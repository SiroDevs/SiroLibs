{
  "id": "AMO.6",
  "number": "6",
  "bookId": "AMO",
  "reference": "Amosi 6",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "AMO 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawa na bato oyo bamimonaka ete bakoka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawa na bino oyo bomimonaka ete bokoka kati na Siona,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "mpe na bino oyo bokanisaka ete bozali na kimia na likolo ya ngomba Samari,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "bino bato ya lokumu ya ekolo oyo ekenda sango",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "koleka bikolo mosusu epai wapi bana ya Isalaele bayaka !",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokende na Kaline mpo na kotala makambo oyo elekaki kuna !",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "Bongo longwa kuna, bokende na Amati, engumba monene,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "mpe bokende lisusu na Gati kati na Filisitia !",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "Boni, bingumba oyo eleki penza",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "bingumba ya mikili ya bokonzi oyo na malamu ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "Mpe etando na yango eleki ya bino na monene ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bozali kozongisa mokolo ya pasi sima",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.3",
            "verseOrgIds": [
              "AMO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:3"
      },
      "items": [
        {
          "text": "mpe komibendela bokonzi ya somo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.3",
            "verseOrgIds": [
              "AMO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bozali kolala na bambeto oyo batia pembe ya nzoko,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "bozali komivandisa na bakiti ya divan ya kitoko,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "bozali kolia misuni ya bameme ya kitoko kati na bibwele",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "mpe ya bana ngombe ya mibali ya mafuta kati na etonga.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bozali kobeta mandanda na bino lokola Davidi",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.5",
            "verseOrgIds": [
              "AMO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:5"
      },
      "items": [
        {
          "text": "mpe kokotisa bibetelo mindule kati na banzembo na bino.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.5",
            "verseOrgIds": [
              "AMO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bozali komela bakopo etonda na masanga ya vino",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:6"
      },
      "items": [
        {
          "text": "mpe bozali kopakola mafuta ya talo na banzoto na bino,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:6"
      },
      "items": [
        {
          "text": "kasi kobebisama ya ndako ya Jozefi ezali kosala bino pasi na mitema te.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana bokozala bato ya liboso mpo na kokende na bowumbu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.7",
            "verseOrgIds": [
              "AMO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:7"
      },
      "items": [
        {
          "text": "mpe bafeti ya bato oyo bamivandisaka na bakiti ya kitoko ekosila.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.7",
            "verseOrgIds": [
              "AMO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kobebisama ya engumba Samari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkolo Yawe alapi ndayi na Kombo na Ye moko ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "Yawe, Nzambe, Mokonzi ya mampinga, alobi :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "« Nazali na somo ya lolendo ya Jakobi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "nayini bandako na ye, oyo batonga makasi ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "nakokaba engumba elongo na biloko na yango nyonso. »",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki bato zomi batikali na bomoi kati na ndako moko, bango mpe bakokufa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
            "verseOrgIds": [
              "AMO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki noko moko oyo asengeli kotumba bibembe ayei kobimisa yango na ndako mpe atuni na moto nyonso oyo abombami kuna :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "AMO 6:10"
      },
      "items": [
        {
          "text": "— Boni, ozali elongo na moto mosusu kuna ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 6:10"
      },
      "items": [
        {
          "text": "Akozongisa :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "AMO 6:10"
      },
      "items": [
        {
          "text": "— Te, moto mosusu azali te !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 6:10"
      },
      "items": [
        {
          "text": "Bongo akoloba lisusu :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "AMO 6:10"
      },
      "items": [
        {
          "text": "— Esili ! Bakolobela lisusu Kombo ya Yawe te.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te Yawe apesi mitindo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:11"
      },
      "items": [
        {
          "text": "boye akobuka-buka na biteni ndako monene",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:11"
      },
      "items": [
        {
          "text": "mpe akobuka-buka na biteni ya mike-mike ndako moke.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, bampunda ekimaka penza mbangu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.12",
            "verseOrgIds": [
              "AMO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:12"
      },
      "items": [
        {
          "text": "na nzela oyo etonda na mabanga ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.12",
            "verseOrgIds": [
              "AMO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:12"
      },
      "items": [
        {
          "text": "Ngombe ebalolaka penza mabele na bisika ya ndenge wana ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.12",
            "verseOrgIds": [
              "AMO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:12"
      },
