          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAL 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "PORQUE he aquí,",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.1",
            "verseOrgIds": [
              "MAL.3.19"
            ]
          }
        },
        {
          "text": "viene el día",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.1",
            "verseOrgIds": [
              "MAL.3.19"
            ]
          }
        },
        {
          "text": "ardiente como un horno; y todos los soberbios, y todos los que hacen maldad, serán",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.1",
            "verseOrgIds": [
              "MAL.3.19"
            ]
          }
        },
        {
          "text": "estopa; y",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.1",
            "verseOrgIds": [
              "MAL.3.19"
            ]
          }
        },
        {
          "text": "aquel día que vendrá, los abrasará, ha dicho Jehová de los ejércitos, el cual no les dejará ni raíz ni rama.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.1",
            "verseOrgIds": [
              "MAL.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas á vosotros los que teméis mi nombre, nacerá",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.2",
            "verseOrgIds": [
              "MAL.3.20"
            ]
          }
        },
        {
          "text": "el Sol de justicia, y en sus alas",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.2",
            "verseOrgIds": [
              "MAL.3.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "traerá",
              "type": "text",
              "attrs": {
                "verseId": "MAL.4.2",
                "verseOrgIds": [
                  "MAL.3.20"
                ]
              }
            }
          ]
        },
        {
          "text": "salud: y saldréis, y saltaréis como becerros de la manada.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.2",
            "verseOrgIds": [
              "MAL.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y hollaréis á los malos, los cuales serán ceniza bajo las plantas de vuestros pies, en el día que yo hago, ha dicho Jehová de los ejércitos.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acordaos",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.3.22"
            ]
          }
        },
        {
          "text": "de la ley de Moisés mi siervo, al cual encargué",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.3.22"
            ]
          }
        },
        {
          "text": "en Horeb ordenanzas y leyes para todo Israel.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí, yo os envío á",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.3.23"
            ]
          }
        },
        {
          "text": "Elías el profeta,",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.3.23"
            ]
          }
        },
        {
          "text": "antes que venga el día de Jehová grande y terrible.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "El",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.6",
            "verseOrgIds": [
              "MAL.3.24"
            ]
          }
        },
        {
          "text": "convertirá el corazón de los padres á los hijos, y el corazón de los hijos á los padres: no sea que yo venga, y con destrucción hiera la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.6",
            "verseOrgIds": [
              "MAL.3.24"
            ]
          }
        }
      ]
    }
  ],
