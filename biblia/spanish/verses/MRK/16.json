{
  "id": "MRK.16",
  "number": "16",
  "bookId": "MRK",
  "reference": "San Marcos 16",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "MRK 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.1",
            "verseOrgIds": [
              "MRK.16.1"
            ]
          }
        },
        {
          "text": "COMO pasó el sábado,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.1",
            "verseOrgIds": [
              "MRK.16.1"
            ]
          }
        },
        {
          "text": "María Magdalena, y",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.1",
            "verseOrgIds": [
              "MRK.16.1"
            ]
          }
        },
        {
          "text": "María",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.1",
            "verseOrgIds": [
              "MRK.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "madre",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.1",
                "verseOrgIds": [
                  "MRK.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "de Jacobo, y",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.1",
            "verseOrgIds": [
              "MRK.16.1"
            ]
          }
        },
        {
          "text": "Salomé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.1",
            "verseOrgIds": [
              "MRK.16.1"
            ]
          }
        },
        {
          "text": "compraron",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.1",
            "verseOrgIds": [
              "MRK.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "drogas",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.1",
                "verseOrgIds": [
                  "MRK.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "aromáticas, para venir á ungirle.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.1",
            "verseOrgIds": [
              "MRK.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y muy de mañana, el primer",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.2",
            "verseOrgIds": [
              "MRK.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "día",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.2",
                "verseOrgIds": [
                  "MRK.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "de la semana, vienen al sepulcro,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.2",
            "verseOrgIds": [
              "MRK.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "ya",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.2",
                "verseOrgIds": [
                  "MRK.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "salido el sol.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.2",
            "verseOrgIds": [
              "MRK.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y decían entre sí: ¿Quién nos revolverá la piedra de la puerta del sepulcro?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.3",
            "verseOrgIds": [
              "MRK.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y como miraron, ven",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.4",
            "verseOrgIds": [
              "MRK.16.4"
            ]
          }
        },
        {
          "text": "la piedra revuelta; que era muy grande.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.4",
            "verseOrgIds": [
              "MRK.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y entradas en el sepulcro,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.5",
            "verseOrgIds": [
              "MRK.16.5"
            ]
          }
        },
        {
          "text": "vieron un mancebo sentado al lado derecho, cubierto de una larga ropa blanca; y se espantaron.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.5",
            "verseOrgIds": [
              "MRK.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Más él les dice: No os asustéis: buscáis á Jesús Nazareno, el que fué crucificado; resucitado há, no está aquí; he aquí el lugar en donde le pusieron.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.6",
            "verseOrgIds": [
              "MRK.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas id, decid á sus discípulos y á",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.7",
            "verseOrgIds": [
              "MRK.16.7"
            ]
          }
        },
        {
          "text": "Pedro, que él va antes que vosotros á Galilea: allí le veréis,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.7",
            "verseOrgIds": [
              "MRK.16.7"
            ]
          }
        },
        {
          "text": "como os dijo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.7",
            "verseOrgIds": [
              "MRK.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y ellas se fueron huyendo del sepulcro; porque las había tomado temblor y espanto;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.8",
            "verseOrgIds": [
              "MRK.16.8"
            ]
          }
        },
        {
          "text": "ni decían nada á nadie, porque tenían miedo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.8",
            "verseOrgIds": [
              "MRK.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas como Jesús resucitó por la mañana, el primer",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.9",
            "verseOrgIds": [
              "MRK.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "día",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.9",
                "verseOrgIds": [
                  "MRK.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "de la semana, apareció primeramente á María Magdalena, de la cual había",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.9",
            "verseOrgIds": [
              "MRK.16.9"
            ]
          }
        },
        {
          "text": "echado siete demonios.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.9",
            "verseOrgIds": [
              "MRK.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Apariciones de",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Jesús resucitado.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yendo ella,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.10",
            "verseOrgIds": [
              "MRK.16.10"
            ]
          }
        },
        {
          "text": "lo hizo saber á los que habían estado con él,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.10",
            "verseOrgIds": [
              "MRK.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "que estaban",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.10",
                "verseOrgIds": [
                  "MRK.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "tristes y llorando.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.10",
            "verseOrgIds": [
              "MRK.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y ellos como oyeron que vivía, y que había sido visto de ella,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.11",
            "verseOrgIds": [
              "MRK.16.11"
            ]
          }
        },
        {
          "text": "no",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.11",
            "verseOrgIds": [
              "MRK.16.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "lo",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.11",
                "verseOrgIds": [
                  "MRK.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "creyeron.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.11",
            "verseOrgIds": [
              "MRK.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas después apareció en otra forma",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.12",
            "verseOrgIds": [
              "MRK.16.12"
            ]
          }
        },
        {
          "text": "a dos de ellos que iban caminando, yendo al campo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.12",
            "verseOrgIds": [
              "MRK.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y ellos fueron, y lo hicieron saber á los otros; y",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.13",
            "verseOrgIds": [
              "MRK.16.13"
            ]
          }
        },
        {
          "text": "ni aun á éllos creyeron.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.13",
            "verseOrgIds": [
              "MRK.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finalmente",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.14",
            "verseOrgIds": [
              "MRK.16.14"
            ]
          }
        },
        {
          "text": "se apareció á los once mismos, estando sentados á la mesa, y censuróles su incredulidad y dureza de corazón,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.14",
            "verseOrgIds": [
              "MRK.16.14"
            ]
          }
        },
        {
          "text": "que no hubiesen creído á los que le habían visto resucitado.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.14",
            "verseOrgIds": [
              "MRK.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y les dijo:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.15",
            "verseOrgIds": [
              "MRK.16.15"
            ]
          }
        },
        {
          "text": "Id por todo el mundo; predicad el evangelio á toda criatura.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.15",
            "verseOrgIds": [
              "MRK.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que creyere y",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.16",
            "verseOrgIds": [
              "MRK.16.16"
            ]
          }
        },
        {
          "text": "fuere bautizado, será salvo;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.16",
            "verseOrgIds": [
              "MRK.16.16"
            ]
          }
        },
        {
          "text": "mas el que no creyere, será condenado.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.16",
            "verseOrgIds": [
              "MRK.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y estas señales seguirán á los que creyeren:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.17",
            "verseOrgIds": [
              "MRK.16.17"
            ]
          }
        },
        {
          "text": "En mi nombre echarán fuera demonios;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.17",
            "verseOrgIds": [
              "MRK.16.17"
            ]
          }
        },
        {
          "text": "hablaran nuevas lenguas;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.17",
            "verseOrgIds": [
              "MRK.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
