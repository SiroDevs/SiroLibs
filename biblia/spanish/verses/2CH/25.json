          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asimismo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "tomó",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.24",
                "verseOrgIds": [
                  "2CH.25.24"
                ]
              }
            }
          ]
        },
        {
          "text": "todo el oro y plata, y todos los vasos que se hallaron en la casa de Dios en casa de Obed-edom, y los tesoros de la casa del rey, y los hijos de los príncipes, y volvióse á Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
