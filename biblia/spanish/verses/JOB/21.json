{
  "id": "JOB.21",
  "number": "21",
  "bookId": "JOB",
  "reference": "Job 21",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "JOB 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y RESPONDIÓ Job, y dijo:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.1",
            "verseOrgIds": [
              "JOB.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oid atentamente mi palabra,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.2",
            "verseOrgIds": [
              "JOB.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:2"
      },
      "items": [
        {
          "text": "Y sea esto vuestros consuelos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.2",
            "verseOrgIds": [
              "JOB.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soportadme, y yo hablaré;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.3",
            "verseOrgIds": [
              "JOB.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:3"
      },
      "items": [
        {
          "text": "Y después que hubiere hablado, escarneced.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.3",
            "verseOrgIds": [
              "JOB.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Hablo yo á algún hombre?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.4",
            "verseOrgIds": [
              "JOB.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:4"
      },
      "items": [
        {
          "text": "Y ¿por qué no se ha de angustiar mi espíritu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.4",
            "verseOrgIds": [
              "JOB.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miradme, y espantaos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.5",
            "verseOrgIds": [
              "JOB.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:5"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.5",
            "verseOrgIds": [
              "JOB.21.5"
            ]
          }
        },
        {
          "text": "poned la mano sobre la boca.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.5",
            "verseOrgIds": [
              "JOB.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aun yo mismo, cuando me acuerdo, me asombro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.6",
            "verseOrgIds": [
              "JOB.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:6"
      },
      "items": [
        {
          "text": "Y toma temblor mi carne.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.6",
            "verseOrgIds": [
              "JOB.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Por qué viven los impíos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.7",
            "verseOrgIds": [
              "JOB.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:7"
      },
      "items": [
        {
          "text": "Y se envejecen, y aun crecen en riquezas?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.7",
            "verseOrgIds": [
              "JOB.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Su simiente con ellos, compuesta delante de ellos;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.8",
            "verseOrgIds": [
              "JOB.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:8"
      },
      "items": [
        {
          "text": "Y sus renuevos delante de sus ojos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.8",
            "verseOrgIds": [
              "JOB.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sus casas seguras de temor,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.9",
            "verseOrgIds": [
              "JOB.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:9"
      },
      "items": [
        {
          "text": "Ni hay azote de Dios sobre ellos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.9",
            "verseOrgIds": [
              "JOB.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sus vacas conciben, no abortan;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.10",
            "verseOrgIds": [
              "JOB.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:10"
      },
      "items": [
        {
          "text": "Paren sus vacas, y no malogran su cría.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.10",
            "verseOrgIds": [
              "JOB.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 que no siempre los malos",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 son castigados en este mundo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salen sus chiquitos como manada,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.11",
            "verseOrgIds": [
              "JOB.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:11"
      },
      "items": [
        {
          "text": "Y sus hijos andan saltando.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.11",
            "verseOrgIds": [
              "JOB.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al son de tamboril y cítara saltan,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.12",
            "verseOrgIds": [
              "JOB.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:12"
      },
      "items": [
        {
          "text": "Y se huelgan al son del",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.12",
            "verseOrgIds": [
              "JOB.21.12"
            ]
          }
        },
        {
          "text": "órgano.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.12",
            "verseOrgIds": [
              "JOB.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gastan sus días en bien,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.13",
            "verseOrgIds": [
              "JOB.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:13"
      },
      "items": [
        {
          "text": "Y en un momento descienden á la sepultura.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.13",
            "verseOrgIds": [
              "JOB.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dicen pues á Dios: Apártate de nosotros,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.14",
            "verseOrgIds": [
              "JOB.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:14"
      },
      "items": [
        {
          "text": "Que no queremos el conocimiento de tus caminos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.14",
            "verseOrgIds": [
              "JOB.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién es el Todopoderoso, para que le sirvamos?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.15",
            "verseOrgIds": [
              "JOB.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:15"
      },
      "items": [
        {
          "text": "¿Y de qué nos aprovechará que oremos á él?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.15",
            "verseOrgIds": [
              "JOB.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí que su bien no está en manos de ellos:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.16",
            "verseOrgIds": [
              "JOB.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:16"
      },
      "items": [
        {
          "text": "El consejo de los impíos lejos esté de mí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.16",
            "verseOrgIds": [
              "JOB.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "¡Oh cuántas veces la lámpara de los impíos es apagada,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:17"
      },
      "items": [
        {
          "text": "Y viene sobre ellos su quebranto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Y Dios",
              "type": "text",
              "attrs": {
                "verseId": "JOB.21.17",
                "verseOrgIds": [
                  "JOB.21.17"
                ]
              }
            }
          ]
        },
        {
          "text": "en su ira les reparte dolores!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Serán como la paja delante del viento,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.18",
            "verseOrgIds": [
              "JOB.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:18"
      },
      "items": [
        {
          "text": "Y como el tamo que arrebata el torbellino.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.18",
            "verseOrgIds": [
              "JOB.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dios",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.19",
            "verseOrgIds": [
              "JOB.21.19"
            ]
          }
        },
        {
          "text": "guardará para sus hijos su violencia;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.19",
            "verseOrgIds": [
              "JOB.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:19"
      },
      "items": [
        {
          "text": "Y le dará su pago, para que conozca.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.19",
            "verseOrgIds": [
              "JOB.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Verán sus ojos su quebranto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.20",
            "verseOrgIds": [
              "JOB.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:20"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.20",
            "verseOrgIds": [
              "JOB.21.20"
            ]
          }
        },
        {
          "text": "beberá de la ira del Todopoderoso.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.20",
            "verseOrgIds": [
              "JOB.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque ¿qué deleite tendrá él de su casa después de sí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.21",
            "verseOrgIds": [
              "JOB.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:21"
      },
      "items": [
        {
          "text": "Siendo cortado el número de sus meses?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.21",
            "verseOrgIds": [
              "JOB.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Enseñará alguien á Dios sabiduría,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.22",
            "verseOrgIds": [
              "JOB.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:22"
      },
      "items": [
        {
          "text": "Juzgando él á los que están elevados?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.22",
            "verseOrgIds": [
              "JOB.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Este morirá en el vigor de su hermosura, todo quieto y pacífico.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.23",
            "verseOrgIds": [
              "JOB.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sus colodras están llenas de leche,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.24",
            "verseOrgIds": [
              "JOB.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:24"
      },
      "items": [
        {
          "text": "Y sus huesos serán regados de tuétano.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.24",
            "verseOrgIds": [
              "JOB.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y estotro morirá en amargura de ánimo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.25",
            "verseOrgIds": [
              "JOB.21.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:25"
      },
      "items": [
        {
          "text": "Y no habiendo comido jamás con gusto.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.25",
            "verseOrgIds": [
              "JOB.21.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igualmente",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.26",
            "verseOrgIds": [
              "JOB.21.26"
            ]
          }
        },
        {
          "text": "yacerán ellos en el polvo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.26",
            "verseOrgIds": [
              "JOB.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:26"
      },
      "items": [
        {
          "text": "Y gusanos los cubrirán.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.26",
            "verseOrgIds": [
              "JOB.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí, yo conozco vuestros pensamientos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.27",
            "verseOrgIds": [
              "JOB.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:27"
      },
      "items": [
        {
          "text": "Y las imaginaciones que contra mí forjáis.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.27",
            "verseOrgIds": [
              "JOB.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque decís:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.28",
            "verseOrgIds": [
              "JOB.21.28"
            ]
          }
        },
        {
          "text": "¿Qué es de la casa del príncipe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.28",
            "verseOrgIds": [
              "JOB.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:28"
      },
      "items": [
        {
          "text": "Y qué de la tienda de las moradas de los impíos?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.28",
            "verseOrgIds": [
              "JOB.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿No habéis preguntado á los que pasan por los caminos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.29",
            "verseOrgIds": [
              "JOB.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:29"
      },
      "items": [
        {
          "text": "Por cuyas señas no negaréis,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.29",
            "verseOrgIds": [
              "JOB.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que el malo es reservado para el día de la destrucción?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.30",
            "verseOrgIds": [
              "JOB.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:30"
      },
      "items": [
        {
          "text": "Presentados serán en el día de las iras.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.30",
            "verseOrgIds": [
              "JOB.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién le denunciará en su cara su camino?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.31",
            "verseOrgIds": [
              "JOB.21.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:31"
      },
      "items": [
        {
          "text": "Y de lo que él hizo, ¿quién le dará el pago?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.31",
            "verseOrgIds": [
              "JOB.21.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque llevado será él á los sepulcros,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.32",
            "verseOrgIds": [
              "JOB.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:32"
      },
      "items": [
        {
          "text": "Y en el montón permanecerá.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.32",
            "verseOrgIds": [
              "JOB.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los terrones del valle le serán dulces;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.33",
            "verseOrgIds": [
              "JOB.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:33"
      },
      "items": [
        {
          "text": "Y tras de él será llevado todo hombre,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.33",
            "verseOrgIds": [
              "JOB.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:33"
      },
      "items": [
        {
          "text": "Y antes de él",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.33",
            "verseOrgIds": [
              "JOB.21.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "han ido",
              "type": "text",
              "attrs": {
                "verseId": "JOB.21.33",
                "verseOrgIds": [
                  "JOB.21.33"
                ]
              }
            }
          ]
        },
        {
          "text": "innumerables.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.33",
            "verseOrgIds": [
              "JOB.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Cómo pues me consoláis en vano,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.34",
            "verseOrgIds": [
              "JOB.21.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 21:34"
      },
      "items": [
        {
          "text": "Viniendo á parar vuestras respuestas en falacia?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.34",
            "verseOrgIds": [
              "JOB.21.34"
            ]
          }
        }
      ]
    }
