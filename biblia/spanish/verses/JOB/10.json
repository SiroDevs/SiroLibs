          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Renuevas contra mí tus plagas,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.17",
            "verseOrgIds": [
              "JOB.10.17"
            ]
          }
        }
      ]
    },
