      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 10:18"
      },
      "items": [
        {
          "text": "Habría yo espirado, y no me vieran ojos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.18",
            "verseOrgIds": [
              "JOB.10.18"
            ]
          }
        }
      ]
    },
