      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 10:17"
      },
      "items": [
        {
          "text": "Remudándose sobre mí ejércitos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.17",
            "verseOrgIds": [
              "JOB.10.17"
            ]
