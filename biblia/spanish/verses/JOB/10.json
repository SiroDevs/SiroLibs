      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 10:17"
      },
      "items": [
        {
          "text": "Y aumentas conmigo tu furor,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.17",
            "verseOrgIds": [
              "JOB.10.17"
            ]
          }
        }
      ]
    },
    {
