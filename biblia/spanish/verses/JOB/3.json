{
  "id": "JOB.3",
  "number": "3",
  "bookId": "JOB",
  "reference": "Job 3",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JOB 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "DESPUÉS de esto abrió Job su boca, y maldijo su día.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.1",
            "verseOrgIds": [
              "JOB.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y exclamó Job, y dijo:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.2",
            "verseOrgIds": [
              "JOB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perezca el día en que yo nací,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.3",
            "verseOrgIds": [
              "JOB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:3"
      },
      "items": [
        {
          "text": "Y la noche que se dijo: Varón es concebido.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.3",
            "verseOrgIds": [
              "JOB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sea aquel día sombrío,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.4",
            "verseOrgIds": [
              "JOB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:4"
      },
      "items": [
        {
          "text": "Y Dios no cuide de él desde arriba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.4",
            "verseOrgIds": [
              "JOB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:4"
      },
      "items": [
        {
          "text": "Ni claridad sobre él resplandezca.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.4",
            "verseOrgIds": [
              "JOB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aféenlo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        },
        {
          "text": "tinieblas y sombra de muerte;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:5"
      },
      "items": [
        {
          "text": "Repose sobre él nublado,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:5"
      },
      "items": [
        {
          "text": "Que lo haga horrible como caliginoso día.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ocupe la oscuridad aquella noche;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.6",
            "verseOrgIds": [
              "JOB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:6"
      },
      "items": [
        {
          "text": "No sea contada entre los días del año,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.6",
            "verseOrgIds": [
              "JOB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:6"
      },
      "items": [
        {
          "text": "Ni venga en él número de los meses.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.6",
            "verseOrgIds": [
              "JOB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "¡Oh si fuere aquella noche solitaria,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.7",
            "verseOrgIds": [
              "JOB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:7"
      },
      "items": [
        {
          "text": "Que no viniera canción alguna en ella!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.7",
            "verseOrgIds": [
              "JOB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maldíganla los que maldicen al día,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.8",
            "verseOrgIds": [
              "JOB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:8"
      },
      "items": [
        {
          "text": "Los que se aprestan para levantar su llanto.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.8",
            "verseOrgIds": [
              "JOB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oscurézcanse las estrellas de su alba;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.9",
            "verseOrgIds": [
              "JOB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:9"
      },
      "items": [
        {
          "text": "Espere la luz, y no venga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.9",
            "verseOrgIds": [
              "JOB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:9"
      },
      "items": [
        {
          "text": "Ni vea los",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.9",
            "verseOrgIds": [
              "JOB.3.9"
            ]
          }
        },
        {
          "text": "párpados de la mañana:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.9",
            "verseOrgIds": [
              "JOB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por cuanto no cerró las puertas del vientre donde yo estaba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.10",
            "verseOrgIds": [
              "JOB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:10"
      },
      "items": [
        {
          "text": "Ni escondió de mis ojos la miseria.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.10",
            "verseOrgIds": [
              "JOB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Por qué no",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.11",
            "verseOrgIds": [
              "JOB.3.11"
            ]
          }
        },
        {
          "text": "morí yo desde la matriz,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.11",
            "verseOrgIds": [
              "JOB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:11"
      },
      "items": [
        {
          "text": "O fuí traspasado en saliendo del vientre?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.11",
            "verseOrgIds": [
              "JOB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Por qué me previnieron las rodillas?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.12",
            "verseOrgIds": [
              "JOB.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:12"
      },
      "items": [
        {
          "text": "¿Y para qué las tetas que mamase?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.12",
            "verseOrgIds": [
              "JOB.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pues que ahora yaciera yo, y reposara;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.13",
            "verseOrgIds": [
              "JOB.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:13"
      },
      "items": [
        {
          "text": "Durmiera, y entonces tuviera reposo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.13",
            "verseOrgIds": [
              "JOB.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con los reyes y con los consejeros de la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.14",
            "verseOrgIds": [
              "JOB.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:14"
      },
      "items": [
        {
          "text": "Que edifican para sí los desiertos;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.14",
            "verseOrgIds": [
              "JOB.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O con los príncipes que poseían el oro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.15",
            "verseOrgIds": [
              "JOB.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:15"
      },
      "items": [
        {
          "text": "Que henchían sus casas de plata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.15",
            "verseOrgIds": [
              "JOB.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ¿por qué no fuí escondido",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.16",
            "verseOrgIds": [
              "JOB.3.16"
            ]
          }
        },
        {
          "text": "como aborto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.16",
            "verseOrgIds": [
              "JOB.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:16"
      },
      "items": [
        {
          "text": "Como los pequeñitos que nunca vieron luz?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.16",
            "verseOrgIds": [
              "JOB.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Allí los impíos dejan el perturbar,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.17",
            "verseOrgIds": [
              "JOB.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:17"
      },
      "items": [
        {
          "text": "Y allí descansan los de cansadas fuerzas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.17",
            "verseOrgIds": [
              "JOB.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Allí asimismo reposan los cautivos;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.18",
            "verseOrgIds": [
              "JOB.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 3:18"
      },
      "items": [
        {
          "text": "No oyen la voz del exactor.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.18",
            "verseOrgIds": [
              "JOB.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
