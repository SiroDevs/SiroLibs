{
  "id": "JOB.27",
  "number": "27",
  "bookId": "JOB",
  "reference": "Job 27",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "JOB 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y REASUMIÓ Job su discurso, y dijo:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.1",
            "verseOrgIds": [
              "JOB.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vive Dios,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.2",
            "verseOrgIds": [
              "JOB.27.2"
            ]
          }
        },
        {
          "text": "el cual ha apartado mi causa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.2",
            "verseOrgIds": [
              "JOB.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:2"
      },
      "items": [
        {
          "text": "Y el Omnipotente, que amargó el alma mía,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.2",
            "verseOrgIds": [
              "JOB.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 y prosigue afirmando",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 su propia inocencia.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que todo el tiempo que mi alma estuviere en mí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.3",
            "verseOrgIds": [
              "JOB.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:3"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.3",
            "verseOrgIds": [
              "JOB.27.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "hubiere",
              "type": "text",
              "attrs": {
                "verseId": "JOB.27.3",
                "verseOrgIds": [
                  "JOB.27.3"
                ]
              }
            }
          ]
        },
        {
          "text": "hálito",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.3",
            "verseOrgIds": [
              "JOB.27.3"
            ]
          }
        },
        {
          "text": "de Dios en mis narices,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.3",
            "verseOrgIds": [
              "JOB.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mis labios no hablarán iniquidad,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.4",
            "verseOrgIds": [
              "JOB.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:4"
      },
      "items": [
        {
          "text": "Ni mi lengua pronunciará engaño.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.4",
            "verseOrgIds": [
              "JOB.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunca tal acontezca que yo os justifique:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.5",
            "verseOrgIds": [
              "JOB.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:5"
      },
      "items": [
        {
          "text": "Hasta morir no quitaré de mí mi integridad.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.5",
            "verseOrgIds": [
              "JOB.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi justicia tengo asida, y no la cederé:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.6",
            "verseOrgIds": [
              "JOB.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:6"
      },
      "items": [
        {
          "text": "No",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.6",
            "verseOrgIds": [
              "JOB.27.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "me",
              "type": "text",
              "attrs": {
                "verseId": "JOB.27.6",
                "verseOrgIds": [
                  "JOB.27.6"
                ]
              }
            }
          ]
        },
        {
          "text": "reprochará mi corazón en el tiempo de mi vida.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.6",
            "verseOrgIds": [
              "JOB.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sea como el impío mi enemigo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.7",
            "verseOrgIds": [
              "JOB.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:7"
      },
      "items": [
        {
          "text": "Y como el inicuo mi adversario.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.7",
            "verseOrgIds": [
              "JOB.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque ¿cuál es la esperanza del hipócrita, por mucho que hubiere robado,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.8",
            "verseOrgIds": [
              "JOB.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:8"
      },
      "items": [
        {
          "text": "Cuando Dios arrebatare su alma?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.8",
            "verseOrgIds": [
              "JOB.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Oirá Dios su clamor",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.9",
            "verseOrgIds": [
              "JOB.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:9"
      },
      "items": [
        {
          "text": "Cuando la tribulación sobre él viniere?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.9",
            "verseOrgIds": [
              "JOB.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Deleitaráse en el Omnipotente?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.10",
            "verseOrgIds": [
              "JOB.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:10"
      },
      "items": [
        {
          "text": "¿Invocará á Dios en todo tiempo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.10",
            "verseOrgIds": [
              "JOB.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo os enseñaré en orden á la mano de Dios:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.11",
            "verseOrgIds": [
              "JOB.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:11"
      },
      "items": [
        {
          "text": "No esconderé lo que hay para con el Omnipotente.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.11",
            "verseOrgIds": [
              "JOB.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí que todos vosotros lo habéis visto:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.12",
            "verseOrgIds": [
              "JOB.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:12"
      },
      "items": [
        {
          "text": "¿Por qué pues os desvanecéis con fantasía?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.12",
            "verseOrgIds": [
              "JOB.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esta es para con Dios la suerte del hombre impío,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.13",
            "verseOrgIds": [
              "JOB.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:13"
      },
      "items": [
        {
          "text": "Y la herencia que los violentos han de recibir del Omnipotente.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.13",
            "verseOrgIds": [
              "JOB.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si sus hijos fueren multiplicados, serán para el",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.14",
            "verseOrgIds": [
              "JOB.27.14"
            ]
          }
        },
        {
          "text": "cuchillo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.14",
            "verseOrgIds": [
              "JOB.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:14"
      },
      "items": [
        {
          "text": "Y sus pequeños no se hartarán de pan;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.14",
            "verseOrgIds": [
              "JOB.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los que le quedaren, en muerte serán sepultados;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.15",
            "verseOrgIds": [
              "JOB.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:15"
      },
      "items": [
        {
          "text": "Y no llorarán sus viudas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.15",
            "verseOrgIds": [
              "JOB.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.16",
            "verseOrgIds": [
              "JOB.27.16"
            ]
          }
        },
        {
          "text": "amontonare plata como polvo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.16",
            "verseOrgIds": [
              "JOB.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:16"
      },
      "items": [
        {
          "text": "Y si preparare ropa como lodo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.16",
            "verseOrgIds": [
              "JOB.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habrála él preparado,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.17",
            "verseOrgIds": [
              "JOB.27.17"
            ]
          }
        },
        {
          "text": "mas el justo se vestirá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.17",
            "verseOrgIds": [
              "JOB.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 27:17"
      },
      "items": [
        {
          "text": "Y el inocente repartirá la plata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.17",
            "verseOrgIds": [
              "JOB.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edificó su casa como la polilla,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.18",
            "verseOrgIds": [
