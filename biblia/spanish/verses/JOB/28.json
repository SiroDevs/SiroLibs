{
  "id": "JOB.28",
  "number": "28",
  "bookId": "JOB",
  "reference": "Job 28",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "JOB 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "CIERTAMENTE la plata tiene sus veneros,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.1",
            "verseOrgIds": [
              "JOB.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:1"
      },
      "items": [
        {
          "text": "Y el oro lugar",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.1",
            "verseOrgIds": [
              "JOB.28.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "donde",
              "type": "text",
              "attrs": {
                "verseId": "JOB.28.1",
                "verseOrgIds": [
                  "JOB.28.1"
                ]
              }
            }
          ]
        },
        {
          "text": "se forma.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.1",
            "verseOrgIds": [
              "JOB.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hierro se saca del polvo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.2",
            "verseOrgIds": [
              "JOB.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:2"
      },
      "items": [
        {
          "text": "Y de la piedra es fundido el metal.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.2",
            "verseOrgIds": [
              "JOB.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "A las tinieblas puso término,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.3",
            "verseOrgIds": [
              "JOB.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:3"
      },
      "items": [
        {
          "text": "Y examina todo á la perfección,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.3",
            "verseOrgIds": [
              "JOB.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:3"
      },
      "items": [
        {
          "text": "Las piedras",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.3",
            "verseOrgIds": [
              "JOB.28.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "que hay",
              "type": "text",
              "attrs": {
                "verseId": "JOB.28.3",
                "verseOrgIds": [
                  "JOB.28.3"
                ]
              }
            }
          ]
        },
        {
          "text": "en la oscuridad y en la sombra de muerte.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.3",
            "verseOrgIds": [
              "JOB.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Brota el torrente de junto al morador,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.4",
            "verseOrgIds": [
              "JOB.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Aguas",
              "type": "text",
              "attrs": {
                "verseId": "JOB.28.4",
                "verseOrgIds": [
                  "JOB.28.4"
                ]
              }
            }
          ]
        },
        {
          "text": "que el pie había olvidado:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.4",
            "verseOrgIds": [
              "JOB.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:4"
      },
      "items": [
        {
          "text": "Sécanse luego, vanse del hombre.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.4",
            "verseOrgIds": [
              "JOB.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "De la tierra nace el pan,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.5",
            "verseOrgIds": [
              "JOB.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:5"
      },
      "items": [
        {
          "text": "Y debajo de ella estará como convertida en fuego.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.5",
            "verseOrgIds": [
              "JOB.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lugar hay cuyas piedras son zafiro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.6",
            "verseOrgIds": [
              "JOB.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:6"
      },
      "items": [
        {
          "text": "Y sus polvos de oro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.6",
            "verseOrgIds": [
              "JOB.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Senda que nunca la conoció ave,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.7",
            "verseOrgIds": [
              "JOB.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:7"
      },
      "items": [
        {
          "text": "Ni ojo de buitre la vió:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.7",
            "verseOrgIds": [
              "JOB.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunca la pisaron animales fieros,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.8",
            "verseOrgIds": [
              "JOB.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:8"
      },
      "items": [
        {
          "text": "Ni león pasó por ella.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.8",
            "verseOrgIds": [
              "JOB.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "En el pedernal puso su mano,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.9",
            "verseOrgIds": [
              "JOB.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:9"
      },
      "items": [
        {
          "text": "Y trastornó los montes de raíz.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.9",
            "verseOrgIds": [
              "JOB.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "De los peñascos cortó ríos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.10",
            "verseOrgIds": [
              "JOB.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:10"
      },
      "items": [
        {
          "text": "Y sus ojos vieron todo lo preciado.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.10",
            "verseOrgIds": [
              "JOB.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Excelencia de la sabiduría.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Job describe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Detuvo los ríos en su nacimiento,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.11",
            "verseOrgIds": [
              "JOB.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:11"
      },
      "items": [
        {
          "text": "E hizo salir á luz lo escondido.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.11",
            "verseOrgIds": [
              "JOB.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empero ¿dónde se hallará la sabiduría?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.12",
            "verseOrgIds": [
              "JOB.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:12"
      },
      "items": [
        {
          "text": "¿Y dónde está el lugar de la prudencia?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.12",
            "verseOrgIds": [
              "JOB.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "No conoce su valor el hombre,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.13",
            "verseOrgIds": [
              "JOB.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:13"
      },
      "items": [
        {
          "text": "Ni se halla en la tierra de los vivientes.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.13",
            "verseOrgIds": [
              "JOB.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "El abismo dice: No está en mí:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.14",
            "verseOrgIds": [
              "JOB.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:14"
      },
      "items": [
        {
          "text": "Y la mar dijo: Ni conmigo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.14",
            "verseOrgIds": [
              "JOB.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "No se dará por oro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.15",
            "verseOrgIds": [
              "JOB.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:15"
      },
      "items": [
        {
          "text": "Ni su precio será á peso de plata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.15",
            "verseOrgIds": [
              "JOB.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "No puede ser apreciada con",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.16",
            "verseOrgIds": [
              "JOB.28.16"
            ]
          }
        },
        {
          "text": "oro de Ophir,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.16",
            "verseOrgIds": [
              "JOB.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:16"
      },
      "items": [
        {
          "text": "Ni con onique precioso, ni con zafiro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.16",
            "verseOrgIds": [
              "JOB.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "El oro no se le igualará, ni el diamante;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.17",
            "verseOrgIds": [
              "JOB.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:17"
      },
      "items": [
        {
          "text": "Ni se trocará por vaso de oro fino.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.17",
            "verseOrgIds": [
              "JOB.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "De coral ni de perlas no se hará mención:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.18",
            "verseOrgIds": [
              "JOB.28.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:18"
      },
      "items": [
        {
          "text": "La sabiduría es mejor que",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.18",
            "verseOrgIds": [
              "JOB.28.18"
            ]
          }
        },
        {
          "text": "piedras preciosas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.18",
            "verseOrgIds": [
              "JOB.28.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "No se igualará con ella esmeralda de Ethiopía;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.19",
            "verseOrgIds": [
              "JOB.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:19"
      },
      "items": [
        {
          "text": "No se podrá apreciar con oro fino.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.19",
            "verseOrgIds": [
              "JOB.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿De dónde pues vendrá la sabiduría?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.20",
            "verseOrgIds": [
              "JOB.28.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:20"
      },
      "items": [
        {
          "text": "¿Y dónde está el lugar de la inteligencia?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.20",
            "verseOrgIds": [
              "JOB.28.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque encubierta está á los ojos de todo viviente, y á toda ave del cielo es oculta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.21",
            "verseOrgIds": [
              "JOB.28.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "El infierno y la muerte dijeron:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.22",
            "verseOrgIds": [
              "JOB.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:22"
      },
      "items": [
        {
          "text": "Su fama hemos oído con nuestros oídos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.22",
            "verseOrgIds": [
              "JOB.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dios entiende el camino de ella,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.23",
            "verseOrgIds": [
              "JOB.28.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:23"
      },
      "items": [
        {
          "text": "Y él conoce su lugar.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.23",
            "verseOrgIds": [
              "JOB.28.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque él mira hasta los fines de la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.24",
            "verseOrgIds": [
              "JOB.28.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:24"
      },
      "items": [
        {
          "text": "Y ve debajo de todo el cielo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.24",
            "verseOrgIds": [
              "JOB.28.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al dar peso al viento,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.25",
            "verseOrgIds": [
              "JOB.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:25"
      },
      "items": [
        {
          "text": "Y poner las aguas por medida;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.25",
            "verseOrgIds": [
              "JOB.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando él hizo ley á la lluvia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.26",
            "verseOrgIds": [
              "JOB.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:26"
      },
      "items": [
        {
          "text": "Y camino al relámpago de los truenos:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.26",
            "verseOrgIds": [
              "JOB.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entonces la veía él, y la manifestaba:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.27",
            "verseOrgIds": [
              "JOB.28.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:27"
      },
      "items": [
        {
          "text": "Preparóla y descubrióla también.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.27",
            "verseOrgIds": [
              "JOB.28.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y dijo al hombre:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.28",
            "verseOrgIds": [
              "JOB.28.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:28"
      },
      "items": [
        {
          "text": "He aquí que",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.28",
            "verseOrgIds": [
              "JOB.28.28"
            ]
          }
        },
        {
          "text": "el temor del Señor es la sabiduría,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.28",
            "verseOrgIds": [
              "JOB.28.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 28:28"
      },
      "items": [
        {
          "text": "Y el",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.28",
            "verseOrgIds": [
              "JOB.28.28"
            ]
          }
        },
        {
          "text": "apartarse del mal la inteligencia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.28",
            "verseOrgIds": [
              "JOB.28.28"
            ]
          }
        }
      ]
    }
