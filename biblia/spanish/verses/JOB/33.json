{
  "id": "JOB.33",
  "number": "33",
  "bookId": "JOB",
  "reference": "Job 33",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "JOB 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "POR tanto, Job, oye ahora mis razones,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.1",
            "verseOrgIds": [
              "JOB.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:1"
      },
      "items": [
        {
          "text": "Y escucha todas mis palabras.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.1",
            "verseOrgIds": [
              "JOB.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí yo abriré ahora mi boca,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.2",
            "verseOrgIds": [
              "JOB.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:2"
      },
      "items": [
        {
          "text": "Y mi lengua hablará en mi garganta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.2",
            "verseOrgIds": [
              "JOB.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mis razones",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.3",
            "verseOrgIds": [
              "JOB.33.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "declararán",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.3",
                "verseOrgIds": [
                  "JOB.33.3"
                ]
              }
            }
          ]
        },
        {
          "text": "la rectitud de mi corazón,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.3",
            "verseOrgIds": [
              "JOB.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:3"
      },
      "items": [
        {
          "text": "Y mis labios proferirán pura sabiduría.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.3",
            "verseOrgIds": [
              "JOB.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "El espíritu de Dios me hizo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.4",
            "verseOrgIds": [
              "JOB.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:4"
      },
      "items": [
        {
          "text": "Y la inspiración del Omnipotente me dió vida.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.4",
            "verseOrgIds": [
              "JOB.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si pudieres, respóndeme:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.5",
            "verseOrgIds": [
              "JOB.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:5"
      },
      "items": [
        {
          "text": "Dispón",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.5",
            "verseOrgIds": [
              "JOB.33.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "tus palabras,",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.5",
                "verseOrgIds": [
                  "JOB.33.5"
                ]
              }
            }
          ]
        },
        {
          "text": "está delante de mí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.5",
            "verseOrgIds": [
              "JOB.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heme aquí á mí en lugar de Dios, conforme á tu dicho:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.6",
            "verseOrgIds": [
              "JOB.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:6"
      },
      "items": [
        {
          "text": "De lodo soy yo también formado.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.6",
            "verseOrgIds": [
              "JOB.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí que mi terror no te espantará,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.7",
            "verseOrgIds": [
              "JOB.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:7"
      },
      "items": [
        {
          "text": "Ni mi mano se agravará sobre ti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.7",
            "verseOrgIds": [
              "JOB.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "De cierto tú dijiste á oídos míos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.8",
            "verseOrgIds": [
              "JOB.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:8"
      },
      "items": [
        {
          "text": "Y yo oí la voz de tus palabras",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.8",
            "verseOrgIds": [
              "JOB.33.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "que decían:",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.8",
                "verseOrgIds": [
                  "JOB.33.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo soy limpio y sin defecto;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.9",
            "verseOrgIds": [
              "JOB.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:9"
      },
      "items": [
        {
          "text": "Y soy inocente, y no hay maldad en mí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.9",
            "verseOrgIds": [
              "JOB.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí que él buscó achaques contra mí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.10",
            "verseOrgIds": [
              "JOB.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:10"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.10",
            "verseOrgIds": [
              "JOB.33.10"
            ]
          }
        },
        {
          "text": "me tiene por su enemigo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.10",
            "verseOrgIds": [
              "JOB.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puso mis pies en el cepo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.11",
            "verseOrgIds": [
              "JOB.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:11"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.11",
            "verseOrgIds": [
              "JOB.33.11"
            ]
          }
        },
        {
          "text": "guardó todas mis sendas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.11",
            "verseOrgIds": [
              "JOB.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí en esto no has hablado justamente:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.12",
            "verseOrgIds": [
              "JOB.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:12"
      },
      "items": [
        {
          "text": "Yo te responderé que mayor es Dios que el hombre.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.12",
            "verseOrgIds": [
              "JOB.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Grandeza, justicia,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 y misericordia de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Por qué tomaste",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.13",
            "verseOrgIds": [
              "JOB.33.13"
            ]
          }
        },
        {
          "text": "pleito contra él?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.13",
            "verseOrgIds": [
              "JOB.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:13"
      },
      "items": [
        {
          "text": "Porque él no da cuenta de ninguna de sus razones.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.13",
            "verseOrgIds": [
              "JOB.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sin embargo, en una ó en dos",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.14",
            "verseOrgIds": [
              "JOB.33.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "maneras",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.14",
                "verseOrgIds": [
                  "JOB.33.14"
                ]
              }
            }
          ]
        },
        {
          "text": "habla Dios;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.14",
            "verseOrgIds": [
              "JOB.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:14"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Mas el hombre",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.14",
                "verseOrgIds": [
                  "JOB.33.14"
                ]
              }
            }
          ]
        },
        {
          "text": "no entiende.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.14",
            "verseOrgIds": [
              "JOB.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por sueño de visión nocturna,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.15",
            "verseOrgIds": [
              "JOB.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:15"
      },
      "items": [
        {
          "text": "Cuando el sueño cae sobre los hombres,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.15",
            "verseOrgIds": [
              "JOB.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:15"
      },
      "items": [
        {
          "text": "Cuando se adormecen sobre el lecho;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.15",
            "verseOrgIds": [
              "JOB.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entonces revela al oído de los hombres,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.16",
            "verseOrgIds": [
              "JOB.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:16"
      },
      "items": [
        {
          "text": "Y les señala su consejo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.16",
            "verseOrgIds": [
              "JOB.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para quitar al hombre de",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.17",
            "verseOrgIds": [
              "JOB.33.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "su",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.17",
                "verseOrgIds": [
                  "JOB.33.17"
                ]
              }
            }
          ]
        },
        {
          "text": "obra,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.17",
            "verseOrgIds": [
              "JOB.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:17"
      },
      "items": [
        {
          "text": "Y apartar del varón la soberbia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.17",
            "verseOrgIds": [
              "JOB.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Detendrá su alma de corrupción,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.18",
            "verseOrgIds": [
              "JOB.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:18"
      },
      "items": [
        {
          "text": "Y su vida de que pase á cuchillo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.18",
            "verseOrgIds": [
              "JOB.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "También sobre su cama es castigado",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.19",
            "verseOrgIds": [
              "JOB.33.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:19"
      },
      "items": [
        {
          "text": "Con dolor fuerte en todos sus huesos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.19",
            "verseOrgIds": [
              "JOB.33.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que le hace que su vida aborrezca el pan,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.20",
            "verseOrgIds": [
              "JOB.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:20"
      },
      "items": [
        {
          "text": "Y su alma la comida suave.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.20",
            "verseOrgIds": [
              "JOB.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Su carne desfallece sin verse,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.21",
            "verseOrgIds": [
              "JOB.33.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:21"
      },
      "items": [
        {
          "text": "Y sus huesos, que antes no se veían, aparecen.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.21",
            "verseOrgIds": [
              "JOB.33.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y su alma se acerca al sepulcro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.22",
            "verseOrgIds": [
              "JOB.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:22"
      },
      "items": [
        {
          "text": "Y su vida á los que causan la muerte.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.22",
            "verseOrgIds": [
              "JOB.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si tuviera cerca de él",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.23",
            "verseOrgIds": [
              "JOB.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:23"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Algún",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.23",
                "verseOrgIds": [
                  "JOB.33.23"
                ]
              }
            }
          ]
        },
        {
          "text": "elocuente anunciador muy escogido,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.23",
            "verseOrgIds": [
              "JOB.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:23"
      },
      "items": [
        {
          "text": "Que anuncie al hombre su deber;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.23",
            "verseOrgIds": [
              "JOB.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que le diga que",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Dios",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.24",
                "verseOrgIds": [
                  "JOB.33.24"
                ]
              }
            }
          ]
        },
        {
          "text": "tuvo de él misericordia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:24"
      },
      "items": [
        {
          "text": "Que lo libró de descender al sepulcro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:24"
      },
      "items": [
        {
          "text": "Que halló redención;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enterneceráse su carne más que de niño,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.25",
            "verseOrgIds": [
              "JOB.33.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:25"
      },
      "items": [
        {
          "text": "Volverá á los días de su mocedad.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.25",
            "verseOrgIds": [
              "JOB.33.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orará á Dios, y le amará,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.26",
            "verseOrgIds": [
              "JOB.33.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:26"
      },
      "items": [
        {
          "text": "Y verá su faz con júbilo:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.26",
            "verseOrgIds": [
              "JOB.33.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:26"
      },
      "items": [
        {
          "text": "Y él restituirá al hombre su justicia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.26",
            "verseOrgIds": [
              "JOB.33.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 33:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "El mira sobre los hombres; y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "el que",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.27",
                "verseOrgIds": [
                  "JOB.33.27"
                ]
              }
            }
          ]
        },
        {
          "text": "dijere:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:27"
      },
      "items": [
        {
          "text": "Pequé, y pervertí lo recto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:27"
      },
      "items": [
        {
          "text": "Y no me ha aprovechado;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 33:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Dios",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.28",
                "verseOrgIds": [
                  "JOB.33.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.28",
            "verseOrgIds": [
              "JOB.33.28"
            ]
          }
        },
        {
          "text": "redimirá su alma, que no pase al sepulcro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.28",
            "verseOrgIds": [
              "JOB.33.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:28"
      },
      "items": [
        {
          "text": "Y su vida se verá en luz.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.28",
            "verseOrgIds": [
              "JOB.33.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 33:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí, todas estas cosas hace Dios",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.29",
            "verseOrgIds": [
              "JOB.33.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:29"
      },
      "items": [
        {
          "text": "Dos y tres veces con el hombre;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.29",
            "verseOrgIds": [
              "JOB.33.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 33:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para apartar su alma del sepulcro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.30",
            "verseOrgIds": [
              "JOB.33.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:30"
      },
      "items": [
        {
          "text": "Y para iluminarlo con la luz de los vivientes.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.30",
            "verseOrgIds": [
              "JOB.33.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 33:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Escucha, Job, y óyeme;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.31",
            "verseOrgIds": [
              "JOB.33.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:31"
      },
      "items": [
        {
          "text": "Calla, y yo hablaré.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.31",
            "verseOrgIds": [
              "JOB.33.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 33:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que si tuvieres razones, respóndeme:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.32",
            "verseOrgIds": [
              "JOB.33.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 33:32"
      },
      "items": [
        {
          "text": "Habla, porque yo te quiero justificar.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.32",
            "verseOrgIds": [
              "JOB.33.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 33:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
