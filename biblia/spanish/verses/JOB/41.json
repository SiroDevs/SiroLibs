{
  "id": "JOB.41",
  "number": "41",
  "bookId": "JOB",
  "reference": "Job 41",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "JOB 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿SACARÁS tú al",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.1",
            "verseOrgIds": [
              "JOB.40.25"
            ]
          }
        },
        {
          "text": "leviathán con el anzuelo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.1",
            "verseOrgIds": [
              "JOB.40.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:1"
      },
      "items": [
        {
          "text": "O con la cuerda que le echares en su lengua?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.1",
            "verseOrgIds": [
              "JOB.40.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Pondrás tú garfio en sus narices,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.2",
            "verseOrgIds": [
              "JOB.40.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:2"
      },
      "items": [
        {
          "text": "Y horadarás con espinas su quijada?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.2",
            "verseOrgIds": [
              "JOB.40.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Multiplicará él ruegos para contigo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.3",
            "verseOrgIds": [
              "JOB.40.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:3"
      },
      "items": [
        {
          "text": "¿Hablaráte él lisonjas?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.3",
            "verseOrgIds": [
              "JOB.40.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Hará concierto contigo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.4",
            "verseOrgIds": [
              "JOB.40.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:4"
      },
      "items": [
        {
          "text": "Para que lo tomes por siervo perpetuo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.4",
            "verseOrgIds": [
              "JOB.40.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Jugarás tú con él como con pájaro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.5",
            "verseOrgIds": [
              "JOB.40.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:5"
      },
      "items": [
        {
          "text": "O lo atarás para tus niñas?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.5",
            "verseOrgIds": [
              "JOB.40.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Harán de él banquete",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.6",
            "verseOrgIds": [
              "JOB.40.30"
            ]
          }
        },
        {
          "text": "los compañeros?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.6",
            "verseOrgIds": [
              "JOB.40.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:6"
      },
      "items": [
        {
          "text": "¿Partiránlo entre",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.6",
            "verseOrgIds": [
              "JOB.40.30"
            ]
          }
        },
        {
          "text": "los mercaderes?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.6",
            "verseOrgIds": [
              "JOB.40.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Cortarás tú con cuchillo su cuero,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.7",
            "verseOrgIds": [
              "JOB.40.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:7"
      },
      "items": [
        {
          "text": "O con asta de pescadores su cabeza?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.7",
            "verseOrgIds": [
              "JOB.40.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Dios muestra á Job",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 sus grandes obras.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pon tu mano sobre él;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.8",
            "verseOrgIds": [
              "JOB.40.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:8"
      },
      "items": [
        {
          "text": "Te acordarás de la batalla, y nunca más tornarás.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.8",
            "verseOrgIds": [
              "JOB.40.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí que la esperanza acerca de él será burlada:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.9",
            "verseOrgIds": [
              "JOB.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:9"
      },
      "items": [
        {
          "text": "Porque aun á su sola vista se desmayarán.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.9",
            "verseOrgIds": [
              "JOB.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nadie hay tan osado que lo despierte:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.10",
            "verseOrgIds": [
              "JOB.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:10"
      },
      "items": [
        {
          "text": "¿Quién pues podrá estar delante de mí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.10",
            "verseOrgIds": [
              "JOB.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién me ha anticipado, para que yo restituya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.11",
            "verseOrgIds": [
              "JOB.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:11"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Todo lo que hay",
              "type": "text",
              "attrs": {
                "verseId": "JOB.41.11",
                "verseOrgIds": [
                  "JOB.41.3"
                ]
              }
            }
          ]
        },
        {
          "text": "debajo del cielo es mío.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.11",
            "verseOrgIds": [
              "JOB.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo no callaré sus miembros,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.12",
            "verseOrgIds": [
              "JOB.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:12"
      },
      "items": [
        {
          "text": "Ni lo de sus fuerzas y la gracia de su disposición.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.12",
            "verseOrgIds": [
              "JOB.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién descubrirá la delantera de su vestidura?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.13",
            "verseOrgIds": [
              "JOB.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:13"
      },
      "items": [
        {
          "text": "¿Quién se llegará á él con freno doble?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.13",
            "verseOrgIds": [
              "JOB.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién abrirá las puertas de su rostro?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.14",
            "verseOrgIds": [
              "JOB.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:14"
      },
      "items": [
        {
          "text": "Los órdenes de sus dientes espantan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.14",
            "verseOrgIds": [
              "JOB.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "La gloria",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.15",
            "verseOrgIds": [
              "JOB.41.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "de su vestido son",
              "type": "text",
              "attrs": {
                "verseId": "JOB.41.15",
                "verseOrgIds": [
                  "JOB.41.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.15",
            "verseOrgIds": [
              "JOB.41.7"
            ]
          }
        },
        {
          "text": "escudos fuertes,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.15",
            "verseOrgIds": [
              "JOB.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:15"
      },
      "items": [
        {
          "text": "Cerrados entre sí estrechamente.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.15",
            "verseOrgIds": [
              "JOB.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "El uno se junta con el otro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.16",
            "verseOrgIds": [
              "JOB.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:16"
      },
      "items": [
        {
          "text": "Que viento no entra entre ellos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.16",
            "verseOrgIds": [
              "JOB.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pegado está el uno con el otro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.17",
            "verseOrgIds": [
              "JOB.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:17"
      },
      "items": [
        {
          "text": "Están trabados entre sí, que no se pueden apartar.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.17",
            "verseOrgIds": [
              "JOB.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con sus estornudos encienden lumbre,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.18",
            "verseOrgIds": [
              "JOB.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:18"
      },
      "items": [
        {
          "text": "Y sus ojos son como los párpados del alba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.18",
            "verseOrgIds": [
              "JOB.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "De su boca salen hachas de fuego,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.19",
            "verseOrgIds": [
              "JOB.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:19"
      },
      "items": [
        {
          "text": "Centellas de fuego proceden.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.19",
            "verseOrgIds": [
              "JOB.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 41:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "De sus narices sale humo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.20",
            "verseOrgIds": [
              "JOB.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:20"
      },
      "items": [
        {
          "text": "Como de una olla ó caldero que hierve.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.20",
            "verseOrgIds": [
              "JOB.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Su aliento enciende los carbones,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.21",
            "verseOrgIds": [
              "JOB.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:21"
      },
      "items": [
        {
          "text": "Y de su boca sale llama.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.21",
            "verseOrgIds": [
              "JOB.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 41:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "En su cerviz mora la fortaleza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.22",
            "verseOrgIds": [
              "JOB.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:22"
      },
      "items": [
        {
          "text": "Y espárcese el desaliento delante de él.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.22",
            "verseOrgIds": [
              "JOB.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 41:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las partes momias de su carne están apretadas:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.23",
            "verseOrgIds": [
              "JOB.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:23"
      },
      "items": [
        {
          "text": "Están en él firmes, y no se mueven.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.23",
            "verseOrgIds": [
              "JOB.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Su corazón es firme como una piedra,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.24",
            "verseOrgIds": [
              "JOB.41.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:24"
      },
      "items": [
        {
          "text": "Y fuerte como la muela de abajo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.24",
            "verseOrgIds": [
              "JOB.41.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "De su grandeza tienen temor los fuertes,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.25",
            "verseOrgIds": [
              "JOB.41.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:25"
      },
      "items": [
        {
          "text": "Y á causa de su desfallecimiento hacen por purificarse.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.25",
            "verseOrgIds": [
              "JOB.41.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando alguno lo alcanzare, ni espada,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.26",
            "verseOrgIds": [
              "JOB.41.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:26"
      },
      "items": [
        {
          "text": "Ni lanza, ni dardo, ni coselete durará.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.26",
            "verseOrgIds": [
              "JOB.41.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 41:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hierro estima por pajas,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.27",
            "verseOrgIds": [
              "JOB.41.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:27"
      },
      "items": [
        {
          "text": "Y el acero por leño podrido.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.27",
            "verseOrgIds": [
              "JOB.41.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 41:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saeta no le hace huir;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.28",
            "verseOrgIds": [
              "JOB.41.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:28"
      },
      "items": [
        {
          "text": "Las piedras de honda se le tornan aristas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.28",
            "verseOrgIds": [
              "JOB.41.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 41:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiene toda arma por hojarascas,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.29",
            "verseOrgIds": [
              "JOB.41.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:29"
      },
      "items": [
        {
          "text": "Y del blandir de la pica se burla.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.29",
            "verseOrgIds": [
              "JOB.41.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 41:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por debajo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.30",
            "verseOrgIds": [
              "JOB.41.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "tiene",
              "type": "text",
              "attrs": {
                "verseId": "JOB.41.30",
                "verseOrgIds": [
                  "JOB.41.22"
                ]
              }
            }
          ]
        },
        {
          "text": "agudas conchas;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.30",
            "verseOrgIds": [
              "JOB.41.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:30"
      },
      "items": [
        {
          "text": "Imprime",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.30",
            "verseOrgIds": [
              "JOB.41.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "su",
              "type": "text",
              "attrs": {
                "verseId": "JOB.41.30",
                "verseOrgIds": [
                  "JOB.41.22"
                ]
              }
            }
          ]
        },
        {
          "text": "agudez en el suelo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.30",
            "verseOrgIds": [
              "JOB.41.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 41:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hace hervir como una olla la profunda mar,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.31",
            "verseOrgIds": [
              "JOB.41.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:31"
      },
      "items": [
        {
          "text": "Y tórnala como una olla de ungüento.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.31",
            "verseOrgIds": [
              "JOB.41.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 41:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "En pos de sí hace resplandecer la senda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.32",
            "verseOrgIds": [
              "JOB.41.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:32"
      },
      "items": [
        {
          "text": "Que parece que la mar es cana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.32",
            "verseOrgIds": [
              "JOB.41.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 41:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "No hay sobre la tierra su semejante,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.33",
            "verseOrgIds": [
              "JOB.41.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:33"
      },
      "items": [
        {
          "text": "Hecho para nada temer.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.33",
            "verseOrgIds": [
              "JOB.41.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 41:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menosprecia toda cosa alta:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.34",
            "verseOrgIds": [
              "JOB.41.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 41:34"
      },
      "items": [
        {
          "text": "Es rey sobre todos los soberbios.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.34",
            "verseOrgIds": [
              "JOB.41.26"
            ]
          }
        }
      ]
    }
  ],
