{
  "id": "JOB.35",
  "number": "35",
  "bookId": "JOB",
  "reference": "Job 35",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "JOB 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y PROCEDIENDO Eliú en su razonamiento, dijo:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.1",
            "verseOrgIds": [
              "JOB.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 y ensalza la grandeza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 y el poder de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Piensas ser conforme á derecho",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.2",
            "verseOrgIds": [
              "JOB.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:2"
      },
      "items": [
        {
          "text": "Esto",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.2",
            "verseOrgIds": [
              "JOB.35.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "que",
              "type": "text",
              "attrs": {
                "verseId": "JOB.35.2",
                "verseOrgIds": [
                  "JOB.35.2"
                ]
              }
            }
          ]
        },
        {
          "text": "dijiste: Más justo soy yo que Dios?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.2",
            "verseOrgIds": [
              "JOB.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque dijiste:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.3",
            "verseOrgIds": [
              "JOB.35.3"
            ]
          }
        },
        {
          "text": "¿Qué ventaja sacarás tú de ello?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.3",
            "verseOrgIds": [
              "JOB.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:3"
      },
      "items": [
        {
          "text": "¿O qué provecho tendré de mi pecado?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.3",
            "verseOrgIds": [
              "JOB.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo te responderé razones,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.4",
            "verseOrgIds": [
              "JOB.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:4"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.4",
            "verseOrgIds": [
              "JOB.35.4"
            ]
          }
        },
        {
          "text": "a tus compañeros contigo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.4",
            "verseOrgIds": [
              "JOB.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mira á los cielos, y ve,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.5",
            "verseOrgIds": [
              "JOB.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:5"
      },
      "items": [
        {
          "text": "Y considera que las nubes son más altas que tú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.5",
            "verseOrgIds": [
              "JOB.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si pecares,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.6",
            "verseOrgIds": [
              "JOB.35.6"
            ]
          }
        },
        {
          "text": "¿qué habrás hecho contra él?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.6",
            "verseOrgIds": [
              "JOB.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:6"
      },
      "items": [
        {
          "text": "Y si tus rebeliones se multiplicaren, ¿qué le harás tú?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.6",
            "verseOrgIds": [
              "JOB.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si fueres justo, ¿qué le darás á el?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.7",
            "verseOrgIds": [
              "JOB.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:7"
      },
      "items": [
        {
          "text": "¿O qué recibirá de tu mano?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.7",
            "verseOrgIds": [
              "JOB.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al hombre como tú",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.8",
            "verseOrgIds": [
              "JOB.35.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "dañará",
              "type": "text",
              "attrs": {
                "verseId": "JOB.35.8",
                "verseOrgIds": [
                  "JOB.35.8"
                ]
              }
            }
          ]
        },
        {
          "text": "tu impiedad,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.8",
            "verseOrgIds": [
              "JOB.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:8"
      },
      "items": [
        {
          "text": "Y al hijo del hombre",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.8",
            "verseOrgIds": [
              "JOB.35.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "aprovechará",
              "type": "text",
              "attrs": {
                "verseId": "JOB.35.8",
                "verseOrgIds": [
                  "JOB.35.8"
                ]
              }
            }
          ]
        },
        {
          "text": "tu justicia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.8",
            "verseOrgIds": [
              "JOB.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A causa de la multitud de las violencias clamarán,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.9",
            "verseOrgIds": [
              "JOB.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:9"
      },
      "items": [
        {
          "text": "Y se lamentarán por el poderío de los grandes.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.9",
            "verseOrgIds": [
              "JOB.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y ninguno dice: ¿Dónde está Dios mi Hacedor,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.10",
            "verseOrgIds": [
              "JOB.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:10"
      },
      "items": [
        {
          "text": "Que da canciones en la noche,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.10",
            "verseOrgIds": [
              "JOB.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que nos enseña más que á las bestias de la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.11",
            "verseOrgIds": [
              "JOB.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:11"
      },
      "items": [
        {
          "text": "Y nos hace sabios más que las aves del cielo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.11",
            "verseOrgIds": [
              "JOB.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Allí clamarán, y él no oirá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.12",
            "verseOrgIds": [
              "JOB.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:12"
      },
      "items": [
        {
          "text": "Por la soberbia de los malos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.12",
            "verseOrgIds": [
              "JOB.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciertamente Dios no oirá la vanidad,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.13",
            "verseOrgIds": [
              "JOB.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:13"
      },
      "items": [
        {
          "text": "Ni la mirará el Omnipotente.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.13",
            "verseOrgIds": [
              "JOB.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aunque más digas, No lo mirará;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:14"
      },
      "items": [
        {
          "text": "Haz juicio delante de él, y en él espera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas ahora, porque",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.15",
            "verseOrgIds": [
              "JOB.35.15"
            ]
          }
        },
        {
          "text": "en su ira no visita,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.15",
            "verseOrgIds": [
              "JOB.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:15"
      },
      "items": [
        {
          "text": "Ni conoce con rigor,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.15",
            "verseOrgIds": [
              "JOB.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:15"
      },
      "items": [
        {
          "text": "Por eso Job abrió su boca vanamente,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.15",
            "verseOrgIds": [
              "JOB.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 35:15"
      },
      "items": [
        {
          "text": "Y multiplica palabras sin sabiduría.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.15",
            "verseOrgIds": [
              "JOB.35.15"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "JOB.36",
    "number": "36",
    "bookId": "JOB"
  },
  "previous": {
    "id": "JOB.34",
