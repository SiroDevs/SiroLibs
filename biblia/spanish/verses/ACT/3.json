              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "A vosotros primeramente, Dios, habiendo levantado á su Hijo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.26",
            "verseOrgIds": [
              "ACT.3.26"
            ]
          }
        },
        {
          "text": "le envió para que os bendijese,",
