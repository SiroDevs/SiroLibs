              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vosotros sois los hijos de los profetas, y del pacto que Dios concertó con nuestros padres, diciendo á Abraham:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.25",
            "verseOrgIds": [
              "ACT.3.25"
            ]
          }
        },
        {
          "text": "Y en tu simiente serán benditas todas las familias de la tierra.",
          "type": "text",
          "attrs": {
