          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Confirmando los ánimos de los discípulos, exhortándoles á que permaneciesen en la fe, y",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.22",
            "verseOrgIds": [
              "ACT.14.22"
            ]
          }
        },
        {
          "text": "que es menester que por muchas tribulaciones entremos en el reino de Dios.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.22",
            "verseOrgIds": [
              "ACT.14.22"
            ]
          }
        }
      ]
    },
