          ]
        },
        {
          "text": "Y habiéndoles constituído",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.23",
            "verseOrgIds": [
              "ACT.14.23"
            ]
          }
        },
        {
          "text": "ancianos en cada una de las iglesias, y habiendo orado con ayunos, los encomendaron al Señor en el cual habían creído.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.23",
            "verseOrgIds": [
              "ACT.14.23"
