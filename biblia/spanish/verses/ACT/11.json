          "attrs": {
            "verseId": "ACT.11.25",
            "verseOrgIds": [
              "ACT.11.25"
            ]
          }
        },
        {
          "text": "Tarso á buscar á Saulo; y hallado, le trajo á Antioquía.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.25",
            "verseOrgIds": [
              "ACT.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
