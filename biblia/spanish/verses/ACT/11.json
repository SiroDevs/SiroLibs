          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y conversaron todo un año allí con la iglesia, y enseñaron á mucha gente; y los discípulos fueron llamados",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.26",
            "verseOrgIds": [
              "ACT.11.26"
            ]
          }
        },
        {
          "text": "Cristianos primeramente en",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.26",
            "verseOrgIds": [
              "ACT.11.26"
            ]
          }
        },
        {
          "text": "Antioquía.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.26",
            "verseOrgIds": [
              "ACT.11.26"
            ]
          }
        }
      ]
