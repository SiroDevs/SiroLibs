{
  "id": "PSA.79",
  "number": "79",
  "bookId": "PSA",
  "reference": "Salmos 79",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "79",
        "style": "c",
        "sid": "PSA 79"
      },
      "items": [
        {
          "text": "79",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo de Asaph.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 79:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OH Dios, vinieron",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        },
        {
          "text": "las gentes á",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        },
        {
          "text": "tu heredad;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:1"
      },
      "items": [
        {
          "text": "El templo de tu santidad han contaminado;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:1"
      },
      "items": [
        {
          "text": "Pusieron á Jerusalem en montones.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 79:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dieron los cuerpos de tus siervos por comida á las aves de los cielos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:2"
      },
      "items": [
        {
          "text": "La carne de tus santos á las bestias de la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 El pueblo, afligido y en afrenta,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 se vuelve arrepentido á Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 79:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Derramaron su sangre como agua en los alrededores de Jerusalem;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:3"
      },
      "items": [
        {
          "text": "Y no hubo quien",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "los",
              "type": "text",
              "attrs": {
                "verseId": "PSA.79.3",
                "verseOrgIds": [
                  "PSA.79.3"
                ]
              }
            }
          ]
        },
        {
          "text": "enterrase.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 79:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Somos afrentados de nuestros vecinos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.4",
            "verseOrgIds": [
              "PSA.79.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:4"
      },
      "items": [
        {
          "text": "Escarnecidos y burlados de los que están en nuestros alrededores.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.4",
            "verseOrgIds": [
              "PSA.79.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 79:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Hasta cuándo, oh Jehová? ¿has de estar airado para siempre?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.5",
            "verseOrgIds": [
              "PSA.79.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:5"
      },
      "items": [
        {
          "text": "¿Arderá como fuego tu celo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.5",
            "verseOrgIds": [
              "PSA.79.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 79:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Derrama tu ira sobre las gentes que no te conocen,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:6"
      },
      "items": [
        {
          "text": "Y sobre los reinos que no invocan tu nombre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 79:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque han consumido á Jacob,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.7",
            "verseOrgIds": [
              "PSA.79.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:7"
      },
      "items": [
        {
          "text": "Y su morada han asolado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.7",
            "verseOrgIds": [
              "PSA.79.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 79:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "No recuerdes contra nosotros las iniquidades antiguas:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:8"
      },
      "items": [
        {
          "text": "Anticípennos presto tus misericordias,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:8"
      },
      "items": [
        {
          "text": "Porque estamos muy abatidos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 79:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayúdanos, oh Dios, salud nuestra, por la gloria de tu nombre:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:9"
      },
      "items": [
        {
          "text": "Y líbranos, y aplácate sobre nuestros pecados",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        },
        {
          "text": "por amor de tu nombre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 79:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque dirán las gentes: ¿Dónde está su Dios?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "Sea notoria en las gentes, delante de nuestros ojos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "La",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        },
        {
          "text": "venganza de la sangre de tus siervos, que fué derramada.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 79:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entre ante tu acatamiento el gemido de los presos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.11",
            "verseOrgIds": [
              "PSA.79.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:11"
      },
      "items": [
        {
          "text": "Conforme á la grandeza de tu brazo preserva á los sentenciados á muerte.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.11",
            "verseOrgIds": [
              "PSA.79.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 79:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y torna á nuestros vecinos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.12",
            "verseOrgIds": [
              "PSA.79.12"
            ]
          }
        },
        {
          "text": "en su seno",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.12",
            "verseOrgIds": [
              "PSA.79.12"
            ]
          }
        },
        {
          "text": "siete tantos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.12",
            "verseOrgIds": [
              "PSA.79.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:12"
      },
      "items": [
        {
          "text": "De su infamia, con que te han deshonrado, oh Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.12",
            "verseOrgIds": [
              "PSA.79.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 79:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.13",
            "verseOrgIds": [
              "PSA.79.13"
            ]
          }
        },
        {
          "text": "nosotros, pueblo tuyo, y ovejas de tu dehesa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.13",
            "verseOrgIds": [
              "PSA.79.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:13"
      },
      "items": [
        {
          "text": "Te alabaremos para siempre:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.13",
            "verseOrgIds": [
              "PSA.79.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 79:13"
      },
      "items": [
        {
          "text": "Por generación y generación cantaremos tus alabanzas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.13",
            "verseOrgIds": [
              "PSA.79.13"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.80",
    "number": "80",
