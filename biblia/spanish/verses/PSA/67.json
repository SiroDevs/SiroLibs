{
  "id": "PSA.67",
  "number": "67",
  "bookId": "PSA",
  "reference": "Salmos 67",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "67",
        "style": "c",
        "sid": "PSA 67"
      },
      "items": [
        {
          "text": "67",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: en Neginoth: Salmo: Cántico.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 67:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "DIOS tenga misericordia de nosotros, y nos bendiga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.1",
            "verseOrgIds": [
              "PSA.67.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 67:1"
      },
      "items": [
        {
          "text": "Haga resplandecer su rostro sobre nosotros (Selah);",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.1",
            "verseOrgIds": [
              "PSA.67.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 67:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.2",
            "verseOrgIds": [
              "PSA.67.3"
            ]
          }
        },
        {
          "text": "que sea conocido en la tierra tu camino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.2",
            "verseOrgIds": [
              "PSA.67.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 67:2"
      },
      "items": [
        {
          "text": "En todas las gentes tu salud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.2",
            "verseOrgIds": [
              "PSA.67.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 67:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alábente los pueblos, oh Dios;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.3",
            "verseOrgIds": [
              "PSA.67.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 67:3"
      },
      "items": [
        {
          "text": "Alábente los pueblos todos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.3",
            "verseOrgIds": [
              "PSA.67.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 67:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alégrense y gocénse las gentes;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.4",
            "verseOrgIds": [
              "PSA.67.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 67:4"
      },
      "items": [
        {
          "text": "Porque juzgarás los pueblos con equidad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.4",
            "verseOrgIds": [
              "PSA.67.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 67:4"
      },
      "items": [
        {
          "text": "Y pastorearás las naciones en la tierra. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.4",
            "verseOrgIds": [
              "PSA.67.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 67:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alábente los pueblos, oh Dios:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.5",
            "verseOrgIds": [
              "PSA.67.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 67:5"
      },
      "items": [
        {
          "text": "Todos los pueblos te alaben.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.5",
            "verseOrgIds": [
              "PSA.67.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 67:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "La tierra dará su fruto:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.6",
            "verseOrgIds": [
              "PSA.67.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 67:6"
      },
      "items": [
        {
          "text": "Nos bendecirá Dios, el Dios nuestro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.6",
            "verseOrgIds": [
              "PSA.67.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 67:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bendíganos Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.7",
            "verseOrgIds": [
              "PSA.67.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 67:7"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.7",
            "verseOrgIds": [
              "PSA.67.8"
            ]
          }
        },
        {
          "text": "témanlo todos los fines de la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.7",
            "verseOrgIds": [
              "PSA.67.8"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.68",
    "number": "68",
