{
  "id": "PSA.102",
  "number": "102",
  "bookId": "PSA",
  "reference": "Salmos 102",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "102",
        "style": "c",
        "sid": "PSA 102"
      },
      "items": [
        {
          "text": "102",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Oración del pobre, cuando estuviere angustiado, y delante de Jehová derramare su lamento.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 102:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "JEHOVÁ, oye mi oración,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.1",
            "verseOrgIds": [
              "PSA.102.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:1"
      },
      "items": [
        {
          "text": "Y venga mi clamor á ti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.1",
            "verseOrgIds": [
              "PSA.102.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 102:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "No escondas de mí tu rostro: en el día de mi angustia",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:2"
      },
      "items": [
        {
          "text": "Inclina á mí tu oído;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:2"
      },
      "items": [
        {
          "text": "El día que",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "te",
              "type": "text",
              "attrs": {
                "verseId": "PSA.102.2",
                "verseOrgIds": [
                  "PSA.102.3"
                ]
              }
            }
          ]
        },
        {
          "text": "invocare, apresúrate á responderme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 102:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque mis días se han consumido como humo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.3",
            "verseOrgIds": [
              "PSA.102.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:3"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.3",
            "verseOrgIds": [
              "PSA.102.4"
            ]
          }
        },
        {
          "text": "mis huesos cual tizón están quemados.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.3",
            "verseOrgIds": [
              "PSA.102.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 102:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi corazón fué herido, y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.4",
            "verseOrgIds": [
              "PSA.102.5"
            ]
          }
        },
        {
          "text": "secóse como la hierba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.4",
            "verseOrgIds": [
              "PSA.102.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:4"
      },
      "items": [
        {
          "text": "Por lo cual",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.4",
            "verseOrgIds": [
              "PSA.102.5"
            ]
          }
        },
        {
          "text": "me olvidé de comer mi pan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.4",
            "verseOrgIds": [
              "PSA.102.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 102:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por la voz de mi gemido",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.5",
            "verseOrgIds": [
              "PSA.102.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:5"
      },
      "items": [
        {
          "text": "Mis huesos se han pegado á mi carne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.5",
            "verseOrgIds": [
              "PSA.102.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 102:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soy semejante al pelícano del desierto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.6",
            "verseOrgIds": [
              "PSA.102.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:6"
      },
      "items": [
        {
          "text": "Soy como el buho de las soledades.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.6",
            "verseOrgIds": [
              "PSA.102.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 102:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Velo, y soy",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.7",
            "verseOrgIds": [
              "PSA.102.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:7"
      },
      "items": [
        {
          "text": "Como el pájaro solitario sobre el tejado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.7",
            "verseOrgIds": [
              "PSA.102.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 102:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cada día me afrentan mis enemigos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.8",
            "verseOrgIds": [
              "PSA.102.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:8"
      },
      "items": [
        {
          "text": "Los que se enfurecen contra mí, hanse contra mí conjurado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.8",
            "verseOrgIds": [
              "PSA.102.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 102:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por lo que como la ceniza á manera de pan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.9",
            "verseOrgIds": [
              "PSA.102.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:9"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.9",
            "verseOrgIds": [
              "PSA.102.10"
            ]
          }
        },
        {
          "text": "mi bebida mezclo con lloro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.9",
            "verseOrgIds": [
              "PSA.102.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 102:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A causa de tu enojo y de tu ira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.10",
            "verseOrgIds": [
              "PSA.102.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:10"
      },
      "items": [
        {
          "text": "Pues me alzaste, y me has arrojado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.10",
            "verseOrgIds": [
              "PSA.102.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 102:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mis días son como la sombra que se va;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.11",
            "verseOrgIds": [
              "PSA.102.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:11"
      },
      "items": [
        {
          "text": "Y heme secado como la hierba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.11",
            "verseOrgIds": [
              "PSA.102.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 102:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        },
        {
          "text": "tú, Jehová, permanecerás para siempre,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:12"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        },
        {
          "text": "tu memoria para generación y generación.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 102:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú levantándote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        },
        {
          "text": "tendrás misericordia de Sión;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:13"
      },
      "items": [
        {
          "text": "Porque el tiempo de tener misericordia de ella, porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        },
        {
          "text": "el plazo es llegado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 102:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque tus siervos aman sus piedras,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.14",
            "verseOrgIds": [
              "PSA.102.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:14"
      },
      "items": [
        {
          "text": "Y del polvo de ella tienen compasión.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.14",
            "verseOrgIds": [
              "PSA.102.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 102:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entonces temerán las gentes el",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.15",
            "verseOrgIds": [
              "PSA.102.16"
            ]
          }
        },
        {
          "text": "nombre de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.15",
            "verseOrgIds": [
              "PSA.102.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:15"
      },
      "items": [
        {
          "text": "Y todos los reyes de la tierra tu gloria;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.15",
            "verseOrgIds": [
              "PSA.102.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 102:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por cuanto Jehová habrá edificado á Sión,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.16",
            "verseOrgIds": [
              "PSA.102.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:16"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.16",
            "verseOrgIds": [
              "PSA.102.17"
            ]
          }
        },
        {
          "text": "en su gloria será visto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.16",
            "verseOrgIds": [
              "PSA.102.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 102:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habrá mirado á la oración de los solitarios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.17",
            "verseOrgIds": [
              "PSA.102.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:17"
      },
      "items": [
        {
          "text": "Y no habrá desechado el ruego de ellos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.17",
            "verseOrgIds": [
              "PSA.102.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 102:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Escribirse",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.18",
            "verseOrgIds": [
              "PSA.102.19"
            ]
          }
        },
        {
          "text": "ha esto para la generación venidera:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.18",
            "verseOrgIds": [
              "PSA.102.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:18"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.18",
            "verseOrgIds": [
              "PSA.102.19"
            ]
          }
        },
        {
          "text": "el pueblo que se criará, alabará á JAH.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.18",
            "verseOrgIds": [
              "PSA.102.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 102:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque miró",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.19",
            "verseOrgIds": [
              "PSA.102.20"
            ]
          }
        },
        {
          "text": "de lo alto de su santuario;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.19",
            "verseOrgIds": [
              "PSA.102.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:19"
      },
      "items": [
        {
          "text": "Jehová miró de los cielos á la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.19",
            "verseOrgIds": [
              "PSA.102.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 102:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para oir el gemido de los presos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.20",
            "verseOrgIds": [
              "PSA.102.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:20"
      },
      "items": [
        {
          "text": "Para soltar á los sentenciados á muerte;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.20",
            "verseOrgIds": [
              "PSA.102.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 102:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque cuenten en Sión el nombre de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.21",
            "verseOrgIds": [
              "PSA.102.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:21"
      },
      "items": [
        {
          "text": "Y su alabanza en Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.21",
            "verseOrgIds": [
              "PSA.102.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 102:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando los pueblos se congregaren en uno,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.22",
            "verseOrgIds": [
              "PSA.102.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:22"
      },
      "items": [
        {
          "text": "Y los reinos, para servir á Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.22",
            "verseOrgIds": [
              "PSA.102.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 \"Bendice, alma mía,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 á Jehová.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 102:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "El afligió mi fuerza en el camino;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.23",
            "verseOrgIds": [
              "PSA.102.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:23"
      },
      "items": [
        {
          "text": "Acortó mis días.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.23",
            "verseOrgIds": [
              "PSA.102.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 102:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dije: Dios mío, no me cortes en el medio de mis días:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.24",
            "verseOrgIds": [
              "PSA.102.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:24"
      },
      "items": [
        {
          "text": "Por generación de generaciones son tus años.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.24",
            "verseOrgIds": [
              "PSA.102.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 102:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú fundaste la tierra antiguamente,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.25",
            "verseOrgIds": [
              "PSA.102.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:25"
      },
      "items": [
        {
          "text": "Y los cielos son obra de tus manos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.25",
            "verseOrgIds": [
              "PSA.102.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 102:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ellos perecerán, y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
          }
        },
        {
          "text": "tú permanecerás;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:26"
      },
      "items": [
        {
          "text": "Y todos ellos como un vestido se envejecerán;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:26"
      },
      "items": [
        {
          "text": "Como una ropa de vestir los mudarás, y serán mudados:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PSA 102:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.27",
            "verseOrgIds": [
              "PSA.102.28"
            ]
          }
        },
        {
          "text": "tú eres el mismo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.27",
            "verseOrgIds": [
              "PSA.102.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:27"
      },
      "items": [
        {
          "text": "Y tus años no se acabarán.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.27",
            "verseOrgIds": [
              "PSA.102.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 102:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los hijos de tus siervos habitarán,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.28",
            "verseOrgIds": [
              "PSA.102.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 102:28"
      },
      "items": [
        {
          "text": "Y su simiente será afirmada delante de ti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.28",
            "verseOrgIds": [
              "PSA.102.29"
            ]
          }
        }
      ]
    }
  ],
