{
  "id": "PSA.28",
  "number": "28",
  "bookId": "PSA",
  "reference": "Salmos 28",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "PSA 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A TI clamaré, oh Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.1",
            "verseOrgIds": [
              "PSA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:1"
      },
      "items": [
        {
          "text": "Fortaleza mía:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.1",
            "verseOrgIds": [
              "PSA.28.1"
            ]
          }
        },
        {
          "text": "no te desentiendas de mí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.1",
            "verseOrgIds": [
              "PSA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:1"
      },
      "items": [
        {
          "text": "Porque no sea yo, dejándome tú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.1",
            "verseOrgIds": [
              "PSA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:1"
      },
      "items": [
        {
          "text": "Semejante á los que descienden al sepulcro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.1",
            "verseOrgIds": [
              "PSA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Oración del afligido.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 La majestad de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oye la voz de mis ruegos cuando clamo á ti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.2",
            "verseOrgIds": [
              "PSA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:2"
      },
      "items": [
        {
          "text": "Cuando alzo mis manos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.2",
            "verseOrgIds": [
              "PSA.28.2"
            ]
          }
        },
        {
          "text": "hacia el templo de tu santidad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.2",
            "verseOrgIds": [
              "PSA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "No me arrebates á una con los malos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.3",
            "verseOrgIds": [
              "PSA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:3"
      },
      "items": [
        {
          "text": "Y con los que hacen iniquidad:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.3",
            "verseOrgIds": [
              "PSA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:3"
      },
      "items": [
        {
          "text": "Los cuales hablan paz con sus prójimos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.3",
            "verseOrgIds": [
              "PSA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:3"
      },
      "items": [
        {
          "text": "Y la maldad está en su corazón.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.3",
            "verseOrgIds": [
              "PSA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dales conforme á su obra, y conforme á la malicia de sus hechos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.4",
            "verseOrgIds": [
              "PSA.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:4"
      },
      "items": [
        {
          "text": "Dales conforme á la obra de sus manos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.4",
            "verseOrgIds": [
              "PSA.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:4"
      },
      "items": [
        {
          "text": "Dales su paga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.4",
            "verseOrgIds": [
              "PSA.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.5",
            "verseOrgIds": [
              "PSA.28.5"
            ]
          }
        },
        {
          "text": "no atendieron á las obras de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.5",
            "verseOrgIds": [
              "PSA.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:5"
      },
      "items": [
        {
          "text": "Ni al hecho de sus manos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.5",
            "verseOrgIds": [
              "PSA.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:5"
      },
      "items": [
        {
          "text": "Derribarálos, y no los edificará.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.5",
            "verseOrgIds": [
              "PSA.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bendito Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.6",
            "verseOrgIds": [
              "PSA.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:6"
      },
      "items": [
        {
          "text": "Que oyó la voz de mis ruegos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.6",
            "verseOrgIds": [
              "PSA.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová es mi fortaleza y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        },
        {
          "text": "mi escudo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:7"
      },
      "items": [
        {
          "text": "En él esperó mi corazón, y fuí ayudado;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:7"
      },
      "items": [
        {
          "text": "Por lo que se gozó mi corazón,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:7"
      },
      "items": [
        {
          "text": "Y con mi canción le alabaré.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová es su fuerza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.8",
            "verseOrgIds": [
              "PSA.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:8"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.8",
            "verseOrgIds": [
              "PSA.28.8"
            ]
          }
        },
        {
          "text": "la fortaleza de las saludes de su ungido.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.8",
            "verseOrgIds": [
              "PSA.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salva á tu pueblo, y bendice",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.9",
            "verseOrgIds": [
              "PSA.28.9"
            ]
          }
        },
        {
          "text": "a tu heredad;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.9",
            "verseOrgIds": [
              "PSA.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 28:9"
      },
      "items": [
        {
          "text": "Y pastoréalos y ensálzalos para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.9",
            "verseOrgIds": [
              "PSA.28.9"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.29",
    "number": "29",
    "bookId": "PSA"
  },
  "previous": {
    "id": "PSA.27",
    "number": "27",
