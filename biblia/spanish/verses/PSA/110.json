      },
      "items": [
        {
          "text": "110",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 110:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "JEHOVÁ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        },
        {
          "text": "dijo á mi Señor:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 110:1"
      },
      "items": [
        {
          "text": "Siéntate",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        },
        {
          "text": "a mi diestra,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 110:1"
      },
      "items": [
        {
          "text": "En tanto que pongo tus enemigos por estrado de tus pies.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 110:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "La",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.2",
            "verseOrgIds": [
              "PSA.110.2"
            ]
          }
        },
        {
          "text": "vara de tu fortaleza enviará Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.2",
            "verseOrgIds": [
              "PSA.110.2"
            ]
          }
        },
        {
          "text": "desde Sión:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.2",
            "verseOrgIds": [
              "PSA.110.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 110:2"
      },
      "items": [
        {
          "text": "Domina en medio de tus enemigos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.2",
            "verseOrgIds": [
              "PSA.110.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 110:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tu pueblo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.3",
            "verseOrgIds": [
              "PSA.110.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "serálo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.110.3",
                "verseOrgIds": [
                  "PSA.110.3"
                ]
              }
            }
          ]
        },
        {
          "text": "de buena voluntad en el día de tu poder,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.3",
            "verseOrgIds": [
              "PSA.110.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 110:3"
      },
      "items": [
        {
          "text": "En la hermosura de la santidad: desde el seno de la aurora,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.3",
            "verseOrgIds": [
              "PSA.110.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 110:3"
      },
      "items": [
        {
          "text": "Tienes tú el rocío de tu juventud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.3",
            "verseOrgIds": [
              "PSA.110.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 110:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juró Jehová, y no se arrepentirá:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.4",
            "verseOrgIds": [
              "PSA.110.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 110:4"
      },
      "items": [
        {
          "text": "Tú eres",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.4",
            "verseOrgIds": [
              "PSA.110.4"
            ]
          }
        },
        {
          "text": "sacerdote",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.4",
            "verseOrgIds": [
              "PSA.110.4"
            ]
          }
        },
        {
          "text": "para siempre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.4",
            "verseOrgIds": [
              "PSA.110.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 110:4"
      },
      "items": [
        {
          "text": "Según el orden de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.4",
            "verseOrgIds": [
              "PSA.110.4"
            ]
          }
        },
        {
          "text": "Melchîsedech.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.4",
            "verseOrgIds": [
              "PSA.110.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 110:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "El Señor",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.5",
            "verseOrgIds": [
              "PSA.110.5"
            ]
          }
        },
        {
          "text": "a tu diestra",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.5",
            "verseOrgIds": [
              "PSA.110.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 110:5"
      },
      "items": [
        {
          "text": "Herirá á los reyes",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.5",
            "verseOrgIds": [
              "PSA.110.5"
            ]
          }
        },
        {
          "text": "en el día de su furor:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.5",
            "verseOrgIds": [
              "PSA.110.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 110:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juzgará en las gentes,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.6",
            "verseOrgIds": [
              "PSA.110.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 110:6"
      },
      "items": [
        {
          "text": "Llenará",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.6",
            "verseOrgIds": [
              "PSA.110.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "las",
              "type": "text",
              "attrs": {
                "verseId": "PSA.110.6",
                "verseOrgIds": [
                  "PSA.110.6"
                ]
              }
            }
          ]
        },
        {
          "text": "de cadáveres:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.6",
            "verseOrgIds": [
              "PSA.110.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 110:6"
      },
      "items": [
        {
          "text": "Herirá las cabezas en muchas tierras.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.6",
            "verseOrgIds": [
              "PSA.110.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 110:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Del arroyo beberá en el camino:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.7",
            "verseOrgIds": [
              "PSA.110.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 110:7"
      },
      "items": [
        {
          "text": "Por lo cual levantará cabeza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.7",
            "verseOrgIds": [
              "PSA.110.7"
            ]
          }
        }
      ]
    }
  ],
