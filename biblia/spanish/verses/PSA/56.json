{
  "id": "PSA.56",
  "number": "56",
  "bookId": "PSA",
  "reference": "Salmos 56",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "56",
        "style": "c",
        "sid": "PSA 56"
      },
      "items": [
        {
          "text": "56",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: sobre La paloma silenciosa en paraje muy distante. Michtam de David,",
          "type": "text"
        },
        {
          "text": "cuando los Filisteos le prendieron en Gath.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 56:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "TEN",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.1",
            "verseOrgIds": [
              "PSA.56.2"
            ]
          }
        },
        {
          "text": "misericordia de mí, oh Dios, porque me devoraría el hombre:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.1",
            "verseOrgIds": [
              "PSA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:1"
      },
      "items": [
        {
          "text": "Me oprime combatiéndome cada día.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.1",
            "verseOrgIds": [
              "PSA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 56:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apúranme mis enemigos cada día;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.2",
            "verseOrgIds": [
              "PSA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:2"
      },
      "items": [
        {
          "text": "Porque muchos son los que pelean contra mí, oh Altísimo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.2",
            "verseOrgIds": [
              "PSA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 56:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "En el día que temo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.3",
            "verseOrgIds": [
              "PSA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:3"
      },
      "items": [
        {
          "text": "Yo en ti confío.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.3",
            "verseOrgIds": [
              "PSA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 56:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "En Dios alabaré su palabra:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:4"
      },
      "items": [
        {
          "text": "En Dios he confiado,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        },
        {
          "text": "no temeré",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:4"
      },
      "items": [
        {
          "text": "Lo que la carne me hiciere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 56:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todos los días me contristan mis negocios;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.5",
            "verseOrgIds": [
              "PSA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:5"
      },
      "items": [
        {
          "text": "Contra mí son todos sus pensamientos para mal.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.5",
            "verseOrgIds": [
              "PSA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 56:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reúnense,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        },
        {
          "text": "escóndense,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:6"
      },
      "items": [
        {
          "text": "Miran ellos atentamente mis pasos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:6"
      },
      "items": [
        {
          "text": "Esperando mi vida.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 56:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Escaparán ellos por la iniquidad?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.7",
            "verseOrgIds": [
              "PSA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:7"
      },
      "items": [
        {
          "text": "Oh Dios, derriba en tu furor los pueblos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.7",
            "verseOrgIds": [
              "PSA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Plegarias de David",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 en varias tribulaciones.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 56:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mis huídas has tú contado:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:8"
      },
      "items": [
        {
          "text": "Pon mis lágrimas en tu redoma:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:8"
      },
      "items": [
        {
          "text": "¿No están ellas en tu libro?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 56:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Serán luego vueltos atrás mis enemigos el día que yo clamare:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:9"
      },
      "items": [
        {
          "text": "En esto conozco que",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        },
        {
          "text": "Dios es por mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 56:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "En Dios alabaré",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "su",
              "type": "text",
              "attrs": {
                "verseId": "PSA.56.10",
                "verseOrgIds": [
                  "PSA.56.11"
                ]
              }
            }
          ]
        },
        {
          "text": "palabra;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:10"
      },
      "items": [
        {
          "text": "En Jehová alabaré",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "su",
              "type": "text",
              "attrs": {
                "verseId": "PSA.56.10",
                "verseOrgIds": [
                  "PSA.56.11"
                ]
              }
            }
          ]
        },
        {
          "text": "palabra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 56:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "En Dios he confiado:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.11",
            "verseOrgIds": [
              "PSA.56.12"
            ]
          }
        },
        {
          "text": "no temeré",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.11",
            "verseOrgIds": [
              "PSA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:11"
      },
      "items": [
        {
          "text": "Lo que me hará el hombre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.11",
            "verseOrgIds": [
              "PSA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 56:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sobre mí, oh Dios, están tus votos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.12",
            "verseOrgIds": [
              "PSA.56.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:12"
      },
      "items": [
        {
          "text": "Te tributaré alabanzas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.12",
            "verseOrgIds": [
              "PSA.56.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 56:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        },
        {
          "text": "has librado mi vida de la muerte,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:13"
      },
      "items": [
        {
          "text": "Y mis pies de caída,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:13"
      },
      "items": [
        {
          "text": "Para que ande delante de Dios",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 56:13"
      },
      "items": [
        {
          "text": "En",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        },
        {
          "text": "la luz de los que viven.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    }
  ],
