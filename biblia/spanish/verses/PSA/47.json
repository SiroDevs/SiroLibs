{
  "id": "PSA.47",
  "number": "47",
  "bookId": "PSA",
  "reference": "Salmos 47",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "PSA 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: de los hijos de Coré: Salmo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "PUEBLOS todos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.1",
            "verseOrgIds": [
              "PSA.47.2"
            ]
          }
        },
        {
          "text": "batid las manos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.1",
            "verseOrgIds": [
              "PSA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 47:1"
      },
      "items": [
        {
          "text": "Aclamad á Dios con voz de júbilo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.1",
            "verseOrgIds": [
              "PSA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque Jehová el Altísimo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.2",
            "verseOrgIds": [
              "PSA.47.3"
            ]
          }
        },
        {
          "text": "es terrible;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.2",
            "verseOrgIds": [
              "PSA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 47:2"
      },
      "items": [
        {
          "text": "Rey grande sobre toda la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.2",
            "verseOrgIds": [
              "PSA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "El sujetará á los pueblos debajo de nosotros,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.3",
            "verseOrgIds": [
              "PSA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 47:3"
      },
      "items": [
        {
          "text": "Y á las gentes debajo de nuestros pies.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.3",
            "verseOrgIds": [
              "PSA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "El nos elegirá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.4",
            "verseOrgIds": [
              "PSA.47.5"
            ]
          }
        },
        {
          "text": "nuestras heredades;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.4",
            "verseOrgIds": [
              "PSA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 47:4"
      },
      "items": [
        {
          "text": "La hermosura de Jacob, al cual amó. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.4",
            "verseOrgIds": [
              "PSA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Subió Dios con júbilo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.5",
            "verseOrgIds": [
              "PSA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 47:5"
      },
      "items": [
        {
          "text": "Jehová con sonido de trompeta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.5",
            "verseOrgIds": [
              "PSA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cantad á Dios, cantad:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.6",
            "verseOrgIds": [
              "PSA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 47:6"
      },
      "items": [
        {
          "text": "Cantad á nuestro Rey, cantad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.6",
            "verseOrgIds": [
              "PSA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque Dios es",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.7",
            "verseOrgIds": [
              "PSA.47.8"
            ]
          }
        },
        {
          "text": "el Rey de toda la tierra:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.7",
            "verseOrgIds": [
              "PSA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 47:7"
      },
      "items": [
        {
          "text": "Cantad con inteligencia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.7",
            "verseOrgIds": [
              "PSA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reinó Dios sobre las gentes:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.8",
            "verseOrgIds": [
              "PSA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 47:8"
      },
      "items": [
        {
          "text": "Asentóse Dios sobre su santo trono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.8",
            "verseOrgIds": [
              "PSA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los príncipes de los pueblos se juntaron",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "Al pueblo del Dios de Abraham:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "Porque de Dios son los",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        },
        {
          "text": "escudos de la tierra;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "El es muy ensalzado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    }
  ],
