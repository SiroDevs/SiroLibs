      },
      "items": [
        {
          "text": "135",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Aleluya.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 135:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ALABAD el nombre de Jehová;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.1",
            "verseOrgIds": [
              "PSA.135.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:1"
      },
      "items": [
        {
          "text": "Alabad",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.1",
            "verseOrgIds": [
              "PSA.135.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "le,",
              "type": "text",
              "attrs": {
                "verseId": "PSA.135.1",
                "verseOrgIds": [
                  "PSA.135.1"
                ]
              }
            }
          ]
        },
        {
          "text": "siervos de Jehová;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.1",
            "verseOrgIds": [
              "PSA.135.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 135:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los que estáis en la casa de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.2",
            "verseOrgIds": [
              "PSA.135.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:2"
      },
      "items": [
        {
          "text": "En",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.2",
            "verseOrgIds": [
              "PSA.135.2"
            ]
          }
        },
        {
          "text": "los atrios de la casa de nuestro Dios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.2",
            "verseOrgIds": [
              "PSA.135.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 135:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alabad á JAH, porque es bueno Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.3",
            "verseOrgIds": [
              "PSA.135.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:3"
      },
      "items": [
        {
          "text": "Cantad salmos á su nombre,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.3",
            "verseOrgIds": [
              "PSA.135.3"
            ]
          }
        },
        {
          "text": "porque es suave.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.3",
            "verseOrgIds": [
              "PSA.135.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 135:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        },
        {
          "text": "JAH ha escogido á Jacob para sí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:4"
      },
      "items": [
        {
          "text": "A Israel por",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        },
        {
          "text": "posesión suya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 135:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque yo sé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.5",
            "verseOrgIds": [
              "PSA.135.5"
            ]
          }
        },
        {
          "text": "que Jehová es grande,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.5",
            "verseOrgIds": [
              "PSA.135.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:5"
      },
      "items": [
        {
          "text": "Y el Señor nuestro, mayor que todos los dioses.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.5",
            "verseOrgIds": [
              "PSA.135.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 135:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todo lo que quiso Jehová, ha hecho",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.6",
            "verseOrgIds": [
              "PSA.135.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:6"
      },
      "items": [
        {
          "text": "En los cielos y en la tierra, en las mares y en todos los abismos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.6",
            "verseOrgIds": [
              "PSA.135.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 135:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hace subir las nubes del cabo de la tierra;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.7",
            "verseOrgIds": [
              "PSA.135.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:7"
      },
      "items": [
        {
          "text": "El hizo los relámpagos para la lluvia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.7",
            "verseOrgIds": [
              "PSA.135.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:7"
      },
      "items": [
        {
          "text": "El saca los vientos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.7",
            "verseOrgIds": [
              "PSA.135.7"
            ]
          }
        },
        {
          "text": "de sus tesoros.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.7",
            "verseOrgIds": [
              "PSA.135.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 135:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "El",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.8",
            "verseOrgIds": [
              "PSA.135.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es el",
              "type": "text",
              "attrs": {
                "verseId": "PSA.135.8",
                "verseOrgIds": [
                  "PSA.135.8"
                ]
              }
            }
          ]
        },
        {
          "text": "que hirió los primogénitos de Egipto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.8",
            "verseOrgIds": [
              "PSA.135.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:8"
      },
      "items": [
        {
          "text": "Desde el hombre hasta la bestia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.8",
            "verseOrgIds": [
              "PSA.135.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 135:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Envió señales y prodigios en medio de ti, oh Egipto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.9",
            "verseOrgIds": [
              "PSA.135.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:9"
      },
      "items": [
        {
          "text": "Sobre Faraón, y sobre todos sus siervos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.9",
            "verseOrgIds": [
              "PSA.135.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 135:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que hirió muchas gentes,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.10",
            "verseOrgIds": [
              "PSA.135.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:10"
      },
      "items": [
        {
          "text": "Y mató reyes poderosos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.10",
            "verseOrgIds": [
              "PSA.135.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 135:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        },
        {
          "text": "Sehón rey Amorrheo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:11"
      },
      "items": [
        {
          "text": "Y á Og rey de Basán,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:11"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        },
        {
          "text": "a todos los reinos de Canaán.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 135:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y dió la tierra de ellos en heredad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.12",
            "verseOrgIds": [
              "PSA.135.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:12"
      },
      "items": [
        {
          "text": "En heredad á Israel su pueblo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.12",
            "verseOrgIds": [
              "PSA.135.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 135:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Jehová, eterno",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.13",
            "verseOrgIds": [
              "PSA.135.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es",
              "type": "text",
              "attrs": {
                "verseId": "PSA.135.13",
                "verseOrgIds": [
                  "PSA.135.13"
                ]
              }
            }
          ]
        },
        {
          "text": "tu nombre;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.13",
            "verseOrgIds": [
              "PSA.135.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:13"
      },
      "items": [
        {
          "text": "Tu memoria, oh Jehová para generación y generación.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.13",
            "verseOrgIds": [
              "PSA.135.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 135:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque juzgará Jehová su pueblo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.14",
            "verseOrgIds": [
              "PSA.135.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:14"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.14",
            "verseOrgIds": [
              "PSA.135.14"
            ]
          }
        },
        {
          "text": "arrepentiráse sobre sus siervos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.14",
            "verseOrgIds": [
              "PSA.135.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 135:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los ídolos de las gentes son plata y oro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.15",
            "verseOrgIds": [
              "PSA.135.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 135:15"
      },
      "items": [
        {
          "text": "Obra de manos de hombres.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.15",
            "verseOrgIds": [
              "PSA.135.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 135:16"
          },
          "items": [
            {
