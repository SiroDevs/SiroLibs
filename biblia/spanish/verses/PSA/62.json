{
  "id": "PSA.62",
  "number": "62",
  "bookId": "PSA",
  "reference": "Salmos 62",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "62",
        "style": "c",
        "sid": "PSA 62"
      },
      "items": [
        {
          "text": "62",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: á Jeduthúm: Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 62:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "EN",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.1",
            "verseOrgIds": [
              "PSA.62.2"
            ]
          }
        },
        {
          "text": "Dios solamente está callada mi alma:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.1",
            "verseOrgIds": [
              "PSA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:1"
      },
      "items": [
        {
          "text": "De él",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.1",
            "verseOrgIds": [
              "PSA.62.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "viene",
              "type": "text",
              "attrs": {
                "verseId": "PSA.62.1",
                "verseOrgIds": [
                  "PSA.62.2"
                ]
              }
            }
          ]
        },
        {
          "text": "mi salud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.1",
            "verseOrgIds": [
              "PSA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 62:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "El solamente es mi fuerte, y mi salud;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.2",
            "verseOrgIds": [
              "PSA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Es",
              "type": "text",
              "attrs": {
                "verseId": "PSA.62.2",
                "verseOrgIds": [
                  "PSA.62.3"
                ]
              }
            }
          ]
        },
        {
          "text": "mi refugio,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.2",
            "verseOrgIds": [
              "PSA.62.3"
            ]
          }
        },
        {
          "text": "no resbalaré mucho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.2",
            "verseOrgIds": [
              "PSA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 62:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Hasta cuándo maquinaréis contra un hombre?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:3"
      },
      "items": [
        {
          "text": "Pereceréis todos vosotros,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Caeréis",
              "type": "text",
              "attrs": {
                "verseId": "PSA.62.3",
                "verseOrgIds": [
                  "PSA.62.4"
                ]
              }
            }
          ]
        },
        {
          "text": "como pared acostada, como cerca ruinosa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 62:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solamente consultan de arrojarle de su grandeza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "Aman la mentira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "Con su boca bendicen,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        },
        {
          "text": "pero maldicen en sus entrañas. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 62:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alma mía, en Dios solamente reposa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.5",
            "verseOrgIds": [
              "PSA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:5"
      },
      "items": [
        {
          "text": "Porque de él es mi esperanza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.5",
            "verseOrgIds": [
              "PSA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 62:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "El solamente es mi fuerte y mi salud:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.6",
            "verseOrgIds": [
              "PSA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Es",
              "type": "text",
              "attrs": {
                "verseId": "PSA.62.6",
                "verseOrgIds": [
                  "PSA.62.7"
                ]
              }
            }
          ]
        },
        {
          "text": "mi refugio,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.6",
            "verseOrgIds": [
              "PSA.62.7"
            ]
          }
        },
        {
          "text": "no resbalaré.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.6",
            "verseOrgIds": [
              "PSA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 62:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "En Dios está mi salvación y mi gloria:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.7",
            "verseOrgIds": [
              "PSA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:7"
      },
      "items": [
        {
          "text": "En Dios está la roca de mi fortaleza, y mi refugio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.7",
            "verseOrgIds": [
              "PSA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 62:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esperad en él en todo tiempo, oh pueblos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:8"
      },
      "items": [
        {
          "text": "Derramad delante de él vuestro corazón:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:8"
      },
      "items": [
        {
          "text": "Dios es nuestro amparo. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 62:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por cierto, vanidad son los hijos de los hombres, mentira los hijos de varón:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:9"
      },
      "items": [
        {
          "text": "Pesándolos á todos igualmente en la balanza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:9"
      },
      "items": [
        {
          "text": "Serán menos que la vanidad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 \"Dios, Dios mío eres tú.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Protección de los justos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 62:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "No confiéis en la violencia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:10"
      },
      "items": [
        {
          "text": "Ni en la rapiña; no os envanezcáis:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:10"
      },
      "items": [
        {
          "text": "Si se aumentare la hacienda, no pongáis el corazón",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "en ella.",
              "type": "text",
              "attrs": {
                "verseId": "PSA.62.10",
                "verseOrgIds": [
                  "PSA.62.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 62:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Una vez habló Dios;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:11"
      },
      "items": [
        {
          "text": "Dos veces he oído esto:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:11"
      },
      "items": [
        {
          "text": "Que de Dios es la fortaleza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 62:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y de ti, oh Señor, es la",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        },
        {
          "text": "misericordia:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 62:12"
      },
      "items": [
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        },
        {
          "text": "tú pagas á cada uno conforme á su obra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.63",
    "number": "63",
    "bookId": "PSA"
  },
  "previous": {
    "id": "PSA.61",
