  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "PSA 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "DAD á Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.1",
            "verseOrgIds": [
              "PSA.29.1"
            ]
          }
        },
        {
          "text": "oh hijos de fuertes,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.1",
            "verseOrgIds": [
              "PSA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 29:1"
      },
      "items": [
        {
          "text": "Dad á Jehová la gloria y la fortaleza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.1",
            "verseOrgIds": [
              "PSA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dad á Jehová la gloria debida á su nombre:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.2",
            "verseOrgIds": [
              "PSA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 29:2"
      },
      "items": [
        {
          "text": "Humillaos á Jehová en",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.2",
            "verseOrgIds": [
              "PSA.29.2"
            ]
          }
        },
        {
          "text": "el glorioso santuario.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.2",
            "verseOrgIds": [
              "PSA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voz de Jehová sobre las aguas:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 29:3"
      },
      "items": [
        {
          "text": "Hizo tronar el Dios de gloria:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 29:3"
      },
      "items": [
        {
          "text": "Jehová sobre las",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        },
        {
          "text": "muchas aguas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voz de Jehová con potencia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.4",
            "verseOrgIds": [
              "PSA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 29:4"
      },
      "items": [
        {
          "text": "Voz de Jehová con gloria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.4",
            "verseOrgIds": [
              "PSA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voz de Jehová que quebranta los cedros;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.5",
            "verseOrgIds": [
              "PSA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 29:5"
      },
      "items": [
        {
          "text": "Y quebrantó Jehová los cedros del Líbano.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.5",
            "verseOrgIds": [
              "PSA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "E hízolos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.6",
            "verseOrgIds": [
              "PSA.29.6"
            ]
          }
        },
        {
          "text": "saltar como becerros",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.6",
            "verseOrgIds": [
              "PSA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 29:6"
      },
      "items": [
        {
          "text": "Al Líbano y al",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.6",
            "verseOrgIds": [
              "PSA.29.6"
            ]
          }
        },
        {
          "text": "Sirión como hijos de unicornios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.6",
            "verseOrgIds": [
              "PSA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voz de Jehová que derrama llamas de fuego.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.7",
            "verseOrgIds": [
              "PSA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voz de Jehová que hará temblar el desierto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.8",
            "verseOrgIds": [
              "PSA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 29:8"
      },
      "items": [
        {
          "text": "Hará temblar Jehová el desierto de Cades.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.8",
            "verseOrgIds": [
              "PSA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voz de Jehová que hará estar de parto á las ciervas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.9",
            "verseOrgIds": [
              "PSA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 29:9"
      },
      "items": [
        {
          "text": "Y desnudará la breñas:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.9",
            "verseOrgIds": [
              "PSA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 29:9"
      },
      "items": [
        {
          "text": "Y en su templo todos los suyos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.9",
            "verseOrgIds": [
              "PSA.29.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "le",
              "type": "text",
              "attrs": {
                "verseId": "PSA.29.9",
                "verseOrgIds": [
                  "PSA.29.9"
                ]
              }
            }
          ]
        },
        {
          "text": "dicen gloria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.9",
            "verseOrgIds": [
              "PSA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.10",
            "verseOrgIds": [
              "PSA.29.10"
            ]
          }
        },
        {
          "text": "preside en el diluvio,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.10",
            "verseOrgIds": [
              "PSA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 29:10"
      },
      "items": [
        {
          "text": "Y asentóse Jehová por rey para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.10",
            "verseOrgIds": [
              "PSA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová dará fortaleza á su pueblo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.11",
            "verseOrgIds": [
              "PSA.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 29:11"
      },
      "items": [
        {
          "text": "Jehová bendecirá á su pueblo en paz.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.11",
            "verseOrgIds": [
              "PSA.29.11"
            ]
          }
        }
      ]
    }
  ],
