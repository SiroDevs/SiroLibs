{
  "id": "PSA.60",
  "number": "60",
  "bookId": "PSA",
  "reference": "Salmos 60",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "60",
        "style": "c",
        "sid": "PSA 60"
      },
      "items": [
        {
          "text": "60",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: sobre Susan-Heduth: Michtam de David, para enseñar,",
          "type": "text"
        },
        {
          "text": "cuando tuvo guerra contra Aram-Naharaim y contra Aram de Soba, y volvió Joab, é hirió de Edom en el valle de las Salina doce mil.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 60:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OH Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.1",
            "verseOrgIds": [
              "PSA.60.3"
            ]
          }
        },
        {
          "text": "tú nos has desechado, nos disipaste;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.1",
            "verseOrgIds": [
              "PSA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 60:1"
      },
      "items": [
        {
          "text": "Te has airado: vuélvete á nosotros.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.1",
            "verseOrgIds": [
              "PSA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 60:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiciste temblar la tierra, abrístela:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.2",
            "verseOrgIds": [
              "PSA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 60:2"
      },
      "items": [
        {
          "text": "Sana sus quiebras, porque titubea.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.2",
            "verseOrgIds": [
              "PSA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 60:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Has hecho ver á tu pueblo duras cosas:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.3",
            "verseOrgIds": [
              "PSA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 60:3"
      },
      "items": [
        {
          "text": "Hicístenos beber el vino de agitación.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.3",
            "verseOrgIds": [
              "PSA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 en medio de muchos peligros.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 \"En Dios está acallada mi alma.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 60:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Has dado á los que te temen bandera",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.4",
            "verseOrgIds": [
              "PSA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 60:4"
      },
      "items": [
        {
          "text": "Que alcen por la verdad. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.4",
            "verseOrgIds": [
              "PSA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 60:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para que se libren",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.5",
            "verseOrgIds": [
              "PSA.60.7"
            ]
          }
        },
        {
          "text": "tus amados,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.5",
            "verseOrgIds": [
              "PSA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 60:5"
      },
      "items": [
        {
          "text": "Salva con tu diestra, y óyeme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.5",
            "verseOrgIds": [
              "PSA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 60:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dios",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        },
        {
          "text": "pronunció por su santuario; yo me alegraré;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 60:6"
      },
      "items": [
        {
          "text": "Partiré á",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        },
        {
          "text": "Sichêm, y mediré",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        },
        {
          "text": "el valle de Succoth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 60:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mío es Galaad, y mío es Manasés;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 60:7"
      },
      "items": [
        {
          "text": "Y Ephraim es la fortaleza de mi cabeza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 60:7"
      },
      "items": [
        {
          "text": "Judá,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        },
        {
          "text": "mi legislador;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 60:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moab, la vasija de mi lavatorio;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 60:8"
      },
      "items": [
        {
          "text": "Sobre Edom echaré mi zapato:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 60:8"
      },
      "items": [
        {
          "text": "Haz júbilo sobre mí, oh Palestina.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 60:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién me llevará á la ciudad fortalecida?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.9",
            "verseOrgIds": [
              "PSA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 60:9"
      },
      "items": [
        {
          "text": "¿Quién me llevará hasta Idumea?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.9",
            "verseOrgIds": [
              "PSA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 60:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciertamente, tú, oh Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.10",
            "verseOrgIds": [
              "PSA.60.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "que",
              "type": "text",
              "attrs": {
                "verseId": "PSA.60.10",
                "verseOrgIds": [
                  "PSA.60.12"
                ]
              }
            }
          ]
        },
        {
          "text": "nos habías desechado;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.10",
            "verseOrgIds": [
              "PSA.60.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 60:10"
      },
      "items": [
        {
          "text": "Y no salías, oh Dios, con nuestros ejércitos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.10",
            "verseOrgIds": [
              "PSA.60.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 60:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danos socorro contra el enemigo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.11",
            "verseOrgIds": [
              "PSA.60.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 60:11"
      },
      "items": [
        {
          "text": "Que",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.11",
            "verseOrgIds": [
              "PSA.60.13"
            ]
          }
        },
        {
          "text": "vana es la salud de los hombres.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.11",
            "verseOrgIds": [
              "PSA.60.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 60:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "En Dios",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.12",
            "verseOrgIds": [
              "PSA.60.14"
            ]
          }
        },
        {
          "text": "haremos proezas;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.12",
            "verseOrgIds": [
              "PSA.60.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 60:12"
      },
      "items": [
        {
          "text": "Y él",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.12",
            "verseOrgIds": [
              "PSA.60.14"
            ]
          }
        },
        {
          "text": "hollará nuestros enemigos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.12",
            "verseOrgIds": [
              "PSA.60.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.61",
    "number": "61",
