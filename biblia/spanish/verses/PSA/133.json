      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 133:1"
      },
      "items": [
        {
          "text": "Habitar los hermanos igualmente en uno!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.1",
            "verseOrgIds": [
              "PSA.133.1"
            ]
          }
        }
      ]
    },
