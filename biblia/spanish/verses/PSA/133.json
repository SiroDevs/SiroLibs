          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        },
        {
          "text": "el buen óleo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        },
