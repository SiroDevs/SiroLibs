  "verseCount": 6,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "PSA 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "JEHOVÁ es",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.1",
            "verseOrgIds": [
              "PSA.23.1"
            ]
          }
        },
        {
          "text": "mi pastor; nada me faltará.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.1",
            "verseOrgIds": [
              "PSA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "En lugares de delicados pastos me hará yacer:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.2",
            "verseOrgIds": [
              "PSA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 23:2"
      },
      "items": [
        {
          "text": "Junto á aguas de reposo me pastoreará.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.2",
            "verseOrgIds": [
              "PSA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Confortará mi alma;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 23:3"
      },
      "items": [
        {
          "text": "Guiárame por sendas de justicia",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        },
        {
          "text": "por amor de su nombre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aunque ande en valle de sombra de muerte,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "No temeré mal alguno; porque tú estarás conmigo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "Tu vara y tu cayado me infundirán aliento.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aderezarás mesa delante de mí, en presencia de mis angustiadores:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 23:5"
      },
      "items": [
        {
          "text": "Ungiste mi cabeza con aceite:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        },
        {
          "text": "mi copa está rebosando.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciertamente el bien y la misericordia me seguirán todos los días de mi vida:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 23:6"
      },
      "items": [
        {
          "text": "Y en la casa de Jehová moraré por largos días.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
          }
        }
      ]
    }
  ],
