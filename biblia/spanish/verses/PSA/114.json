        "sid": "PSA 114"
      },
      "items": [
        {
          "text": "114",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 114:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "CUANDO",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.1",
            "verseOrgIds": [
              "PSA.114.1"
            ]
          }
        },
        {
          "text": "salió Israel de Egipto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.1",
            "verseOrgIds": [
              "PSA.114.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 114:1"
      },
      "items": [
        {
          "text": "La casa de Jacob",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.1",
            "verseOrgIds": [
              "PSA.114.1"
            ]
          }
        },
        {
          "text": "del pueblo bárbaro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.1",
            "verseOrgIds": [
              "PSA.114.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 114:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judá fué su consagrada heredad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.2",
            "verseOrgIds": [
              "PSA.114.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 114:2"
      },
      "items": [
        {
          "text": "Israel su señorío.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.2",
            "verseOrgIds": [
              "PSA.114.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 114:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "La mar vió, y huyó;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.3",
            "verseOrgIds": [
              "PSA.114.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 114:3"
      },
      "items": [
        {
          "text": "El Jordán se volvió atrás.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.3",
            "verseOrgIds": [
              "PSA.114.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 114:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los montes saltaron como carneros:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.4",
            "verseOrgIds": [
              "PSA.114.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 114:4"
      },
      "items": [
        {
          "text": "Los collados como corderitos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.4",
            "verseOrgIds": [
              "PSA.114.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 114:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Qué tuviste, oh mar, que huiste?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.5",
            "verseOrgIds": [
              "PSA.114.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 114:5"
      },
      "items": [
        {
          "text": "¿Y tú, oh Jordán, que te volviste atrás?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.5",
            "verseOrgIds": [
              "PSA.114.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 114:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh montes, ¿por qué saltasteis como carneros,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.6",
            "verseOrgIds": [
              "PSA.114.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 114:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Y",
              "type": "text",
              "attrs": {
                "verseId": "PSA.114.6",
                "verseOrgIds": [
                  "PSA.114.6"
                ]
              }
            }
          ]
        },
        {
          "text": "vosotros, collados, como corderitos?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.6",
            "verseOrgIds": [
              "PSA.114.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 114:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A la presencia del Señor tiembla la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.7",
            "verseOrgIds": [
              "PSA.114.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 114:7"
      },
      "items": [
        {
          "text": "A la presencia del Dios de Jacob;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.7",
            "verseOrgIds": [
              "PSA.114.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 114:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "El cual tornó la peña en estanque de aguas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.8",
            "verseOrgIds": [
              "PSA.114.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 114:8"
      },
      "items": [
        {
          "text": "Y en fuente de aguas la roca.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.8",
            "verseOrgIds": [
              "PSA.114.8"
            ]
          }
        }
      ]
    }
  ],
