  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "99",
        "style": "c",
        "sid": "PSA 99"
      },
      "items": [
        {
          "text": "99",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 99:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "JEHOVÁ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        },
        {
          "text": "reinó, temblarán los pueblos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 99:1"
      },
      "items": [
        {
          "text": "El está sentado sobre los querubines, conmoveráse la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 99:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová en Sión es grande,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.2",
            "verseOrgIds": [
              "PSA.99.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 99:2"
      },
      "items": [
        {
          "text": "Y ensalzado sobre todos los pueblos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.2",
            "verseOrgIds": [
              "PSA.99.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 99:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alaben tu nombre grande y tremendo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.3",
            "verseOrgIds": [
              "PSA.99.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 99:3"
      },
      "items": [
        {
          "text": "El es",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.3",
            "verseOrgIds": [
              "PSA.99.3"
            ]
          }
        },
        {
          "text": "santo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.3",
            "verseOrgIds": [
              "PSA.99.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 99:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y la gloria del rey ama el juicio:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.4",
            "verseOrgIds": [
              "PSA.99.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 99:4"
      },
      "items": [
        {
          "text": "Tú confirmas la rectitud;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.4",
            "verseOrgIds": [
              "PSA.99.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 99:4"
      },
      "items": [
        {
          "text": "Tú has hecho en Jacob juicio y justicia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.4",
            "verseOrgIds": [
              "PSA.99.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 99:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensalzad á Jehová nuestro Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.5",
            "verseOrgIds": [
              "PSA.99.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 99:5"
      },
      "items": [
        {
          "text": "Y encorvaos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.5",
            "verseOrgIds": [
              "PSA.99.5"
            ]
          }
        },
        {
          "text": "al estrado de sus pies:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.5",
            "verseOrgIds": [
              "PSA.99.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 99:5"
      },
      "items": [
        {
          "text": "El es santo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.5",
            "verseOrgIds": [
              "PSA.99.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 99:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moisés y Aarón entre sus sacerdotes,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.6",
            "verseOrgIds": [
              "PSA.99.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 99:6"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.6",
            "verseOrgIds": [
              "PSA.99.6"
            ]
          }
        },
        {
          "text": "Samuel entre los que invocaron su nombre;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.6",
            "verseOrgIds": [
              "PSA.99.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 99:6"
      },
      "items": [
        {
          "text": "Invocaban á Jehová, y él les respondía.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.6",
            "verseOrgIds": [
              "PSA.99.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 99:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "En columna de nube hablaba con ellos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.7",
            "verseOrgIds": [
              "PSA.99.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 99:7"
      },
      "items": [
        {
          "text": "Guardaban sus testimonios, y el estatuto que les había dado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.7",
            "verseOrgIds": [
              "PSA.99.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 99:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová Dios nuestro, tú les respondías:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.8",
            "verseOrgIds": [
              "PSA.99.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 99:8"
      },
      "items": [
        {
          "text": "Tú les fuiste un Dios perdonador,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.8",
            "verseOrgIds": [
              "PSA.99.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 99:8"
      },
      "items": [
        {
          "text": "Y vengador de sus obras.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.8",
            "verseOrgIds": [
              "PSA.99.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 99:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensalzad á Jehová nuestro Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.9",
            "verseOrgIds": [
              "PSA.99.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 99:9"
      },
      "items": [
        {
          "text": "Y encorvaos al",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.9",
            "verseOrgIds": [
              "PSA.99.9"
            ]
          }
        },
        {
          "text": "monte de su santidad;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.9",
            "verseOrgIds": [
              "PSA.99.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 99:9"
      },
      "items": [
        {
          "text": "Porque Jehová nuestro Dios es santo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.9",
            "verseOrgIds": [
              "PSA.99.9"
            ]
          }
        }
      ]
    }
  ],
