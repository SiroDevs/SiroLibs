{
  "id": "PSA.14",
  "number": "14",
  "bookId": "PSA",
  "reference": "Salmos 14",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "PSA 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "DIJO",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        },
        {
          "text": "el",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        },
        {
          "text": "necio en su corazón:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "No hay Dios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "Corrompiéronse, hicieron obras abominables;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "No hay quien haga bien.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová miró desde los cielos sobre los hijos de los hombres,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 14:2"
      },
      "items": [
        {
          "text": "Por ver si había algún entendido,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 14:2"
      },
      "items": [
        {
          "text": "Que buscara á Dios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todos declinaron, juntamente se han corrompido:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 14:3"
      },
      "items": [
        {
          "text": "No hay quien haga bien, no hay ni siquiera uno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿No tendrán conocimiento todos los que obran iniquidad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 14:4"
      },
      "items": [
        {
          "text": "Que devoran á mi pueblo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "como",
              "type": "text",
              "attrs": {
                "verseId": "PSA.14.4",
                "verseOrgIds": [
                  "PSA.14.4"
                ]
              }
            }
          ]
        },
        {
          "text": "si pan comiesen,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 14:4"
      },
      "items": [
        {
          "text": "Y á Jehová no invocaron?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Allí temblaron de espanto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.5",
            "verseOrgIds": [
              "PSA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 14:5"
      },
      "items": [
        {
          "text": "Porque Dios está con la nación de los justos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.5",
            "verseOrgIds": [
              "PSA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "El consejo del pobre habéis escarnecido,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.6",
            "verseOrgIds": [
              "PSA.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 14:6"
      },
      "items": [
        {
          "text": "Por cuanto Jehová es su",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.6",
            "verseOrgIds": [
              "PSA.14.6"
            ]
          }
        },
        {
          "text": "esperanza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.6",
            "verseOrgIds": [
              "PSA.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "¡Quién diese",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        },
        {
          "text": "de Sión la salud de Israel!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 14:7"
      },
      "items": [
        {
          "text": "En",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        },
        {
          "text": "tornando Jehová la cautividad de su pueblo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 14:7"
      },
      "items": [
        {
          "text": "Se gozará Jacob, y alegraráse Israel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        }
      ]
    }
  ],
