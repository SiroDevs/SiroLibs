{
  "id": "PSA.17",
  "number": "17",
  "bookId": "PSA",
  "reference": "Salmos 17",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "PSA 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Oración de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OYE, oh Jehová, justicia; está atento á mi clamor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "Escucha mi oración hecha sin labios de engaño.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "De delante de tu rostro salga mi juicio;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.2",
            "verseOrgIds": [
              "PSA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:2"
      },
      "items": [
        {
          "text": "Vean tus ojos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.2",
            "verseOrgIds": [
              "PSA.17.2"
            ]
          }
        },
        {
          "text": "la rectitud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.2",
            "verseOrgIds": [
              "PSA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú has probado mi corazón,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        },
        {
          "text": "hasme visitado de noche;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:3"
      },
      "items": [
        {
          "text": "Me has apurado, y nada inicuo hallaste:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:3"
      },
      "items": [
        {
          "text": "Heme propuesto que mi boca no ha de propasarse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para las obras humanas, por la palabra de tus labios",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.4",
            "verseOrgIds": [
              "PSA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:4"
      },
      "items": [
        {
          "text": "Yo me he guardado de las vías del destructor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.4",
            "verseOrgIds": [
              "PSA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sustenta mis pasos en tus caminos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.5",
            "verseOrgIds": [
              "PSA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:5"
      },
      "items": [
        {
          "text": "Porque mis pies no resbalen.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.5",
            "verseOrgIds": [
              "PSA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo te he invocado, por cuanto tú me oirás, oh Dios:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.6",
            "verseOrgIds": [
              "PSA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:6"
      },
      "items": [
        {
          "text": "Inclina á mí tu oído, escucha mi palabra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.6",
            "verseOrgIds": [
              "PSA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muestra tus estupendas misericordias, tú que salvas á los que en ti confían.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.7",
            "verseOrgIds": [
              "PSA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:7"
      },
      "items": [
        {
          "text": "De los que se levantan contra tu diestra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.7",
            "verseOrgIds": [
              "PSA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guárdame como lo negro de la niñeta del ojo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.8",
            "verseOrgIds": [
              "PSA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:8"
      },
      "items": [
        {
          "text": "Escóndeme con la sombra de tus alas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.8",
            "verseOrgIds": [
              "PSA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "De delante de los malos que me oprimen,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.9",
            "verseOrgIds": [
              "PSA.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:9"
      },
      "items": [
        {
          "text": "De mis enemigos que me cercan por la vida.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.9",
            "verseOrgIds": [
              "PSA.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cerrados están con su grosura;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.10",
            "verseOrgIds": [
              "PSA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:10"
      },
      "items": [
        {
          "text": "Con su boca",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.10",
            "verseOrgIds": [
              "PSA.17.10"
            ]
          }
        },
        {
          "text": "hablan soberbiamente.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.10",
            "verseOrgIds": [
              "PSA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuestros pasos nos han cercado ahora:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.11",
            "verseOrgIds": [
              "PSA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:11"
      },
      "items": [
        {
          "text": "Puestos tienen sus ojos para echar",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.11",
            "verseOrgIds": [
              "PSA.17.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "nos",
              "type": "text",
              "attrs": {
                "verseId": "PSA.17.11",
                "verseOrgIds": [
                  "PSA.17.11"
                ]
              }
            }
          ]
        },
        {
          "text": "por tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.11",
            "verseOrgIds": [
              "PSA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Parecen al león que desea hacer presa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.12",
            "verseOrgIds": [
              "PSA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:12"
      },
      "items": [
        {
          "text": "Y al leoncillo que está escondido.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.12",
            "verseOrgIds": [
              "PSA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Levántate, oh Jehová;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.13",
            "verseOrgIds": [
              "PSA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:13"
      },
      "items": [
        {
          "text": "Prevén su encuentro, póstrale:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.13",
            "verseOrgIds": [
              "PSA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:13"
      },
      "items": [
        {
          "text": "Libra mi alma del malo con tu espada;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.13",
            "verseOrgIds": [
              "PSA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "De los hombres con tu mano, oh Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:14"
      },
      "items": [
        {
          "text": "De los hombres de mundo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        },
        {
          "text": "cuya parte es en",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "esta",
              "type": "text",
              "attrs": {
                "verseId": "PSA.17.14",
                "verseOrgIds": [
                  "PSA.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "vida,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:14"
      },
      "items": [
        {
          "text": "Y cuyo vientre hinches de tu tesoro:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:14"
      },
      "items": [
        {
          "text": "Hartan",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "sus",
              "type": "text",
              "attrs": {
                "verseId": "PSA.17.14",
                "verseOrgIds": [
                  "PSA.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "hijos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 17:14"
      },
      "items": [
        {
          "text": "Y dejan el resto á sus chiquitos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 David bendice á Dios",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 por sus liberaciones.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo en justicia veré tu rostro:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.15",
            "verseOrgIds": [
              "PSA.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
