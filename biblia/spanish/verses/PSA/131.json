            "sid": "PSA 131:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "JEHOVÁ, no se ha envanecido",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        },
        {
          "text": "mi corazón, ni mis ojos se enaltecieron;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 131:1"
      },
      "items": [
        {
          "text": "Ni anduve en grandezas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 131:1"
      },
      "items": [
        {
          "text": "Ni en cosas para mí demasiado sublimes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 131:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "En verdad que me he comportado y he acallado mi alma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 131:2"
      },
      "items": [
        {
          "text": "Como un niño destetado de su madre:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 131:2"
      },
      "items": [
        {
          "text": "Como un niño destetado está mi alma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 131:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Espera, oh Israel, en Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.3",
            "verseOrgIds": [
              "PSA.131.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 131:3"
      },
      "items": [
        {
          "text": "Desde ahora y para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.3",
            "verseOrgIds": [
              "PSA.131.3"
            ]
          }
        }
      ]
    }
