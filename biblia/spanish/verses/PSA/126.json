  "verseCount": 6,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "126",
        "style": "c",
        "sid": "PSA 126"
      },
      "items": [
        {
          "text": "126",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Cántico gradual.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 126:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "CUANDO Jehová hiciere tornar la cautividad de Sión,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.1",
            "verseOrgIds": [
              "PSA.126.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 126:1"
      },
      "items": [
        {
          "text": "Seremos como los que sueñan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.1",
            "verseOrgIds": [
              "PSA.126.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 126:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entonces nuestra boca se henchirá de risa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 126:2"
      },
      "items": [
        {
          "text": "Y nuestra lengua de alabanza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 126:2"
      },
      "items": [
        {
          "text": "Entonces dirán entre las gentes:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 126:2"
      },
      "items": [
        {
          "text": "Grandes cosas ha hecho Jehová con éstos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 126:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Grandes cosas ha hecho Jehová con nosotros;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.3",
            "verseOrgIds": [
              "PSA.126.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 126:3"
      },
      "items": [
        {
          "text": "Estaremos alegres.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.3",
            "verseOrgIds": [
              "PSA.126.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 126:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haz volver nuestra cautividad oh Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.4",
            "verseOrgIds": [
              "PSA.126.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 126:4"
      },
      "items": [
        {
          "text": "Como los arroyos en el austro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.4",
            "verseOrgIds": [
              "PSA.126.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 126:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los que sembraron con lágrimas, con regocijo segarán.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.5",
            "verseOrgIds": [
              "PSA.126.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 126:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irá andando y llorando el que lleva la preciosa simiente;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 126:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Mas",
              "type": "text",
              "attrs": {
                "verseId": "PSA.126.6",
                "verseOrgIds": [
                  "PSA.126.6"
                ]
              }
            }
          ]
        },
        {
          "text": "volverá á venir con regocijo, trayendo sus gavillas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.127",
