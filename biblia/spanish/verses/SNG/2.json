            "verseOrgIds": [
              "SNG.2.15"
            ]
          }
        },
        {
          "text": "las zorra, las zorras pequeñas, que echan á perder las viñas;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.15",
            "verseOrgIds": [
              "SNG.2.15"
            ]
          }
        }
