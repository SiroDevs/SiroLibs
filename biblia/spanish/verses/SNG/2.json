              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasta que apunte el día,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.17",
            "verseOrgIds": [
              "SNG.2.17"
            ]
          }
        },
