          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando Jehová habló á Moisés en la tierra de Egipto,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.28",
            "verseOrgIds": [
              "EXO.6.28"
            ]
          }
        }
      ]
    },
