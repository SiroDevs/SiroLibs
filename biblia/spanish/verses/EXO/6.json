              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y tomóse Aarón por mujer á Elisabeth, hija de",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.23",
            "verseOrgIds": [
              "EXO.6.23"
            ]
          }
        },
        {
          "text": "Aminadab, hermana de Naasón; la cual le parió á",
