          "attrs": {
            "verseId": "EXO.6.23",
            "verseOrgIds": [
              "EXO.6.23"
            ]
          }
        },
        {
          "text": "Nadab, y á Abiú, y á Eleazar, y á Ithamar.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.23",
            "verseOrgIds": [
              "EXO.6.23"
            ]
