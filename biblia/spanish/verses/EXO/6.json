              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y Moisés respondió delante de Jehová: He aquí,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.30",
            "verseOrgIds": [
              "EXO.6.30"
            ]
          }
        },
        {
          "text": "yo soy incircunciso de labios, ¿cómo pues me ha de oir Faraón?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.30",
            "verseOrgIds": [
              "EXO.6.30"
            ]
          }
        }
