            "verseId": "EXO.6.25",
            "verseOrgIds": [
              "EXO.6.25"
            ]
          }
        },
        {
          "text": "le parió á Phinees: y estas son las cabezas de los padres de los Levitas por sus familias.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.25",
            "verseOrgIds": [
              "EXO.6.25"
            ]
          }
        }
      ]
