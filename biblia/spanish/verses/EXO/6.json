          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entonces Jehová habló á Moisés, diciendo: Yo soy",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.29",
            "verseOrgIds": [
              "EXO.6.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "JEHOVÁ",
              "type": "text",
              "attrs": {
                "verseId": "EXO.6.29",
                "verseOrgIds": [
                  "EXO.6.29"
                ]
              }
            }
          ]
        },
        {
          "text": "; di á Faraón rey de Egipto todas las cosas que yo te digo á ti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.29",
            "verseOrgIds": [
              "EXO.6.29"
            ]
          }
        }
