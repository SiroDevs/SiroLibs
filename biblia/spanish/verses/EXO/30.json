          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y de casia quinientos, al peso del santuario, y de aceite de olivas un",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.24",
            "verseOrgIds": [
              "EXO.30.24"
            ]
          }
        },
        {
          "text": "hin:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.24",
            "verseOrgIds": [
              "EXO.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y harás de ello el aceite de la santa unción, superior ungüento, obra de perfumador, el cual será el aceite de la unción sagrada.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.25",
            "verseOrgIds": [
              "EXO.30.25"
            ]
          }
        }
      ]
    },
    {
