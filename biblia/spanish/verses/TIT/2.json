{
  "id": "TIT.2",
  "number": "2",
  "bookId": "TIT",
  "reference": "Tito 2",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "TIT 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "TIT 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "EMPERO tú, habla lo que conviene á la",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.1",
            "verseOrgIds": [
              "TIT.2.1"
            ]
          }
        },
        {
          "text": "sana doctrina:",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.1",
            "verseOrgIds": [
              "TIT.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "TIT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que los viejos sean templados,",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.2",
            "verseOrgIds": [
              "TIT.2.2"
            ]
          }
        },
        {
          "text": "graves, prudentes,",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.2",
            "verseOrgIds": [
              "TIT.2.2"
            ]
          }
        },
        {
          "text": "sanos en la",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.2",
            "verseOrgIds": [
              "TIT.2.2"
            ]
          }
        },
        {
          "text": "fe, en la caridad, en la paciencia.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.2",
            "verseOrgIds": [
              "TIT.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Deberes de cada estado.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 La enseñanza útil y la inútil.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "TIT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las viejas,",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.3",
            "verseOrgIds": [
              "TIT.2.3"
            ]
          }
        },
        {
          "text": "asimismo,",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.3",
            "verseOrgIds": [
              "TIT.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "se distingan",
              "type": "text",
              "attrs": {
                "verseId": "TIT.2.3",
                "verseOrgIds": [
                  "TIT.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "en un porte santo; no calumniadoras, no dadas á mucho vino, maestras de honestidad:",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.3",
            "verseOrgIds": [
              "TIT.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que enseñen á las mujeres jóvenes á ser predentes, á",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.4",
            "verseOrgIds": [
              "TIT.2.4"
            ]
          }
        },
        {
          "text": "que amen á sus maridos, á que amen á sus hijos,",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.4",
            "verseOrgIds": [
              "TIT.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "TIT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "A",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.5",
            "verseOrgIds": [
              "TIT.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "ser",
              "type": "text",
              "attrs": {
                "verseId": "TIT.2.5",
                "verseOrgIds": [
                  "TIT.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "templadas, castas, que tengan cuidado de la casa, buenas, sujetas á sus maridos; porque",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.5",
            "verseOrgIds": [
              "TIT.2.5"
            ]
          }
        },
        {
          "text": "la palabra de Dios no sea blasfemada.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.5",
            "verseOrgIds": [
              "TIT.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Exhorta asimismo á los mancebos á que sean comedidos;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.6",
            "verseOrgIds": [
              "TIT.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mostrándote en todo por ejemplo de buenas obras; en doctrina",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.7",
            "verseOrgIds": [
              "TIT.2.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "haciendo ver",
              "type": "text",
              "attrs": {
                "verseId": "TIT.2.7",
                "verseOrgIds": [
                  "TIT.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "integridad, gravedad,",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.7",
            "verseOrgIds": [
              "TIT.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palabra sana,",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.8",
            "verseOrgIds": [
              "TIT.2.8"
            ]
          }
        },
        {
          "text": "e irreprensible;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.8",
            "verseOrgIds": [
              "TIT.2.8"
            ]
          }
        },
        {
          "text": "que el adversario se avergüence, no teniendo mal ninguno que decir de vosotros.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.8",
            "verseOrgIds": [
              "TIT.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Exhorta",
              "type": "text",
              "attrs": {
                "verseId": "TIT.2.9",
                "verseOrgIds": [
                  "TIT.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "á los",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.9",
            "verseOrgIds": [
              "TIT.2.9"
            ]
          }
        },
        {
          "text": "siervos á que sean sujetos á sus señores, que agraden en todo, no respondones;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.9",
            "verseOrgIds": [
              "TIT.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "No defraudando, antes mostrando toda buena lealtad, para que adornen en todo",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.10",
            "verseOrgIds": [
              "TIT.2.10"
            ]
          }
        },
        {
          "text": "la doctrina de",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.10",
            "verseOrgIds": [
              "TIT.2.10"
            ]
          }
        },
        {
          "text": "nuestro Salvador Dios.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.10",
            "verseOrgIds": [
              "TIT.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "TIT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque la gracia de Dios que trae salvación á todos los hombres, se manifestó.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.11",
            "verseOrgIds": [
              "TIT.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "TIT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enseñándonos que, renunciando á la impiedad",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.12",
            "verseOrgIds": [
              "TIT.2.12"
            ]
          }
        },
        {
          "text": "y á los deseos mundanos, vivamos en este siglo templada, y justa, y píamente,",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.12",
            "verseOrgIds": [
              "TIT.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esperando aquella esperanza",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.13",
            "verseOrgIds": [
              "TIT.2.13"
            ]
          }
        },
        {
          "text": "bienaventurada, y la manifestación",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.13",
            "verseOrgIds": [
              "TIT.2.13"
            ]
          }
        },
        {
          "text": "gloriosa del gran Dios y Salvador nuestro Jesucristo.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.13",
            "verseOrgIds": [
              "TIT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        },
        {
          "text": "se dió á sí mismo por nosotros",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        },
        {
          "text": "para redimirnos de toda iniquidad, y limpiar para sí",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        },
        {
          "text": "un pueblo propio, celoso de buenas obras.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esto habla y exhorta, y reprende con toda autoridad.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.15",
            "verseOrgIds": [
              "TIT.2.15"
            ]
          }
        },
        {
          "text": "Nadie te desprecie.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.15",
            "verseOrgIds": [
              "TIT.2.15"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "TIT.3",
    "number": "3",
    "bookId": "TIT"
  },
  "previous": {
    "id": "TIT.1",
    "number": "1",
