          "text": "Adonías, Bigvai, Adín,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.16",
            "verseOrgIds": [
              "NEH.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
