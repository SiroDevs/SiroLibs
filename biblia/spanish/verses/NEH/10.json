        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.1",
            "verseOrgIds": [
              "NEH.10.2"
            ]
          }
        },
        {
          "text": "LOS que firmaron fueron,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.1",
            "verseOrgIds": [
              "NEH.10.2"
            ]
          }
        },
        {
          "text": "Nehemías el Tirsatha,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.1",
            "verseOrgIds": [
              "NEH.10.2"
            ]
          }
        },
        {
          "text": "hijo de Hachâlías, y Sedecías,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.1",
            "verseOrgIds": [
              "NEH.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seraías,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.2",
            "verseOrgIds": [
              "NEH.10.3"
            ]
          }
        },
        {
          "text": "Azarías, Jeremías,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.2",
            "verseOrgIds": [
              "NEH.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pashur, Amarías, Malchías,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.3",
            "verseOrgIds": [
              "NEH.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hattus, Sebanías, Malluch,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.4",
            "verseOrgIds": [
              "NEH.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harim, Meremoth, Obadías,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.5",
            "verseOrgIds": [
              "NEH.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daniel, Ginethón, Baruch,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.6",
            "verseOrgIds": [
              "NEH.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesullam, Abías, Miamín,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.7",
            "verseOrgIds": [
              "NEH.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maazías, Bilgai, Semeías: estos, sacerdotes.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.8",
            "verseOrgIds": [
              "NEH.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y Levitas: Jesuá hijo de Azanías, Binnui de los hijos de Henadad, Cadmiel;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.9",
            "verseOrgIds": [
              "NEH.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y sus hermanos Sebanías, Odaía, Celita, Pelaías, Hanán;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.10",
            "verseOrgIds": [
              "NEH.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Michâ, Rehob, Hasabías,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.11",
            "verseOrgIds": [
              "NEH.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zachû, Serebías, Sebanías,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.12",
            "verseOrgIds": [
              "NEH.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odaía, Bani, Beninu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.13",
            "verseOrgIds": [
              "NEH.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cabezas del pueblo: Pharos, Pahath-moab, Elam, Zattu, Bani,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.14",
            "verseOrgIds": [
              "NEH.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bunni, Azgad, Bebai,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.15",
            "verseOrgIds": [
              "NEH.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
