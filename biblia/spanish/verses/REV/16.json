{
  "id": "REV.16",
  "number": "16",
  "bookId": "REV",
  "reference": "Apocalipsis 16",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "REV 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y OÍ una gran voz del templo, que decía",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        },
        {
          "text": "a los siete ángeles: Id, y derramad las siete copas",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        },
        {
          "text": "de la ira de Dios sobre la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y fué el primero, y derramó su copa",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        },
        {
          "text": "sobre la tierra; y",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        },
        {
          "text": "vino una plaga mala y dañosa sobre los hombres",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        },
        {
          "text": "que tenían la señal de la bestia, y",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        },
        {
          "text": "sobre los que adoraban su imagen.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y el segundo ángel derramó su copa",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        },
        {
          "text": "sobre el mar, y se convirtió en sangre como de un muerto;",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        },
        {
          "text": "y toda alma viviente fué muerta en el mar.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y el tercer ángel derramó su copa",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.4",
            "verseOrgIds": [
              "REV.16.4"
            ]
          }
        },
        {
          "text": "sobre los ríos, y sobre las fuentes de las aguas,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.4",
            "verseOrgIds": [
              "REV.16.4"
            ]
          }
        },
        {
          "text": "y se convirtieron en sangre.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.4",
            "verseOrgIds": [
              "REV.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y oí al ángel de las aguas, que decía:",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        },
        {
          "text": "Justo eres tú, oh Señor,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        },
        {
          "text": "que eres y que eras, el Santo, porque has juzgado estas cosas:",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque ellos derramaron la sangre",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.6",
            "verseOrgIds": [
              "REV.16.6"
            ]
          }
        },
        {
          "text": "de los santos y de los profetas,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.6",
            "verseOrgIds": [
              "REV.16.6"
            ]
          }
        },
        {
          "text": "también tú les has dado á beber sangre; pues",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.6",
            "verseOrgIds": [
              "REV.16.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "lo",
              "type": "text",
              "attrs": {
                "verseId": "REV.16.6",
                "verseOrgIds": [
                  "REV.16.6"
                ]
              }
            }
          ]
        },
        {
          "text": "merecen.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.6",
            "verseOrgIds": [
              "REV.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y oí á otro del",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        },
        {
          "text": "altar, que decía: Ciertamente,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        },
        {
          "text": "Señor Dios Todopoderoso, tus juicios son verdaderos y justos.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y el cuarto ángel derramó su copa",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.8",
            "verseOrgIds": [
              "REV.16.8"
            ]
          }
        },
        {
          "text": "sobre el sol; y le fué dado quemar á los hombres con fuego.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.8",
            "verseOrgIds": [
              "REV.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y los hombres",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.9",
            "verseOrgIds": [
              "REV.16.9"
            ]
          }
        },
        {
          "text": "se quemaron con el grande calor, y",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.9",
            "verseOrgIds": [
              "REV.16.9"
            ]
          }
        },
        {
          "text": "blasfemaron el nombre de Dios, que tiene potestad sobre estas plagas,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.9",
            "verseOrgIds": [
              "REV.16.9"
            ]
          }
        },
        {
          "text": "y no se arrepintieron para",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.9",
            "verseOrgIds": [
              "REV.16.9"
            ]
          }
        },
        {
          "text": "darle gloria.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.9",
            "verseOrgIds": [
              "REV.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y el quinto ángel derramó su copa",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "text": "sobre la silla de la bestia;",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "text": "y su reino se hizo tenebroso, y se mordían sus lenguas de dolor;",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Plagas sobre la tierra.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 La ramera y la bestia.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y blasfemaron del Dios del cielo por sus dolores,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        },
        {
          "text": "y por sus plagas, y no se arrepintieron de sus obras.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y el sexto ángel derramó su copa",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.12",
            "verseOrgIds": [
              "REV.16.12"
            ]
          }
        },
        {
          "text": "sobre el gran río Eufrates; y",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.12",
            "verseOrgIds": [
              "REV.16.12"
            ]
          }
        },
        {
          "text": "el agua de él se secó,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.12",
            "verseOrgIds": [
              "REV.16.12"
            ]
          }
        },
        {
          "text": "para que fuese preparado el camino de los reyes del Oriente.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.12",
            "verseOrgIds": [
              "REV.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y vi",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "salir",
              "type": "text",
              "attrs": {
                "verseId": "REV.16.13",
                "verseOrgIds": [
                  "REV.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": "de la boca",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        },
        {
          "text": "del dragón, y de la boca de",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        },
        {
          "text": "la bestia, y de la boca",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        },
        {
          "text": "del falso profeta, tres espíritus inmundos",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        },
        {
          "text": "a manera de ranas:",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque son espíritus de demonios,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.14",
            "verseOrgIds": [
              "REV.16.14"
            ]
          }
        },
        {
          "text": "que hacen señales, para ir á los reyes de la tierra y de todo el mundo, para congregarlos para",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.14",
            "verseOrgIds": [
              "REV.16.14"
            ]
          }
        },
        {
          "text": "la batalla de",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.14",
            "verseOrgIds": [
              "REV.16.14"
            ]
          }
        },
        {
          "text": "aquel gran día del Dios Todopoderoso.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.14",
            "verseOrgIds": [
              "REV.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí, yo vengo",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
            "verseOrgIds": [
              "REV.16.15"
            ]
          }
        },
        {
          "text": "como ladrón.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
            "verseOrgIds": [
              "REV.16.15"
            ]
          }
        },
        {
          "text": "Bienaventurado el que vela, y guarda sus vestiduras, para que no ande desnudo, y vean su vergüenza.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
            "verseOrgIds": [
              "REV.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y los congregó",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.16",
            "verseOrgIds": [
              "REV.16.16"
            ]
          }
        },
        {
          "text": "en el lugar que en hebreo se llama",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.16",
            "verseOrgIds": [
              "REV.16.16"
            ]
          }
        },
        {
          "text": "Armagedón.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.16",
            "verseOrgIds": [
              "REV.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
