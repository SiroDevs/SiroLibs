{
  "id": "PRO.15",
  "number": "15",
  "bookId": "PRO",
  "reference": "Proverbios 15",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "PRO 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "LA",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.1",
            "verseOrgIds": [
              "PRO.15.1"
            ]
          }
        },
        {
          "text": "blanda respuesta quita la ira:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.1",
            "verseOrgIds": [
              "PRO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:1"
      },
      "items": [
        {
          "text": "Mas la palabra áspera hace subir el furor.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.1",
            "verseOrgIds": [
              "PRO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "La lengua de los sabios adornará la sabiduría:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.2",
            "verseOrgIds": [
              "PRO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:2"
      },
      "items": [
        {
          "text": "Mas la boca de los necios hablará sandeces.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.2",
            "verseOrgIds": [
              "PRO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los ojos de Jehová están en todo lugar,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.3",
            "verseOrgIds": [
              "PRO.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:3"
      },
      "items": [
        {
          "text": "Mirando á los malos y á los buenos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.3",
            "verseOrgIds": [
              "PRO.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "La sana lengua es árbol de vida:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.4",
            "verseOrgIds": [
              "PRO.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:4"
      },
      "items": [
        {
          "text": "Mas la perversidad en ella es quebrantamiento de espíritu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.4",
            "verseOrgIds": [
              "PRO.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "El necio menosprecia el consejo de su padre:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.5",
            "verseOrgIds": [
              "PRO.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:5"
      },
      "items": [
        {
          "text": "Mas el que guarda la corrección, vendrá á ser cuerdo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.5",
            "verseOrgIds": [
              "PRO.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "En la casa del justo hay gran provisión;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.6",
            "verseOrgIds": [
              "PRO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:6"
      },
      "items": [
        {
          "text": "Empero turbación en las ganancias del impío.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.6",
            "verseOrgIds": [
              "PRO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los labios de los sabios esparcen sabiduría:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.7",
            "verseOrgIds": [
              "PRO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:7"
      },
      "items": [
        {
          "text": "Mas no así el corazón de los necios.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.7",
            "verseOrgIds": [
              "PRO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Proverbios sobre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 diversos asuntos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "El sacrificio de los impíos es abominación á Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.8",
            "verseOrgIds": [
              "PRO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:8"
      },
      "items": [
        {
          "text": "Mas la oración de los rectos es su gozo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.8",
            "verseOrgIds": [
              "PRO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abominación es á Jehová el camino del impío:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.9",
            "verseOrgIds": [
              "PRO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:9"
      },
      "items": [
        {
          "text": "Mas él ama",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.9",
            "verseOrgIds": [
              "PRO.15.9"
            ]
          }
        },
        {
          "text": "al que sigue justicia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.9",
            "verseOrgIds": [
              "PRO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "La reconvención es molesta al que deja el camino:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.10",
            "verseOrgIds": [
              "PRO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:10"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.10",
            "verseOrgIds": [
              "PRO.15.10"
            ]
          }
        },
        {
          "text": "el que aborreciere la corrección, morirá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.10",
            "verseOrgIds": [
              "PRO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "El infierno y la perdición están delante de Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.11",
            "verseOrgIds": [
              "PRO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:11"
      },
      "items": [
        {
          "text": "¡Cuánto más los corazones de los hombres!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.11",
            "verseOrgIds": [
              "PRO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "El escarnecedor no ama al que le reprende;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.12",
            "verseOrgIds": [
              "PRO.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:12"
      },
      "items": [
        {
          "text": "Ni se allega á los sabios.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.12",
            "verseOrgIds": [
              "PRO.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "El corazón alegre hermosea el rostro:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.13",
            "verseOrgIds": [
              "PRO.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:13"
      },
      "items": [
        {
          "text": "Mas por el dolor de corazón el espíritu se abate.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.13",
            "verseOrgIds": [
              "PRO.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "El corazón entendido busca la sabiduría:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.14",
            "verseOrgIds": [
              "PRO.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:14"
      },
      "items": [
        {
          "text": "Mas la boca de los necios pace necedad.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.14",
            "verseOrgIds": [
              "PRO.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todos los días del afligido son trabajosos:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.15",
            "verseOrgIds": [
              "PRO.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:15"
      },
      "items": [
        {
          "text": "Mas el de corazón contento",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.15",
            "verseOrgIds": [
              "PRO.15.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "tiene",
              "type": "text",
              "attrs": {
                "verseId": "PRO.15.15",
                "verseOrgIds": [
                  "PRO.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "un convite continuo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.15",
            "verseOrgIds": [
              "PRO.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mejor es lo poco con el temor de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.16",
            "verseOrgIds": [
              "PRO.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:16"
      },
      "items": [
        {
          "text": "Que el gran tesoro donde hay turbación.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.16",
            "verseOrgIds": [
              "PRO.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mejor es la comida de legumbres donde hay amor,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.17",
            "verseOrgIds": [
              "PRO.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:17"
      },
      "items": [
        {
          "text": "Que de buey engordado donde hay odio.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.17",
            "verseOrgIds": [
              "PRO.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hombre iracundo mueve contiendas:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.18",
            "verseOrgIds": [
              "PRO.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:18"
      },
      "items": [
        {
          "text": "Mas el que tarde se enoja, apaciguará la rencilla.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.18",
            "verseOrgIds": [
              "PRO.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "El camino del perezoso es como seto de espinos:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.19",
            "verseOrgIds": [
              "PRO.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:19"
      },
      "items": [
        {
          "text": "Mas la vereda de los rectos",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.19",
            "verseOrgIds": [
              "PRO.15.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "como",
              "type": "text",
              "attrs": {
                "verseId": "PRO.15.19",
                "verseOrgIds": [
                  "PRO.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": "una calzada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.19",
            "verseOrgIds": [
              "PRO.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hijo sabio alegra al padre:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.20",
            "verseOrgIds": [
              "PRO.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:20"
      },
      "items": [
        {
          "text": "Mas el hombre necio menosprecia á su madre.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.20",
            "verseOrgIds": [
              "PRO.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "La necedad es alegría al falto de entendimiento:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.21",
            "verseOrgIds": [
              "PRO.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:21"
      },
      "items": [
        {
          "text": "Mas el hombre entendido enderezará su proceder.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.21",
            "verseOrgIds": [
              "PRO.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los pensamientos son frustrados donde no hay consejo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.22",
            "verseOrgIds": [
              "PRO.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:22"
      },
      "items": [
        {
          "text": "Mas en la multitud de consejeros se afirman.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.22",
            "verseOrgIds": [
              "PRO.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alégrase el hombre con la respuesta de su boca:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.23",
            "verseOrgIds": [
              "PRO.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:23"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.23",
            "verseOrgIds": [
              "PRO.15.23"
            ]
          }
        },
        {
          "text": "la palabra",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.23",
            "verseOrgIds": [
              "PRO.15.23"
            ]
          }
        },
        {
          "text": "a su tiempo, ¡cuán buena es!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.23",
            "verseOrgIds": [
              "PRO.15.23"
            ]
          }
        }
      ]
    },
    {
