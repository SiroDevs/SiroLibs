          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "El temor de Jehová es enseñanza de",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.33",
            "verseOrgIds": [
              "PRO.15.33"
            ]
          }
        },
        {
          "text": "sabiduría:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.33",
            "verseOrgIds": [
              "PRO.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:33"
      },
      "items": [
        {
          "text": "Y delante de la honra",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.33",
            "verseOrgIds": [
              "PRO.15.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "está",
              "type": "text",
              "attrs": {
                "verseId": "PRO.15.33",
                "verseOrgIds": [
                  "PRO.15.33"
                ]
              }
            }
          ]
        },
        {
          "text": "la humildad.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.33",
            "verseOrgIds": [
              "PRO.15.33"
            ]
          }
        }
