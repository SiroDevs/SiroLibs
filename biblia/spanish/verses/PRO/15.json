      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:25"
      },
      "items": [
        {
          "text": "Mas él afirmará el término de",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.25",
            "verseOrgIds": [
              "PRO.15.25"
            ]
          }
        },
        {
          "text": "la viuda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.25",
            "verseOrgIds": [
              "PRO.15.25"
            ]
          }
        }
      ]
    },
    {
