          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "La oreja que escucha la corrección de vida,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.31",
            "verseOrgIds": [
              "PRO.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:31"
      },
      "items": [
        {
          "text": "Entre los sabios morará.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.31",
            "verseOrgIds": [
              "PRO.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que tiene en poco la disciplina, menosprecia su alma:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.32",
            "verseOrgIds": [
              "PRO.15.32"
            ]
          }
        }
      ]
    },
