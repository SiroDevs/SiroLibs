      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:26"
      },
      "items": [
        {
          "text": "Mas las expresiones de los limpios",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.26",
            "verseOrgIds": [
              "PRO.15.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "son",
              "type": "text",
              "attrs": {
                "verseId": "PRO.15.26",
                "verseOrgIds": [
                  "PRO.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": "limpias.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.26",
            "verseOrgIds": [
              "PRO.15.26"
            ]
          }
        }
      ]
    },
