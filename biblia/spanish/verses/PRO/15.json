          "type": "text",
          "attrs": {
            "verseId": "PRO.15.24",
            "verseOrgIds": [
              "PRO.15.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es",
              "type": "text",
              "attrs": {
                "verseId": "PRO.15.24",
                "verseOrgIds": [
                  "PRO.15.24"
                ]
              }
            }
          ]
        },
        {
          "text": "hacia arriba al entendido,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.24",
            "verseOrgIds": [
              "PRO.15.24"
            ]
          }
        }
      ]
    },
