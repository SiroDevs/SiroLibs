          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "La luz de los ojos alegra el corazón;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.30",
            "verseOrgIds": [
              "PRO.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:30"
      },
      "items": [
        {
          "text": "Y la buena fama engorda los huesos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.30",
            "verseOrgIds": [
              "PRO.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
