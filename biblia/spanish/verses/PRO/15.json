          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alborota su casa el codicioso:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.27",
            "verseOrgIds": [
              "PRO.15.27"
            ]
          }
        }
      ]
