      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:28"
      },
      "items": [
        {
          "text": "Mas la boca de los impíos derrama malas cosas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.28",
            "verseOrgIds": [
              "PRO.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lejos está Jehová de los impíos:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.29",
            "verseOrgIds": [
              "PRO.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:29"
      },
      "items": [
        {
          "text": "Mas él oye la oración de los justos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.29",
            "verseOrgIds": [
              "PRO.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
