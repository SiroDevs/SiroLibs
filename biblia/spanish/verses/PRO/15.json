      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:27"
      },
      "items": [
        {
          "text": "Mas el que aborrece las dádivas vivirá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.27",
            "verseOrgIds": [
              "PRO.15.27"
            ]
          }
        }
      ]
    },
    {
