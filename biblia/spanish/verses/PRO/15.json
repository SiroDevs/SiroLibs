      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 15:32"
      },
      "items": [
        {
          "text": "Mas el que escucha la corrección, tiene entendimiento.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.32",
            "verseOrgIds": [
              "PRO.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
