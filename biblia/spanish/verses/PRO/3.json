          ]
        },
        {
          "text": "Con su ciencia se partieron los abismos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.20",
            "verseOrgIds": [
              "PRO.3.20"
            ]
          }
        }
      ]
    },
    {
