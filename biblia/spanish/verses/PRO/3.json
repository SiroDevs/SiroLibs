      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:32"
      },
      "items": [
        {
          "text": "Mas su secreto es con los rectos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.32",
            "verseOrgIds": [
              "PRO.3.32"
            ]
          }
        }
      ]
