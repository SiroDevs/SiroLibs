          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entonces andarás por tu camino confiadamente,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.23",
            "verseOrgIds": [
              "PRO.3.23"
            ]
          }
        }
      ]
    },
