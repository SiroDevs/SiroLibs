          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "No envidies al hombre injusto,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.31",
            "verseOrgIds": [
              "PRO.3.31"
            ]
          }
        }
      ]
