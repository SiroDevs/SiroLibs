      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:31"
      },
      "items": [
        {
          "text": "Ni escojas alguno de sus caminos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.31",
            "verseOrgIds": [
              "PRO.3.31"
            ]
          }
        }
      ]
    },
    {
