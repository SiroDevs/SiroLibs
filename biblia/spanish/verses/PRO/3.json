          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando te acostares, no tendrás temor;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.24",
            "verseOrgIds": [
              "PRO.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:24"
      },
      "items": [
        {
          "text": "Antes te acostarás, y tu sueño será suave.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.24",
            "verseOrgIds": [
              "PRO.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
