                "verseId": "PRO.3.21",
                "verseOrgIds": [
                  "PRO.3.21"
                ]
              }
            }
          ]
        },
        {
          "text": "de tus ojos;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.21",
            "verseOrgIds": [
              "PRO.3.21"
            ]
          }
        }
      ]
