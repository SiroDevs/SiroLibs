          "attrs": {
            "verseId": "PRO.3.20",
            "verseOrgIds": [
              "PRO.3.20"
            ]
          }
        },
        {
          "text": "rocío los cielos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.20",
            "verseOrgIds": [
              "PRO.3.20"
            ]
          }
        }
      ]
