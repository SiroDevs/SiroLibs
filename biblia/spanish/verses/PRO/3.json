      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:34"
      },
      "items": [
        {
          "text": "Y á los humildes dará gracia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.34",
            "verseOrgIds": [
              "PRO.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
