          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "No tendrás temor de pavor repentino,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.25",
            "verseOrgIds": [
              "PRO.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:25"
      },
      "items": [
        {
          "text": "Ni de la ruina de los impíos cuando viniere:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.25",
            "verseOrgIds": [
              "PRO.3.25"
            ]
          }
        }
      ]
    },
    {
