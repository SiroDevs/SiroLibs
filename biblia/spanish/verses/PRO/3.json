      "attrs": {
        "style": "q",
        "vid": "PRO 3:19"
      },
      "items": [
        {
          "text": "Afirmó los cielos con inteligencia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.19",
            "verseOrgIds": [
              "PRO.3.19"
            ]
          }
        }
      ]
    },
    {
