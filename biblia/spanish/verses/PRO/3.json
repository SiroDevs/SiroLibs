            "sid": "PRO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y serán vida á tu alma,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.22",
            "verseOrgIds": [
              "PRO.3.22"
            ]
          }
        }
      ]
    },
