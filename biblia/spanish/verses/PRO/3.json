      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:26"
      },
      "items": [
        {
          "text": "Y él preservará tu pie de ser preso.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.26",
            "verseOrgIds": [
              "PRO.3.26"
            ]
          }
        }
      ]
    },
