      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:28"
      },
      "items": [
        {
          "text": "Y mañana",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.28",
            "verseOrgIds": [
              "PRO.3.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
