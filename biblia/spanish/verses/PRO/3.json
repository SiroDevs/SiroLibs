      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:29"
      },
      "items": [
        {
          "text": "Estando él confiado de ti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.29",
            "verseOrgIds": [
              "PRO.3.29"
            ]
          }
        }
