{
  "id": "PRO.3",
  "number": "3",
  "bookId": "PRO",
  "reference": "Proverbios 3",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "PRO 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "HIJO mío, no te olvides de mi ley;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.1",
            "verseOrgIds": [
              "PRO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:1"
      },
      "items": [
        {
          "text": "Y tu corazón guarde mis mandamientos:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.1",
            "verseOrgIds": [
              "PRO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.2",
            "verseOrgIds": [
              "PRO.3.2"
            ]
          }
        },
        {
          "text": "largura de días, y años de vida",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.2",
            "verseOrgIds": [
              "PRO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:2"
      },
      "items": [
        {
          "text": "Y paz te aumentarán.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.2",
            "verseOrgIds": [
              "PRO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misericordia y verdad no te desamparen;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.3",
            "verseOrgIds": [
              "PRO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:3"
      },
      "items": [
        {
          "text": "Atalas á tu cuello,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.3",
            "verseOrgIds": [
              "PRO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:3"
      },
      "items": [
        {
          "text": "Escríbelas en la tabla de tu corazón:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.3",
            "verseOrgIds": [
              "PRO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y hallarás gracia y buena opinión",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.4",
            "verseOrgIds": [
              "PRO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:4"
      },
      "items": [
        {
          "text": "En los ojos de Dios y de los hombres.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.4",
            "verseOrgIds": [
              "PRO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fíate de Jehová de todo tu corazón,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.5",
            "verseOrgIds": [
              "PRO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:5"
      },
      "items": [
        {
          "text": "Y no estribes en tu prudencia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.5",
            "verseOrgIds": [
              "PRO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reconócelo en todos tus caminos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.6",
            "verseOrgIds": [
              "PRO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:6"
      },
      "items": [
        {
          "text": "Y él",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.6",
            "verseOrgIds": [
              "PRO.3.6"
            ]
          }
        },
        {
          "text": "enderezará tus veredas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.6",
            "verseOrgIds": [
              "PRO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "No seas sabio en tu opinión:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.7",
            "verseOrgIds": [
              "PRO.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:7"
      },
      "items": [
        {
          "text": "Teme á Jehová, y apártate del mal;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.7",
            "verseOrgIds": [
              "PRO.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque será medicina á tu ombligo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.8",
            "verseOrgIds": [
              "PRO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:8"
      },
      "items": [
        {
          "text": "Y tuétano á tus huesos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.8",
            "verseOrgIds": [
              "PRO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Honra á Jehová de tu sustancia,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.9",
            "verseOrgIds": [
              "PRO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:9"
      },
      "items": [
        {
          "text": "Y de las primicias de todos tus frutos;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.9",
            "verseOrgIds": [
              "PRO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y serán llenas tus trojes con abundancia,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.10",
            "verseOrgIds": [
              "PRO.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:10"
      },
      "items": [
        {
          "text": "Y tus lagares rebosarán de mosto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.10",
            "verseOrgIds": [
              "PRO.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "No deseches, hijo mío, el castigo de Jehová;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.11",
            "verseOrgIds": [
              "PRO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:11"
      },
      "items": [
        {
          "text": "Ni te fatigues de su corrección:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.11",
            "verseOrgIds": [
              "PRO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque al que ama castiga,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.12",
            "verseOrgIds": [
              "PRO.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:12"
      },
      "items": [
        {
          "text": "Como el padre al hijo á quien quiere.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.12",
            "verseOrgIds": [
              "PRO.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienaventurado el hombre que halla la sabiduría,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.13",
            "verseOrgIds": [
              "PRO.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:13"
      },
      "items": [
        {
          "text": "Y que obtiene la inteligencia:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.13",
            "verseOrgIds": [
              "PRO.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque su mercadería es mejor que la mercadería de la plata,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.14",
            "verseOrgIds": [
              "PRO.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:14"
      },
      "items": [
        {
          "text": "Y sus frutos más que el oro fino.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.14",
            "verseOrgIds": [
              "PRO.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Valor y beneficios",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 de la sabiduría.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Más preciosa es que las piedras preciosas;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.15",
            "verseOrgIds": [
              "PRO.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:15"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.15",
            "verseOrgIds": [
              "PRO.3.15"
            ]
          }
        },
        {
          "text": "todo lo que puedes desear, no se puede comparar á ella.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.15",
            "verseOrgIds": [
              "PRO.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Largura de días está en su mano derecha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.16",
            "verseOrgIds": [
              "PRO.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:16"
      },
      "items": [
        {
          "text": "En su izquierda",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.16",
            "verseOrgIds": [
              "PRO.3.16"
            ]
          }
        },
        {
          "text": "riquezas y honra.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.16",
            "verseOrgIds": [
              "PRO.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sus caminos son caminos deleitosos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.17",
            "verseOrgIds": [
              "PRO.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:17"
      },
      "items": [
        {
          "text": "Y todas sus veredas paz.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.17",
            "verseOrgIds": [
              "PRO.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ella",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.18",
            "verseOrgIds": [
              "PRO.3.18"
            ]
          }
        },
        {
          "text": "es árbol de vida á los que de ella asen:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.18",
            "verseOrgIds": [
              "PRO.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:18"
      },
      "items": [
        {
          "text": "Y bienaventurados son los que la mantienen.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.18",
            "verseOrgIds": [
              "PRO.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
