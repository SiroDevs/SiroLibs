      "attrs": {
        "style": "q",
        "vid": "PRO 3:21"
      },
      "items": [
        {
          "text": "Guarda la ley y el consejo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.21",
            "verseOrgIds": [
              "PRO.3.21"
            ]
          }
        }
      ]
    },
    {
