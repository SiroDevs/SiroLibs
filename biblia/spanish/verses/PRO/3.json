      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:23"
      },
      "items": [
        {
          "text": "Y tu pie no tropezará.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.23",
            "verseOrgIds": [
              "PRO.3.23"
            ]
          }
        }
      ]
    },
    {
