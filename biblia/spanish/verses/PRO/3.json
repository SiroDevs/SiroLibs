          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque el perverso es abominado de Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.32",
            "verseOrgIds": [
              "PRO.3.32"
            ]
          }
        }
      ]
    },
