      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "La maldición de Jehová está en la casa del impío;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.33",
            "verseOrgIds": [
              "PRO.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 3:33"
      },
      "items": [
        {
          "text": "Mas él bendecirá la morada de los justos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.33",
            "verseOrgIds": [
              "PRO.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciertamente él escarnecerá á los escarnecedores,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.34",
            "verseOrgIds": [
              "PRO.3.34"
            ]
          }
        }
      ]
    },
