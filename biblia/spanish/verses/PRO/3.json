          "type": "text",
          "attrs": {
            "verseId": "PRO.3.28",
            "verseOrgIds": [
              "PRO.3.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "qué darle.",
