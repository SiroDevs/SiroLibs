          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hijo mío, no se aparten",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.21",
            "verseOrgIds": [
              "PRO.3.21"
            ]
          }
        },
        {
          "name": "char",
