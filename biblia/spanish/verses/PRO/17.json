      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 17:21"
      },
      "items": [
        {
          "text": "Y el padre del fatuo no se alegrará.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.21",
            "verseOrgIds": [
              "PRO.17.21"
            ]
