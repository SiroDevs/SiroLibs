          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "El perverso de corazón nunca hallará bien:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.20",
            "verseOrgIds": [
              "PRO.17.20"
            ]
          }
