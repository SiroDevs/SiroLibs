{
  "id": "PRO.10",
  "number": "10",
  "bookId": "PRO",
  "reference": "Proverbios 10",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "PRO 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Las sentencias de Salomón.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "EL hijo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        },
        {
          "text": "sabio alegra al padre;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:1"
      },
      "items": [
        {
          "text": "Y el hijo necio es tristeza de su madre.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los tesoros de maldad no serán de provecho:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.2",
            "verseOrgIds": [
              "PRO.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:2"
      },
      "items": [
        {
          "text": "Mas la justicia libra de muerte.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.2",
            "verseOrgIds": [
              "PRO.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová no dejará hambrear el alma del justo:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.3",
            "verseOrgIds": [
              "PRO.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:3"
      },
      "items": [
        {
          "text": "Mas la iniquidad lanzará á los impíos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.3",
            "verseOrgIds": [
              "PRO.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "La mano negligente hace pobre:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.4",
            "verseOrgIds": [
              "PRO.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:4"
      },
      "items": [
        {
          "text": "Mas la mano de los diligentes enriquece.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.4",
            "verseOrgIds": [
              "PRO.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que recoge en el estío es hombre entendido:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.5",
            "verseOrgIds": [
              "PRO.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:5"
      },
      "items": [
        {
          "text": "El que duerme en el tiempo de la siega es hombre afrentoso.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.5",
            "verseOrgIds": [
              "PRO.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bendiciones sobre la cabeza del justo:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.6",
            "verseOrgIds": [
              "PRO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:6"
      },
      "items": [
        {
          "text": "Mas violencia cubrirá la boca de los impíos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.6",
            "verseOrgIds": [
              "PRO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "La memoria del justo será bendita:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.7",
            "verseOrgIds": [
              "PRO.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:7"
      },
      "items": [
        {
          "text": "Mas el nombre de los impíos se pudrirá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.7",
            "verseOrgIds": [
              "PRO.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "El sabio de corazón recibirá los mandamientos:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.8",
            "verseOrgIds": [
              "PRO.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:8"
      },
      "items": [
        {
          "text": "Mas el loco de labios caerá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.8",
            "verseOrgIds": [
              "PRO.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que camina en integridad, anda confiado:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.9",
            "verseOrgIds": [
              "PRO.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:9"
      },
      "items": [
        {
          "text": "Mas el que pervierte sus caminos, será quebrantado.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.9",
            "verseOrgIds": [
              "PRO.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que guiña del ojo acarrea tristeza;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.10",
            "verseOrgIds": [
              "PRO.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:10"
      },
      "items": [
        {
          "text": "Y el loco de labios será castigado.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.10",
            "verseOrgIds": [
              "PRO.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vena de vida es la boca del justo:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.11",
            "verseOrgIds": [
              "PRO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:11"
      },
      "items": [
        {
          "text": "Mas violencia cubrirá la boca de los impíos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.11",
            "verseOrgIds": [
              "PRO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "El odio despierta rencillas:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.12",
            "verseOrgIds": [
              "PRO.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:12"
      },
      "items": [
        {
          "text": "Mas la caridad cubrirá todas las faltas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.12",
            "verseOrgIds": [
              "PRO.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "En los labios del prudente se halla sabiduría:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.13",
            "verseOrgIds": [
              "PRO.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:13"
      },
      "items": [
        {
          "text": "Y vara á las espaldas del falto de cordura.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.13",
            "verseOrgIds": [
              "PRO.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los sabios guardan la sabiduría:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.14",
            "verseOrgIds": [
              "PRO.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:14"
      },
      "items": [
        {
          "text": "Mas la boca del loco es calamidad cercana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.14",
            "verseOrgIds": [
              "PRO.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las riquezas del rico",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.15",
            "verseOrgIds": [
              "PRO.10.15"
            ]
          }
        },
        {
          "text": "son su ciudad fuerte;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.15",
            "verseOrgIds": [
              "PRO.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:15"
      },
      "items": [
        {
          "text": "Y el desmayo de los pobres es su pobreza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.15",
            "verseOrgIds": [
              "PRO.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "La obra del justo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.16",
            "verseOrgIds": [
              "PRO.10.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es",
              "type": "text",
              "attrs": {
                "verseId": "PRO.10.16",
                "verseOrgIds": [
                  "PRO.10.16"
                ]
              }
            }
          ]
        },
        {
          "text": "para vida;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.16",
            "verseOrgIds": [
              "PRO.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:16"
      },
      "items": [
        {
          "text": "Mas el fruto del impío",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.16",
            "verseOrgIds": [
              "PRO.10.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es",
              "type": "text",
              "attrs": {
                "verseId": "PRO.10.16",
                "verseOrgIds": [
                  "PRO.10.16"
                ]
              }
            }
          ]
        },
        {
          "text": "para pecado.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.16",
            "verseOrgIds": [
              "PRO.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Camino á la vida es guardar la corrección:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.17",
            "verseOrgIds": [
              "PRO.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:17"
      },
      "items": [
        {
          "text": "Mas el que deja la reprensión, yerra.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.17",
            "verseOrgIds": [
              "PRO.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que encubre el odio es de labios mentirosos;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.18",
            "verseOrgIds": [
              "PRO.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:18"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.18",
            "verseOrgIds": [
              "PRO.10.18"
            ]
          }
        },
        {
          "text": "el que echa mala fama es necio.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.18",
            "verseOrgIds": [
              "PRO.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "En las muchas palabras no falta pecado:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.19",
            "verseOrgIds": [
              "PRO.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:19"
      },
      "items": [
        {
          "text": "Mas",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.19",
            "verseOrgIds": [
              "PRO.10.19"
            ]
          }
        },
        {
          "text": "el que refrena sus labios es prudente.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.19",
            "verseOrgIds": [
              "PRO.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Plata escogida es la lengua del justo:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.20",
            "verseOrgIds": [
              "PRO.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:20"
      },
      "items": [
        {
          "text": "Mas el entendimiento de los impíos es como nada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.20",
            "verseOrgIds": [
              "PRO.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Proverbios sobre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 diversos asuntos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los labios del justo apacientan á muchos:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.21",
            "verseOrgIds": [
              "PRO.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:21"
      },
      "items": [
        {
          "text": "Mas los necios por falta de entendimiento mueren.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.21",
            "verseOrgIds": [
              "PRO.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "La bendición de Jehová es la que enriquece,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.22",
            "verseOrgIds": [
              "PRO.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:22"
      },
      "items": [
        {
          "text": "Y no añade tristeza con ella.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.22",
            "verseOrgIds": [
              "PRO.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hacer abominación es como risa al insensato:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.23",
            "verseOrgIds": [
              "PRO.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:23"
      },
      "items": [
        {
          "text": "Mas el hombre entendido sabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.23",
            "verseOrgIds": [
              "PRO.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lo que el impío teme, eso le vendrá:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.24",
            "verseOrgIds": [
              "PRO.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:24"
      },
      "items": [
        {
          "text": "Mas á los justos les será dado lo que desean.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.24",
            "verseOrgIds": [
              "PRO.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Como pasa el torbellino, así el",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.25",
            "verseOrgIds": [
              "PRO.10.25"
            ]
          }
        },
        {
          "text": "malo no permanece:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.25",
            "verseOrgIds": [
              "PRO.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:25"
      },
      "items": [
        {
          "text": "Mas el",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.25",
            "verseOrgIds": [
              "PRO.10.25"
            ]
          }
        },
        {
          "text": "justo, fundado para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.25",
            "verseOrgIds": [
              "PRO.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Como el vinagre á los dientes, y como el humo á los ojos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.26",
            "verseOrgIds": [
              "PRO.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:26"
      },
      "items": [
        {
          "text": "Así es el perezoso á los que lo envían.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.26",
            "verseOrgIds": [
              "PRO.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "El temor de Jehová aumentará los días:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.27",
            "verseOrgIds": [
              "PRO.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:27"
      },
      "items": [
        {
          "text": "Mas los años de los impíos serán acortados.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.27",
            "verseOrgIds": [
              "PRO.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "La esperanza de los justos",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.28",
            "verseOrgIds": [
              "PRO.10.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es",
              "type": "text",
              "attrs": {
                "verseId": "PRO.10.28",
                "verseOrgIds": [
                  "PRO.10.28"
                ]
              }
            }
          ]
        },
        {
          "text": "alegría;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.28",
            "verseOrgIds": [
              "PRO.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:28"
      },
      "items": [
        {
          "text": "Mas la esperanza de los impíos perecerá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.28",
            "verseOrgIds": [
              "PRO.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fortaleza es al perfecto el camino de Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.29",
            "verseOrgIds": [
              "PRO.10.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:29"
      },
      "items": [
        {
          "text": "Mas espanto es á los que obran maldad.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.29",
            "verseOrgIds": [
              "PRO.10.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "El justo eternalmente no será removido:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.30",
            "verseOrgIds": [
              "PRO.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:30"
      },
      "items": [
        {
          "text": "Mas los impíos no habitarán la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.30",
            "verseOrgIds": [
              "PRO.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "La boca del justo producirá sabiduría:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.31",
            "verseOrgIds": [
              "PRO.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:31"
      },
      "items": [
        {
          "text": "Mas la lengua perversa será cortada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.31",
            "verseOrgIds": [
              "PRO.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los labios del justo conocerán lo que agrada:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.32",
            "verseOrgIds": [
              "PRO.10.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 10:32"
      },
      "items": [
        {
          "text": "Mas la boca de los impíos",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.32",
            "verseOrgIds": [
              "PRO.10.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "habla",
              "type": "text",
              "attrs": {
                "verseId": "PRO.10.32",
                "verseOrgIds": [
                  "PRO.10.32"
                ]
              }
            }
          ]
        },
        {
          "text": "perversidades.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.32",
            "verseOrgIds": [
              "PRO.10.32"
            ]
          }
        }
      ]
    }
