{
  "id": "PRO.22",
  "number": "22",
  "bookId": "PRO",
  "reference": "Proverbios 22",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "PRO 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "DE",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.1",
            "verseOrgIds": [
              "PRO.22.1"
            ]
          }
        },
        {
          "text": "más estima es la buena fama que las muchas riquezas;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.1",
            "verseOrgIds": [
              "PRO.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:1"
      },
      "items": [
        {
          "text": "Y la buena gracia más que la plata y el oro.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.1",
            "verseOrgIds": [
              "PRO.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "El rico y el pobre se encontraron:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.2",
            "verseOrgIds": [
              "PRO.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:2"
      },
      "items": [
        {
          "text": "A todos ellos hizo Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.2",
            "verseOrgIds": [
              "PRO.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "El avisado ve el mal, y escóndese:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.3",
            "verseOrgIds": [
              "PRO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:3"
      },
      "items": [
        {
          "text": "Mas los simples pasan, y reciben el daño.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.3",
            "verseOrgIds": [
              "PRO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riquezas, y honra, y vida,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Son",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.4",
                "verseOrgIds": [
                  "PRO.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": "la remuneración de la humildad",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "y",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.4",
                "verseOrgIds": [
                  "PRO.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": "del temor de Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Espinas",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.5",
            "verseOrgIds": [
              "PRO.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "y",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.5",
                "verseOrgIds": [
                  "PRO.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "lazos hay en el camino del perverso:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.5",
            "verseOrgIds": [
              "PRO.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:5"
      },
      "items": [
        {
          "text": "El que guarda su alma se alejará de ellos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.5",
            "verseOrgIds": [
              "PRO.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Instruye al niño en su carrera:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.6",
            "verseOrgIds": [
              "PRO.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:6"
      },
      "items": [
        {
          "text": "Aun cuando fuere viejo no se apartará de ella.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.6",
            "verseOrgIds": [
              "PRO.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "El rico se enseñoreará de los pobres;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.7",
            "verseOrgIds": [
              "PRO.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:7"
      },
      "items": [
        {
          "text": "Y el que toma prestado, siervo es del que empresta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.7",
            "verseOrgIds": [
              "PRO.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que sembrare iniquidad, iniquidad segará:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.8",
            "verseOrgIds": [
              "PRO.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:8"
      },
      "items": [
        {
          "text": "Y consumiráse la vara de su ira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.8",
            "verseOrgIds": [
              "PRO.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "El ojo misericordioso será bendito,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.9",
            "verseOrgIds": [
              "PRO.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:9"
      },
      "items": [
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.9",
            "verseOrgIds": [
              "PRO.22.9"
            ]
          }
        },
        {
          "text": "dió de su pan al indigente.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.9",
            "verseOrgIds": [
              "PRO.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Echa fuera al escarnecedor, y saldrá la contienda,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.10",
            "verseOrgIds": [
              "PRO.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:10"
      },
      "items": [
        {
          "text": "Y cesará el pleito y la afrenta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.10",
            "verseOrgIds": [
              "PRO.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que ama la limpieza de corazón,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.11",
            "verseOrgIds": [
              "PRO.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:11"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Por",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.11",
                "verseOrgIds": [
                  "PRO.22.11"
                ]
              }
            }
          ]
        },
        {
          "text": "la gracia de sus labios su amigo será el rey.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.11",
            "verseOrgIds": [
              "PRO.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los ojos de Jehová miran por la ciencia;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.12",
            "verseOrgIds": [
              "PRO.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:12"
      },
      "items": [
        {
          "text": "Mas él trastorna las cosas de los prevaricadores.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.12",
            "verseOrgIds": [
              "PRO.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dice el perezoso: El león está fuera;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.13",
            "verseOrgIds": [
              "PRO.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:13"
      },
      "items": [
        {
          "text": "En mitad de las calles seré muerto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.13",
            "verseOrgIds": [
              "PRO.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima profunda es la boca de las extrañas:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.14",
            "verseOrgIds": [
              "PRO.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:14"
      },
      "items": [
        {
          "text": "Aquel contra el cual estuviere Jehová airado, caerá en ella.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.14",
            "verseOrgIds": [
              "PRO.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "La necedad está ligada en el corazón del muchacho;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.15",
            "verseOrgIds": [
              "PRO.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:15"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Mas",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.15",
                "verseOrgIds": [
                  "PRO.22.15"
                ]
              }
            }
          ]
        },
        {
          "text": "la vara de la corrección la hará alejar de él.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.15",
            "verseOrgIds": [
              "PRO.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que oprime al pobre para aumentarse él,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.16",
            "verseOrgIds": [
              "PRO.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:16"
      },
      "items": [
        {
          "text": "Y que da al rico,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.16",
            "verseOrgIds": [
              "PRO.22.16"
            ]
          }
        },
        {
          "text": "ciertamente",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.16",
            "verseOrgIds": [
              "PRO.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "será",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.16",
                "verseOrgIds": [
                  "PRO.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": "pobre.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.16",
            "verseOrgIds": [
              "PRO.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inclina tu oído, y oye las palabras de los sabios,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.17",
            "verseOrgIds": [
              "PRO.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:17"
      },
      "items": [
        {
          "text": "Y pon tu corazón á mi sabiduría:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.17",
            "verseOrgIds": [
              "PRO.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque es cosa deleitable, si las guardares en tus entrañas;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.18",
            "verseOrgIds": [
              "PRO.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:18"
      },
      "items": [
        {
          "text": "Y que juntamente sean ordenadas en tus labios.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.18",
            "verseOrgIds": [
              "PRO.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para que tu confianza sea en Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.19",
            "verseOrgIds": [
              "PRO.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:19"
      },
      "items": [
        {
          "text": "Te",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.19",
            "verseOrgIds": [
              "PRO.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "las",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.19",
                "verseOrgIds": [
                  "PRO.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "he hecho saber hoy á ti también.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.19",
            "verseOrgIds": [
              "PRO.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿No te he escrito tres veces",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.20",
            "verseOrgIds": [
              "PRO.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:20"
      },
      "items": [
        {
          "text": "En consejos y ciencia,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.20",
            "verseOrgIds": [
              "PRO.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para hacerte saber la certidumbre de las razones verdaderas,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.21",
            "verseOrgIds": [
              "PRO.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:21"
      },
      "items": [
        {
          "text": "Para que puedas responder razones de verdad á los que á ti enviaren?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.21",
            "verseOrgIds": [
              "PRO.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Discursos morales",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 sobre diversos asuntos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "No robes al pobre, porque es pobre,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.22",
            "verseOrgIds": [
              "PRO.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:22"
      },
      "items": [
        {
          "text": "Ni quebrantes",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.22",
            "verseOrgIds": [
              "PRO.22.22"
            ]
          }
        },
        {
          "text": "en la puerta al afligido:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.22",
            "verseOrgIds": [
              "PRO.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque Jehová juzgará la causa de ellos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.23",
            "verseOrgIds": [
              "PRO.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:23"
      },
      "items": [
        {
          "text": "Y despojará el alma de aquellos que los despojaren.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.23",
            "verseOrgIds": [
              "PRO.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "No te entrometas con el iracundo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.24",
            "verseOrgIds": [
              "PRO.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:24"
      },
      "items": [
        {
          "text": "Ni te acompañes con el hombre de enojos;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.24",
            "verseOrgIds": [
              "PRO.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque no aprendas sus maneras,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.25",
            "verseOrgIds": [
              "PRO.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:25"
      },
      "items": [
        {
          "text": "Y tomes lazo para tu alma.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.25",
            "verseOrgIds": [
              "PRO.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "No estés entre los que tocan la mano,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.26",
            "verseOrgIds": [
              "PRO.22.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:26"
      },
      "items": [
        {
          "text": "Entre los que fían por deudas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.26",
            "verseOrgIds": [
              "PRO.22.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si no tuvieres para pagar,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.27",
            "verseOrgIds": [
              "PRO.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:27"
      },
      "items": [
        {
          "text": "¿Por qué",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.27",
            "verseOrgIds": [
              "PRO.22.27"
            ]
          }
        },
        {
          "text": "han de quitar tu cama de debajo de ti?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.27",
            "verseOrgIds": [
              "PRO.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "No traspases el término antiguo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.28",
            "verseOrgIds": [
              "PRO.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:28"
      },
      "items": [
        {
          "text": "Que pusieron tus padres.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.28",
            "verseOrgIds": [
              "PRO.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Has visto hombre solícito en su obra? delante de los reyes estará;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.29",
            "verseOrgIds": [
              "PRO.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 22:29"
      },
      "items": [
        {
          "text": "No estará delante de los de baja suerte.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.29",
            "verseOrgIds": [
              "PRO.22.29"
            ]
          }
        }
      ]
    }
