      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 4:27"
      },
      "items": [
        {
          "text": "Aparta tu pie del mal.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.27",
            "verseOrgIds": [
              "PRO.4.27"
            ]
          }
        }
