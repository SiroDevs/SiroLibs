          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sobre toda cosa guardada guarda tu corazón;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.23",
            "verseOrgIds": [
              "PRO.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 4:23"
      },
      "items": [
        {
          "text": "Porque de él mana la vida.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.23",
            "verseOrgIds": [
              "PRO.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aparta de ti la perversidad de la boca,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.24",
            "verseOrgIds": [
              "PRO.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 4:24"
      },
      "items": [
        {
          "text": "Y aleja de ti la iniquidad de labios.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.24",
            "verseOrgIds": [
              "PRO.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tus ojos miren lo recto,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.25",
            "verseOrgIds": [
              "PRO.4.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 4:25"
      },
      "items": [
        {
          "text": "Y tus párpados en derechura delante de ti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.25",
            "verseOrgIds": [
              "PRO.4.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Examina la senda de tus pies,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.26",
            "verseOrgIds": [
              "PRO.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 4:26"
      },
      "items": [
        {
          "text": "Y todos tus caminos sean ordenados.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.26",
            "verseOrgIds": [
              "PRO.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "No te apartes á diestra, ni á siniestra:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.27",
            "verseOrgIds": [
              "PRO.4.27"
            ]
          }
        }
      ]
