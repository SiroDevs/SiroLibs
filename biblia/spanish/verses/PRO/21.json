{
  "id": "PRO.21",
  "number": "21",
  "bookId": "PRO",
  "reference": "Proverbios 21",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "PRO 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "COMO los repartimientos de las aguas, así está el corazón del rey en la mano de Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.1",
            "verseOrgIds": [
              "PRO.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:1"
      },
      "items": [
        {
          "text": "A todo lo que quiere lo inclina.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.1",
            "verseOrgIds": [
              "PRO.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todo camino del hombre es recto en su opinión:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.2",
            "verseOrgIds": [
              "PRO.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:2"
      },
      "items": [
        {
          "text": "Mas Jehová pesa los corazones.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.2",
            "verseOrgIds": [
              "PRO.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hacer justicia y juicio es á Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.3",
            "verseOrgIds": [
              "PRO.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:3"
      },
      "items": [
        {
          "text": "Más agradable que sacrificio.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.3",
            "verseOrgIds": [
              "PRO.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Altivez de ojos, y orgullo de corazón,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.4",
            "verseOrgIds": [
              "PRO.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:4"
      },
      "items": [
        {
          "text": "Y el brillo de los impíos, son pecado.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.4",
            "verseOrgIds": [
              "PRO.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los pensamientos del solícito ciertamente",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.5",
            "verseOrgIds": [
              "PRO.21.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "van",
              "type": "text",
              "attrs": {
                "verseId": "PRO.21.5",
                "verseOrgIds": [
                  "PRO.21.5"
                ]
              }
            }
          ]
        },
        {
          "text": "á abundancia;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.5",
            "verseOrgIds": [
              "PRO.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:5"
      },
      "items": [
        {
          "text": "Mas todo presuroso, indefectiblemente á pobreza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.5",
            "verseOrgIds": [
              "PRO.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Allegar tesoros con lengua de mentira,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.6",
            "verseOrgIds": [
              "PRO.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:6"
      },
      "items": [
        {
          "text": "Es vanidad desatentada de aquellos que buscan la muerte.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.6",
            "verseOrgIds": [
              "PRO.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "La rapiña de los impíos los destruirá;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.7",
            "verseOrgIds": [
              "PRO.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:7"
      },
      "items": [
        {
          "text": "Por cuanto no quisieron hacer juicio.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.7",
            "verseOrgIds": [
              "PRO.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "El camino del hombre perverso es torcido y extraño:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.8",
            "verseOrgIds": [
              "PRO.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:8"
      },
      "items": [
        {
          "text": "Mas la obra del limpio es recta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.8",
            "verseOrgIds": [
              "PRO.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mejor es vivir en un rincón de zaquizamí.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.9",
            "verseOrgIds": [
              "PRO.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:9"
      },
      "items": [
        {
          "text": "Que con la mujer rencillosa en espaciosa casa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.9",
            "verseOrgIds": [
              "PRO.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "El alma del impío desea mal:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.10",
            "verseOrgIds": [
              "PRO.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:10"
      },
      "items": [
        {
          "text": "Su prójimo no le parece bien.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.10",
            "verseOrgIds": [
              "PRO.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando el escarnecedor es castigado, el simple se hace sabio;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.11",
            "verseOrgIds": [
              "PRO.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:11"
      },
      "items": [
        {
          "text": "Y cuando se amonestare al sabio, aprenderá ciencia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.11",
            "verseOrgIds": [
              "PRO.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Considera el justo la casa del impío:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.12",
            "verseOrgIds": [
              "PRO.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Cómo",
              "type": "text",
              "attrs": {
                "verseId": "PRO.21.12",
                "verseOrgIds": [
                  "PRO.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": "los impíos son trastornados por el mal.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.12",
            "verseOrgIds": [
              "PRO.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que cierra su oído al clamor del pobre,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.13",
            "verseOrgIds": [
              "PRO.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:13"
      },
      "items": [
        {
          "text": "También él clamará, y no será oído.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.13",
            "verseOrgIds": [
              "PRO.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "El",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.14",
            "verseOrgIds": [
              "PRO.21.14"
            ]
          }
        },
        {
          "text": "presente en secreto amansa el furor,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.14",
            "verseOrgIds": [
              "PRO.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:14"
      },
      "items": [
        {
          "text": "Y el don en el seno, la fuerte ira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.14",
            "verseOrgIds": [
              "PRO.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alegría es al justo hacer juicio;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.15",
            "verseOrgIds": [
              "PRO.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:15"
      },
      "items": [
        {
          "text": "Mas quebrantamiento á los que hacen iniquidad.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.15",
            "verseOrgIds": [
              "PRO.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hombre que se extravía del camino de la sabiduría,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.16",
            "verseOrgIds": [
              "PRO.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:16"
      },
      "items": [
        {
          "text": "Vendrá á parar en la compañía de los muertos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.16",
            "verseOrgIds": [
              "PRO.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hombre necesitado será el que ama el deleite:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.17",
            "verseOrgIds": [
              "PRO.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:17"
      },
      "items": [
        {
          "text": "Y el que ama el vino y ungüentos no enriquecerá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.17",
            "verseOrgIds": [
              "PRO.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "El rescate del justo es el impío,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.18",
            "verseOrgIds": [
              "PRO.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:18"
      },
      "items": [
        {
          "text": "Y por los rectos el prevaricador.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.18",
            "verseOrgIds": [
              "PRO.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mejor es morar en tierra del desierto,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.19",
            "verseOrgIds": [
              "PRO.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:19"
      },
      "items": [
        {
          "text": "Que con la mujer rencillosa é iracunda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.19",
            "verseOrgIds": [
              "PRO.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tesoro codiciable y pingüe hay en la casa del sabio;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.20",
            "verseOrgIds": [
              "PRO.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:20"
      },
      "items": [
        {
          "text": "Mas el hombre insensato lo disipará.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.20",
            "verseOrgIds": [
              "PRO.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que sigue la justicia y la misericordia,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.21",
            "verseOrgIds": [
              "PRO.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:21"
      },
      "items": [
        {
          "text": "Hallará la vida, la justicia, y la honra.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.21",
            "verseOrgIds": [
              "PRO.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "La ciudad de los fuertes tomó el sabio,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.22",
            "verseOrgIds": [
              "PRO.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:22"
      },
      "items": [
        {
          "text": "Y derribó la fuerza en que ella confiaba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.22",
            "verseOrgIds": [
              "PRO.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que guarda su boca y su lengua,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.23",
            "verseOrgIds": [
              "PRO.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:23"
      },
      "items": [
        {
          "text": "Su alma guarda de angustias.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.23",
            "verseOrgIds": [
              "PRO.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soberbio y presuntuoso escarnecedor es el nombre",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.24",
            "verseOrgIds": [
              "PRO.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:24"
      },
      "items": [
        {
          "text": "Del que obra con orgullosa saña.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.24",
            "verseOrgIds": [
              "PRO.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Proverbios sobre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 diversos asuntos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "El deseo del perezoso le mata,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.25",
            "verseOrgIds": [
              "PRO.21.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:25"
      },
      "items": [
        {
          "text": "Porque sus manos no quieren trabajar.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.25",
            "verseOrgIds": [
              "PRO.21.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hay quien todo el día codicia:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.26",
            "verseOrgIds": [
              "PRO.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:26"
      },
      "items": [
        {
          "text": "Mas el",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.26",
            "verseOrgIds": [
              "PRO.21.26"
            ]
          }
        },
        {
          "text": "justo da, y no desperdicia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.26",
            "verseOrgIds": [
              "PRO.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "El sacrificio de los impíos es abominación:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.27",
            "verseOrgIds": [
              "PRO.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:27"
      },
      "items": [
        {
          "text": "¡Cuánto más ofreciéndolo con maldad!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.27",
            "verseOrgIds": [
              "PRO.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "El testigo mentiroso perecerá:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.28",
            "verseOrgIds": [
              "PRO.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:28"
      },
      "items": [
        {
          "text": "Mas el hombre que oye, permanecerá en su dicho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.28",
            "verseOrgIds": [
              "PRO.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hombre impío afirma rostro:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.29",
            "verseOrgIds": [
              "PRO.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:29"
      },
      "items": [
        {
          "text": "Mas el recto ordena sus caminos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.29",
            "verseOrgIds": [
              "PRO.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "No hay sabiduría, ni inteligencia,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.30",
            "verseOrgIds": [
              "PRO.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:30"
      },
      "items": [
        {
          "text": "Ni consejo, contra Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.30",
            "verseOrgIds": [
              "PRO.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "El caballo se apareja para el día de la batalla:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.31",
            "verseOrgIds": [
              "PRO.21.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 21:31"
      },
      "items": [
        {
          "text": "Mas de Jehová es el salvar.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.31",
            "verseOrgIds": [
              "PRO.21.31"
            ]
          }
        }
      ]
    }
  ],
