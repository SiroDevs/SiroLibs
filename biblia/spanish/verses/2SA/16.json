                "verseId": "2SA.16.21",
                "verseOrgIds": [
                  "2SA.16.21"
                ]
              }
            }
          ]
        },
        {
          "text": "contigo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.21",
            "verseOrgIds": [
              "2SA.16.21"
            ]
          }
        }
