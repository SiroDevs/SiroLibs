        },
        {
          "text": "Entonces pusieron una tienda á Absalom sobre el terrado, y entró Absalom á las concubinas de su padre,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.22",
            "verseOrgIds": [
              "2SA.16.22"
            ]
          }
