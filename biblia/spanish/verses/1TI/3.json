{
  "id": "1TI.3",
  "number": "3",
  "bookId": "1TI",
  "reference": "1 Timoteo 3",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "1TI 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "PALABRA fiel:",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.1",
            "verseOrgIds": [
              "1TI.3.1"
            ]
          }
        },
        {
          "text": "Si alguno apetece obispado, buena obra desea.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.1",
            "verseOrgIds": [
              "1TI.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Conviene, pues, que el",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.2",
            "verseOrgIds": [
              "1TI.3.2"
            ]
          }
        },
        {
          "text": "obispo",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.2",
            "verseOrgIds": [
              "1TI.3.2"
            ]
          }
        },
        {
          "text": "sea irreprensible, marido de una mujer, solícito, templado, compuesto,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.2",
            "verseOrgIds": [
              "1TI.3.2"
            ]
          }
        },
        {
          "text": "hospedador,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.2",
            "verseOrgIds": [
              "1TI.3.2"
            ]
          }
        },
        {
          "text": "apto para enseñar;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.2",
            "verseOrgIds": [
              "1TI.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "No amador del vino, no heridor, no codicioso de torpes ganancias, sino moderado, no litigioso, ajeno de avaricia;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.3",
            "verseOrgIds": [
              "1TI.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que gobierne bien su casa,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.4",
            "verseOrgIds": [
              "1TI.3.4"
            ]
          }
        },
        {
          "text": "que tenga sus hijos en sujeción con toda",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.4",
            "verseOrgIds": [
              "1TI.3.4"
            ]
          }
        },
        {
          "text": "honestidad;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.4",
            "verseOrgIds": [
              "1TI.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Porque el que no sabe gobernar su casa, ¿cómo cuidará de",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.5",
            "verseOrgIds": [
              "1TI.3.5"
            ]
          }
        },
        {
          "text": "la iglesia de Dios?)",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.5",
            "verseOrgIds": [
              "1TI.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "No un neófito, porque inflándose no caiga en",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.6",
            "verseOrgIds": [
              "1TI.3.6"
            ]
          }
        },
        {
          "text": "juicio del diablo.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.6",
            "verseOrgIds": [
              "1TI.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "También conviene que",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.7",
            "verseOrgIds": [
              "1TI.3.7"
            ]
          }
        },
        {
          "text": "tenga buen testimonio de",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.7",
            "verseOrgIds": [
              "1TI.3.7"
            ]
          }
        },
        {
          "text": "los extraños, porque no caiga en afrenta",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.7",
            "verseOrgIds": [
              "1TI.3.7"
            ]
          }
        },
        {
          "text": "y en lazo del diablo.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.7",
            "verseOrgIds": [
              "1TI.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los diáconos asimismo,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.8",
            "verseOrgIds": [
              "1TI.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "deben ser",
              "type": "text",
              "attrs": {
                "verseId": "1TI.3.8",
                "verseOrgIds": [
                  "1TI.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.8",
            "verseOrgIds": [
              "1TI.3.8"
            ]
          }
        },
        {
          "text": "honestos, no bilingües, no dados á mucho vino, no amadores de torpes ganancias;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.8",
            "verseOrgIds": [
              "1TI.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que tengan",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.9",
            "verseOrgIds": [
              "1TI.3.9"
            ]
          }
        },
        {
          "text": "el misterio de la fe con limpia conciencia.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.9",
            "verseOrgIds": [
              "1TI.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y éstos también sean antes probados; y así ministren, si fueren sin crimen.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.10",
            "verseOrgIds": [
              "1TI.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las mujeres",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.11",
            "verseOrgIds": [
              "1TI.3.11"
            ]
          }
        },
        {
          "text": "asimismo, honestas, no detractoras, templadas, fieles en todo.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.11",
            "verseOrgIds": [
              "1TI.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los diáconos sean maridos de una mujer, que gobiernen bien sus hijos y sus casas.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.12",
            "verseOrgIds": [
              "1TI.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque los que bien ministraren, ganan para sí buen grado, y mucha confianza en la fe que es en Cristo Jesús.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.13",
            "verseOrgIds": [
              "1TI.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esto te escribo con esperanza que iré presto á ti:",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.14",
            "verseOrgIds": [
              "1TI.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y si no fuere tan presto, para que sepas cómo te conviene conversar",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.15",
            "verseOrgIds": [
              "1TI.3.15"
            ]
          }
        },
        {
          "text": "en la casa de Dios, que es la iglesia del Dios vivo, columna y apoyo de la verdad.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.15",
            "verseOrgIds": [
              "1TI.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y sin contradicción, grande es",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        },
        {
          "text": "el misterio de la piedad: Dios ha sido manifestado",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        },
        {
          "text": "en carne;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        },
        {
          "text": "ha sido justificado con el Espíritu; ha sido",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        },
        {
          "text": "visto de los ángeles; ha sido predicado á los Gentiles; ha sido",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        },
        {
          "text": "creído en el mundo; ha sido",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        },
        {
          "text": "recibido en gloria.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1TI.4",
    "number": "4",
    "bookId": "1TI"
  },
