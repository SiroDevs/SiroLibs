          "attrs": {
            "verseId": "1KI.12.28",
            "verseOrgIds": [
              "1KI.12.28"
            ]
          }
        },
        {
          "text": "he aquí tus dioses, oh Israel, que te hicieron subir de la tierra de Egipto.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.28",
            "verseOrgIds": [
              "1KI.12.28"
            ]
          }
        }
      ]
    },
