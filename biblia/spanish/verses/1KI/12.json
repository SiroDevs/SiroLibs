              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entonces instituyó Jeroboam solemnidad en el mes octavo, á los quince del mes, conforme á",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        },
        {
          "text": "la solemnidad que",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "se celebraba",
              "type": "text",
              "attrs": {
                "verseId": "1KI.12.32",
                "verseOrgIds": [
                  "1KI.12.32"
                ]
              }
            }
          ]
        },
        {
          "text": "en Judá; y sacrificó sobre altar. Así hizo en Beth-el, sacrificando á los becerros que había hecho. Ordenó también en Beth-el sacerdotes de los altos que él había fabricado.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        }
      ]
