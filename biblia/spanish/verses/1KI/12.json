            "verseOrgIds": [
              "1KI.12.22"
            ]
          }
        },
        {
          "text": "varón de Dios, diciendo:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.22",
            "verseOrgIds": [
              "1KI.12.22"
            ]
          }
        }
