          "attrs": {
            "verseId": "ROM.16.26",
            "verseOrgIds": [
              "ROM.16.26"
            ]
          }
        },
        {
          "text": "y por las Escrituras de los profetas, según el mandamiento del Dios eterno, declarado á todas las gentes para que obedezcan á la fe;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.26",
            "verseOrgIds": [
              "ROM.16.26"
            ]
          }
        }
      ]
