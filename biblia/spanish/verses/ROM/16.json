          "type": "text",
          "attrs": {
            "verseId": "ROM.16.25",
            "verseOrgIds": [
              "ROM.16.25"
            ]
          }
        },
        {
          "text": "según mi evangelio y la predicación de Jesucristo,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.25",
            "verseOrgIds": [
              "ROM.16.25"
            ]
          }
        },
        {
          "text": "según la revelación del misterio",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.25",
            "verseOrgIds": [
              "ROM.16.25"
            ]
          }
        },
        {
          "text": "encubierto desde tiempos eternos,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.25",
            "verseOrgIds": [
              "ROM.16.25"
            ]
          }
        }
      ]
    },
