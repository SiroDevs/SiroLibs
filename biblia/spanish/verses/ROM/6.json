          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas ahora, librados del pecado, y hechos siervos á Dios, tenéis por vuestro fruto la santificación, y por fin la vida eterna.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.22",
            "verseOrgIds": [
              "ROM.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
