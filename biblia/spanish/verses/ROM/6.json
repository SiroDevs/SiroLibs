          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.23",
            "verseOrgIds": [
              "ROM.6.23"
            ]
          }
        },
        {
          "text": "la paga del pecado es muerte: mas",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.23",
            "verseOrgIds": [
              "ROM.6.23"
            ]
          }
        },
        {
          "text": "la dádiva de Dios es vida eterna en Cristo Jesús Señor nuestro.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.23",
            "verseOrgIds": [
              "ROM.6.23"
            ]
          }
