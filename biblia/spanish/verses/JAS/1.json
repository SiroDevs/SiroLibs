{
  "id": "JAS.1",
  "number": "1",
  "bookId": "JAS",
  "reference": "Santiago 1",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JAS 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JAS 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "JACOBO,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.1",
            "verseOrgIds": [
              "JAS.1.1"
            ]
          }
        },
        {
          "text": "siervo de Dios y del Señor Jesucristo,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.1",
            "verseOrgIds": [
              "JAS.1.1"
            ]
          }
        },
        {
          "text": "a las doce tribus",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.1",
            "verseOrgIds": [
              "JAS.1.1"
            ]
          }
        },
        {
          "text": "que están esparcidas, salud.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.1",
            "verseOrgIds": [
              "JAS.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JAS 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hermanos míos, tened por sumo gozo cuando cayereis en diversas tentaciones;",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.2",
            "verseOrgIds": [
              "JAS.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JAS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabiendo",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.3",
            "verseOrgIds": [
              "JAS.1.3"
            ]
          }
        },
        {
          "text": "que la prueba de vuestra fe",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.3",
            "verseOrgIds": [
              "JAS.1.3"
            ]
          }
        },
        {
          "text": "obra paciencia.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.3",
            "verseOrgIds": [
              "JAS.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JAS 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas tenga la paciencia perfecta",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.4",
            "verseOrgIds": [
              "JAS.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "su",
              "type": "text",
              "attrs": {
                "verseId": "JAS.1.4",
                "verseOrgIds": [
                  "JAS.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "obra, para que seáis",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.4",
            "verseOrgIds": [
              "JAS.1.4"
            ]
          }
        },
        {
          "text": "perfectos y cabales, sin faltar en alguna cosa.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.4",
            "verseOrgIds": [
              "JAS.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JAS 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y si alguno de vosotros tiene falta de sabiduría,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.5",
            "verseOrgIds": [
              "JAS.1.5"
            ]
          }
        },
        {
          "text": "demándela á Dios, el cual da á todos abundantemente, y no zahiere; y le será dada.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.5",
            "verseOrgIds": [
              "JAS.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pero",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.6",
            "verseOrgIds": [
              "JAS.1.6"
            ]
          }
        },
        {
          "text": "pida en fe,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.6",
            "verseOrgIds": [
              "JAS.1.6"
            ]
          }
        },
        {
          "text": "no dudando nada: porque el que duda es semejante á",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.6",
            "verseOrgIds": [
              "JAS.1.6"
            ]
          }
        },
        {
          "text": "la onda de la mar, que es movida del viento, y echada de una parte á otra.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.6",
            "verseOrgIds": [
              "JAS.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JAS 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "No piense pues el tal hombre que recibirá ninguna cosa del Señor.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.7",
            "verseOrgIds": [
              "JAS.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JAS 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hombre",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.8",
            "verseOrgIds": [
              "JAS.1.8"
            ]
          }
        },
        {
          "text": "de doblado ánimo es inconstante en todos sus caminos.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.8",
            "verseOrgIds": [
              "JAS.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JAS 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hermano que es de baja suerte, gloríese",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.9",
            "verseOrgIds": [
              "JAS.1.9"
            ]
          }
        },
        {
          "text": "en su alteza:",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.9",
            "verseOrgIds": [
              "JAS.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JAS 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas el que es rico,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.10",
            "verseOrgIds": [
              "JAS.1.10"
            ]
          }
        },
        {
          "text": "en su bajeza; porque",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.10",
            "verseOrgIds": [
              "JAS.1.10"
            ]
          }
        },
        {
          "text": "él se pasará como la flor de la hierba.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.10",
            "verseOrgIds": [
              "JAS.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque salido el sol con ardor,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.11",
            "verseOrgIds": [
              "JAS.1.11"
            ]
          }
        },
        {
          "text": "la hierba se secó, y su flor se cayó, y pereció su hermosa apariencia: así también se marchitará el rico en todos sus caminos.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.11",
            "verseOrgIds": [
              "JAS.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienaventurado el varón que sufre la tentación; porque cuando fuere probado, recibirá",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.12",
            "verseOrgIds": [
              "JAS.1.12"
            ]
          }
        },
        {
          "text": "la corona de vida,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.12",
            "verseOrgIds": [
              "JAS.1.12"
            ]
          }
        },
        {
          "text": "que Dios ha prometido á los que le aman.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.12",
            "verseOrgIds": [
              "JAS.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando alguno es tentado, no diga que es tentado de Dios: porque Dios no puede ser tentado de los malos, ni él tienta á alguno:",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.13",
            "verseOrgIds": [
              "JAS.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sino que cada uno es tentado, cuando",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.14",
            "verseOrgIds": [
              "JAS.1.14"
            ]
          }
        },
        {
          "text": "de su propia concupiscencia es atraído, y cebado.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.14",
            "verseOrgIds": [
              "JAS.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y la concupiscencia,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.15",
            "verseOrgIds": [
              "JAS.1.15"
            ]
          }
        },
        {
          "text": "después que ha concebido, pare el pecado: y el pecado, siendo cumplido,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.15",
            "verseOrgIds": [
              "JAS.1.15"
            ]
          }
        },
        {
          "text": "engendra muerte.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.15",
            "verseOrgIds": [
              "JAS.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amados hermanos míos, no erréis.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.16",
            "verseOrgIds": [
              "JAS.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toda buena dádiva",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.17",
            "verseOrgIds": [
              "JAS.1.17"
            ]
          }
        },
        {
          "text": "y todo don perfecto es de lo alto, que desciende del",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.17",
            "verseOrgIds": [
              "JAS.1.17"
            ]
          }
        },
        {
          "text": "Padre de las luces,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.17",
            "verseOrgIds": [
              "JAS.1.17"
            ]
          }
        },
        {
          "text": "en el cual no hay mudanza, ni sombra de variación.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.17",
            "verseOrgIds": [
              "JAS.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "El,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.18",
            "verseOrgIds": [
              "JAS.1.18"
            ]
          }
        },
        {
          "text": "de su voluntad nos ha engendrado por la palabra de verdad,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.18",
            "verseOrgIds": [
              "JAS.1.18"
            ]
          }
        },
        {
          "text": "para que seamos",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.18",
            "verseOrgIds": [
              "JAS.1.18"
            ]
          }
        },
        {
          "text": "primicias de sus criaturas.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.18",
            "verseOrgIds": [
              "JAS.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JAS 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por esto, mis amados hermanos, todo hombre sea",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.19",
            "verseOrgIds": [
              "JAS.1.19"
            ]
          }
        },
        {
          "text": "pronto para oir,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.19",
            "verseOrgIds": [
              "JAS.1.19"
            ]
          }
        },
        {
          "text": "tardío para hablar,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.19",
            "verseOrgIds": [
              "JAS.1.19"
            ]
          }
        },
        {
          "text": "tardío para airarse:",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.19",
            "verseOrgIds": [
              "JAS.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JAS 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque la ira del hombre no obra la justicia de Dios.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.20",
            "verseOrgIds": [
              "JAS.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JAS 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por lo cual,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.21",
            "verseOrgIds": [
              "JAS.1.21"
            ]
          }
        },
        {
          "text": "dejando toda inmundicia y superfluidad de malicia, recibid con mansedumbre la palabra ingerida,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.21",
            "verseOrgIds": [
              "JAS.1.21"
            ]
          }
        },
        {
          "text": "la cual puede hacer salvas vuestras almas.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.21",
            "verseOrgIds": [
              "JAS.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JAS 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas sed",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.22",
            "verseOrgIds": [
              "JAS.1.22"
            ]
          }
        },
        {
          "text": "hacedores de la palabra, y no tan solamente oidores, engañándoos á vosotros mismos.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.22",
            "verseOrgIds": [
              "JAS.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JAS 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.23",
            "verseOrgIds": [
              "JAS.1.23"
            ]
          }
        },
        {
          "text": "si alguno oye la palabra, y no la pone por obra, este tal es semejante al hombre que considera en",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.23",
            "verseOrgIds": [
              "JAS.1.23"
            ]
          }
        },
        {
          "text": "un espejo su rostro natural.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.23",
            "verseOrgIds": [
              "JAS.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JAS 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque él se consideró á sí mismo, y se fué, y luego se olvidó qué tal era.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.24",
            "verseOrgIds": [
              "JAS.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JAS 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas el que hubiere mirado atentamente en la perfecta",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.25",
            "verseOrgIds": [
              "JAS.1.25"
            ]
          }
        },
        {
          "text": "ley,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.25",
            "verseOrgIds": [
              "JAS.1.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "que es",
              "type": "text",
              "attrs": {
                "verseId": "JAS.1.25",
                "verseOrgIds": [
                  "JAS.1.25"
                ]
              }
            }
          ]
        },
        {
          "text": "la de la libertad, y perseverado",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.25",
            "verseOrgIds": [
              "JAS.1.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "en ella,",
              "type": "text",
              "attrs": {
                "verseId": "JAS.1.25",
                "verseOrgIds": [
                  "JAS.1.25"
                ]
              }
            }
          ]
        },
        {
          "text": "no siendo oidor olvidadizo, sino hacedor de la obra, este tal será bienaventurado en su hecho.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.25",
            "verseOrgIds": [
              "JAS.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JAS 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si alguno piensa ser religioso entre vosotros,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.26",
            "verseOrgIds": [
              "JAS.1.26"
            ]
          }
        },
        {
          "text": "y no refrena su lengua, sino engañando su corazón, la religión del tal es vana.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.26",
            "verseOrgIds": [
              "JAS.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JAS 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "La religión pura y sin mácula delante de",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.27",
            "verseOrgIds": [
              "JAS.1.27"
            ]
          }
        },
        {
          "text": "Dios y Padre es esta:",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.27",
            "verseOrgIds": [
              "JAS.1.27"
            ]
          }
        },
        {
          "text": "Visitar los huérfanos y las viudas en sus tribulaciones,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.27",
            "verseOrgIds": [
              "JAS.1.27"
            ]
          }
        },
        {
          "text": "y guardarse sin mancha de este mundo.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.27",
            "verseOrgIds": [
              "JAS.1.27"
            ]
          }
        }
      ]
    }
