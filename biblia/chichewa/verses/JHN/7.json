  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JHN 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Apita Kuphwando Lamisasa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zitatha izi Yesu anayendayenda mu Galileya, ndi cholinga chakuti asafike ku Yudeya chifukwa Ayuda kumeneko amadikira kuti amuphe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.1",
            "verseOrgIds": [
              "JHN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma phwando la Ayuda lamisasa litayandikira,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.2",
            "verseOrgIds": [
              "JHN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "abale a Yesu anati kwa Iye, \"Inu muyenera kuchoka kuno ndi kupita ku Yudeya, kuti ophunzira anu akaone zodabwitsa zomwe mumachita.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.3",
            "verseOrgIds": [
              "JHN.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palibe wina aliyense amene amafuna kukhala wodziwika amachita zinthu mseri. Popeza Inu mukuchita zinthu izi, mudzionetsere nokha ku dziko la pansi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.4",
            "verseOrgIds": [
              "JHN.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ngakhale abale ake omwe sanamukhulupirire.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.5",
            "verseOrgIds": [
              "JHN.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yesu anawawuza iwo kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.6",
            "verseOrgIds": [
              "JHN.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nthawi yanga yoyenera sinafike; kwa inu nthawi ina iliyonse ndi yoyenera.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.6",
                "verseOrgIds": [
                  "JHN.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.6",
            "verseOrgIds": [
              "JHN.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Dziko lapansi silingakudeni inu, koma limandida Ine chifukwa Ine ndimachitira umboni kuti zomwe limachita ndi zoyipa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.7",
                "verseOrgIds": [
                  "JHN.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.7",
            "verseOrgIds": [
              "JHN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Inu pitani kuphwando. Ine sindipita tsopano kuphwando ili chifukwa kwa Ine nthawi yoyenera sinafike.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.8",
                "verseOrgIds": [
                  "JHN.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.8",
            "verseOrgIds": [
              "JHN.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atanena izi, Iye anakhalabe mu Galileya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.9",
            "verseOrgIds": [
              "JHN.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe, abale ake atanyamuka kupita kuphwando, Iye anapitanso, osati moonekera, koma mseri.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.10",
            "verseOrgIds": [
              "JHN.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano kuphwandoko Ayuda anakamufunafuna ndi kumafunsana kuti, \"Kodi munthu ameneyu ali kuti?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.11",
            "verseOrgIds": [
              "JHN.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti pa chigulu cha anthu panali kunongʼona ponseponse za Iye. Ena ankanena kuti, \"Iye ndi munthu wabwino.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.12",
            "verseOrgIds": [
              "JHN.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 7:12"
      },
      "items": [
        {
          "text": "Ena ankayankha kuti, \"Ayi, Iye amanamiza anthu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.12",
            "verseOrgIds": [
              "JHN.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma panalibe amene ankanena kalikonse poyera za Iye chifukwa choopa Ayuda.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.13",
            "verseOrgIds": [
              "JHN.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Aphunzitsa pa Phwando",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phwando lili pakatikati, Yesu anapita ku bwalo la Nyumba ya Mulungu ndi kuyamba kuphunzitsa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.14",
            "verseOrgIds": [
              "JHN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayuda anadabwa ndipo anafunsa kuti, \"Kodi munthu uyu nzeru izi anazitenga kuti popanda kuphunzira?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.15",
            "verseOrgIds": [
              "JHN.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.16",
            "verseOrgIds": [
              "JHN.7.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chiphunzitso changa si cha Ine ndekha. Chimachokera kwa Iye amene anandituma.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.16",
                "verseOrgIds": [
                  "JHN.7.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.16",
            "verseOrgIds": [
              "JHN.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati munthu asankha kuchita chifuniro cha Mulungu, adzazindikira ngati chiphunzitso changa nʼchochokera kwa Mulungu kapena ngati ndi mwa Ine ndekha.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.17",
                "verseOrgIds": [
                  "JHN.7.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.17",
            "verseOrgIds": [
              "JHN.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iye amene amayankhula za Iye mwini amatero kuti adzipezere ulemu, koma amene amagwira ntchito kuti amene anamutuma alandire ulemu, ameneyo ndiye munthu woona; mu mtima mwake mulibe chinyengo chilichonse.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.18",
                "verseOrgIds": [
                  "JHN.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.18",
            "verseOrgIds": [
              "JHN.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kodi Mose sanakupatseni lamulo? Komatu palibe ndi mmodzi yemwe mwa inu amene akusunga lamulo. Nʼchifukwa chiyani mukufuna kundipha Ine?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.19",
                "verseOrgIds": [
                  "JHN.7.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gulu la anthu linayankha kuti, \"Iwe ndiye wagwidwa ndi ziwanda. Ndani akufuna kukupha?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.20",
            "verseOrgIds": [
              "JHN.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anawawuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.21",
            "verseOrgIds": [
              "JHN.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ine ndinachita chodabwitsa chimodzi ndipo inu mwadabwa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.21",
                "verseOrgIds": [
                  "JHN.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.21",
            "verseOrgIds": [
              "JHN.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma, chifukwa chakuti Mose anakulamulani kuti muzichita mdulidwe (ngakhale kuti sunachokere kwa Mose, koma kwa makolo anu), inuyo mumachita mdulidwe mwana tsiku la Sabata.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.22",
                "verseOrgIds": [
                  "JHN.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.22",
            "verseOrgIds": [
              "JHN.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tsopano ngati mwana angachite mdulidwe pa Sabata kuti lamulo la Mose lisaswedwe, nʼchifukwa chiyani mukundipsera mtima chifukwa chochiritsa munthu pa Sabata?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.23",
                "verseOrgIds": [
                  "JHN.7.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.23",
            "verseOrgIds": [
              "JHN.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Musamaweruze potengera maonekedwe chabe, koma weruzani molungama.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.24",
                "verseOrgIds": [
                  "JHN.7.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kodi Yesu ndi Khristu?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi imeneyi anthu ena a ku Yerusalemu anayamba kufunsana kuti, \"Kodi uyu si munthu uja akufuna kumuphayu?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.25",
            "verseOrgIds": [
              "JHN.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu ali apa, kuyankhula poyera, ndipo iwo sakunena kanthu kwa Iye. Kodi olamulira atsimikizadi kuti Iye ndi Khristu?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.26",
            "verseOrgIds": [
              "JHN.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ife tikudziwa kumene achokera munthuyu; pamene Khristu adzabwere, palibe amene adzadziwa kumene akuchokera.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.27",
            "verseOrgIds": [
              "JHN.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yesu, akuphunzitsabe mʼbwalo la Nyumba ya Mulungu anafuwula kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.28",
            "verseOrgIds": [
              "JHN.7.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zoona, mukundidziwa Ine, ndipo mukudziwa kumene ndikuchokera. Ine sindili pano mwa Ine ndekha, koma Iye amene anandituma Ine ndi woona. Inu simukumudziwa,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.28",
                "verseOrgIds": [
                  "JHN.7.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.28",
            "verseOrgIds": [
              "JHN.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "koma Ine ndikumudziwa chifukwa ndichokera kwa Iyeyo ndipo ndiye amene anandituma Ine.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.29",
                "verseOrgIds": [
                  "JHN.7.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa cha izi iwo anayesa kumugwira Iye, koma palibe aliyense amene anayika dzanja lake pa Iye, chifukwa nthawi yake inali isanafike.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.30",
            "verseOrgIds": [
              "JHN.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe, ambiri a mʼchigulucho anamukhulupirira Iye. Iwo anati, \"Kodi pamene Khristu abwera, adzachita zizindikiro zodabwitsa zambiri kuposa munthu uyu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.31",
            "verseOrgIds": [
              "JHN.7.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afarisi anamva chigulucho chikunongʼona zinthu zotere za Iye. Kenaka akulu a ansembe ndi Afarisi anatumiza asilikali a mʼNyumba ya Mulungu kuti akamumange Iye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.32",
            "verseOrgIds": [
              "JHN.7.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anati,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.33",
            "verseOrgIds": [
              "JHN.7.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ine ndili ndi inu kwa kanthawi kochepa chabe, ndipo kenaka ndizipita kwa Iye amene anandituma Ine.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.33",
                "verseOrgIds": [
                  "JHN.7.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.33",
            "verseOrgIds": [
              "JHN.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Inu mudzandifunafuna koma simudzandipeza; ndipo kumene Ine ndili inu simungathe kubwera.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.34",
                "verseOrgIds": [
                  "JHN.7.34"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayuda anati kwa wina ndi mnzake, \"Kodi munthu uyu akuganizira zoti apite kuti kumene ife sitingathe kumupeza Iye? Kodi Iye adzapita kumene anthu amakhala mobalalikana pakati pa Agriki, ndi kuphunzitsa Agriki?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.35",
            "verseOrgIds": [
              "JHN.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Iye amatanthauza chiyani pamene anati,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.36",
            "verseOrgIds": [
              "JHN.7.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Inu mudzandifunafuna koma simudzandipeza,'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.36",
                "verseOrgIds": [
                  "JHN.7.36"
                ]
              }
            }
          ]
        },
        {
          "text": "ndi",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.36",
            "verseOrgIds": [
              "JHN.7.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Kumene Ine ndili, inu simungathe kubwera?' \"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.36",
                "verseOrgIds": [
                  "JHN.7.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mitsinje ya Madzi Opatsa Moyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku lomaliza ndi lalikulu kwambiri laphwando, Yesu anayimirira nafuwula nati,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.37",
            "verseOrgIds": [
              "JHN.7.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngati munthu ali ndi ludzu, abwere kwa Ine kuti adzamwe.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.37",
                "verseOrgIds": [
                  "JHN.7.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.37",
            "verseOrgIds": [
              "JHN.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Malemba kuti 'Aliyense amene akhulupirira Ine, mitsinje yamadzi amoyo idzatuluka kuchokera mʼkati mwake.' \"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.38",
                "verseOrgIds": [
                  "JHN.7.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.38",
            "verseOrgIds": [
              "JHN.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ponena izi Iye amatanthauza Mzimu Woyera, amene adzalandire amene amakhulupirira Iye. Pa nthawiyi nʼkuti Mzimu Woyera asanaperekedwe, pakuti Yesu anali asanalemekezedwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.39",
            "verseOrgIds": [
              "JHN.7.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakumva mawu ake, ena a anthuwo anati, \"Zoonadi munthu uyu ndi mneneri.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.40",
            "verseOrgIds": [
              "JHN.7.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena anati, \"Iye ndiye Khristu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.41",
            "verseOrgIds": [
              "JHN.7.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 7:41"
      },
      "items": [
        {
          "text": "Komanso ena anafunsa kuti, \"Kodi Khristu angachokere bwanji ku Galileya?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.41",
            "verseOrgIds": [
              "JHN.7.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Malemba samanena kuti Khristu adzachokera mʼbanja la Davide, ndi ku Betelehemu mu mzinda umene Davide anakhalamo?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.42",
            "verseOrgIds": [
              "JHN.7.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero anthu anagawikana chifukwa cha Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.43",
            "verseOrgIds": [
              "JHN.7.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena anafuna kumugwira Iye, koma palibe amene anayika dzanja pa Iye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.44",
            "verseOrgIds": [
              "JHN.7.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusakhulupirira kwa Atsogoleri a Ayuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pomaliza asilikali a mʼNyumba ya Mulungu anabwerera kwa akulu a ansembe ndi Afarisi amene anawafunsa iwo kuti, \"Kodi ndi chifukwa chiyani simunamugwire Iye?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.45",
            "verseOrgIds": [
              "JHN.7.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asilikali aja anati, \"Palibe wina amene anayankhula ngati Munthu ameneyo nʼkale lonse.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.46",
            "verseOrgIds": [
              "JHN.7.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afarisi anawadzudzula nati, \"Kodi mukutanthauza kuti Iye anakunamizani inunso?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.47",
            "verseOrgIds": [
              "JHN.7.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi alipo ena a olamulira kapena a Afarisi, anamukhulupirira Iye?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.48",
            "verseOrgIds": [
              "JHN.7.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 7:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi! Koma gulu limene silidziwa malamulo ndi lotembereredwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.49",
            "verseOrgIds": [
              "JHN.7.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekodimo, amene anapita kwa Yesu poyamba paja ndipo anali mmodzi wa iwo, anafunsa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.50",
            "verseOrgIds": [
              "JHN.7.50"
            ]
