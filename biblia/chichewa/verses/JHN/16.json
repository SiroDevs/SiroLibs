  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "JHN 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ine ndakuwuzani zonsezi kuti musadzakhumudwe.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.1",
                "verseOrgIds": [
                  "JHN.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.1",
            "verseOrgIds": [
              "JHN.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iwo adzakuchotsani mʼsunagoge mwawo. Kunena zoona, nthawi ikubwera imene aliyense amene adzakuphani adzaganiza kuti akutumikira Mulungu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.2",
                "verseOrgIds": [
                  "JHN.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.2",
            "verseOrgIds": [
              "JHN.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iwo adzachita zoterozo chifukwa sanadziwe Atate kapena Inenso.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.3",
                "verseOrgIds": [
                  "JHN.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.3",
            "verseOrgIds": [
              "JHN.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndakuwuzani izi kuti nthawi ikadzafika mudzakumbukire kuti Ine ndinakuchenjezani kale. Ine sindinakuwuzeni izi poyamba paja chifukwa ndinali nanu.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.4",
                "verseOrgIds": [
                  "JHN.16.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ntchito ya Mzimu Woyera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tsopano Ine ndikupita kwa Iye amene anandituma koma palibe wina mwa inu akundifunsa kuti, 'Kodi mukupita kuti?'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.5",
                "verseOrgIds": [
                  "JHN.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.5",
            "verseOrgIds": [
              "JHN.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Muli ndi chisoni kwambiri chifukwa ndakuwuzani zimene.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.6",
                "verseOrgIds": [
                  "JHN.16.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.6",
            "verseOrgIds": [
              "JHN.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Komatu ndakuwuzani zoona. Ine ndikuti kuli bwino kwa inu kuti ndichoke. Ngati sindichoka, Nkhosweyo sidzabwera kwa inu, koma ngati Ine ndipita, ndidzamutumiza kwa inu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.7",
                "verseOrgIds": [
                  "JHN.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.7",
            "verseOrgIds": [
              "JHN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iye akabwera, adzatsutsa dziko lapansi za uchimo, zachilungamo ndi zachiweruzo.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.8",
                "verseOrgIds": [
                  "JHN.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.8",
            "verseOrgIds": [
              "JHN.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Za uchimo, chifukwa anthu sakhulupirira Ine.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.9",
                "verseOrgIds": [
                  "JHN.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.9",
            "verseOrgIds": [
              "JHN.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Za chilungamo, chifukwa Ine ndi kupita kwa Atate, kumene simudzandionanso.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.10",
                "verseOrgIds": [
                  "JHN.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.10",
            "verseOrgIds": [
              "JHN.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Za chiweruzo, chifukwa wolamulira dziko lino lapansi waweruzidwa tsopano.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.11",
                "verseOrgIds": [
                  "JHN.16.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ine ndili ndi zambiri zoti ndiyankhule nanu, koma simungathe kuzilandira tsopano.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.12",
                "verseOrgIds": [
                  "JHN.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.12",
            "verseOrgIds": [
              "JHN.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma pamene Iye, Mzimu wachoonadi, abwera, adzakutsogolerani mʼchoonadi chonse. Iye sadzayankhula mwa Iye yekha, adzayankhula zokhazo zimene wamva ndipo Iye adzakuwuzani zimene zikubwera.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.13",
                "verseOrgIds": [
                  "JHN.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.13",
            "verseOrgIds": [
              "JHN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iye adzalemekeza Ine chifukwa adzatenga za Ine nadzakudziwitsani.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.14",
                "verseOrgIds": [
                  "JHN.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.14",
            "verseOrgIds": [
              "JHN.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zonse za Atate ndi zanga. Ichi nʼchifukwa chake Ine ndanena kuti Mzimu Woyera adzatenga kwa Ine zanga kuti muzidziwe.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.15",
                "verseOrgIds": [
                  "JHN.16.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chisoni cha Ophunzira Chisandulika Chimwemwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anapitiriza kuyankhula kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.16",
            "verseOrgIds": [
              "JHN.16.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mwa kanthawi kochepa, simudzandionanso, ndipo patatha nthawi pangʼono mudzandionanso.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.16",
                "verseOrgIds": [
                  "JHN.16.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena a ophunzira ake anati kwa wina ndi mnzake, \"Kodi Iye akutanthauza chiyani ponena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Mwa kanthawi kochepa, simudzandionanso,'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.17",
                "verseOrgIds": [
                  "JHN.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ndi",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'ndipo patatha nthawi pangʼono mudzandionanso,'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.17",
                "verseOrgIds": [
                  "JHN.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ndiponso",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'chifukwa ndikupita kwa Atate?' \"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.17",
                "verseOrgIds": [
                  "JHN.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anapitiriza kufunsana kuti, \"Kodi akutanthauza chiyani,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.18",
            "verseOrgIds": [
              "JHN.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'kanthawi kochepa?'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.18",
                "verseOrgIds": [
                  "JHN.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Ife sitikumvetsetsa chimene Iye akuyankhula.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.18",
            "verseOrgIds": [
              "JHN.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anadziwa kuti ankafuna kuti amufunse za zimenezi, choncho anawafunsa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.19",
            "verseOrgIds": [
              "JHN.16.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi mukufunsana wina ndi mnzake chimene Ine ndimatanthauza pamene ndinati, 'Mwa kanthawi kochepa simudzandionanso,' ndi 'patatha nthawi pangʼono mudzandionanso?'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.19",
                "verseOrgIds": [
                  "JHN.16.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.19",
            "verseOrgIds": [
              "JHN.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zoonadi, Ine ndikukuwuzani kuti inu mudzalira ndi kubuma pomwe dziko lapansi lidzakhale likukondwera. Inu mudzamva chisoni, koma chisoni chanu chidzasandulika chimwemwe.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.20",
                "verseOrgIds": [
                  "JHN.16.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.20",
            "verseOrgIds": [
              "JHN.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mayi akamabereka mwana amamva ululu chifukwa nthawi yake yafika; koma mwana wake akabadwa amayiwala ululu wake chifukwa cha chimwemwe chake chakuti mwana wabadwa mʼdziko lapansi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.21",
                "verseOrgIds": [
                  "JHN.16.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.21",
            "verseOrgIds": [
              "JHN.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Chimodzimodzinso ndi inu. Tsopano ino ndi nthawi yanu yomva chisoni, koma Ine ndidzakuonaninso ndipo inu mudzasangalala, ndipo palibe amene adzachotsa chimwemwe chanu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.22",
                "verseOrgIds": [
                  "JHN.16.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.22",
            "verseOrgIds": [
              "JHN.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tsiku limenelo inu simudzandipemphanso kalikonse. Ine ndikukuwuzani zoona kuti Atate anga adzakupatsani chilichonse chimene mudzapempha mʼdzina langa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.23",
                "verseOrgIds": [
                  "JHN.16.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.23",
            "verseOrgIds": [
              "JHN.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mpaka tsopano simunapemphe kalikonse mʼdzina langa. Pemphani ndipo mudzalandira, ndipo chimwemwe chanu chidzakhala chathunthu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.24",
                "verseOrgIds": [
                  "JHN.16.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngakhale ndakhala ndikuyankhula mʼmafanizo, nthawi ikubwera imene Ine sindidzagwiritsanso ntchito mafanizo otere koma ndidzakuwuzani momveka za Atate anga.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.25",
                "verseOrgIds": [
                  "JHN.16.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.25",
            "verseOrgIds": [
              "JHN.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tsiku limenelo inu mudzapempha mʼdzina langa. Ine sindikunena kuti ndidzapempha Atate mʼmalo mwanu ayi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.26",
                "verseOrgIds": [
                  "JHN.16.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.26",
            "verseOrgIds": [
              "JHN.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Atate mwini anakukondani chifukwa inu mwandikonda Ine ndipo mwakhulupirira kuti Ine ndinabwera kuchokera kwa Atate.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.27",
                "verseOrgIds": [
                  "JHN.16.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.27",
            "verseOrgIds": [
              "JHN.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndinabwera kuchokera kwa Atate ndi kulowa mʼdziko lapansi. Tsopano ndikulisiya dziko lapansi kubwerera kwa Atate.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.28",
                "verseOrgIds": [
                  "JHN.16.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka ophunzira ake anati, \"Tsopano mukuyankhula momveka bwino ndi mopanda mafanizo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.29",
            "verseOrgIds": [
              "JHN.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano ife tikuona kuti Inu mumadziwa zinthu zonse ndi kuti sipafunika wina aliyense kukufunsani. Mwa ichi ife takhulupirira kuti Inu munachokera kwa Mulungu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.30",
            "verseOrgIds": [
              "JHN.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anawafunsa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi tsopano mwakhulupirira?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.31",
                "verseOrgIds": [
                  "JHN.16.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma nthawi ikubwera ndipo yafika, pamene inu mudzabalalitsidwa, aliyense ku nyumba yake. Inu mudzandisiya ndekhandekha. Koma Ine sindili ndekha, pakuti Atate anga ali nane.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.32",
                "verseOrgIds": [
                  "JHN.16.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ine ndakuwuzani izi kuti mwa Ine mukhale nawo mtendere. Mʼdziko lapansi mudzakhala nawo mavuto. Koma limbikani mtima! Ine ndaligonjetsa dziko lapansi.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.33",
                "verseOrgIds": [
                  "JHN.16.33"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
