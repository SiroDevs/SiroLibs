      "attrs": {
        "style": "q2",
        "vid": "JOB 6:24"
      },
      "items": [
        {
          "text": "ndionetseni pomwe ndalakwitsa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.24",
            "verseOrgIds": [
              "JOB.6.24"
            ]
          }
        }
