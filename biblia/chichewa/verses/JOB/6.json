      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:19"
      },
      "items": [
        {
          "text": "anthu amalonda apaulendo a ku Seba amafunafuna mwa chiyembekezo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.19",
            "verseOrgIds": [
              "JOB.6.19"
            ]
          }
