      "attrs": {
        "style": "q2",
        "vid": "JOB 6:25"
      },
      "items": [
        {
          "text": "Koma mawu anu otsutsa akufuna kuonetsa chiyani?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.25",
            "verseOrgIds": [
              "JOB.6.25"
            ]
          }
        }
      ]
    },
