          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amataya mtima chifukwa ankayembekezera kupeza madzi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.20",
            "verseOrgIds": [
              "JOB.6.20"
            ]
          }
        }
