      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:21"
      },
      "items": [
        {
          "text": "mukuona chinthu choopsa kwambiri ndipo mukuchita mantha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.21",
            "verseOrgIds": [
              "JOB.6.21"
            ]
          }
