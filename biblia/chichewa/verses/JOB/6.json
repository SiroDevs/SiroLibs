  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "JOB 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawu a Yobu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Yobu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.1",
            "verseOrgIds": [
              "JOB.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Achikhala mavuto anga anayezedwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.2",
            "verseOrgIds": [
              "JOB.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:2"
      },
      "items": [
        {
          "text": "ndipo zipsinjo zanga zonse zikanayikidwa pa sikelo!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.2",
            "verseOrgIds": [
              "JOB.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithu, zikanalemera kupambana mchenga wa ku nyanja;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.3",
            "verseOrgIds": [
              "JOB.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:3"
      },
      "items": [
        {
          "text": "nʼchifukwa chake mawu anga akhala okhadzula.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.3",
            "verseOrgIds": [
              "JOB.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mivi ya Wamphamvuzonse yandibaya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:4"
      },
      "items": [
        {
          "text": "thupi langa likumva ululu wa miviyo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:4"
      },
      "items": [
        {
          "text": "zoopsa za Mulungu zandizinga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi bulu wakuthengo amalira akakhala ndi msipu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.5",
            "verseOrgIds": [
              "JOB.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:5"
      },
      "items": [
        {
          "text": "nanga ngʼombe imalira ikakhala ndi chakudya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.5",
            "verseOrgIds": [
              "JOB.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi chakudya chosakoma nʼkuchidya chopanda mchere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.6",
            "verseOrgIds": [
              "JOB.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:6"
      },
      "items": [
        {
          "text": "nanga choyera cha dzira chimakoma?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.6",
            "verseOrgIds": [
              "JOB.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zakudya zimenezi sindifuna nʼkuzilawa komwe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.7",
            "verseOrgIds": [
              "JOB.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:7"
      },
      "items": [
        {
          "text": "zakudya zimenezi zimabwerera kukhosi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.7",
            "verseOrgIds": [
              "JOB.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aa, ndikanalandira chimene ndikuchipempha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.8",
            "verseOrgIds": [
              "JOB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:8"
      },
      "items": [
        {
          "text": "chikhala Mulungu anandipatsa chimene ndikuchiyembekezera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.8",
            "verseOrgIds": [
              "JOB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "achikhala chinamukomera Mulungu kuti anditswanye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.9",
            "verseOrgIds": [
              "JOB.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:9"
      },
      "items": [
        {
          "text": "kulola dzanja lake kuti lindimenye ndi kundiwonongeratu!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.9",
            "verseOrgIds": [
              "JOB.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo ine ndikanakhalabe ndi chitonthozo ichi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.10",
            "verseOrgIds": [
              "JOB.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:10"
      },
      "items": [
        {
          "text": "ndikanakondwa mu ululu wanga wosalekezawu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.10",
            "verseOrgIds": [
              "JOB.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:10"
      },
      "items": [
        {
          "text": "podziwa kuti sindinakane mawu a Woyerayo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.10",
            "verseOrgIds": [
              "JOB.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi mphamvu zanga nʼzotani kuti ndizikhalabe ndi chiyembekezo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.11",
            "verseOrgIds": [
              "JOB.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:11"
      },
      "items": [
        {
          "text": "Nanga zoyembekezera zanga nʼzotani kuti ndipirirebe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.11",
            "verseOrgIds": [
              "JOB.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ine ndili ndi mphamvu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.12",
            "verseOrgIds": [
              "JOB.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:12"
      },
      "items": [
        {
          "text": "Nanga thupi langa ndi lolimba ngati chitsulo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.12",
            "verseOrgIds": [
              "JOB.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ndili ndi mphamvu zodzithandizira ndekha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.13",
            "verseOrgIds": [
              "JOB.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:13"
      },
      "items": [
        {
          "text": "nanga pakuti thandizo lachotsedwa kwa ine?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.13",
            "verseOrgIds": [
              "JOB.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munthu amene ali kakasi ayenera kukhala ndi abwenzi odzipereka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.14",
            "verseOrgIds": [
              "JOB.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:14"
      },
      "items": [
        {
          "text": "ngakhale kuti iyeyo wasiya kuopa Wamphamvuzonse.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.14",
            "verseOrgIds": [
              "JOB.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma abale anga ndi wosadalirika ngati mitsinje yowuma msanga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.15",
            "verseOrgIds": [
              "JOB.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:15"
      },
      "items": [
        {
          "text": "ngati mitsinje imene imathamanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.15",
            "verseOrgIds": [
              "JOB.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali ngati mitsinje ya madzi akuda nthawi ya dzinja,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.16",
            "verseOrgIds": [
              "JOB.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:16"
      },
      "items": [
        {
          "text": "imene madzi ake amakhala ambiri chifukwa chakuchuluka kwa mvula,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.16",
            "verseOrgIds": [
              "JOB.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma madziwo amasiya kuyenda nthawi yachilimwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.17",
            "verseOrgIds": [
              "JOB.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:17"
      },
      "items": [
        {
          "text": "ndipo nthawi yotentha madziwo amawumiratu mʼmitsinjemo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.17",
            "verseOrgIds": [
              "JOB.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu oyenda pa ngamira amapatukirako kufuna madzi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.18",
            "verseOrgIds": [
              "JOB.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:18"
      },
      "items": [
        {
          "text": "iwo amangoyendayenda nʼkufera mʼchipululu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.18",
            "verseOrgIds": [
              "JOB.6.18"
            ]
          }
        }
