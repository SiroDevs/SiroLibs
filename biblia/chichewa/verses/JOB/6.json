      "attrs": {
        "style": "q2",
        "vid": "JOB 6:26"
      },
      "items": [
        {
          "text": "ndipo mukufuna kuyesa mawu a munthu wosweka mtima ngati mphepo chabe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.26",
            "verseOrgIds": [
              "JOB.6.26"
            ]
