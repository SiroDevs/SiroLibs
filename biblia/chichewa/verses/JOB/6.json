      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:22"
      },
      "items": [
        {
          "text": "ndilipirireni dipo kuchokera pa chuma chanu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.22",
            "verseOrgIds": [
              "JOB.6.22"
            ]
