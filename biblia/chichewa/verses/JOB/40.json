  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
        "style": "c",
        "sid": "JOB 40"
      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anati kwa Yobu:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.1",
            "verseOrgIds": [
              "JOB.40.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi iwe ufuna kukangana ndi Wamphamvuzonse?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.2",
            "verseOrgIds": [
              "JOB.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:2"
      },
      "items": [
        {
          "text": "Iwe amene unatsutsana ndi Mulungu umuyankhe Iyeyo!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.2",
            "verseOrgIds": [
              "JOB.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yobu anayankha Yehova:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.3",
            "verseOrgIds": [
              "JOB.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ine sindili kanthu konse,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.4",
            "verseOrgIds": [
              "JOB.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:4"
      },
      "items": [
        {
          "text": "kodi ndingathe kukuyankhani chiyani? Ndagwira pakamwa panga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.4",
            "verseOrgIds": [
              "JOB.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinayankhula kamodzi, koma pano ndilibe yankho,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.5",
            "verseOrgIds": [
              "JOB.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:5"
      },
      "items": [
        {
          "text": "ndinayankha kawiri, koma sindiwonjezeranso mawu ena.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.5",
            "verseOrgIds": [
              "JOB.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova anayankha Yobu mʼkamvuluvulu kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.6",
            "verseOrgIds": [
              "JOB.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsopano vala dzilimbe ngati mwamuna;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.7",
            "verseOrgIds": [
              "JOB.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:7"
      },
      "items": [
        {
          "text": "ndikufunsa mafunso",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.7",
            "verseOrgIds": [
              "JOB.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:7"
      },
      "items": [
        {
          "text": "ndipo iwe undiyankhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.7",
            "verseOrgIds": [
              "JOB.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi iwe unganyoze chiweruzo changa cholungama?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.8",
            "verseOrgIds": [
              "JOB.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:8"
      },
      "items": [
        {
          "text": "Kodi ungandidzudzule kuti iweyo ukhale wolungama?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.8",
            "verseOrgIds": [
              "JOB.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi uli ndi dzanja monga la Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.9",
            "verseOrgIds": [
              "JOB.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:9"
      },
      "items": [
        {
          "text": "ndipo mawu ako angagunde ngati mphenzi monga a Mulungu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.9",
            "verseOrgIds": [
              "JOB.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati zili choncho udzikometsere ndi ulemerero ndi kukongola,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.10",
            "verseOrgIds": [
              "JOB.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:10"
      },
      "items": [
        {
          "text": "ndipo udziveke ulemu ndi ulemerero waufumu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.10",
            "verseOrgIds": [
              "JOB.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsanula ukali wako wosefukirawo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.11",
            "verseOrgIds": [
              "JOB.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:11"
      },
      "items": [
        {
          "text": "uyangʼane aliyense wodzikuza ndipo umuchepetse,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.11",
            "verseOrgIds": [
              "JOB.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyangʼane aliyense wodzikweza ndipo umutsitse,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.12",
            "verseOrgIds": [
              "JOB.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:12"
      },
      "items": [
        {
          "text": "uwapondereze oyipa onse pamalo pomwe alilipo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.12",
            "verseOrgIds": [
              "JOB.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onsewo uwakwirire pamodzi mfumbi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.13",
            "verseOrgIds": [
              "JOB.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:13"
      },
      "items": [
        {
          "text": "ukulunge nkhope zawo mʼmanda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.13",
            "verseOrgIds": [
              "JOB.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukatero Ine ndidzakuvomereza",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.14",
            "verseOrgIds": [
              "JOB.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:14"
      },
      "items": [
        {
          "text": "kuti dzanja lako lamanja lakupulumutsadi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.14",
            "verseOrgIds": [
              "JOB.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Taganiza za mvuwu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.15",
            "verseOrgIds": [
              "JOB.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:15"
      },
      "items": [
        {
          "text": "imene ndinayipanga monga momwe ndinapangira iwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.15",
            "verseOrgIds": [
              "JOB.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:15"
      },
      "items": [
        {
          "text": "ndipo imadya udzu ngati ngʼombe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.15",
            "verseOrgIds": [
              "JOB.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mphamvu zake ndi zazikulu kwambiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.16",
            "verseOrgIds": [
              "JOB.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:16"
      },
      "items": [
        {
          "text": "thupi lake ndi lanyonga kwambiri!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.16",
            "verseOrgIds": [
              "JOB.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mchira wake umayima tolotolo ngati mtengo wamkungudza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.17",
            "verseOrgIds": [
              "JOB.40.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:17"
      },
      "items": [
        {
          "text": "mitsempha ya ntchafu zake ndi yogwirana bwino.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.17",
            "verseOrgIds": [
              "JOB.40.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafupa ake ali ngati mapayipi amkuwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.18",
            "verseOrgIds": [
              "JOB.40.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:18"
      },
      "items": [
        {
          "text": "nthiti zake zili ngati mipiringidzo yachitsulo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.18",
            "verseOrgIds": [
              "JOB.40.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvuwuyo ndi yayikulu mwa zolengedwa za Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.19",
            "verseOrgIds": [
              "JOB.40.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:19"
      },
      "items": [
        {
          "text": "komatu mlengi wake amatha kuyiopseza ndi lupanga lake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.19",
            "verseOrgIds": [
              "JOB.40.19"
            ]
          }
        }
      ]
    },
    {
