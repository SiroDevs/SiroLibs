  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JOB 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawu a Yobu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake Yobu anatsekula pakamwa pake nayamba kutemberera tsiku limene iyeyo anabadwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.1",
            "verseOrgIds": [
              "JOB.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yobu anati:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.2",
            "verseOrgIds": [
              "JOB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsiku limene ine ndinabadwa litembereredwe",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.3",
            "verseOrgIds": [
              "JOB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:3"
      },
      "items": [
        {
          "text": "ndi usiku umene ananena kuti, 'Mwana wamwamuna wabadwa!'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.3",
            "verseOrgIds": [
              "JOB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo lisanduke mdima;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.4",
            "verseOrgIds": [
              "JOB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:4"
      },
      "items": [
        {
          "text": "Mulungu wa kumwambako asalilabadirenso;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.4",
            "verseOrgIds": [
              "JOB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:4"
      },
      "items": [
        {
          "text": "kuwala kusaonekenso pa tsikulo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.4",
            "verseOrgIds": [
              "JOB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mdima ndi mthunzi wa imfa zikhale pa tsiku limeneli;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:5"
      },
      "items": [
        {
          "text": "mtambo uphimbe tsikuli;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:5"
      },
      "items": [
        {
          "text": "mdima wandiweyani udetse kuwala kwake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku umenewo ukutidwe ndi mdima wandiweyani;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.6",
            "verseOrgIds": [
              "JOB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:6"
      },
      "items": [
        {
          "text": "usawerengedwenso pamodzi ndi masiku a chaka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.6",
            "verseOrgIds": [
              "JOB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:6"
      },
      "items": [
        {
          "text": "kapena kukhala pa mwezi wina uliwonse.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.6",
            "verseOrgIds": [
              "JOB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku umenewo usabweretse chilichonse chabwino;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.7",
            "verseOrgIds": [
              "JOB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:7"
      },
      "items": [
        {
          "text": "kusamvekenso nthungululu za chikondwerero.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.7",
            "verseOrgIds": [
              "JOB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odziwa kutemberera masiku alitemberere tsikulo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.8",
            "verseOrgIds": [
              "JOB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:8"
      },
      "items": [
        {
          "text": "iwo amene akonzekera kuwutsa Leviyatani.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.8",
            "verseOrgIds": [
              "JOB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyenyezi zake za mʼbandakucha zikhale mdima;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.9",
            "verseOrgIds": [
              "JOB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:9"
      },
      "items": [
        {
          "text": "tsikulo liyembekezere kucha pachabe",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.9",
            "verseOrgIds": [
              "JOB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:9"
      },
      "items": [
        {
          "text": "ndipo lisaonenso kuwala koyamba kwa mʼbandakucha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.9",
            "verseOrgIds": [
              "JOB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti tsiku limenelo ndiye ndinatuluka mʼmimba ya amayi anga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.10",
            "verseOrgIds": [
              "JOB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:10"
      },
      "items": [
        {
          "text": "ndipo ndi limene linandionetsa zovuta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.10",
            "verseOrgIds": [
              "JOB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bwanji ine sindinawonongeke pamene ndinkabadwa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.11",
            "verseOrgIds": [
              "JOB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:11"
      },
      "items": [
        {
          "text": "ndi kufa pamene ndimatuluka mʼmimba?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.11",
            "verseOrgIds": [
              "JOB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa chiyani panali mawondo wondilandirirapo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.12",
            "verseOrgIds": [
              "JOB.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:12"
      },
      "items": [
        {
          "text": "ndi mawere woti andiyamwitsepo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.12",
            "verseOrgIds": [
              "JOB.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti tsopano bwenzi ndili gone mwamtendere;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.13",
            "verseOrgIds": [
              "JOB.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:13"
      },
      "items": [
        {
          "text": "ndikanakhala nditagona tulo ndili pa mpumulo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.13",
            "verseOrgIds": [
              "JOB.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamodzi ndi mafumu ndi aphungu a dziko lapansi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.14",
            "verseOrgIds": [
              "JOB.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:14"
      },
      "items": [
        {
          "text": "amene anadzimangira nyumba zikuluzikulu zimene tsopano ndi mabwinja,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.14",
            "verseOrgIds": [
              "JOB.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamodzi ndi olamulira amene anali ndi golide,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.15",
            "verseOrgIds": [
              "JOB.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:15"
      },
      "items": [
        {
          "text": "amene anadzaza nyumba zawo ndi siliva.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.15",
            "verseOrgIds": [
              "JOB.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapena, bwanji sindinakwiriridwe pansi monga mwana wobadwa wakufa kale,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.16",
            "verseOrgIds": [
              "JOB.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:16"
      },
      "items": [
        {
          "text": "ngati khanda limene silinaone kuwala kwa dzuwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.16",
            "verseOrgIds": [
              "JOB.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku mandako anthu oyipa sakhalanso pa mavuto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.17",
            "verseOrgIds": [
              "JOB.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:17"
      },
      "items": [
        {
          "text": "ndipo kumeneko anthu otopa ali pa mpumulo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.17",
            "verseOrgIds": [
              "JOB.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "A mʼndende kumeneko akusangalala ndi mtendere;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.18",
            "verseOrgIds": [
              "JOB.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:18"
      },
      "items": [
        {
