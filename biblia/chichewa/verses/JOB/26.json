  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "JOB 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawu a Yobu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yobu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.1",
            "verseOrgIds": [
              "JOB.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wamuthandizadi munthu wopanda mphamvu!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.2",
            "verseOrgIds": [
              "JOB.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:2"
      },
      "items": [
        {
          "text": "Walimbitsadi dzanja la munthu wofowoka!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.2",
            "verseOrgIds": [
              "JOB.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wapereka malangizo kwa munthu amene alibe nzeru!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.3",
            "verseOrgIds": [
              "JOB.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:3"
      },
      "items": [
        {
          "text": "Ndipotu waonetsadi nzeru zochuluka!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.3",
            "verseOrgIds": [
              "JOB.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi wakuthandiza ndani kuti uyankhule mawu awa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.4",
            "verseOrgIds": [
              "JOB.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:4"
      },
      "items": [
        {
          "text": "Ndipo ndi mzimu wa yani umene unayankhula pakamwa pako?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.4",
            "verseOrgIds": [
              "JOB.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mizimu ya anthu akufa ikunjenjemera pansi pa madzi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.5",
            "verseOrgIds": [
              "JOB.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:5"
      },
      "items": [
        {
          "text": "ndi zonse zokhala mʼmadzimo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.5",
            "verseOrgIds": [
              "JOB.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko la anthu akufa ndi lapululu pamaso pa Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.6",
            "verseOrgIds": [
              "JOB.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:6"
      },
      "items": [
        {
          "text": "chiwonongeko ndi chosaphimbidwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.6",
            "verseOrgIds": [
              "JOB.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anayala thambo la kumpoto pa phompho;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.7",
            "verseOrgIds": [
              "JOB.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:7"
      },
      "items": [
        {
          "text": "Iye anakoloweka dziko lapansi mʼmalo mwake pamene panali popanda nʼkanthu komwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.7",
            "verseOrgIds": [
              "JOB.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasunga madzi ambiri mʼmitambo yake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.8",
            "verseOrgIds": [
              "JOB.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:8"
      },
      "items": [
        {
          "text": "koma mitamboyo siphulika chifukwa cha kulemera kwa madziwo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.8",
            "verseOrgIds": [
              "JOB.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amaphimba mwezi wowala,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.9",
            "verseOrgIds": [
              "JOB.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:9"
      },
      "items": [
        {
          "text": "amawuphimba ndi mitambo yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.9",
            "verseOrgIds": [
              "JOB.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anawalembera madzi malire wonga uta,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.10",
            "verseOrgIds": [
              "JOB.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:10"
      },
      "items": [
        {
          "text": "kukhala malire pakati pa kuwunika ndi mdima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.10",
            "verseOrgIds": [
              "JOB.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mizati yochirikiza mitambo yakumwamba imanjenjemera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.11",
            "verseOrgIds": [
              "JOB.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:11"
      },
      "items": [
        {
          "text": "ndi kudabwa pa kudzudzula kwake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.11",
            "verseOrgIds": [
              "JOB.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi mphamvu zake anatontholetsa nyanja;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.12",
            "verseOrgIds": [
              "JOB.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:12"
      },
      "items": [
        {
          "text": "ndi nzeru zake anakantha chirombo cha mʼmadzi chija chotchedwa Rahabe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.12",
            "verseOrgIds": [
              "JOB.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi mpweya wake anayeretsa zamumlengalenga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.13",
            "verseOrgIds": [
              "JOB.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:13"
      },
      "items": [
        {
          "text": "dzanja lake linapha chinjoka chothawa chija.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.13",
            "verseOrgIds": [
              "JOB.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimenezi ndi pangʼono chabe mwa ntchito yake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:14"
      },
      "items": [
        {
          "text": "tingomva pangʼono za Iye ngati kunongʼona!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:14"
      },
      "items": [
        {
          "text": "Kodi ndani angathe kudziwa kukula kwa mphamvu zake?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "JOB.27",
    "number": "27",
