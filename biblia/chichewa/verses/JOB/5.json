              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti adzakupulumutsa ku masautso nthawi ndi nthawi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.19",
            "verseOrgIds": [
