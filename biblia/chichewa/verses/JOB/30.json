          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inu Mulungu, ine ndikulirira kwa Inu, koma simukundiyankha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.20",
            "verseOrgIds": [
              "JOB.30.20"
            ]
          }
        }
      ]
