      "attrs": {
        "style": "q2",
        "vid": "JOB 30:21"
      },
      "items": [
        {
          "text": "mumandizunza ndi dzanja lanu lamphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.21",
            "verseOrgIds": [
              "JOB.30.21"
            ]
          }
