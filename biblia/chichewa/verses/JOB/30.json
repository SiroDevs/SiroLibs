      "attrs": {
        "style": "q2",
        "vid": "JOB 30:24"
      },
      "items": [
        {
          "text": "amene akupempha thandizo mʼmasautso ake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.24",
            "verseOrgIds": [
              "JOB.30.24"
            ]
