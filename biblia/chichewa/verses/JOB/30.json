          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wandiponya mʼmatope,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.19",
            "verseOrgIds": [
              "JOB.30.19"
            ]
          }
