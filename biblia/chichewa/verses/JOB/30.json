          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ine sindinalire nawo iwo amene anali pamavuto?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.25",
            "verseOrgIds": [
              "JOB.30.25"
            ]
          }
        }
