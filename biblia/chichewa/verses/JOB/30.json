      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:20"
      },
      "items": [
        {
          "text": "ndikayimirira, Inu simundiyangʼana nʼkomwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.20",
            "verseOrgIds": [
              "JOB.30.20"
            ]
          }
        }
      ]
    },
