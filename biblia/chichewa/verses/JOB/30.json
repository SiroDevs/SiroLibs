      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:18"
      },
      "items": [
        {
          "text": "Iye wandigwira ngati chovala chondithina pa khosi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.18",
            "verseOrgIds": [
              "JOB.30.18"
            ]
          }
        }
      ]
