      "attrs": {
        "style": "q2",
        "vid": "JOB 30:26"
      },
      "items": [
        {
          "text": "pamene ndinkafunafuna kuwala, mdima ndiye unandigwera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.26",
            "verseOrgIds": [
              "JOB.30.26"
            ]
