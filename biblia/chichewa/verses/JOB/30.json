      "attrs": {
        "style": "q2",
        "vid": "JOB 30:19"
      },
      "items": [
        {
          "text": "ndipo ndasanduka ngati fumbi ndi phulusa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.19",
            "verseOrgIds": [
              "JOB.30.19"
            ]
          }
        }
      ]
