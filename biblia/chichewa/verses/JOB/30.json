          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inuyo mumandichitira zankhanza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.21",
            "verseOrgIds": [
              "JOB.30.21"
            ]
          }
        }
