      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:25"
      },
      "items": [
        {
          "text": "Kodi mtima wanga sunamvere chisoni anthu osauka?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.25",
            "verseOrgIds": [
              "JOB.30.25"
            ]
          }
        }
