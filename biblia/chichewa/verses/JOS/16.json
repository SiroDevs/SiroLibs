  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "JOS 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Madera amene Efereimu ndi Manase Analandira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko limene linapatsidwa kwa fuko la Yosefe linayambira ku mtsinje wa Yorodani ku Yeriko, kummawa kwa akasupe a Yeriko, ndiponso kuyambira mtsinje wa Yorodaniwo nʼkumakwera, kudutsa mʼchipululu mpaka ku mapiri a ku Beteli.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchokera ku Beteli malire ake anakafika ku Luzi, kudutsa dziko la Ataroti kumene kumakhala Aariki.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malirewo anatsikira cha kumadzulo kwa dziko la Yafuleti mpaka ku chigawo cha kumunsi kwa Beti-Horoni. Kuchokera kumeneko anapitirira mpaka ku Gezeri nʼkuthera ku Nyanja.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Manase ndi Efereimu, ana a Yosefe analandira cholowa chawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.4",
            "verseOrgIds": [
              "JOS.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko la mabanja a fuko la Efereimu ndi ili:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.5",
            "verseOrgIds": [
              "JOS.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 16:5"
      },
      "items": [
        {
          "text": "Malire a dzikolo anachokera kummawa kwa Ataroti Adari mpaka ku mtunda kwa Beti-Horoni.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malirewo anapitirira mpaka ku nyanja. Mikimetati anali kumpoto kwake. Kuchokera kumeneko anakhotera cha kummawa kuloza ku Taanati Silo ndi kudutsa kumeneko cha kummawa mpaka ku Yanowa.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo kuchokera ku Yanowa anatsikira ku Ataroti ndi Naara, nakafika ku Yeriko ndi kukathera ku mtsinje wa Yorodani.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchokera ku Tapuwa anapita kumadzulo mpaka ku mtsinje wa Kana ndi kukathera ku nyanja. Dziko ili linali cholowa cha mabanja afuko la Efereimu,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuphatikizapo mizinda yonse ndi midzi yake yopatsidwa kwa Efereimu, koma yokhala mʼkati mwa dziko la Manase.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo sanapirikitse Akanaani amene amakhala ku Gezeri ndipo mpaka lero Akanaani akukhala pakati pa Aefereimu koma amagwira ntchito ngati akapolo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.10",
            "verseOrgIds": [
              "JOS.16.10"
            ]
          }
        }
      ]
    }
  ],
