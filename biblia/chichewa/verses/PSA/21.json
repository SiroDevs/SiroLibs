  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "PSA 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, mfumu ikusangalala mu mphamvu yanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.1",
            "verseOrgIds": [
              "PSA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:1"
      },
      "items": [
        {
          "text": "chimwemwe chake nʼchachikuludi pa kupambana kumene mumapereka!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.1",
            "verseOrgIds": [
              "PSA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mwayipatsa zokhumba za mtima wake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.2",
            "verseOrgIds": [
              "PSA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:2"
      },
      "items": [
        {
          "text": "ndipo simunayimane zopempha za pa milomo yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.2",
            "verseOrgIds": [
              "PSA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 21:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.21.2",
                "verseOrgIds": [
                  "PSA.21.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu munayilandira ndi madalitso ochuluka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.3",
            "verseOrgIds": [
              "PSA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:3"
      },
      "items": [
        {
          "text": "ndipo munayiveka chipewa chaufumu chagolide weniweni pa mutu wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.3",
            "verseOrgIds": [
              "PSA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anakupemphani moyo, ndipo munamupatsa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.4",
            "verseOrgIds": [
              "PSA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:4"
      },
      "items": [
        {
          "text": "masiku ochuluka kwamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.4",
            "verseOrgIds": [
              "PSA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudzera mʼzigonjetso zimene munapereka, ulemerero wake ndi waukulu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.5",
            "verseOrgIds": [
              "PSA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:5"
      },
      "items": [
        {
          "text": "Inu mwapereka pa iyo ulemerero ndi ufumu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.5",
            "verseOrgIds": [
              "PSA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zoonadi Inu mwayipatsa madalitso amuyaya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.6",
            "verseOrgIds": [
              "PSA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:6"
      },
      "items": [
        {
          "text": "Inu mwayipatsa chisangalalo ndi chimwemwe chimene chili pamaso panu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.6",
            "verseOrgIds": [
              "PSA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti mfumu imadalira Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.7",
            "verseOrgIds": [
              "PSA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:7"
      },
      "items": [
        {
          "text": "kudzera mʼchikondi chake chosatha cha Wammwambamwamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.7",
            "verseOrgIds": [
              "PSA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:7"
      },
      "items": [
        {
          "text": "iyo sidzagwedezeka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.7",
            "verseOrgIds": [
              "PSA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzanja lanu lidzayimitsa adani anu onse;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.8",
            "verseOrgIds": [
              "PSA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:8"
      },
      "items": [
        {
          "text": "dzanja lanu lamanja lidzagwira adani anu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.8",
            "verseOrgIds": [
              "PSA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi ya kuonekera kwanu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:9"
      },
      "items": [
        {
          "text": "mudzawasandutsa ngʼanjo yamoto yotentha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 21:9"
      },
      "items": [
        {
          "text": "Mu ukali wake Yehova adzawameza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:9"
      },
      "items": [
        {
          "text": "ndipo moto wake udzawatha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mudzawononga ana awo pa dziko lapansi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.10",
            "verseOrgIds": [
              "PSA.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:10"
      },
      "items": [
        {
          "text": "zidzukulu zawo pakati pa anthu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.10",
            "verseOrgIds": [
              "PSA.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale iwo akukonzereni chiwembu mwa kuchenjera kwawo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.11",
            "verseOrgIds": [
              "PSA.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:11"
      },
      "items": [
        {
          "text": "sadzapambana;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.11",
            "verseOrgIds": [
              "PSA.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakuti mudzawapirikitsa ndipo adzaonetsa misana yawo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.12",
            "verseOrgIds": [
              "PSA.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:12"
      },
      "items": [
        {
          "text": "pamene mudzawaloza ndi mivi yanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.12",
            "verseOrgIds": [
              "PSA.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwezeke Inu Yehova mʼmphamvu yanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.13",
            "verseOrgIds": [
              "PSA.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:13"
      },
      "items": [
        {
          "text": "ife tidzayimba nyimbo ndi kutamanda mphamvu yanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.13",
            "verseOrgIds": [
              "PSA.21.14"
            ]
          }
        }
      ]
    }
  ],
