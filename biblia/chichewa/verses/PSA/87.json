    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 87",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salimo la Ana a Kora.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 87:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye wakhazikitsa maziko ake pa phiri loyera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.1",
            "verseOrgIds": [
              "PSA.87.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 87:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova amakonda zipata za Ziyoni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.2",
            "verseOrgIds": [
              "PSA.87.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:2"
      },
      "items": [
        {
          "text": "kupambana malo onse okhalamo a Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.2",
            "verseOrgIds": [
              "PSA.87.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 87:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Za ulemerero wako zimakambidwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.3",
            "verseOrgIds": [
              "PSA.87.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:3"
      },
      "items": [
        {
          "text": "Iwe mzinda wa Mulungu:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.3",
            "verseOrgIds": [
              "PSA.87.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 87:3"
      },
      "items": [
        {
          "text": "Sela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 87:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndidzanena za Rahabe ndi Babuloni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:4"
      },
      "items": [
        {
          "text": "pakati pa iwo amene amandidziwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 87:4"
      },
      "items": [
        {
          "text": "Dzikonso la Filisitiya, Turo pamodzi ndi Kusi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:4"
      },
      "items": [
        {
          "text": "ndipo ndidzati, 'Uyu anabadwira mʼZiyoni.' \"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 87:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithudi, za Ziyoni adzanena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:5"
      },
      "items": [
        {
          "text": "\"Uyu ndi uyo anabadwira mwa iye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:5"
      },
      "items": [
        {
          "text": "ndipo Wammwambamwamba adzakhazikitsa iyeyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 87:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova adzalemba mʼbuku la kawundula wa anthu a mitundu ina:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.6",
            "verseOrgIds": [
              "PSA.87.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:6"
      },
      "items": [
        {
          "text": "\"Uyu anabadwira mʼZiyoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.6",
            "verseOrgIds": [
              "PSA.87.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 87:6"
      },
      "items": [
        {
          "text": "Sela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 87:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyimba ndi ovina omwe adzati,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.7",
            "verseOrgIds": [
              "PSA.87.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:7"
      },
      "items": [
        {
          "text": "\"Akasupe anga onse ali mwa iwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.7",
            "verseOrgIds": [
              "PSA.87.7"
            ]
          }
        }
      ]
    }
  ],
