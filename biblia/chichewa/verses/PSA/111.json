    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 111",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 111:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamandani Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 111:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 111:1"
      },
      "items": [
        {
          "text": "Ndidzathokoza Yehova ndi mtima wanga wonse",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:1"
      },
      "items": [
        {
          "text": "mʼbwalo la anthu olungama mtima ndi pa msonkhano.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 111:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito za Yehova nʼzazikulu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.2",
            "verseOrgIds": [
              "PSA.111.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:2"
      },
      "items": [
        {
          "text": "onse amene amakondwera nazo amazilingalira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.2",
            "verseOrgIds": [
              "PSA.111.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 111:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zochita zake ndi za ulemerero ndi zaufumu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.3",
            "verseOrgIds": [
              "PSA.111.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:3"
      },
      "items": [
        {
          "text": "ndipo chilungamo chake ndi chosatha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.3",
            "verseOrgIds": [
              "PSA.111.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 111:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye wachititsa kuti zodabwitsa zake zikumbukirike;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.4",
            "verseOrgIds": [
              "PSA.111.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:4"
      },
      "items": [
        {
          "text": "Yehova ndi wokoma mtima ndi wachifundo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.4",
            "verseOrgIds": [
              "PSA.111.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 111:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amapereka chakudya kwa amene amamuopa Iye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.5",
            "verseOrgIds": [
              "PSA.111.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:5"
      },
      "items": [
        {
          "text": "amakumbukira pangano lake kwamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.5",
            "verseOrgIds": [
              "PSA.111.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 111:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waonetsa anthu ake mphamvu ya ntchito zake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.6",
            "verseOrgIds": [
              "PSA.111.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:6"
      },
      "items": [
        {
          "text": "kuwapatsa mayiko a anthu a mitundu ina.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.6",
            "verseOrgIds": [
              "PSA.111.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 111:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito za manja ake ndi zokhulupirika ndi zolungama;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.7",
            "verseOrgIds": [
              "PSA.111.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:7"
      },
      "items": [
        {
          "text": "malangizo ake onse ndi odalirika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.7",
            "verseOrgIds": [
              "PSA.111.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 111:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malamulo ndi okhazikika ku nthawi za nthawi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.8",
            "verseOrgIds": [
              "PSA.111.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:8"
      },
      "items": [
        {
          "text": "ochitidwa mokhulupirika ndi molungama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.8",
            "verseOrgIds": [
              "PSA.111.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 111:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyeyo amawombola anthu ake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:9"
      },
      "items": [
        {
          "text": "anakhazikitsa pangano lake kwamuyaya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:9"
      },
      "items": [
        {
          "text": "dzina lake ndi loyera ndi loopsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 111:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuopa Yehova ndicho chiyambi cha nzeru;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.10",
            "verseOrgIds": [
              "PSA.111.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:10"
      },
      "items": [
        {
          "text": "onse amene amatsatira malangizo ake amamvetsa bwino zinthu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.10",
            "verseOrgIds": [
              "PSA.111.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:10"
      },
      "items": [
        {
          "text": "Iye ndi wotamandika mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.10",
            "verseOrgIds": [
              "PSA.111.10"
            ]
          }
        }
      ]
    }
  ],
