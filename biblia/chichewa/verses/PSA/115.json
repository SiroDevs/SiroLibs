    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 115",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 115:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa ife ayi Yehova, kwa ife ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:1"
      },
      "items": [
        {
          "text": "koma ulemerero ukhale pa dzina lanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:1"
      },
      "items": [
        {
          "text": "chifukwa cha chikondi chanu chosasinthika ndiponso chifukwa cha kukhulupirika kwanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 115:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa chiyani anthu a mitundu ina akunena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.2",
            "verseOrgIds": [
              "PSA.115.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:2"
      },
      "items": [
        {
          "text": "\"Mulungu wawo ali kuti?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.2",
            "verseOrgIds": [
              "PSA.115.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 115:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu wathu ali kumwamba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.3",
            "verseOrgIds": [
              "PSA.115.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:3"
      },
      "items": [
        {
          "text": "Iye amachita chilichonse chimene chimamukondweretsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.3",
            "verseOrgIds": [
              "PSA.115.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 115:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mafano awo ndi siliva ndi golide,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.4",
            "verseOrgIds": [
              "PSA.115.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:4"
      },
      "items": [
        {
          "text": "opangidwa ndi manja a anthu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.4",
            "verseOrgIds": [
              "PSA.115.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 115:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakamwa ali napo koma sayankhula,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.5",
            "verseOrgIds": [
              "PSA.115.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:5"
      },
      "items": [
        {
          "text": "maso ali nawo koma sapenya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.5",
            "verseOrgIds": [
              "PSA.115.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 115:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "makutu ali nawo koma samva,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.6",
            "verseOrgIds": [
              "PSA.115.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:6"
      },
      "items": [
        {
          "text": "mphuno ali nazo koma sanunkhiza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.6",
            "verseOrgIds": [
              "PSA.115.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 115:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "manja ali nawo koma akakhudza samva kanthu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.7",
            "verseOrgIds": [
              "PSA.115.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:7"
      },
      "items": [
        {
          "text": "mapazi ali nawo koma sayenda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.7",
            "verseOrgIds": [
              "PSA.115.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:7"
      },
      "items": [
        {
          "text": "kapena pakhosi pawo kutulutsa mawu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.7",
            "verseOrgIds": [
              "PSA.115.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 115:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu amene amapanga mafanowo adzafanana nawo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.8",
            "verseOrgIds": [
              "PSA.115.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:8"
      },
      "items": [
        {
          "text": "chimodzimodzinso onse amene amadalira mafanowo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.8",
            "verseOrgIds": [
              "PSA.115.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 115:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Aisraeli, dalirani Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.9",
            "verseOrgIds": [
              "PSA.115.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:9"
      },
      "items": [
        {
          "text": "Iye ndiye thandizo lanu ndi chishango chanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.9",
            "verseOrgIds": [
              "PSA.115.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 115:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe nyumba ya Aaroni, dalira Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.10",
            "verseOrgIds": [
              "PSA.115.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:10"
      },
      "items": [
        {
          "text": "Iye ndiye thandizo lako ndi chishango chako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.10",
            "verseOrgIds": [
              "PSA.115.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 115:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu amene mumaopa Iye, dalirani Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.11",
            "verseOrgIds": [
              "PSA.115.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:11"
      },
      "items": [
        {
          "text": "Iye ndiye thandizo lanu ndi chishango chanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.11",
            "verseOrgIds": [
              "PSA.115.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 115:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova watikumbukira ndipo adzatidalitsa:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.12",
            "verseOrgIds": [
              "PSA.115.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:12"
      },
      "items": [
        {
          "text": "adzadalitsa nyumba ya Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.12",
            "verseOrgIds": [
              "PSA.115.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:12"
      },
      "items": [
        {
          "text": "adzadalitsa nyumba ya Aaroni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.12",
            "verseOrgIds": [
              "PSA.115.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 115:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "adzadalitsa iwo amene amaopa Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.13",
            "verseOrgIds": [
              "PSA.115.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:13"
      },
      "items": [
        {
          "text": "aangʼono ndi aakulu omwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.13",
            "verseOrgIds": [
              "PSA.115.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 115:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akuwonjezereni madalitso;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.14",
            "verseOrgIds": [
              "PSA.115.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:14"
      },
      "items": [
        {
          "text": "inuyo pamodzi ndi ana anu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.14",
            "verseOrgIds": [
              "PSA.115.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 115:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudalitsidwe ndi Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.15",
            "verseOrgIds": [
              "PSA.115.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:15"
      },
      "items": [
        {
          "text": "Wolenga kumwamba ndi dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.15",
            "verseOrgIds": [
              "PSA.115.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 115:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumwamba ndi kwa Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.16",
            "verseOrgIds": [
              "PSA.115.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:16"
      },
      "items": [
        {
          "text": "koma dziko lapansi Iye walipereka kwa anthu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.16",
            "verseOrgIds": [
              "PSA.115.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 115:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si anthu akufa amene amatamanda Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.17",
            "verseOrgIds": [
              "PSA.115.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:17"
      },
      "items": [
        {
          "text": "amene amatsikira kuli chete;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.17",
            "verseOrgIds": [
              "PSA.115.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
