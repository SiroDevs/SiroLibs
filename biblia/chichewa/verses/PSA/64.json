  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "64",
        "style": "c",
        "sid": "PSA 64"
      },
      "items": [
        {
          "text": "64",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 64",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 64:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimvereni Mulungu pomwe ndikunena madandawulo anga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.1",
            "verseOrgIds": [
              "PSA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:1"
      },
      "items": [
        {
          "text": "tetezani moyo wanga ku chiopsezo cha mdani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.1",
            "verseOrgIds": [
              "PSA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 64:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibiseni ku chiwembu cha anthu oyipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.2",
            "verseOrgIds": [
              "PSA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:2"
      },
      "items": [
        {
          "text": "ku gulu laphokoso la anthu ochita zoyipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.2",
            "verseOrgIds": [
              "PSA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 64:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amanola malilime awo ngati malupanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.3",
            "verseOrgIds": [
              "PSA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:3"
      },
      "items": [
        {
          "text": "amaponya mawu awo olasa ngati mivi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.3",
            "verseOrgIds": [
              "PSA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 64:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amaponya mivi yawo ali pa malo wobisala kwa munthu wosalakwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.4",
            "verseOrgIds": [
              "PSA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:4"
      },
      "items": [
        {
          "text": "amamulasa modzidzimutsa ndi mopanda mantha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.4",
            "verseOrgIds": [
              "PSA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 64:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amalimbikitsana wina ndi mnzake pa chikonzero chawo choyipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:5"
      },
      "items": [
        {
          "text": "amayankhula zobisa misampha yawo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:5"
      },
      "items": [
        {
          "text": "ndipo amati, \"Adzayiona ndani?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 64:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amakonzekera zosalungama ndipo amati,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:6"
      },
      "items": [
        {
          "text": "\"Takonza ndondomeko yabwino kwambiri!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:6"
      },
      "items": [
        {
          "text": "Ndithu maganizo ndi mtima wa munthu ndi zachinyengo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 64:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Mulungu adzawalasa ndi mivi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.7",
            "verseOrgIds": [
              "PSA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:7"
      },
      "items": [
        {
          "text": "mwadzidzidzi adzakanthidwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.7",
            "verseOrgIds": [
              "PSA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 64:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzatembenuza milomo yawoyo kuwatsutsa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.8",
            "verseOrgIds": [
              "PSA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:8"
      },
      "items": [
        {
          "text": "ndi kuwasandutsa bwinja;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.8",
            "verseOrgIds": [
              "PSA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:8"
      },
      "items": [
        {
          "text": "onse amene adzawaona adzagwedeza mitu yawo mowanyoza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.8",
            "verseOrgIds": [
              "PSA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 64:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu onse adzachita mantha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:9"
      },
      "items": [
        {
          "text": "adzalengeza ntchito za Mulungu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:9"
      },
      "items": [
        {
          "text": "ndi kulingalira mozama zomwe Iye wazichita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 64:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lolani wolungama akondwere mwa Yehova",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:10"
      },
      "items": [
        {
          "text": "ndi kubisala mwa Iye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:10"
      },
      "items": [
        {
          "text": "owongoka mtima onse atamande Iye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    }
  ],
