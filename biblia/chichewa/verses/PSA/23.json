      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:2"
      },
      "items": [
        {
          "text": "amanditsogolera ku madzi akumwa abwino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.2",
            "verseOrgIds": [
              "PSA.23.2"
            ]
          }
        }
      ]
    },
