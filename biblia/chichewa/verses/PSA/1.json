        {
          "text": "Salimo 1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wodala munthu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:1"
      },
      "items": [
        {
          "text": "amene satsatira uphungu wa anthu ochimwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 1:1"
      },
      "items": [
        {
          "text": "kapena kuyima mʼnjira ya anthu oyipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:1"
      },
      "items": [
        {
          "text": "kapena kukhala mʼmagulu a anthu onyoza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma chikondwerero chake chili mʼmalamulo a Yehova",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.2",
            "verseOrgIds": [
              "PSA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:2"
      },
      "items": [
        {
          "text": "ndipo mʼmalamulo akewo amalingaliramo usana ndi usiku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.2",
            "verseOrgIds": [
              "PSA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ali ngati mtengo wodzalidwa mʼmbali mwa mitsinje ya madzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:3"
      },
      "items": [
        {
          "text": "umene umabereka zipatso zake pa nyengo yake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 1:3"
      },
      "items": [
        {
          "text": "ndipo masamba ake safota.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:3"
      },
      "items": [
        {
          "text": "Chilichonse chimene amachita amapindula nacho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sizitero ndi anthu oyipa!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.4",
            "verseOrgIds": [
              "PSA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:4"
      },
      "items": [
        {
          "text": "Iwo ali ngati mungu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.4",
            "verseOrgIds": [
              "PSA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:4"
      },
      "items": [
        {
          "text": "umene umawuluzidwa ndi mphepo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.4",
            "verseOrgIds": [
              "PSA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero anthu oyipa sadzatha kuyima pa chiweruzo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.5",
            "verseOrgIds": [
              "PSA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:5"
      },
      "items": [
        {
          "text": "kapena anthu ochimwa mu msonkhano wa anthu olungama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.5",
            "verseOrgIds": [
              "PSA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Yehova amayangʼanira mayendedwe a anthu olungama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.6",
            "verseOrgIds": [
              "PSA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:6"
      },
      "items": [
        {
          "text": "koma mayendedwe a anthu oyipa adzawonongeka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.6",
            "verseOrgIds": [
              "PSA.1.6"
            ]
          }
        }
      ]
    }
  ],
