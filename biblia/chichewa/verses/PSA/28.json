    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa Inu ine ndiyitana, Yehova ndinu Thanthwe langa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.1",
            "verseOrgIds": [
              "PSA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:1"
      },
      "items": [
        {
          "text": "musakhale osamva kwa ine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.1",
            "verseOrgIds": [
              "PSA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 28:1"
      },
      "items": [
        {
          "text": "Pakuti mukapitirira kukhala chete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.1",
            "verseOrgIds": [
              "PSA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:1"
      },
      "items": [
        {
          "text": "ndidzakhala ngati iwo amene atsikira ku dzenje.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.1",
            "verseOrgIds": [
              "PSA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imvani kupempha chifundo kwanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.2",
            "verseOrgIds": [
              "PSA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:2"
      },
      "items": [
        {
          "text": "pomwe ndikuyitana kwa Inu kuti mundithandize,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.2",
            "verseOrgIds": [
              "PSA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 28:2"
      },
      "items": [
        {
          "text": "pomwe ndikukweza manja anga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.2",
            "verseOrgIds": [
              "PSA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:2"
      },
      "items": [
        {
          "text": "kuloza ku malo anu oyeretsetsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.2",
            "verseOrgIds": [
              "PSA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musandikokere kutali pamodzi ndi anthu oyipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.3",
            "verseOrgIds": [
              "PSA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:3"
      },
      "items": [
        {
          "text": "pamodzi ndi iwo amene amachita zoyipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.3",
            "verseOrgIds": [
              "PSA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 28:3"
      },
      "items": [
        {
          "text": "amene amayankhula mwachikondi ndi anzawo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.3",
            "verseOrgIds": [
              "PSA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:3"
      },
      "items": [
        {
          "text": "koma akusunga chiwembu mʼmitima mwawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.3",
            "verseOrgIds": [
              "PSA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muwabwezere chifukwa cha zochita zawo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.4",
            "verseOrgIds": [
              "PSA.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:4"
      },
      "items": [
        {
          "text": "ndi ntchito zawo zoyipa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.4",
            "verseOrgIds": [
              "PSA.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 28:4"
      },
      "items": [
        {
          "text": "abwezereni chifuwa cha zimene manja awo achita",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.4",
            "verseOrgIds": [
              "PSA.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:4"
      },
      "items": [
        {
          "text": "ndipo mubweretse pa iwo zimene zowayenera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.4",
            "verseOrgIds": [
              "PSA.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza iwowo sakhudzidwa ndi ntchito za Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.5",
            "verseOrgIds": [
              "PSA.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:5"
      },
      "items": [
        {
          "text": "ndi zimene manja ake anazichita,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.5",
            "verseOrgIds": [
              "PSA.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 28:5"
      },
      "items": [
        {
          "text": "Iye adzawakhadzula",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.5",
            "verseOrgIds": [
              "PSA.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:5"
      },
      "items": [
        {
          "text": "ndipo sadzawathandizanso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.5",
            "verseOrgIds": [
              "PSA.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matamando apite kwa Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.6",
            "verseOrgIds": [
              "PSA.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:6"
      },
      "items": [
        {
          "text": "popeza Iye wamva kupempha chifundo kwanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.6",
            "verseOrgIds": [
              "PSA.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ndiye mphamvu yanga ndi chishango changa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:7"
      },
      "items": [
        {
          "text": "mtima wanga umadalira Iye, ndipo Ine ndathandizidwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 28:7"
      },
      "items": [
        {
          "text": "Mtima wanga umalumphalumpha chifukwa cha chimwemwe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:7"
      },
      "items": [
        {
          "text": "ndipo ndidzayamika Iye mʼnyimbo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ndi mphamvu ya anthu ake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.8",
            "verseOrgIds": [
              "PSA.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:8"
      },
      "items": [
        {
          "text": "linga la chipulumutso kwa wodzozedwa wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.8",
            "verseOrgIds": [
              "PSA.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pulumutsani anthu anu ndipo mudalitse cholowa chanu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.9",
            "verseOrgIds": [
              "PSA.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:9"
      },
      "items": [
        {
          "text": "mukhale mʼbusa wawo ndipo muwakweze kwamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.9",
            "verseOrgIds": [
              "PSA.28.9"
            ]
          }
        }
      ]
    }
  ],
