  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "52",
        "style": "c",
        "sid": "PSA 52"
      },
      "items": [
        {
          "text": "52",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 52",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe, ndakatulo ya Davide; pamene Doegi Mwedomu anapita kwa Sauli ndi kunena kuti \"Davide wapita ku nyumba ya Ahimeleki.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 52:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chiyani ukudzitamandira ndi zoyipa, iwe munthu wamphamvu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.1",
            "verseOrgIds": [
              "PSA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:1"
      },
      "items": [
        {
          "text": "Nʼchifukwa chiyani ukudzitamandira tsiku lonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.1",
            "verseOrgIds": [
              "PSA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:1"
      },
      "items": [
        {
          "text": "iwe munthu wochititsa manyazi pamaso pa Mulungu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.1",
            "verseOrgIds": [
              "PSA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lonse umakhalira kuganizira za kuwononga ena;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.2",
            "verseOrgIds": [
              "PSA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:2"
      },
      "items": [
        {
          "text": "lilime lako lili ngati lumo lakuthwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.2",
            "verseOrgIds": [
              "PSA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:2"
      },
      "items": [
        {
          "text": "ntchito yako nʼkunyenga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.2",
            "verseOrgIds": [
              "PSA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe umakonda choyipa mʼmalo mwa kuyankhula choonadi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.3",
            "verseOrgIds": [
              "PSA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:3"
      },
      "items": [
        {
          "text": "Umakonda kunama kupambana kuyankhula zoona.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.3",
            "verseOrgIds": [
              "PSA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 52:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.52.3",
                "verseOrgIds": [
                  "PSA.52.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umakonda mawu onse opweteka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.4",
            "verseOrgIds": [
              "PSA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:4"
      },
      "items": [
        {
          "text": "iwe lilime lachinyengo!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.4",
            "verseOrgIds": [
              "PSA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zoonadi Mulungu adzakutsitsa kupita ku chiwonongeko chamuyaya:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.5",
            "verseOrgIds": [
              "PSA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:5"
      },
      "items": [
        {
          "text": "iye adzakukwatula ndi kukuchotsa mʼtenti yako;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.5",
            "verseOrgIds": [
              "PSA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:5"
      },
      "items": [
        {
          "text": "iye adzakuzula kuchoka mʼdziko la amoyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.5",
            "verseOrgIds": [
              "PSA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olungama adzaona zimenezi ndi kuchita mantha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.6",
            "verseOrgIds": [
              "PSA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:6"
      },
      "items": [
        {
          "text": "adzamuseka nʼkumanena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.6",
            "verseOrgIds": [
              "PSA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 52:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pano tsopano pali munthu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:7"
      },
      "items": [
        {
          "text": "amene sanayese Mulungu linga lake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 52:7"
      },
      "items": [
        {
          "text": "koma anakhulupirira chuma chake chambiri",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:7"
      },
      "items": [
        {
          "text": "nalimbika kuchita zoyipa!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ine ndili ngati mtengo wa olivi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:8"
      },
      "items": [
        {
          "text": "wobiriwira bwino mʼnyumba ya Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 52:8"
      },
      "items": [
        {
          "text": "ndimadalira chikondi chosatha cha Mulungu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:8"
      },
      "items": [
        {
          "text": "kwa nthawi za nthawi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzakutamandani kwamuyaya chifukwa cha zimene mwachita;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:9"
      },
      "items": [
        {
          "text": "chifukwa cha zimene mwachita; mʼdzina lanu ndidzayembekezera",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:9"
      },
      "items": [
        {
          "text": "pakuti dzina lanulo ndi labwino. Ndidzakutamandani pamaso pa oyera mtima anu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.11"
            ]
          }
        }
      ]
    }
  ],
