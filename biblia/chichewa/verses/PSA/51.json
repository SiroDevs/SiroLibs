  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "51",
        "style": "c",
        "sid": "PSA 51"
      },
      "items": [
        {
          "text": "51",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 51",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Salimo la Davide. Pamene Mneneri Natani anabwera kwa iye atachita chigololo ndi Batiseba.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 51:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundichitire chifundo, Inu Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:1"
      },
      "items": [
        {
          "text": "molingana ndi chikondi chanu chosasinthika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 51:1"
      },
      "items": [
        {
          "text": "molingana ndi chifundo chanu chachikulu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:1"
      },
      "items": [
        {
          "text": "mufafanize mphulupulu zanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 51:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munditsuke zolakwa zanga zonse",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.2",
            "verseOrgIds": [
              "PSA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:2"
      },
      "items": [
        {
          "text": "ndipo mundiyeretse kuchotsa tchimo langa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.2",
            "verseOrgIds": [
              "PSA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 51:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ndikudziwa mphulupulu zanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.3",
            "verseOrgIds": [
              "PSA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:3"
      },
      "items": [
        {
          "text": "ndipo tchimo langa lili pamaso panga nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.3",
            "verseOrgIds": [
              "PSA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 51:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motsutsana ndi Inu, Inu nokha, ndachimwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:4"
      },
      "items": [
        {
          "text": "ndipo ndachita zoyipa pamaso panu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 51:4"
      },
      "items": [
        {
          "text": "Kotero kuti inu mwapezeka kuti ndinu wolungama",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:4"
      },
      "items": [
        {
          "text": "pamene muyankhula ndi pamene muweruza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 51:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zoonadi ine ndinali wochimwa pomwe ndimabadwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.5",
            "verseOrgIds": [
              "PSA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:5"
      },
      "items": [
        {
          "text": "wochimwa kuyambira pa nthawi imene amayi anga anakhala woyembekezera ine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.5",
            "verseOrgIds": [
              "PSA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 51:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zoonadi inu mumafuna choonadi mu ziwalo zamʼkati mwanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.6",
            "verseOrgIds": [
              "PSA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:6"
      },
      "items": [
        {
          "text": "mumandiphunzitsa nzeru mʼkati mwanga mwenimweni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.6",
            "verseOrgIds": [
              "PSA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 51:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundiyeretse ndi hisope ndipo ndidzayera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.7",
            "verseOrgIds": [
              "PSA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:7"
      },
      "items": [
        {
          "text": "munditsuke ndipo ndidzayera kuposa matalala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.7",
            "verseOrgIds": [
              "PSA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 51:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundilole ndimve chimwemwe ndi chisangalalo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.8",
            "verseOrgIds": [
              "PSA.51.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:8"
      },
      "items": [
        {
          "text": "mulole kuti mafupa amene mwawamphwanya akondwere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.8",
            "verseOrgIds": [
              "PSA.51.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 51:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mufulatire machimo anga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.9",
            "verseOrgIds": [
              "PSA.51.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:9"
      },
      "items": [
        {
          "text": "ndi kufafaniza zolakwa zanga zonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.9",
            "verseOrgIds": [
              "PSA.51.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 51:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulenge mʼkati mwanga mtima woyera Inu Mulungu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.10",
            "verseOrgIds": [
              "PSA.51.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:10"
      },
      "items": [
        {
          "text": "ndi kukonzanso mzimu wokhazikika mwa ine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.10",
            "verseOrgIds": [
              "PSA.51.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 51:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musandichotse pamaso panu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.11",
            "verseOrgIds": [
              "PSA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:11"
      },
      "items": [
        {
          "text": "kapena kuchotsa Mzimu wanu Woyera mwa ine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.11",
            "verseOrgIds": [
              "PSA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 51:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwezeretsani mwa ine chimwemwe cha chipulumutso chanu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.12",
            "verseOrgIds": [
              "PSA.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:12"
      },
      "items": [
        {
          "text": "ndipo mundipatse mzimu wofuna kumvera kuti undilimbitse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.12",
            "verseOrgIds": [
              "PSA.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 51:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo ndidzaphunzitsa anthu amphulupulu njira zanu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.13",
            "verseOrgIds": [
              "PSA.51.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:13"
      },
      "items": [
        {
          "text": "kuti ochimwa adzabwerere kwa inu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.13",
            "verseOrgIds": [
              "PSA.51.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 51:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundipulumutse ku tchimo lokhetsa magazi, Inu Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:14"
      },
      "items": [
        {
          "text": "Mulungu wa chipulumutso changa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:14"
      },
      "items": [
        {
          "text": "ndipo lilime langa lidzayimba zachilungamo chanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 51:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Ambuye tsekulani milomo yanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.15",
            "verseOrgIds": [
              "PSA.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:15"
      },
      "items": [
        {
          "text": "ndipo pakamwa panga padzalengeza matamando anu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.15",
            "verseOrgIds": [
              "PSA.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 51:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu simusangalatsidwa ndi nsembe wamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.16",
            "verseOrgIds": [
              "PSA.51.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:16"
      },
      "items": [
        {
          "text": "Ndikanapereka nsembe yopsereza, Inu simukondwera nayo.",
          "type": "text",
          "attrs": {
