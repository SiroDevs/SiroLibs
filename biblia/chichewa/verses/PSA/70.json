  "verseCount": 5,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "70",
        "style": "c",
        "sid": "PSA 70"
      },
      "items": [
        {
          "text": "70",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 70",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Salimo la Davide. Pempho.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 70:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fulumirani Mulungu kundipulumutsa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.1",
            "verseOrgIds": [
              "PSA.70.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:1"
      },
      "items": [
        {
          "text": "Yehova bwerani msanga kudzandithandiza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.1",
            "verseOrgIds": [
              "PSA.70.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 70:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amene akufunafuna moyo wanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:2"
      },
      "items": [
        {
          "text": "achititsidwe manyazi ndi kusokonezedwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 70:2"
      },
      "items": [
        {
          "text": "onse amene akukhumba chiwonongeko changa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:2"
      },
      "items": [
        {
          "text": "abwezedwe mopanda ulemu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 70:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onse amene akunena kwa ine kuti, \"Aha, aha,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.3",
            "verseOrgIds": [
              "PSA.70.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:3"
      },
      "items": [
        {
          "text": "abwerere chifukwa cha manyazi awo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.3",
            "verseOrgIds": [
              "PSA.70.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 70:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma onse amene akufunafuna Inu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:4"
      },
      "items": [
        {
          "text": "akondwere ndi kusangalala mwa Inu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 70:4"
      },
      "items": [
        {
          "text": "iwo amene amakonda chipulumutso chanu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:4"
      },
      "items": [
        {
          "text": "nthawi zonse anene kuti, \"Mulungu akuzike!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 70:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ine ndine wosauka ndi wosowa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:5"
      },
      "items": [
        {
          "text": "bwerani msanga kwa ine Inu Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 70:5"
      },
      "items": [
        {
          "text": "Inu ndinu thandizo langa ndi momboli wanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:5"
      },
      "items": [
        {
          "text": "Inu Yehova musachedwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    }
  ],
