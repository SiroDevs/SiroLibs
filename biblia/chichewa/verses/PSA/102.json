          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anathyola mphamvu zanga pa nthawi ya moyo wanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.23",
            "verseOrgIds": [
              "PSA.102.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:23"
      },
      "items": [
        {
          "text": "Iyeyo anafupikitsa masiku anga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.23",
            "verseOrgIds": [
              "PSA.102.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 102:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Ine ndinati:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.24",
            "verseOrgIds": [
              "PSA.102.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:24"
      },
      "items": [
        {
          "text": "\"Musandichotse, Inu Mulungu wanga, pakati pa masiku a moyo wanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.24",
            "verseOrgIds": [
              "PSA.102.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:24"
      },
      "items": [
        {
          "text": "zaka zanu zimakhalabe pa mibado yonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.24",
            "verseOrgIds": [
              "PSA.102.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 102:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pachiyambi Inu munakhazikitsa maziko a dziko lapansi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.25",
            "verseOrgIds": [
              "PSA.102.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:25"
      },
      "items": [
        {
          "text": "ndipo mayiko akumwamba ndi ntchito ya manja anu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.25",
            "verseOrgIds": [
              "PSA.102.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 102:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izi zidzatha, koma Inu mudzakhalapo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:26"
      },
      "items": [
        {
          "text": "zidzatha ngati chovala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 102:26"
      },
      "items": [
        {
          "text": "Mudzazisintha ngati chovala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
          }
        }
      ]
    },
