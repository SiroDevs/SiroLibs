          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a atumiki anu adzakhala pamaso panu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.28",
            "verseOrgIds": [
              "PSA.102.29"
            ]
          }
        }
