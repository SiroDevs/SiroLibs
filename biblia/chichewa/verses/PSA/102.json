          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimenezi zilembedwe chifukwa cha mibado ya mʼtsogolo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.18",
            "verseOrgIds": [
              "PSA.102.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:18"
      },
      "items": [
        {
          "text": "kuti anthu amene sanabadwe adzatamande Yehova:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.18",
            "verseOrgIds": [
              "PSA.102.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 102:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yehova anayangʼana pansi kuchokera ku malo ake opatulika mmwamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.19",
            "verseOrgIds": [
              "PSA.102.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:19"
      },
      "items": [
        {
          "text": "kuchokera kumwamba anayangʼana dziko lapansi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.19",
            "verseOrgIds": [
              "PSA.102.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 102:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti amve kubuwula kwa anthu a mʼndende,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.20",
            "verseOrgIds": [
              "PSA.102.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:20"
      },
      "items": [
        {
          "text": "kuti apulumutse amene anayenera kuphedwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.20",
            "verseOrgIds": [
              "PSA.102.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 102:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero dzina la Yehova lidzalengezedwa mu Ziyoni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.21",
            "verseOrgIds": [
              "PSA.102.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:21"
      },
      "items": [
        {
          "text": "ndi matamando ake mu Yerusalemu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.21",
            "verseOrgIds": [
              "PSA.102.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 102:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamene mitundu ya anthu ndi maufumu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.22",
            "verseOrgIds": [
              "PSA.102.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:22"
      },
      "items": [
        {
          "text": "adzasonkhana kuti alambire Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.22",
            "verseOrgIds": [
              "PSA.102.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
