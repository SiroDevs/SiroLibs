  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "102",
        "style": "c",
        "sid": "PSA 102"
      },
      "items": [
        {
          "text": "102",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 102",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pemphero la munthu wosautsidwa, pamene walefuka, nakhuthulira pamaso pa Yehova kulira kwakeko.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 102:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova imvani pemphero langa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.1",
            "verseOrgIds": [
              "PSA.102.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:1"
      },
      "items": [
        {
          "text": "kulira kwanga kopempha thandizo kufike kwa Inu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.1",
            "verseOrgIds": [
              "PSA.102.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 102:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musandibisire nkhope yanu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:2"
      },
      "items": [
        {
          "text": "pamene ndili pa msautso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 102:2"
      },
      "items": [
        {
          "text": "Munditcherere khutu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:2"
      },
      "items": [
        {
          "text": "pamene ndiyitana ndiyankheni msanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 102:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti masiku anga akupita ngati utsi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.3",
            "verseOrgIds": [
              "PSA.102.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:3"
      },
      "items": [
        {
          "text": "mafupa anga akunyeka ngati nkhuni zoyaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.3",
            "verseOrgIds": [
              "PSA.102.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 102:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wanga wakanthidwa ndipo ukufota ngati udzu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.4",
            "verseOrgIds": [
              "PSA.102.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:4"
      },
      "items": [
        {
          "text": "ndipo ndimayiwala kudya chakudya changa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.4",
            "verseOrgIds": [
              "PSA.102.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 102:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa cha kubuwula kwanga kofuwula",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.5",
            "verseOrgIds": [
              "PSA.102.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:5"
      },
      "items": [
        {
          "text": "ndatsala chikopa ndi mafupa okhaokha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.5",
            "verseOrgIds": [
              "PSA.102.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 102:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndili ngati kadzidzi wa ku chipululu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.6",
            "verseOrgIds": [
              "PSA.102.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:6"
      },
      "items": [
        {
          "text": "monga kadzidzi pakati pa mabwinja.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.6",
            "verseOrgIds": [
              "PSA.102.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 102:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimagona osapeza tulo; ndakhala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.7",
            "verseOrgIds": [
              "PSA.102.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:7"
      },
      "items": [
        {
          "text": "ngati mbalame yokhala yokha pa denga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.7",
            "verseOrgIds": [
              "PSA.102.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 102:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lonse adani anga amandichita chipongwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.8",
            "verseOrgIds": [
              "PSA.102.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:8"
      },
      "items": [
        {
          "text": "iwo amene amandinyoza, amagwiritsa ntchito dzina langa ngati temberero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.8",
            "verseOrgIds": [
              "PSA.102.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 102:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ndimadya phulusa ngati chakudya changa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.9",
            "verseOrgIds": [
              "PSA.102.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:9"
      },
      "items": [
        {
          "text": "ndi kusakaniza chakumwa changa ndi misozi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.9",
            "verseOrgIds": [
              "PSA.102.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 102:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "chifukwa cha ukali wanu waukulu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.10",
            "verseOrgIds": [
              "PSA.102.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:10"
      },
      "items": [
        {
          "text": "popeza Inu mwandinyamula ndi kunditayira kumbali.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.10",
            "verseOrgIds": [
              "PSA.102.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 102:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masiku anga ali ngati mthunzi wa kumadzulo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.11",
            "verseOrgIds": [
              "PSA.102.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:11"
      },
      "items": [
        {
          "text": "Ine ndikufota ngati udzu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.11",
            "verseOrgIds": [
              "PSA.102.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 102:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Inu Yehova, muli pa mpando wanu waufumu kwamuyaya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:12"
      },
      "items": [
        {
          "text": "kudziwika kwanu ndi kokhazikika ku mibado yonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 102:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mudzadzuka ndi kuchitira chifundo Ziyoni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:13"
      },
      "items": [
        {
          "text": "pakuti ndi nthawi yoti muonetse kukoma mtima kwanu pa iyeyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:13"
      },
      "items": [
        {
          "text": "nthawi yoyikika yafika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 102:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti miyala yake ndi yokondedwa kwa atumiki anu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.14",
            "verseOrgIds": [
              "PSA.102.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:14"
      },
      "items": [
        {
          "text": "fumbi lake lokha limawachititsa kuti amve chisoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.14",
            "verseOrgIds": [
              "PSA.102.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 102:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitundu ya anthu idzaopa dzina la Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.15",
            "verseOrgIds": [
              "PSA.102.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:15"
      },
      "items": [
        {
          "text": "mafumu onse a dziko lapansi adzalemekeza ulemerero wanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.15",
            "verseOrgIds": [
              "PSA.102.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 102:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Yehova adzamanganso Ziyoni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.16",
            "verseOrgIds": [
              "PSA.102.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:16"
      },
      "items": [
        {
          "text": "ndi kuonekera mu ulemerero wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.16",
            "verseOrgIds": [
              "PSA.102.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 102:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzayankha pemphero la anthu otayika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.17",
            "verseOrgIds": [
              "PSA.102.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:17"
      },
      "items": [
        {
          "text": "sadzanyoza kupempha kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.17",
            "verseOrgIds": [
              "PSA.102.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
