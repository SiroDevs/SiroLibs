      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:26"
      },
      "items": [
        {
          "text": "ndipo zidzatayidwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
          }
        }
      ]
    },
    {
