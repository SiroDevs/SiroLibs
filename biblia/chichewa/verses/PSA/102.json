      "attrs": {
        "style": "q2",
        "vid": "PSA 102:27"
      },
      "items": [
        {
          "text": "ndipo zaka zanu sizidzatha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.27",
            "verseOrgIds": [
              "PSA.102.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
