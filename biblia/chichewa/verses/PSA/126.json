    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 126",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Nyimbo yoyimba pokwera ku Yerusalemu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 126:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova atabwezera akapolo ku Ziyoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.1",
            "verseOrgIds": [
              "PSA.126.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:1"
      },
      "items": [
        {
          "text": "tinali ngati amene akulota.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.1",
            "verseOrgIds": [
              "PSA.126.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 126:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakamwa pathu panadzaza ndi kuseka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:2"
      },
      "items": [
        {
          "text": "malilime athu ndi nyimbo zachimwemwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 126:2"
      },
      "items": [
        {
          "text": "Pamenepo kunanenedwa pakati pa anthu kuti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:2"
      },
      "items": [
        {
          "text": "\"Yehova wawachitira zinthu zazikulu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 126:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova watichitira zinthu zazikulu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.3",
            "verseOrgIds": [
              "PSA.126.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:3"
      },
      "items": [
        {
          "text": "ndipo tadzazidwa ndi chimwemwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.3",
            "verseOrgIds": [
              "PSA.126.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 126:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tibwezereni madalitso athu, Inu Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.4",
            "verseOrgIds": [
              "PSA.126.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:4"
      },
      "items": [
        {
          "text": "monga mitsinje ya ku Negevi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.4",
            "verseOrgIds": [
              "PSA.126.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 126:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amene amafesa akulira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.5",
            "verseOrgIds": [
              "PSA.126.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:5"
      },
      "items": [
        {
          "text": "adzakolola akuyimba nyimbo zachimwemwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.5",
            "verseOrgIds": [
              "PSA.126.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 126:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amene amayendayenda nalira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:6"
      },
      "items": [
        {
          "text": "atanyamula mbewu yokafesa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 126:6"
      },
      "items": [
        {
          "text": "adzabwerera akuyimba nyimbo zachimwemwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:6"
      },
      "items": [
        {
          "text": "atanyamula mitolo yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
    }
