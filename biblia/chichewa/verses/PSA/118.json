          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼkwabwino kuthawira kwa Yehova",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.8",
            "verseOrgIds": [
              "PSA.118.8"
            ]
          }
        }
