          "text": "ukumveka mʼmatenti a anthu olungama mtima kuti:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.15",
            "verseOrgIds": [
              "PSA.118.15"
            ]
          }
        }
      ]
