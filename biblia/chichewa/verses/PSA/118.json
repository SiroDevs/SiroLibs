          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndili mʼmasautso anga ndinalirira Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.5",
            "verseOrgIds": [
              "PSA.118.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:5"
      },
      "items": [
        {
          "text": "ndipo Iye anayankha pondichotsa mʼmasautsowo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.5",
            "verseOrgIds": [
              "PSA.118.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 118:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ali nane; sindidzachita mantha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.6",
            "verseOrgIds": [
              "PSA.118.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:6"
      },
      "items": [
        {
          "text": "Munthu angandichite chiyani?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.6",
            "verseOrgIds": [
              "PSA.118.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 118:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ali nane; Iye ndiye thandizo langa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.7",
            "verseOrgIds": [
              "PSA.118.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:7"
      },
      "items": [
        {
          "text": "Ndidzayangʼana adani anga mwachipambano.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.7",
            "verseOrgIds": [
              "PSA.118.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
