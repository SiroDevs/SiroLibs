          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzanja lamanja la Yehova latukulidwa mmwamba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.16",
            "verseOrgIds": [
              "PSA.118.16"
            ]
          }
        }
      ]
    },
