      "attrs": {
        "style": "q2",
        "vid": "PSA 118:10"
      },
      "items": [
        {
          "text": "koma mʼdzina la Yehova ndinawawononga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.10",
            "verseOrgIds": [
              "PSA.118.10"
            ]
          }
        }
