          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anandikankha uku ndi uko ndipo ndinali pafupi kugwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.13",
            "verseOrgIds": [
              "PSA.118.13"
