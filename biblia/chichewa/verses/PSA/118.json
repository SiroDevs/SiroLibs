      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 118:15"
      },
      "items": [
        {
          "text": "\"Dzanja lamanja la Yehova lachita zamphamvu!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.15",
            "verseOrgIds": [
              "PSA.118.15"
            ]
          }
        }
      ]
    },
