              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamikani Yehova chifukwa ndi wabwino;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.1",
            "verseOrgIds": [
              "PSA.118.1"
            ]
          }
        }
      ]
    },
    {
