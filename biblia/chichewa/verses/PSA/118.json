          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amene amaopa Yehova anene kuti:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.4",
            "verseOrgIds": [
              "PSA.118.4"
            ]
          }
