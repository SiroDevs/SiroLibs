      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:1"
      },
      "items": [
        {
          "text": "pakuti chikondi chake chosasinthika ndi chosatha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.1",
            "verseOrgIds": [
              "PSA.118.1"
            ]
          }
        }
      ]
    },
