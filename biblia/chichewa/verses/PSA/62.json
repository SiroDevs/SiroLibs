  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "62",
        "style": "c",
        "sid": "PSA 62"
      },
      "items": [
        {
          "text": "62",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 62",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Kutsata mayimbidwe a Yedutuni. Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 62:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyo wanga umapeza mpumulo mwa Mulungu yekha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.1",
            "verseOrgIds": [
              "PSA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:1"
      },
      "items": [
        {
          "text": "chipulumutso changa chimachokera kwa Iye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.1",
            "verseOrgIds": [
              "PSA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 62:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye yekhayo ndiye thanthwe langa ndi chipulumutso changa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.2",
            "verseOrgIds": [
              "PSA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:2"
      },
      "items": [
        {
          "text": "Iye ndi linga langa, choncho sindidzagwedezeka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.2",
            "verseOrgIds": [
              "PSA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 62:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi nonsenu mudzalimbana naye munthu mpaka liti?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:3"
      },
      "items": [
        {
          "text": "Kodi mudzamugwetsa pansi ngati khoma losalimba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:3"
      },
      "items": [
        {
          "text": "ngati mpanda wogwedezeka?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 62:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo akufunitsitsa kumugwetsa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "kuti achoke pa malo ake apamwamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "Iwo amakondweretsedwa ndi mabodza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "Ndi pakamwa pawo amadalitsa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "koma mʼmitima yawo amatemberera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 62:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peza mpumulo mwa Mulungu yekhayo iwe moyo wanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.5",
            "verseOrgIds": [
              "PSA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:5"
      },
      "items": [
        {
          "text": "chiyembekezo changa chichokera mwa Iye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.5",
            "verseOrgIds": [
              "PSA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 62:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye yekhayo ndiye thanthwe langa ndi chipulumutso changa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.6",
            "verseOrgIds": [
              "PSA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:6"
      },
      "items": [
        {
          "text": "Iyeyo ndi linga langa; sindidzagwedezeka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.6",
            "verseOrgIds": [
              "PSA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 62:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipulumutso changa ndi ulemu wanga zimachokera kwa Mulungu:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.7",
            "verseOrgIds": [
              "PSA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:7"
      },
      "items": [
        {
          "text": "Iye ndiye thanthwe langa lamphamvu; Mulungu ndiye pothawira panga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.7",
            "verseOrgIds": [
              "PSA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 62:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dalirani Iye nthawi zonse, inu anthu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:8"
      },
      "items": [
        {
          "text": "khuthulani mitima yanu kwa Iye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:8"
      },
      "items": [
        {
          "text": "pakuti Mulungu ndiye pothawirapo pathu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 62:8"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.62.8",
                "verseOrgIds": [
                  "PSA.62.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 62:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu wamba ndi mpweya chabe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:9"
      },
      "items": [
        {
          "text": "anthu apamwamba ndi bodza chabe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:9"
      },
      "items": [
        {
          "text": "ngati atayezedwa pa sikelo iwo ndi chabe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:9"
      },
      "items": [
        {
          "text": "iwowo pamodzi ndi mpweya ndi chabe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 62:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musadalire kulanda mwachinyengo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:10"
      },
      "items": [
        {
          "text": "kapena katundu wobedwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:10"
      },
      "items": [
        {
          "text": "ngakhale chuma chanu chichuluke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:10"
      },
      "items": [
        {
          "text": "musayike mtima wanu pa icho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 62:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu wayankhula kamodzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:11"
      },
      "items": [
        {
          "text": "ine ndamvapo zinthu ziwiri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:11"
      },
      "items": [
        {
          "text": "choyamba nʼchakuti Inu Mulungu ndinu wamphamvu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 62:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "komanso Inu Ambuye, chikondi chanu nʼchosasinthika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:12"
      },
      "items": [
        {
          "text": "Chachiwiri nʼchakuti mumamuchitira munthu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:12"
      },
      "items": [
        {
          "text": "molingana ndi ntchito zake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        }
      ]
    }
