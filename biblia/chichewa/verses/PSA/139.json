  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "139",
        "style": "c",
        "sid": "PSA 139"
      },
      "items": [
        {
          "text": "139",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 139",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 139:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, mwandisanthula",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.1",
            "verseOrgIds": [
              "PSA.139.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:1"
      },
      "items": [
        {
          "text": "ndipo mukundidziwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.1",
            "verseOrgIds": [
              "PSA.139.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 139:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mumadziwa pamene ndikhala pansi ndi pamene ndidzuka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.2",
            "verseOrgIds": [
              "PSA.139.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:2"
      },
      "items": [
        {
          "text": "mumazindikira maganizo anga muli kutali.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.2",
            "verseOrgIds": [
              "PSA.139.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 139:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumapenyetsetsa pamene ndikutuluka ndi kugona kwanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.3",
            "verseOrgIds": [
              "PSA.139.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:3"
      },
      "items": [
        {
          "text": "mumadziwa njira zanga zonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.3",
            "verseOrgIds": [
              "PSA.139.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 139:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawu asanatuluke pa lilime langa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.4",
            "verseOrgIds": [
              "PSA.139.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:4"
      },
      "items": [
        {
          "text": "mumawadziwa bwinobwino, Inu Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.4",
            "verseOrgIds": [
              "PSA.139.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 139:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumandizinga kumbuyo ndi kutsogolo komwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.5",
            "verseOrgIds": [
              "PSA.139.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:5"
      },
      "items": [
        {
          "text": "mwasanjika dzanja lanu pa ine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.5",
            "verseOrgIds": [
              "PSA.139.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 139:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzeru zimenezi ndi zopitirira nzeru zanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.6",
            "verseOrgIds": [
              "PSA.139.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:6"
      },
      "items": [
        {
          "text": "ndi zapamwamba kuti ine ndizipeze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.6",
            "verseOrgIds": [
              "PSA.139.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 139:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ndingapite kuti kufuna kuzemba Mzimu wanu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.7",
            "verseOrgIds": [
              "PSA.139.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:7"
      },
      "items": [
        {
          "text": "Kodi ndingathawire kuti kuchoka pamaso panu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.7",
            "verseOrgIds": [
              "PSA.139.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 139:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikakwera kumwamba, Inu muli komweko;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.8",
            "verseOrgIds": [
              "PSA.139.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:8"
      },
      "items": [
        {
          "text": "ndikakagona ku malo a anthu akufa, Inu muli komweko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.8",
            "verseOrgIds": [
              "PSA.139.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 139:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati ndiwulukira kotulukira dzuwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.9",
            "verseOrgIds": [
              "PSA.139.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:9"
      },
      "items": [
        {
          "text": "ngati ndikakhala ku malekezero a nyanja,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.9",
            "verseOrgIds": [
              "PSA.139.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 139:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kumenekonso dzanja lanu lidzanditsogolera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.10",
            "verseOrgIds": [
              "PSA.139.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:10"
      },
      "items": [
        {
          "text": "dzanja lanu lamanja lidzandigwiriziza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.10",
            "verseOrgIds": [
              "PSA.139.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 139:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikanena kuti, \"Zoonadi, mdima udzandibisa ndithu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.11",
            "verseOrgIds": [
              "PSA.139.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:11"
      },
      "items": [
        {
          "text": "ndipo kuwunika kukhale mdima mondizungulira,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.11",
            "verseOrgIds": [
              "PSA.139.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 139:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "komabe mdimawo sudzakhala mdima kwa Inu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:12"
      },
      "items": [
        {
          "text": "usiku udzawala ngati masana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:12"
      },
      "items": [
        {
          "text": "pakuti mdima uli ngati kuwunika kwa Inu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 139:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Inu munalenga za mʼkati mwanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.13",
            "verseOrgIds": [
              "PSA.139.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:13"
      },
      "items": [
        {
          "text": "munandiwumba pamodzi mʼmimba mwa amayi anga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.13",
            "verseOrgIds": [
              "PSA.139.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 139:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimakuyamikani chifukwa ndinapangidwa mochititsa mantha ndi modabwitsa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:14"
      },
      "items": [
        {
          "text": "ntchito zanu ndi zodabwitsa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:14"
      },
      "items": [
        {
          "text": "zimenezi ndimazidziwa bwino lomwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 139:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapangidwe anga sanabisike pamaso panu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
            "verseOrgIds": [
              "PSA.139.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:15"
      },
      "items": [
        {
          "text": "pamene ndimapangidwa mʼmalo achinsinsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
            "verseOrgIds": [
              "PSA.139.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 139:15"
      },
      "items": [
        {
          "text": "pamene ndinkawumbidwa mwaluso mʼmimba ya amayi anga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
            "verseOrgIds": [
              "PSA.139.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 139:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maso anu anaona thupi langa lisanawumbidwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.16",
            "verseOrgIds": [
              "PSA.139.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:16"
      },
      "items": [
        {
          "text": "Masiku onse amene anapatsidwa kwa ine, analembedwa mʼbuku lanu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.16",
            "verseOrgIds": [
              "PSA.139.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:16"
      },
      "items": [
        {
          "text": "asanayambe nʼkuwerengedwa komwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.16",
            "verseOrgIds": [
              "PSA.139.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
