              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwerani, mutamande Yehova, inu atumiki onse a Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.134.1",
            "verseOrgIds": [
              "PSA.134.1"
