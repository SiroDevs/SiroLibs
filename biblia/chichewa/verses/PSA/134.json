      "attrs": {
        "style": "q2",
        "vid": "PSA 134:1"
      },
      "items": [
        {
          "text": "amene mumatumikira usiku mʼnyumba ya Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.134.1",
            "verseOrgIds": [
              "PSA.134.1"
            ]
