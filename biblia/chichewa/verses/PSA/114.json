          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Israeli anatuluka mu Igupto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.1",
            "verseOrgIds": [
              "PSA.114.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:1"
      },
      "items": [
        {
          "text": "nyumba ya Yakobo kuchoka ku mtundu wa anthu a chiyankhulo chachilendo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.1",
            "verseOrgIds": [
              "PSA.114.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 114:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda anasanduka malo opatulika a Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.2",
            "verseOrgIds": [
              "PSA.114.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:2"
      },
      "items": [
        {
          "text": "Israeli anasanduka ufumu wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.2",
            "verseOrgIds": [
              "PSA.114.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 114:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyanja inaona ndi kuthawa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.3",
            "verseOrgIds": [
              "PSA.114.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:3"
      },
      "items": [
        {
          "text": "mtsinje wa Yorodani unabwerera mʼmbuyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.3",
            "verseOrgIds": [
              "PSA.114.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 114:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mapiri analumphalumpha ngati nkhosa zazimuna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.4",
            "verseOrgIds": [
              "PSA.114.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:4"
      },
      "items": [
        {
          "text": "timapiri ngati ana ankhosa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.4",
            "verseOrgIds": [
              "PSA.114.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 114:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chiyani iwe unathawa?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.5",
            "verseOrgIds": [
              "PSA.114.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:5"
      },
      "items": [
        {
          "text": "iwe mtsinje wa Yorodani unabwereranji mʼmbuyo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.5",
            "verseOrgIds": [
              "PSA.114.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 114:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "inu mapiri, munalumphalumphiranji ngati nkhosa zazimuna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.6",
            "verseOrgIds": [
              "PSA.114.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:6"
      },
      "items": [
        {
          "text": "inu timapiri, ngati ana ankhosa?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.6",
            "verseOrgIds": [
              "PSA.114.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
