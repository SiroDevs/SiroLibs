        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perekani kwa Yehova, inu anthu amphamvu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.1",
            "verseOrgIds": [
              "PSA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:1"
      },
      "items": [
        {
          "text": "perekani kwa Yehova ulemerero ndi mphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.1",
            "verseOrgIds": [
              "PSA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perekani kwa Yehova ulemerero woyenera dzina lake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.2",
            "verseOrgIds": [
              "PSA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:2"
      },
      "items": [
        {
          "text": "pembedzani Yehova mwa kukongola kwa chiyero chake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.2",
            "verseOrgIds": [
              "PSA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liwu la Yehova lili pamwamba pa madzi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:3"
      },
      "items": [
        {
          "text": "Mulungu waulemerero abangula,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:3"
      },
      "items": [
        {
          "text": "Yehova abangula pamwamba pa madzi amphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liwu la Yehova ndi lamphamvu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.4",
            "verseOrgIds": [
              "PSA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:4"
      },
      "items": [
        {
          "text": "liwu la Yehova ndi laulemerero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.4",
            "verseOrgIds": [
              "PSA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liwu la Yehova limathyola mikungudza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.5",
            "verseOrgIds": [
              "PSA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:5"
      },
      "items": [
        {
          "text": "Yehova amathyolathyola mikungudza ya ku Lebanoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.5",
            "verseOrgIds": [
              "PSA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amachititsa Lebanoni kulumphalumpha ngati mwana wangʼombe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.6",
            "verseOrgIds": [
              "PSA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:6"
      },
      "items": [
        {
          "text": "Siriyoni ngati mwana wa njati:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.6",
            "verseOrgIds": [
              "PSA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liwu la Yehova limakantha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.7",
            "verseOrgIds": [
              "PSA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:7"
      },
      "items": [
        {
          "text": "ngati kungʼanima kwa mphenzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.7",
            "verseOrgIds": [
              "PSA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liwu la Yehova limagwedeza chipululu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.8",
            "verseOrgIds": [
              "PSA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:8"
      },
      "items": [
        {
          "text": "Yehova amagwedeza chipululu cha Kadesi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.8",
            "verseOrgIds": [
              "PSA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liwu la Yehova limapindapinda mibawa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.9",
            "verseOrgIds": [
              "PSA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:9"
      },
      "items": [
        {
          "text": "ndi kuyeretsa nkhalango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.9",
            "verseOrgIds": [
              "PSA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 29:9"
      },
      "items": [
        {
          "text": "Ndipo mʼNyumba mwake onse amafuwula kuti, \"Ulemerero!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.9",
            "verseOrgIds": [
              "PSA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova amakhala pamwamba pa madzi osefukira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.10",
            "verseOrgIds": [
              "PSA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:10"
      },
      "items": [
        {
          "text": "Yehova ndiye mfumu kwamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.10",
            "verseOrgIds": [
              "PSA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova amapereka mphamvu kwa anthu ake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.11",
            "verseOrgIds": [
              "PSA.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:11"
      },
      "items": [
        {
          "text": "Yehova amadalitsa anthu ake ndi mtendere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.11",
            "verseOrgIds": [
              "PSA.29.11"
            ]
          }
        }
      ]
    }
  ],
