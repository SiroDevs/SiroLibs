          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Andizunza kwambiri kuyambira ubwana wanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.2",
            "verseOrgIds": [
              "PSA.129.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:2"
      },
      "items": [
        {
          "text": "koma sanandipambane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.2",
            "verseOrgIds": [
              "PSA.129.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 129:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu otipula analima pa msana panga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.3",
            "verseOrgIds": [
              "PSA.129.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:3"
      },
      "items": [
        {
          "text": "ndipo anapangapo mizere yayitali:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.3",
            "verseOrgIds": [
              "PSA.129.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 129:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yehova ndi wolungama;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.4",
            "verseOrgIds": [
              "PSA.129.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:4"
      },
      "items": [
        {
          "text": "Iye wandimasula ku zingwe za anthu oyipa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.4",
            "verseOrgIds": [
              "PSA.129.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 129:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onse amene amadana ndi Ziyoni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.5",
            "verseOrgIds": [
              "PSA.129.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:5"
      },
      "items": [
        {
          "text": "abwezedwe pambuyo mwamanyazi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.5",
            "verseOrgIds": [
              "PSA.129.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 129:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akhale ngati udzu womera pa denga la nyumba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.6",
            "verseOrgIds": [
              "PSA.129.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:6"
      },
      "items": [
        {
          "text": "umene umafota usanakule;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.6",
            "verseOrgIds": [
              "PSA.129.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 129:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "sungadzaze manja a owumweta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.7",
            "verseOrgIds": [
              "PSA.129.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:7"
      },
      "items": [
        {
          "text": "kapena manja a omanga mitolo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.7",
            "verseOrgIds": [
              "PSA.129.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 129:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odutsa pafupi asanene kuti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.8",
            "verseOrgIds": [
              "PSA.129.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:8"
      },
      "items": [
        {
          "text": "\"Dalitso la Yehova lili pa inu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.8",
            "verseOrgIds": [
              "PSA.129.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:8"
      },
      "items": [
        {
          "text": "tikukudalitsani mʼdzina la Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.8",
            "verseOrgIds": [
              "PSA.129.8"
            ]
          }
        }
      ]
    }
