    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 112",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 112:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamandani Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 112:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 112:1"
      },
      "items": [
        {
          "text": "Wodala munthu amene amaopa Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:1"
      },
      "items": [
        {
          "text": "amene amakondwera kwambiri ndi malamulo ake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 112:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ake adzakhala amphamvu mʼdziko;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.2",
            "verseOrgIds": [
              "PSA.112.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:2"
      },
      "items": [
        {
          "text": "mʼbado wa olungama mtima udzadalitsidwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.2",
            "verseOrgIds": [
              "PSA.112.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 112:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulemera ndi chuma zili mʼnyumba yake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.3",
            "verseOrgIds": [
              "PSA.112.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:3"
      },
      "items": [
        {
          "text": "ndipo chilungamo chake ndi chosatha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.3",
            "verseOrgIds": [
              "PSA.112.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 112:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale mu mdima kuwala kumatulukira olungama mtima;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.4",
            "verseOrgIds": [
              "PSA.112.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:4"
      },
      "items": [
        {
          "text": "wokoma mtima, wachifundo ndi wowongoka mtima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.4",
            "verseOrgIds": [
              "PSA.112.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 112:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zinthu zabwino zidzabwera kwa iye amene amapereka mowolowamanja ndi wokongoletsa mwaufulu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.5",
            "verseOrgIds": [
              "PSA.112.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:5"
      },
      "items": [
        {
          "text": "amene amachita ntchito yake mwachilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.5",
            "verseOrgIds": [
              "PSA.112.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 112:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithu sadzagwedezeka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.6",
            "verseOrgIds": [
              "PSA.112.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:6"
      },
      "items": [
        {
          "text": "munthu wolungama sadzayiwalika mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.6",
            "verseOrgIds": [
              "PSA.112.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 112:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saopa akamva zoyipa zimene zachitika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.7",
            "verseOrgIds": [
              "PSA.112.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:7"
      },
      "items": [
        {
          "text": "mtima wake ndi wokhazikika ndipo amadalira Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.7",
            "verseOrgIds": [
              "PSA.112.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 112:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wake ndi wotetezedwa, sadzakhala ndi mantha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.8",
            "verseOrgIds": [
              "PSA.112.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:8"
      },
      "items": [
        {
          "text": "potsiriza pake adzayangʼana adani ake mwachipambano.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.8",
            "verseOrgIds": [
              "PSA.112.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 112:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wopereka mphatso zake mowolowamanja kwa osauka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:9"
      },
      "items": [
        {
          "text": "chilungamo chake chimanka mpaka muyaya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:9"
      },
      "items": [
        {
          "text": "nyanga yake idzakwezedwa mwaulemu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 112:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu woyipa adzaona zimenezi ndipo adzapsa mtima;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:10"
      },
      "items": [
        {
          "text": "adzakukuta mano ake ndipo adzasungunuka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:10"
      },
      "items": [
        {
          "text": "Zolakalaka za anthu oyipa sizidzachitika konse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    }
  ],
