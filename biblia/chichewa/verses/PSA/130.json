    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 130",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Nyimbo yoyimba pokwera ku Yerusalemu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 130:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikulirira kwa Inu Yehova ndili mʼdzenje lozama;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.1",
            "verseOrgIds": [
              "PSA.130.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 130:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye imvani mawu anga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.2",
            "verseOrgIds": [
              "PSA.130.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 130:2"
      },
      "items": [
        {
          "text": "Makutu anu akhale tcheru kumva",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.2",
            "verseOrgIds": [
              "PSA.130.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:2"
      },
      "items": [
        {
          "text": "kupempha chifundo kwanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.2",
            "verseOrgIds": [
              "PSA.130.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 130:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, mukanamawerengera machimo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.3",
            "verseOrgIds": [
              "PSA.130.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:3"
      },
      "items": [
        {
          "text": "Inu Yehova, akanayima chilili ndani wopanda mlandu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.3",
            "verseOrgIds": [
              "PSA.130.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 130:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma kwa Inu kuli chikhululukiro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.4",
            "verseOrgIds": [
              "PSA.130.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:4"
      },
      "items": [
        {
          "text": "nʼchifukwa chake mumaopedwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.4",
            "verseOrgIds": [
              "PSA.130.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 130:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimayembekezera Yehova, moyo wanga umayembekezera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.5",
            "verseOrgIds": [
              "PSA.130.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:5"
      },
      "items": [
        {
          "text": "ndipo ndimakhulupirira mawu ake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.5",
            "verseOrgIds": [
              "PSA.130.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 130:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyo wanga umayembekezera Ambuye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:6"
      },
      "items": [
        {
          "text": "kupambana momwe alonda amayembekezera mmawa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:6"
      },
      "items": [
        {
          "text": "inde, kupambana momwe alonda amayembekezera mmawa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 130:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yembekeza Yehova, iwe Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:7"
      },
      "items": [
        {
          "text": "pakuti Yehova ali ndi chikondi chosasinthika",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:7"
      },
      "items": [
        {
          "text": "ndipo alinso ndi chipulumutso chochuluka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 130:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye mwini adzawombola Israeli",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.8",
            "verseOrgIds": [
              "PSA.130.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:8"
      },
      "items": [
        {
          "text": "ku machimo ake onse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.8",
            "verseOrgIds": [
              "PSA.130.8"
            ]
          }
        }
      ]
