  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "AMO 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawu Odandawulira Aisraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli, imva mawu awa, nyimbo ya maliro imene ndikuyimba za iweyo:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.1",
            "verseOrgIds": [
              "AMO.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namwali Israeli wagwa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:2"
      },
      "items": [
        {
          "text": "moti sadzadzukanso,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:2"
      },
      "items": [
        {
          "text": "wasiyidwa mʼdziko lake lomwe,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:2"
      },
      "items": [
        {
          "text": "popanda woti ndi kumudzutsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:3"
      },
      "items": [
        {
          "text": "\"Mzinda umene udzapite ku nkhondo ndi anthu 1,000 amphamvu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:3"
      },
      "items": [
        {
          "text": "udzatsala ndi anthu 100 okha;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:3"
      },
      "items": [
        {
          "text": "mzinda umene udzapite ku nkhondo ndi anthu 100 amphamvu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:3"
      },
      "items": [
        {
          "text": "udzatsala ndi anthu khumi okha basi.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimene Yehova akunena kwa nyumba ya Israeli ndi izi:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.4",
            "verseOrgIds": [
              "AMO.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:4"
      },
      "items": [
        {
          "text": "\"Mundifunefune kuti mukhale ndi moyo;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.4",
            "verseOrgIds": [
              "AMO.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "musafunefune Beteli,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:5"
      },
      "items": [
        {
          "text": "musapite ku Giligala,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:5"
      },
      "items": [
        {
          "text": "musapite ku Beeriseba.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:5"
      },
      "items": [
        {
          "text": "Pakuti Giligala adzatengedwa ndithu kupita ku ukapolo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:5"
      },
      "items": [
        {
          "text": "ndipo Beteli adzawonongekeratu.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Funani Yehova kuti mukhale ndi moyo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:6"
      },
      "items": [
        {
          "text": "mukapanda kutero Iye adzatentha nyumba ya Yosefe ngati moto;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:6"
      },
      "items": [
        {
          "text": "motowo udzawononga,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:6"
      },
      "items": [
        {
          "text": "ndipo sipadzakhala wina wozimitsa motowo ku Beteli.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu amene mumasandutsa chiweruzo cholungama kukhala chowawa",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.7",
            "verseOrgIds": [
              "AMO.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:7"
      },
      "items": [
        {
          "text": "ndi kunyoza chilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.7",
            "verseOrgIds": [
              "AMO.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Iye amene analenga nyenyezi za Nsangwe ndi Akamwiniatsatana,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:8"
      },
      "items": [
        {
          "text": "amene amasandutsa mdima kuti ukhale mmawa",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:8"
      },
      "items": [
        {
          "text": "ndi kudetsa usana kuti ukhale usiku,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:8"
      },
      "items": [
        {
          "text": "amene amayitana madzi a mʼnyanja",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:8"
      },
      "items": [
        {
          "text": "ndi kuwathira pa dziko lapansi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:8"
      },
      "items": [
        {
          "text": "Yehova ndiye dzina lake.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyeyo amabweretsa chiwonongeko modzidzimutsa pa anthu amphamvu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.9",
            "verseOrgIds": [
              "AMO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:9"
      },
      "items": [
        {
          "text": "ndi kuwononga mizinda yotetezedwa),",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.9",
            "verseOrgIds": [
              "AMO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "inu mumadana ndi amene amadzudzula mʼbwalo la milandu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.10",
            "verseOrgIds": [
              "AMO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:10"
      },
      "items": [
        {
          "text": "ndi kunyoza amene amanena zoona.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.10",
            "verseOrgIds": [
              "AMO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumapondereza munthu wosauka",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:11"
      },
      "items": [
        {
          "text": "ndi kumukakamiza kuti akupatseni tirigu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:11"
      },
      "items": [
        {
          "text": "Nʼchifukwa chake, ngakhale mwamanga nyumba zamiyala yosema,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:11"
      },
      "items": [
        {
          "text": "inuyo simudzakhalamo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:11"
      },
      "items": [
        {
          "text": "Ngakhale mwalima minda yabwino ya mphesa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:11"
      },
      "items": [
        {
          "text": "inu simudzamwa vinyo wake.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Ine ndikudziwa kuchuluka kwa zolakwa zanu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.12",
            "verseOrgIds": [
              "AMO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:12"
      },
      "items": [
        {
          "text": "ndi kukula kwa machimo anu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.12",
            "verseOrgIds": [
