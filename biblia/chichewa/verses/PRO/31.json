          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amasoka nsalu zabafuta nazigulitsa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.24",
            "verseOrgIds": [
              "PRO.31.24"
            ]
          }
