      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:20"
      },
      "items": [
        {
          "text": "ndipo amapereka chithandizo kwa anthu osowa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.20",
            "verseOrgIds": [
              "PRO.31.20"
            ]
          }
        }
      ]
