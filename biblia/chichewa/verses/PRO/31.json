      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:24"
      },
      "items": [
        {
          "text": "amaperekanso mipango kwa anthu amalonda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.24",
            "verseOrgIds": [
              "PRO.31.24"
            ]
          }
