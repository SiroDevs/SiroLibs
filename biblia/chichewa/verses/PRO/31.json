              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amadzilukira thonje",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.19",
            "verseOrgIds": [
              "PRO.31.19"
            ]
          }
