      "attrs": {
        "style": "q2",
        "vid": "PRO 31:25"
      },
      "items": [
        {
          "text": "ndipo amaseka osaopa zamʼtsogolo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.25",
            "verseOrgIds": [
              "PRO.31.25"
            ]
