      "attrs": {
        "style": "q2",
        "vid": "PRO 31:31"
      },
      "items": [
        {
          "text": "ndipo ntchito zake zimutamande ku mabwalo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.31",
            "verseOrgIds": [
              "PRO.31.31"
