      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:19"
      },
      "items": [
        {
          "text": "ndipo yekha amagwira chowombera nsalu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.19",
            "verseOrgIds": [
              "PRO.31.19"
            ]
          }
        }
      ]
