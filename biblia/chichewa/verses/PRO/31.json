          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkhope yachikoka ndi yonyenga, ndipo kukongola nʼkosakhalitsa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.30",
            "verseOrgIds": [
              "PRO.31.30"
            ]
          }
        }
