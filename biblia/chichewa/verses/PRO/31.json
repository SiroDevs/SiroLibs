          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye saopa kuti banja lake lifa ndi kuzizira pa nyengo yachisanu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.21",
            "verseOrgIds": [
              "PRO.31.21"
            ]
          }
        }
      ]
