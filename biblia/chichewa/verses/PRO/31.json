  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "PRO 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawu a Mfumu Lemueli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawa mawu a mfumu Lemueli wa ku Massa amene anamuphunzitsa amayi ake:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.1",
            "verseOrgIds": [
              "PRO.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchiyani mwana wanga? Nʼchiyani mwana wa mʼmimba mwanga?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.2",
            "verseOrgIds": [
              "PRO.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:2"
      },
      "items": [
        {
          "text": "Nʼchiyani iwe mwana wanga amene ndinachita kupempha ndi malumbiro?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.2",
            "verseOrgIds": [
              "PRO.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usapereke mphamvu yako kwa akazi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.3",
            "verseOrgIds": [
              "PRO.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:3"
      },
      "items": [
        {
          "text": "Usamayenda nawo amenewa popeza amawononga ngakhale mafumu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.3",
            "verseOrgIds": [
              "PRO.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe Lemueli si choyenera kwa mafumu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.4",
            "verseOrgIds": [
              "PRO.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:4"
      },
      "items": [
        {
          "text": "mafumu sayenera kumwa vinyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.4",
            "verseOrgIds": [
              "PRO.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:4"
      },
      "items": [
        {
          "text": "Olamulira asamalakalake chakumwa choledzeretsa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.4",
            "verseOrgIds": [
              "PRO.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuopa kuti akamwa adzayiwala malamulo a dziko,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.5",
            "verseOrgIds": [
              "PRO.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:5"
      },
      "items": [
        {
          "text": "nayamba kukhotetsa zinthu zoyenera anthu osauka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.5",
            "verseOrgIds": [
              "PRO.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perekani chakumwa choledzeretsa kwa amene ali pafupi kufa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.6",
            "verseOrgIds": [
              "PRO.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:6"
      },
      "items": [
        {
          "text": "vinyo kwa amene ali pa mavuto woopsa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.6",
            "verseOrgIds": [
              "PRO.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "amwe kuti ayiwale umphawi wawo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.7",
            "verseOrgIds": [
              "PRO.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:7"
      },
      "items": [
        {
          "text": "asakumbukirenso kuvutika kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.7",
            "verseOrgIds": [
              "PRO.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yankhula mʼmalo mwa amene sangathe kudziyankhulira okha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.8",
            "verseOrgIds": [
              "PRO.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:8"
      },
      "items": [
        {
          "text": "Uwayankhulire anthu onse osiyidwa pa zonse zowayenera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.8",
            "verseOrgIds": [
              "PRO.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yankhula ndi kuweruza mwachilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.9",
            "verseOrgIds": [
              "PRO.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:9"
      },
      "items": [
        {
          "text": "Uwateteze amphawi ndi osauka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.9",
            "verseOrgIds": [
              "PRO.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mathero: Mkazi Wangwiro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi mkazi wangwiro angathe kumupeza ndani?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.10",
            "verseOrgIds": [
              "PRO.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:10"
      },
      "items": [
        {
          "text": "Ndi wokwera mtengo kuposa miyala yamtengowapatali.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.10",
            "verseOrgIds": [
              "PRO.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wa mwamuna wake umamukhulupirira",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.11",
            "verseOrgIds": [
              "PRO.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:11"
      },
      "items": [
        {
          "text": "ndipo mwamunayo sasowa phindu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.11",
            "verseOrgIds": [
              "PRO.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masiku onse a moyo wake",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.12",
            "verseOrgIds": [
              "PRO.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:12"
      },
      "items": [
        {
          "text": "mkaziyo amachitira mwamuna wake zabwino zokhazokha osati zoyipa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.12",
            "verseOrgIds": [
              "PRO.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amafunafuna ubweya ndi thonje;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.13",
            "verseOrgIds": [
              "PRO.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:13"
      },
      "items": [
        {
          "text": "amagwira ntchito ndi manja ake mwaufulu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.13",
            "verseOrgIds": [
              "PRO.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ali ngati sitima zapamadzi za anthu amalonda,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.14",
            "verseOrgIds": [
              "PRO.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:14"
      },
      "items": [
        {
          "text": "amakatenga chakudya chake kutali.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.14",
            "verseOrgIds": [
              "PRO.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amadzuka kusanache kwenikweni;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.15",
            "verseOrgIds": [
              "PRO.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:15"
      },
      "items": [
        {
          "text": "ndi kuyamba kukonzera a pa banja pake chakudya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.15",
            "verseOrgIds": [
              "PRO.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:15"
      },
      "items": [
        {
          "text": "ndi kuwagawira ntchito atsikana ake antchito.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.15",
            "verseOrgIds": [
              "PRO.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amalingalira za munda ndi kuwugula;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.16",
            "verseOrgIds": [
              "PRO.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:16"
      },
      "items": [
        {
          "text": "ndi ndalama zimene wazipeza amalima munda wamphesa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.16",
            "verseOrgIds": [
              "PRO.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amavala zilimbe",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.17",
            "verseOrgIds": [
              "PRO.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:17"
      },
      "items": [
        {
          "text": "nagwira ntchito mwamphamvu ndi manja ake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.17",
            "verseOrgIds": [
              "PRO.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amaona kuti malonda ake ndi aphindu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.18",
            "verseOrgIds": [
              "PRO.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:18"
      },
      "items": [
        {
          "text": "choncho nyale yake sizima usiku wonse.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.18",
            "verseOrgIds": [
              "PRO.31.18"
            ]
          }
        }
      ]
    },
    {
