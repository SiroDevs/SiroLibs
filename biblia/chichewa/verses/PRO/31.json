      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:21"
      },
      "items": [
        {
          "text": "pakuti onse amakhala atavala zovala zofunda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.21",
            "verseOrgIds": [
              "PRO.31.21"
            ]
          }
        }
      ]
    },
    {
