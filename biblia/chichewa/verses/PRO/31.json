      "attrs": {
        "style": "q2",
        "vid": "PRO 31:23"
      },
      "items": [
        {
          "text": "ndipo amakhala pakati pa akuluakulu a mʼdzikomo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.23",
            "verseOrgIds": [
              "PRO.31.23"
            ]
          }
        }
      ]
    },
    {
