      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:29"
      },
      "items": [
        {
          "text": "koma iwe umawaposa onsewa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.29",
            "verseOrgIds": [
              "PRO.31.29"
            ]
          }
        }
      ]
    },
