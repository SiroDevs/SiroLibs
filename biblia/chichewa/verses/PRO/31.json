          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mphamvu ndi ulemu zimakhala ngati chovala chake;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.25",
            "verseOrgIds": [
              "PRO.31.25"
            ]
