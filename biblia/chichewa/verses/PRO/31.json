      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:30"
      },
      "items": [
        {
          "text": "koma mkazi amene amaopa Yehova ayenera kutamandidwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.30",
            "verseOrgIds": [
              "PRO.31.30"
            ]
          }
