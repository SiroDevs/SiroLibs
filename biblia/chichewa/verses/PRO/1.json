        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi inu anthu osachangamukanu, mudzakondwera ndi kusachangamuka mpaka liti?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.22",
            "verseOrgIds": [
              "PRO.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:22"
      },
      "items": [
        {
          "text": "Nanga anthu onyogodola adzakondabe kunyogodola mpaka liti?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.22",
            "verseOrgIds": [
              "PRO.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:22"
      },
      "items": [
        {
          "text": "Kapena opusa adzadana ndi nzeru mpaka liti?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.22",
            "verseOrgIds": [
              "PRO.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamverani mawu anga a chidzudzulo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.23",
            "verseOrgIds": [
              "PRO.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:23"
      },
      "items": [
        {
          "text": "Ine ndikukuwuzani maganizo anga",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.23",
            "verseOrgIds": [
              "PRO.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:23"
      },
      "items": [
        {
          "text": "ndi kukudziwitsani mawu anga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.23",
            "verseOrgIds": [
              "PRO.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
