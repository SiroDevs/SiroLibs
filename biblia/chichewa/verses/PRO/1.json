  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "PRO 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawu Oyamba: Cholinga ndi Mutu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi ndi miyambi ya Solomoni mwana wa Davide, mfumu ya Israeli:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.1",
            "verseOrgIds": [
              "PRO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi yothandiza kuti munthu adziwe nzeru ndi malangizo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.2",
            "verseOrgIds": [
              "PRO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:2"
      },
      "items": [
        {
          "text": "kuti amvetse mawu a matanthauzo ozama;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.2",
            "verseOrgIds": [
              "PRO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti alandire malangizo othandiza kuti achite zinthu mwanzeru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.3",
            "verseOrgIds": [
              "PRO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:3"
      },
      "items": [
        {
          "text": "akhale wangwiro, wachilungamo ndiponso wosakondera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.3",
            "verseOrgIds": [
              "PRO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi yothandiza munthu wamba kuti aphunzire nzeru za kuchenjera,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.4",
            "verseOrgIds": [
              "PRO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:4"
      },
      "items": [
        {
          "text": "achinyamata kudziwa zinthu bwino ndi kulingalira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.4",
            "verseOrgIds": [
              "PRO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu wanzeru amvetse bwino miyamboyi kuti awonjezere kuphunzira kwake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.5",
            "verseOrgIds": [
              "PRO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:5"
      },
      "items": [
        {
          "text": "ndi munthu womvetsa zinthu bwino apatepo luso,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.5",
            "verseOrgIds": [
              "PRO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti azimvetsa miyambi ndi mafanizo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.6",
            "verseOrgIds": [
              "PRO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:6"
      },
      "items": [
        {
          "text": "mawu a anthu anzeru ndi mikuluwiko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.6",
            "verseOrgIds": [
              "PRO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuopa Yehova ndiye chiyambi cha nzeru.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.7",
            "verseOrgIds": [
              "PRO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:7"
      },
      "items": [
        {
          "text": "Zitsiru zimanyoza nzeru ndi malangizo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.7",
            "verseOrgIds": [
              "PRO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Malangizo kuti Asunge Nzeru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Malangizo kwa Achinyamata",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wanga, mvera malangizo a abambo ako",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.8",
            "verseOrgIds": [
              "PRO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:8"
      },
      "items": [
        {
          "text": "ndipo usakane mawu okuwongolera a amayi ako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.8",
            "verseOrgIds": [
              "PRO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali ngati sangamutu yokongola ya maluwa pamutu pako",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.9",
            "verseOrgIds": [
              "PRO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:9"
      },
      "items": [
        {
          "text": "ndiponso ali ngati mkanda mʼkhosi mwako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.9",
            "verseOrgIds": [
              "PRO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wanga, ngati anthu oyipa afuna kukukopa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.10",
            "verseOrgIds": [
              "PRO.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:10"
      },
      "items": [
        {
          "text": "usamawamvere.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.10",
            "verseOrgIds": [
              "PRO.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akadzati, \"Tiye kuno;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:11"
      },
      "items": [
        {
          "text": "tikabisale kuti tiphe anthu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:11"
      },
      "items": [
        {
          "text": "tikabisalire anthu osalakwa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "tiwameze amoyo ngati manda,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.12",
            "verseOrgIds": [
              "PRO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:12"
      },
      "items": [
        {
          "text": "ndi athunthu ngati anthu otsikira mʼdzenje.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.12",
            "verseOrgIds": [
              "PRO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motero tidzapeza zinthu zosiyanasiyana zamtengowapatali",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.13",
            "verseOrgIds": [
              "PRO.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:13"
      },
      "items": [
        {
          "text": "ndi kudzaza nyumba zathu ndi zolanda;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.13",
            "verseOrgIds": [
              "PRO.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwera, chita nafe maere,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.14",
            "verseOrgIds": [
              "PRO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:14"
      },
      "items": [
        {
          "text": "ndipo tidzagawana chuma chathu tonse.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.14",
            "verseOrgIds": [
              "PRO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wanga, usayende nawo pamodzi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.15",
            "verseOrgIds": [
              "PRO.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:15"
      },
      "items": [
        {
          "text": "usatsagane nawo mʼnjira zawozo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.15",
            "verseOrgIds": [
              "PRO.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwowatu amangofuna zoyipa zokhazokha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.16",
            "verseOrgIds": [
              "PRO.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:16"
      },
      "items": [
        {
          "text": "amathamangira kukhetsa magazi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.16",
            "verseOrgIds": [
              "PRO.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼkopanda phindu kutchera msampha",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.17",
            "verseOrgIds": [
              "PRO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:17"
      },
      "items": [
        {
          "text": "mbalame zikuona!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.17",
            "verseOrgIds": [
              "PRO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma anthu amenewa amangobisalira miyoyo yawo yomwe;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.18",
            "verseOrgIds": [
              "PRO.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:18"
      },
      "items": [
        {
          "text": "amangodzitchera okha msampha!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.18",
            "verseOrgIds": [
              "PRO.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
