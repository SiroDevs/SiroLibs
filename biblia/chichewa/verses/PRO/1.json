      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:20"
      },
      "items": [
        {
          "text": "ikuyankhula mokweza mawu mʼmisika;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.20",
            "verseOrgIds": [
              "PRO.1.20"
            ]
          }
        }
      ]
    },
    {
