      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:19"
      },
      "items": [
        {
          "text": "chumacho chimapha mwiniwake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.19",
            "verseOrgIds": [
              "PRO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Chenjezo Pomwe Tikana Nzeru",
          "type": "text"
        }
      ]
    },
    {
