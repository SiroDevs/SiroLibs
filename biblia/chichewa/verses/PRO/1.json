      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:32"
      },
      "items": [
        {
          "text": "ndipo zitsiru zimadziwononga zokha chifukwa cha mphwayi zawo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.32",
            "verseOrgIds": [
              "PRO.1.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
