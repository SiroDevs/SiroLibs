          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiye inenso ndidzakusekani mukadzakhala mʼmavuto;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.26",
            "verseOrgIds": [
              "PRO.1.26"
            ]
          }
        }
      ]
    },
