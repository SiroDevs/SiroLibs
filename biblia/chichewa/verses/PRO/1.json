      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:31"
      },
      "items": [
        {
          "text": "ndi kukhuta ndi ntchito zimene anachita kwa ena.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.31",
            "verseOrgIds": [
              "PRO.1.31"
            ]
          }
        }
      ]
    },
    {
