          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "popeza iwo sanasamale malangizo anga",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.30",
            "verseOrgIds": [
              "PRO.1.30"
            ]
          }
        }
      ]
