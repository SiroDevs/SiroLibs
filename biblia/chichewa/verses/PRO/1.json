          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzeru ikufuwula mu msewu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.20",
            "verseOrgIds": [
              "PRO.1.20"
            ]
          }
        }
      ]
    },
    {
