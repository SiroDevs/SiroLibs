      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:25"
      },
      "items": [
        {
          "text": "Kudzudzula kwanga simunakusamale.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.25",
            "verseOrgIds": [
              "PRO.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
