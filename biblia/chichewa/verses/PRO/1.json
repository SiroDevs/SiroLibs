          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono adzadya zipatso zoyenera mayendedwe awo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.31",
            "verseOrgIds": [
              "PRO.1.31"
            ]
          }
        }
      ]
    },
