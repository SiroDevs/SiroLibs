          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa ndiwo mathero a anthu opeza chuma mwankhanza;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.19",
            "verseOrgIds": [
              "PRO.1.19"
            ]
          }
        }
      ]
    },
