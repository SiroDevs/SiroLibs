          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti anthu osachangamuka amaphedwa chifukwa cha kusochera kwawo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.32",
            "verseOrgIds": [
              "PRO.1.32"
            ]
          }
        }
      ]
    },
