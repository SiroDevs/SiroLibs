          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza iwo anadana ndi chidziwitso",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.29",
            "verseOrgIds": [
              "PRO.1.29"
            ]
          }
