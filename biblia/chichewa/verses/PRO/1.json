          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwonongeko chikadzakugwerani ngati namondwe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.27",
            "verseOrgIds": [
              "PRO.1.27"
            ]
          }
        }
      ]
    },
