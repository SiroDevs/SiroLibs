          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma aliyense wondimvera adzakhala mwa bata;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.33",
            "verseOrgIds": [
              "PRO.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:33"
      },
      "items": [
        {
          "text": "adzakhala mosatekeseka posaopa chilichonse.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.33",
            "verseOrgIds": [
              "PRO.1.33"
            ]
          }
        }
      ]
