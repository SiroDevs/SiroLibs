      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:26"
      },
      "items": [
        {
          "text": "ndidzakunyogodolani chikadzakugwerani chimene mumachiopacho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.26",
            "verseOrgIds": [
              "PRO.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
