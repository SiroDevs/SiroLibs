          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza ndinakuyitanani koma inu munakana kumvera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.24",
            "verseOrgIds": [
              "PRO.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:24"
      },
      "items": [
        {
          "text": "Ndinayesa kukuthandizani koma panalibe amene anasamala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.24",
            "verseOrgIds": [
              "PRO.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uphungu wanga munawunyoza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.25",
            "verseOrgIds": [
              "PRO.1.25"
            ]
          }
        }
      ]
    },
