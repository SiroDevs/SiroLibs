      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:29"
      },
      "items": [
        {
          "text": "ndipo sanasankhe kuopa Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.29",
            "verseOrgIds": [
              "PRO.1.29"
            ]
          }
        }
      ]
    },
