      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:28"
      },
      "items": [
        {
          "text": "mudzandifunafuna, koma simudzandipeza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.28",
            "verseOrgIds": [
              "PRO.1.28"
            ]
          }
        }
      ]
    },
    {
