          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikufuwula pa mphambano ya misewu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.21",
            "verseOrgIds": [
              "PRO.1.21"
            ]
          }
        }
      ]
    },
