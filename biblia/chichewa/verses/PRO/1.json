      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:21"
      },
      "items": [
        {
          "text": "ikuyankhula pa zipata za mzinda kuti,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.21",
            "verseOrgIds": [
              "PRO.1.21"
            ]
          }
        }
      ]
    },
    {
