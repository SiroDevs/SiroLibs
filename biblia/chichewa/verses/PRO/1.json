      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:27"
      },
      "items": [
        {
          "text": "tsoka likadzakufikirani ngati kamvuluvulu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.27",
            "verseOrgIds": [
              "PRO.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:27"
      },
      "items": [
        {
          "text": "mavuto ndi masautso akadzakugwerani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.27",
            "verseOrgIds": [
              "PRO.1.27"
            ]
          }
        }
      ]
    },
