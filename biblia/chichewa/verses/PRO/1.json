          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsono mudzandiyitana koma sindidzayankha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.28",
            "verseOrgIds": [
              "PRO.1.28"
            ]
          }
        }
      ]
    },
