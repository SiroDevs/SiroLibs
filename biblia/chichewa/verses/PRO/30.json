  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "PRO 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawu a Aguri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawa mawu a Aguri mwana wa Yake wa ku Masa:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.1",
            "verseOrgIds": [
              "PRO.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:1"
      },
      "items": [
        {
          "text": "Munthuyo anati kwa Itieli, \"Inu Mulungu, ine ndatopa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.1",
            "verseOrgIds": [
              "PRO.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:1"
      },
      "items": [
        {
          "text": "Inu Mulungu, ine ndatopa. Ndalefukiratu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.1",
            "verseOrgIds": [
              "PRO.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ine ndine munthu wopusa kuposa anthu onse;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.2",
            "verseOrgIds": [
              "PRO.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:2"
      },
      "items": [
        {
          "text": "ndilibe nzeru zomvetsa zinthu zonga za munthu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.2",
            "verseOrgIds": [
              "PRO.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sindinaphunzire nzeru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.3",
            "verseOrgIds": [
              "PRO.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:3"
      },
      "items": [
        {
          "text": "ndipo Woyerayo sindimudziwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.3",
            "verseOrgIds": [
              "PRO.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ndani anakwera kumwamba ndi kutsikako?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Ndani anafumbatapo mphepo mʼmanja mwake?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Ndani anamanga madzi mʼchovala chake?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Ndani anakhazikitsa mathero onse a dziko lapansi?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Dzina lake ndani? Ndiwuze ngati ukudziwa!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Ndipo mwana wake dzina lake ndani?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mawu ali wonse a Mulungu ndi opanda cholakwika;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.5",
            "verseOrgIds": [
              "PRO.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:5"
      },
      "items": [
        {
          "text": "Iye ndi chishango kwa amene amathawira kwa Iye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.5",
            "verseOrgIds": [
              "PRO.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usawonjezepo kanthu pa mawu ake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.6",
            "verseOrgIds": [
              "PRO.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:6"
      },
      "items": [
        {
          "text": "kuopa kuti Iye angadzakudzudzule ndi kukupeza kuti ndiwe wabodza.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.6",
            "verseOrgIds": [
              "PRO.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inu Yehova, ndikukupemphani zinthu ziwiri",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.7",
            "verseOrgIds": [
              "PRO.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:7"
      },
      "items": [
        {
          "text": "musandimane zimenezo ndisanafe:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.7",
            "verseOrgIds": [
              "PRO.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choyamba, mundichotsere kutali nane mabodza ndi chinyengo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:8"
      },
      "items": [
        {
          "text": "Chachiwiri, ndisakhale mʼmphawi kapena munthu wachuma.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:8"
      },
      "items": [
        {
          "text": "Koma muzindidyetsa chakudya chondikwanira tsiku ndi tsiku",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuopa kuti ndikakhuta kwambiri ndingayambe kukukanani,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "nʼkumanena kuti, 'Yehova ndiye yaninso?'",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "Kuopanso kuti ndikakhala wosauka ndingayambe kuba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "potero nʼkuyipitsa dzina la Mulungu wanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Usamusinjirire wantchito kwa mbuye wake",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.10",
            "verseOrgIds": [
              "PRO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:10"
      },
      "items": [
        {
          "text": "kuopa kuti angakutemberere ndipo iweyo nʼkupezeka wolakwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.10",
            "verseOrgIds": [
              "PRO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Alipo ena amene amatemberera abambo awo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.11",
            "verseOrgIds": [
              "PRO.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:11"
      },
      "items": [
        {
          "text": "ndipo sadalitsa amayi awo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.11",
            "verseOrgIds": [
              "PRO.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pali ena amene amadziyesa okha oyera mtima",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.12",
            "verseOrgIds": [
              "PRO.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:12"
      },
      "items": [
        {
          "text": "komatu sanachotse zoyipa zawo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.12",
            "verseOrgIds": [
              "PRO.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pali ena ndi odzitukumula kwambiri,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.13",
            "verseOrgIds": [
              "PRO.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:13"
      },
      "items": [
        {
          "text": "amene amakweza zikope modzitukumula.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.13",
            "verseOrgIds": [
              "PRO.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pali ena amene mano awo ali ngati malupanga",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:14"
      },
      "items": [
        {
          "text": "ndipo zibwano zawo zili ngati mipeni",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:14"
      },
      "items": [
        {
          "text": "moti amadya amphawi ndi kuwachotsa pa dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:14"
      },
      "items": [
        {
          "text": "Amachotsanso anthu osauka pakati pa anzawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
