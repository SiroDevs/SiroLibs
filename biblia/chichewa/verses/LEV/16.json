  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "LEV 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tsiku la Mwambo Wopepesera Machimo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atafa ana awiri a Aaroni amene anaphedwa atapita pamaso pa Yehova mosayenera, Yehova anayankhula ndi Mose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.1",
            "verseOrgIds": [
              "LEV.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anawuza Mose kuti, \"Uza mchimwene wako Aaroni kuti asamalowe ku Malo Wopatulika, kuseri kwa katani, pamaso pa chivundikiro cha Bokosi la Chipangano nthawi iliyonse imene akufuna kuopa kuti angadzafe, pakuti Ine ndimaoneka mu mtambo umene uli pamwamba pa chivundikiro cha Bokosi la Chipangano.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.2",
            "verseOrgIds": [
              "LEV.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aaroni azilowa Malo Wopatulika Kwambiri motere: azitenga mwana wangʼombe wamwamuna kuti akhale nsembe yopepesera machimo ndi nkhosa yayimuna kuti ikhale nsembe yopsereza.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.3",
            "verseOrgIds": [
              "LEV.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azivala mwinjiro wopatulika wa nsalu yosalala, azivalanso kabudula wa mʼkati wa nsalu yosalala, azimanga lamba wa nsalu yosalala, ndipo avalenso nduwira ya nsalu yosalala kumutu. Zimenezi ndi nsalu zopatulika ndipo atasamba thupi lonse azivala zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.4",
            "verseOrgIds": [
              "LEV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchokera pa gulu la Aisraeli, Aaroni azitenga mbuzi zazimuna ziwiri kuti zikhale nsembe yopepesera machimo ndi nkhosa yayimuna kuti ikhale nsembe yopsereza.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.5",
            "verseOrgIds": [
              "LEV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aaroni apereke ngʼombe yayimuna kuti ikhale yopepesera machimo a iye mwini kuti achite mwambo wopepesera machimo ake pamodzi ndi a banja lake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.6",
            "verseOrgIds": [
              "LEV.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka atenge mbuzi ziwiri zija ndipo aziyimike pamaso pa Yehova pa khomo la tenti ya msonkhano.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.7",
            "verseOrgIds": [
              "LEV.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni ndiye achite maere pa mbuzi ziwirizo kuti imodzi ikhale ya Yehova, ndipo inayo ikhale ya Azazele.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.8",
            "verseOrgIds": [
              "LEV.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni abwere ndi mbuzi imene maere aonetsa kuti ndi ya Yehova, ndipo apereke kuti ikhale nsembe yopereka chifukwa cha tchimo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.9",
            "verseOrgIds": [
              "LEV.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mbuzi imene maere aonetsa kuti ndi yosenza machimo, apereke ya moyo pamaso pa Yehova, kuti achite mwambo wopepesera machimo pa mbuziyo poyitumiza ku chipululu kuti ikhale ya Azazele.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.10",
            "verseOrgIds": [
              "LEV.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aaroni apereke ngʼombe yayimuna kuti ikhale nsembe yopepesera machimo ake. Ndiye achite mwambo wopepesera machimo a iye mwini wake pamodzi ndi banja lake. Pambuyo pake aphe ngʼombe yopepesera machimo ake aja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.11",
            "verseOrgIds": [
              "LEV.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka iye atenge chofukizira chodzaza ndi makala a moto ochokera pa guwa lansembe pamaso pa Yehova. Atengenso lubani wonunkhira ndi woperapera wokwanira manja awiri, ndipo alowe naye kuseri kwa katani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.12",
            "verseOrgIds": [
              "LEV.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athire lubani pa moto pamaso pa Yehova kuti utsi wa lubaniyo uphimbe chivundikiro chimene chili pamwamba pa Bokosi la Chipangano, kuti Aaroniyo asafe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.13",
            "verseOrgIds": [
              "LEV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo atenge magazi ena a ngʼombeyo, awawaze ndi chala chake pa chivundikiro cha kummawa; kenaka awaze magaziwo ndi chala chake kasanu ndi kawiri patsogolo pa chivundikirocho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.14",
            "verseOrgIds": [
              "LEV.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kenaka Aaroni aphe mbuzi ya nsembe yopepesera machimo a anthu, ndipo magazi ake alowe nawo kuseri kwa katani ndi kuchita chimodzimodzi monga anachitira ndi magazi a ngʼombe aja: Aaroni awaze magaziwo pa chivundikiro chija ndi patsogolo pa chivundikirocho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.15",
            "verseOrgIds": [
              "LEV.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo ndiye kuti wansembeyo wachita mwambo wopepesera ku Malo Wopatulika chifukwa cha kudetsedwa ndi kuwukira kwa Aisraeli pa machimo ena aliwonse amene achita. Achite chimodzimodzi ndi tenti ya msonkhano imenenso ili yodetsedwa chifukwa cha machimo awo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.16",
            "verseOrgIds": [
              "LEV.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tenti ya msonkhano musakhale munthu ndi mmodzi yemwe nthawi imene Aaroni akupita kukachita mwambo wopepesera ku Malo Wopatulika mpaka atatulukako. Musakhale munthu mu tenti ya msonkhano mpaka atachita mwambo wopepesera machimo a iye mwini wake, banja lake ndi gulu lonse la Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.17",
            "verseOrgIds": [
              "LEV.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kenaka, Aaroniyo akatuluka apite ku guwa limene lili pamaso pa Yehova ndi kulichitira mwambo wolipepesera. Atengeko magazi a ngʼombe yayimuna ndiponso magazi a mbuzi ndi kuwapaka pa nyanga zonse za guwa lansembe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.18",
            "verseOrgIds": [
              "LEV.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magazi ena awawaze pa guwalo ndi chala chake kasanu ndi kawiri kuliyeretsa ndi kulipatula kuchotsa zodetsa za Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.19",
            "verseOrgIds": [
              "LEV.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aaroni akatsiriza mwambo wopepesera Malo Wopatulika, tenti ya msonkhano ndi guwa, azibwera ndi mbuzi yamoyo kudzayipereka nsembe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.20",
            "verseOrgIds": [
              "LEV.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni asanjike manja ake pa mutu wa mbuziyo ndipo awulule pa mbuziyo zoyipa zonse ndi zowukira zonse za Aisraeli, kutanthauza machimo awo onse. Machimowo awayike pa mutu wa mbuziyo. Kenaka munthu amene anasankhidwa athamangitsire mbuziyo ku chipululu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.21",
            "verseOrgIds": [
              "LEV.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuziyo isenze machimo awo onse ndi kupita nawo kutali ndipo munthuyo aleke mbuziyo kuti ipite ku chipululuko.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.22",
            "verseOrgIds": [
              "LEV.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pambuyo pake Aaroni alowe mu tenti ya msonkhano ndi kuvula zovala zosalala zija zimene anavala polowa ku Malo Wopatulika ndi kuzisiya komweko.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.23",
            "verseOrgIds": [
              "LEV.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asambe thupi lonse ku Malo Wopatulika ndi kuvala zovala zake za nthawi zonse. Kenaka atuluke ndi kukapereka nsembe yopsereza ya iye mwini, ndiponso nsembe yopsereza yoperekera anthu. Akatero ndiye kuti wachita mwambo wopepesera machimo a iye mwini wake ndi a anthu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.24",
            "verseOrgIds": [
              "LEV.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuta a nyama yopepesera machimo awatenthe pa guwa lansembe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.25",
            "verseOrgIds": [
              "LEV.16.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsono munthu amene anaperekeza mbuzi yosenza machimo ija achape zovala zake ndi kusamba. Pambuyo pake alowe ku msasa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.26",
            "verseOrgIds": [
              "LEV.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼombe ndi mbuzi zoperekera nsembe yopepesera machimo zimene magazi ake anabwera nawo kuti achitire mwambo wopepesera Malo Wopatulika, azitulutsire kunja kwa msasa. Koma zikopa zake, nyama yake ndi matumbo ake azitenthe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.27",
            "verseOrgIds": [
              "LEV.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu amene azitenthe achape zovala zake ndi kusamba. Pambuyo pake alowe mu msasa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.28",
            "verseOrgIds": [
              "LEV.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ili likhale lamulo lanu lamuyaya: Mwezi wachisanu ndi chiwiri, pa tsiku la khumi la mwezi, mugonje pamaso pa Yehova. Musamagwire ntchito iliyonse, kaya ndinu mbadwa kapena mlendo amene akukhala pakati panu,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "chifukwa tsiku limeneli kudzachitika mwambo wopepesera machimo anu, kukuyeretsani kuti mukhale oyeretsedwa ku machimo anu pamaso pa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Limeneli ndi tsiku lanu la Sabata lopumula, ndipo muzigonja pamaso pa Yehova. Limeneli ndi lamulo lanu la muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wansembe amene wadzozedwa ndi kupatulidwa kuti akhale wansembe kulowa mʼmalo mwa abambo ake ndiye azichita mwambo wopepesera machimo atavala zovala zake zosalala ndi zopatulika.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adzachite mwambo wopepesera machimo Malo Wopatulika, tenti ya msonkhano ndi guwa lansembe. Adzachitenso mwambo wopepesera anzake ndi gulu lonse la anthu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ili likhale lamulo lanu lamuyaya. Mwambo wopepesera machimo uzichitika kamodzi pa chaka chifukwa cha machimo a anthu onse.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 16:34"
      },
      "items": [
        {
          "text": "Ndipo Mose anachita monga momwe Yehova analamulira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
