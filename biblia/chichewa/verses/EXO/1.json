  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "EXO 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aisraeli Azunzidwa ku Igupto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa ndi mayina a ana a Israeli amene anapita ku Igupto pamodzi ndi Yakobo abambo awo, aliyense ndi banja lake:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.1",
            "verseOrgIds": [
              "EXO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rubeni, Simeoni, Levi, Yuda;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.2",
            "verseOrgIds": [
              "EXO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isakara, Zebuloni, Benjamini;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.3",
            "verseOrgIds": [
              "EXO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dani, Nafutali; Gadi ndi Aseri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.4",
            "verseOrgIds": [
              "EXO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu onse obadwa mwa Yakobo analipo 70. Yosefe nʼkuti ali kale ku Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.5",
            "verseOrgIds": [
              "EXO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Yosefe ndi abale ake onse ndiponso mʼbado wawo wonse anamwalira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.6",
            "verseOrgIds": [
              "EXO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Aisraeli anaberekana ndi kuchuluka kwambiri nakhala amphamvu kwambiri, kotero kuti anadzaza dzikolo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.7",
            "verseOrgIds": [
              "EXO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake mfumu yatsopano imene sinkamudziwa Yosefe, inayamba kulamulira dziko la Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.8",
            "verseOrgIds": [
              "EXO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo inati kwa anthu ake, \"Taonani, Aisraeli achuluka ndipo ndi amphamvu kwambiri kuposa ife.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.9",
            "verseOrgIds": [
              "EXO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyeni tiwachenjerere. Tikapanda kutero adzachuluka kuposa ife, ndipo ngati kutakhala nkhondo, adzadziphatika kwa adani athu nadzamenyana nafe, kenaka nʼkudzachoka mʼdziko muno.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.10",
            "verseOrgIds": [
              "EXO.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero anayika akapitawo kuti aziwazunza ndi kuwagwiritsa ntchito yolemetsa mokakamiza. Iwo anamangira Farao mizinda ya Pitomu ndi Ramesesi kumene ankasungirako chakudya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.11",
            "verseOrgIds": [
              "EXO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma pamene ankawazunza kwambiri, Aisraeli ndiye ankachulukirachulukira mpaka kubalalikira mʼdziko lonse. Kotero Aigupto anayamba kuopa Aisraeliwo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.12",
            "verseOrgIds": [
              "EXO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo anawagwiritsa ntchito mwankhanza kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.13",
            "verseOrgIds": [
              "EXO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aigupto anachititsa moyo wa Aisraeli kukhala owawa kwambiri powagwiritsa ntchito yakalavulagaga yowumba njerwa ndi kuponda dothi lomangira, pamodzi ndi ntchito zina zosiyanasiyana zamʼminda. Iwo anakakamiza Aisraeli mwankhanza kuti agwire ntchito yowawayi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.14",
            "verseOrgIds": [
              "EXO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Azamba Akana Kumvera Mfumu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu ya Igupto inati kwa azamba a Chihebri omwe mayina awo anali Sifira ndi Puwa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.15",
            "verseOrgIds": [
              "EXO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mukamathandiza amayi a Chihebri pa mwala wochirira, muzionetsetsa kuti akabadwa mwana wamwamuna muzipha, koma akakhala wamkazi muzimuleka akhale ndi moyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.16",
            "verseOrgIds": [
              "EXO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma azambawo ankaopa Mulungu ndipo sanachite zimene mfumu ya Igupto inawawuza kuti achite. Iwo analeka ana aamuna kuti akhale ndi moyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.17",
            "verseOrgIds": [
              "EXO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka mfumu ya Igupto inayitanitsa azamba aja ndi kuwafunsa kuti, \"Chifukwa chiyani mwachita zimenezi? Bwanji mwasiya ana aamuna kuti akhale ndi moyo?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.18",
            "verseOrgIds": [
              "EXO.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azambawo anamuyankha Farao kuti, \"Amayi a Chihebri sali ngati amayi a Chiigupto; Iwo ndi amphamvu ndipo amachira azamba asanafike.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.19",
            "verseOrgIds": [
              "EXO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero Mulungu anawakomera mtima azambawo, ndipo Aisraeli anapitirirabe kuchulukana nakhala amphamvu kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.20",
            "verseOrgIds": [
              "EXO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti azambawo ankaopa Mulungu, Iye anawapatsa mabanja awoawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.21",
            "verseOrgIds": [
              "EXO.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Farao analamulira anthu ake onse kuti, \"Mwana wamwamuna aliyense akabadwa, mukamuponye mu mtsinje wa Nailo, koma wamkazi mulekeni akhale ndi moyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.22",
            "verseOrgIds": [
              "EXO.1.22"
            ]
          }
        }
      ]
    }
  ],
