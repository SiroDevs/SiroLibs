  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "EXO 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zopereka Zomangira Chihema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ananena kwa Mose kuti,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.1",
            "verseOrgIds": [
              "EXO.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uza Aisraeli kuti abweretse chopereka kwa Ine. Iwe ulandire choperekacho mʼmalo mwanga kuchokera kwa munthu amene akupereka mwakufuna kwake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.2",
            "verseOrgIds": [
              "EXO.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zopereka zimene ulandire kwa anthuwo ndi izi: Golide, siliva ndi mkuwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.3",
            "verseOrgIds": [
              "EXO.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsalu zobiriwira, zapepo, zofiira, nsalu zofewa, ubweya wambuzi;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.4",
            "verseOrgIds": [
              "EXO.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "zikopa za nkhosa zazimuna za utoto wofiira ndi zikopa za akatumbu; matabwa amtengo wa mkesha;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.5",
            "verseOrgIds": [
              "EXO.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mafuta anyale a olivi, zonunkhiritsa mafuta odzozera ndi zopangira lubani wonunkhira;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.6",
            "verseOrgIds": [
              "EXO.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "miyala yokongola ya mtundu wa onikisi ndi ina yabwino yoyika pa efodi ndi pa chovala cha pachifuwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.7",
            "verseOrgIds": [
              "EXO.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwo andipangire malo wopatulika, ndipo Ine ndidzakhala pakati pawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.8",
            "verseOrgIds": [
              "EXO.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umange chihema ndiponso ziwiya zamʼkatimo monga momwe Ine ndidzakuonetsere.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.9",
            "verseOrgIds": [
              "EXO.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bokosi la Chipangano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsono apange bokosi lamatabwa amtengo wa mkesha, ndipo kutalika kwake kukhale masentimita 114, mulifupi mwake masentimita 69, msinkhu wake masentimita 69.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.10",
            "verseOrgIds": [
              "EXO.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokosilo ulikute ndi golide wabwino kwambiri, mʼkati mwake ndi kunja komwe, ndipo upange mkombero wagolide kuzungulira bokosilo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.11",
            "verseOrgIds": [
              "EXO.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upange mphete zinayi zagolide ndipo uzimangirire ku miyendo yake inayi ya bokosilo, mbali ina ziwiri ndi mbali inanso ziwiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.12",
            "verseOrgIds": [
              "EXO.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka upange mizati yamtengo wa mkesha ndi kuzikuta ndi golide.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.13",
            "verseOrgIds": [
              "EXO.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ulowetse nsichizo mʼmphete zija za mbali zonse ziwiri za bokosilo kuti azinyamulira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.14",
            "verseOrgIds": [
              "EXO.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsichizo zizikhala mʼmphete za bokosilo nthawi zonse, zisamachotsedwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.15",
            "verseOrgIds": [
              "EXO.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo udzayike mʼbokosilo miyala iwiri yolembedwapo malamulo imene Ine ndidzakupatse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.16",
            "verseOrgIds": [
              "EXO.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Upange chivundikiro cha bokosilo cha golide wabwino kwambiri, kutalika kwake masentimita 114, mulifupi mwake masentimita 69.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.17",
            "verseOrgIds": [
              "EXO.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo upange Akerubi awiri agolide osula ndi nyundo, uwayike mbali ziwiri za chivundikirocho,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.18",
            "verseOrgIds": [
              "EXO.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kerubi mmodzi mbali ina ndi wina mbali inayo. Akerubiwa uwapangire limodzi ndi chivundikirocho mʼmapeto mwa mbali ziwirizo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.19",
            "verseOrgIds": [
              "EXO.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapiko a Akerubiwo adzatambasukire pamwamba pa chivundikiro cha bokosilo kuti achiphimbe. Akerubiwo adzakhale choyangʼanana, aliyense kuyangʼana chivundikirocho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.20",
            "verseOrgIds": [
              "EXO.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyike chivundikirocho pamwamba pa bokosi ndipo mʼbokosilo uyikemo miyala ya malamulo, imene ndidzakupatse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.21",
            "verseOrgIds": [
              "EXO.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndizidzakumana nawe pamenepo, pamwamba pa chivundikiro cha bokosilo, pakati pa Akerubi awiriwo, ndikumadzakupatsa malamulo onse okhudzana ndi Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.22",
            "verseOrgIds": [
              "EXO.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tebulo la Buledi Woperekedwa kwa Mulungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Upange tebulo la matabwa amtengo wa mkesha, mulitali mwake masentimita 91, mulifupi mwake masentimita 46, msinkhu wake masentimita 69.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.23",
            "verseOrgIds": [
              "EXO.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tebulolo ulikute ndi golide wabwino kwambiri ndipo upange mkombero wagolide mʼmbali mwake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.24",
            "verseOrgIds": [
              "EXO.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upange feremu yozungulira tebulo, mulifupi mwake ngati chikhatho cha dzanja, ndipo uyike mkombero wagolide kuzungulira feremuyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.25",
            "verseOrgIds": [
              "EXO.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upange mphete zinayi zagolide, ndipo uzilumikize ku ngodya zake zinayi, kumene kuli miyendo yake inayi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.26",
            "verseOrgIds": [
              "EXO.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mphetezo uziyike kufupi ndi feremu kuti azikolowekamo nsichi zonyamulira tebuloyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.27",
            "verseOrgIds": [
              "EXO.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upange nsichi zamtengo wa mkesha ndi kuzikuta ndi golide kuti azinyamulira tebulolo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.28",
            "verseOrgIds": [
              "EXO.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upange mbale ndi zipande zagolide wabwino, pamodzinso ndi mitsuko ndi mabeseni zogwiritsa ntchito popereka nsembe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.29",
            "verseOrgIds": [
              "EXO.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tebulopo uyikepo buledi woperekedwa kosalekeza, kuti azikhala pamaso panga nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.30",
            "verseOrgIds": [
              "EXO.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Choyikapo Nyale",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Upange choyikapo nyale chagolide wabwino kwambiri. Tsinde lake ndi mphanda zake zikhale zosulidwa ndi nyundo. Zikho zake zokhala ndi mphukira ndi maluwa ake zipangidwire kumodzi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.31",
            "verseOrgIds": [
              "EXO.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmbali mwake mukhale mphanda zisanu ndi imodzi, zitatu mbali iliyonse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.32",
            "verseOrgIds": [
              "EXO.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zikho zitatu zokhala ngati za maluwa amtowo, mphukira ndi duwa zikhale pa mphanda yoyamba. Pa mphanda yachiwiri pakhalenso zikho zitatu zokhala ngati za maluwa amtowo, mphukira ndi duwa. Ndipo mphanda zonse zisanu ndi imodzi zikhale chimodzimodzi ndipo zituluke mʼchoyikapo nyalecho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.33",
            "verseOrgIds": [
              "EXO.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa choyikapo nyalecho pakhale zikho zinayi zopangidwa ngati maluwa amtowo ali ndi mphukira ndi maluwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.34",
            "verseOrgIds": [
              "EXO.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mphukira yoyamba ikhale mʼmunsi mwa nthambi ziwiri zoyamba za pa choyikapo nyale. Mphukira yachiwiri ikhale mʼmunsi mwa nthambi ziwiri zinazo. Ndipo mphukira yachitatu ikhale mʼmunsi mwa nthambi zina ziwirinso. Zonse pamodzi zikhale nthambi zisanu ndi imodzi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.35",
            "verseOrgIds": [
              "EXO.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mphukira ndi nthambi zonse zisulidwe kumodzi ndi choyikapo nyalecho ndi golide wabwino kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.36",
            "verseOrgIds": [
              "EXO.25.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndipo upange nyale zisanu ndi ziwiri ndi kuziyika pa choyikapo nyalecho kuti ziwunikire kutsogolo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.37",
            "verseOrgIds": [
              "EXO.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaniro ndi zowolera phulusa zikhale zagolide wabwino kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.38",
            "verseOrgIds": [
              "EXO.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choyikapo nyale ndi zipangizo zonse zipangidwe ndi golide wabwino kwambiri wolemera makilogalamu 34.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.39",
            "verseOrgIds": [
              "EXO.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwonetsetse kuti wapanga zonse monga momwe ndikukuonetsera pa phiri pano.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.40",
            "verseOrgIds": [
              "EXO.25.40"
            ]
          }
        }
      ]
    }
  ],
