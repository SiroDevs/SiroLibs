        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Anthu Omanga Makoma a Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake Eliyasibu mkulu wa ansembe ndi ansembe anzake anayamba kugwira ntchito ndipo anamanganso Chipata cha Nkhosa. Iwo anachipatulira Mulungu ndipo anayika zitseko zake. Khoma limene analipatula linafika mpaka pa Nsanja ya Zana ndi Nsanja ya Hananeli.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.1",
            "verseOrgIds": [
              "NEH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a ku Yeriko anamanga chigawo china pambali pake ndipo Zakuri mwana wa Imuri anamanga chigawo chinanso choyandikana nawo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipata cha Nsomba chinamangidwanso ndi ana a fuko la Hasena. Iwo anayika mitanda yake ndi zitseko, zotsekera zake, ndi mipiringidzo yake.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meremoti mwana wa Uriya, mwana wa Hakozi, anakonza chigawo choyandikana nacho. Motsatana naye, Mesulamu mwana wa Berekiya, mwana wa Mesezabeli anakonza chigawo china. Pambali pake, Zadoki mwana wa Baana anakonzanso chigawo china.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.4",
            "verseOrgIds": [
              "NEH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambali pa iwowa anthu a ku Tekowa anakonza chigawo china. Koma wolemekezeka awo anakana kugwira ntchito imene akuluakulu awo anawapatsa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipata cha Yesana chinakonzedwa ndi Yoyada mwana wa Paseya ndi Mesulamu mwana wa Besodeya. Iwo anayika mitanda yake ndi kuyika zitseko, zotsekera zake ndi mipiringidzo yake.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.6",
            "verseOrgIds": [
              "NEH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambali pawo Melatiya Mgibeyoni ndi Yadoni Mmerenoti ndiponso anthu a ku Gibiyoni ndi a ku Mizipa anakonza chigawo chawo mpaka ku nyumba ya bwanamkubwa wa chigawo cha Patsidya pa Yufurate.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.7",
            "verseOrgIds": [
              "NEH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambali pawo Uzieli mwana wa Harihaya wa mʼgulu amisiri osula golide anakonzanso chigawo china. Pambali pake Hananiya mmodzi mwa anthu oyenga mafuta onunkhira, anakonzanso chigawo china. Iwo anakonzanso Yerusalemu mpaka ku Khoma Lotambasuka.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.8",
            "verseOrgIds": [
              "NEH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Refaya mwana wa Huri wolamulira theka la chigawo cha Yerusalemu anakonza chigawo china motsatana nawo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.9",
            "verseOrgIds": [
              "NEH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulumikiza ichi, Yedaya mwana wa Harumafi anakonza chigawo choyangʼanana ndi nyumba yake, ndipo Hatusi mwana wa Hasabaneya anakonzanso motsatana naye.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.10",
            "verseOrgIds": [
              "NEH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malikiya mwana wa Harimu ndi Hasubu mwana wa Pahati-Mowabu anakonzanso chigawo china ndiponso Nsanja ya Ngʼanjo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.11",
            "verseOrgIds": [
              "NEH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salumu mwana wa Halohesi wolamulira theka la chigawo cha Yerusalemu, anakonzanso chigawo chotsatana nawo mothandizidwa ndi ana ake akazi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
            "verseOrgIds": [
              "NEH.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipata cha ku chigwa chinakonzedwa ndi Hanuni ndi anthu okhala ku Zanowa. Iwo anachimanganso ndi kuyika zitseko zake ndi zotsekera ndi mipiringidzo yake. Iwo anakonzanso khoma lotalika mamita 450 mpaka ku Chipata cha Zinyalala.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipata cha Zinyalala chinakonzedwa ndi Malikiya mwana wa Rekabu, wolamulira chigawo cha Beti-Hakeremu. Iye anachimanganso ndi kuyika zitseko zake, zotsekera zake ndi mipiringidzo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipata cha Kasupe chinakonzedwa ndi Saluni mwana wa Koli-Hoze, wolamulira chigawo cha Mizipa. Iye anachimanganso ndi kuyikanso denga ndiponso zitseko, zotsekera ndi mipiringidzo yake. Iye anakonzanso khoma la Dziwe la Siloamu limene lili pafupi ndi munda wa mfumu mpaka ku makwerero otsikira potuluka mzinda wa Davide.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambali pa iyeyo, Nehemiya mwana wa Azibuki, wolamulira theka la chigawo cha Beti Zuri anakonza chigawo china mpaka kumalo oyangʼanana ndi manda a Davide, mpaka ku dziwe lokumba ndi ku nyumba ya anthu ankhondo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambali pake Alevi anakonza chigawo china, ndipo mtsogoleri wawo anali Rehumi mwana wa Bani. Pambali pa iye Hasabiya wolamulira theka la chigawo cha Keyila anagwira ntchito ku chigawo chake.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.17",
            "verseOrgIds": [
              "NEH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pa iyeyu abale awo anapitiriza kukonza, ndipo mtsogoleri wawo anali Bawai mwana wa Henadadi, wolamulira theka lina la chigawo cha Keyila.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.18",
            "verseOrgIds": [
              "NEH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motsatana naye Ezeri mwana wa Yesuwa, wolamulira Mizipa anakonza chigawo chinanso choyangʼanana ndi chikweza chofikira ku nyumba yosungira zida za nkhondo pa ngodya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.19",
            "verseOrgIds": [
              "NEH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motsatana naye, Baruki mwana wa Zakai anakonzanso chigawo china kuchokera pa ngodya mpaka pa chitseko cha nyumba ya Eliyasibu mkulu wa ansembe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.20",
            "verseOrgIds": [
              "NEH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motsatana naye, Meremoti mwana wa Uriya, mwana wa Hakozi anakonzanso chigawo china kuchokera ku chitseko cha nyumba ya Eliyasibu mpaka kumapeto kwake.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
              "NEH.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake ansembe okhala ku chidikha anakonzanso chigawo china.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.22",
            "verseOrgIds": [
              "NEH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pawo, Benjamini ndi Hasubu anakonza kutsogolo kwa nyumba zawo. Ndipo motsatana nawo, Azariya mwana wa Maaseya mwana wa Ananiya, anakonza chigawo choyangʼanana ndi nyumba zawo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.23",
            "verseOrgIds": [
              "NEH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motsatana naye, Binuyi mwana wa Henadadi anakonzanso chigawo china, kuchokera pa nyumba ya Azariya kukafika potsirizira pa ngodya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.24",
            "verseOrgIds": [
              "NEH.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palali mwana Uzai anakonza chigawo china choyangʼanana ndi ngodya ndi nsanja yotuluka pa nyumba yapamwamba ya mfumu ku bwalo la alonda. Motsatana naye, Pedaya mwana wa Parosi,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.25",
            "verseOrgIds": [
              "NEH.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndi otumikira mʼNyumba ya Mulungu amene amakhala pa khoma la Ofeli anakonza chigawo china mpaka pa malo oyangʼanana ndi Chipata cha Madzi kuloza kummawa ndiponso nsanja yayitali ija.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motsatana nawo, anthu a ku Tekowa anakonzanso chigawo china choyangʼanana ndi nsanja ija yayikulu ndi yayitali mpaka ku khoma la Ofeli.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
            "verseOrgIds": [
              "NEH.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyambira ku Chipata cha Akavalo anakonza ndi ansembe ena ndipo aliyense amakonza khoma loyangʼanana ndi nyumba yake.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.28",
            "verseOrgIds": [
              "NEH.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
