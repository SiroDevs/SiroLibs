          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku Yesuwa, Molada, Beti-Peleti,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.26",
            "verseOrgIds": [
              "NEH.11.26"
