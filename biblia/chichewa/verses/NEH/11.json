              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku Eni-Rimoni, Zora, Yarimuti,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.29",
            "verseOrgIds": [
              "NEH.11.29"
            ]
          }
        },
