          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zanowa, Adulamu ndi midzi yake, ku Lakisi ndi minda yake, ku Beeriseba mpaka ku chigwa cha Hinomu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.30",
            "verseOrgIds": [
              "NEH.11.30"
            ]
          }
        }
