          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Esau anali ndi zaka 40, anakwatira Yuditi mwana wamkazi wa Beeri Mhiti. Anakwatiranso Basemati mwana wa mkazi wa Eloni Mhiti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
          }
