          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmawa wake aliyense analumbira pangano kwa mnzake. Tsono Isake anawalola kuti anyamuke ndipo anamusiya mu mtendere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.31",
            "verseOrgIds": [
              "GEN.26.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo, antchito a Isake anabwera namuwuza za chitsime chimene anakumba. Iwo anati, \"Tawapeza madzi!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.32",
            "verseOrgIds": [
              "GEN.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye chitsimecho anachitcha Pangano. Nʼchifukwa chake mzindawu umatchedwa Beeriseba mpaka lero.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        }
      ]
    },
    {
