          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazi awiriwa anasandutsa Isake ndi Rebeka kukhala ndi moyo wa madandawulo nthawi zonse.",
          "type": "text",
          "attrs": {
