  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "49",
        "style": "c",
        "sid": "GEN 49"
      },
      "items": [
        {
          "text": "49",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo Adalitsa Ana ake Aamuna",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 49:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake Yakobo anayitanitsa ana ake aamuna nati: Sonkhanani pamodzi kuti ndikuwuzeni zimene zidzakuchitikireni mʼmasiku a mʼtsogolo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.1",
            "verseOrgIds": [
              "GEN.49.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 49:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bwerani ndipo imvani mawu anga, inu ana a Yakobo;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.2",
            "verseOrgIds": [
              "GEN.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:2"
      },
      "items": [
        {
          "text": "mverani abambo anu Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.2",
            "verseOrgIds": [
              "GEN.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 49:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Rubeni, ndiwe woyamba kubadwa;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:3"
      },
      "items": [
        {
          "text": "mphamvu yanga ndiponso chizindikiro choyamba cha mphamvu zanga,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:3"
      },
      "items": [
        {
          "text": "wopambana pa ulemerero ndi mphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 49:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wokokoma ngati madzi a chigumula, koma sudzakhalanso wopambana,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:4"
      },
      "items": [
        {
          "text": "iwe unagona pa bedi la abambo ako,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:4"
      },
      "items": [
        {
          "text": "ndithu unayipitsa bedi la mdzakazi wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Simeoni ndi Levi ndi pachibale pawo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.5",
            "verseOrgIds": [
              "GEN.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:5"
      },
      "items": [
        {
          "text": "anachitira nkhanza anthu amene anachita nawo pangano.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.5",
            "verseOrgIds": [
              "GEN.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe moyo wanga, usakhale nawo pa misonkhano yawo ya mseri,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:6"
      },
      "items": [
        {
          "text": "kapena kugwirizana nawo mʼmabwalo awo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:6"
      },
      "items": [
        {
          "text": "pakuti anapha anthu mu mkwiyo wawo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:6"
      },
      "items": [
        {
          "text": "ndipo anapundula ngʼombe zamphongo monga kunawakomera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 49:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matemberero awagwere chifukwa cha mkwiyo wawo woopsa chonchi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:7"
      },
      "items": [
        {
          "text": "ndi ukali wawo wankhanza choterewu!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:7"
      },
      "items": [
        {
          "text": "Ine ndidzawabalalitsa mʼdziko la Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:7"
      },
      "items": [
        {
          "text": "ndi kuwamwaza iwo mʼdziko la Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 49:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yuda, ndiwe amene abale ako adzatamanda;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:8"
      },
      "items": [
        {
          "text": "dzanja lako lidzagwira pa khosi pa adani ako;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:8"
      },
      "items": [
        {
          "text": "abale ako adzakugwadira iwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 49:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda ali ngati mwana wa mkango;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:9"
      },
      "items": [
        {
          "text": "umabwerera ku malo ako ndi zofunkha, mwana wanga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:9"
      },
      "items": [
        {
          "text": "Monga mkango, amadziwongola ndi kugona pansi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:9"
      },
      "items": [
        {
          "text": "ndipo ngati mkango waukazi, ndani angalimbe mtima kumudzutsa?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 49:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndodo yaufumu sidzachoka mwa Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:10"
      },
      "items": [
        {
          "text": "udzawupanirira ulamuliro motero kuti palibe amene adzawuchotse,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:10"
      },
      "items": [
        {
          "text": "mpaka mwini wake weniweni atabwera",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:10"
      },
      "items": [
        {
          "text": "ndipo mitundu yonse ya anthu idzamumvera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiye amene amamangirira bulu wake wamkazi kumtengo wa mpesa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:11"
      },
      "items": [
        {
          "text": "ndi mwana wa bulu ku nthambi ya mpesa wabwino.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:11"
      },
      "items": [
        {
          "text": "Ndi iye amene amachapa zovala zake mu vinyo;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:11"
      },
      "items": [
        {
          "text": "ndi mkanjo wake mu vinyo wofiira ngati magazi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 49:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maso ake adzakhala akuda chifukwa cha vinyo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.12",
            "verseOrgIds": [
              "GEN.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:12"
      },
      "items": [
        {
          "text": "mano ake woyera chifukwa cha mkaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.12",
            "verseOrgIds": [
              "GEN.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 49:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zebuloni adzakhala mʼmphepete mwa nyanja;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.13",
            "verseOrgIds": [
              "GEN.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:13"
      },
      "items": [
        {
          "text": "adzakhala pa dooko la sitima zapamadzi;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.13",
            "verseOrgIds": [
              "GEN.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:13"
      },
      "items": [
        {
          "text": "malire ake adzafika ku Sidoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.13",
            "verseOrgIds": [
              "GEN.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
