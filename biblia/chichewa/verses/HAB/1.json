      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:13"
      },
      "items": [
        {
          "text": "Inu simulekerera cholakwa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.13",
            "verseOrgIds": [
              "HAB.1.13"
            ]
          }
