      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:13"
      },
      "items": [
        {
          "text": "Chifukwa chiyani nanga mukulekerera anthu ochita zachinyengowa?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.13",
            "verseOrgIds": [
              "HAB.1.13"
            ]
          }
        }
