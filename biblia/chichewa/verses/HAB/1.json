      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:12"
      },
      "items": [
        {
          "text": "Inu Yehova, munawasankha anthuwo kuti abweretse chiweruzo;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.12",
            "verseOrgIds": [
              "HAB.1.12"
            ]
