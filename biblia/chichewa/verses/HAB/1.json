      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:12"
      },
      "items": [
        {
          "text": "Inu Thanthwe, munawayika iwowo kuti atilange.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.12",
            "verseOrgIds": [
              "HAB.1.12"
            ]
