  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "2CH 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abiya Mfumu ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka cha 18 cha ulamuliro wa Yeroboamu, Abiya analowa ufumu wa Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.1",
            "verseOrgIds": [
              "2CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo analamulira mu Yerusalemu kwa zaka zitatu. Dzina la amayi ake linali Maaka mwana wa Urieli wa ku Gibeya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 13:2"
      },
      "items": [
        {
          "text": "Koma panali nkhondo pakati pa Abiya ndi Yeroboamu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiya anapita ku nkhondo ndi asilikali odziwa bwino nkhondo 400,000, ndipo Yeroboamu anandandalitsa ankhondo, asilikali 800,000 odziwa bwino nkhondo, osankhidwa ndi amphamvu, woti amenyane naye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.3",
            "verseOrgIds": [
              "2CH.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiya anayima pa phiri la Zemaraimu, mʼdziko lamapiri la Efereimu, ndipo anati, \"Yeroboamu ndi Aisraeli onse, tandimverani!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.4",
            "verseOrgIds": [
              "2CH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi inu simukudziwa kuti Yehova, Mulungu wa Israeli, wapereka ufumu wa Israeli kwa Davide ndi zidzukulu zake mpaka muyaya ndiponso pangano la mchere?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.5",
            "verseOrgIds": [
              "2CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe Yeroboamu mwana wa Nebati, mtumiki wa Solomoni mwana wa Davide, anawukira mbuye wake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.6",
            "verseOrgIds": [
              "2CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anthu ena achabechabe anasonkhana kwa iye ndipo anatsutsana ndi Rehobowamu mwana wa Solomoni pamene anali wamngʼono ndi wosalimba mtima ndi wopanda mphamvu kuti athe kulimbana nawo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.7",
            "verseOrgIds": [
              "2CH.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndipo tsopano inu mwakonzekera kutsutsana ndi ufumu wa Yehova, umene uli mʼmanja mwa zidzukulu za Davide. Inu ndithu mulipo ankhondo ambirimbiri ndipo muli ndi ana angʼombe agolide amene Yeroboamu anapanga kuti akhale milungu yanu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.8",
            "verseOrgIds": [
              "2CH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma kodi inu simunathamangitse ansembe a Yehova, ana a Aaroni ndiponso Alevi ndi kudzisankhira ansembe anuanu monga anthu ena amachitira? Aliyense amene amabwera kuti adzipatule atatenga mwana wangʼombe wamwamuna ndi nkhosa zazimuna zisanu ndi ziwiri amakhala wansembe wa zinthu zimene sizili milungu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.9",
            "verseOrgIds": [
              "2CH.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koma kunena za ife, Yehova ndiye Mulungu wathu, ndipo sitinamusiye. Ansembe amene amatumikira Yehova ndi ana a Aaroni ndipo amathandizidwa ndi Alevi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmawa uliwonse ndi madzulo aliwonse amapereka nsembe zopsereza ndi kufukiza lubani kwa Yehova. Iwo amayika buledi pa tebulo loyeretsedwa monga mwa mwambo ndipo amayatsa nyale pa zoyikapo nyale zagolide madzulo aliwonse. Ife timachita zofuna za Yehova Mulungu wathu. Koma inu mwamusiya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.11",
            "verseOrgIds": [
              "2CH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu ali nafe pakuti ndiye mtsogoleri wathu. Ansembe ake atanyamula malipenga, adzayimba mfuwu wankhondo kulimbana nanu. Inu Aisraeli musalimbane ndi Yehova, Mulungu wa makolo anu, pakuti simungathe kupambana.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.12",
            "verseOrgIds": [
              "2CH.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Yeroboamu anali atatumiza asilikali kumbuyo mowazungulira, kotero kuti iye ali kutsogolo kwa anthu a ku Yuda, anthu owabisalira anali kumbuyo kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.13",
            "verseOrgIds": [
              "2CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asilikali a Yuda anatembenuka ndipo anaona kuti nkhondo imachitikira kutsogolo ndi kumbuyo. Ndipo iwo anafuwulira Yehova. Ansembe anayimba malipenga awo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.14",
            "verseOrgIds": [
              "2CH.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo asilikali a Yuda anafuwula mawu ankhondo. Atafuwula mawu ankhondowo, Mulungu anagonjetsa Yeroboamu pamodzi ndi Aisraeli onse pamaso pa Abiya ndi Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.15",
            "verseOrgIds": [
              "2CH.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisraeli anathawa Ayuda. Ndipo Mulungu anawapereka mʼmanja mwawo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.16",
            "verseOrgIds": [
              "2CH.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiya pamodzi ndi anthu ake anapha anthu ambiri, kotero kuti Aisraeli 500,000 odziwa bwino nkhondo anaphedwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.17",
            "verseOrgIds": [
              "2CH.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ankhondo a Israeli anagonjetsedwa pa nthawi imeneyi, ndipo ankhondo a Yuda anapambana chifukwa anadalira Yehova, Mulungu wa makolo awo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.18",
            "verseOrgIds": [
              "2CH.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiya anathamangitsa Yeroboamu ndipo anamulanda mizinda ya Beteli, Yesana, ndi Efroni pamodzi ndi midzi yawo yozungulira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.19",
            "verseOrgIds": [
              "2CH.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroboamu sanapezenso mphamvu nthawi ya Abiya. Ndipo Yehova anamukantha nafa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.20",
            "verseOrgIds": [
              "2CH.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Abiya mphamvu zake zinakula. Iye anakwatira akazi 14 ndipo anali ndi ana aamuna 22 ndi ana aakazi 16.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.21",
            "verseOrgIds": [
              "2CH.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zina ndi zina zokhudza Abiya, zimene anachita ndi zimene anayankhula, zinalembedwa mʼbuku la mbiri ya mneneri Ido.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.22",
            "verseOrgIds": [
              "2CH.13.22"
            ]
          }
        }
      ]
    }
  ],
