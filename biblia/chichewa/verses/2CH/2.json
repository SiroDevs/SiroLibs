  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "2CH 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukonzekera Kumanga Nyumba ya Mulungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni anatsimikiza zoti amange Nyumba ya Dzina la Yehova ndi nyumba yake yaufumu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.1",
            "verseOrgIds": [
              "2CH.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye analemba ntchito anthu 70,000 onyamula katundu ndi anthu 80,000 okumba miyala ku mapiri ndiponso akapitawo 3,600 oyangʼanira anthuwo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.2",
            "verseOrgIds": [
              "2CH.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni anatumiza uthenga uwu kwa Hiramu mfumu ya ku Turo:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.3",
            "verseOrgIds": [
              "2CH.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 2:3"
      },
      "items": [
        {
          "text": "\"Munditumizire mitengo ya mkungudza monga munachitira ndi abambo anga pamene munawatumizira mitengo ya mkungudza yomangira nyumba yaufumu yokhalamo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.3",
            "verseOrgIds": [
              "2CH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono ine ndikufuna kumanga Nyumba ya Yehova Mulungu wanga ndi kuyipereka kwa Iye kuti tiziyikamo buledi wopatulika nthawi zonse ndiponso kuperekeramo nsembe zopsereza mmawa uliwonse ndi madzulo ndi pa masabata ndi pa masiku a chikondwerero cha mwezi watsopano ndiponso pa masiku osankhika a chikondwerero cha Yehova Mulungu wathu, monga mwa malamulo a Aisraeli mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.4",
            "verseOrgIds": [
              "2CH.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nyumba ya Mulungu imene ndidzamange idzakhala yayikulu, chifukwa Mulungu wathu ndi wamkulu kuposa milungu ina yonse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.5",
            "verseOrgIds": [
              "2CH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ndani angathe kumumangira Iye Nyumba, pakuti mlengalenga, ngakhale kumwamba kwenikweni sikungamukwane? Tsono ine ndine yani kuti ndimangire Iyeyo Nyumba, kupatula malo chabe opserezerapo nsembe pamaso pake?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.6",
            "verseOrgIds": [
              "2CH.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsono tumizireni munthu waluso pa ntchito zagolide ndi siliva, mkuwa ndi chitsulo, nsalu yapepo ndi yofiira ndi yobiriwira ndiponso waluso losema, kuti adzagwire ntchito mu Yuda ndi Yerusalemu pamodzi ndi anthu aluso amene abambo anga Davide anandipatsa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.7",
            "verseOrgIds": [
              "2CH.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munditumizirenso mitengo ya mkungudza, payini ndiponso matabwa a mʼbawa wa ku Lebanoni, pakuti ndikudziwa kuti anthu anu ali ndi luso locheka matabwa kumeneko. Antchito anga adzagwira ntchito pamodzi ndi antchito anu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.8",
            "verseOrgIds": [
              "2CH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti andipatse matabwa ambiri, chifukwa Nyumba imene ndikumanga iyenera kukhala yayikulu ndi yokongola.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.9",
            "verseOrgIds": [
              "2CH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzalipira antchito anu amene adzacheke matabwa matani 1,000 a tirigu wopunthapuntha, matani 2,000 a barele, malita 440,000 a vinyo, ndiponso malita 440,000 a mafuta a olivi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.10",
            "verseOrgIds": [
              "2CH.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu, mfumu ya ku Turo, anamuyankha Solomoni pomulembera kalata kuti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.11",
            "verseOrgIds": [
              "2CH.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 2:11"
      },
      "items": [
        {
          "text": "\"Chifukwa Yehova amakonda anthu ake, wayika iwe kukhala mfumu yawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.11",
            "verseOrgIds": [
              "2CH.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Hiramu anawonjezera kunena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.12",
            "verseOrgIds": [
              "2CH.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 2:12"
      },
      "items": [
        {
          "text": "\"Atamandike Yehova Mulungu wa Israeli, amene analenga kumwamba ndi dziko lapansi! Iye wamupatsa Davide mwana wanzeru, wodzaza ndi luntha ndi wozindikira, amene adzamanga Nyumba ya Mulungu ndi kudzimangira yekha nyumba yaufumu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.12",
            "verseOrgIds": [
              "2CH.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ine ndikukutumizira Hiramu Abi, munthu wa luso lalikulu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.13",
            "verseOrgIds": [
              "2CH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "amene amayi ake anali wochokera ku Dani ndipo abambo ake anali a ku Turo. Iye anaphunzitsidwa kugwira ntchito zagolide ndi siliva, mkuwa ndi chitsulo, miyala yokongola ndi matabwa, ndiponso nsalu zofewa zobiriwira, zapepo ndi zofiira. Alinso ndi luso la zosemasema ndipo atha kupanga chilichonse chimene wapatsidwa. Iye adzagwira ntchito ndi amisiri anu ndi a mbuye wanga, Davide abambo anu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.14",
            "verseOrgIds": [
              "2CH.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsono mbuye wanga tumizirani antchito anu tirigu ndi barele, mafuta a olivi ndi vinyo zimene mwalonjeza,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.15",
            "verseOrgIds": [
              "2CH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo ife tidzadula mitengo yonse imene mukuyifuna kuchokera ku Lebanoni ndipo tidzayimanga pamodzi ndi kuyiyadamitsa pa madzi mpaka ku Yopa. Ndipo inu mudzatha kuyitenga mpaka ku Yerusalemu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.16",
            "verseOrgIds": [
              "2CH.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni anawerenga alendo onse amene anali mu Israeli, potsatira chiwerengero chimene abambo ake Davide anachita ndipo panapezeka kuti analipo anthu 153,600.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.17",
            "verseOrgIds": [
              "2CH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayika anthu 70,000 kuti akhale onyamula katundu ndi anthu 80,000 kuti akhale ophwanya miyala mʼmapiri, anthu 3,600 anawayika kukhala akapitawo oyangʼanira anthu pa ntchitoyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.18",
            "verseOrgIds": [
              "2CH.2.17"
            ]
          }
        }
      ]
    }
  ],
