  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1KI 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Davide Alangiza Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide ali pafupi kumwalira, analangiza mwana wake Solomoni kuti:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.1",
            "verseOrgIds": [
              "1KI.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndatsala pangʼono kupita kumene munthu wina aliyense amayenera kupitako. Tsono khala wamphamvu, uvale zilimbe,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.2",
            "verseOrgIds": [
              "1KI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo uzichita zimene Yehova Mulungu wako amafuna, uziyenda mʼnjira zake, uzisunga malangizo ndi malamulo ake monga momwe zinalembedwera mʼMalamulo a Mose, kuti zonse zimene udzachite zidzakuyendere bwino kulikonse kumene udzapite.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.3",
            "verseOrgIds": [
              "1KI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova akwaniritse zimene anandilonjeza kuti, 'Ngati zidzukulu zako zidzakhala mosamala, niziyenda mokhulupirika pamaso panga ndi mtima wawo wonse ndi moyo wawo wonse, sudzasowa munthu wokhala pa mpando waufumu wa Israeli.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.4",
            "verseOrgIds": [
              "1KI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsono iwe ukudziwanso zoyipa zimene Yowabu mwana wa Zeruya anandichitira pakupha atsogoleri awiri a ankhondo a Israeli, Abineri mwana wa Neri ndi Amasa mwana wa Yeteri. Iye anawapha ndi kukhetsa magazi nthawi ya mtendere ngati nthawi ya nkhondo, ndipo anapaka magazi amenewo pa lamba wa mʼchiwuno mwake ndi pa nsapato za ku mapazi ake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.5",
            "verseOrgIds": [
              "1KI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe uchite kwa iye molingana ndi nzeru zako, koma usalole kuti afe ndi ukalamba ndi kupita ku manda mwamtendere.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.6",
            "verseOrgIds": [
              "1KI.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koma ana a Barizilai wa ku Giliyadi uwakomere mtima ndipo uwalole kuti akhale mʼgulu la anthu amene azidya pamodzi nawe. Pakuti anandisamalira pamene ndinkathawa mʼbale wako Abisalomu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.7",
            "verseOrgIds": [
              "1KI.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndipo kumbukira kuti uli ndi Simei mwana wa Gera, wa fuko la Benjamini wochokera ku Bahurimu, amene ananditemberera koopsa tsiku limene ndimapita ku Mahanaimu. Atabwera kudzakumana nane ku Yorodani, ine ndinalumbira mʼdzina la Yehova kuti, 'Sindidzakupha iwe ndi lupanga.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.8",
            "verseOrgIds": [
              "1KI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma tsopano usamuyese ngati munthu wosalakwa. Iwe ndiwe munthu wanzeru. Udzadziwa choti uchite naye. Ngakhale ndi wokalamba, aphedwe ndithu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.9",
            "verseOrgIds": [
              "1KI.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Davide anamwalira ndipo anayikidwa mʼmanda mu Mzinda wa Davide.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.10",
            "verseOrgIds": [
              "1KI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyeyo nʼkuti atalamulira Israeli kwa zaka makumi anayi. Ku Hebroni analamulira zaka zisanu ndi ziwiri ndipo ku Yerusalemu analamulira zaka 33.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.11",
            "verseOrgIds": [
              "1KI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Solomoni anakhala pa mpando waufumu wa abambo ake Davide, ndipo ufumu wake unakhazikika kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.12",
            "verseOrgIds": [
              "1KI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukhazikika kwa Ufumu wa Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Adoniya, mwana wa Hagiti, anapita kwa Batiseba, amayi ake a Solomoni. Batiseba anamufunsa kuti, \"Kodi wabwera mwamtendere?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.13",
            "verseOrgIds": [
              "1KI.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 2:13"
      },
      "items": [
        {
          "text": "Iye anayakha kuti, \"Eya, ndi zamtendere.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.13",
            "verseOrgIds": [
              "1KI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo iye anawonjezera kunena kuti, \"Ndili ndi mawu oti ndiyankhule nanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.14",
            "verseOrgIds": [
              "1KI.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 2:14"
      },
      "items": [
        {
          "text": "Batiseba anayankha kuti, \"Yankhula.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.14",
            "verseOrgIds": [
              "1KI.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Adoniya anati, \"Monga inu mukudziwa, ufumu unali wanga. Aisraeli onse ankayembekezera kuti ine ndidzakhala mfumu yawo. Koma zinthu zinasintha ndipo ufumu wapita kwa mʼbale wanga; pakuti wapatsa iye ufumuwu ndi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.15",
            "verseOrgIds": [
              "1KI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono ndili ndi pempho limodzi kwa inu. Musandikanize ayi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.16",
            "verseOrgIds": [
              "1KI.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 2:16"
      },
      "items": [
        {
          "text": "Batiseba anati, \"Nena.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.16",
            "verseOrgIds": [
              "1KI.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoniya anapitiriza kunena kuti, \"Chonde, inu mupemphe mfumu Solomoni kuti andipatse Abisagi wa ku Sunemu kuti akhale mkazi wanga pakuti mukapempha inu sadzakukanizani.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.17",
            "verseOrgIds": [
              "1KI.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batiseba anayankha kuti, \"Chabwino. Ndidzakuyankhulira kwa mfumu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.18",
            "verseOrgIds": [
              "1KI.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batiseba atapita kwa Mfumu Solomoni kukayankhula naye mʼmalo mwa Adoniya, mfumu inanyamuka kukumana naye, ndipo inaweramira amayi akewo, kenaka inakhala pa mpando wake waufumu. Iye anayitanitsa mpando wina kuti amayi ake akhalepo ndipo anakhala pansi ku dzanja lake lamanja.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.19",
            "verseOrgIds": [
              "1KI.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayi akewo anati, \"Ndikufuna ndikupempheni kanthu kakangʼono. Chonde musandikanize.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.20",
            "verseOrgIds": [
              "1KI.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 2:20"
      },
      "items": [
        {
          "text": "Mfumu inayankha kuti, \"Pemphani amayi, ine sindikukanizani.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.20",
            "verseOrgIds": [
              "1KI.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo amayiwo anati, \"Mulole kuti Abisagi wa ku Sunemu akhale mkazi wa mʼbale wanu Adoniya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.21",
            "verseOrgIds": [
              "1KI.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Mfumu Solomoni inayankha amayi ake aja kuti, \"Chifukwa chiyani mukupemphera Adoniya Abisagi wa ku Sunemu? Mungathenso kumupemphera ufumu pakuti iyeyu ndi mkulu wanga ndipo mupemphereninso wansembe Abiatara ndi Yowabu mwana wa Zeruya!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.22",
            "verseOrgIds": [
              "1KI.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Mfumu Solomoni inalumbira mʼdzina la Yehova kuti, \"Mulungu andilange ine koopsa ngati Adoniya saphedwa chifukwa cha pempho lakeli!",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.23",
            "verseOrgIds": [
              "1KI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono pali Yehova wamoyo, amene anandikhazikitsa ine pa mpando waufumu wa abambo anga Davide ndi kundipatsa ufumu monga analonjezera, Adoniya aphedwa lero lomwe lino!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.24",
            "verseOrgIds": [
              "1KI.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Mfumu Solomoni inalamula Benaya mwana wa Yehoyada ndipo anakantha Adoniyayo, nafa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.25",
            "verseOrgIds": [
              "1KI.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mfumu inati kwa Abiatara wansembe, \"Pita ku Anatoti ku minda yako chifukwa ndiwe woyenera kufa, koma sindikupha tsopano, chifukwa unkanyamula Bokosi la Chipangano la Ambuye Yehova pamaso pa abambo anga Davide ndipo unazunzika limodzi ndi abambo angawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.26",
            "verseOrgIds": [
              "1KI.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero Solomoni anachotsa Abiatara pa udindo wokhala wansembe wa Yehova, kukwaniritsa mawu a Yehova amene anayankhula za nyumba ya Eli ku Silo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.27",
            "verseOrgIds": [
              "1KI.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabu atamva zimenezi anathawira ku tenti ya Yehova ndipo anakagwira msonga za guwa lansembe, popeza Yowabu ndiye anathandiza Adoniya kuwukira koma sanathandize Abisalomu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.28",
            "verseOrgIds": [
              "1KI.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu Solomoni inawuzidwa kuti Yowabu wathawira ku tenti ya Yehova ndipo ali pambali pa guwa lansembe. Tsono Solomoni analamula Benaya mwana wa Yehoyada kuti, \"Pita, kamukanthe!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.29",
            "verseOrgIds": [
              "1KI.2.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Benaya analowa mʼtenti ya Yehova ndipo anati kwa Yowabu, \"Mfumu ikuti 'Tuluka!' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.30",
            "verseOrgIds": [
              "1KI.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 2:30"
      },
      "items": [
        {
          "text": "Koma iye anayankha kuti, \"Ayi, ine ndifera muno.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.30",
            "verseOrgIds": [
              "1KI.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 2:30"
      },
      "items": [
        {
          "text": "Benaya anakafotokozera mfumu kuti, \"Umu ndi mmene Yowabu wandiyankhira.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.30",
            "verseOrgIds": [
              "1KI.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo mfumu inalamula Benaya kuti, \"Kachite monga iye wanenera. Ukamukanthe ndi kumuyika mʼmanda. Ukatero udzandichotsera ine pamodzi ndi nyumba ya abambo anga mlandu wa anthu osalakwa amene Yowabu anawapha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.31",
            "verseOrgIds": [
              "1KI.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova adzamubwezera zomwe anachita pokhetsa magazi, chifukwa iye anakantha ndi lupanga anthu awiri abwino ndi olungama kuposa iye, nawapha, abambo anga Davide osadziwa. Anthu awiriwo ndi Abineri mwana wa Neri, wolamulira gulu lankhondo la Israeli ndi Amasa mwana wa Yeteri, wolamulira gulu lankhondo la Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.32",
            "verseOrgIds": [
              "1KI.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magazi amene Yowabu anakhetsa akhale pamutu pake ndi pa zidzukulu zake kwamuyaya. Koma pa Davide ndi zidzukulu zake, nyumba yake ndi mpando wake waufumu pakhale mtendere wochokera kwa Yehova kwamuyaya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.33",
            "verseOrgIds": [
              "1KI.2.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Benaya mwana wa Yehoyada anapita kukakantha Yowabu nʼkumupha ndipo anayikidwa mʼmanda mʼnyumba yakeyake ya ku chipululu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.34",
            "verseOrgIds": [
              "1KI.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inayika Benaya mwana wa Yehoyada kuti akhale woyangʼanira gulu lankhondo mʼmalo mwa Yowabu ndipo inayika Zadoki kuti akhale wansembe mʼmalo mwa Abiatara.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.35",
            "verseOrgIds": [
              "1KI.2.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka mfumu inatuma anthu kukayitana Simei ndipo inamuwuza kuti, \"Udzimangire nyumba mu Yerusalemu ndipo uzikhala kumeneko, koma usatuluke mu mzinda kupita kwina kulikonse.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.36",
            "verseOrgIds": [
              "1KI.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lomwe udzatulukemo ndi kuwoloka Chigwa cha Kidroni, udziwiretu kuti udzafa ndipo magazi ako adzakhala pamutu pako.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.37",
            "verseOrgIds": [
              "1KI.2.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simei anayankha mfumu kuti, \"Zimene mwanenazi nʼzabwino. Kapolo wanu adzachita monga mbuye wanga mfumu mwanenera.\" Choncho Simei anakhala mu Yerusalemu nthawi yayitali.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.38",
            "verseOrgIds": [
              "1KI.2.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma patatha zaka zitatu, akapolo awiri a Simei anathawira kwa Akisi mwana wa Maaka, mfumu ya ku Gati, ndipo Simei anawuzidwa kuti, \"Akapolo anu ali ku Gati.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.39",
            "verseOrgIds": [
              "1KI.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamva zimenezi, anakwera bulu wake ndipo anapita kwa Akisi ku Gati kukafunafuna akapolo ake. Choncho Simei anapita ndi kukatenga akapolo ake ku Gati ndipo anabwera nawo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.40",
            "verseOrgIds": [
              "1KI.2.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni atawuzidwa kuti Simei anatuluka mu Yerusalemu ndi kupita ku Gati ndipo kuti wabwerako,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.41",
            "verseOrgIds": [
              "1KI.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "mfumu inamuyitanitsa Simei ndipo inamufunsa kuti, \"Kodi sindinakulumbiritse mʼdzina la Yehova ndi kukuchenjeza kuti, 'Tsiku limene udzatuluka kupita kwina kulikonse, udziwe kuti udzafa'? Nthawi imeneyo iwe unandiwuza kuti, 'Zimene mwanena nʼzabwino. Ine ndidzamvera.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.42",
            "verseOrgIds": [
              "1KI.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa chiyani tsono sunasunge lumbiro lako kwa Yehova? Bwanji nanga sunamvere lamulo limene ndinakuwuza?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.43",
            "verseOrgIds": [
              "1KI.2.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumuyo inawuzanso Simei kuti, \"Ukudziwa mu mtima mwakomo zoyipa zonse zimene unachitira abambo anga Davide. Tsopano Yehova akubwezera zoyipa zakozo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.44",
            "verseOrgIds": [
              "1KI.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Mfumu Solomoni idzadalitsidwa ndipo mpando waufumu wa Davide udzakhazikika pamaso pa Yehova kwamuyaya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.45",
            "verseOrgIds": [
              "1KI.2.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo mfumu inalamula Benaya mwana wa Yehoyada ndipo iye anapita kukakantha Simei ndi kumupha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.46",
            "verseOrgIds": [
              "1KI.2.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 2:46"
      },
      "items": [
        {
          "text": "Tsono ufumu unakhazikika mʼdzanja la Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.46",
            "verseOrgIds": [
              "1KI.2.46"
            ]
          }
        }
      ]
    }
  ],
