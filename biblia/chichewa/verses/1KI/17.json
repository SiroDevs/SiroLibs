  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "1KI 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Makwangwala Adyetsa Eliya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mneneri Eliya wa ku Tisibe ku Giliyadi, anati kwa Ahabu, \"Pali Yehova wamoyo, Mulungu wa Israeli, amene ndimamutumikira, sipadzakhala mame kapena mvula zaka zikubwerazi, pokhapokha ine nditanena.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.1",
            "verseOrgIds": [
              "1KI.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yehova anayankhula ndi Eliya kuti,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.2",
            "verseOrgIds": [
              "1KI.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Choka kuno, upite kummawa, ukabisale mʼmbali mwa mtsinje wa Keriti, pafupi ndi Yorodani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.3",
            "verseOrgIds": [
              "1KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzikamwa mu mtsinjemo, ndipo ndalamula makwangwala kuti azikakudyetsa kumeneko.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.4",
            "verseOrgIds": [
              "1KI.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Eliya anachita zomwe Yehova anamuwuza. Anapita ku mtsinje wa Keriti, pafupi ndi Yorodani, nakakhala kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.5",
            "verseOrgIds": [
              "1KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makwangwala ankabweretsera buledi ndi nyama mmawa ndi madzulo, ndipo ankamwa mu mtsinjemo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.6",
            "verseOrgIds": [
              "1KI.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mayi Wamasiye wa ku Zarefati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patapita masiku, mtsinjewo unaphwa chifukwa mvula sinagwe mʼdzikomo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.7",
            "verseOrgIds": [
              "1KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anayankhula naye kuti,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.8",
            "verseOrgIds": [
              "1KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nyamuka tsopano, pita ku Zarefati ku Sidoni ndipo ukakhale kumeneko. Ndalamula mkazi wamasiye wa kumeneko kuti azikakudyetsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.9",
            "verseOrgIds": [
              "1KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho iye ananyamuka napita ku Zarefati. Atafika pa chipata cha mzindawo, taonani mkazi wamasiye amatola nkhuni. Anamuyitana ndi kumuwuza kuti, \"Patseni madzi pangʼono mʼchikho kuti ndimwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.10",
            "verseOrgIds": [
              "1KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayi wamasiye uja ankapita kukatunga madzi, Eliya anamuyitananso namuwuza kuti, \"Chonde munditengerekonso buledi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.11",
            "verseOrgIds": [
              "1KI.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayankha kuti \"Pali Yehova Mulungu wanu wamoyo, ine ndilibe chakudya china chilichonse, koma kaufa pangʼono mʼmbiya ndi mafuta pangʼono mʼbotolo. Ine ndikutola tinkhuni tochepa kuti ndipite nato ku nyumba ndi kukaphika chakudya changa ndi cha mwana wanga, kuti tikadye kenaka tife.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.12",
            "verseOrgIds": [
              "1KI.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya anati kwa iye, \"Musachite mantha. Pitani mukachite monga mwaneneramo. Koma poyamba mundipangire kachakudya pangʼono kuchokera pa ufa umene muli nawo ndi kubwera nako kwa ine, ndipo kenaka mukaphike choti mudye inuyo ndi mwana wanuyo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.13",
            "verseOrgIds": [
              "1KI.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Yehova Mulungu wa Israeli akuti, 'Ufa umene uli mʼmbiyamo sudzatha ndipo mafuta amene ali mʼbotolomo sadzathanso mpaka tsiku limene Yehova adzagwetse mvula pa dziko lapansi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.14",
            "verseOrgIds": [
              "1KI.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayi wamasiyeyo anapita nakachita zimene Eliya anamuwuza. Choncho panali chakudya cha Eliya, mayiyo pamodzi ndi banja lake lonse chimene anadya masiku ambiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.15",
            "verseOrgIds": [
              "1KI.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ufa umene unali mʼmbiya sunathe ndiponso mafuta amene anali mʼbotolo sanathe, monga momwe ananenera Yehova kudzera mwa Eliya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.16",
            "verseOrgIds": [
              "1KI.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lina mwana wake wa mkazi wamasiye uja, mwini nyumbayo, anadwala. Matenda ananka nakulirakulirabe, ndipo kenaka analeka kupuma.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.17",
            "verseOrgIds": [
              "1KI.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayiyo anati kwa Eliya, \"Kodi ndakulakwirani chiyani, inu munthu wa Mulungu? Kodi munabwera kuno kudzandikumbutsa tchimo langa ndi kudzandiphera mwana wanga?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.18",
            "verseOrgIds": [
              "1KI.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya anayankha kuti, \"Patseni mwana wanuyo.\" Iye anatenga mwanayo mʼmanja mwa mayiyo napita naye mʼchipinda chapamwamba, kumene Eliyayo amagona, namugoneka pa bedi lake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.19",
            "verseOrgIds": [
              "1KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Eliya anafuwula kwa Yehova nati, \"Inu Yehova Mulungu wanga, kodi mwabweretsanso choyipa chotere pa mkazi wamasiye amene ine ndikukhala naye, pakuchititsa kuti mwana wake afe?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.20",
            "verseOrgIds": [
              "1KI.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Eliya anakumbatira mwanayo katatu ndi kufuwula kwa Yehova kuti, \"Inu Yehova Mulungu wanga, mubwezereni mwanayu moyo wake!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.21",
            "verseOrgIds": [
              "1KI.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anamva kufuwula kwa Eliya, ndipo moyo wa mwanayo unabwerera mwa iye ndipo anatsitsimuka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.22",
            "verseOrgIds": [
              "1KI.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya ananyamula mwanayo natsika naye kuchoka mʼchipinda chapamwamba chija nalowa naye mʼnyumba. Anamupereka kwa amayi ake ndipo anati, \"Taonani, mwana wanu ali ndi moyo!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.23",
            "verseOrgIds": [
              "1KI.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo mayiyo anati kwa Eliya, \"Tsopano ndadziwa kuti ndinu munthu wa Mulungu ndipo mawu a Yehova amene mumayankhula ndi owona.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.24",
            "verseOrgIds": [
              "1KI.17.24"
            ]
          }
        }
      ]
    }
  ],
