      "attrs": {
        "style": "q2",
        "vid": "ISA 52:12"
      },
      "items": [
        {
          "text": "kapena kuchita chothawa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.12",
            "verseOrgIds": [
              "ISA.52.12"
            ]
          }
