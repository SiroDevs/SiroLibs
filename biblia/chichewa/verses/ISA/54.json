  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "54",
        "style": "c",
        "sid": "ISA 54"
      },
      "items": [
        {
          "text": "54",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ulemerero Wamʼtsogolo wa Ziyoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 54:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sangalala, iwe mayi wosabala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "iwe amene sunabalepo mwana;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "imba nyimbo, ndi kufuwula mwachimwemwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "iwe amene sunamvepo ululu wa pobereka;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "chifukwa mkazi wosiyidwa adzakhala ndi ana ambiri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "kuposa mkazi wokwatiwa,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 54:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulitsa malo omangapo tenti yako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "tambasula kwambiri nsalu zake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "usaleke;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "talikitsa zingwe zako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "limbitsa zikhomo zako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 54:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti udzasendeza malire ako kumanja ndi kumanzere;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "ndipo zidzukulu zako zidzalanda dziko la anthu a mitundu ina",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "ndipo zidzakhala mʼmizinda yawo yosiyidwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 54:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Usachite mantha; sadzakunyozanso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:4"
      },
      "items": [
        {
          "text": "Usakhumudwe; sudzapeputsidwanso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:4"
      },
      "items": [
        {
          "text": "Udzayiwala za manyazi zimene zinakuchitikira nthawi ya unyamata wako",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:4"
      },
      "items": [
        {
          "text": "ndipo za manyazi zimene zinakuchitikira pa nthawi ya umasiye wako sudzazikumbukanso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 54:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Mlengi wako ali ngati mwamuna wako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:5"
      },
      "items": [
        {
          "text": "dzina lake ndi Yehova Wamphamvuzonse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:5"
      },
      "items": [
        {
          "text": "Woyerayo wa Israeli ndiye Mpulumutsi wanu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:5"
      },
      "items": [
        {
          "text": "dzina lake ndi Mulungu wa dziko lonse lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 54:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wakuyitananso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:6"
      },
      "items": [
        {
          "text": "uli ngati mkazi wosiyidwa ndi wodzaza ndi chisoni mu mtima,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:6"
      },
      "items": [
        {
          "text": "mkazi amene anakwatiwa pa unyamata wake kenaka nʼkukanidwa,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:6"
      },
      "items": [
        {
          "text": "akutero Mulungu wako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 54:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa kanthawi kochepa, Ine ndinakusiya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.7",
            "verseOrgIds": [
              "ISA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:7"
      },
      "items": [
        {
          "text": "koma ndidzakutenganso chifukwa ndimakukonda kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.7",
            "verseOrgIds": [
              "ISA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 54:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinakufulatira kwa kanthawi kochepa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "ndili wokwiya kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "Koma ndi kukoma mtima kwanga kwa muyaya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "ndidzakuchitira chifundo,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "akutero Yehova Mpulumutsi wako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 54:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa ine zimenezi zili ngati mmene zinalili mʼnthawi ya Nowa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:9"
      },
      "items": [
        {
          "text": "Monga ndinalumbira nthawi imeneyo kuti sindidzawononganso dziko lapansi ndi madzi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:9"
      },
      "items": [
        {
          "text": "Kotero tsopano ndalumbira kuti sindidzakupseraninso mtima,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:9"
      },
      "items": [
        {
          "text": "sindidzakudzudzulaninso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 54:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale mapiri atagwedezeka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.10",
            "verseOrgIds": [
              "ISA.54.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:10"
      },
      "items": [
        {
          "text": "ndi zitunda kusunthidwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.10",
            "verseOrgIds": [
              "ISA.54.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:10"
      },
      "items": [
        {
          "text": "koma chikondi changa chosasinthika pa iwe sichidzatha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.10",
            "verseOrgIds": [
              "ISA.54.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:10"
      },
      "items": [
        {
          "text": "Pangano langa lamtendere silidzasintha,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.10",
            "verseOrgIds": [
              "ISA.54.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:10"
      },
      "items": [
        {
          "text": "akutero Yehova amene amakuchitira chifundo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.10",
            "verseOrgIds": [
