      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:11"
      },
      "items": [
        {
          "text": "Munthu wina akundiyitana kuchokera ku Seiri kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.11",
            "verseOrgIds": [
              "ISA.21.11"
