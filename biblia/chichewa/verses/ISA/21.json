      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:12"
      },
      "items": [
        {
          "text": "Ngati ukufuna kufunsa, funsa tsopano;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.12",
            "verseOrgIds": [
              "ISA.21.12"
            ]
          }
        }
