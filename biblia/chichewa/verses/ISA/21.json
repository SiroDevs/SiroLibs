        },
        {
          "text": "Mwa anthu okoka uta, ankhondo a ku Kedara opulumuka adzakhala owerengeka.\" Wayankhula ndi Yehova Mulungu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.17",
