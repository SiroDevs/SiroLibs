    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:11"
      },
      "items": [
        {
          "text": "Iwe mlonda, utha liti kodi usikuwu?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.11",
            "verseOrgIds": [
              "ISA.21.11"
            ]
          }
        }
      ]
    },
