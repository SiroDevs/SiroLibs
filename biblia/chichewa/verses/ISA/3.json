      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:14"
      },
      "items": [
        {
          "text": "akuluakulu ndi atsogoleri a anthu ake:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.14",
            "verseOrgIds": [
              "ISA.3.14"
            ]
          }
        }
      ]
    },
    {
