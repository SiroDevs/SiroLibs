          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake Ambuye, adzatulutsa zipere pa mitu ya akazi a ku Ziyoniwo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.17",
            "verseOrgIds": [
              "ISA.3.17"
            ]
          }
        }
      ]
    },
