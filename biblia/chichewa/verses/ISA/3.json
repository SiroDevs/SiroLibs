      "attrs": {
        "style": "q2",
        "vid": "ISA 3:24"
      },
      "items": [
        {
          "text": "mʼmalo mwa lamba, adzavala chingwe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.24",
            "verseOrgIds": [
              "ISA.3.24"
            ]
          }
        }
      ]
