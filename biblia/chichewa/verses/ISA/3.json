          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akuwazenga milandu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.14",
            "verseOrgIds": [
              "ISA.3.14"
            ]
          }
