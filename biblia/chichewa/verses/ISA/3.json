              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe Yerusalemu anthu ako aamuna adzaphedwa ndi lupanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.25",
            "verseOrgIds": [
              "ISA.3.25"
            ]
