      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:15"
      },
      "items": [
        {
          "text": "nʼkudyera masuku pamutu amphawi?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.15",
            "verseOrgIds": [
              "ISA.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "ISA 3:15"
      },
      "items": [
        {
          "text": "Akutero Ambuye Yehova Wamphamvuzonse.",
          "type": "text"
        }
      ]
