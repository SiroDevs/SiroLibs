      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:13"
      },
      "items": [
        {
          "text": "wakonzeka kuti aweruze anthu ake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.13",
            "verseOrgIds": [
              "ISA.3.13"
            ]
          }
        }
      ]
    },
    {
