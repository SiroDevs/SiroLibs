      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:16"
      },
      "items": [
        {
          "text": "\"Akazi a ku Ziyoni ngodzikuza kwambiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.16",
            "verseOrgIds": [
              "ISA.3.16"
            ]
          }
        }
      ]
    },
