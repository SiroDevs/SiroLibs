      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:16"
      },
      "items": [
        {
          "text": "akuyenda atakweza makosi awo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.16",
            "verseOrgIds": [
              "ISA.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:16"
      },
      "items": [
        {
          "text": "akukopa amuna ndi maso awo",
