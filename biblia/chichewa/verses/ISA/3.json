      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:14"
      },
      "items": [
        {
          "text": "nyumba zanu zadzaza ndi zolanda kwa amphawi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.14",
            "verseOrgIds": [
              "ISA.3.14"
            ]
          }
        }
      ]
    },
    {
