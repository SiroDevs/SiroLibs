      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:14"
      },
      "items": [
        {
          "text": "\"Ndinu amene mwawononga munda wanga wa mpesa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.14",
            "verseOrgIds": [
              "ISA.3.14"
            ]
          }
        }
      ]
    },
