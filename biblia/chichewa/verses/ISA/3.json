      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:17"
      },
      "items": [
        {
          "text": "Yehova adzachititsa dazi mitu yawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.17",
            "verseOrgIds": [
              "ISA.3.17"
            ]
          }
        }
      ]
    },
    {
