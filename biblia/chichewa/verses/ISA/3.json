      "attrs": {
        "style": "q2",
        "vid": "ISA 3:26"
      },
      "items": [
        {
          "text": "Iweyo udzasakazidwa nʼkukhala pansi, ukugubuduzika pa fumbi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.26",
            "verseOrgIds": [
