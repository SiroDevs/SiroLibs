            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wakhala pamalo pake mʼbwalo la milandu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.13",
            "verseOrgIds": [
              "ISA.3.13"
            ]
