          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndolo ndi zibangiri, nsalu zophimba pa nkhope,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.19",
            "verseOrgIds": [
              "ISA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "maduku, zigwinjiri za mʼmiyendo ndi malamba, mabotolo a zonunkhira ndi zithumwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.20",
            "verseOrgIds": [
              "ISA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mphete ndi zipini,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.21",
            "verseOrgIds": [
              "ISA.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "zovala za pa mphwando, zipewa ndi mwinjiro, zikwama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.22",
            "verseOrgIds": [
              "ISA.3.22"
            ]
          }
        },
