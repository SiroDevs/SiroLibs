          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "magalasi oyangʼanira, zovala zosalala, nduwira ndiponso nsalu za mʼmapewa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.23",
            "verseOrgIds": [
              "ISA.3.23"
            ]
          }
        }
      ]
