          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chiyani inu mukupsinja anthu anga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.15",
            "verseOrgIds": [
              "ISA.3.15"
            ]
          }
        }
      ]
