      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:24"
      },
      "items": [
        {
          "text": "mʼmalo mwa tsitsi lopesa bwino, adzakhala ndi dazi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.24",
            "verseOrgIds": [
              "ISA.3.24"
            ]
          }
        }
      ]
