      "attrs": {
        "style": "q2",
        "vid": "ISA 3:25"
      },
      "items": [
        {
          "text": "asilikali ako adzafera ku nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.25",
            "verseOrgIds": [
              "ISA.3.25"
            ]
          }
        }
