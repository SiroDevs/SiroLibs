          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo Ambuye adzawachotsera zodzikongoletsera zawo: za mʼmiyendo, za ku mutu za mʼkhosi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.18",
            "verseOrgIds": [
              "ISA.3.18"
            ]
          }
        },
