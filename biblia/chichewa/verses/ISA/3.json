          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa zipata za Ziyoni padzakhala kubuma ndi kulira;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.26",
            "verseOrgIds": [
              "ISA.3.26"
            ]
