  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "ISA 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a ku Mowabu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:1"
      },
      "items": [
        {
          "text": "atumiza mphatso za ana ankhosa onenepa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:1"
      },
      "items": [
        {
          "text": "kuchokera ku Sela kudutsa chipululu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:1"
      },
      "items": [
        {
          "text": "mpaka kukafika ku phiri la Ziyoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga momwe mbalame zimawulukira uku ndi uku",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:2"
      },
      "items": [
        {
          "text": "akazimwaza mʼchisa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:2"
      },
      "items": [
        {
          "text": "momwemonso akazi a ku Mowabu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:2"
      },
      "items": [
        {
          "text": "akuyendayenda ku madooko a Arinoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amowabu aja anawuza a ku Yuda kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "\"Tiwuzeni chochita, gamulani zoti tichite.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "Inu mutiteteze kwa adani anthu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "Mukhale ngati mthunzi wathu dzuwa lili pa liwombo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "Mutibise,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "musatipereke ife othawa nkhondo kwa adani athu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lolani kuti anthu othawa nkhondo a ku Mowabu azikhala pakati panu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "mukhale populumukira pawo kwa wowonongayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 16:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "Nthawi idzafika ndipo wozunzayo sadzakhalaponso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "kuwononga kudzaleka;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "waukaliyo adzachoka mʼdzikomo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpando waufumu udzakhazikitsidwa mwachikondi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "mmodzi mwa zidzukulu za Davide adzakhalapo mokhulupirika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "Iyeyo poweruza adzatsata chilungamo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "ndipo adzalimbikitsa kuchita zachilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinamva kuti Mowabu anadzikuza kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "Kunyada kwawo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "ndi kunyogodola kwawo ndi kudzitama kwawo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "zonse ndi zopanda phindu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake Amowabu akulira kwambiri;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:7"
      },
      "items": [
        {
          "text": "iwo akulirira dziko lawo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:7"
      },
      "items": [
        {
          "text": "Akubuma momvetsa chisoni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:7"
      },
      "items": [
        {
          "text": "chifukwa cha makeke a mphesa a ku Kiri Hareseti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Minda ya ku Hesiboni yauma,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "minda ya mpesa ya ku Sibina yaguga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "Atsogoleri a mitundu ina anapondaponda",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "minda ya mpesa wabwino,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "imene nthambi zake zinakafika ku Yazeri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "mpaka kutambalalira ku chipululu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "Mizu yake inakafika",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "mpaka ku tsidya la nyanja.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero Ine ndikulira, monga mmene akulirira anthu a ku Yazeri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "chifukwa cha minda ya mpesa ya ku Sibima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "Inu anthu a ku Hesiboni, inu anthu a ku Eleali,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "ndikukunyowetsani ndi misozi!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "Mwalephera kupeza zokolola,",
          "type": "text",
          "attrs": {
