  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "43",
        "style": "c",
        "sid": "ISA 43"
      },
      "items": [
        {
          "text": "43",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehova Yekha Mpulumutsi wa Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 43:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma tsopano, Yehova",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:1"
      },
      "items": [
        {
          "text": "amene anakulenga, iwe Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:1"
      },
      "items": [
        {
          "text": "amene anakuwumba, iwe Israeli akuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:1"
      },
      "items": [
        {
          "text": "\"Usaope, pakuti ndakuwombola;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:1"
      },
      "items": [
        {
          "text": "Ndinakuyitanitsa mokutchula dzina lako, ndiwe wanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ukuwoloka nyanja,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:2"
      },
      "items": [
        {
          "text": "ndidzakhala nawe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:2"
      },
      "items": [
        {
          "text": "ndipo pamene ukuwoloka mitsinje,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:2"
      },
      "items": [
        {
          "text": "sidzakukokolola.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:2"
      },
      "items": [
        {
          "text": "Pamene ukudutsa pa moto,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:2"
      },
      "items": [
        {
          "text": "sudzapsa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:2"
      },
      "items": [
        {
          "text": "lawi la moto silidzakutentha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa Ine Yehova, Mulungu wako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.3",
            "verseOrgIds": [
              "ISA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:3"
      },
      "items": [
        {
          "text": "Woyera wa Israeli, ndine Mpulumutsi wako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.3",
            "verseOrgIds": [
              "ISA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:3"
      },
      "items": [
        {
          "text": "Ndinapereka Igupto pofuna kuti ndiwombole iwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.3",
            "verseOrgIds": [
              "ISA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:3"
      },
      "items": [
        {
          "text": "ndinapereka Kusi ndi Seba mʼmalo mwa iwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.3",
            "verseOrgIds": [
              "ISA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza kuti ndiwe wamtengowapatali wolemekezeka ndi wapamtima panga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.4",
            "verseOrgIds": [
              "ISA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:4"
      },
      "items": [
        {
          "text": "ndipo chifukwa ndimakukonda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.4",
            "verseOrgIds": [
              "ISA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:4"
      },
      "items": [
        {
          "text": "ndidzapereka anthu mʼmalo mwa iwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.4",
            "verseOrgIds": [
              "ISA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:4"
      },
      "items": [
        {
          "text": "ndidzapereka mitundu ya anthu pofuna kuwombola moyo wako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.4",
            "verseOrgIds": [
              "ISA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usachite mantha, pakuti Ine ndili nawe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.5",
            "verseOrgIds": [
              "ISA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:5"
      },
      "items": [
        {
          "text": "ndidzabweretsa ana ako kuchokera kummawa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.5",
            "verseOrgIds": [
              "ISA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:5"
      },
      "items": [
        {
          "text": "ndipo ndidzakusonkhanitsani kuchokera kumadzulo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.5",
            "verseOrgIds": [
              "ISA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzawuza a kumpoto kuti, 'Amasuleni,'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:6"
      },
      "items": [
        {
          "text": "ndidzawuza akummwera kuti, 'Musawagwire.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:6"
      },
      "items": [
        {
          "text": "Bweretsani ana anga aamuna kuchokera ku mayiko akutali,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:6"
      },
      "items": [
        {
          "text": "ana anga a akazi kuchokera kumalekezero a dziko lapansi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "onsewo amadziwika ndi dzina langa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.7",
            "verseOrgIds": [
              "ISA.43.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:7"
      },
      "items": [
        {
          "text": "ndinawalenga chifukwa cha ulemerero wanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.7",
            "verseOrgIds": [
              "ISA.43.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:7"
      },
      "items": [
        {
          "text": "ndinawawumba, inde ndinawapanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.7",
            "verseOrgIds": [
              "ISA.43.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulutsa anthu amene ali nawo maso koma sakupenya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.8",
            "verseOrgIds": [
              "ISA.43.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:8"
      },
      "items": [
        {
          "text": "anthu amene ali nawo makutu koma sakumva.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.8",
            "verseOrgIds": [
              "ISA.43.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitundu yonse ya anthu isonkhane pamodzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:9"
      },
      "items": [
        {
          "text": "anthu a mitundu ina akhale pamodzi pabwalo la milandu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:9"
      },
      "items": [
        {
          "text": "Ndani wa iwo amene ananeneratu zimenezi?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:9"
      },
      "items": [
        {
          "text": "Ndani wa iwo anatifotokozerapo zinthu zakalekale?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:9"
      },
      "items": [
        {
          "text": "Abweretu ndi mboni zawo kuti adzatsimikizire kuti ananena zoona,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:9"
      },
      "items": [
        {
          "text": "kuti anthu ena amve ndi kunena kuti, \"Ndi zoona.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akunena kuti, \"Inu Aisraeli ndinu mboni zanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:10"
      },
      "items": [
        {
          "text": "ndi mtumiki wanga amene ndinakusankha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:10"
      },
      "items": [
        {
          "text": "kuti mundidziwe ndi kundikhulupirira, ndipo mudzamvetsa kuti Mulungu ndine ndekha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:10"
      },
      "items": [
        {
          "text": "Patsogolo panga sipanapangidwepo mulungu wina,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:10"
      },
      "items": [
        {
          "text": "ngakhale pambuyo panga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:10"
      },
      "items": [
        {
          "text": "sipadzakhalaponso wina.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akutero Yehova, \"Ine, Inetu ndine Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.11",
            "verseOrgIds": [
              "ISA.43.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:11"
      },
      "items": [
        {
          "text": "ndipo palibe Mpulumutsi wina koma Ine ndekha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.11",
            "verseOrgIds": [
              "ISA.43.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndine amene ndinaneneratu, amene ndinakupulumutsa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:12"
      },
      "items": [
        {
          "text": "ndine, osati mulungu wina wachilendo pakati panu amene ndinalengezeratu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:12"
      },
      "items": [
        {
          "text": "Inu ndinu mboni zanga, kuti Ine ndine Mulungu,\" akutero Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ine ndine Mulungu kuyambira nthawi yamakedzana, ndipo ndidzakhalabe Mulungu ku nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.13",
            "verseOrgIds": [
              "ISA.43.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:13"
      },
      "items": [
        {
          "text": "Palibe amene angathe kuthawa mʼmanja mwanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.13",
            "verseOrgIds": [
              "ISA.43.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:13"
      },
      "items": [
        {
          "text": "ndipo chimene ndachita palibe angathe kuchisintha.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.13",
            "verseOrgIds": [
              "ISA.43.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chifundo cha Mulungu ndi Kusakhulupirika kwa Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 43:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.14",
            "verseOrgIds": [
              "ISA.43.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:14"
      },
      "items": [
        {
          "text": "Mpulumutsi wanu, Woyerayo wa Israeli akuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.14",
            "verseOrgIds": [
              "ISA.43.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:14"
      },
      "items": [
        {
          "text": "\"Chifukwa cha inu ndidzatuma gulu lankhondo kukalimbana ndi Babuloni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.14",
            "verseOrgIds": [
              "ISA.43.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:14"
      },
      "items": [
        {
          "text": "ndi kukupulumutsani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.14",
            "verseOrgIds": [
              "ISA.43.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:14"
      },
      "items": [
        {
          "text": "Ndidzagwetsa zitseko zonse za mzindawo, ndipo kukondwa kwa anthu ake kudzasanduka kulira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.14",
            "verseOrgIds": [
              "ISA.43.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 43:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndine Yehova, Woyera wanu uja,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.15",
            "verseOrgIds": [
              "ISA.43.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:15"
      },
      "items": [
        {
          "text": "Mlengi wa Israeli. Ine ndine Mfumu yanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.15",
            "verseOrgIds": [
              "ISA.43.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 43:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.16",
            "verseOrgIds": [
              "ISA.43.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:16"
      },
      "items": [
        {
          "text": "anapanga njira pa nyanja,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.16",
            "verseOrgIds": [
              "ISA.43.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:16"
      },
      "items": [
        {
          "text": "anapanga njira pakati pa madzi amphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.16",
            "verseOrgIds": [
              "ISA.43.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anasonkhanitsa magaleta, akavalo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.17",
            "verseOrgIds": [
              "ISA.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:17"
      },
      "items": [
        {
          "text": "gulu lankhondo ndi asilikali amphamvu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.17",
            "verseOrgIds": [
              "ISA.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:17"
      },
      "items": [
        {
          "text": "ndipo onse anagwa pamenepo, osadzukanso",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.17",
            "verseOrgIds": [
              "ISA.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:17"
      },
      "items": [
        {
          "text": "anazimitsidwa kutheratu ngati chingwe cha nyale. Yehova ameneyu akuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.17",
            "verseOrgIds": [
              "ISA.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 43:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwalani zinthu zakale;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.18",
            "verseOrgIds": [
              "ISA.43.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:18"
      },
      "items": [
        {
          "text": "ndipo musaganizirenso zinthu zimene zinachitika kale.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.18",
            "verseOrgIds": [
              "ISA.43.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 43:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taonani, Ine ndikuchita zinthu zatsopano!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.19",
            "verseOrgIds": [
              "ISA.43.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:19"
      },
      "items": [
        {
          "text": "Tsopano zayamba kale kuoneka; kodi simukuziona?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.19",
            "verseOrgIds": [
              "ISA.43.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:19"
      },
      "items": [
        {
          "text": "Ine ndikulambula msewu mʼchipululu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.19",
            "verseOrgIds": [
              "ISA.43.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:19"
      },
      "items": [
        {
          "text": "ndi kupanga mitsinje mʼdziko lowuma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.19",
            "verseOrgIds": [
              "ISA.43.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 43:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyama zakuthengo, nkhandwe ndi akadzidzi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.20",
            "verseOrgIds": [
              "ISA.43.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:20"
      },
      "items": [
        {
          "text": "zinandilemekeza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.20",
            "verseOrgIds": [
              "ISA.43.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:20"
      },
      "items": [
        {
          "text": "Ndidzayendetsa mitsinje mʼdziko lowuma",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.20",
            "verseOrgIds": [
              "ISA.43.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:20"
      },
      "items": [
        {
          "text": "kuti ndiwapatse madzi anthu anga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.20",
            "verseOrgIds": [
              "ISA.43.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:20"
      },
      "items": [
        {
          "text": "osankhidwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.20",
            "verseOrgIds": [
              "ISA.43.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 43:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu amene ndinadziwumbira ndekha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.21",
            "verseOrgIds": [
              "ISA.43.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:21"
      },
      "items": [
        {
          "text": "kuti aziyimba nyimbo yotamanda Ine.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.21",
            "verseOrgIds": [
              "ISA.43.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 43:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Komatu simunapemphera kwa Ine, Inu a mʼbanja la Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.22",
            "verseOrgIds": [
              "ISA.43.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:22"
      },
      "items": [
        {
          "text": "munatopa nane, Inu Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.22",
            "verseOrgIds": [
              "ISA.43.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 43:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simunabweretse kwa Ine nkhosa za nsembe zopsereza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.23",
            "verseOrgIds": [
              "ISA.43.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:23"
      },
      "items": [
        {
          "text": "kapena kundilemekeza ndi nsembe zanu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.23",
            "verseOrgIds": [
              "ISA.43.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:23"
      },
      "items": [
        {
          "text": "Ine sindinakulemetseni pomakupemphani zopereka za chakudya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.23",
            "verseOrgIds": [
              "ISA.43.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:23"
      },
      "items": [
        {
          "text": "kapena kukutopetsani pomakupemphani nsembe zofukiza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.23",
            "verseOrgIds": [
              "ISA.43.23"
            ]
          }
        }
      ]
    },
    {
