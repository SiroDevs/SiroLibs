      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzi a ku Nimurimu aphwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.6",
            "verseOrgIds": [
              "ISA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:6"
      },
      "items": [
        {
          "text": "ndipo udzu wauma;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.6",
            "verseOrgIds": [
              "ISA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:6"
      },
      "items": [
        {
          "text": "zomera zawonongeka",
