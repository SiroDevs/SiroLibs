      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:6"
      },
      "items": [
        {
          "text": "ndipo palibe chomera chobiriwira chatsala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.6",
            "verseOrgIds": [
              "ISA.15.6"
            ]
          }
        }
      ]
    },
    {
