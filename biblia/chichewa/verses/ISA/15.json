        "style": "s1"
      },
      "items": [
        {
          "text": "Za Kulangidwa kwa Mowabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uthenga wonena za Mowabu:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:1"
      },
      "items": [
        {
          "text": "Popeza kuti mu usiku umodzi wokha mzinda wa Ari wa ku Mowabu wawonongedwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:1"
      },
      "items": [
        {
          "text": "wawonongedwa pa usiku umodzi wokha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:1"
      },
      "items": [
        {
          "text": "Mzinda wa Kiri wawonongedwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:1"
      },
      "items": [
        {
          "text": "wawonongedwa pa usiku umodzi wokha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a ku Diboni akupita ku nyumba ya milungu yawo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "akupita ku malo awo achipembedzo kukalira;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "anthu a ku Mowabu akulirira mofuwula mzinda wa Nebo ndi wa Medeba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "Mutu uliwonse wametedwa mpala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "ndipo ndevu zonse zametedwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmisewu akuvala ziguduli;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:3"
      },
      "items": [
        {
          "text": "pa madenga ndi mʼmabwalo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:3"
      },
      "items": [
        {
          "text": "aliyense akulira mofuwula,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:3"
      },
      "items": [
        {
          "text": "misozi ili pupupu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a ku Hesiboni ndi Eleali akulira mofuwula,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.4",
            "verseOrgIds": [
              "ISA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:4"
      },
      "items": [
        {
          "text": "mawu awo akumveka mpaka ku Yahazi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.4",
            "verseOrgIds": [
              "ISA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:4"
      },
      "items": [
        {
          "text": "Kotero asilikali a ku Mowabu akulira mofuwula,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.4",
            "verseOrgIds": [
              "ISA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:4"
      },
      "items": [
        {
          "text": "ndipo ataya mtima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.4",
            "verseOrgIds": [
              "ISA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
