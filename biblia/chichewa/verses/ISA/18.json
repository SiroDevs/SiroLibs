  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "ISA 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Kulangidwa kwa Kusi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsoka kwa anthu a ku Kusi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:1"
      },
      "items": [
        {
          "text": "Kumeneko kumamveka mkokomo wa mapiko a dzombe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko limenelo limatumiza akazembe pa mtsinje wa Nailo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "mʼmabwato amabango amene amayandama pa madzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "ndikunena kuti, \"Pitani, inu amithenga aliwiro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "kwa mtundu wa anthu ataliatali a khungu losalala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "ndi woopedwa ndi anthu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "Akazembe anatumidwa ku dziko la anthu amphamvu ndi logonjetsa anthu ena.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "Dziko lawo ndi logawikanagawikana ndi mitsinje.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu nonse anthu a pa dziko lonse,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:3"
      },
      "items": [
        {
          "text": "inu amene mumakhala pa dziko lapansi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:3"
      },
      "items": [
        {
          "text": "pamene mbendera yakwezedwa pa mapiri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:3"
      },
      "items": [
        {
          "text": "yangʼanani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:3"
      },
      "items": [
        {
          "text": "ndipo pamene lipenga lilira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:3"
      },
      "items": [
        {
          "text": "mumvere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Yehova akunena kwa ine kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:4"
      },
      "items": [
        {
          "text": "\"Ndili chikhalire ku malo anga kuno, ndidzakhala chete, ndi kumangoyangʼana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:4"
      },
      "items": [
        {
          "text": "monga momwe dzuwa limawalira nthawi yotentha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:4"
      },
      "items": [
        {
          "text": "monganso momwe mame amagwera usiku pa nthawi yotentha yokolola.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti, anthu asanayambe kukolola, maluwa atayoyoka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:5"
      },
      "items": [
        {
          "text": "ndiponso mphesa zitayamba kupsa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:5"
      },
      "items": [
        {
          "text": "Iye adzadula mphukira ndi mipeni yosadzira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:5"
      },
      "items": [
        {
          "text": "ndipo adzadula ndi kuchotsa nthambi zotambalala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitembo ya anthu ankhondo adzasiyira mbalame zamʼmapiri zodya nyama",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:6"
      },
      "items": [
        {
          "text": "ndiponso zirombo zakuthengo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:6"
      },
      "items": [
        {
          "text": "mbalame zidzadya mitemboyo nthawi yonse ya chilimwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:6"
      },
      "items": [
        {
          "text": "ndipo zirombo zidzayidya pa nthawi yonse yachisanu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi imeneyo anthu adzabwera ndi mphatso kwa Yehova Wamphamvuzonse,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "zochokera kwa anthu ataliatali ndi osalala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "kuchokera kwa mtundu wa anthu woopedwa ndi anthu apafupi ndi akutali omwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "mtundu wa anthu amphamvu ndi a chiyankhulo chachilendo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "anthu amene dziko lawo ndi logawikanagawikana ndi mitsinje.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "Adzabwera nazo mphatso ku Phiri la Ziyoni, ku malo a Dzina la Yehova Wamphamvuzonse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    }
  ],
