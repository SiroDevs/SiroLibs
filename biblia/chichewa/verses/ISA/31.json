  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "ISA 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tsoka kwa Amene Amadalira Igupto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsoka kwa amene amapita ku Igupto kukapempha chithandizo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "amene amadalira akavalo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "nakhulupirira kuchuluka kwa magaleta awo ankhondo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "ndiponso mphamvu za asilikali awo okwera pa akavalo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "koma sakhulupirira Woyerayo wa Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "kapena kupempha chithandizo kwa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komatu Yehovayo ndi wanzeru ndipo angathe kuwononga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "ndipo sasintha chimene wanena.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "Adzalimbana ndi anthu ochita zoyipa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "komanso ndi amene amathandiza anthu ochita zoyipa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aigupto ndi anthu chabe osati Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "akavalo awo ndi nyama chabe osati mizimu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "Yehova akangotambasula dzanja lake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "amene amapereka chithandizo adzapunthwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "amene amalandira chithandizocho adzagwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "onsewo adzathera limodzi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimene Yehova akunena kwa ine ndi izi:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "\"Monga mkango kapena msona wamkango umabangula",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "ukagwira nyama yake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "ndipo suopsedwa kapena kusokonezeka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "ndi kufuwula kwa abusa amene akulimbana nayo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "momwemonso palibe chingaletse",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "Yehova Wamphamvuzonse",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "kubwera kudzatchinjiriza",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "phiri la Ziyoni ndi zitunda zake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga mbalame zowuluka pamwamba pa zisa zake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "Yehova Wamphamvuzonse adzatchinjiriza Yerusalemu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "ndi kumupulumutsa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "iye adzawupitirira ndi kuwulanditsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Aisraeli, bwererani kwa Iye amene munamuwukira kwakukulu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.6",
            "verseOrgIds": [
              "ISA.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti tsiku limenelo nonsenu mudzataya mafano anu a siliva ndi golide amene mumapanga ndi manja anu auchimo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.7",
            "verseOrgIds": [
              "ISA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aasiriya adzaphedwa ku nkhondo ndi mphamvu osati za munthu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "Lupanga, osati la munthu, lidzawawononga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "Adzathawa ku nkhondo ndipo anyamata awo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "adzagwira ntchito yathangata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu yawo idzamwalira ndi mantha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:9"
      },
      "items": [
        {
          "text": "ndipo atsogoleri awo ankhondo adzathawa ndi mantha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:9"
      },
      "items": [
        {
          "text": "kusiya pambuyo mbendera yawo ya nkhondo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:9"
      },
      "items": [
        {
          "text": "Akutero Yehova, amene moto wake uli mu Ziyoni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:9"
      },
      "items": [
        {
          "text": "ndipo ngʼanjo yake ili mu Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        }
      ]
    }
  ],
