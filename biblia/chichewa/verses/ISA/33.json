      "attrs": {
        "style": "q2",
        "vid": "ISA 33:18"
      },
      "items": [
        {
          "text": "Ali kuti wokhometsa misonkho uja?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.18",
            "verseOrgIds": [
              "ISA.33.18"
            ]
          }
