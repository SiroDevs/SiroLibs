      "attrs": {
        "style": "q2",
        "vid": "ISA 33:14"
      },
      "items": [
        {
          "text": "Ndani wa ife angathe kukhala moto wosatha?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.14",
            "verseOrgIds": [
              "ISA.33.14"
            ]
          }
