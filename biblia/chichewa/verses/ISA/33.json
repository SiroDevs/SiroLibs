  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "ISA 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Msautso ndi Thandizo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsoka kwa iwe, iwe wowonongawe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "amene sunawonongedwepo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "Tsoka kwa iwe, iwe mthirakuwiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "iwe amene sunanyengedwepo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "Iwe ukadzaleka kuwononga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "udzawonongedwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "ukadzasiya umʼthirakuwiri, adzakuwononga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "ndipo ukadzaleka kuchita zachinyengo adzakunyenga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, mutikomere mtima ife;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.2",
            "verseOrgIds": [
              "ISA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:2"
      },
      "items": [
        {
          "text": "tikulakalaka Inu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.2",
            "verseOrgIds": [
              "ISA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:2"
      },
      "items": [
        {
          "text": "Tsiku ndi tsiku mutitchinjirize ndi mkono wanu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.2",
            "verseOrgIds": [
              "ISA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:2"
      },
      "items": [
        {
          "text": "ndipo mutipulumutse pa nthawi ya masautso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.2",
            "verseOrgIds": [
              "ISA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukatulutsa liwu lanu longa bingu mitundu ya anthu imathawa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.3",
            "verseOrgIds": [
              "ISA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:3"
      },
      "items": [
        {
          "text": "pamene Inu mwadzambatuka mitundu ya anthu imabalalika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.3",
            "verseOrgIds": [
              "ISA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zofunkha za ku nkhondo za mitundu ina Aisraeli adzazisonkhanitsa ngati mmene limachitira dzombe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.4",
            "verseOrgIds": [
              "ISA.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:4"
      },
      "items": [
        {
          "text": "Iwo adzalumphira zofunkhazo monga mmene limachitira dzombe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.4",
            "verseOrgIds": [
              "ISA.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wakwezeka kwambiri pakuti amakhala pamwamba pa zonse",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.5",
            "verseOrgIds": [
              "ISA.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:5"
      },
      "items": [
        {
          "text": "adzadzaza Ziyoni ndi chilungamo ndi chipulumutso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.5",
            "verseOrgIds": [
              "ISA.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzakupatsani mtendere pa nthawi yanu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.6",
            "verseOrgIds": [
              "ISA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:6"
      },
      "items": [
        {
          "text": "adzakupatsani chipulumutso chochuluka, nzeru zambiri ndi chidziwitso chochuluka;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.6",
            "verseOrgIds": [
              "ISA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:6"
      },
      "items": [
        {
          "text": "kuopa Yehova ngati madalitso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.6",
            "verseOrgIds": [
              "ISA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taonani, anthu awo amphamvu akulira mofuwula mʼmisewu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.7",
            "verseOrgIds": [
              "ISA.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:7"
      },
      "items": [
        {
          "text": "akazembe okhazikitsa mtendere akulira kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.7",
            "verseOrgIds": [
              "ISA.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmisewu yayikulu mulibe anthu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.8",
            "verseOrgIds": [
              "ISA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:8"
      },
      "items": [
        {
          "text": "mʼmisewu mulibe anthu a paulendo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.8",
            "verseOrgIds": [
              "ISA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:8"
      },
      "items": [
        {
          "text": "Mdaniyo ndi wosasunga pangano.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.8",
            "verseOrgIds": [
              "ISA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:8"
      },
      "items": [
        {
          "text": "Iye amanyoza mboni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.8",
            "verseOrgIds": [
              "ISA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:8"
      },
      "items": [
        {
          "text": "Palibe kulemekezana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.8",
            "verseOrgIds": [
              "ISA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko likulira ndipo likunka likutha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.9",
            "verseOrgIds": [
              "ISA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:9"
      },
      "items": [
        {
          "text": "Nkhalango ya Lebanoni ikuchita manyazi, yafota.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.9",
            "verseOrgIds": [
              "ISA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:9"
      },
      "items": [
        {
          "text": "Chigwa cha chonde cha Saroni chasanduka chachidalala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.9",
            "verseOrgIds": [
              "ISA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:9"
      },
      "items": [
        {
          "text": "Masamba a mitengo ya ku Basani ndi Karimeli akuyoyoka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.9",
            "verseOrgIds": [
              "ISA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akunena kuti, \"Tsopano ndidzadzambatuka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.10",
            "verseOrgIds": [
              "ISA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:10"
      },
      "items": [
        {
          "text": "ndipo ndidzaonetsa mphamvu zanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.10",
            "verseOrgIds": [
              "ISA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:10"
      },
      "items": [
        {
          "text": "ndipo ndidzakwezedwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.10",
            "verseOrgIds": [
              "ISA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zolingalira zanu nʼzachabechabe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.11",
            "verseOrgIds": [
              "ISA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:11"
      },
      "items": [
        {
          "text": "ngati udzu wamanyowa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.11",
            "verseOrgIds": [
              "ISA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:11"
      },
      "items": [
        {
          "text": "Mpweya wamoto udzakupserezani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.11",
            "verseOrgIds": [
              "ISA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a mitundu ina adzatenthedwa ngati miyala ya njereza;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.12",
            "verseOrgIds": [
              "ISA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:12"
      },
      "items": [
        {
          "text": "ndi ngati minga yodulidwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.12",
            "verseOrgIds": [
              "ISA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
