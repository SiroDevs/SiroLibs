      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:15"
      },
      "items": [
        {
          "text": "ndi kuyankhula zoona,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        }
      ]
