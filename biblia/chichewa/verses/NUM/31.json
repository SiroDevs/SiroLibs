              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose anapereka kwa wansembe Eliezara gawo limene linali loyenera kupereka kwa Yehova monga momwe Yehova analamulira Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.41",
