        {
          "text": "anthu 16,000.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.46",
            "verseOrgIds": [
              "NUM.31.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 31:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchoka pa gawo la Aisraelilo, Mose anatengapo chimodzi pa zolanda ku nkhondo makumi asanu aliwonse, anthu ndi nyama, ndipo anazipereka kwa Alevi amene ankayangʼanira tenti ya Yehova monga Yehova analamulira Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.47",
            "verseOrgIds": [
              "NUM.31.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
