              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "abulu 30,500,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.45",
            "verseOrgIds": [
              "NUM.31.45"
            ]
          }
