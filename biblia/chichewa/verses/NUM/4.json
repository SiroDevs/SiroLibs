          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito yawo pamene azikatumikira mu tenti ya msonkhano ndi iyi: kunyamula matabwa a chihema, mitanda, mizati ndi matsinde,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
              "NUM.4.31"
            ]
