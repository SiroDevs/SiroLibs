          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi ndiyo ntchito ya mafuko a Amerari pamene akugwira ntchito ku tenti ya msonkhano motsogozedwa ndi Itamara mwana wa wansembe Aaroni.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.33",
            "verseOrgIds": [
              "NUM.4.33"
            ]
          }
        }
