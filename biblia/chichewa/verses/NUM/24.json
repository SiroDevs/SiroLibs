  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "NUM 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano Balaamu ataona kuti kunakomera Yehova kudalitsa Israeli, sanapitenso ku mawula monga ankachitira kale, koma kuyangʼana ku chipululu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.1",
            "verseOrgIds": [
              "NUM.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu atayangʼana, anaona Aisraeli atamanga misasa yawo fuko ndi fuko. Pamenepo mzimu wa Mulungu unabwera pa iye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.2",
            "verseOrgIds": [
              "NUM.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo ananena uthenga wake:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:3"
      },
      "items": [
        {
          "text": "\"Uthenga wa Balaamu mwana wa Beori,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:3"
      },
      "items": [
        {
          "text": "uthenga wa amene diso lake ndi lotsekuka,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "uthenga wa amene amamva mawu a Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.4",
            "verseOrgIds": [
              "NUM.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:4"
      },
      "items": [
        {
          "text": "yemwe amaona masomphenya wochokera kwa Wamphamvuzonse,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.4",
            "verseOrgIds": [
              "NUM.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:4"
      },
      "items": [
        {
          "text": "yemwe amagwa chafufumimba, koma maso ake ali chipenyere:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.4",
            "verseOrgIds": [
              "NUM.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Matenti ako ndi okongola kwambiri iwe Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.5",
            "verseOrgIds": [
              "NUM.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:5"
      },
      "items": [
        {
          "text": "misasa yako, iwe Israeli!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.5",
            "verseOrgIds": [
              "NUM.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Monga zigwa zotambalala,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:6"
      },
      "items": [
        {
          "text": "monga minda mʼmbali mwa mtsinje,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:6"
      },
      "items": [
        {
          "text": "monga aloe wodzalidwa ndi Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:6"
      },
      "items": [
        {
          "text": "monga mikungudza mʼmbali mwa madzi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzi adzayenderera mʼmitsuko yake;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:7"
      },
      "items": [
        {
          "text": "mbewu zake zidzakhala ndi madzi ambiri.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NUM 24:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:7"
      },
      "items": [
        {
          "text": "\"Mfumu yake idzakhala yamphamvu kuposa Agagi;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:7"
      },
      "items": [
        {
          "text": "ufumu wake udzakwezedwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mulungu womutulutsa mʼdziko la Igupto",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "ali ndi mphamvu ngati za njati.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "Amawononga mitundu yomuwukira",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "ndi kuphwanya mafupa awo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "amalasa ndi mivi yake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga mkango waumuna, amabisala nagona pansi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:9"
      },
      "items": [
        {
          "text": "monga mkango waukazi, adzamuputa ndani?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NUM 24:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:9"
      },
      "items": [
        {
          "text": "\"Amene adalitsa iwe, adalitsike",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:9"
      },
      "items": [
        {
          "text": "ndipo amene atemberera iwe, atembereredwe!\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Balaki anakwiyira Balaamu. Anawomba mʼmanja ndi kunena naye kuti, \"Ndinakuyitana kuti utemberere adani anga, koma taona, wawadalitsa katatu konseka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.10",
            "verseOrgIds": [
              "NUM.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano choka msanga uzipita kwanu! Ndinanena kuti ndidzakulipira bwino kwambiri, koma Yehova sanafune kuti ulandire malipirowo.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.11",
            "verseOrgIds": [
              "NUM.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu anayankha Balaki kuti, \"Kodi sindinawawuze amithenga amene munawatumiza kwa ine,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.12",
            "verseOrgIds": [
              "NUM.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti ngakhale Balaki atandipatsa nyumba yake yaufumu yodzaza ndi siliva ndi golide sindingathe kuchita zinthu mwa ine ndekha, zabwino kapena zoyipa, kuposa lamulo la Yehova ndi kuti ndiyenera kunena zokhazo zimene Yehova akunena?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano ndikupita kwa anthu anga, koma tabwerani ndikuchenjezeni zimene anthu awa adzachitira anthu anu masiku akubwerawa.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.14",
            "verseOrgIds": [
              "NUM.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uthenga Wachinayi wa Balaamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo iye ananena uthenga wake nati,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.15",
            "verseOrgIds": [
              "NUM.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:15"
      },
      "items": [
        {
          "text": "\"Uthenga wa Balaamu mwana wa Beori,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.15",
            "verseOrgIds": [
              "NUM.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:15"
      },
      "items": [
        {
          "text": "uthenga wa amene diso lake ndi lotsekuka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.15",
            "verseOrgIds": [
              "NUM.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uthenga wa amene amamva mawu a Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.16",
            "verseOrgIds": [
              "NUM.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:16"
      },
      "items": [
        {
          "text": "amene ali ndi nzeru zochokera kwa Wammwambamwamba,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.16",
            "verseOrgIds": [
              "NUM.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:16"
      },
      "items": [
        {
          "text": "amene amaona masomphenya wochokera kwa Wamphamvuzonse,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.16",
            "verseOrgIds": [
              "NUM.24.16"
            ]
          }
        }
      ]
    },
    {
