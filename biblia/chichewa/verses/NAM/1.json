  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "NAM 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NAM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uthenga wonena za Ninive. Buku la masomphenya a Nahumu wa ku Elikosi.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.1",
            "verseOrgIds": [
              "NAM.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mkwiyo wa Yehova pa Ninive",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NAM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ndi Mulungu wansanje",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:2"
      },
      "items": [
        {
          "text": "ndiponso wobwezera;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:2"
      },
      "items": [
        {
          "text": "Yehova amabwezera ndipo ndi waukali.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:2"
      },
      "items": [
        {
          "text": "Yehova amabwezera adani ake",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:2"
      },
      "items": [
        {
          "text": "ndipo ukali wake umakhala nthawi zonse pa adani akewo.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NAM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova sakwiya msanga koma ndi wa mphamvu yayikulu;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:3"
      },
      "items": [
        {
          "text": "ndipo sadzalola kuti munthu",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:3"
      },
      "items": [
        {
          "text": "wolakwa asalangidwe.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:3"
      },
      "items": [
        {
          "text": "Iye amayenda mʼkamvuluvulu ndi mʼnamondwe,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:3"
      },
      "items": [
        {
          "text": "ndipo mitambo ndi fumbi la ku mapazi ake.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NAM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalamulira nyanja ndipo imawuma;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:4"
      },
      "items": [
        {
          "text": "amawumitsa mitsinje yonse.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:4"
      },
      "items": [
        {
          "text": "Zomera za ku Basani ndi Karimeli zimawuma",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:4"
      },
      "items": [
        {
          "text": "ndipo maluwa a ku Lebanoni amafota.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NAM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapiri amagwedera pamaso pake",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:5"
      },
      "items": [
        {
          "text": "ndipo zitunda zimasungunuka.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:5"
      },
      "items": [
        {
          "text": "Dziko lapansi limanjenjemera pamaso pake,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:5"
      },
      "items": [
        {
          "text": "dziko lonse ndi zonse zokhala mʼmenemo.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani angathe kuyima pamaso pake Iye akalusa?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:6"
      },
      "items": [
        {
          "text": "Ndani angapirire mkwiyo wake woopsa?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:6"
      },
      "items": [
        {
          "text": "Ukali wake ukuyaka ngati moto;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:6"
      },
      "items": [
        {
          "text": "matanthwe akunyeka pamaso pake.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NAM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ndi wabwino,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.7",
            "verseOrgIds": [
              "NAM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:7"
      },
      "items": [
        {
          "text": "ndiye kothawirako nthawi ya masautso.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.7",
            "verseOrgIds": [
              "NAM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:7"
      },
      "items": [
        {
          "text": "Amasamalira amene amamudalira,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.7",
            "verseOrgIds": [
              "NAM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NAM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma ndi madzi achigumula choopsa",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.8",
            "verseOrgIds": [
              "NAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:8"
      },
      "items": [
        {
          "text": "Iye adzawononga adani ake (Ninive);",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.8",
            "verseOrgIds": [
              "NAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:8"
      },
      "items": [
        {
          "text": "adzapirikitsira adani ake ku malo a mdima.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.8",
            "verseOrgIds": [
              "NAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NAM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwembu chilichonse chimene akukonzekera kumuchitira Yehova",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.9",
            "verseOrgIds": [
              "NAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:9"
      },
      "items": [
        {
          "text": "adzachiwononga kotheratu;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.9",
            "verseOrgIds": [
              "NAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:9"
      },
      "items": [
        {
          "text": "msautso sudzabweranso kachiwiri.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.9",
            "verseOrgIds": [
              "NAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo adzakodwa mu ziyangoyango za minga",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.10",
            "verseOrgIds": [
              "NAM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:10"
      },
      "items": [
        {
          "text": "ndipo adzaledzera ndi vinyo wawo;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.10",
            "verseOrgIds": [
              "NAM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:10"
      },
      "items": [
        {
          "text": "adzatenthedwa ngati ziputu zowuma.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.10",
            "verseOrgIds": [
              "NAM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NAM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa iwe, Ninive, kunachokera munthu wa cholinga choyipa,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.11",
            "verseOrgIds": [
              "NAM.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:11"
      },
      "items": [
        {
          "text": "wofuna kuchitira Yehova chiwembu,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.11",
            "verseOrgIds": [
              "NAM.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:11"
      },
      "items": [
        {
          "text": "amene amapereka uphungu woyipa.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.11",
            "verseOrgIds": [
              "NAM.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NAM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.12",
            "verseOrgIds": [
              "NAM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:12"
      },
      "items": [
        {
          "text": "\"Ngakhale Asiriyawo ali ndi abwenzi,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.12",
            "verseOrgIds": [
              "NAM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:12"
      },
      "items": [
        {
          "text": "kaya iwowo ndi ambiri,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.12",
            "verseOrgIds": [
              "NAM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:12"
      },
      "items": [
        {
          "text": "koma adzawonongedwa ndi kutheratu.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.12",
            "verseOrgIds": [
              "NAM.1.12"
            ]
          }
