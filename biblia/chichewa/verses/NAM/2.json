  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "NAM 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kugwa kwa Ninive",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NAM 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wodzathira nkhondo akubwera",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "kudzalimbana nawe, Ninive.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "Tetezani malinga anu,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "dziyangʼanani ku msewu,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "konzekerani nkhondo,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "valani dzilimbe.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NAM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova adzabwezeretsa ulemerero wa Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "ngati ulemerero wa Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "ngakhale anthu owononga anawawononga kotheratu",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "ndipo anawononganso mpesa wawo.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NAM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zishango za ankhondo ake ndi zofiira;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "asilikali ake avala zovala zofiirira.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "Zitsulo za pa magaleta zikunyezimira",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "tsiku la kukonzekera kwake.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "Akuonetsa mikondo ya mkungudza yonoledwa.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NAM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaleta akuthamanga mʼmisewu",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "akungothamangathamanga pa mabwalo.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "Akuoneka ngati miyuni yoyaka;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "akuthamanga ngati chingʼaningʼani.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NAM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akuyitanitsa asilikali ake wolemekezeka,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "koma iwo akubwera napunthwa.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "Akuthamangira ku linga la mzinda;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "akuyimika chodzitchinjirizira pamalo pake.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atsekula zipata zotchinga madzi a mu mtsinje",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.6",
            "verseOrgIds": [
              "NAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:6"
      },
      "items": [
        {
          "text": "ndipo nyumba yaufumu yagwa.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.6",
            "verseOrgIds": [
              "NAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NAM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zatsimikizika kuti mzinda",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "utengedwa ndi kupita ku ukapolo.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "Akapolo aakazi akulira ngati nkhunda",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "ndipo akudziguguda pachifuwa.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NAM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninive ali ngati dziwe,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "ndipo madzi ake akutayika.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "Iwo akufuwula kuti, \"Imani! Imani!\"",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "Koma palibe amene akubwerera.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NAM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Funkhani siliva!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "Funkhani golide!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "Katundu wake ndi wochuluka kwambiri,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "chuma chochokera pa zinthu zake zamtengowapatali!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye wawonongedwa, wafunkhidwa ndipo wavulidwa!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:10"
      },
      "items": [
        {
          "text": "Mitima yasweka, mawondo akuwombana,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:10"
      },
      "items": [
        {
          "text": "anthu akunjenjemera ndipo",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:10"
      },
      "items": [
        {
          "text": "nkhope zasandulika ndi mantha.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NAM 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi tsopano dzenje la mikango lili kuti,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.11",
            "verseOrgIds": [
              "NAM.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:11"
      },
      "items": [
        {
          "text": "malo amene mikango inkadyetserako ana ake,",
