  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "MIC 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wolamulira Wochokera ku Betelehemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe mzinda wa anthu ankhondo, sonkhanitsa anthu ako ankhondo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:1"
      },
      "items": [
        {
          "text": "pakuti anthu atizungulira kuti alimbane nafe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:1"
      },
      "items": [
        {
          "text": "Adzakantha ndi ndodo pa chibwano",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:1"
      },
      "items": [
        {
          "text": "cha wolamulira wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koma iwe Betelehemu Efurata,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "ngakhale uli wonyozeka pakati pa mafuko a Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "mwa iwe mudzatuluka",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "munthu amene adzalamulira Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "amene chiyambi chake nʼchakalekale,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "nʼchamasiku amakedzana.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake Israeli adzasiyidwa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:3"
      },
      "items": [
        {
          "text": "mpaka pa nthawi imene mayi amene ali woyembekezera adzachire.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:3"
      },
      "items": [
        {
          "text": "Ndipo abale ake onse otsalira adzabwerera",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:3"
      },
      "items": [
        {
          "text": "kudzakhala pamodzi ndi Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzalimbika, ndipo adzaweta nkhosa zake",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:4"
      },
      "items": [
        {
          "text": "mwa mphamvu ya Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:4"
      },
      "items": [
        {
          "text": "mu ulemerero wa dzina la Yehova Mulungu wake.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:4"
      },
      "items": [
        {
          "text": "Ndipo iwo adzakhala mu mtendere,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:4"
      },
      "items": [
        {
          "text": "pakuti ukulu wake udzakhala ponseponse pa dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Iye adzakhala mtendere wawo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "MIC 5:5"
      },
      "items": [
        {
          "text": "Chipulumutso ndi Chiwonongeko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:5"
      },
      "items": [
        {
          "text": "Asiriya akadzalowa mʼdziko lathu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:5"
      },
      "items": [
        {
          "text": "ndi kuyamba kuthira nkhondo malo athu otetezedwa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:5"
      },
      "items": [
        {
          "text": "tidzawadzutsira abusa asanu ndi awiri,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:5"
      },
      "items": [
        {
          "text": "ngakhalenso atsogoleri asanu ndi atatu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo adzagonjetsa dziko la Asiriya ndi lupanga,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:6"
      },
      "items": [
        {
          "text": "dziko la Nimurodi adzalilamulira mwankhondo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:6"
      },
      "items": [
        {
          "text": "Adzatipulumutsa kwa Asiriya",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:6"
      },
      "items": [
        {
          "text": "akadzafika mʼmalire a mʼdziko lathu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:6"
      },
      "items": [
        {
          "text": "kudzatithira nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otsalira a Yakobo adzakhala",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "pakati pa mitundu yambiri ya anthu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "ngati mame ochokera kwa Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "ngati mvumbi pa udzu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "omwe sulamulidwa ndi munthu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "kapena kudikira lamulo la anthu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otsala a Yakobo adzakhala pakati pa mitundu ya anthu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:8"
      },
      "items": [
        {
          "text": "mʼgulu la anthu a mitundu yambiri,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:8"
      },
      "items": [
        {
          "text": "ngati mkango pakati pa nyama za mʼnkhalango.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:8"
      },
      "items": [
        {
          "text": "Ngati mwana wa mkango pakati pa gulu la nkhosa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:8"
      },
      "items": [
        {
          "text": "amene pozidutsa amazidya ndi kuzikhadzula,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:8"
      },
      "items": [
        {
          "text": "ndipo palibe angathe kuzilanditsa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudzagonjetsa adani anu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.9",
            "verseOrgIds": [
              "MIC.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
