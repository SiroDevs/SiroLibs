  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "MIC 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mlandu wa Yehova ndi Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamverani zimene Yehova akunena:",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:1"
      },
      "items": [
        {
          "text": "\"Nyamukani, fotokozani mlandu wanu pamaso pa mapiri;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:1"
      },
      "items": [
        {
          "text": "zitunda zimve zimene inu muti muyankhule.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imvani mlandu wa Yehova, inu mapiri;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "text": "tamverani, maziko amuyaya a dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "text": "Pakuti Yehova ali ndi mlandu ndi anthu ake;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "text": "Iye akutsutsa Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anthu anga, kodi ndakuchitirani chiyani?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.3",
            "verseOrgIds": [
              "MIC.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:3"
      },
      "items": [
        {
          "text": "Kodi ndakutopetsani bwanji? Ndiyankheni.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.3",
            "verseOrgIds": [
              "MIC.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndinakutulutsani ku dziko la Igupto",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "ndi kukuwombolani ku nyumba ya ukapolo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "Ndinatuma Mose kuti akutsogolereni,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "pamodzi ndi Aaroni ndi Miriamu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu anga, kumbukirani",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "zimene Balaki mfumu ya ku Mowabu inafuna kukuchitirani",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "ndiponso zimene Balaamu mwana wa Beori anayankha.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "Kumbukirani zomwe zinachitika pa ulendo wochoka ku Sitimu kupita ku Giligala,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "kuti mudziwe machitidwe olungama a Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ndidzatenga chiyani kupita nacho pamaso pa Yehova",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "ndi kukagwada pamaso pa Mulungu wakumwamba?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "Kodi ndidzabwera pamaso pake ndi nsembe yopsereza,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "ndi ana angʼombe a chaka chimodzi?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Yehova adzakondwera ndi nkhosa zazimuna 1,000,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "kapena ndi mitsinje yosalekeza ya mafuta?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "Kodi ndipereke nsembe mwana wanga woyamba kubadwa chifukwa cha zolakwa zanga?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "Chipatso cha thupi langa chifukwa cha tchimo la moyo wanga?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu iwe, Yehova wakuonetsa kale chimene chili chabwino.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "Tsono kodi Yehova akuyembekezera chiyani kwa iwe?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "Uzichita zolungama ndi kukonda chifundo",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "ndiponso kuyenda modzichepetsa pamaso pa Mulungu wako.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kulakwa kwa Israeli ndi Chilango chake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamverani! Yehova akuyitana anthu okhala mu mzinda",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:9"
      },
      "items": [
        {
          "text": "ndi nzeru kuopa dzina lanu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:9"
      },
      "items": [
        {
          "text": "\"Mverani mfumu ndi Iye amene anayikhazikitsa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu anthu oyipa, kodi Ine nʼkuyiwala",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.10",
            "verseOrgIds": [
              "MIC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:10"
      },
      "items": [
        {
          "text": "chuma chanu chimene munachipeza mwachinyengo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.10",
            "verseOrgIds": [
              "MIC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:10"
      },
      "items": [
        {
          "text": "ndiponso muyeso wanu woperewera umene ndi wotembereredwa?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.10",
            "verseOrgIds": [
              "MIC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ndimutenge ngati wosalakwa munthu amene ali ndi sikelo yachinyengo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.11",
            "verseOrgIds": [
              "MIC.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:11"
      },
      "items": [
        {
          "text": "ndiponso miyeso yabodza mʼthumba lake?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.11",
            "verseOrgIds": [
              "MIC.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu ake olemera amachita zachiwawa;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.12",
            "verseOrgIds": [
              "MIC.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:12"
      },
      "items": [
        {
          "text": "anthu ake ndi abodza",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.12",
            "verseOrgIds": [
              "MIC.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:12"
      },
