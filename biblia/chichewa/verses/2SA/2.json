  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "2SA 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Davide Adzozedwa Kukhala Mfumu ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patapita nthawi, Davide anafunsa Yehova kuti, \"Kodi ndipite ku umodzi mwa mizinda ya Yuda?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:1"
      },
      "items": [
        {
          "text": "Yehova anayankha kuti, \"Pita.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:1"
      },
      "items": [
        {
          "text": "Davide anafunsanso kuti, \"Kodi ndipite kuti?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:1"
      },
      "items": [
        {
          "text": "Yehova anayankha kuti, \"Ku Hebroni.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Davide anapita kumeneko ndi akazi ake awiri, Ahinoamu wa ku Yezireeli ndi Abigayeli mkazi wamasiye uja wa Nabala wa ku Karimeli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.2",
            "verseOrgIds": [
              "2SA.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anatenganso anthu amene anali nawo aliyense ndi banja lake, ndipo anakakhala ku midzi ya ku Hebroni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.3",
            "verseOrgIds": [
              "2SA.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka amuna a ku Yuda anabwera ku Hebroni ndipo kumeneko anadzoza Davide kukhala mfumu ya fuko la Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:4"
      },
      "items": [
        {
          "text": "Davide atawuzidwa kuti anthu a ku Yabesi Giliyadi ndi amene anayika mʼmanda Sauli,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "iye anatuma amithenga kwa anthu a ku Yabesi Giliyadi kuti akayankhule nawo kuti, \"Yehova akudalitseni poonetsa kukoma mtima kwanu kwa Sauli mbuye wanu pomuyika mʼmanda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.5",
            "verseOrgIds": [
              "2SA.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano Yehova akuonetseni kukoma mtima ndi kukhulupirika kwake ndipo inenso ndidzakukomerani mtima chifukwa munachita zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.6",
            "verseOrgIds": [
              "2SA.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano khalani amphamvu ndi olimba mtima, pakuti Sauli mbuye wanu wafa, ndipo fuko la Yuda landidzoza kukhala mfumu yawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.7",
            "verseOrgIds": [
              "2SA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkhondo Pakati pa Otsatira Davide ndi Otsatira Sauli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi imeneyi Abineri mwana wa Neri, wolamulira ankhondo a Sauli, anatenga Isi-Boseti mwana wa Sauli ndi kubwera naye ku Mahanaimu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.8",
            "verseOrgIds": [
              "2SA.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anamuyika kuti akhale mfumu yoyangʼanira Giliyadi, Asuri ndi Yezireeli, pamodzi ndi Efereimu, Benjamini ndi Israeli yense.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.9",
            "verseOrgIds": [
              "2SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isi-Boseti mwana wa Sauli anali wa zaka makumi anayi pamene anakhala mfumu ya Israeli ndipo analamulira zaka ziwiri. Koma fuko la Yuda linatsatira Davide.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.10",
            "verseOrgIds": [
              "2SA.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anakhala mfumu ku Hebroni akulamulira fuko la Yuda, kwa zaka zisanu ndi chimodzi ndi miyezi isanu ndi umodzi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.11",
            "verseOrgIds": [
              "2SA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abineri mwana wa Neri, pamodzi ndi ankhondo a Isi-Boseti mwana wa Sauli, anachoka ku Mahanaimu ndi kupita ku Gibiyoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.12",
            "verseOrgIds": [
              "2SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabu mwana wa Zeruya pamodzi ndi ankhondo a Davide anapita ndi kukakumana nawo ku dziwe la ku Gibiyoni. Gulu lina linakhala mbali ina ya dziwelo pamene gulu lina linakhala mbali inayo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.13",
            "verseOrgIds": [
              "2SA.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Abineri anati kwa Yowabu, \"Tiye tibweretse ena mwa anyamata athu kuti amenyane patsogolo pathupa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.14",
            "verseOrgIds": [
              "2SA.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:14"
      },
      "items": [
        {
          "text": "Yowabu anayankha, \"Chabwino, amenyane.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.14",
            "verseOrgIds": [
              "2SA.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero anayimirira ndipo anawawerenga: anyamata khumi ndi awiri a fuko la Benjamini ndi Isi-Boseti mwana wa Sauli ndiponso anyamata khumi ndi awiri a Davide.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.15",
            "verseOrgIds": [
              "2SA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono aliyense anagwira mutu wa mnzake namubaya mnzakeyo mʼnthiti ndi mpeni ndipo onse anagwera pansi limodzi. Kotero malo amenewo ku Gibiyoni amatchedwa Helikati Hazurimu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.16",
            "verseOrgIds": [
              "2SA.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limeneli nkhondo yake inali yoopsa kwambiri, ndipo Abineri ndi ankhondo a Israeli anagonjetsedwa ndi ankhondo a Davide.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.17",
            "verseOrgIds": [
              "2SA.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana atatu aamuna a Zeruya, Yowabu, Abisai ndi Asaheli anali komweko. Koma Asaheli anali waliwiro ngati insa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.18",
            "verseOrgIds": [
              "2SA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anathamangitsa Abineri ndipo sanakhotere kumanja kapena kumanzere pamene amamutsatira.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.19",
            "verseOrgIds": [
              "2SA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abineri anayangʼana mʼmbuyo ndipo anafunsa, \"Kodi ndiwe Asaheli?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.20",
            "verseOrgIds": [
              "2SA.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:20"
      },
      "items": [
        {
          "text": "Iye anayankha kuti, \"Ndine.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.20",
            "verseOrgIds": [
              "2SA.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Abineri anati kwa iye, \"Khotera kumanja kapena kumanzere: tsatira mmodzi mwa anyamatawa ndipo umulande zida zake.\" Koma Asaheli sanasiye kumuthamangitsa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.21",
            "verseOrgIds": [
              "2SA.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abineri anamuchenjezanso Asaheli, \"Siya kuthamangitsa ine! Kodi ndikukanthe chifukwa chiyani? Kodi ndikaonana naye bwanji mʼbale wako Yowabu?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.22",
            "verseOrgIds": [
              "2SA.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma iye anakana kuleka kumuthamangitsa. Choncho Abineri anabaya Asaheli mʼmimba ndi msonga ya mkondo wake ndipo mkondowo unatulukira mbali ina. Iye anagwa ndi kufera pamalo pomwepo. Ndipo munthu aliyense amayima akafika pamalo pamene anagwera ndi kufa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.23",
            "verseOrgIds": [
              "2SA.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yowabu ndi Abisai anathamangitsa Abineri, ndipo dzuwa likulowa, anafika ku phiri la Ama, pafupi ndi Giya pa njira yopita ku chipululu cha ku Gibiyoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.24",
            "verseOrgIds": [
              "2SA.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo anthu a fuko la Benjamini anasonkhana kudzathandiza Abineri. Iwo anapanga gulu ndipo anayima pamwamba pa phiri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.25",
            "verseOrgIds": [
              "2SA.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abineri anayitana Yowabu, \"Kodi tipitirize kumenyana mpaka kalekale? Kodi sukuzindikira kuti mathero ake kudzakhala kuwawidwa mitima? Kodi udzawaletsa liti ankhondo ako kuthamangitsa abale awo?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.26",
            "verseOrgIds": [
              "2SA.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabu anayankha kuti, \"Pali Yehova wamoyo, ukanapanda kuyankhula, ankhondo anga akanapitiriza kuthamangitsa abale awo mpaka mmawa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.27",
            "verseOrgIds": [
              "2SA.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chomwecho Yowabu analiza lipenga, ndipo ankhondo onse anayima. Iwo analeka kuthamangitsa Aisraeli kapena kumenyana nawo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.28",
            "verseOrgIds": [
              "2SA.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku wonsewo Abineri ndi ankhondo ake anayenda kudutsa Araba. Iwo anawoloka Yorodani, napitirira mpaka kudutsa dera lonse la Bitironi ndipo anafika ku Mahanaimu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.29",
            "verseOrgIds": [
              "2SA.2.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yowabu anabwerera kuchokera kothamangitsa Abineri ndipo anasonkhanitsa ankhondo ake onse. Kupatula Asaheli, panali ankhondo khumi ndi anayi a Davide amene anasowa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.30",
            "verseOrgIds": [
              "2SA.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ankhondo a Davide anapha ankhondo a fuko la Benjamini 360 amene anali ndi Abineri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.31",
            "verseOrgIds": [
              "2SA.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anatenga Asaheli ndi kukamuyika mʼmanda a abambo ake ku Betelehemu. Ndipo Yowabu ndi ankhondo ake anayenda usiku wonse ndi kufika ku Hebroni kukucha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.32",
            "verseOrgIds": [
              "2SA.2.32"
            ]
          }
        }
      ]
    }
  ],
