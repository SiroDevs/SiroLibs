  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "2SA 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawu Otsiriza a Davide",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawa mawu otsiriza a Davide:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:1"
      },
      "items": [
        {
          "text": "\"Mawu a Davide mwana wa Yese,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:1"
      },
      "items": [
        {
          "text": "mawu a munthu amene wakwezedwa ndi Wammwambamwamba,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:1"
      },
      "items": [
        {
          "text": "munthu wodzozedwa ndi Mulungu wa Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:1"
      },
      "items": [
        {
          "text": "woyimba nyimbo za Israeli:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mzimu wa Yehova unayankhula kudzera mwa ine;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.2",
            "verseOrgIds": [
              "2SA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:2"
      },
      "items": [
        {
          "text": "mawu ake anali pakamwa panga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.2",
            "verseOrgIds": [
              "2SA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu wa Israeli anayankhula,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:3"
      },
      "items": [
        {
          "text": "Thanthwe la Israeli linati kwa ine:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:3"
      },
      "items": [
        {
          "text": "'Pamene munthu alamulira anthu mwachilungamo,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:3"
      },
      "items": [
        {
          "text": "pamene alamulira moopa Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "amakhala ngati kuwala kwa mmamawa,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.4",
            "verseOrgIds": [
              "2SA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:4"
      },
      "items": [
        {
          "text": "mmawa wopanda mitambo,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.4",
            "verseOrgIds": [
              "2SA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:4"
      },
      "items": [
        {
          "text": "monga kuwala pamene mvula yaleka kugwa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.4",
            "verseOrgIds": [
              "2SA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:4"
      },
      "items": [
        {
          "text": "imene imameretsa udzu mʼnthaka.'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.4",
            "verseOrgIds": [
              "2SA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi banja langa silolungama pamaso pa Mulungu?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:5"
      },
      "items": [
        {
          "text": "Kodi Iye sanachite pangano losatha ndi ine,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:5"
      },
      "items": [
        {
          "text": "lokonzedwa ndi lotetezedwa mbali zonse?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:5"
      },
      "items": [
        {
          "text": "Kodi sadzakwaniritsa chipulumutso changa,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:5"
      },
      "items": [
        {
          "text": "ndi kundipatsa chokhumba changa chilichonse?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma anthu oyipa ndiwo ayenera kutayidwa kunja ngati minga,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.6",
            "verseOrgIds": [
              "2SA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:6"
      },
      "items": [
        {
          "text": "imene sitengedwa ndi manja.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.6",
            "verseOrgIds": [
              "2SA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliyense amene wayikhudza mingayo",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.7",
            "verseOrgIds": [
              "2SA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:7"
      },
      "items": [
        {
          "text": "amayidula pogwiritsa ntchito chigwandali kapena ndodo ya mkondo;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.7",
            "verseOrgIds": [
              "2SA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:7"
      },
      "items": [
        {
          "text": "nayitentha pa moto.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.7",
            "verseOrgIds": [
              "2SA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ankhondo Otchuka a Davide",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawa mayina a ankhondo amphamvu a Davide:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.8",
            "verseOrgIds": [
              "2SA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 23:8"
      },
      "items": [
        {
          "text": "Yosebu-Basebeti wa ku Takemoni mkulu wa atsogoleri a ankhondo atatu. Iye anapha ndi mkondo ankhondo 800 nthawi imodzi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.8",
            "verseOrgIds": [
              "2SA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wotsatana naye anali Eliezara mwana wa Dodo Mwahohi. Monga mmodzi mwa ankhondo atatu amphamvu a Davide, iye anali ndi Davide pamene anazunza Afilisti amene anasonkhana ku Pasi-Damimu kuchita nkhondo. Kenaka ankhondo a Israeli anabwerera mʼmbuyo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.9",
            "verseOrgIds": [
              "2SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma iye anayima osasuntha ndipo anakantha Afilisti mpaka mkono wake unatopa ndipo unakanirira ku lupanga lake. Yehova anapereka chigonjetso chachikulu pa tsiku limenelo. Asilikali anabwerera kwa Eliezara, kukatenga katundu wa anthu ophedwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.10",
            "verseOrgIds": [
              "2SA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wotsatana naye anali Sama mwana wa Age Mharari. Pamene Afilisti anasonkhana pamalo pamene panali munda wa mphodza, ankhondo a Israeli anathawa Afilistiwo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.11",
            "verseOrgIds": [
              "2SA.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Sama anayima pakati pa mundawo. Iye anawuteteza nakantha Afilistiwo ndipo Yehova anawapambanitsa koposa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.12",
            "verseOrgIds": [
              "2SA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi yokolola, atatu mwa atsogoleri makumi atatu anabwera kwa Davide ku phanga la Adulamu, pamene gulu la Afilisti linali litamanga misasa mʼchigwa cha Refaimu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.13",
            "verseOrgIds": [
              "2SA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi imeneyo Davide anali mu linga, ndipo boma la Afilisti linali ku Betelehemu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.14",
            "verseOrgIds": [
              "2SA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide analakalaka madzi ndipo anati, \"Haa, pakanapezeka munthu wokanditungira madzi a mʼchitsime chomwe chili pafupi ndi chipata cha ku Betelehemu!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.15",
            "verseOrgIds": [
              "2SA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho anthu amphamvu atatuwa anadutsa mizere ya Afilisti, natunga madzi amene anali mʼchitsime chomwe chinali pafupi ndi chipata cha ku Betelehemu nabwera nawo kwa Davide. Koma iye anakana kumwa. Mʼmalo mwake anathira pansi pamaso pa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.16",
            "verseOrgIds": [
              "2SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anati, \"Inu Yehova, musalole kuti ine ndichite chinthu ichi! Kodi awa si magazi a anthu amene anayika miyoyo yawo pachiswe?\" Ndipo Davide sanamwe madziwo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.17",
            "verseOrgIds": [
              "2SA.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 23:17"
      },
      "items": [
        {
          "text": "Zimenezi ndi zimene anachita anthu amphamvu atatuwo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.17",
            "verseOrgIds": [
              "2SA.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisai mʼbale wa Yowabu mwana wa Zeruya ndiye anali mtsogoleri wa anthu atatuwa. Iye anapha ndi mkondo ankhondo 300, choncho iyeyo anali wotchuka pakati pa anthu atatu aja.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.18",
            "verseOrgIds": [
              "2SA.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi iyeyo sanali wolemekezeka koposa? Iye anakhala mtsogoleri wawo ngakhale kuti sanali mʼgulu la anthu atatu aja.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.19",
            "verseOrgIds": [
              "2SA.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya mwana wa Yehoyada wa ku Kabizeeli anali munthu wolimba mtima amene anachita zinthu zamphamvu. Iye anakantha ankhondo awiri otchuka a ku Mowabu. Tsiku lina kukuzizira kwambiri, iye analowa mʼdzenje ndi kuphamo mkango.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.20",
            "verseOrgIds": [
              "2SA.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo iye anakanthanso Mwigupto wamkulu msinkhu. Ngakhale kuti Mwiguptoyo anali ndi mkondo mʼdzanja mwake, Benaya anapita kukamenyana naye ali ndi chibonga chokha mʼmanja. Iye analanda mkondo mʼdzanja la Mwiguptoyo ndi kumupha ndi mkondo wake womwe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.21",
            "verseOrgIds": [
              "2SA.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izi ndi zamphamvu zimene Benaya mwana wa Yehoyada anachita. Iyeyo analinso wotchuka ngati anthu atatu amphamvu aja.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.22",
            "verseOrgIds": [
              "2SA.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ankalemekezedwa kuposa wina aliyense mwa anthu makumi atatu aja, koma sanali mʼgulu la anthu atatu aja. Ndipo Davide anamuyika kukhala woyangʼanira asilikali omuteteza.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.23",
            "verseOrgIds": [
              "2SA.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
