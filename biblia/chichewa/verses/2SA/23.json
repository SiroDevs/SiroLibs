      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "2SA 23:24"
      },
      "items": [
        {
          "text": "Elihanani mwana wa Dodo wa ku Betelehemu,",
          "type": "text"
        }
      ]
    },
