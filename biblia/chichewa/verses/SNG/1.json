  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "SNG 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyimbo ya Solomoni, nyimbo yoposa nyimbo zonse.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.1",
            "verseOrgIds": [
              "SNG.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mkazi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Undipsompsone ndi milomo yako",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.2",
            "verseOrgIds": [
              "SNG.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:2"
      },
      "items": [
        {
          "text": "chifukwa chikondi chako nʼchokoma kuposa vinyo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.2",
            "verseOrgIds": [
              "SNG.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuta ako odzola ndi onunkhira bwino;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.3",
            "verseOrgIds": [
              "SNG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:3"
      },
      "items": [
        {
          "text": "dzina lako lili ngati mafuta onunkhira otsanulidwa.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.3",
            "verseOrgIds": [
              "SNG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:3"
      },
      "items": [
        {
          "text": "Nʼchifukwa chake atsikana amakukonda!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.3",
            "verseOrgIds": [
              "SNG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nditenge ndipo ndizikutsata, tiye tifulumire!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "Mfumu indilowetse mʼchipinda chake.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "Abwenzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "Ife timasangalala ndi kukondwera nawe,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "tidzatamanda chikondi chako kupambana vinyo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "Mkazi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "Amachita bwinotu potamanda iwe!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndine wakuda, komatu ndine wokongola,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:5"
      },
      "items": [
        {
          "text": "inu akazi a ku Yerusalemu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:5"
      },
      "items": [
        {
          "text": "ine ndine wakuda ngati tenti ya ku Kedara,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:5"
      },
      "items": [
        {
          "text": "ngati makatani a tenti ya Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musandiyangʼane monyoza chifukwa ndine wakuda,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:6"
      },
      "items": [
        {
          "text": "ndine wakuda chifukwa cha dzuwa.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:6"
      },
      "items": [
        {
          "text": "Alongo anga anandikwiyira",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:6"
      },
      "items": [
        {
          "text": "ndipo anandigwiritsa ntchito mʼminda ya mpesa;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:6"
      },
      "items": [
        {
          "text": "munda wangawanga sindinawusamalire.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiwuze iwe, amene ndimakukonda, kumene umadyetsa ziweto zako",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:7"
      },
      "items": [
        {
          "text": "ndi kumene umagoneka nkhosa zako nthawi yamasana.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:7"
      },
      "items": [
        {
          "text": "Ndikhalirenji ngati mkazi wachiwerewere",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:7"
      },
      "items": [
        {
          "text": "pambali pa ziweto za abwenzi ako?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Abwenzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati sukudziwa iwe wokongola kwambiri kuposa akazi ena,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:8"
      },
      "items": [
        {
          "text": "ngati sukudziwa, tsatira makwalala a nkhosa",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:8"
      },
      "items": [
        {
          "text": "ndipo udyetse ana ambuzi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:8"
      },
      "items": [
        {
          "text": "pambali pa matenti a abusa.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mwamuna",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe bwenzi langa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.9",
            "verseOrgIds": [
              "SNG.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:9"
      },
      "items": [
        {
          "text": "uli ngati kavalo wamkazi ku magaleta a Farao.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.9",
            "verseOrgIds": [
              "SNG.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masaya ako ndi okongola ndi ndolo zamʼmakutuzo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.10",
            "verseOrgIds": [
              "SNG.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:10"
      },
      "items": [
        {
          "text": "khosi lako likukongola ndi mikanda yamiyala yamtengowapatali.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.10",
            "verseOrgIds": [
              "SNG.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tidzakupangira ndolo zagolide",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.11",
            "verseOrgIds": [
              "SNG.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:11"
      },
      "items": [
        {
          "text": "zokongoletsedwa ndi mikanda yasiliva.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.11",
            "verseOrgIds": [
              "SNG.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mkazi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene mfumu inali pa malo ake odyera,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.12",
            "verseOrgIds": [
              "SNG.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:12"
      },
      "items": [
        {
          "text": "mafuta anga onunkhira anamveka fungo lake.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.12",
            "verseOrgIds": [
              "SNG.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wokondedwa wanga ali ngati kathumba ka mure kwa ine,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.13",
            "verseOrgIds": [
              "SNG.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:13"
      },
