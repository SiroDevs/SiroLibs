          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamenepo ndidzawawuza momveka bwino kuti, 'Sindinakudziweni inu. Chokani kwa Ine, inu ochita zoyipa!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.23",
                "verseOrgIds": [
                  "MAT.7.23"
                ]
              }
            }
          ]
