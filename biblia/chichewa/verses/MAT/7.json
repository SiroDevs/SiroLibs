        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mvula inagwa, mitsinje inadzaza, ndi mphepo zinawomba pa nyumbayo; koma sinagwe, chifukwa maziko ake anali pa thanthwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.25",
                "verseOrgIds": [
                  "MAT.7.25"
                ]
              }
            }
