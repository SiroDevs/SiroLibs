        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nʼchifukwa chake aliyense amene amva mawu anga ndi kuwachita akufanana ndi munthu wanzeru amene anamanga nyumba yake pa thanthwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.24",
                "verseOrgIds": [
                  "MAT.7.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.24",
            "verseOrgIds": [
              "MAT.7.24"
            ]
