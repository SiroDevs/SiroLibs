              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mvula inagwa, mitsinje inadzaza, ndi mphepo zinawomba pa nyumbayo, ndipo inagwa ndipo kugwa kwake kunali kwakukulu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.27",
