          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma aliyense amene amva mawu angawa ndi kusawachita ali ngati munthu wopusa amene anamanga nyumba yake pa mchenga.",
