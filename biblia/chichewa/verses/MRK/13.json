    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koma masiku amenewo, masautsowo atatha,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.24",
                "verseOrgIds": [
                  "MRK.13.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 13:24"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'dzuwa lidzada,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.24",
                "verseOrgIds": [
                  "MRK.13.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 13:24"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ndipo mwezi sudzawala;",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.24",
                "verseOrgIds": [
                  "MRK.13.24"
                ]
              }
            }
          ]
        }
      ]
