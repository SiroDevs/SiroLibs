    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nyenyezi zidzagwa kuchokera ku thambo,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.25",
                "verseOrgIds": [
                  "MRK.13.25"
                ]
              }
            }
