        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ndipo mayiko mumlengalenga adzagwedezeka!'",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.25",
                "verseOrgIds": [
                  "MRK.13.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nthawi imeneyo anthu adzaona Mwana wa Munthu akubwera mʼmitambo ndi mphamvu yayikulu ndi ulemerero.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.26",
                "verseOrgIds": [
                  "MRK.13.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.26",
            "verseOrgIds": [
              "MRK.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo adzatuma angelo ake kukasonkhanitsa osankhidwiratu ake ku mphepo zinayi, kuyambira kumalekezero a dziko lapansi mpaka ku malekezero ake enanso.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.27",
                "verseOrgIds": [
                  "MRK.13.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tsopano phunzirani phunziro ili kuchokera ku mtengo wamkuyu. Pamene msonga za nthambi zake zikhala za nthete ndipo masamba ake ayamba kuphukira, mumadziwa kuti dzinja layandikira.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.28",
                "verseOrgIds": [
                  "MRK.13.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.28",
            "verseOrgIds": [
              "MRK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Momwenso pamene muona zinthu izi zikuchitika, dziwani kuti wayandikira, ali pa khomo.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.29",
                "verseOrgIds": [
                  "MRK.13.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.29",
            "verseOrgIds": [
              "MRK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zoonadi, Ine ndikuwuzani kuti mʼbado uno sudzatha mpaka zinthu zonsezi zitachitika.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.30",
                "verseOrgIds": [
                  "MRK.13.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.30",
            "verseOrgIds": [
              "MRK.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kumwamba ndi dziko lapansi zidzatha, koma mawu anga sadzatha.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.31",
                "verseOrgIds": [
                  "MRK.13.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tsiku ndi Ora Sizikudziwika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Palibe amene akudziwa za tsikulo kapena nthawi, ngakhale angelo akumwamba, kapena Mwana, koma Atate wokha.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.32",
                "verseOrgIds": [
                  "MRK.13.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.32",
            "verseOrgIds": [
              "MRK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Khalani maso! Khalani tcheru! Simudziwa pamene nthawi imeneyo idzafike.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.33",
                "verseOrgIds": [
                  "MRK.13.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.33",
            "verseOrgIds": [
              "MRK.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zili ngati munthu amene akuchokapo. Amasiyira nyumba yake antchito ake, aliyense ndi ntchito yake; ndi kumuwuza wa pa khomo kuti azikhala maso.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.34",
                "verseOrgIds": [
                  "MRK.13.34"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Inunso muyenera kukhala maso chifukwa simukudziwa nthawi imene mwini nyumba adzabwere, kaya madzulo, kapena pakati pa usiku, kapena tambala akulira, kapena mʼbandakucha.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.35",
                "verseOrgIds": [
                  "MRK.13.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.35",
            "verseOrgIds": [
              "MRK.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati atabwera mwadzidzidzi, asadzakupezeni inu muli mtulo.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.36",
                "verseOrgIds": [
                  "MRK.13.36"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.36",
            "verseOrgIds": [
              "MRK.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zimene ndikunena kwa inu, ndikunena kwa aliyense: 'Khalani tcheru!' \"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.37",
                "verseOrgIds": [
                  "MRK.13.37"
                ]
              }
            }
          ]
        }
