        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Choncho khalani tcheru; ndakuwuzani zonse nthawi isanafike.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.23",
                "verseOrgIds": [
                  "MRK.13.23"
                ]
              }
            }
          ]
