  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "MRK 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zizindikiro za Kutha kwa Masiku Yomaliza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye atachoka mʼNyumba ya Mulungu, mmodzi wa ophunzira ake anati kwa Iye, \"Aphunzitsi taonani! Miyala ikuluikulu! Nyumba zikongolerenji!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.1",
            "verseOrgIds": [
              "MRK.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.2",
            "verseOrgIds": [
              "MRK.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi mukuziona nyumba zikuluzikuluzi? Palibe mwala ndi umodzi pano umene udzakhala pa unzake; uliwonse udzagwetsedwa pansi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.2",
                "verseOrgIds": [
                  "MRK.13.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu atakhala pansi pa phiri la Olivi moyangʼanana ndi Nyumba ya Mulungu, Petro, Yakobo, Yohane ndi Andreya anamufunsa Iye pambali kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.3",
            "verseOrgIds": [
              "MRK.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tatiwuzani, izi zidzachitika liti? Nanga chizindikiro chakuti zatsala pangʼono kukwaniritsidwa chidzakhala chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.4",
            "verseOrgIds": [
              "MRK.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anawawuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.5",
            "verseOrgIds": [
              "MRK.13.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chenjerani kuti wina asakunyengeni.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.5",
                "verseOrgIds": [
                  "MRK.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.5",
            "verseOrgIds": [
              "MRK.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Anthu ambiri adzabwera mʼdzina langa, nadzati, 'Ine ndi Iyeyo,' ndipo adzanamiza anthu ambiri.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.6",
                "verseOrgIds": [
                  "MRK.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.6",
            "verseOrgIds": [
              "MRK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamene mudzamva zankhondo ndi mbiri zankhondo, musadzadzidzimuke. Zinthu zotere ziyenera kuchitika, koma sikuti chimaliziro chafika kale ayi.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.7",
                "verseOrgIds": [
                  "MRK.13.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.7",
            "verseOrgIds": [
              "MRK.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mtundu udzawukira mtundu unzake, ndi ufumu kuwukira ufumu unzake. Kudzakhala zivomerezi mʼmalo osiyanasiyana, ndi njala. Izi ndi chiyambi chabe cha zowawa monga mayi pobereka.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.8",
                "verseOrgIds": [
                  "MRK.13.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Muyenera kukhala tcheru. Mudzaperekedwa ku mabwalo oweruza ndi kukwapulidwa mwankhanza mʼmasunagoge. Mudzayima pamaso pa abwanamkubwa ndi mafumu monga mboni kwa iwo chifukwa cha Ine.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.9",
                "verseOrgIds": [
                  "MRK.13.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.9",
            "verseOrgIds": [
              "MRK.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo Uthenga Wabwino uyenera kuyamba walalikidwa kwa anthu a mitundu yonse.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.10",
                "verseOrgIds": [
                  "MRK.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.10",
            "verseOrgIds": [
              "MRK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nthawi iliyonse pamene mwamangidwa ndi kuyimbidwa mlandu, musadandaule za zimene mudzanena. Zimene mudzapatsidwe pa nthawiyo yankhulani; pakuti sindinu amene mudzayankhula, koma Mzimu Woyera.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.11",
                "verseOrgIds": [
                  "MRK.13.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mʼbale adzapereka mʼbale kuti aphedwe, ndipo abambo adzapereka mwana wawo. Ana adzawukira makolo awo ndi kuwapereka kuti aphedwe.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.12",
                "verseOrgIds": [
                  "MRK.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.12",
            "verseOrgIds": [
              "MRK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Anthu onse adzakudani chifukwa cha Ine, koma amene adzalimbika mpaka potsiriza, ameneyo ndiye adzapulumuke.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.13",
                "verseOrgIds": [
                  "MRK.13.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mukadzaona 'chinthu chonyansa chosakaza' chitayima pa malo amene si ake, owerenga azindikire. Pamenepo amene ali ku Yudeya athawire kumapiri.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.14",
                "verseOrgIds": [
                  "MRK.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.14",
            "verseOrgIds": [
              "MRK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Aliyense amene ali pa denga la nyumba yake asatsike kapena kulowa mʼnyumba kukatenga kanthu kalikonse.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.15",
                "verseOrgIds": [
                  "MRK.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.15",
            "verseOrgIds": [
              "MRK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Aliyense amene ali ku munda asabwerere kukatenga mkanjo wake.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.16",
                "verseOrgIds": [
                  "MRK.13.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.16",
            "verseOrgIds": [
              "MRK.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kudzakhala koopsa mʼmasiku amenewo kwa amayi oyembekezera ndi amayi oyamwitsa!",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.17",
                "verseOrgIds": [
                  "MRK.13.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.17",
            "verseOrgIds": [
              "MRK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pempherani kuti zimenezi zisadzachitike nthawi yozizira,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.18",
                "verseOrgIds": [
                  "MRK.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.18",
            "verseOrgIds": [
              "MRK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "chifukwa masiku amenewo adzakhala owawitsa osafanana ndi ena kuyambira pachiyambi, pamene Mulungu analenga dziko, kufikira lero ndipo sadzafanananso ndi ena.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.19",
                "verseOrgIds": [
                  "MRK.13.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.19",
            "verseOrgIds": [
              "MRK.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ambuye akanapanda kufupikitsa masikuwo, palibe amene akanapulumuka. Koma chifukwa cha osankhidwiratu, amene anawasankha, Iye anawafupikitsa.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.20",
                "verseOrgIds": [
                  "MRK.13.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.20",
            "verseOrgIds": [
              "MRK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pa nthawi imeneyo, ngati wina adzati kwa inu, 'Taonani, Khristu ali kuno, kapena, Taonani, uyo ali apoyo!' musakhulupirire.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.21",
                "verseOrgIds": [
                  "MRK.13.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.21",
            "verseOrgIds": [
              "MRK.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti akhristu onama ndi aneneri onama adzaonekera ndipo adzachita zizindikiro ndi zodabwitsa kuti anyenge osankhidwiratu ngati kutakhala kotheka kutero.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.22",
                "verseOrgIds": [
                  "MRK.13.22"
                ]
              }
            }
          ]
        },
