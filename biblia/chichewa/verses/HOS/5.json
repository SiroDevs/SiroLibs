  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "HOS 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiweruzo cha Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ansembe inu, imvani izi!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "Inu Aisraeli, tcherani khutu!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "Inu nyumba yaufumu, mvetserani!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "Chiweruzo ichi ndi chotsutsa inu:",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "Inu munali ngati msampha ku Mizipa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "munali ngati ukonde woyalidwa pa phiri la Tabori.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owukira azama mʼmoyo wakupha,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.2",
            "verseOrgIds": [
              "HOS.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:2"
      },
      "items": [
        {
          "text": "Ine ndidzawalanga onsewo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.2",
            "verseOrgIds": [
              "HOS.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimadziwa zonse za Efereimu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:3"
      },
      "items": [
        {
          "text": "Aisraeli ndi osabisika kwa Ine.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:3"
      },
      "items": [
        {
          "text": "Efereimu wayamba tsopano kuchita zachiwerewere;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:3"
      },
      "items": [
        {
          "text": "Israeli wadziyipitsa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ntchito zawo siziwalola",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:4"
      },
      "items": [
        {
          "text": "kubwerera kwa Mulungu wawo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:4"
      },
      "items": [
        {
          "text": "Mʼmitima mwawo muli mzimu wachiwerewere;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:4"
      },
      "items": [
        {
          "text": "Iwo sadziwa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudzikuza kwa Israeli kwakhala umboni womutsutsa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:5"
      },
      "items": [
        {
          "text": "Aisraeli, ngakhale Aefereimu, anagwa mʼmachimo awo;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:5"
      },
      "items": [
        {
          "text": "Yudanso anagwa nawo pamodzi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene adzapita ndi nkhosa zawo ndi ngʼombe zawo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:6"
      },
      "items": [
        {
          "text": "kukapereka nsembe kwa Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:6"
      },
      "items": [
        {
          "text": "iwo sadzamupeza;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:6"
      },
      "items": [
        {
          "text": "Iye wawachokera.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo ndi osakhulupirika kwa Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:7"
      },
      "items": [
        {
          "text": "amabereka ana amʼchigololo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:7"
      },
      "items": [
        {
          "text": "ndipo chikondwerero chawo cha mwezi watsopano",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:7"
      },
      "items": [
        {
          "text": "chidzawawononga pamodzi ndi minda yawo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Womba lipenga mu Gibeya,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:8"
      },
      "items": [
        {
          "text": "liza mbetete mu Rama.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:8"
      },
      "items": [
        {
          "text": "Fuwulani mfuwu wankhondo mu Beti-Aveni;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:8"
      },
      "items": [
        {
          "text": "iwe Benjamini tsogolera.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efereimu adzasanduka bwinja",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:9"
      },
      "items": [
        {
          "text": "pa tsiku la chilango.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:9"
      },
      "items": [
        {
          "text": "Ine ndikulengeza zomwe zidzachitikadi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:9"
      },
      "items": [
        {
          "text": "pakati pa mafuko a Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atsogoleri a Yuda ali ngati anthu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.10",
            "verseOrgIds": [
              "HOS.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:10"
      },
      "items": [
        {
          "text": "amene amasuntha miyala ya mʼmalire.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.10",
            "verseOrgIds": [
              "HOS.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:10"
      },
      "items": [
        {
          "text": "Ndidzawakhutulira ukali wanga",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.10",
            "verseOrgIds": [
              "HOS.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:10"
      },
      "items": [
        {
          "text": "ngati madzi a chigumula.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.10",
            "verseOrgIds": [
              "HOS.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efereimu waponderezedwa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.11",
            "verseOrgIds": [
              "HOS.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:11"
      },
      "items": [
        {
          "text": "akulangidwa chifukwa chotsatira",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.11",
            "verseOrgIds": [
              "HOS.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:11"
      },
      "items": [
        {
          "text": "mafano.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.11",
            "verseOrgIds": [
              "HOS.5.11"
            ]
          }
        }
      ]
    },
    {
