  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "HOS 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehova Ayimba Mlandu Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Aisraeli, imvani mawu a Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "chifukwa Yehova ali ndi mlandu ndi inu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "amene mumakhala mʼdzikoli:",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "\"Mʼdziko mwanu mulibe kukhulupirika, mulibe chikondi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "mulibe kulabadira za Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muli kutemberera kokha, kunama ndi kupha.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:2"
      },
      "items": [
        {
          "text": "Kuba ndi kuchita chigololo;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:2"
      },
      "items": [
        {
          "text": "machimo achita kunyanya",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:2"
      },
      "items": [
        {
          "text": "ndipo akungokhalira kuphana.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa chake dziko likulira",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "ndipo onse amene amakhalamo akuvutika;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "zirombo zakuthengo ndi mbalame zamumlengalenga",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "ndiponso nsomba zamʼnyanja zikufa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koma wina asapeze mnzake chifukwa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "wina aliyense asayimbe mlandu mnzake,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "pakuti anthu ako ali ngati anthu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "amene amayimba mlandu wansembe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumapunthwa usana ndi usiku",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:5"
      },
      "items": [
        {
          "text": "ndipo aneneri amapunthwa nanu pamodzi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:5"
      },
      "items": [
        {
          "text": "Choncho ndidzawononga amayi anu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu anga akuwonongeka chifukwa chosadziwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "HOS 4:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "\"Pakuti mwakana kudziwa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "Inenso ndidzakukanani monga ansembe anga;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "chifukwa mwayiwala lamulo la Mulungu wanu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "Inenso ndidzayiwala ana anu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ansembe ankati akachuluka",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:7"
      },
      "items": [
        {
          "text": "iwo ankandichimwiranso kwambiri;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:7"
      },
      "items": [
        {
          "text": "iwo anasinthanitsa ulemerero wawo ndi chinthu china chonyansa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalemererapo pa machimo a anthu anga",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.8",
            "verseOrgIds": [
              "HOS.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:8"
      },
      "items": [
        {
          "text": "ndipo amafunitsitsa kuti anthuwo azipitiriza kuchimwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.8",
            "verseOrgIds": [
              "HOS.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo zidzakhala motere: zochitikira anthu ena, zidzachitikiranso ansembe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:9"
      },
      "items": [
        {
          "text": "Ndidzawalanga onsewo chifukwa cha njira zawo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:9"
      },
      "items": [
        {
          "text": "ndidzawabwezera chifukwa cha machitidwe awo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwo azidzadya koma sadzakhuta;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:10"
      },
      "items": [
        {
          "text": "azidzachita zachiwerewere koma sadzachulukana,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:10"
      },
      "items": [
        {
          "text": "chifukwa anasiya Yehova",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:10"
      },
      "items": [
        {
          "text": "kuti adzipereke",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku zachiwerewere,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.11",
            "verseOrgIds": [
              "HOS.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:11"
      },
      "items": [
        {
          "text": "ku vinyo wakale ndi watsopano,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.11",
            "verseOrgIds": [
              "HOS.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:11"
      },
      "items": [
        {
          "text": "zimene zimachotsa nzeru zomvetsa zinthu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.11",
            "verseOrgIds": [
              "HOS.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "za anthu anga.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.12",
            "verseOrgIds": [
              "HOS.4.12"
            ]
          }
        }
      ]
