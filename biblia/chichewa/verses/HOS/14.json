  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "HOS 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kulapa Kubweretsa Madalitso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe Israeli bwerera kwa Yehova Mulungu wako.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.1",
            "verseOrgIds": [
              "HOS.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:1"
      },
      "items": [
        {
          "text": "Machimo anu ndi amene akugwetsani!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.1",
            "verseOrgIds": [
              "HOS.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bweretsani zopempha zanu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "ndipo bwererani kwa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "Munene kwa Iye kuti,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "\"Tikhululukireni machimo athu onse",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "ndi kutilandira mokoma mtima,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "kuti tithe kukuyamikani ndi mawu a pakamwa pathu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asiriya sangatipulumutse;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "ife sitidzakwera pa akavalo ankhondo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "sitidzanenanso kuti, 'Milungu yathu'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "kwa zimene manja athu omwe anazipanga,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "pakuti ndinu amene mumachitira chifundo ana amasiye.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzachiza kusakhulupirika kwawo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:4"
      },
      "items": [
        {
          "text": "ndipo ndidzawakonda mwaufulu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:4"
      },
      "items": [
        {
          "text": "pakuti ndaleka kuwakwiyira.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakhala ngati mame kwa Israeli",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:5"
      },
      "items": [
        {
          "text": "Ndipo iye adzachita maluwa ngati kakombo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:5"
      },
      "items": [
        {
          "text": "Adzazika mizu yake pansi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:5"
      },
      "items": [
        {
          "text": "ngati mkungudza wa ku Lebanoni;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mphukira zake zidzakula.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.6",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:6"
      },
      "items": [
        {
          "text": "Kukongola kwake kudzakhala ngati mtengo wa olivi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.6",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:6"
      },
      "items": [
        {
          "text": "kununkhira kwake ngati mkungudza wa ku Lebanoni.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.6",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu adzakhalanso mu mthunzi wake.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:7"
      },
      "items": [
        {
          "text": "Iye adzakula bwino ngati tirigu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:7"
      },
      "items": [
        {
          "text": "Adzachita maluwa ngati mphesa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:7"
      },
      "items": [
        {
          "text": "ndipo kutchuka kwake kudzakhala ngati vinyo wochokera ku Lebanoni.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efereimu adzati, \"Ndidzachita nawonso chiyani mafano?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:8"
      },
      "items": [
        {
          "text": "Ine ndidzamuyankha ndi kumusamalira.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:8"
      },
      "items": [
        {
          "text": "Ine ndili ngati mtengo wa payini wobiriwira;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:8"
      },
      "items": [
        {
          "text": "zipatso zako zimachokera kwa Ine.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani ali ndi nzeru? Adzazindikire zinthu izi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "Ndani amene amamvetsa zinthu? Adzamvetse izi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "Njira za Yehova ndi zolungama;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "anthu olungama amayenda mʼmenemo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "koma anthu owukira amapunthwamo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    }
  ],
