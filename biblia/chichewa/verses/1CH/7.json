  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "1CH 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fuko la Isakara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Isakara anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.1",
            "verseOrgIds": [
              "1CH.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:1"
      },
      "items": [
        {
          "text": "Tola, Puwa, Yasubu ndi Simironi ndipo onse analipo anayi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.1",
            "verseOrgIds": [
              "1CH.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Tola ndi awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.2",
            "verseOrgIds": [
              "1CH.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:2"
      },
      "items": [
        {
          "text": "Uzi, Refaya, Yerieli, Yahimai, Ibisamu ndi Samueli. Awa anali atsogoleri a mabanja awo. Pa nthawi ya ulamuliro wa Davide zidzukulu za Tola zomwe zinali anthu odziwa kumenya nkhondo zinalipo 22,600.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.2",
            "verseOrgIds": [
              "1CH.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa Uzi anali",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:3"
      },
      "items": [
        {
          "text": "Izirahiya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 7:3"
      },
      "items": [
        {
          "text": "Ana a Izirahiya anali:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:3"
      },
      "items": [
        {
          "text": "Mikayeli, Obadiya, Yoweli ndi Isiya. Onse asanu anali atsogoleri a mabanja.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga mwa chiwerengero cha mabanja awo, panali anthu 36,000 odziwa kumenya nkhondo, pakuti iwo anali ndi akazi ndi ana ambiri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.4",
            "verseOrgIds": [
              "1CH.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abale awo onse a mʼbanja la Isakara amene anali odziwa kumenya nkhondo analipo 87,000, olembedwa potsata mibado yawo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.5",
            "verseOrgIds": [
              "1CH.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fuko la Benjamini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana atatu a Benjamini anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.6",
            "verseOrgIds": [
              "1CH.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:6"
      },
      "items": [
        {
          "text": "Bela, Bekeri ndi Yediaeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.6",
            "verseOrgIds": [
              "1CH.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Bela anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.7",
            "verseOrgIds": [
              "1CH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:7"
      },
      "items": [
        {
          "text": "Eziboni, Uzi, Uzieli, Yerimoti ndi Iri. Iwowa anali atsogoleri a mabanja awo ndipo onse pamodzi analipo asanu. Pa mndandanda wa mʼbado wawo panali anthu 22,034 odziwa kumenya nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.7",
            "verseOrgIds": [
              "1CH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Bekeri anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.8",
            "verseOrgIds": [
              "1CH.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:8"
      },
      "items": [
        {
          "text": "Zemira, Yowasi, Eliezara, Eliyoenai, Omiri, Yeremoti, Abiya, Anatoti ndi Alemeti. Onsewa anali ana a Bekeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.8",
            "verseOrgIds": [
              "1CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mndandanda wa mʼbado wawo panali atsogoleri a mabanja ndi anthu 20,200 odziwa kumenya nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.9",
            "verseOrgIds": [
              "1CH.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa Yediaeli anali",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:10"
      },
      "items": [
        {
          "text": "Bilihani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 7:10"
      },
      "items": [
        {
          "text": "Ana a Bilihani anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:10"
      },
      "items": [
        {
          "text": "Yeusi, Benjamini, Ehudi, Kenaana, Zetani, Tarisisi ndi Ahisahara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana onsewa a Yediaeli anali atsogoleri a mabanja. Analipo anthu 17,200 amene anali okonzeka kupita ku nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.11",
            "verseOrgIds": [
              "1CH.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asupi ndi Ahupi anali zidzukulu za Iri, ndipo Ahusimu anali zidzukulu za Aheri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.12",
            "verseOrgIds": [
              "1CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fuko la Nafutali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Nafutali anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.13",
            "verseOrgIds": [
              "1CH.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:13"
      },
      "items": [
        {
          "text": "Yahazieli, Guni, Yezeri ndi Salumu, zidzukulu za Biliha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.13",
            "verseOrgIds": [
              "1CH.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fuko la Manase",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Manase anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.14",
            "verseOrgIds": [
              "1CH.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:14"
      },
      "items": [
        {
          "text": "Asirieli ndi mwana amene anabereka kwa mzikazi wake wa ku Aramu. Mzikazi yemweyo anaberekanso Makiri abambo ake a Giliyadi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.14",
            "verseOrgIds": [
              "1CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makiri anatenga mkazi wa banja la Ahupi ndi Asupi. Mlongo wake anali Maaka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.15",
            "verseOrgIds": [
              "1CH.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:15"
      },
      "items": [
        {
          "text": "Mwana wake wina anali Zelofehadi, amene anabereka ana aakazi okhaokha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.15",
            "verseOrgIds": [
              "1CH.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maaka mkazi wa Makiri anabereka mwana wamwamuna ndipo anamutcha Perezi. Mʼbale wake anamutcha Seresi, ndipo ana ake anali Ulamu ndi Rakemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.16",
            "verseOrgIds": [
              "1CH.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa Ulamu anali",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:17"
      },
      "items": [
        {
          "text": "Bedani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 7:17"
      },
      "items": [
        {
          "text": "Awa anali ana a Giliyadi mwana wa Makiri, mwana wa Manase.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlongo wake Hamoleketi anabereka Isihodi, Abiezeri ndi Mahila.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.18",
            "verseOrgIds": [
              "1CH.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Semida anali:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
              "1CH.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:19"
      },
      "items": [
        {
          "text": "Ahiyani, Sekemu, Likihi ndi Aniyamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
              "1CH.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fuko la Efereimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Efereimu anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:20"
      },
      "items": [
        {
          "text": "Sutela, Beredi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:20"
      },
      "items": [
        {
          "text": "Tahati, Eliada,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:20"
      },
      "items": [
        {
          "text": "Tahati,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zabadi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.21",
            "verseOrgIds": [
              "1CH.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:21"
      },
      "items": [
        {
          "text": "Sutela.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.21",
            "verseOrgIds": [
              "1CH.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:21"
      },
      "items": [
        {
          "text": "Ezeri ndi Eladi anaphedwa ndi anthu a ku Gati, pamene anabwera kudzalanda zoweta zawo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.21",
            "verseOrgIds": [
              "1CH.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efereimu, abambo awo, anawalira masiku ambiri, ndipo abale ake anabwera kudzamutonthoza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.22",
            "verseOrgIds": [
              "1CH.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka anagona ndi mkazi wake, ndipo anakhala woyembekezera nabala mwana wamwamuna. Anamutcha dzina lake Beriya, chifukwa tsoka linagwera banja lake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.23",
            "verseOrgIds": [
              "1CH.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wake wamkazi anali Seera, amene anamanga mzinda wa Beti-Horoni Wakumunsi, Wakumtunda kudzanso Uzeni-Seera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.24",
            "verseOrgIds": [
              "1CH.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wina wa Efereimu anali Refa amene zidzukulu zake zinali Resefu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.25",
            "verseOrgIds": [
              "1CH.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:25"
      },
      "items": [
        {
          "text": "Tela, Tahani,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.25",
            "verseOrgIds": [
              "1CH.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ladani, Amihudi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.26",
            "verseOrgIds": [
              "1CH.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:26"
      },
      "items": [
        {
          "text": "Elisama,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.26",
            "verseOrgIds": [
              "1CH.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuni",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.27",
            "verseOrgIds": [
              "1CH.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:27"
      },
      "items": [
        {
          "text": "ndi Yoswa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.27",
            "verseOrgIds": [
              "1CH.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malo amene ankakhala anali Beteli ndi midzi yozungulira, cha kummawa kunali Naarani, Gezeri ndi midzi yake ya kumadzulo ndi Sekemu ndi midzi yake mpaka ku Aya ndi midzi yake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.28",
            "verseOrgIds": [
              "1CH.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmbali mwa malire a Manase munali Beti-Seani, Taanaki, Megido ndi Dori, pamodzi ndi midzi yake. Zidzukulu za Yosefe mwana wa Israeli zimakhala mʼmizinda imeneyi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.29",
            "verseOrgIds": [
              "1CH.7.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fuko la Aseri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Aseri anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.30",
            "verseOrgIds": [
              "1CH.7.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:30"
      },
      "items": [
        {
          "text": "Imuna, Isiva, Isivi ndi Beriya. Mlongo wawo anali Sera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.30",
            "verseOrgIds": [
              "1CH.7.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Beriya anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.31",
            "verseOrgIds": [
              "1CH.7.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:31"
      },
      "items": [
        {
          "text": "Heberi ndi Malikieli amene anabereka Birizaiti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.31",
            "verseOrgIds": [
              "1CH.7.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heberi anabereka Yafuleti, Someri, Hotamu ndi Suwa, mlongo wawo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.32",
            "verseOrgIds": [
              "1CH.7.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Yafuleti anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.33",
            "verseOrgIds": [
              "1CH.7.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:33"
      },
      "items": [
        {
          "text": "Pasaki, Bimuhali ndi Asivati.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.33",
            "verseOrgIds": [
              "1CH.7.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "1CH 7:33"
      },
      "items": [
        {
          "text": "Awa anali ana a Yafuleti.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Someri anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.34",
            "verseOrgIds": [
              "1CH.7.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:34"
      },
      "items": [
        {
          "text": "Ahi, Rohiga, Yehuba ndi Aramu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.34",
            "verseOrgIds": [
              "1CH.7.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a mʼbale wake Helemu anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.35",
            "verseOrgIds": [
              "1CH.7.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:35"
      },
      "items": [
        {
          "text": "Zofa, Imuna, Selesi ndi Amali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.35",
            "verseOrgIds": [
              "1CH.7.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Zofa anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.36",
            "verseOrgIds": [
              "1CH.7.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:36"
      },
      "items": [
        {
          "text": "Suwa, Harineferi, Suwali, Beri, Imula,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.36",
            "verseOrgIds": [
              "1CH.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bezeri, Hodi, Sama, Silisa, Itirani ndi Bera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.37",
            "verseOrgIds": [
              "1CH.7.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Yeteri anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.38",
            "verseOrgIds": [
              "1CH.7.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:38"
      },
      "items": [
        {
          "text": "Yefune, Pisipa ndi Ara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.38",
            "verseOrgIds": [
              "1CH.7.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Ula anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.39",
            "verseOrgIds": [
              "1CH.7.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:39"
      },
      "items": [
        {
          "text": "Ara, Hanieli ndi Riziya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.39",
            "verseOrgIds": [
              "1CH.7.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onsewa anali zidzukulu za Aseri, atsogoleri a mabanja, anthu omveka, ankhondo olimba mtima, ndi akuluakulu pakati pa atsogoleri anzawo. Chiwerengero cha anthu odziwa kumenya nkhondo chomwe chinalembedwa chinali 26,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.40",
            "verseOrgIds": [
              "1CH.7.40"
            ]
          }
        }
      ]
    }
