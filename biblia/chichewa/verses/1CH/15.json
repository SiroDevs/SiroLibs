      "attrs": {
        "style": "li2",
        "vid": "1CH 15:7"
      },
      "items": [
        {
          "text": "mtsogoleri Yoweli ndi abale ake 130;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.7",
            "verseOrgIds": [
              "1CH.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
