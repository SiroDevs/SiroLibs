  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "1CH 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndondomeko ya Kamangidwe ka Nyumba ya Mulungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anayitana akuluakulu onse a Israeli kuti asonkhane ku Yerusalemu: akuluakulu a mafuko, olamulira magulu a ntchito ya mfumu, olamulira ankhondo 1,000, ndi olamulira ankhondo 100, ndiponso akuluakulu onse osunga katundu ndi ziweto za mfumu ndi ana ake, pamodzinso ndi akuluakulu a ku nyumba yaufumu, anthu amphamvu ndi asilikali onse olimba mtima.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.1",
            "verseOrgIds": [
              "1CH.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu Davide inayimirira ndipo inati: \"Tamverani abale anga ndi anthu anga. Ine ndinali ndi maganizo omanga nyumba monga malo okhalamo Bokosi la Chipangano la Yehova, malo oyikapo mapazi a Mulungu wathu, ndipo ndinakonza ndondomeko yomangira nyumbayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.2",
            "verseOrgIds": [
              "1CH.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Mulungu anati kwa ine, \"Usandimangire nyumba chifukwa ndiwe munthu wankhondo ndipo wakhala ukukhetsa magazi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.3",
            "verseOrgIds": [
              "1CH.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Komabe Yehova Mulungu wa Israeli anasankha ine pakati pa onse a banja langa kukhala mfumu ya Israeli kwamuyaya. Iye anasankha Yuda kukhala mtsogoleri, ndipo pa banja la Yuda anasankha banja langa. Pakati pa ana aamuna a abambo anga, kunamukomera Iye kundikhazika mfumu ya Aisraeli onse.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.4",
            "verseOrgIds": [
              "1CH.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ana anga ambiri onse amene Yehova wandipatsa, Iye wasankha mwana wanga Solomoni kuti akhale pa mpando waufumu wa ufumu wa Yehova kuti alamulire Israeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.5",
            "verseOrgIds": [
              "1CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anati kwa ine, \"Solomoni mwana wako ndiye amene adzamanga nyumba yanga ndi mabwalo anga, pakuti Ine ndamusankha kuti akhale mwana wanga ndipo Ine ndidzakhala abambo ake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.6",
            "verseOrgIds": [
              "1CH.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzakhazikitsa ufumu wake kwamuyaya ngati iye saleka kutsatira malamulo ndi malangizo anga, monga momwe zikuchitikira leromu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.7",
            "verseOrgIds": [
              "1CH.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsono lero ine ndikulamula inu pamaso pa Aisraeli onse ndi pa msonkhano wa Yehova, ndipo Mulungu wathu akumva: Mutsatire mosamala malamulo a Yehova Mulungu wathu, kuti dziko labwinoli likhale lanu ndi kuti mudzalipereke kwa zidzukulu zanu kukhala cholowa chawo kwamuyaya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.8",
            "verseOrgIds": [
              "1CH.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndipo iwe mwana wanga Solomoni, umvere Mulungu wa abambo ako, umutumikire ndi mtima wodzipereka kwathunthu ndi mtima wako wonse, pakuti Yehova amasanthula mtima wa aliyense, ndipo amadziwa maganizo aliwonse a munthu. Ngati ufunafuna Yehova, Iye adzapezeka; koma ngati umutaya, Iye adzakukana kwamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.9",
            "verseOrgIds": [
              "1CH.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano ganizira bwino, pakuti Yehova wakusankha iwe kuti umange Nyumba ya Mulungu monga malo ake opatulika. Khala wamphamvu ndipo ugwire ntchito.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.10",
            "verseOrgIds": [
              "1CH.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero Davide anapatsa Solomoni mwana wake mapulani a khonde la Nyumba ya Mulungu, nyumba zake, mosungiramo katundu, zipinda zake zamʼmwamba, zipinda zamʼkati ndi malo a nsembe zopepesera machimo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.11",
            "verseOrgIds": [
              "1CH.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anapatsa Solomoni mapulani a zonse zimene ankaziganizira za bwalo la Nyumba ya Yehova ndi zipinda zonse zozungulira, zipinda zosungiramo chuma cha Nyumba ya Mulungu ndi zinthu zoperekedwa kwa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.12",
            "verseOrgIds": [
              "1CH.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anamulangiza za magulu a ansembe ndi Alevi ndi ntchito yonse yotumikira mʼNyumba ya Yehova, komanso za zinthu zonse zogwirira ntchito potumikira.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.13",
            "verseOrgIds": [
              "1CH.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anakonzeratu za kulemera kwa golide wopangira zida zonse zagolide zogwirira ntchito zosiyanasiyana, ndiponso kulemera kwa siliva wopangira zida zonse zasiliva zogwirira ntchito zosiyanasiyana:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.14",
            "verseOrgIds": [
              "1CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulemera kwa golide wopangira choyikapo nyale chagolide ndi nyale zake; ndiponso kulemera kwa siliva wa choyikapo nyale chilichonse ndi nyale zake, molingana ndi kagwiritsidwe ka choyikapo nyale chilichonse;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.15",
            "verseOrgIds": [
              "1CH.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulemera kwa golide wa tebulo iliyonse yoyikapo buledi wopatulika; kulemera kwa siliva wopangira matebulo asiliva;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.16",
            "verseOrgIds": [
              "1CH.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "muyeso wa golide woyengeka bwino wopangira mafoloko, mbale ndi zotungira; muyeso wa golide wa beseni lililonse la siliva;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.17",
            "verseOrgIds": [
              "1CH.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndiponso muyeso wa golide wabwino wopangira guwa la zofukiza. Davide anamupatsanso ndondomeko ya mapangidwe a galeta, akerubi agolide atatambasula mapiko awo kuphimba Bokosi la Chipangano la Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.18",
            "verseOrgIds": [
              "1CH.28.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anati, \"Zonsezi ndalemba kuchokera kwa Yehova, ndipo Iye wachita kuti ndimvetsetse zonse za mapulaniwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.19",
            "verseOrgIds": [
              "1CH.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anatinso kwa mwana wake Solomoni, \"Khala wamphamvu ndi wolimba mtima ndipo uchite ntchitoyi. Usachite mantha kapena kutaya mtima pakuti Yehova Mulungu wanga ali nawe. Iye sadzakukhumudwitsa kapena kukusiya mpaka ntchito yonse ya Nyumba ya Mulungu itatha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.20",
            "verseOrgIds": [
              "1CH.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magulu a ansembe ndi Alevi ndi okonzeka kugwira ntchito ya Nyumba ya Mulungu, ndipo munthu waluso aliyense wodzipereka adzakuthandiza pa ntchito yonse. Akuluakulu ndi anthu onse adzamvera chilichonse chomwe udzalamula.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.21",
            "verseOrgIds": [
              "1CH.28.21"
            ]
          }
        }
      ]
    }
  ],
