  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JDG 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samsoni Abwezera Afilisti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patapita nthawi, mu nyengo yodula tirigu, Samsoni anatenga kamwana kambuzi ndipo anapita kukacheza kwa mkazi wake. Iye anati, \"Ndikufuna kukalowa ku chipinda cha mkazi wanga.\" Koma abambo a mkaziyo anamuletsa kutero.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.1",
            "verseOrgIds": [
              "JDG.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abambo a mkaziyo anati, \"Ine ndimaganiza kuti umamuda kwambiri nʼchifukwa chake ndinamupereka kwa mnzako. Kodi mngʼono wake uja sindiye wokongola kupambana iye? Ingotengani ameneyo mʼmalo mwake.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.2",
            "verseOrgIds": [
              "JDG.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samsoni anawawuza kuti, \"Pano sindikhala wochimwa ndikawachita choyipa chachikulu Afilistiwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.3",
            "verseOrgIds": [
              "JDG.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Samsoni anapita nakagwira nkhandwe 300 nazimangirira michira ziwiriziwiri ndipo pa fundo iliyonse ya michirayo anamangirira nsakali.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.4",
            "verseOrgIds": [
              "JDG.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anayatsa nsakalizo kenaka ndi kuzitayira nkhandwe zija mʼminda ya tirigu ya Afilisti, ndipo zinatentha milu ya tirigu, ndi wosadula yemwe pamodzi ndi mitengo ya mpesa ndi ya olivi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.5",
            "verseOrgIds": [
              "JDG.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Afilisti anayamba kufunsana kuti, \"Ndani wachita izi?\" Ena anati, \"Ndi Samsoni mkamwini wa munthu wa ku Timna uja chifukwa Mtimunayo anatenga mkazi wake ndi kumupereka kwa mnzake.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.6",
            "verseOrgIds": [
              "JDG.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 15:6"
      },
      "items": [
        {
          "text": "Choncho Afilisti anapita kukatentha mtsikanayo pamodzi ndi abambo ake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.6",
            "verseOrgIds": [
              "JDG.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samsoni anawawuza kuti, \"Ngati mumachita zangati zimenezi, ndiye ine sindileka mpaka nditakulipsirani.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.7",
            "verseOrgIds": [
              "JDG.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Samsoni anamenyana nawo koopsa ndipo anapha ambiri a iwo. Kenaka anakalowa mʼphanga la Etamu, nakhala momwemo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.8",
            "verseOrgIds": [
              "JDG.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake Afilisti anakamanga misasa ya nkhondo mʼdziko la Yuda, ndi kuthira nkhondo mʼdera la Lehi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.9",
            "verseOrgIds": [
              "JDG.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a fuko la Yuda anafunsa kuti, \"Nʼchifukwa chiyani mwabwera kudzamenyana nafe?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.10",
            "verseOrgIds": [
              "JDG.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 15:10"
      },
      "items": [
        {
          "text": "Iwo anayankha kuti, \"Tabwera kudzamanga Samsoni ndi kuti timuchite zofanana ndi zimene anatichita.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.10",
            "verseOrgIds": [
              "JDG.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anthu 3,000 a ku Yuda anapita ku phanga la Etamu, ndi kukamufunsa Samsoni kuti, \"Kodi iwe sudziwa kuti ife amatilamulira ndi Afilisti? Tsono ndi chiyani chimene watichitachi?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.11",
            "verseOrgIds": [
              "JDG.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 15:11"
      },
      "items": [
        {
          "text": "Iye anayankha kuti, \"Ine ndinachita zomwe iwo anandichita.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.11",
            "verseOrgIds": [
              "JDG.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anati kwa iye, \"Ife tabwera kuti tikumange ndi kukupereka kwa Afilisti.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.12",
            "verseOrgIds": [
              "JDG.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 15:12"
      },
      "items": [
        {
          "text": "Ndipo Samsoni anati, \"Lonjezani mwa lumbiro kuti simundipha ndinu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.12",
            "verseOrgIds": [
              "JDG.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anamuyankha kuti, \"Ayi, ife sitikupha. Koma tingokumanga ndi kukupereka mʼmanja mwa Afilisti.\" Choncho anamumanga ndi zingwe ziwiri zatsopano namutulutsa mʼphanga muja.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.13",
            "verseOrgIds": [
              "JDG.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samsoni anafika ku Lehi, ndipo Afilisti anamuchingamira akufuwula. Nthawi yomweyo Mzimu wa Yehova unatsika pa iye mwamphamvu ndipo zingwe zimene anamumanga nazo zinasanduka ngati thonje lopsa mʼmoto, zinachita ngati zasungunuka nʼkuchoka mʼmanja mwake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.14",
            "verseOrgIds": [
              "JDG.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anapeza chibwano cha bulu amene anali atangofa kumene. Anachitola ndi kuphera nacho anthu 1,000.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.15",
            "verseOrgIds": [
              "JDG.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Samsoni anati,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.16",
            "verseOrgIds": [
              "JDG.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 15:16"
      },
      "items": [
        {
          "text": "\"Ndi chibwano cha bulu,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.16",
            "verseOrgIds": [
              "JDG.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 15:16"
      },
      "items": [
        {
          "text": "milu ndi milu ya anthu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.16",
            "verseOrgIds": [
              "JDG.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 15:16"
      },
      "items": [
        {
          "text": "Ndi chibwano cha bulu,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.16",
            "verseOrgIds": [
              "JDG.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 15:16"
      },
      "items": [
        {
          "text": "ndapha anthu 1,000.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.16",
            "verseOrgIds": [
              "JDG.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atatsiriza kuyankhula, anataya chibwanocho, ndipo malowo anawatcha Ramati-Lehi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.17",
            "verseOrgIds": [
              "JDG.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake anamva ludzu kwambiri ndipo anayitana Yehova mopempha kuti, \"Inu mwapatsa mtumiki wanu chipulumutso chachikulu chotere. Kodi tsopano ndife ndi ludzu ndi kugwidwa ndi anthu osachita mdulidwewa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.18",
            "verseOrgIds": [
              "JDG.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Mulungu anangʼamba nthaka ku Lehi, ndipo madzi anatuluka mʼdzenjemo. Samsoni anamwa madziwo, ndipo mphamvu zake zinabwerera nakhalanso monga analili. Choncho chitsimecho chinatchedwa Eni-Hakore, ndipo chilipobe ku Lehiko mpaka lero.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.19",
            "verseOrgIds": [
              "JDG.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samsoni anatsogolera Israeli pa nthawi ya Afilisti kwa zaka makumi awiri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.20",
            "verseOrgIds": [
              "JDG.15.20"
            ]
          }
        }
      ]
    }
  ],
