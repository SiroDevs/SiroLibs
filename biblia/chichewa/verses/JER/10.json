      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:17"
      },
      "items": [
        {
          "text": "inu amene mukukhala mʼlinga la ankhondo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.17",
            "verseOrgIds": [
              "JER.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.18",
            "verseOrgIds": [
              "JER.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:18"
      },
      "items": [
        {
          "text": "\"Tsopano Ine ndidzachotsa anthu onse",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.18",
            "verseOrgIds": [
              "JER.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:18"
      },
      "items": [
        {
          "text": "amene akukhala mʼdziko lino;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.18",
            "verseOrgIds": [
              "JER.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:18"
      },
      "items": [
        {
          "text": "adzakhala pa mavuto",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.18",
            "verseOrgIds": [
              "JER.10.18"
            ]
          }
        }
      ]
    },
