    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:14"
      },
      "items": [
        {
          "text": "mmisiri aliyense wosula golide akuchita manyazi ndi mafano ake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.14",
            "verseOrgIds": [
              "JER.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:14"
      },
      "items": [
        {
          "text": "Mafano akewo ndi abodza;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.14",
            "verseOrgIds": [
              "JER.10.14"
            ]
          }
        }
      ]
    },
    {
