      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:20"
      },
      "items": [
        {
          "text": "zingwe zake zonse zaduka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.20",
            "verseOrgIds": [
              "JER.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:20"
      },
      "items": [
        {
          "text": "Ana anga andisiya ndipo kulibenso.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.20",
            "verseOrgIds": [
              "JER.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:20"
      },
      "items": [
        {
          "text": "Palibenso amene adzandimangire tenti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.20",
            "verseOrgIds": [
              "JER.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:20"
      },
      "items": [
        {
          "text": "kapena kufunyulula nsalu yake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.20",
            "verseOrgIds": [
              "JER.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
