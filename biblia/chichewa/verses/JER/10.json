          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusa ndi opusa",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.21",
            "verseOrgIds": [
              "JER.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:21"
      },
      "items": [
        {
          "text": "ndipo sanapemphe nzeru kwa Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.21",
            "verseOrgIds": [
              "JER.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:21"
      },
      "items": [
        {
          "text": "choncho palibe chimene anapindula",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.21",
            "verseOrgIds": [
              "JER.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:21"
      },
      "items": [
        {
          "text": "ndipo nkhosa zawo zonse zabalalika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.21",
            "verseOrgIds": [
              "JER.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamvani! kukubwera mphekesera,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.22",
            "verseOrgIds": [
              "JER.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:22"
      },
      "items": [
        {
          "text": "phokoso lalikulu la gulu la a ankhondo likumveka kuchokera kumpoto!",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.22",
            "verseOrgIds": [
              "JER.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:22"
      },
      "items": [
        {
          "text": "Lidzasandutsa bwinja mizinda ya ku Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.22",
            "verseOrgIds": [
              "JER.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:22"
      },
      "items": [
        {
          "text": "malo okhala nkhandwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.22",
            "verseOrgIds": [
              "JER.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pemphero la Yeremiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, ndikudziwa kuti moyo umene munthu ali nawo si wake;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.23",
            "verseOrgIds": [
              "JER.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:23"
      },
      "items": [
        {
          "text": "munthuyo sangathe kuwongolera mayendedwe ake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.23",
            "verseOrgIds": [
              "JER.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, langizeni, komatu mwachilungamo,",
          "type": "text",
          "attrs": {
