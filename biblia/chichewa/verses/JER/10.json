          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sonkhanitsani katundu wanu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.17",
            "verseOrgIds": [
              "JER.10.17"
            ]
          }
        }
      ]
    },
