      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:16"
      },
      "items": [
        {
          "text": "Iyeyu ndi Mlengi wa zinthu zonse",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.16",
            "verseOrgIds": [
              "JER.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:16"
      },
      "items": [
        {
          "text": "kuphatikizapo Israeli, mtundu umene anawusankha kuti ukhale anthu ake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.16",
            "verseOrgIds": [
              "JER.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:16"
      },
      "items": [
        {
          "text": "Dzina lake ndi Yehova Wamphamvuzonse.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.16",
            "verseOrgIds": [
              "JER.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiwonongeko Chikubwera",
          "type": "text"
        }
      ]
    },
    {
