      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:14"
      },
      "items": [
        {
          "text": "alibe moyo mʼkati mwawo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.14",
            "verseOrgIds": [
              "JER.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafanowo ndi achabechabe, zinthu zosekedwa nazo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.15",
            "verseOrgIds": [
              "JER.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:15"
      },
      "items": [
        {
          "text": "Pamene anthuwo azidzaweruzidwa, mafanowo adzawonongedwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.15",
            "verseOrgIds": [
              "JER.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
