  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JER 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mulungu ndi Mafano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Aisraeli, imvani zimene Yehova akunena.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.1",
            "verseOrgIds": [
              "JER.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.2",
            "verseOrgIds": [
              "JER.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:2"
      },
      "items": [
        {
          "text": "\"Musatsatire makhalidwe a anthu a mitundu ina",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.2",
            "verseOrgIds": [
              "JER.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:2"
      },
      "items": [
        {
          "text": "kapena kuchita mantha ndi zizindikiro zamlengalenga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.2",
            "verseOrgIds": [
              "JER.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:2"
      },
      "items": [
        {
          "text": "ngakhale anthu a mitundu ina amachita nazo mantha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.2",
            "verseOrgIds": [
              "JER.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti miyambo ya mitundu inayo ndiyachabechabe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.3",
            "verseOrgIds": [
              "JER.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:3"
      },
      "items": [
        {
          "text": "Iwo amakadula mtengo ku nkhalango",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.3",
            "verseOrgIds": [
              "JER.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:3"
      },
      "items": [
        {
          "text": "ndipo mmisiri amawusema ndi sompho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.3",
            "verseOrgIds": [
              "JER.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakongoletsa chosemacho ndi siliva ndi golide;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.4",
            "verseOrgIds": [
              "JER.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:4"
      },
      "items": [
        {
          "text": "kenaka amachikhomerera ndi misomali",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.4",
            "verseOrgIds": [
              "JER.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:4"
      },
      "items": [
        {
          "text": "kuti chisagwedezeke.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.4",
            "verseOrgIds": [
              "JER.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafano awo ali ngati mtengo wakanjedza woopsezera mbalame mʼmunda wa minkhaka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:5"
      },
      "items": [
        {
          "text": "Mafanowo sangathe nʼkuyankhula komwe",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:5"
      },
      "items": [
        {
          "text": "ndipo ayenera kunyamulidwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:5"
      },
      "items": [
        {
          "text": "popeza sangathe nʼkuyenda komwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:5"
      },
      "items": [
        {
          "text": "Musachite nawo mantha",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:5"
      },
      "items": [
        {
          "text": "popeza sangathe kukuchitani choyipa",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:5"
      },
      "items": [
        {
          "text": "ndiponso alibe mphamvu yochitira chabwino chilichonse.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palibe wofanana nanu, Inu Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.6",
            "verseOrgIds": [
              "JER.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:6"
      },
      "items": [
        {
          "text": "Inu ndinu wamkulu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.6",
            "verseOrgIds": [
              "JER.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:6"
      },
      "items": [
        {
          "text": "ndipo dzina lanu lili ndi mphamvu yayikulu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.6",
            "verseOrgIds": [
              "JER.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani amene angaleke kukuopani,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:7"
      },
      "items": [
        {
          "text": "inu Mfumu ya mitundu ya anthu?",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:7"
      },
      "items": [
        {
          "text": "Chimenechi ndicho chokuyenerani.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:7"
      },
      "items": [
        {
          "text": "Pakati pa anthu anzeru onse komanso mafumu onse",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:7"
      },
      "items": [
        {
          "text": "a mitundu ya anthu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:7"
      },
      "items": [
        {
          "text": "palibe wina wofanana nanu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onsewo ndi opusa ndi opanda nzeru;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.8",
            "verseOrgIds": [
              "JER.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:8"
      },
      "items": [
        {
          "text": "malangizo awo amawatenga kuchokera kwa mafano achabechabe opanga ndi mitengo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.8",
            "verseOrgIds": [
              "JER.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siliva wosula amabwera naye kuchokera ku Tarisisi",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:9"
      },
      "items": [
        {
          "text": "ndipo golide amachokera naye ku Ufazi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:9"
      },
      "items": [
        {
          "text": "Mafanowo ndi ntchito ya anthu aluso ndi odziwa kuzokota golide.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:9"
      },
      "items": [
        {
          "text": "Tsono mafanowo amawaveka zovala za mtundu wamtambo ndi pepo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:9"
      },
      "items": [
        {
          "text": "Yonseyo ndi ntchito ya anthu a luso.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yehova ndiye Mulungu woona;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:10"
      },
      "items": [
        {
          "text": "Iyeyo ndiye Mulungu wamoyo, Mfumu yamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:10"
      },
      "items": [
        {
          "text": "Akakwiya, dziko limagwedezeka;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:10"
      },
      "items": [
        {
          "text": "anthu a mitundu ina sangathe kupirira ukali wakewo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Awuze anthu awa kuti, 'Milungu iyi, imene sinalenge dziko lakumwamba ndi dziko lapansi, idzawonongeka pa dziko lapansi ndi pansi pa thambo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.11",
            "verseOrgIds": [
              "JER.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Mulungu analenga dziko lapansi ndi mphamvu zake;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.12",
            "verseOrgIds": [
              "JER.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:12"
      },
      "items": [
        {
          "text": "Iye anapanga dziko lonse ndi nzeru zake",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.12",
            "verseOrgIds": [
              "JER.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:12"
      },
      "items": [
        {
          "text": "ndipo anayala thambo mwaluso lake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.12",
            "verseOrgIds": [
              "JER.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
