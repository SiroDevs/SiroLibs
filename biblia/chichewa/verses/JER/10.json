          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliyense ankangoti, \"Mayo ine, chifukwa cha kupweteka kwanga!",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.19",
            "verseOrgIds": [
              "JER.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:19"
      },
      "items": [
        {
          "text": "Chilonda changa nʼchachikulu!\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.19",
            "verseOrgIds": [
              "JER.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:19"
      },
      "items": [
        {
          "text": "Koma ine ndinkaganiza kuti, \"Ndithu, ili ndi vuto langa basi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.19",
            "verseOrgIds": [
              "JER.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:19"
      },
      "items": [
        {
          "text": "choncho ndingolipirira.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.19",
            "verseOrgIds": [
              "JER.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tenti yanga yawonongeka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.20",
            "verseOrgIds": [
              "JER.10.20"
            ]
          }
        }
      ]
    },
