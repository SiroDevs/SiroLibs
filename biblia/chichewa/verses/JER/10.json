        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akayankhula, kumamveka mkokomo wamadzi akumwamba;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.13",
            "verseOrgIds": [
              "JER.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:13"
      },
      "items": [
        {
          "text": "Iyeyo amabweretsa mitambo kuchokera ku malekezero a dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.13",
            "verseOrgIds": [
              "JER.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:13"
      },
      "items": [
        {
          "text": "Amabweretsa mphenzi pamodzi ndi mvula",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.13",
            "verseOrgIds": [
              "JER.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:13"
      },
      "items": [
        {
          "text": "ndi kutulutsa mphepo yamkuntho kumalo kumene osungirako.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.13",
            "verseOrgIds": [
              "JER.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
