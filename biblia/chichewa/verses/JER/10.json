          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu onse ndi opusa ndiponso opanda nzeru;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.14",
            "verseOrgIds": [
              "JER.10.14"
            ]
          }
        }
