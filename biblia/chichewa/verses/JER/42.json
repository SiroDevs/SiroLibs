  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "JER 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atsogoleri onse a ankhondo pamodzi ndi Yohanani mwana wa Kareya ndi Azariya mwana wa Hosayia, ndiponso anthu onse, ana ndi akuluakulu omwe, anapita",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.1",
            "verseOrgIds": [
              "JER.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa mneneri Yeremiya ndipo anamuwuza kuti, \"Chonde imvani dandawulo lathu ndipo mutipempherere anthu otsalafe kwa Yehova Mulungu wanu. Pakuti monga tsopano mukuona, ngakhale kuti kale tinalipo ambiri, koma tsopano ochepa okha ndiye amene atsala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.2",
            "verseOrgIds": [
              "JER.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mupemphere kuti Yehova Mulungu wanu atiwuze kumene tiyenera kupita ndi chimene tiyenera kuchita.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.3",
            "verseOrgIds": [
              "JER.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mneneri Yeremiya anawayankha kuti, \"Ndamva zimene mwanenazi. Ndithu ndidzapemphera kwa Yehova Mulungu wanu monga momwe mwandipemphera. Ndidzakuwuzani chilichonse chimene Yehova anene ndipo sindidzakubisirani kanthu kalikonse.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.4",
            "verseOrgIds": [
              "JER.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo iwo anawuza Yeremiya kuti, \"Yehova akhale mboni yoona ndi yokhulupirika yodzatitsutsa ife ngati sitichita mogwirizana ndi chilichonse chimene Yehova Mulungu adzakutumani kuti mutiwuze.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.5",
            "verseOrgIds": [
              "JER.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaya ndi zotikomera kapena zosatikomera, ife tidzamvera Yehova Mulungu wathu, amene takutumaniko. Tidzamvera Yehova Mulungu wathu kuti zinthu zidzatiyendere bwino.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.6",
            "verseOrgIds": [
              "JER.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patapita masiku khumi, Yehova anayankhula ndi Yeremiya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.7",
            "verseOrgIds": [
              "JER.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yeremiya anayitana Yohanani mwana wa Kareya pamodzi ndi atsogoleri onse a ankhondo amene anali naye ndiponso anthu onse, ana ndi akulu omwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.8",
            "verseOrgIds": [
              "JER.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova, Mulungu wa Israeli amene munanditumako kuti ndikapereke madandawulo mʼdzina lanu akuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.9",
            "verseOrgIds": [
              "JER.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngati mukhala mʼdziko muno, ndiye kuti ndidzakukhazikitsani, osakuchotsani. Inde ndidzakudzalani osakuchotsani pakuti ndi kumva chisoni kwambiri chifukwa cha mavuto amene ndabweretsa pa inu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.10",
            "verseOrgIds": [
              "JER.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musayiope mfumu ya ku Babuloni, imene mukuyiopa tsopano. Musachite nayo mantha, akutero Yehova, pakuti Ine ndili nanu ndipo ndidzakupulumutsani ndi kukulanditsani mʼmanja mwake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.11",
            "verseOrgIds": [
              "JER.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakuchitirani chifundo, ndipo mfumuyonso idzakuchitirani chifundo ndi kukulolani kuti mukhale mʼdziko mwanumwanu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.12",
            "verseOrgIds": [
              "JER.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koma mwina simudzamvera Yehova Mulungu wanu nʼkumanena kuti, 'Ayi ife sitidzakhala mʼdziko muno,",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.13",
            "verseOrgIds": [
              "JER.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo ngati mukunena kuti, 'Ayi, koma tidzapita ku Igupto kumene sitidzaonako nkhondo kapena kumva kulira kwa lipenga kapenanso kusowa chakudya.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.14",
            "verseOrgIds": [
              "JER.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono, inu otsala a ku Yuda, imvani mawu a Yehova. Iye akuti, ngati mutsimikiza zopita ku Igupto, nʼkupitadi kukakhala kumeneko,",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.15",
            "verseOrgIds": [
              "JER.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndiye nkhondo imene mukuyiopayo idzakugonjetsani ku Igupto komweko. Njala imene mukuyiopayo idzakupezani ku Igupto komweko ndipo mudzafera kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.16",
            "verseOrgIds": [
              "JER.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunena zoona, onse amene atsimikiza zopita ku Igupto kuti akakhale kumeneko adzafa ndi nkhondo njala ndi mliri. Palibe ndi mmodzi yemwe amene adzapulumuke kapena kuthawa mavuto amene ndidzawagwetsera.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.17",
            "verseOrgIds": [
              "JER.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Wamphamvuzonse, Mulungu wa Israeli akuti, 'Momwe ndinawakwiyira mwaukali anthu okhala mu Yerusalemu, koteronso ndidzakukwiyirani mukapita ku Igupto. Mudzasanduka chinthu chotembereredwa ndi chochititsa mantha, choseketsa ndi chonyozeka. Malo ano simudzawaonanso.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.18",
            "verseOrgIds": [
              "JER.42.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inu otsala a ku Yuda, Yehova wakuwuzani kuti, 'Musapite ku Igupto.' Dziwani chinthu ichi: Ine lero ndikukuchenjezani",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.19",
            "verseOrgIds": [
              "JER.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti munalakwitsa kwambiri. Inu munandituma kwa Yehova Mulungu wanu nʼkumati 'Mukatipempherere kwa Yehova Mulungu wathu, nʼkudzatiwuza chimene afuna kuti tichite, ndipo ife tidzachita.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.20",
            "verseOrgIds": [
              "JER.42.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine lero ndakuwuzani, koma inu simukumverabe zonse zimene Yehova Mulungu anandituma kuti ndikuwuzeni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.21",
            "verseOrgIds": [
              "JER.42.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono dziwani ichi: mudzafadi ndi nkhondo, njala ndi mliri kumalo kumene mukufuna mukakhaleko.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.22",
            "verseOrgIds": [
              "JER.42.22"
            ]
          }
        }
      ]
    }
  ],
