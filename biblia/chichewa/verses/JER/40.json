  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
        "style": "c",
        "sid": "JER 40"
      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amasula Yeremiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anayankhula ndi Yeremiya pamene Nebuzaradani mtsogoleri wa asilikali olonda mfumu anamasula Yeremiyayo ku Rama. Anamupeza Yeremiya ali womangidwa ndi unyolo pamodzi ndi amʼndende ena onse a ku Yerusalemu ndi a ku Yuda amene ankapita nawo ku ukapolo ku Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.1",
            "verseOrgIds": [
              "JER.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtsogoleriyu anamupeza Yeremiya, anamuwuza kuti, \"Yehova Mulungu wako analengeza kale zakuti malo ano adzawonongedwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.2",
            "verseOrgIds": [
              "JER.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo tsopano Yehova wachitadi zimenezi monga mmene ananenera. Izi zonse zachitika chifukwa anthu inu munachimwira Yehova ndipo simunamumvere.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.3",
            "verseOrgIds": [
              "JER.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma tsopano taona, lero ndikukumasula unyolo umene unali mʼmanja mwako. Ngati ukufuna kupita nane ku Babuloni, tiye ndipo adzakusamala bwino. Koma ngati sukufuna kupita, ndiye usapite. Dziko ndi limeneli monga ukulioneramo. Uli ndi ufulu kupita kulikonse kumene ukufuna.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.4",
            "verseOrgIds": [
              "JER.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya asanayankhe, Nebuzaradani anamuwuzanso kuti, \"Ngati supita ndiye pita, ubwerere kwa Gedaliya, mwana wa Ahikamu, mdzukulu wa Safani, amene mfumu ya ku Babuloni inamusankha kuti akhale bwanamkubwa wa Yuda. Ukakhale naye pakati pa anthu, kapena upite kulikonse ukufuna.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.5",
            "verseOrgIds": [
              "JER.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 40:5"
      },
      "items": [
        {
          "text": "Ndipo mtsogoleri uja anamupatsa Yeremiya chakudya ndi mphatso zina ndi kumulola kuti apite.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.5",
            "verseOrgIds": [
              "JER.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motero Yeremiya anapita kwa Gedaliya mwana wa Ahikamu ku Mizipa ndipo anakakhala naye kumeneko pakati pa anthu amene anatsala mʼdzikomo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.6",
            "verseOrgIds": [
              "JER.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuphedwa kwa Gedaliya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panali atsogoleri ena a nkhondo ndi anthu awo amene sanadzipereke nawo. Iwowa anamva kuti mfumu ya ku Babuloni inasankha Gedaliya mwana wa Ahikamu kukhala bwanamkubwa wa dzikolo ndipo kuti yamuyika kukhala wolamulira amuna, akazi ndi ana amene anali osauka kwambiri mʼdzikomo, amene sanawagwire ukapolo kupita nawo ku Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.7",
            "verseOrgIds": [
              "JER.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwowa anapita ku Mizipa kwa Gedaliya. Amene anapitawo ndi awa: Ismaeli mwana wa Netaniya, Yohanani ndi Yonatani ana a Kareya, Seraya mwana wa Tanihumeti, ana a Efai a ku Netofa, ndi Yezaniya mwana wa Maaka, iwowo pamodzi ndi anthu awo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.8",
            "verseOrgIds": [
              "JER.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedaliya mwana wa Ahikamu, mdzukulu wa Safani, anawalonjeza iwo pamodzi ndi anthuwo mwalumbiro. Ndipo anati, \"Musaope kuwatumikira Ababuloni. Khalani mʼdziko muno, tumikirani mfumu ya ku Babuloni, ndipo zinthu zidzakuyenderani bwino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.9",
            "verseOrgIds": [
              "JER.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzakhala ku Mizipa kuti ndizikuyimirirani kwa Ababuloni amene azidzabwera kwa ife, koma inu muzikolola vinyo wanu, zipatso zanu, mafuta anu ndi kuzisunga mʼmitsuko yanu, nʼkumakhala mʼmizinda imene mwalandayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.10",
            "verseOrgIds": [
              "JER.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawonso Ayuda onse a ku Mowabu, ku Amoni, ku Edomu ndi a ku mayiko ena onse anamva kuti mfumu ya ku Babuloni inasiyako anthu ena ku Yuda ndipo kuti inasankha Gedaliya mwana wa Ahikamu, mwana wa Safani, kukhala bwanamkubwa wawo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.11",
            "verseOrgIds": [
              "JER.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Ayuda onsewo anabwerera ku Yuda, ku Mizipa kwa Gedaliya, kuchokera ku mayiko onse kumene anabalalikira. Ndipo anakolola zipatso zochuluka ndi vinyo wambiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.12",
            "verseOrgIds": [
              "JER.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohanani mwana wa Kareya ndi atsogoleri a ankhondo onse amene sanadzipereke aja anabwera ku Mizipa kwa Gedaliya",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.13",
            "verseOrgIds": [
              "JER.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo anamufunsa kuti, \"Kodi sukudziwa kuti Baalisi mfumu ya Aamoni watuma Ismaeli mwana wa Netaniya kuti akuphe?\" Koma Gedaliya mwana wa Ahikamu sanawankhulupirire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.14",
            "verseOrgIds": [
              "JER.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Yohanani mwana wa Kareya, mwamseri anawuza Gedaliya ku Mizipa kuti, \"Loleni ndipite ndikaphe Ismaeli mwana wa Netaniya, ndipo palibe amene ati adziwe. Akuphereninji ndi kuchititsa Ayuda onse, amene akuzungulirani kuti abalalike ndi kuti otsala a ku Yuda awonongeke?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.15",
            "verseOrgIds": [
              "JER.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Gedaliya mwana wa Ahikamu anawuza Yohanani mwana wa Kareya kuti, \"Usachite zimenezo! Zimene ukunena za Ismaeli ndi zabodza.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.16",
            "verseOrgIds": [
              "JER.40.16"
            ]
          }
        }
      ]
    }
  ],
