      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:22"
      },
      "items": [
        {
          "text": "Ife chikhulupiriro chathu chili pa Inu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.22",
            "verseOrgIds": [
              "JER.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:22"
      },
      "items": [
        {
          "text": "popeza Inu nokha ndinu Yehova Mulungu wathu",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.22",
            "verseOrgIds": [
              "JER.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:22"
      },
      "items": [
        {
          "text": "amene mukhoza kuchita zimenezi.",
