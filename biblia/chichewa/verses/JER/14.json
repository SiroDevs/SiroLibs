      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "ndikuona amene asakazidwa ndi njala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "Ngakhale aneneri pamodzi",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "ndi ansembe onse atengedwa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi anthu a ku Yuda mwawakana kwathunthu?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "Kodi mtima wanu wanyansidwa nawo anthu a ku Ziyoni?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "Chifukwa chiyani mwatikantha chotere",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "kuti sitingathenso kuchira?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "Ife tinayembekezera mtendere",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "koma palibe chabwino chomwe chabwera,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "tinayembekezera kuchira",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
