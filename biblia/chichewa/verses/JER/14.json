          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa milungu yachabechabe ya anthu a mitundu ina,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.22",
            "verseOrgIds": [
              "JER.14.22"
            ]
          }
        }
      ]
    },
