  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JER 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chilala, Njala, Lupanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa ndi mawu amene Yehova anamuwuza Yeremiya onena za chilala:",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.1",
            "verseOrgIds": [
              "JER.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yuda akulira,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:2"
      },
      "items": [
        {
          "text": "mizinda yake ikuvutika;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:2"
      },
      "items": [
        {
          "text": "anthu ake adzigwetsa pansi mwachisoni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:2"
      },
      "items": [
        {
          "text": "kulira kwa Yerusalemu kwakula.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu awo wolemekezeka akutuma antchito awo kuti akatunge madzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "Apita ku zitsime",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "osapezako madzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "Choncho amabwerera ndi mitsuko yopanda madzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "Amanyazi ndi othedwa nzeru",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "adziphimba kumaso.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza pansi pawumiratu",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:4"
      },
      "items": [
        {
          "text": "chifukwa kulibe madzi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:4"
      },
      "items": [
        {
          "text": "alimi ali ndi manyazi",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:4"
      },
      "items": [
        {
          "text": "ndipo amphimba nkhope zawo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale mbawala yayikazi",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:5"
      },
      "items": [
        {
          "text": "ikusiya mwana wake wakhanda ku thengo",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:5"
      },
      "items": [
        {
          "text": "chifukwa kulibe msipu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbidzi zikuyima pa zitunda zopanda kanthu",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:6"
      },
      "items": [
        {
          "text": "nʼkumapuma wefuwefu ngati nkhandwe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:6"
      },
      "items": [
        {
          "text": "maso awo achita chidima",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:6"
      },
      "items": [
        {
          "text": "chifukwa chosowa msipu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu akuti, \"Ngakhale machimo athu akutitsutsa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:7"
      },
      "items": [
        {
          "text": "koma Inu Yehova chitanipo kanthu chifukwa cha dzina lanu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:7"
      },
      "items": [
        {
          "text": "Pakuti kusakhulupirika kwathu nʼkwakukulu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:7"
      },
      "items": [
        {
          "text": "ife takuchimwirani.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova amene Aisraeli amakukhulupirirani",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:8"
      },
      "items": [
        {
          "text": "ndi amene mumawapulumutsa pa nthawi ya masautso,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:8"
      },
      "items": [
        {
          "text": "chifukwa chiyani mukukhala ngati mlendo mʼdziko muno?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:8"
      },
      "items": [
        {
          "text": "Chifukwa chiyani muli ngati wapaulendo amene akungogona tsiku limodzi?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa chiyani muli ngati munthu amene wadzidzimutsidwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "kapena ngati wankhondo amene alibe mphamvu yopulumutsa?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "Komabe Inu Yehova, muli pakati pathu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "ndipo tikudziwika ndi dzina lanu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "musatitaye ife!\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimene Yehova akunena za anthuwa ndi izi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "\"Iwo amakonda kuyendayenda kwambiri;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "samatha kudziretsa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "Nʼchifukwa chake Ine Yehova sindingawalandire,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "ndipo tsopano ndidzakumbukira zoyipa zawo",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "ndi kuwalanga chifukwa cha machimo awo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yehova anandiwuza kuti, \"Usawapempherere anthu awa kuti zinthu ziwayendere bwino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.11",
            "verseOrgIds": [
              "JER.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale asale zakudya, Ine sindidzamva kulira kwawo; ngakhale apereke nsembe zopsereza ndi chopereka cha chakudya, sindidzazilandira. Mʼmalo mwake, ndidzawapha ndi lupanga, njala ndi mliri.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.12",
            "verseOrgIds": [
              "JER.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ine ndinati, \"Aa, Ambuye Yehova, aneneri amawawuza anthuwo kuti, sadzaphedwa ndi lupanga kapena kuvutika ndi njala. Koma kuti Inu mudzawapatsa mtendere wokhawokha pamalo pano.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.13",
            "verseOrgIds": [
              "JER.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova anandiwuza kuti, \"Ndi zabodza kuti aneneriwa akunenera mʼdzina langa. Ine sindinawatume kapena kuwasankha kapenanso kuyankhula nawo. Iwo amakuwuzani zinthu zabodza zomwe amati anaziona mʼmasomphenya, kapena pogwiritsa ntchito mawula achabechabe. Zimene amayankhula ndi zongopeka mʼmutu mwawo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.14",
            "verseOrgIds": [
              "JER.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake Ine Yehova ndikuti aneneri amenewa akulosera mʼdzina langa pamene Ine sindinawatume. Iwo amati simudzafa pa nkhondo kapena ndi njala mʼdziko muno. Koma tsono ndi iwowo, aneneriwa amene adzafe pa nkhondo kapena ndi njala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.15",
            "verseOrgIds": [
              "JER.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anthu amene anawaloserawo adzaponyedwa mʼmisewu ya mu Yerusalemu atafa ndi njala ndi lupanga. Sipadzapezeka wowayika mʼmanda popeza iwowo, akazi awo, ana awo aamuna, onse adzakhala atafa. Ine ndidzawagwetsera chilango chowayenera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.16",
            "verseOrgIds": [
              "JER.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Awuze mawu awa:",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "\" 'Maso anga akugwetsa misozi kosalekeza",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "usana ndi usiku;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "chifukwa anthu anga okondedwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "apwetekeka kwambiri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "akanthidwa kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
