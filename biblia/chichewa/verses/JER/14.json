      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:22"
      },
      "items": [
        {
          "text": "kodi pali mulungu amene angagwetse mvula?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.22",
            "verseOrgIds": [
              "JER.14.22"
            ]
          }
        }
      ]
    },
    {
