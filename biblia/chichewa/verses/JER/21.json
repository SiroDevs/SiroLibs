  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "JER 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mulungu Akana Pempho la Zedekiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu Zedekiya inatuma Pasuri mwana wa Malikiya ndi wansembe Zefaniya mwana wa Maseya kwa Yeremiya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amati akanene kwa Yeremiya mawu akuti, \"Tinenere kwa Yehova chifukwa Nebukadinezara mfumu ya Babuloni akutithira nkhondo. Mwina mwake Yehova nʼkutichitira zodabwitsa kuti Nebukadinezarayo achoke kwathu kuno.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yehova anawuza Yeremiya kuti ayankhe Pasuri ndi Zefaniya kuti, \"Kamuwuzeni Zedekiya kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.3",
            "verseOrgIds": [
              "JER.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Yehova, Mulungu wa Israeli akuti ndikulandeni zida zimene zili mʼmanja mwanu zimene mukugwiritsa ntchito polimbana ndi mfumu ya ku Babuloni ndi ankhondo ake amene akuzingani kunja kwa lingali. Ndipo ndidzasonkhanitsa zidazo mʼkati mwa mzindawu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ineyo mwini wakene ndi mkono wotambasula ndi dzanja lamphamvu, ndidzachita nanu nkhondo ndili wokwiya, wokalipa ndi waukali.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.5",
            "verseOrgIds": [
              "JER.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakantha amene amakhala mu mzinda muno, anthu pamodzi ndi zirombo, ndipo zidzafa ndi mliri woopsa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.6",
            "verseOrgIds": [
              "JER.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake, ndidzapereka Zedekiya mfumu ya ku Yuda, nduna zake pamodzi ndi anthu a mu mzinda muno amene adzapulumuke pa nthawi ya mliri, lupanga ndi njala kwa Nebukadinezara mfumu ya ku Babuloni ndi kwa adani awo amene ankafuna kuwapha. Iye adzawapha ndi lupanga. Sadzawachitira chifundo kapena kuwamvera chisoni kapenanso kuwakomera mtima.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yehova anati ndiwawuzenso anthu amenewa kuti asankhe pakati pa moyo ndi imfa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliyense amene akhale mu mzinda muno adzaphedwa ndi lupanga, njala kapena mliri. Koma aliyense amene apite kukadzipereka kwa Ababuloni amene akuzinganiwa adzakhala ndi moyo, adzapulumuka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.9",
            "verseOrgIds": [
              "JER.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndatsimikiza kuchitira mzinda uno choyipa osati chabwino, akutero Yehova. Udzaperekedwa mʼdzanja la mfumu ya ku Babuloni, ndipo iyeyo adzawutentha ndi moto.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Komanso, uwuze banja laufumu la Yuda kuti, 'Imva mawu a Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
              "JER.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "inu a mʼbanja la Davide, Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "\" 'Weruzani mwachilungamo mmawa uliwonse;",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "pulumutsani mʼdzanja la wozunza",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "aliyense amene walandidwa katundu wake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "kuopa kuti ukali wanga ungabuke",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "ndi kuyaka ngati moto wosazimitsika",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "chifukwa cha zoyipa zimene mwachita.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzalimbana nanu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "inu amene mukukhala pamwamba pa chigwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "inu okhala ngati thanthwe lapachidikha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "Inu amene mumanena kuti, 'Ndani amene angabwere kudzalimbana nafe?",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "Ndani amene angathe kulowa mʼmalinga mwathu?'",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakulangani molingana ndi ntchito zanu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.14",
            "verseOrgIds": [
              "JER.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 21:14"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:14"
      },
      "items": [
        {
          "text": "Ndidzatentha nkhalango zanu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.14",
            "verseOrgIds": [
              "JER.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:14"
      },
      "items": [
        {
          "text": "moto udzapsereza zonse zimene zakuzungulirani.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.14",
            "verseOrgIds": [
              "JER.21.14"
            ]
          }
        }
      ]
    }
  ],
