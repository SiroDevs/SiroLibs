              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma Yehova Wamphamvuzonse akuti, 'Ine ndidzawalanga. Achinyamata awo adzaphedwa ndi lupanga, ana awo aamuna ndi aakazi adzafa ndi njala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.22",
