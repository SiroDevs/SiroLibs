      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:12"
      },
      "items": [
        {
          "text": "ku zitunda zonse za mʼchipululu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.12",
            "verseOrgIds": [
              "JER.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:12"
      },
      "items": [
        {
          "text": "Yehova watuma ankhondo ake",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.12",
            "verseOrgIds": [
              "JER.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:12"
      },
      "items": [
        {
          "text": "kudzawatha kuyambira kumalire ena a dziko mpaka ku malire enanso a dziko,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.12",
            "verseOrgIds": [
              "JER.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:12"
      },
      "items": [
        {
          "text": "ndipo palibe amene adzakhale pa mtendere.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.12",
            "verseOrgIds": [
              "JER.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
