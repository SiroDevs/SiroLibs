      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:11"
      },
      "items": [
        {
          "text": "Dziko lonse lasanduka chipululu",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.11",
            "verseOrgIds": [
              "JER.12.11"
            ]
          }
        }
      ]
    },
    {
