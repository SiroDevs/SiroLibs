              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unawusandutsadi chipululu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.11",
            "verseOrgIds": [
              "JER.12.11"
            ]
          }
