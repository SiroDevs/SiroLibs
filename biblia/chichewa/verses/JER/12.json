      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:11"
      },
      "items": [
        {
          "text": "chifukwa palibe wolisamalira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.11",
            "verseOrgIds": [
              "JER.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
