      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:11"
      },
      "items": [
        {
          "text": "Ukanali wokhawokha chomwecho ukundilirira Ine.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.11",
            "verseOrgIds": [
              "JER.12.11"
            ]
          }
        }
      ]
    },
    {
