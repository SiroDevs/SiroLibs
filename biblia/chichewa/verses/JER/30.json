      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:16"
      },
      "items": [
        {
          "text": "adani anu onse adzapita ku ukapolo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.16",
            "verseOrgIds": [
              "JER.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:16"
      },
      "items": [
        {
          "text": "Iwo amene anafunkha zinthu zanu, zinthu zawo zidzafunkhidwanso;",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.16",
            "verseOrgIds": [
              "JER.30.16"
            ]
