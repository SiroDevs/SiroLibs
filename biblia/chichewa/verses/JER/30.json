      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:14"
      },
      "items": [
        {
          "text": "Ndakukanthani ngati mmene mdani akanachitira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.14",
            "verseOrgIds": [
              "JER.30.14"
