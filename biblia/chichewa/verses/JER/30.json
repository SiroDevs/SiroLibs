      "attrs": {
        "style": "q2",
        "vid": "JER 30:16"
      },
      "items": [
        {
          "text": "onse amene anakusakazani nawonso adzasakazidwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.16",
            "verseOrgIds": [
              "JER.30.16"
            ]
