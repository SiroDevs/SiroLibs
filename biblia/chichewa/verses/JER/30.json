  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "JER 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kubwezeretsedwa kwa Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anawuza Yeremiya kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.1",
            "verseOrgIds": [
              "JER.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ine Yehova, Mulungu wa Israeli ndikuti, 'Lemba mʼbuku mawu onse amene ndakuwuza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi ikubwera pamene ndidzachotse anthu anga, Israeli ndi Yuda kuchokera ku ukapolo ndi kuwabwezera dziko limene ndinapatsa makolo awo,' akutero Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawa mawu amene Yehova anayankhula ndi anthu a ku Israeli ndi Yuda:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.4",
            "verseOrgIds": [
              "JER.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yehova akuti:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
            "verseOrgIds": [
              "JER.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:5"
      },
      "items": [
        {
          "text": "\"Ndamva kulira chifukwa cha nkhawa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
            "verseOrgIds": [
              "JER.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:5"
      },
      "items": [
        {
          "text": "ndamva kulira kwa mantha popeza palibe mtendere.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
            "verseOrgIds": [
              "JER.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono khalani pansi ndi kudzifunsa kuti:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:6"
      },
      "items": [
        {
          "text": "Kodi munthu wamwamuna angathe kubereka mwana?",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:6"
      },
      "items": [
        {
          "text": "Nanga nʼchifukwa chiyani ndikuona munthu aliyense wamwamuna",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:6"
      },
      "items": [
        {
          "text": "atagwira manja ake pa mimba pake ngati mayi pa nthawi yake yochira?",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:6"
      },
      "items": [
        {
          "text": "Chifukwa chiyani nkhope iliyonse ili yakugwa?",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayo ine! Tsiku limeneli ndi lalikulu kwambiri!",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:7"
      },
      "items": [
        {
          "text": "Sipadzakhala lina lofanana nalo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:7"
      },
      "items": [
        {
          "text": "Idzakhala nthawi ya masautso kwa Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:7"
      },
      "items": [
        {
          "text": "koma adzapulumuka ku masautsowo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Wamphamvuzonse akuti, \"Pa tsiku limenelo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:8"
      },
      "items": [
        {
          "text": "ndidzathyola goli la ukapolo mʼkhosi mwawo",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:8"
      },
      "items": [
        {
          "text": "ndipo ndidzadula zingwe zowamanga;",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:8"
      },
      "items": [
        {
          "text": "Aisraeli sadzakhalanso akapolo a alendo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmalo mwake, adzatumikira Yehova Mulungu wawo",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:9"
      },
      "items": [
        {
          "text": "ndiponso Davide mfumu yawo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:9"
      },
      "items": [
        {
          "text": "amene ndidzawasankhira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Tsono usachite mantha, iwe mtumiki wanga Yakobo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "usade nkhawa, iwe Israeli,'",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "'Ndithu ndidzakupulumutsa kuchokera ku dziko lakutali,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "zidzukulu zako kuchokera ku dziko la ukapolo wawo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "Yakobo adzabwerera ndipo adzakhala modekha pa mtendere,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "ndipo palibe amene adzamuchititsa mantha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndili nanu ndipo ndidzakupulumutsani,'",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "'Ngakhale ndidzawononga kotheratu mitundu yonse ya anthu",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "kumene ndinakubalalitsirani,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "koma inu sindidzakuwonongani kotheratu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "Sindidzakulekani kuti mukhale osalangidwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "Koma ndidzakulangani mwachilungamo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.12",
            "verseOrgIds": [
              "JER.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:12"
      },
      "items": [
        {
          "text": "\"Chilonda chanu nʼchosachizika,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.12",
            "verseOrgIds": [
              "JER.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:12"
      },
      "items": [
        {
          "text": "bala lanu ndi lonyeka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.12",
            "verseOrgIds": [
              "JER.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palibe amene angathe kukutetezani pa mlandu wanu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.13",
            "verseOrgIds": [
              "JER.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
