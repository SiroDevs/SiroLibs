          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsono onse amene anakuwonongani, nawonso adzawonongedwa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.16",
            "verseOrgIds": [
              "JER.30.16"
            ]
          }
        }
