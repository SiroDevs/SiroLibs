        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:21"
      },
      "items": [
        {
          "text": "Ndani angalimbe mtima payekha kuyandikana nane",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.21",
            "verseOrgIds": [
              "JER.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:21"
      },
      "items": [
        {
          "text": "popanda kuyitanidwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.21",
            "verseOrgIds": [
              "JER.30.21"
            ]
          }
        }
      ]
    },
