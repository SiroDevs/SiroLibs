          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa chiyani mukulira nacho chilonda chanu?",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.15",
            "verseOrgIds": [
              "JER.30.15"
            ]
