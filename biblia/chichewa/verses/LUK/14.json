  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "LUK 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Mʼnyumba ya Mfarisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku lina la Sabata, Yesu atapita kukadya ku nyumba ya Mfarisi wodziwika, Afarisi anamulonda mosamalitsa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.1",
            "verseOrgIds": [
              "LUK.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poteropo, patsogolo pake panali munthu amene anadwala matenda otupa mimba ndi miyendo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.2",
            "verseOrgIds": [
              "LUK.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anafunsa Afarisi ndi akatswiri amalamulo kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.3",
            "verseOrgIds": [
              "LUK.14.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi ndi zololedwa kuchiritsa pa tsiku la Sabata kapena ayi?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.3",
                "verseOrgIds": [
                  "LUK.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.3",
            "verseOrgIds": [
              "LUK.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma iwo sanayankhe. Tsono atamutenga munthuyo, Iye anamuchiritsa ndipo anamuwuza kuti azipita.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.4",
            "verseOrgIds": [
              "LUK.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Iye anawafunsa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.5",
            "verseOrgIds": [
              "LUK.14.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi ngati mmodzi mwa inu ali ndi mwana wamwamuna kapena ngʼombe imene yagwera mʼchitsime tsiku la Sabata, kodi simungamuvuwulemo tsiku lomwelo?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.5",
                "verseOrgIds": [
                  "LUK.14.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.5",
            "verseOrgIds": [
              "LUK.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo iwo analibe choyankha.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.6",
            "verseOrgIds": [
              "LUK.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kudzichepetsa ndi Kulandira Ulemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ataona momwe alendo amasankhira malo aulemu pa tebulo, Iye anawawuza fanizo ili:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.7",
            "verseOrgIds": [
              "LUK.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pamene wina wakuyitanani ku phwando la ukwati, musakhale pa malo aulemu ayi, chifukwa mwina anayitananso munthu wina wolemekezeka kuposa inu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.8",
                "verseOrgIds": [
                  "LUK.14.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.8",
            "verseOrgIds": [
              "LUK.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati zitatero, ndiye kuti munthu uja amene anakuyitani inu nonse awiri adzakuwuzani kuti, 'Mupatseni munthu uyu malo anu.' Pamenepo inu mudzachita manyazi, pokakhala malo wotsika.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.9",
                "verseOrgIds": [
                  "LUK.14.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.9",
            "verseOrgIds": [
              "LUK.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma akakuyitanani, khalani pa malo otsika, kuti amene anakuyitanani uja adzakuwuzeni kuti, 'Bwenzi, bwera udzakhale pa malo aulemu pano.' Pamenepo inu mudzalandira ulemu pamaso pa alendo anzanu onse.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.10",
                "verseOrgIds": [
                  "LUK.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.10",
            "verseOrgIds": [
              "LUK.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti aliyense wodzikuza adzamuchepetsa, ndipo aliyense wodzichepetsa adzamukweza.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.11",
                "verseOrgIds": [
                  "LUK.14.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yesu anati kwa mwini malo uja,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.12",
            "verseOrgIds": [
              "LUK.14.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ukakonza chakudya chamasana kapena chamadzulo, usamayitane abwenzi ako, abale ako, anthu afuko lako kapena anzako achuma; ngati iwe utero, iwo adzakuyitananso, choncho udzalandiriratu mphotho yako.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.12",
                "verseOrgIds": [
                  "LUK.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.12",
            "verseOrgIds": [
              "LUK.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma ukakonza phwando, itana anthu osauka, ofa ziwalo, olumala ndi osaona.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.13",
                "verseOrgIds": [
                  "LUK.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.13",
            "verseOrgIds": [
              "LUK.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamenepo udzakhala wodala, chifukwa iwo sangakubwezere kanthu, koma Mulungu ndiye adzakubwezera pa chiukitso cha olungama.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.14",
                "verseOrgIds": [
                  "LUK.14.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fanizo la Phwando Lalikulu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmodzi mwa amene amadya naye atamva izi, anati kwa Yesu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.15",
            "verseOrgIds": [
              "LUK.14.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndi wodala munthu amene adzadye nawo mu ufumu wa Mulungu.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.15",
                "verseOrgIds": [
                  "LUK.14.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.16",
            "verseOrgIds": [
              "LUK.14.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Munthu wina ankakonza phwando lalikulu ndipo anayitana alendo ambiri.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.16",
                "verseOrgIds": [
                  "LUK.14.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.16",
            "verseOrgIds": [
              "LUK.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nthawi yaphwando itakwana anatuma wantchito wake kuti akawuze onse amene anayitanidwa kuti, 'Bwerani, pakuti zonse zakonzeka.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.17",
                "verseOrgIds": [
                  "LUK.14.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koma onse anayamba kupereka zifukwa mofanana. Woyamba anati, 'Ine ndangogula kumene munda, ndipo ndikuyenera kupita kuti ndikawuone. Pepani mundikhululukire.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.18",
                "verseOrgIds": [
                  "LUK.14.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wina anati, 'Ndangogula kumene ngʼombe khumi zokoka ngolo ndipo kupita kukaziyesa. Pepani mundikhululukire.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.19",
                "verseOrgIds": [
                  "LUK.14.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wina anatinso, 'Ine ndangokwatira kumene, choncho sinditha kubwera.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.20",
                "verseOrgIds": [
                  "LUK.14.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wantchitoyo anabwera ndikudzamuwuza bwana wakeyo zimenezi. Pamenepo mphwandoyo anapsa mtima ndipo analamula wantchito wakeyo kuti, 'Pita msangamsanga kunja mʼmisewu ndi mʼmakwalala a mu mzinda ndipo ukabweretse osauka, ofa ziwalo, osaona ndi olumala.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.21",
                "verseOrgIds": [
                  "LUK.14.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wantchitoyo anati, 'Bwana, zimene munanena zachitika koma malo akanalipobe.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.22",
                "verseOrgIds": [
                  "LUK.14.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndipo mbuye uja anawuza wantchito wake kuti, 'Pita kunja ku misewu ikuluikulu ndi kunja kwa mpanda ndipo ukawawuze kuti alowe, kuti nyumba yanga idzaze.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.23",
                "verseOrgIds": [
                  "LUK.14.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.23",
            "verseOrgIds": [
              "LUK.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndikukuwuzani inu kuti palibe ndi mmodzi yemwe mwa anthu amene anayitanidwa adzalawa phwandolo.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.24",
                "verseOrgIds": [
                  "LUK.14.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dipo la Kutsatira Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gulu lalikulu la anthu linkayenda naye Yesu ndipo atatembenukira kwa iwo anati,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.25",
            "verseOrgIds": [
              "LUK.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngati wina aliyense abwera kwa Ine ndipo sadana ndi abambo ndi amayi ake, mkazi wake ndi ana, abale ake ndi alongo ake, inde ngakhale moyo wake omwe, iye sangakhale ophunzira wanga.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.26",
                "verseOrgIds": [
                  "LUK.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.26",
            "verseOrgIds": [
              "LUK.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo aliyense amene sasenza mtanda wake ndi kunditsata Ine sangakhale ophunzira wanga.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.27",
                "verseOrgIds": [
                  "LUK.14.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Taganizani, ngati wina mwa inu akufuna kumanga nsanja, kodi iye sayamba wakhala pansi ndi kuganizira za mtengo wake kuti aone ngati ali ndi ndalama zokwanira kuti atsirizire?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.28",
                "verseOrgIds": [
                  "LUK.14.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.28",
            "verseOrgIds": [
              "LUK.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti ngati ayika maziko ndi kulephera kutsiriza, aliyense amene adzayiona adzamuseka,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.29",
                "verseOrgIds": [
                  "LUK.14.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.29",
            "verseOrgIds": [
              "LUK.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nanena kuti, 'Munthu uyu anayamba kumanga koma sanathe kutsiriza.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.30",
                "verseOrgIds": [
                  "LUK.14.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kapena mfumu imene ikupita ku nkhondo kukamenyana ndi mfumu ina, kodi siyamba yakhala pansi ndi kulingalira ngati ingathe ndi anthu 10,000 kulimbana ndi amene akubwera ndi 20,000?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.31",
                "verseOrgIds": [
                  "LUK.14.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.31",
            "verseOrgIds": [
              "LUK.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati singathe, idzatuma nthumwi pomwe winayo ali kutali ndi kukapempha mgwirizano wamtendere.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.32",
                "verseOrgIds": [
                  "LUK.14.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.32",
            "verseOrgIds": [
              "LUK.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mʼnjira yomweyo, wina aliyense wa inu amene sasiya zonse ali nazo sangakhale ophunzira wanga.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.33",
                "verseOrgIds": [
                  "LUK.14.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mchere ndi wabwino, koma ngati usukuluka adzawukoleretsanso ndi chiyani?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.34",
                "verseOrgIds": [
                  "LUK.14.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.34",
            "verseOrgIds": [
              "LUK.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Suyeneranso ngakhale mʼnthaka kapena kudzala la manyowa; umatayidwa kunja.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.35",
                "verseOrgIds": [
                  "LUK.14.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 14:35"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amene ali ndi makutu akumva, amve.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.35",
                "verseOrgIds": [
                  "LUK.14.35"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
