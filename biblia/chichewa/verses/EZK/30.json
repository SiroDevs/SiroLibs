      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:13"
      },
      "items": [
        {
          "text": "\" 'Ndidzawononga mafano",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.13",
            "verseOrgIds": [
              "EZK.30.13"
            ]
          }
        }
