          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku Tehafinehezi kudzakhala mdima",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.18",
            "verseOrgIds": [
              "EZK.30.18"
            ]
          }
        }
      ]
    },
    {
