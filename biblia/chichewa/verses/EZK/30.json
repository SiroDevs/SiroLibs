  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "EZK 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Kulangidwa kwa Igupto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anandiyankhula kuti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.1",
            "verseOrgIds": [
              "EZK.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe mwana wa munthu, nenera ndipo ulengeze zimene Ine Ambuye Yehova ndikunena.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:2"
      },
      "items": [
        {
          "text": "\" 'Ufuwule mawu awa akuti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:2"
      },
      "items": [
        {
          "text": "'Kalanga, tsiku lafika!'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti tsiku layandikira,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.3",
            "verseOrgIds": [
              "EZK.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:3"
      },
      "items": [
        {
          "text": "tsiku la Yehova lili pafupi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.3",
            "verseOrgIds": [
              "EZK.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:3"
      },
      "items": [
        {
          "text": "tsiku la mitambo yakuda,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.3",
            "verseOrgIds": [
              "EZK.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:3"
      },
      "items": [
        {
          "text": "tsiku lachiwonongeko cha mitundu ya anthu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.3",
            "verseOrgIds": [
              "EZK.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lupanga lidzabwera kudzalimbana ndi Igupto",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:4"
      },
      "items": [
        {
          "text": "ndipo mavuto adzafika pa Kusi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:4"
      },
      "items": [
        {
          "text": "Pamene anthu ambiri adzaphedwa mu Igupto,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:4"
      },
      "items": [
        {
          "text": "chuma chake chidzatengedwa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:4"
      },
      "items": [
        {
          "text": "ndipo maziko ake adzagumuka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusi, Puti, Ludi ndi Arabiya yense, Libiya ndiponso anthu a mʼdziko logwirizana naye adzaphedwa ndi lupanga pamodzi ndi Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.5",
            "verseOrgIds": [
              "EZK.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ine Ambuye Yehova ndikuti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.6",
            "verseOrgIds": [
              "EZK.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:6"
      },
      "items": [
        {
          "text": "\" 'Onse othandiza Igupto adzaphedwa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.6",
            "verseOrgIds": [
              "EZK.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:6"
      },
      "items": [
        {
          "text": "ndipo kunyadira mphamvu zake kudzatheratu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.6",
            "verseOrgIds": [
              "EZK.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:6"
      },
      "items": [
        {
          "text": "Adzaphedwa ndi lupanga",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.6",
            "verseOrgIds": [
              "EZK.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:6"
      },
      "items": [
        {
          "text": "kuyambira ku Migidoli mpaka ku mzinda wa Asiwani,' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.6",
            "verseOrgIds": [
              "EZK.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "EZK 30:6"
      },
      "items": [
        {
          "text": "ndikutero Ine Ambuye Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Dziko la Igupto lidzasanduka bwinja",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.7",
            "verseOrgIds": [
              "EZK.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:7"
      },
      "items": [
        {
          "text": "kupambana mabwinja ena onse opasuka,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.7",
            "verseOrgIds": [
              "EZK.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:7"
      },
      "items": [
        {
          "text": "ndipo mizinda yake idzakhala yopasuka",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.7",
            "verseOrgIds": [
              "EZK.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:7"
      },
      "items": [
        {
          "text": "kupambana mizinda ina yonse.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.7",
            "verseOrgIds": [
              "EZK.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nditatha kutentha Igupto",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.8",
            "verseOrgIds": [
              "EZK.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:8"
      },
      "items": [
        {
          "text": "ndi kupha onse omuthandiza,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.8",
            "verseOrgIds": [
              "EZK.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:8"
      },
      "items": [
        {
          "text": "pamenepo adzadziwa kuti Ine ndine Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.8",
            "verseOrgIds": [
              "EZK.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nthawi imeneyo ikadzafika, amithenga adzapita mofulumira kuchokera kwa Ine kukaopseza Kusi, iwowo osadziwako kanthu. Ndipo adzada nkhawa pa tsiku limene Igupto adzawonongedwa, chifukwa tsikulo lidzafika ndithu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.9",
            "verseOrgIds": [
              "EZK.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ine Ambuye Yehova ndikuti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.10",
            "verseOrgIds": [
              "EZK.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:10"
      },
      "items": [
        {
          "text": "\" 'Ndidzagwiritsa ntchito Nebukadinezara, mfumu ya ku Babuloni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.10",
            "verseOrgIds": [
              "EZK.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:10"
      },
      "items": [
        {
          "text": "kuti ndithetse gulu lankhondo la Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.10",
            "verseOrgIds": [
              "EZK.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ndi gulu lake lankhondo, mtundu wa anthu ankhanza kwambiri aja",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.11",
            "verseOrgIds": [
              "EZK.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:11"
      },
      "items": [
        {
          "text": "adzabwera kudzawononga dzikolo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.11",
            "verseOrgIds": [
              "EZK.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:11"
      },
      "items": [
        {
          "text": "Adzasolola malupanga awo kulimbana ndi Igupto",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.11",
            "verseOrgIds": [
              "EZK.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:11"
      },
      "items": [
        {
          "text": "ndipo dziko lidzadzaza ndi mitembo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.11",
            "verseOrgIds": [
              "EZK.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzawumitsa mtsinje wa Nailo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.12",
            "verseOrgIds": [
              "EZK.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:12"
      },
      "items": [
        {
          "text": "ndi kugulitsa dziko la Igupto kwa anthu oyipa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.12",
            "verseOrgIds": [
              "EZK.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:12"
      },
      "items": [
        {
          "text": "Ndidzagwiritsa ntchito anthu achilendo kuti ndiwononge dzikolo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.12",
            "verseOrgIds": [
              "EZK.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:12"
      },
      "items": [
        {
          "text": "pamodzi ndi zonse zili mʼmenemo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.12",
            "verseOrgIds": [
              "EZK.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EZK 30:12"
      },
      "items": [
        {
          "text": "Ine Yehova ndayankhula.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.12",
            "verseOrgIds": [
              "EZK.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
