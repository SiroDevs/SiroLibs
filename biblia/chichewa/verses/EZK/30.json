      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:13"
      },
      "items": [
        {
          "text": "ndipo ndidzaopseza dziko lonse.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.13",
            "verseOrgIds": [
              "EZK.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
