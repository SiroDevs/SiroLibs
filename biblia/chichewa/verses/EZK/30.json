          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyamata a ku Oni ndi ku Pibeseti",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.17",
            "verseOrgIds": [
              "EZK.30.17"
            ]
          }
        }
      ]
    },
