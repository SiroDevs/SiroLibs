      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:17"
      },
      "items": [
        {
          "text": "ndipo okhala mʼmizinda yake adzatengedwa ukapolo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.17",
            "verseOrgIds": [
              "EZK.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
