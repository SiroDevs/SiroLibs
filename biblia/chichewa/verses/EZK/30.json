      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:14"
      },
      "items": [
        {
          "text": "ndi kutentha mzinda wa Zowani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.14",
            "verseOrgIds": [
              "EZK.30.14"
            ]
          }
        }
