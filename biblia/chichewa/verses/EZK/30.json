      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:15"
      },
      "items": [
        {
          "text": "ndi kuwononga gulu lankhondo la Thebesi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.15",
            "verseOrgIds": [
