            "verseOrgIds": [
              "EZK.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:16"
      },
      "items": [
        {
          "text": "Malinga a Thebesi adzagumuka,",
