  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "EZK 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Chilango cha Igupto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku lakhumi ndi chiwiri la mwezi wakhumi, chaka chakhumi, Yehova anandiyankhula kuti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe mwana wa munthu, tembenukira kwa Farao, mfumu ya Igupto, ndipo unenere modzudzula mfumuyo pamodzi ndi dziko lake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.2",
            "verseOrgIds": [
              "EZK.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyiwuze mfumuyo kuti, 'Ine Ambuye Yehova ndikuti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:3"
      },
      "items": [
        {
          "text": "\" 'Ndine mdani wako, iwe Farao mfumu ya Igupto,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:3"
      },
      "items": [
        {
          "text": "iwe ngʼona yayikulu yogona pakati pa mitsinje yako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:3"
      },
      "items": [
        {
          "text": "Umanena kuti, 'Mtsinje wa Nailo ndi wanga;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:3"
      },
      "items": [
        {
          "text": "ndinadzipangira ndekha.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ndidzakukola ndi mbedza mʼkamwa mwako",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:4"
      },
      "items": [
        {
          "text": "ndipo nsomba za mʼmitsinje yako zidzakangamira ku mamba ako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:4"
      },
      "items": [
        {
          "text": "Tsono ndidzakutulutsa mu mtsinje mwakomo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:4"
      },
      "items": [
        {
          "text": "pamodzi ndi nsomba zimene zakangamira ku mamba ako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakutaya ku chipululu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "iwe pamodzi ndi nsomba zonse za mʼmitsinje yako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "Udzagwera pamtetete kuthengo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "popanda munthu woti akutole kuti akayike maliro ako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "Ndidzakusandutsa chakudya",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "cha zirombo za pa dziko lapansi ndi mbalame za mlengalenga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motero aliyense amene amakhala mu Igupto adzadziwa kuti Ine ndine Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.6",
            "verseOrgIds": [
              "EZK.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 29:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 29:6"
      },
      "items": [
        {
          "text": "\" 'Iwe unakhala ngati ndodo yabango ku Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.6",
            "verseOrgIds": [
              "EZK.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene anakugwira unathethekera mʼmanja mwawo ndi kucheka mapewa awo. Pamene anakutsamira, unathyoka ndipo misana yawo inagwedezeka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.7",
            "verseOrgIds": [
              "EZK.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼchifukwa chake Ine Ambuye Yehova ndikuti, ndikubweretsera lupanga kuti lidzaphe anthu pamodzi ndi nyama zomwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.8",
            "verseOrgIds": [
              "EZK.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko la Igupto lidzasanduka lopanda anthu. Pamenepo iwo adzadziwa kuti Ine ndine Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.9",
            "verseOrgIds": [
              "EZK.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 29:9"
      },
      "items": [
        {
          "text": "\" 'Popeza iwe unati, 'Mtsinje wa Nailo ndi wanga; ndinawupanga ndine,'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.9",
            "verseOrgIds": [
              "EZK.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼchifukwa chake Ine ndikudana nawe pamodzi ndi mitsinje yakoyo, ndipo ndidzasandutsa dziko la Igupto bwinja kuyambira chipululu cha Migidoli mpaka ku mzinda wa Asiwani, kukafika ku malire a Kusi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.10",
            "verseOrgIds": [
              "EZK.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palibe phazi la munthu kapena la nyama limene lidzapondepo. Kudzakhala kopanda anthu kwa zaka makumi anayi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.11",
            "verseOrgIds": [
              "EZK.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzasandutsa dziko la Igupto kukhala chipululu ngati zipululu za mayiko ena. Kwa zaka makumi anayi mizinda yakenso idzakhala yopasuka pakati pa mizinda yopasuka. Ndipo ndidzathamangitsira Aigupto pakati pa mitundu ya anthu ndi kuwabalalitsira mʼmayiko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.12",
            "verseOrgIds": [
              "EZK.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Komabe Ine Ambuye Yehova ndikuti: Pakutha pa zaka makumi anayi ndidzasonkhanitsa Aigupto onse kuchokera ku mayiko amene ndinawabalalitsirako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.13",
            "verseOrgIds": [
              "EZK.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzachotsa Aiguptowo ku ukapolo ndipo ndidzawabwezera ku Patirosi kumene anachokera. Kumeneko iwo adzakhala ufumu wotsika.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.14",
            "verseOrgIds": [
              "EZK.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzakhala ufumu wotsika kwambiri kupambana maufumu ena onse ndipo sudzadzitukumula pakati pa mitundu ina. Ndidzawufowoketsa kwambiri kotero kuti sudzathanso kulamulira mitundu ya anthu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.15",
            "verseOrgIds": [
              "EZK.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisraeli sadzadaliranso Aigupto. Koma kuti chilango chawo chidzawakumbutsa tchimo lawo lija lofunafuna thandizo kuchokera ku Igupto. Pamenepo iwo adzadziwa kuti Ine ndine Ambuye Yehova.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.16",
            "verseOrgIds": [
              "EZK.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mphotho ya Nebukadinezara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku loyamba la mwezi woyamba, chaka cha 27, Yehova anandiyankhula kuti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.17",
            "verseOrgIds": [
              "EZK.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe mwana wa munthu, kale Nebukadinezara mfumu ya Babuloni inagwiritsa ntchito ankhondo ake kukathira nkhondo mzinda wa Turo, mpaka munthu aliyense anachita dazi chifukwa chosenza katundu, ndipo ananyuka pa phewa. Komabe ngakhale iyeyo, kapena gulu lake lankhondo sanaphulepo kanthu pa ntchito yonse imene anayigwira polimbana ndi mzindawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.18",
            "verseOrgIds": [
              "EZK.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake Ine Ambuye Yehova ndikuti, Ine ndidzapereka Igupto kwa Nebukadinezara mfumu ya Babuloni, ndipo iyo idzatenga chuma chake ndi kuchifunkha ngati malipiro a gulu lake lankhondo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.19",
            "verseOrgIds": [
              "EZK.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamupatsa Nebukadinezara Igupto ngati mphotho ya kulimbika kwake chifukwa iyo ndi gulu lake lankhondo anandigwirira ntchito, akutero Ambuye Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.20",
            "verseOrgIds": [
              "EZK.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
