  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "EZK 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mʼphika Wophikira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku lakhumi la mwezi wakhumi chaka chachisanu ndi chinayi, Yehova anandiyankhula kuti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.1",
            "verseOrgIds": [
              "EZK.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe mwana wa munthu lemba dzina la tsiku lalero, lero lomwe lino, chifukwa mfumu ya Babuloni yazungulira Yerusalemu lero lino.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.2",
            "verseOrgIds": [
              "EZK.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwaphere mwambi anthu owukirawa ndi kuwawuza kuti: 'Ambuye Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.3",
            "verseOrgIds": [
              "EZK.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:3"
      },
      "items": [
        {
          "text": "\" 'Ikani mʼphika pa moto,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.3",
            "verseOrgIds": [
              "EZK.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:3"
      },
      "items": [
        {
          "text": "ndipo mu mʼphikamo muthiremo madzi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.3",
            "verseOrgIds": [
              "EZK.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mʼphikamo muyikemo nthuli za nyama,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.4",
            "verseOrgIds": [
              "EZK.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:4"
      },
      "items": [
        {
          "text": "nthuli zonse zabwino kwambiri za mwendo wathako ndi mwendo wamwamba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.4",
            "verseOrgIds": [
              "EZK.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:4"
      },
      "items": [
        {
          "text": "Mudzadzemo mafupa abwino kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.4",
            "verseOrgIds": [
              "EZK.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa gulu la nkhosa musankhepo nkhosa yabwino kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.5",
            "verseOrgIds": [
              "EZK.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:5"
      },
      "items": [
        {
          "text": "Muyike nkhuni pansi pa mʼphikawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.5",
            "verseOrgIds": [
              "EZK.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:5"
      },
      "items": [
        {
          "text": "Madzi awire.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.5",
            "verseOrgIds": [
              "EZK.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:5"
      },
      "items": [
        {
          "text": "Kenaka muphike nyamayo pamodzi ndi mafupa omwe.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.5",
            "verseOrgIds": [
              "EZK.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼchifukwa chake, Ambuye Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:6"
      },
      "items": [
        {
          "text": "\" 'Tsoka kwa mzinda wokhetsa magazi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:6"
      },
      "items": [
        {
          "text": "tsoka kwa mʼphika wadzimbiri;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:6"
      },
      "items": [
        {
          "text": "dzimbiri lake losachoka!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:6"
      },
      "items": [
        {
          "text": "Mutulutsemo nthuli imodzimodzi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:6"
      },
      "items": [
        {
          "text": "osasankhulapo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Paja magazi amene anakhetsa akanali pakati pake mu mzindamo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.7",
            "verseOrgIds": [
              "EZK.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:7"
      },
      "items": [
        {
          "text": "Iye awakhuthulira pa thanthwe losalala.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.7",
            "verseOrgIds": [
              "EZK.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:7"
      },
      "items": [
        {
          "text": "Sanawakhutulire pa dothi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.7",
            "verseOrgIds": [
              "EZK.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:7"
      },
      "items": [
        {
          "text": "kuopa kuti fumbi lingawafotsere.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.7",
            "verseOrgIds": [
              "EZK.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinasiya magaziwo pa mwala wosalala",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.8",
            "verseOrgIds": [
              "EZK.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:8"
      },
      "items": [
        {
          "text": "kuti asafotseredwe ndi fumbi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.8",
            "verseOrgIds": [
              "EZK.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:8"
      },
      "items": [
        {
          "text": "chifukwa ndinafuna kuonetsa mkwiyo wanga ndi kulipsira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.8",
            "verseOrgIds": [
              "EZK.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ine Ambuye Yehova ndikuti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.9",
            "verseOrgIds": [
              "EZK.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:9"
      },
      "items": [
        {
          "text": "\" 'Tsoka kwa mzinda wokhetsa magazi!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.9",
            "verseOrgIds": [
              "EZK.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:9"
      },
      "items": [
        {
          "text": "Inenso, ndidzawunjika mulu waukulu wa nkhuni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.9",
            "verseOrgIds": [
              "EZK.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho wonjeza nkhuni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:10"
      },
      "items": [
        {
          "text": "ndipo muyatse moto.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:10"
      },
      "items": [
        {
          "text": "Phikani nyamayo bwinobwino,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:10"
      },
      "items": [
        {
          "text": "muthiremo zokometsera,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:10"
      },
      "items": [
        {
          "text": "mutsanule msuzi, ndipo mupsereze mafupawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono muyike pa makala mʼphika wopanda kanthuwo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:11"
      },
      "items": [
        {
          "text": "mpaka utenthe kuchita kuti psuu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:11"
      },
      "items": [
        {
          "text": "kuti zonyansa zake zisungunuke",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:11"
      },
      "items": [
        {
          "text": "ndi kuti dzimbiri lake lichoke.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mʼphikawo walephereka kuyeretsedwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:12"
      },
      "items": [
        {
          "text": "Dzimbiri lake linalowerera silingatheke kuchoka",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:12"
      },
      "items": [
        {
          "text": "ngakhale ndi moto womwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Tsono dzimbiri limeneli ndi zilakolako za dama lako. Pakuti ine ndinayesa kukutsuka koma iwe sunayere, ndipo sudzayeranso mpaka ukali wanga utakwaniratu pa iwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.13",
            "verseOrgIds": [
              "EZK.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ine Yehova ndayankhula. Zimenezi zikubwera ndipo ndidzazichitadi. Sindidzabwerera mʼmbuyo. Sindidzakulekerera kapena kukuchitira chifundo. Ndidzakulanga molingana ndi makhalidwe ndi machitidwe ako, akutero Ambuye Yehova.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imfa ya Mkazi wa Ezekieli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anandiyankhula kuti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.15",
            "verseOrgIds": [
              "EZK.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe mwana wa munthu, Ine ndikulanda mwadzidzidzi mkazi amene amakukomera mʼmaso kwambiri. Koma usadandaule, usalire kapena kukhetsa misozi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.16",
            "verseOrgIds": [
              "EZK.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubuwule koma mwakachetechete. Usamulire wakufayo. Uvale nduwira yako ndithu, nsapato zakonso usavule. Usaphimbe nkhope kapena kudya chakudya cha anamfedwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.17",
            "verseOrgIds": [
              "EZK.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho ndinayankhula ndi anthu mmawa, ndipo madzulo mkazi wanga anamwalira. Mmawa mwake ndinachita monga momwe anandilamulira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.18",
            "verseOrgIds": [
              "EZK.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anthu anandifunsa kuti, \"Kodi sutifotokozera tanthauzo la zimene ukuchitazi?\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.19",
            "verseOrgIds": [
              "EZK.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinawayankha kuti, \"Yehova anandipatsa uthenga wakuti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.20",
            "verseOrgIds": [
              "EZK.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Awuze Aisraeli kuti: Ine Ambuye Yehova ndikuti: ndidzayipitsa Nyumba yanga yopatulika, nyumba imene mwakhala mukuyinyadira. Mumakondwa kwambiri poyiona, ndipo mumayikonda ndi mtima onse. Ana aamuna ndi aakazi amene munawasiya mʼmbuyo adzaphedwa ndi lupanga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.21",
            "verseOrgIds": [
              "EZK.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mudzachita monga ndachitira inemu. Inu simudzaphimba nkhope zanu kapena kudya chakudya cha anamfedwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.22",
            "verseOrgIds": [
              "EZK.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudzavala nduwira zanu kumutu ndi nsapato zanu ku mapazi anu. Simudzabuma maliro kapena kukhetsa misozi koma mudzavutika kwambiri chifukwa cha machimo anu ndipo mudzabuwula pakati panu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.23",
            "verseOrgIds": [
              "EZK.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine Ezekieli ndidzakhala chitsanzo chanu. Mudzachita monga momwe ndachitira. Izi zikadzachitika, akutero Yehova, ndipo mudzadziwa kuti Ine ndine Ambuye Wamphamvuzonse.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.24",
            "verseOrgIds": [
              "EZK.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndipo Yehova anandiyankhula nati: Iwe mwana wa munthu, tsiku lina ndidzawachotsera anthuwa linga lawo limene ankakondwerera kukongola kwake, limene linkawakomera mʼmaso mwawo, limenenso anayikapo mtima wawo kwambiri. Ndidzawachotsera ana awo aamuna ndi aakazi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.25",
            "verseOrgIds": [
              "EZK.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku limenelo wothawa nkhondo adzabwera kudzakuwuzani zimenezo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.26",
            "verseOrgIds": [
              "EZK.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku limenelo pakamwa pako padzatsekuka. Udzatha kuyankhula naye ndipo sudzakhalanso chete. Motero udzakhala chizindikiro kwa iwo, ndipo iwo adzadziwa kuti Ine ndine Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.27",
            "verseOrgIds": [
              "EZK.24.27"
            ]
          }
        }
      ]
    }
  ],
