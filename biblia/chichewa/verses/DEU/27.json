  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "DEU 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Guwa Lansembe ku Phiri la Ebala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ndi akuluakulu a Israeli analamula anthu kuti, \"Sungani malamulo onse amene ndikukupatsani lero lino.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.1",
            "verseOrgIds": [
              "DEU.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukawoloka mtsinje wa Yorodani kulowa mʼdziko limene Yehova Mulungu wanu akukupatsani, muyimiritse miyala ingapo ikuluikulu ndi kuyikulungiza.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.2",
            "verseOrgIds": [
              "DEU.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulembepo mawu onse a malamulo amenewa pamene muwoloka kulowa mʼdziko limene Yehova Mulungu wanu akukupatsani, dziko loyenda mkaka ndi uchi, monga momwe Yehova Mulungu wa makolo anu anakulonjezerani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.3",
            "verseOrgIds": [
              "DEU.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mukawoloka Yorodani muyimike miyala iyi pa Phiri la Ebala monga momwe ndikukulamulirani lero lino ndipo muyikulungize.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.4",
            "verseOrgIds": [
              "DEU.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo mumange guwa lansembe la miyala la Yehova Mulungu wanu. Musagwiritse ntchito chida chilichonse chachitsulo pa miyalapo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.5",
            "verseOrgIds": [
              "DEU.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumange guwa lansembe la Yehova Mulungu wanu ndi miyala yakutchire ndi kuperekerapo nsembe yopsereza kwa Yehova Mulungu wanu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.6",
            "verseOrgIds": [
              "DEU.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muperekerepo nsembe zopereka za chiyanjano, muzidye ndi kukondwera pamaso pa Yehova Mulungu wanu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.7",
            "verseOrgIds": [
              "DEU.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo pa miyalapo mudzalembepo mawu onse a malamulo ndi malemba akuluakulu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.8",
            "verseOrgIds": [
              "DEU.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Matemberero Kuchokera ku Phiri la Ebala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Mose ndi ansembe, amene ndi Alevi anati kwa Aisraeli onse, \"Khalani chete Aisraeli inu ndipo mumvetsere! Tsopano inu ndinu anthu a Yehova Mulungu wanu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.9",
            "verseOrgIds": [
              "DEU.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzimvera Yehova Mulungu wanu ndi kutsata malamulo ake ndi malangizo ake omwe ndikukupatsani lero lino.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.10",
            "verseOrgIds": [
              "DEU.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lomwelo Mose analamula anthu kuti:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.11",
            "verseOrgIds": [
              "DEU.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukawoloka Yorodani, mafuko awa akayimirire pa Phiri la Gerizimu ndi kudalitsa anthu: Simeoni, Levi, Yuda, Isakara, Yosefe ndi Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.12",
            "verseOrgIds": [
              "DEU.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mafuko awa akayimirire pa Phiri la Ebala ndi kutchula matemberero: Rubeni, Gadi, Aseri, Zebuloni, Dani ndi Nafutali.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.13",
            "verseOrgIds": [
              "DEU.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alevi adzayankhula mokweza kwa Aisraeli onse kuti:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.14",
            "verseOrgIds": [
              "DEU.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndi wotembereredwa munthu amene asema chifanizo kapena kupanga fano, ndi kuchiyika mobisa, pakuti chimenechi ndi chinthu chodetsedwa pamaso pa Yehova, ntchito za manja a anthu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:15"
      },
      "items": [
        {
          "text": "Pamenepo anthu onse adzati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndi wotembereredwa munthu amene sachitira ulemu abambo ake kapena amayi ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.16",
            "verseOrgIds": [
              "DEU.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:16"
      },
      "items": [
        {
          "text": "Pamenepo anthu onse adzati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.16",
            "verseOrgIds": [
              "DEU.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndi wotembereredwa munthu amene amasuntha mwala wa malire wa mnzake.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.17",
            "verseOrgIds": [
              "DEU.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:17"
      },
      "items": [
        {
          "text": "Pamenepo anthu onse adzati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.17",
            "verseOrgIds": [
              "DEU.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndi wotembereredwa munthu amene amasocheretsa munthu wosaona pa msewu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.18",
            "verseOrgIds": [
              "DEU.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:18"
      },
      "items": [
        {
          "text": "Pamenepo anthu onse adzati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.18",
            "verseOrgIds": [
              "DEU.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndi wotembereredwa munthu amene sachitira chilungamo mlendo, ana amasiye kapena mkazi wamasiye.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.19",
            "verseOrgIds": [
              "DEU.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:19"
      },
      "items": [
        {
          "text": "Pamenepo anthu onse adzati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.19",
            "verseOrgIds": [
              "DEU.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndi wotembereredwa munthu amene agonana ndi mkazi wa abambo ake pakuti iye sachitira ulemu pogona pa abambo ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.20",
            "verseOrgIds": [
              "DEU.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:20"
      },
      "items": [
        {
          "text": "Pamenepo anthu onse adzati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.20",
            "verseOrgIds": [
              "DEU.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndi wotembereredwa munthu amene achita chigololo ndi nyama ya mtundu uli wonse.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.21",
            "verseOrgIds": [
              "DEU.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:21"
      },
      "items": [
        {
          "text": "Pamenepo anthu onse adzati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.21",
            "verseOrgIds": [
              "DEU.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndi wotembereredwa munthu amene agonana ndi mlongo wake, mwana wamkazi wa abambo ake kapena mwana wamkazi wa amayi ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.22",
            "verseOrgIds": [
              "DEU.27.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:22"
      },
      "items": [
        {
          "text": "Pamenepo anthu onse adzati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.22",
            "verseOrgIds": [
              "DEU.27.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndi wotembereredwa munthu amene agonana ndi apongozi ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.23",
            "verseOrgIds": [
              "DEU.27.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:23"
      },
      "items": [
        {
          "text": "Pamenepo anthu onse adzati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.23",
            "verseOrgIds": [
              "DEU.27.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndi wotembereredwa munthu amene apha mnzake mwachinsinsi.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.24",
            "verseOrgIds": [
              "DEU.27.24"
            ]
          }
        }
      ]
    },
    {
