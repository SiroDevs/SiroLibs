{
  "id": "HOS.11",
  "number": "11",
  "bookId": "HOS",
  "reference": "Hosea 11",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "HOS 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hera ma Nyasaye oherogo Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka Israel ne pod nyathi, ne ahere,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.1",
            "verseOrgIds": [
              "HOS.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:1"
      },
      "items": [
        {
          "text": "kendo ne aluongo wuoda ka agolo Misri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.1",
            "verseOrgIds": [
              "HOS.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kaka ne amedo luongo Israel",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
              "HOS.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:2"
      },
      "items": [
        {
          "text": "e kaka nomedo dhi mabor koda.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
              "HOS.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:2"
      },
      "items": [
        {
          "text": "Negichiwo misengini ne Baal",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
              "HOS.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:2"
      },
      "items": [
        {
          "text": "kendo wangʼo ubani ne kido molosi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
              "HOS.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "An owuon ema napuonjo Efraim wuotho,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:3"
      },
      "items": [
        {
          "text": "ka amakogi gi bedegi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:3"
      },
      "items": [
        {
          "text": "to ne ok gifwenyo ni ne en",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:3"
      },
      "items": [
        {
          "text": "An mane ochangogi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne atelonegi gi ngʼwono mathoth",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:4"
      },
      "items": [
        {
          "text": "kaachiel gihera ma ok rum;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:4"
      },
      "items": [
        {
          "text": "ne agolo jok mapek e ngʼutgi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:4"
      },
      "items": [
        {
          "text": "kendo akulora piny mondo apidhgi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Donge ginidog Misri",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.5",
            "verseOrgIds": [
              "HOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:5"
      },
      "items": [
        {
          "text": "kendo Asuria nobedi gi loch kuomgi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.5",
            "verseOrgIds": [
              "HOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:5"
      },
      "items": [
        {
          "text": "nikech gitamore weyo richogi?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.5",
            "verseOrgIds": [
              "HOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligangla nomil e miechgi madongo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.6",
            "verseOrgIds": [
              "HOS.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:6"
      },
      "items": [
        {
          "text": "manoketh lodi mag rangeyegi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.6",
            "verseOrgIds": [
              "HOS.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:6"
      },
      "items": [
        {
          "text": "kendo chenro duto magin-go norum.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.6",
            "verseOrgIds": [
              "HOS.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joga oramo chuth mondo oweya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.7",
            "verseOrgIds": [
              "HOS.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:7"
      },
      "items": [
        {
          "text": "Kata giluong Nyasaye Man Malo Moloyo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.7",
            "verseOrgIds": [
              "HOS.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:7"
      },
      "items": [
        {
          "text": "to ok notingʼ-gi malo e yo moro amora.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.7",
            "verseOrgIds": [
              "HOS.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ere kaka anyalo jwangʼou, Efraim?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "Ere kaka dabolu Israel?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "Ere kaka datiu ka Adma?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "Ere kaka damiu ubed machal gi Zeboim?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "Ok anyal timonu kamano;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "nikech aseloko pacha kendo akechou.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok anaol mirimba mager",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:9"
      },
      "items": [
        {
          "text": "bende ok analokra mi aketh Efraim bende.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:9"
      },
      "items": [
        {
          "text": "Nimar an Nyasaye, ok an dhano,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:9"
      },
      "items": [
        {
          "text": "Jal Maler e dieru.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:9"
      },
      "items": [
        {
          "text": "Ok anabi gi mirima.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibiro luwo Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:10"
      },
      "items": [
        {
          "text": "noruti ka sibuor.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:10"
      },
      "items": [
        {
          "text": "Kuruto,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:10"
      },
      "items": [
        {
          "text": "to nyithinde duto nobi ire katetni kagiwuok yo podho chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ginibi ire ka gitetni",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.11",
            "verseOrgIds": [
              "HOS.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:11"
      },
      "items": [
        {
          "text": "ka winy moa Misri,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.11",
            "verseOrgIds": [
              "HOS.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:11"
      },
      "items": [
        {
          "text": "ka akuche moa Asuria.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.11",
            "verseOrgIds": [
              "HOS.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:11"
      },
      "items": [
        {
          "text": "Anami gibed e miechgi,\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.11",
            "verseOrgIds": [
              "HOS.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
