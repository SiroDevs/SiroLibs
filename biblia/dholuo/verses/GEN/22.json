  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "GEN 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Otem Ibrahim",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ kinde moko Nyasaye notemo Ibrahim. Noluonge niya, \"Ibrahim!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.1",
            "verseOrgIds": [
              "GEN.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 22:1"
      },
      "items": [
        {
          "text": "Eka nodwoke niya, \"Eri an ka.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.1",
            "verseOrgIds": [
              "GEN.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Nyasaye nowacho niya, \"Kaw wuodi, wuodi ma miderma Isaka, kendo mi ihero mondo idhigo e gwengʼ mar Moria. Chiwe kanyo kaka misango miwangʼo pep ewi got moro ma abiro nyisi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.2",
            "verseOrgIds": [
              "GEN.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyne gokinyi mangʼich Ibrahim noa malo kendo noiko pundane ne wuoth. Nodhi kod jotijene ariyo kaachiel gi Isaka wuode. Kane osengʼado yien moromo tiyogo e misango miwangʼo pep, nochako wuoth madhi kamane Nyasaye osenyise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.3",
            "verseOrgIds": [
              "GEN.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "E odiechiengʼ mar adek Ibrahim notingʼo wangʼe moneno kanyo gi kuma bor.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.4",
            "verseOrgIds": [
              "GEN.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowacho ne jotije niya, \"Dongʼuru kae gi punda ka an kod Isaka wadhi kucha. Wadhi lemo kendo eka wabiro duogo iru.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.5",
            "verseOrgIds": [
              "GEN.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibrahim nokawo yien mar misango miwangʼo pep kendo nomiyo Isaka, to en owuon notingʼo mach kod pala ka ji ariyogo ne wuotho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.6",
            "verseOrgIds": [
              "GEN.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka notingʼo dwonde mopenjo wuon-gi Ibrahim niya, \"Wuora?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 22:7"
      },
      "items": [
        {
          "text": "Ibrahim nodwoke niya, \"En angʼo wuoda?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 22:7"
      },
      "items": [
        {
          "text": "Eka Isaka nopenje niya, \"Mach kod yien nikae, to ere nyaim mar misango miwangʼo pep?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibrahim nodwoke niya, \"Wuoda, Nyasaye owuon ema biro chiwo nyaim mar misango miwangʼo pep.\" Bangʼ mano negidhi nyime giwuodhgi kanyakla.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.8",
            "verseOrgIds": [
              "GEN.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gichopo kumane Nyasaye osenyiso Ibrahim, Ibrahim nogero kendo mar misango kanyo kendo nopango yien e wiye motweyo Isaka wuode kendo nopiele ewi kendo mar misango, ewi yien.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.9",
            "verseOrgIds": [
              "GEN.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka notero lwete kendo okawo pala mondo oneg-go wuode.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.10",
            "verseOrgIds": [
              "GEN.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "To malaika mar Jehova Nyasaye noluonge gie polo niya, \"Ibrahim! Ibrahim!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 22:11"
      },
      "items": [
        {
          "text": "Eka nodwoke niya, \"Eri an ka.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika nowachone niya, \"Kik iket lweti kuom wuodi, kendo kik itimne gimoro amora. Koro asengʼeyo ni iluoro Nyasaye, nikech ok isetama e wuodi ma miderma.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.12",
            "verseOrgIds": [
              "GEN.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibrahim notingʼo wangʼe mopo koneno im komoko gitungene e bungu. Nodhi mokawo im kendo ochiwo kaka misango miwangʼo pep kar wuode.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.13",
            "verseOrgIds": [
              "GEN.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Ibrahim nochako kanyo ni Jehova Nyasaye ma Jachiwo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        },
        {
          "text": "kendo nyaka chil kawuono iwacho niya, \"E God Jehova Nyasaye ema nochiwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika mar Jehova Nyasaye nochako luongo Ibrahim gie polo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.15",
            "verseOrgIds": [
              "GEN.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mi Jehova Nyasaye owacho niya, \"Akwongʼora gi nyinga awuon, ni nikech isetimona ma kendo ok isetama e wuodi ma miderma,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.16",
            "verseOrgIds": [
              "GEN.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "abiro gwedhi adier kendo anami nyikwayi bed mangʼeny ka sulwe mae polo kendo ka kuoyo manie dho nam. Nyikwayi nokaw mier mag jowasikgi mondo obed margi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.17",
            "verseOrgIds": [
              "GEN.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo ogendini duto manie piny nogwedhi kokalo e kothi, nikech isewinjo wachna.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.18",
            "verseOrgIds": [
              "GEN.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Ibrahim nodok ir jotije, kendo giduto negiwuok ka gidok Bersheba. Kendo Ibrahim nodak Bersheba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.19",
            "verseOrgIds": [
              "GEN.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yawuot Nahor",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ kinde moko, Ibrahim noyudo wach niya, \"Milka bende koro osenywolone owadu Nahor yawuowi ma gin:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.20",
            "verseOrgIds": [
              "GEN.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uz wuowi makayo, Buz owadgi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.21",
            "verseOrgIds": [
              "GEN.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 22:21"
      },
      "items": [
        {
          "text": "Kemuel (wuon Aram),",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.21",
            "verseOrgIds": [
              "GEN.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kesed, Hazo, Pildash, Jidlaf kod Bethuel.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.22",
            "verseOrgIds": [
              "GEN.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bethuel nonywolo Rebeka.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "GEN 22:23"
      },
      "items": [
        {
          "text": "Yawuowi aborogo ema Milka nonywolone Nahor owadgi Ibrahim.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.23",
            "verseOrgIds": [
              "GEN.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jatichne ma nyako ma nyinge Reuma bende nonywolone yawuowi, ma gin:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.24",
            "verseOrgIds": [
              "GEN.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 22:24"
      },
      "items": [
        {
          "text": "Teba, Gaham, Tahash kod Maaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.24",
            "verseOrgIds": [
              "GEN.22.24"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "GEN.23",
    "number": "23",
    "bookId": "GEN"
  },
