{
  "id": "GEN.12",
  "number": "12",
  "bookId": "GEN",
  "reference": "Chakruok 12",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "GEN 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luong mar Abram",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nowacho ne Abram niya, \"Dar iwe pinyu gi jou kod joodu mondo idhi e piny ma abiro nyisi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.1",
            "verseOrgIds": [
              "GEN.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anaketi oganda maduongʼ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.2",
            "verseOrgIds": [
              "GEN.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 12:2"
      },
      "items": [
        {
          "text": "kendo anagwedhi;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.2",
            "verseOrgIds": [
              "GEN.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 12:2"
      },
      "items": [
        {
          "text": "anami nyingi bed gi huma,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.2",
            "verseOrgIds": [
              "GEN.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 12:2"
      },
      "items": [
        {
          "text": "kendo anami ibed gweth ne ji.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.2",
            "verseOrgIds": [
              "GEN.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anagwedh jogo ma gwedhi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.3",
            "verseOrgIds": [
              "GEN.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 12:3"
      },
      "items": [
        {
          "text": "kendo anakwongʼ jogo makwongʼi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.3",
            "verseOrgIds": [
              "GEN.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 12:3"
      },
      "items": [
        {
          "text": "kendo ogendini duto manie piny",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.3",
            "verseOrgIds": [
              "GEN.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 12:3"
      },
      "items": [
        {
          "text": "nogwedhi nikech in.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.3",
            "verseOrgIds": [
              "GEN.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Abram nowuok kaka Jehova Nyasaye nosenyise kendo Lut nodhi kode. Abram ne ja-higni piero abiriyo gabich kane owuok Haran.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.4",
            "verseOrgIds": [
              "GEN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokawo chiege Sarai, gi Lut wuod owadgi, gi mwandu duto mane gisechoko kod wasumbini duto mane gin-go Haran, kendo negichako wuoth mar dhi Kanaan mi negichopo kuno.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.5",
            "verseOrgIds": [
              "GEN.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abram nowuotho e piny mochopo Shekem e tiend yath maduongʼ mar More. E kindego jo-Kanaan nodak e pinyno.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.6",
            "verseOrgIds": [
              "GEN.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nofwenyore ne Abram mi owachone niya, \"Anami kothi pinyni.\" Omiyo Abram nogero kendo mar misango kanyo ne Jehova Nyasaye mane osefwenyorene.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.7",
            "verseOrgIds": [
              "GEN.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa kanyo modhi e piny gode ma yo wuok chiengʼ mar Bethel kendo nogero hembe e kind Bethel man yo podho chiengʼ to gi Ai man yo wuok chiengʼ. Kanyo nogeroe kendo mar misango ne Jehova Nyasaye kendo nolamo Jehova Nyasaye kanyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.8",
            "verseOrgIds": [
              "GEN.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Abram nochako wuoth kendo odhi nyime giwuoth kochomo Negev.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.9",
            "verseOrgIds": [
              "GEN.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abram e piny Misri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro kech nomako pinyno kendo Abram nodhi Misri mondo odhi odag kuno kuom kinde matin nikech kech ne duongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.10",
            "verseOrgIds": [
              "GEN.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane ochiegni donjo Misri, nowacho ne Sarai chiege niya, \"Angʼeyo kaka in dhako ma jaber.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.11",
            "verseOrgIds": [
              "GEN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka jo-Misri oneni, gibiro wacho, 'Ma en chiege.' Mi gininega to inires ngimani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.12",
            "verseOrgIds": [
              "GEN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wach ni in nyamera, mondo mi gitimna maber kendo ngimana obedie nikech in.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.13",
            "verseOrgIds": [
              "GEN.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Abram ochopo Misri, jo-Misri noneno Sarai kaka ne en dhako ma jaber miwuoro.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.14",
            "verseOrgIds": [
              "GEN.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo kane jodong Farao oneno Sarai, negiwuoro berne ne Farao kendo nokawe motere kar dak ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.15",
            "verseOrgIds": [
              "GEN.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao nomiyo Abram rit maber nikech Sarai, kendo nomiyo Abram rombe, dhok, pundane machwo gi mamon, wasumbini machwo gi mamon kod ngamia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.16",
            "verseOrgIds": [
              "GEN.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Jehova Nyasaye nosando Farao gi joode gi tuoche madongo nikech Sarai chi Abram.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.17",
            "verseOrgIds": [
              "GEN.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Farao noluongo Abram kendo nopenje niya, \"Angʼo ma isetimonani? Ere gima omiyo ne ok inyisa ni Sarai en chiegi?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.18",
            "verseOrgIds": [
              "GEN.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara angʼo ne iwuonda ni Sarai en nyameru momiyo akawe mondo obed chiega? Chiegi eri, kawe mondo udhi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.19",
            "verseOrgIds": [
              "GEN.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Farao nogolo chik ne joge mondo ogol Abram, chiege gi gige duto kendo gikowogi oko mar pinyno.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.20",
            "verseOrgIds": [
              "GEN.12.20"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "GEN.13",
    "number": "13",
    "bookId": "GEN"
  },
  "previous": {
    "id": "GEN.11",
    "number": "11",
