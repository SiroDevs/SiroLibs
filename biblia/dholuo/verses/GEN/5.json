    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chakruok mar dhano koa e Adam nyaka Nowa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e chenro mar tienge nyikwa Adam.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
              "GEN.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 5:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 5:1"
      },
      "items": [
        {
          "text": "Ka Nyasaye nochweyo dhano, nochweye e kite owuon.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
              "GEN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochweyogi dichwo gi dhako kendo ogwedhogi kendo kane ochwegi, nochakogi ni \"dhano.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Adam nosedak kuom higni mia achiel gi piero adek, nonywolo wuowi machal kode, kendo nochake ni Seth.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
              "GEN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ kosenywolo Seth, Adam nodak higni mia aboro kendo nonywolo yawuowi kod nyiri mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adam notho ka en ja-higni mia ochiko gi piero adek.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.5",
            "verseOrgIds": [
              "GEN.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Seth ne ja-higni mia achiel gabich, nonywolo Enosh.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.6",
            "verseOrgIds": [
              "GEN.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ kane osenywolo Enosh, Seth nodak kuom higni mia aboro gabiriyo kendo nonywolo yawuowi kod nyiri mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
              "GEN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seth notho ka en ja-higni mia ochiko gi apar gariyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.8",
            "verseOrgIds": [
              "GEN.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enosh nonywolo Kenan kane en ja-higni piero ochiko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.9",
            "verseOrgIds": [
              "GEN.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ Kenan, Enosh nodak higni mia aboro kod apar gabich kendo nonywolo yawuowi kod nyiri mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.10",
            "verseOrgIds": [
              "GEN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enosh notho ka en ja-higni mia ochiko gabich.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.11",
            "verseOrgIds": [
              "GEN.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Kenan ne ja-higni piero abiriyo nonywolo Mahalalel.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.12",
            "verseOrgIds": [
              "GEN.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo bangʼ ka Kenan noseyuolo Mahalalel nodak higni mia aboro kod piero angʼwen kendo nonywolo yawuowi kod nyiri mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.13",
            "verseOrgIds": [
              "GEN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenan notho ka en ja-higni mia ochiko gapar.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.14",
            "verseOrgIds": [
              "GEN.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Mahalalel ne ja-higni piero auchiel gabich, nonywolo Jared.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.15",
            "verseOrgIds": [
              "GEN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo bangʼ kane osenywolo Jared, Mahalalel nodak higni mia aboro gi piero adek kendo nonywolo yawuowi kod nyiri mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.16",
            "verseOrgIds": [
              "GEN.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahalalel notho kane en ja-higni mia aboro gi piero ochiko gabich.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.17",
            "verseOrgIds": [
              "GEN.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Jared ne ja-higni mia achiel gi piero auchiel gariyo, nonywolo Enok.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.18",
            "verseOrgIds": [
              "GEN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo bangʼ nywolo Enok, Jared nodak higni mia aboro kendo nonywolo yawuowi kod nyiri mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.19",
            "verseOrgIds": [
              "GEN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jared notho kane en ja-higni mia ochiko gi piero auchiel gariyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.20",
            "verseOrgIds": [
              "GEN.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Enok ne ja-higni piero auchiel gabich, nonywolo Methusela.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.21",
            "verseOrgIds": [
              "GEN.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo bangʼ nywolo Methusela, Enok nowuotho gi Nyasaye kuom higni mia adek kendo nonywolo yawuowi kod nyiri mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.22",
            "verseOrgIds": [
              "GEN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enok nodak kuom higni mia adek gi piero auchiel gabich.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.23",
            "verseOrgIds": [
              "GEN.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enok nowuotho gi Nyasaye; bangʼe nobedo maonge, nikech Nyasaye nokawe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.24",
            "verseOrgIds": [
              "GEN.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Methusela ne ja-higni mia achiel gi piero aboro gabiriyo, nonywolo Lamek.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.25",
            "verseOrgIds": [
              "GEN.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo bangʼ kane osenywolo Lamek, Methusela nodak higni mia abiriyo gi piero aboro gariyo kendo nonywolo yawuowi kod nyiri mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.26",
            "verseOrgIds": [
              "GEN.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Methusela nodak kuom higni mia ochiko gi piero auchiel gochiko kendo bangʼe notho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.27",
            "verseOrgIds": [
              "GEN.5.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Lamek ne ja-higni mia achiel gi piero aboro gariyo, nonywolo wuowi moro.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.28",
            "verseOrgIds": [
              "GEN.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochake ni Nowa mi owacho niya, \"Wuowini biro hoyowa kuom tich kendo kuom tich malit mar lwetwa mobet nikech lowo ma Jehova Nyasaye osekwongʼo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.29",
            "verseOrgIds": [
              "GEN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ kane osenywol Nowa, Lamek nodak higni mia abich gi piero ochiko gi abich kendo nonywolo yawuowi kod nyiri moko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.30",
            "verseOrgIds": [
              "GEN.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamek notho kane ja-higni mia abiriyo gi piero abiriyo gabiriyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.31",
            "verseOrgIds": [
              "GEN.5.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Nowa ne ja-higni mia abich nonywolo Shem, Ham kod Jafeth.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.32",
            "verseOrgIds": [
              "GEN.5.32"
            ]
          }
        }
      ]
    }
