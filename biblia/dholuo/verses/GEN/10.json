          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Pinygi mane gi dakie nochakore Mesha kochomo Sefar e gode man yo wuok chiengʼ.)",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.30",
            "verseOrgIds": [
              "GEN.10.30"
            ]
          }
        }
