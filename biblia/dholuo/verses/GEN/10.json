          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi e yawuot Shem kuom dhoutgi ka moro ka moro wacho dhogi giwegi.",
          "type": "text"
        }
      ]
    },
