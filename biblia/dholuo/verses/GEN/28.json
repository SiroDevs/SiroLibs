  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "GEN 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano Isaka noluongo Jakobo mogwedhe kendo osieme konyise niya, \"Kik ikend nyar jo-Kanaan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.1",
            "verseOrgIds": [
              "GEN.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chak wuoth idhi Padan Aram, e od Bethuel ma kwaru. Kend achiel kuom nyi Laban ma neru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.2",
            "verseOrgIds": [
              "GEN.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad Nyasaye Maratego gwedhi kendo inyaa mi kwanu medre nyaka ubed oganda mathoth.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.3",
            "verseOrgIds": [
              "GEN.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad ogwedhi kod nyikwayi kaka nogwedho Ibrahim mondo ikaw piny makoro idakieni kaka jadak, ma en piny mane Nyasaye omiyo Ibrahim.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.4",
            "verseOrgIds": [
              "GEN.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Isaka nogolo Jakobo modhi kendo Jakobo nodhi Padan Aram, ir Laban wuod Bethuel ja-Aram, owad gi Rebeka, mane min Jakobo kod Esau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.5",
            "verseOrgIds": [
              "GEN.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro Esau nofwenyo ni Isaka osegwedho Jakobo kendo oseore Padan Aram mondo odhi okend kuno. Nowinjo bende ni kane Isaka gwedho Jakobo, nochike niya, \"Kik ikend nyar jo-Kanaan.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.6",
            "verseOrgIds": [
              "GEN.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi Jakobo nowinjo wach min gi wuon modhi Padan Aram.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.7",
            "verseOrgIds": [
              "GEN.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau nofwenyo kaka Isaka wuon mare ne ok mor gi nyi jo-Kanaan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.8",
            "verseOrgIds": [
              "GEN.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano Esau nodhi ir Ishmael mi okendo Mahalath nyamin Nebayoth mane nyar Ishmael wuod Ibrahim, mondo obed chiege ewi monde mane okwongo kendo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.9",
            "verseOrgIds": [
              "GEN.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lek ma Jakobo oleko Bethel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobo nowuok Bersheba kendo nodhi Haran.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.10",
            "verseOrgIds": [
              "GEN.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane ochopo kamoro, nobworo gotieno nikech chiengʼ nosepodho. Nonindo kanyo moteno wiye gi kidi moro mane okwanyo kanyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.11",
            "verseOrgIds": [
              "GEN.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noleko ni oneno ngas konyono piny to wiye ochopo e polo kendo malaika mag Nyasaye ne luwe kadhi malo kendo lor piny.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.12",
            "verseOrgIds": [
              "GEN.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ewi ngasno gi malo Jehova Nyasaye nochungʼie kawacho niya, \"An Jehova Nyasaye Nyasach wuonu Ibrahim kendo Nyasach Isaka. Piny minindoeni abiro miyi gi nyikwayi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.13",
            "verseOrgIds": [
              "GEN.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikwayi nobed mangʼeny ka kwoyo, kendo unudag koa yo podho chiengʼ nyaka wuok chiengʼ, bende koa yo nyandwat nyaka yo milambo. Ogendini duto manie piny nogwedh kokadho kuomi kod nyikwayi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.14",
            "verseOrgIds": [
              "GEN.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anabed kodi kendo anariti kamoro amora ma idhiye nyaka adwoki e pinyni. Ok anaweyi nyaka chop atim mana ma asesingorani.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.15",
            "verseOrgIds": [
              "GEN.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Jakobo ochiewo oa e nindo, noparo niya, \"Adier Jehova Nyasaye nika kendo ne ok angʼeyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.16",
            "verseOrgIds": [
              "GEN.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luoro nomake mi owacho niya, \"Ma kama lich manade! Nyaka bedni ma en od Nyasaye; ma en dhoranga polo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.17",
            "verseOrgIds": [
              "GEN.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyne gokinyi mangʼich Jakobo nokawo kidi mane otenogo wiye kendo nochunge ka siro mi oolo mo e wiye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.18",
            "verseOrgIds": [
              "GEN.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochako kanyo ni Bethel to kinde mokwongo nying dalano niluongo ni Luz.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.19",
            "verseOrgIds": [
              "GEN.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jakobo nokwongʼore kawacho niya, \"Ka Nyasaye nobed koda kendo norita e wuodhani ma adhiye kendo miya chiemo ma achamo kod lewni ma arwako,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.20",
            "verseOrgIds": [
              "GEN.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mi anadogi maber e od wuora eka Jehova Nyasaye nobed Nyasacha,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.21",
            "verseOrgIds": [
              "GEN.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo kidi ma asechungo kaka sironi, nobed od Nyasaye kendo duto ma imiya, namiyi achiel kuom apar.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.22",
            "verseOrgIds": [
              "GEN.28.22"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "GEN.29",
    "number": "29",
    "bookId": "GEN"
  },
