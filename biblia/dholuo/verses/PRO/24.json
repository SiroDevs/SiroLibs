  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "PRO 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar piero ariyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik nyiego maki gi joricho",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.1",
            "verseOrgIds": [
              "PRO.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:1"
      },
      "items": [
        {
          "text": "bende kik iyie chunyi gomb bedo e chokruok margi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.1",
            "verseOrgIds": [
              "PRO.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimar chunjegi chano timo mamono",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.2",
            "verseOrgIds": [
              "PRO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:2"
      },
      "items": [
        {
          "text": "to dhogi wacho mana gik makelo chandruok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.2",
            "verseOrgIds": [
              "PRO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar piero ariyo gachiel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rieko ema igerogo ot,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.3",
            "verseOrgIds": [
              "PRO.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:3"
      },
      "items": [
        {
          "text": "to kuom winjo ogurore mosiko;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.3",
            "verseOrgIds": [
              "PRO.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuom ngʼeyo, utene maiye ipongʼo gi gik moko",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.4",
            "verseOrgIds": [
              "PRO.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:4"
      },
      "items": [
        {
          "text": "ma ok yudo yot kod mwandu mabeyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.4",
            "verseOrgIds": [
              "PRO.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar piero ariyo gariyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat mariek nigi teko maduongʼ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.5",
            "verseOrgIds": [
              "PRO.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:5"
      },
      "items": [
        {
          "text": "to ngʼat man-gi ngʼeyo medo teko;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.5",
            "verseOrgIds": [
              "PRO.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimar dhiyo e lweny dwaro ni ongʼadni rieko,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.6",
            "verseOrgIds": [
              "PRO.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:6"
      },
      "items": [
        {
          "text": "to bedo gi loch dwaro jongʼad rieko mangʼeny.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.6",
            "verseOrgIds": [
              "PRO.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar piero ariyo gadek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rieko bor moyombo ngʼat mofuwo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:7"
      },
      "items": [
        {
          "text": "e kar bura mar alap oonge gi gima onyalo wacho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar piero ariyo gangʼwen",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat machano gima rach",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.8",
            "verseOrgIds": [
              "PRO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:8"
      },
      "items": [
        {
          "text": "biro ngʼere kaka ja-andhoga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.8",
            "verseOrgIds": [
              "PRO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andhoga mar fuwo en richo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.9",
            "verseOrgIds": [
              "PRO.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:9"
      },
      "items": [
        {
          "text": "to ji mon kod ja-jar ji.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.9",
            "verseOrgIds": [
              "PRO.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar piero ariyo gabich",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka tekri orumo mipodho e kinde mar lweny,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.10",
            "verseOrgIds": [
              "PRO.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:10"
      },
      "items": [
        {
          "text": "to mano kaka tekri tin!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.10",
            "verseOrgIds": [
              "PRO.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Res jogo mitero kar tho;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.11",
            "verseOrgIds": [
              "PRO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:11"
      },
      "items": [
        {
          "text": "mak jogo mawuotho ka tangni dhiyo kar yengʼo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.11",
            "verseOrgIds": [
              "PRO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka iwacho niya, \"Ne ok wangʼeyo gimoro kuom wachni,\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "donge ngʼatno mapimo chuny dhano ongʼeyo wachno?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "Donge ngʼat morito kendo ngʼiyo ngimani ongʼeyogo?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "To donge obiro chulo ngʼato ka ngʼato mowinjore gi timbene?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar piero ariyo gauchiel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuoda, cham mor kich, nimar ober;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.13",
            "verseOrgIds": [
              "PRO.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:13"
      },
      "items": [
        {
          "text": "mor kich moa e pedni mar kich nigi ndhandhu mamit.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.13",
            "verseOrgIds": [
              "PRO.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼe bende ne rieko mit ni chunyi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:14"
      },
      "items": [
        {
          "text": "ka iyude, nitie geno mar ndalo mabiro kuomi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:14"
      },
      "items": [
        {
          "text": "to genoni ok nongʼad oko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar piero ariyo gabiriyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik ibut ka ngʼat marach mondo iketh od ngʼat makare,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.15",
            "verseOrgIds": [
              "PRO.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:15"
      },
      "items": [
        {
          "text": "kik iyak dalane,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.15",
            "verseOrgIds": [
              "PRO.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata bedni ngʼat makare ogore piny nyadibiriyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.16",
            "verseOrgIds": [
              "PRO.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:16"
      },
      "items": [
        {
          "text": "pod obiro chungo kendo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.16",
            "verseOrgIds": [
              "PRO.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:16"
      },
      "items": [
        {
