  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "PRO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luong mar rieko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donge rieko luongo?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.1",
            "verseOrgIds": [
              "PRO.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:1"
      },
      "items": [
        {
          "text": "Donge ngʼeyo tiend wach tingʼo dwonde ka goyo koko?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.1",
            "verseOrgIds": [
              "PRO.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochungʼ e kuonde motingʼore e bath yo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.2",
            "verseOrgIds": [
              "PRO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:2"
      },
      "items": [
        {
          "text": "e akerkeke mag yore.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.2",
            "verseOrgIds": [
              "PRO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oywak matek e bath dhorangeye",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.3",
            "verseOrgIds": [
              "PRO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:3"
      },
      "items": [
        {
          "text": "midonjogo e dala maduongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.3",
            "verseOrgIds": [
              "PRO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kowacho niya, \"Aluongou, yaye un ji,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.4",
            "verseOrgIds": [
              "PRO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:4"
      },
      "items": [
        {
          "text": "aluongou un ji duto manie piny.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.4",
            "verseOrgIds": [
              "PRO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un joma ngʼeyogi tin, nwangʼuru rieko;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.5",
            "verseOrgIds": [
              "PRO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:5"
      },
      "items": [
        {
          "text": "to un joma ofuwo, nwangʼuru ngʼeyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.5",
            "verseOrgIds": [
              "PRO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjuru, nikech an gi gik mabeyo mangʼeny madwaro nyisou;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:6"
      },
      "items": [
        {
          "text": "ayawo dhoga mondo awach gima kare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhoga wacho gima adiera",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.7",
            "verseOrgIds": [
              "PRO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:7"
      },
      "items": [
        {
          "text": "nikech dhoga kwedo gik maricho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.7",
            "verseOrgIds": [
              "PRO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weche duto mawuok e dhoga gin kare,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:8"
      },
      "items": [
        {
          "text": "onge moro kuomgi mobam kata modwanyore.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne jogo mongʼeyo pogo tiend wach,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.9",
            "verseOrgIds": [
              "PRO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:9"
      },
      "items": [
        {
          "text": "gigi duto nikare, giber ni jogo man-gi ngʼeyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.9",
            "verseOrgIds": [
              "PRO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yier puonjna kar fedha",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.10",
            "verseOrgIds": [
              "PRO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:10"
      },
      "items": [
        {
          "text": "kendo ngʼeyo kar dhahabu mowal,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.10",
            "verseOrgIds": [
              "PRO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech rieko ber moloyo kite ma nengogi tek,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.11",
            "verseOrgIds": [
              "PRO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:11"
      },
      "items": [
        {
          "text": "kendo gimoro amora madiher ok nyal romo kode.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.11",
            "verseOrgIds": [
              "PRO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"An, rieko, wadak kaachiel gi ngʼado bura makare;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.12",
            "verseOrgIds": [
              "PRO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:12"
      },
      "items": [
        {
          "text": "an-gi ngʼeyo kod pogo tiend wach.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.12",
            "verseOrgIds": [
              "PRO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luoro Jehova Nyasaye en sin gi richo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:13"
      },
      "items": [
        {
          "text": "amon gi sunga kod ngʼayi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:13"
      },
      "items": [
        {
          "text": "timbe maricho kod wuoyo mochido.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼado rieko kod ngʼado bura malongʼo gin maga;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.14",
            "verseOrgIds": [
              "PRO.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:14"
      },
      "items": [
        {
          "text": "an-gi winjo tiend wach kod nyalo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.14",
            "verseOrgIds": [
              "PRO.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "An ema amiyo ruodhi locho",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.15",
            "verseOrgIds": [
              "PRO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:15"
      },
      "items": [
        {
          "text": "kendo joloch loso chike makare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.15",
            "verseOrgIds": [
              "PRO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech an, amiyo yawuot ruodhi loch",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.16",
            "verseOrgIds": [
              "PRO.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:16"
      },
      "items": [
        {
          "text": "kod joka ruodhi duto marito pinje.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.16",
            "verseOrgIds": [
              "PRO.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahero jogo mohera,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.17",
            "verseOrgIds": [
              "PRO.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:17"
      },
      "items": [
        {
          "text": "to jogo ma manya yuda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.17",
            "verseOrgIds": [
              "PRO.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwandu gi luor ni kuoma,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.18",
            "verseOrgIds": [
              "PRO.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:18"
      },
      "items": [
        {
          "text": "mwandu mochwere kod mewo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.18",
            "verseOrgIds": [
              "PRO.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olemba ber moloyo dhahabu maber,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.19",
            "verseOrgIds": [
              "PRO.8.19"
            ]
          }
