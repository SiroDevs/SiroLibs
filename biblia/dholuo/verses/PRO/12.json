  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "PRO 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat mohero puonj mar rieko ohero ngʼeyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.1",
            "verseOrgIds": [
              "PRO.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:1"
      },
      "items": [
        {
          "text": "to ngʼat ma ok winj puonj ofuwo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.1",
            "verseOrgIds": [
              "PRO.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat maber yudo pwoch kuom Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.2",
            "verseOrgIds": [
              "PRO.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:2"
      },
      "items": [
        {
          "text": "to Jehova Nyasaye kwero ngʼat ma timbene richo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.2",
            "verseOrgIds": [
              "PRO.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato ok nyal gerore motegno kuom richo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.3",
            "verseOrgIds": [
              "PRO.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:3"
      },
      "items": [
        {
          "text": "to ngʼat makare ok nyal pudhi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.3",
            "verseOrgIds": [
              "PRO.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhako ma kite longʼo en osimbo mar chwore,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.4",
            "verseOrgIds": [
              "PRO.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:4"
      },
      "items": [
        {
          "text": "to dhako ma timbene richo chalo gi nyamuoda manie choke.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.4",
            "verseOrgIds": [
              "PRO.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chenro mar ngʼat makare nikare,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.5",
            "verseOrgIds": [
              "PRO.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:5"
      },
      "items": [
        {
          "text": "to puonj mar joricho en wuondruok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.5",
            "verseOrgIds": [
              "PRO.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weche mag joricho opondo karito chwero remo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.6",
            "verseOrgIds": [
              "PRO.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:6"
      },
      "items": [
        {
          "text": "to wach mar joma kare resogi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.6",
            "verseOrgIds": [
              "PRO.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joricho osewiti kendo gilal nono,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.7",
            "verseOrgIds": [
              "PRO.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:7"
      },
      "items": [
        {
          "text": "to od ngʼat makare osiko ogurore motegno.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.7",
            "verseOrgIds": [
              "PRO.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato ipako kaluwore gi riekone,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.8",
            "verseOrgIds": [
              "PRO.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:8"
      },
      "items": [
        {
          "text": "to jogo man-gi paro mobam ichayo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.8",
            "verseOrgIds": [
              "PRO.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ber bedo dhano adhana, to in gi jatich,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.9",
            "verseOrgIds": [
              "PRO.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:9"
      },
      "items": [
        {
          "text": "moloyo wuondori ni in ngʼato, to ionge chiemo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.9",
            "verseOrgIds": [
              "PRO.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat makare chiwo kony ne gik ma jambe dwaro,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.10",
            "verseOrgIds": [
              "PRO.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:10"
      },
      "items": [
        {
          "text": "to timbe mag ngʼwono mag ngʼat marach gin mana gero.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.10",
            "verseOrgIds": [
              "PRO.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat matiyo e puothe biro bedo gi chiemo mogundho,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.11",
            "verseOrgIds": [
              "PRO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:11"
      },
      "items": [
        {
          "text": "to ngʼat mabayo abaya onge gi rieko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.11",
            "verseOrgIds": [
              "PRO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joricho dwaro gik moyaki mag jogo mamono,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.12",
            "verseOrgIds": [
              "PRO.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:12"
      },
      "items": [
        {
          "text": "to tiend joma kare kelo mwandu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.12",
            "verseOrgIds": [
              "PRO.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat marach imako mana gi wuoyone maricho,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.13",
            "verseOrgIds": [
              "PRO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:13"
      },
      "items": [
        {
          "text": "to ngʼat makare tony ne chandruok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.13",
            "verseOrgIds": [
              "PRO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weche mabeyo mawuok e dho ngʼato miyo obedo gi gik mabeyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.14",
            "verseOrgIds": [
              "PRO.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:14"
      },
      "items": [
        {
          "text": "adiera, tich mar lwete kelone konyruok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.14",
            "verseOrgIds": [
              "PRO.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yor ngʼat mofuwo nenorene ni nikare,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.15",
            "verseOrgIds": [
              "PRO.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:15"
      },
      "items": [
        {
          "text": "to ngʼat makare chiko ite ne puonj.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.15",
            "verseOrgIds": [
              "PRO.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat mofuwo nyiso mirimbe mapiyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.16",
            "verseOrgIds": [
              "PRO.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:16"
      },
      "items": [
        {
          "text": "to ngʼat mariek mwonyo ayany.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.16",
            "verseOrgIds": [
              "PRO.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Janeno ma ja-adiera chiwo neno mobidhore,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.17",
            "verseOrgIds": [
              "PRO.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:17"
      },
      "items": [
        {
          "text": "to janeno ma hango wach wacho miriambo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.17",
            "verseOrgIds": [
              "PRO.12.17"
            ]
          }
        }
      ]
    },
    {
