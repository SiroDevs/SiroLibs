  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "1KI 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mikaya okoro Ahab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom higni adek ne onge lweny e kind Israel gi Aram",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.1",
            "verseOrgIds": [
              "1KI.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "To e higa mar adek Jehoshafat ruodh Juda nodhi neno ruodh Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.2",
            "verseOrgIds": [
              "1KI.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruodh Israel nosenyiso jodonge niya, \"Donge ungʼeyo ni Ramoth Gilead en marwa to onge gima watimo mondo wakawe kuom ruodh Aram?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.3",
            "verseOrgIds": [
              "1KI.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo nopenjo Jehoshafat, \"Ibiro dhi konya kedo gi jo-Ramoth Gilead?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.4",
            "verseOrgIds": [
              "1KI.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 22:4"
      },
      "items": [
        {
          "text": "Jehoshafat nodwoko ruodh Israel niya, \"Wan joka ngʼato achiel, joga gin jogi, faresena gin fareseni.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.4",
            "verseOrgIds": [
              "1KI.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Jehoshafat bende nowachone ruodh Israel niya, \"Mokwongo penj ane Jehova Nyasaye wachni.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.5",
            "verseOrgIds": [
              "1KI.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo ruodh Israel nochoko jonabi kanyakla maromo ji mia angʼwen, mopenjogi niya, \"Bende anyalo dhi kedo gi jo-Ramoth Gilead, koso kik adhi?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.6",
            "verseOrgIds": [
              "1KI.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 22:6"
      },
      "items": [
        {
          "text": "Negidwoke niya \"Dhiyo nikech Jehova Nyasaye nochiwe e lwet ruoth.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.6",
            "verseOrgIds": [
              "1KI.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Jehoshafat nopenjo niya, \"Donge nitie janabi mar Jehova Nyasaye ka ma dwapenj wach?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.7",
            "verseOrgIds": [
              "1KI.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruodh Israel nodwoko Jehoshafat niya, \"Pod nitie ngʼato achiel manyalo penjonwa Jehova Nyasaye wach, to ok adware nikech ok okor gimoro amora maber kuoma, to kinde duto mana gik maricho. Nyinge en Mikaya wuod Imla.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.8",
            "verseOrgIds": [
              "1KI.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 22:8"
      },
      "items": [
        {
          "text": "Jehoshafat nodwoko niya, \"Ruoth ok onego iwach kamano.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.8",
            "verseOrgIds": [
              "1KI.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo ruodh Israel noluongo achiel kuom jodonge mowachone niya, \"Dhi piyo iom Mikaya wuod Imla.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.9",
            "verseOrgIds": [
              "1KI.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruodh Israel kod Jehoshafat ruodh Juda noyudo orwako lepgi mag ruoth ka moro ka moro kuomgi obet e kom duongʼne e kar dino cham mantie e dhoranga Samaria, kendo ne gin kod jonabi duto mane koro e nyimgi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.10",
            "verseOrgIds": [
              "1KI.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro Zedekia wuod Kenana noloso tunge mag nyinyo kolando niya, \"Ma e gima Jehova Nyasaye owacho, 'Gi chumbegi ibiro chwowo jo-Aram nyaka itiekgi chuth.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.11",
            "verseOrgIds": [
              "1KI.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonabi mamoko duto bende ne koro wach mana machal kamano. Negiwacho niya, \"Monj jo-Ramoth Gilead kendo ilogi nikech Jehova Nyasaye enokete e lwet ruoth.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.12",
            "verseOrgIds": [
              "1KI.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaote mane odhi luongo Mikaya nowachone niya \"Jonabi duto osekoro wach achiel machalre, kagiwacho ni gima ber biro timore ni ruoth. In bende yie ikor wach maber kaka gisekorono.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.13",
            "verseOrgIds": [
              "1KI.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Mikaya nowacho niya, \"Akwongʼora gi nying Jehova Nyasaye mangima ni, anyalo mana nyise gima Jehova Nyasaye owachona.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.14",
            "verseOrgIds": [
              "1KI.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Mikaya ochopo, ruoth nopenje niya, \"Bende wanyalo dhi mondo waked gi jo-Ramoth Gilead, koso kik wadhi?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.15",
            "verseOrgIds": [
              "1KI.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 22:15"
      },
      "items": [
        {
          "text": "Nodwoke niya, \"Ked kodgi kendo iyud loch nimar Jehova Nyasaye osechiwe e lwet ruoth.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.15",
            "verseOrgIds": [
              "1KI.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth nowachone niya, \"Nyaka karangʼo ma anaketi mondo ikwongʼrina gi nying Jehova Nyasaye ni iwacho adiera ma ok miriambo?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.16",
            "verseOrgIds": [
              "1KI.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Mikaya nodwoke niya, \"Ne aneno jo-Israel duto koke ewi gode mana kaka rombe maonge jakwath, kendo Jehova Nyasaye nowacho ni, 'Jogi onge gi ruoth. Yie iwe ngʼato ka ngʼato odhi e dalane gi kwe.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.17",
            "verseOrgIds": [
              "1KI.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruodh Israel nowachone Jehoshafat niya, \"Donge nawachoni ni ok okorna gik mabeyo, to okoro mana gik maricho?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.18",
            "verseOrgIds": [
              "1KI.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya nodhi nyime kawacho niya, \"Kuom mano winj wach Jehova Nyasaye: Naneno Jehova Nyasaye kobet e kom duongʼne gi jopolo duto kochungʼ molwore, e bade korachwich kendo e bade koracham.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.19",
            "verseOrgIds": [
              "1KI.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo Jehova Nyasaye nowacho ni, 'En ngʼa mabiro hoyo Ahab mondo oked gi jo-Ramoth Gilead kendo onege kuno?'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.20",
            "verseOrgIds": [
              "1KI.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 22:20"
      },
      "items": [
        {
          "text": "\"To ngʼato ka ngʼato nochiwo pache.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.20",
            "verseOrgIds": [
              "1KI.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mogik, roho marach nobiro mochungʼ e nyim Jehova Nyasaye mowacho ni, 'Abiro hoye.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.21",
            "verseOrgIds": [
              "1KI.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jehova Nyasaye nopenje niya, 'Ere kaka ibiro hoye?'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.22",
            "verseOrgIds": [
              "1KI.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 22:22"
      },
      "items": [
        {
          "text": "\"Nodwoke niya, 'Abiro dhi mondo abed roho mar miriambo e dho jonabi mage duto.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.22",
            "verseOrgIds": [
              "1KI.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 22:22"
      },
      "items": [
        {
          "text": "\"Jehova Nyasaye nodwoke niya, 'Dhiyo kendo itim kamano nikech in ema ibiro hoye mi iloye.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.22",
            "verseOrgIds": [
              "1KI.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omiyo koro sani Jehova Nyasaye oseketo roho mar miriambo e dho jonabigi duto. Jehova Nyasaye osengʼadoni buch masira.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.23",
            "verseOrgIds": [
              "1KI.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Zedekia wuod Kenana noa malo mopamo lemb Mikaya. Nopenje niya, \"En yo mane ma Roho mar Jehova Nyasaye noluwo kobiro wuoyo kodi?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.24",
            "verseOrgIds": [
              "1KI.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya nodwoke niya, \"Ibiro fwenyo chiengʼ ma iniring kidhi pondo e ot maiye.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.25",
            "verseOrgIds": [
              "1KI.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruodh Israel nogolo chik niya, \"Kawuru Mikaya kendo utere ir Amon jatend dala maduongʼ kendo ir Joash wuod ruoth,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.26",
            "verseOrgIds": [
              "1KI.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo uwachne ni, 'Gima ruoth wacho ema: Ket ngʼatni e od twech kendo kik imiye gimoro amora makmana makati kod pi nyaka aduogi kangima.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.27",
            "verseOrgIds": [
              "1KI.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya nowachone niya, \"Kidwogo kingima, to kara ok asewuoyo gi dho Jehova Nyasaye.\" Bangʼe nomedo wacho niya, \"Winjuru wechena, un ji duto!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.28",
            "verseOrgIds": [
              "1KI.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oneg Ahab e piny Ramoth Gilead",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo ruodh Israel gi Jehoshafat ruodh Juda nodhi Ramoth Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.29",
            "verseOrgIds": [
              "1KI.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruodh Israel nowachone Jehoshafat niya, \"Abiro rwako lewni moko ka wadhi e lweny mondo kik gifwenya, in to rwak arwaka lepi mag ruoth.\" Omiyo ruodh Israel norwako lewni ma ok nyal fwenyego kendo nodhi e lweny.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.30",
            "verseOrgIds": [
              "1KI.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruodh jo-Aram nogolo chik ne jotende piero adek gariyo mariembo geche niya, \"Kik uked gi ngʼato angʼata bed ni otin kata oduongʼ makmana ruodh Israel.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.31",
            "verseOrgIds": [
              "1KI.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane jotelo mariembo geche lweny noneno Jehoshafat negiwacho e chunygi niya, \"Adier ma en ruodh Israel.\" Omiyo negilokore mondo giked kode, to kane Jehoshafat oywak,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.32",
            "verseOrgIds": [
              "1KI.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "jotelo mariembo geche lweny noneno ni ok en ruodh Israel mi negiweyo lawe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.33",
            "verseOrgIds": [
              "1KI.22.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ngʼat moro noywayo atungʼ mare modiro asere ma nochwowo ruodh Israel e kind law lweny mane orwako. Ruoth nonyiso jariemb gache niya, \"Lok garini mondo igola ka, nimar ahinyora marach.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.34",
            "verseOrgIds": [
              "1KI.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odiechiengʼno duto lweny nomedo bedo mager kendo noten ruoth e gache komanyore gi jo-Aram. Remo mane chwer kawuok kama nohinyore nopongʼo i gari, kendo godhiambo notho.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.35",
            "verseOrgIds": [
              "1KI.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane ochopo podho chiengʼ ywak nowinjore e kind jolweny niya, ngʼato ka ngʼato odog e gwengʼ-gi kendo ngʼato ka ngʼato odog e pinygi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.36",
            "verseOrgIds": [
              "1KI.22.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamano ruoth notho kendo nokele Samaria moike kanyo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.37",
            "verseOrgIds": [
              "1KI.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne gilwoko garino e yawo moro Samaria (kama ochode lwokoree), kendo guogi nonangʼo rembe, mana kaka wach Jehova Nyasaye nosewacho.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.38",
            "verseOrgIds": [
              "1KI.22.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timbe mamoko mag loch Ahab kaachiel gi gik moko duto mane otimo, gi dala ruoth maduongʼ mane ogero mobawo gi lak liech kod mier mane ochielo gi ohinga, donge ondikgi e kitap rapar mar ruodhi Israel?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.39",
            "verseOrgIds": [
              "1KI.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahab noyweyo gi kwerene, kendo Ahazia wuode nokawo lochne kaka ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.40",
            "verseOrgIds": [
              "1KI.22.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoshafat ruodh Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafat wuod Asa nodoko ruodh Juda e higa mar angʼwen mar Ahab ruodh Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.41",
            "verseOrgIds": [
              "1KI.22.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 22:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafat ne ja-higni piero adek gabich kane obedo ruoth kendo norito piny kodak Jerusalem kuom higni piero adek gabich. Min mare ne nyinge Azuba nyar Shilhi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.42",
            "verseOrgIds": [
              "1KI.22.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 22:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "E gik moko duto noluwo yore Asa wuon mare kendo ne ok oweyogi, nimar notimo gima kare e nyim Jehova Nyasaye. To kata kamano kuonde motingʼore gi malo mag lemo ne ok omuki kendo ji nodhi nyime mana gi chiwo misengini kendo wangʼo ubani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.43",
            "verseOrgIds": [
              "1KI.22.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 22:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafat bende ne nigi kwe gi ruodh Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.44",
            "verseOrgIds": [
              "1KI.22.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 22:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gik mamoko manotimore ndalo loch Jehoshafat gi gik mane otimo kaachiel gi humbe lwenjene, donge ondikgi e kitepe rapar mar ruodhi Juda?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.45",
            "verseOrgIds": [
              "1KI.22.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 22:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noriembo jochode machwo mane ni kuonde motingʼore mag lemo mane otony e ndalo mag loch wuon-gi Asa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.46",
            "verseOrgIds": [
              "1KI.22.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 22:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kindeno ne onge ruoth e piny Edom, jalupne ema ne ni e loch.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.47",
            "verseOrgIds": [
              "1KI.22.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 22:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro Jehoshafat nohondho yiedhi mag ohala mondo odhi Ofir oom dhahabu to kata kamano ne ok gikwangʼ nikech ne gikethore kama iluongo ni Ezion Geber.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.48",
            "verseOrgIds": [
              "1KI.22.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 22:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kindeno Ahazia wuod Ahab nowacho ni Jehoshafat niya, \"Yie iwe joga okwangʼ gi jogi, to Jehoshafat nodagi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.49",
            "verseOrgIds": [
              "1KI.22.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 22:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafat notho kaka kwerene kendo noyike but kwerene e dala maduongʼ mar Daudi wuon-gi. Kendo Jehoram wuode nobedo ruoth kare.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.50",
            "verseOrgIds": [
              "1KI.22.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahazia ruodh Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1KI 22:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazia wuod Ahab nobedo ruodh Israel e Samaria e higa mar apar gabiriyo mar loch Jehoshafat ruodh Juda, kendo nobedo ruodh Israel higni ariyo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.51",
            "verseOrgIds": [
              "1KI.22.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1KI 22:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notimo richo e nyim Jehova Nyasaye nikech nowuotho e yore mag wuon-gi gi min-gi kendo e yore mag Jeroboam wuod Nebat mane omiyo Israel otimo richo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.52",
            "verseOrgIds": [
              "1KI.22.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1KI 22:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notiyo ni Baal kendo nolame mi nomiyo Jehova Nyasaye, Nyasach Israel, obedo gi mirima mana kaka wuon-gi nosetimo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.53",
            "verseOrgIds": [
              "1KI.22.54"
            ]
          }
        }
      ]
    }
  ],
