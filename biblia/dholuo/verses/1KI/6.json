          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo nogero laru maiye gi kite mopa molwore nyadidek kaachiel gi laini achiel mar bap yiend sida.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
