  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
        "style": "c",
        "sid": "JOB 40"
      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nowachone Ayub kama:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.1",
            "verseOrgIds": [
              "JOB.40.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bende nitiere ngʼat mapiem gi Jehova Nyasaye Maratego manyalo kwere?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.2",
            "verseOrgIds": [
              "JOB.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:2"
      },
      "items": [
        {
          "text": "Mad koro ngʼat mamino wach gi Nyasaye oduokeane!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.2",
            "verseOrgIds": [
              "JOB.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Ayub nodwoko Jehova Nyasaye kama:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.3",
            "verseOrgIds": [
              "JOB.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaye Jehova Nyasaye, ok aromo dwokora kodi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.4",
            "verseOrgIds": [
              "JOB.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:4"
      },
      "items": [
        {
          "text": "omiyo mano ema omiyo alingʼ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.4",
            "verseOrgIds": [
              "JOB.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asewuoyo moromo, to ok ayudo dwoko",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.5",
            "verseOrgIds": [
              "JOB.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:5"
      },
      "items": [
        {
          "text": "omiyo koro ok abi wuoyo kendo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.5",
            "verseOrgIds": [
              "JOB.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nodwoko Ayub gi ei yamo maduongʼ. Nowacho kama:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.6",
            "verseOrgIds": [
              "JOB.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chungʼ ane ka dichwo; mondo idwoka weche,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.7",
            "verseOrgIds": [
              "JOB.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:7"
      },
      "items": [
        {
          "text": "ma adwaro penjigi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.7",
            "verseOrgIds": [
              "JOB.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Angʼo momiyo iketho adiera mara?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.8",
            "verseOrgIds": [
              "JOB.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:8"
      },
      "items": [
        {
          "text": "Angʼo momiyo iketo rach kuoma mondo in inenri ka ngʼama ber?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.8",
            "verseOrgIds": [
              "JOB.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende in gi teko machalo gi mar Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.9",
            "verseOrgIds": [
              "JOB.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:9"
      },
      "items": [
        {
          "text": "koso dwondi bende nyalo mor kaka mare?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.9",
            "verseOrgIds": [
              "JOB.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kamano, to kare bidhriane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.10",
            "verseOrgIds": [
              "JOB.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:10"
      },
      "items": [
        {
          "text": "kirwakori gi duongʼ, luor kod ber.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.10",
            "verseOrgIds": [
              "JOB.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ mano rang jogo ma sungore,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.11",
            "verseOrgIds": [
              "JOB.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:11"
      },
      "items": [
        {
          "text": "kendo iol mirimbi mager kuomgi mondo omi gibolre.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.11",
            "verseOrgIds": [
              "JOB.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, rang joma sungore duto kendo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.12",
            "verseOrgIds": [
              "JOB.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:12"
      },
      "items": [
        {
          "text": "ikumgi kama gichungoeno mondo omi gibolre.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.12",
            "verseOrgIds": [
              "JOB.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikgi duto e lowo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.13",
            "verseOrgIds": [
              "JOB.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:13"
      },
      "items": [
        {
          "text": "mondo ji kik negi kendo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.13",
            "verseOrgIds": [
              "JOB.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyalo timo kamano to an owuon ema anakuong paki",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.14",
            "verseOrgIds": [
              "JOB.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:14"
      },
      "items": [
        {
          "text": "ni tekri iwuon ema omiyo iloyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.14",
            "verseOrgIds": [
              "JOB.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Parane rawo, mane achweyo kaka ne achweyi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.15",
            "verseOrgIds": [
              "JOB.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:15"
      },
      "items": [
        {
          "text": "kendo machamo lum kaka rwadh pur chamo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.15",
            "verseOrgIds": [
              "JOB.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Parie teko mangʼeny ma en-go,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.16",
            "verseOrgIds": [
              "JOB.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:16"
      },
      "items": [
        {
          "text": "kendo parie teko maduongʼ manie leche mag dende!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.16",
            "verseOrgIds": [
              "JOB.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe yamo tero ka yiend sida;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.17",
            "verseOrgIds": [
              "JOB.40.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:17"
      },
      "items": [
        {
          "text": "kendo leche manie bembene omoko kuome maber.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.17",
            "verseOrgIds": [
              "JOB.40.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chokene otegno ka mula,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.18",
            "verseOrgIds": [
              "JOB.40.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:18"
      },
      "items": [
        {
          "text": "kendo tiendene otegno ka chuma.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.18",
            "verseOrgIds": [
              "JOB.40.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwane kaka chwech maberie moloyo mar Nyasaye e kind le duto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.19",
            "verseOrgIds": [
              "JOB.40.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:19"
      },
      "items": [
        {
          "text": "kendo en mana Jachwechne kende ema nyalo chome gi ligangla.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.19",
            "verseOrgIds": [
              "JOB.40.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochamo lumbe motwi ewi got,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.20",
            "verseOrgIds": [
              "JOB.40.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:20"
      },
      "items": [
        {
          "text": "kuonde ma le mager ema kwayoe.",
          "type": "text",
