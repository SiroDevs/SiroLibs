  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JOB 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Donge dhano nigi tich matek e piny?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.1",
            "verseOrgIds": [
              "JOB.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:1"
      },
      "items": [
        {
          "text": "Donge ndalone chalo gi ndalo mag ngʼat mondiki kuom kinde machwok?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.1",
            "verseOrgIds": [
              "JOB.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka misumba ma gombo ni seche mag odhiambo ochop piyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.2",
            "verseOrgIds": [
              "JOB.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:2"
      },
      "items": [
        {
          "text": "kata ka ngʼama ondiki marito chudo mare gi geno,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.2",
            "verseOrgIds": [
              "JOB.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "e kaka an bende osemiya dweche maonge ohala",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.3",
            "verseOrgIds": [
              "JOB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:3"
      },
      "items": [
        {
          "text": "kod otieno mopongʼ gi chandruok.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.3",
            "verseOrgIds": [
              "JOB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka adhi nindo to piny ok runa piyo kendo aparora ni abiro aa malo sa adi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.4",
            "verseOrgIds": [
              "JOB.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:4"
      },
      "items": [
        {
          "text": "Piny budhona kapok oru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.4",
            "verseOrgIds": [
              "JOB.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:4"
      },
      "items": [
        {
          "text": "kendo apuodora koni gi koni nyaka okinyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.4",
            "verseOrgIds": [
              "JOB.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Denda kute gi adhonde opongʼo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.5",
            "verseOrgIds": [
              "JOB.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:5"
      },
      "items": [
        {
          "text": "pien denda mbala omako kendo chwer tutu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.5",
            "verseOrgIds": [
              "JOB.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndalo mar ngimana dhiyo mapiyo moloyo masind jachwe usi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.6",
            "verseOrgIds": [
              "JOB.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:6"
      },
      "items": [
        {
          "text": "kendo orumo piyo maonge geno.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.6",
            "verseOrgIds": [
              "JOB.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Nyasaye, parie kaka ngimana en mana muya nono;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.7",
            "verseOrgIds": [
              "JOB.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:7"
      },
      "items": [
        {
          "text": "wengena ok nochak one mor kendo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.7",
            "verseOrgIds": [
              "JOB.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenge makoro nena sani ok nochak onena kendo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.8",
            "verseOrgIds": [
              "JOB.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:8"
      },
      "items": [
        {
          "text": "gibiro dwara to ok gininena.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.8",
            "verseOrgIds": [
              "JOB.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka bor polo rumo mi lal nono,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.9",
            "verseOrgIds": [
              "JOB.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:9"
      },
      "items": [
        {
          "text": "e kaka ngʼat miyiko e liel ok duogi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.9",
            "verseOrgIds": [
              "JOB.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok nodwogi e ode kendo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.10",
            "verseOrgIds": [
              "JOB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:10"
      },
      "items": [
        {
          "text": "kar dakne ok nongʼeye kendo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.10",
            "verseOrgIds": [
              "JOB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Emomiyo ok anyal lingʼ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.11",
            "verseOrgIds": [
              "JOB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:11"
      },
      "items": [
        {
          "text": "abiro wacho lit manie chunya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.11",
            "verseOrgIds": [
              "JOB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:11"
      },
      "items": [
        {
          "text": "abiro nyiso pek ma an-go e chunya nikech mirima ma an-go.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.11",
            "verseOrgIds": [
              "JOB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "An nam, koso an ondiek nam",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.12",
            "verseOrgIds": [
              "JOB.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:12"
      },
      "items": [
        {
          "text": "momiyo ogona agengʼa kama?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.12",
            "verseOrgIds": [
              "JOB.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka aparo ni kitandana biro hoya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.13",
            "verseOrgIds": [
              "JOB.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:13"
      },
      "items": [
        {
          "text": "kendo ni piendena mayom biro dwoko chandruokna chien,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.13",
            "verseOrgIds": [
              "JOB.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "to eka pod ibwoga gi lek magalagala",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.14",
            "verseOrgIds": [
              "JOB.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:14"
      },
      "items": [
        {
          "text": "kendo imiya luoro gi fweny mayoreyore,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.14",
            "verseOrgIds": [
              "JOB.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "momiyo koro daher mondo adera kendo atho,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.15",
            "verseOrgIds": [
              "JOB.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:15"
      },
      "items": [
        {
          "text": "moloyo bedo gi ringruok ma an-goni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.15",
            "verseOrgIds": [
              "JOB.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achayo ngimana; ok agomb kata medo bedo mangima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.16",
            "verseOrgIds": [
              "JOB.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:16"
      },
      "items": [
        {
          "text": "Weya mos; ndalo mag ngimana onge gi tiende.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.16",
            "verseOrgIds": [
              "JOB.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaye Nyasaye, dhano to en angʼo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.17",
            "verseOrgIds": [
              "JOB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:17"
      },
      "items": [
        {
          "text": "momiyo ikawe ka gima lich kendo isiko ipare ndalo duto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.17",
            "verseOrgIds": [
              "JOB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "koso angʼo momiyo isiko inone okinyi kokinyi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.18",
            "verseOrgIds": [
              "JOB.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:18"
      },
