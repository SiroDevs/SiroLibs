  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "JOB 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nitie kama ikunyoe fedha",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.1",
            "verseOrgIds": [
              "JOB.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:1"
      },
      "items": [
        {
          "text": "kod kama ilenyoe dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.1",
            "verseOrgIds": [
              "JOB.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chuma ikunyo koa e lowo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.2",
            "verseOrgIds": [
              "JOB.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:2"
      },
      "items": [
        {
          "text": "kendo mula ilenyo kigolo kuom kite.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.2",
            "verseOrgIds": [
              "JOB.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji kunyo kite ma nengogi tek kuonde matut mogik kendo motimo mudho,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.3",
            "verseOrgIds": [
              "JOB.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:3"
      },
      "items": [
        {
          "text": "omenyo nyaka ei buche maboyo miwuoro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.3",
            "verseOrgIds": [
              "JOB.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:3"
      },
      "items": [
        {
          "text": "nyaka kuonde molil ti, mondo onwangʼie kite mabeyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.3",
            "verseOrgIds": [
              "JOB.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opowo kor gode modhi mabor gi kuonde ma ji odakie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.4",
            "verseOrgIds": [
              "JOB.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:4"
      },
      "items": [
        {
          "text": "mochop nyaka kuonde ma ji ok wuothie;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.4",
            "verseOrgIds": [
              "JOB.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:4"
      },
      "items": [
        {
          "text": "ka giliero e tonde marundore koni gi koni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.4",
            "verseOrgIds": [
              "JOB.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowo e kama chiemo wuokie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.5",
            "verseOrgIds": [
              "JOB.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:5"
      },
      "items": [
        {
          "text": "to pinyne ibaroe lwendni gi mach.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.5",
            "verseOrgIds": [
              "JOB.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwendinigo ema kite ma nengogi tek miluongo ni Safir wuokie",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.6",
            "verseOrgIds": [
              "JOB.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:6"
      },
      "items": [
        {
          "text": "kendo buru ema otingʼo dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.6",
            "verseOrgIds": [
              "JOB.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom winy machamo ringʼo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.7",
            "verseOrgIds": [
              "JOB.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:7"
      },
      "items": [
        {
          "text": "onge moro amora mongʼeyo yore manie buchego,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.7",
            "verseOrgIds": [
              "JOB.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:7"
      },
      "items": [
        {
          "text": "kendo onge achuth mosenene gi wangʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.7",
            "verseOrgIds": [
              "JOB.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ondiegi mager pok nowuotho kuondego,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.8",
            "verseOrgIds": [
              "JOB.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:8"
      },
      "items": [
        {
          "text": "kendo kata sibuor pok oruto kuno.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.8",
            "verseOrgIds": [
              "JOB.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji baro lwanda matek ka chuma",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.9",
            "verseOrgIds": [
              "JOB.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:9"
      },
      "items": [
        {
          "text": "kendo thulo gode oko gie tiendegi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.9",
            "verseOrgIds": [
              "JOB.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otucho kor lwanda;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.10",
            "verseOrgIds": [
              "JOB.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:10"
      },
      "items": [
        {
          "text": "mi wengene ne mwandu duto manie kor gode.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.10",
            "verseOrgIds": [
              "JOB.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omanyo kuonde ma aore ochakoree,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.11",
            "verseOrgIds": [
              "JOB.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:11"
      },
      "items": [
        {
          "text": "mi okel gik mopandi e lela.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.11",
            "verseOrgIds": [
              "JOB.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To rieko to diyud kanye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.12",
            "verseOrgIds": [
              "JOB.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:12"
      },
      "items": [
        {
          "text": "Koso ere kuma ngʼeyo wuokie?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.12",
            "verseOrgIds": [
              "JOB.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhano mangima ok ongʼeyo kaka iyude;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.13",
            "verseOrgIds": [
              "JOB.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:13"
      },
      "items": [
        {
          "text": "kendo ok oyudre e piny joma ngima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.13",
            "verseOrgIds": [
              "JOB.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kut wacho ni, 'Oonge e iya;'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.14",
            "verseOrgIds": [
              "JOB.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:14"
      },
      "items": [
        {
          "text": "to nam wacho ni, 'Oonge koda ka.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.14",
            "verseOrgIds": [
              "JOB.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok nyal ngʼiewe gi dhahabu maler mogik",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.15",
            "verseOrgIds": [
              "JOB.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:15"
      },
      "items": [
        {
          "text": "kendo nengone ok nyal pim gi fedha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.15",
            "verseOrgIds": [
              "JOB.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok nyal ngʼiewe gi dhahabu mokuny Ofir,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.16",
            "verseOrgIds": [
              "JOB.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:16"
      },
      "items": [
        {
          "text": "kata gi kite ma nengogi tek kaka Oniks kata Safir.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.16",
            "verseOrgIds": [
              "JOB.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhahabu kata kite mamil ma nengogi tek ok nyal pimego",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.17",
            "verseOrgIds": [
              "JOB.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:17"
      },
      "items": [
        {
          "text": "bende ok nyal pime gi gima olos gi dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.17",
            "verseOrgIds": [
              "JOB.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit nam ma nengone tek kod kit ombo marieny ok di wuo kuomgi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.18",
            "verseOrgIds": [
              "JOB.28.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
