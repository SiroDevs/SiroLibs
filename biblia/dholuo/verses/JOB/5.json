  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "JOB 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"In Ayub, luong ane ka bende nitiere ngʼama nyalo dwoki?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.1",
            "verseOrgIds": [
              "JOB.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:1"
      },
      "items": [
        {
          "text": "Bende nitie kuom jo-malaika minyalo ringo irgi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.1",
            "verseOrgIds": [
              "JOB.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ich wangʼ nego ngʼama ofuwo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.2",
            "verseOrgIds": [
              "JOB.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:2"
      },
      "items": [
        {
          "text": "kendo nyiego tieko ngʼama omingʼ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.2",
            "verseOrgIds": [
              "JOB.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "An awuon aseneno ngʼama ofuwo ka odak e ngima maber,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.3",
            "verseOrgIds": [
              "JOB.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:3"
      },
      "items": [
        {
          "text": "to apoya nono opo ka ode okwongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.3",
            "verseOrgIds": [
              "JOB.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithinde ok nyal yudo konyruok",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.4",
            "verseOrgIds": [
              "JOB.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:4"
      },
      "items": [
        {
          "text": "kendo onge ngʼama chwakgi e od bura.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.4",
            "verseOrgIds": [
              "JOB.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma kech oloyo chamo chamb ngʼat mofuwono,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:5"
      },
      "items": [
        {
          "text": "nyaka mago madongo e kind kuthe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:5"
      },
      "items": [
        {
          "text": "kendo joma riyo oloyo dwaro yako mwandune.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech richo ok honre ahona kayiem,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.6",
            "verseOrgIds": [
              "JOB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:6"
      },
      "items": [
        {
          "text": "kata chandruok bende ok bi kaonge gima omiyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.6",
            "verseOrgIds": [
              "JOB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "To dhano inywolo ei chandruok,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.7",
            "verseOrgIds": [
              "JOB.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:7"
      },
      "items": [
        {
          "text": "mana kaka pilni mach dhwolore kadhi malo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.7",
            "verseOrgIds": [
              "JOB.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dine bed ni an in, to dine atero ywakna ne Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.8",
            "verseOrgIds": [
              "JOB.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:8"
      },
      "items": [
        {
          "text": "kendo keto weche mathaga e nyime.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.8",
            "verseOrgIds": [
              "JOB.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otimo gik madongo miwuoro ma rieko dhano ok chopie",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.9",
            "verseOrgIds": [
              "JOB.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:9"
      },
      "items": [
        {
          "text": "honni mage thoth ma ok nyal kwan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.9",
            "verseOrgIds": [
              "JOB.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo koth chue e piny;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.10",
            "verseOrgIds": [
              "JOB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:10"
      },
      "items": [
        {
          "text": "kendo omiyo puothe bedo mangʼich.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.10",
            "verseOrgIds": [
              "JOB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma ni piny otingʼo malo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.11",
            "verseOrgIds": [
              "JOB.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:11"
      },
      "items": [
        {
          "text": "kendo ohoyo joma ywak.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.11",
            "verseOrgIds": [
              "JOB.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oketho chenro mar joma paro timo timbe mamono",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.12",
            "verseOrgIds": [
              "JOB.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:12"
      },
      "items": [
        {
          "text": "mondo omi gik ma giparogo kik timre.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.12",
            "verseOrgIds": [
              "JOB.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omako joma riek gi riekogi giwegi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.13",
            "verseOrgIds": [
              "JOB.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:13"
      },
      "items": [
        {
          "text": "kendo gimoro amora ma giparo timo ok timre.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.13",
            "verseOrgIds": [
              "JOB.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piny othonegi mudho kata mana ka chiengʼ rieny,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.14",
            "verseOrgIds": [
              "JOB.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:14"
      },
      "items": [
        {
          "text": "gibagni odiechiengʼ tir mana ka gima en otieno.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.14",
            "verseOrgIds": [
              "JOB.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oreso joma odhier e dho tho;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.15",
            "verseOrgIds": [
              "JOB.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:15"
      },
      "items": [
        {
          "text": "kendo oresogi e lwet joma roteke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.15",
            "verseOrgIds": [
              "JOB.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo joma odhier bedo gi geno,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.16",
            "verseOrgIds": [
              "JOB.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:16"
      },
      "items": [
        {
          "text": "to joma timbegi mono omiyo lingʼ thi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.16",
            "verseOrgIds": [
              "JOB.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"En jahawi ngʼat ma Nyasaye kwero,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.17",
            "verseOrgIds": [
              "JOB.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:17"
      },
      "items": [
        {
          "text": "omiyo kik icha kum mar Jehova Nyasaye Maratego.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.17",
            "verseOrgIds": [
              "JOB.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar kokecho kodi mochwadi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.18",
            "verseOrgIds": [
              "JOB.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:18"
      },
      "items": [
        {
          "text": "to en bende ema ochako othiedho kuonde mohinyorego.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.18",
            "verseOrgIds": [
              "JOB.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 5:19"
          },
          "items": [
