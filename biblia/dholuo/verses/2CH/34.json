          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka nomiyo jo-Jerusalem duto kod jo-Benjamin okwongʼore ni ginirit singruokno kendo jo-Jerusalem notimo mano kaluwore gi singruok mar Nyasaye, ma Nyasach kweregi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        }
      ]
    },
    {
