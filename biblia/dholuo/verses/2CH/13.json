  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "2CH 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abija obedo ruodh Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "E higa mar apar gaboro mar loch Jeroboam, Abija nobedo ruodh Juda,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.1",
            "verseOrgIds": [
              "2CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo norito piny kuom higni adek kodak Jerusalem. Min mare ne nyinge Maaka ma nyar Uriel ja-Gibea.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 13:2"
      },
      "items": [
        {
          "text": "Ne nitiere lweny e kind Abija kod Jeroboam.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abija nodhi e kedo ka en gi jolweny molony alufu mia angʼwen to Jeroboam nochano jolweny moyier marateke alufu mia aboro.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.3",
            "verseOrgIds": [
              "2CH.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abija nochungo e Got Zemaraim e piny gode mag Efraim kowacho niya, \"Winjauru in Jeroboam kod jo-Israel duto!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.4",
            "verseOrgIds": [
              "2CH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donge ungʼeyo ni Jehova Nyasaye ma Nyasach jo-Israel nomiyo Daudi kod nyikwaye loch Israel nyaka chiengʼ kotimo kodgi singruok ma ok tow?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.5",
            "verseOrgIds": [
              "2CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kata obedo kamano Jeroboam wuod Nebat jatelo mar Solomon wuod Daudi nongʼanyo ni ruodhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.6",
            "verseOrgIds": [
              "2CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji moko ma timbegi mono noriwore kode mi negikwedo Rehoboam wuod Solomon kane pod en rawera mayom yom kendo ne ok otek monyalo sirogi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.7",
            "verseOrgIds": [
              "2CH.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To koro sani ichano mondo itamri loch Jehova Nyasaye mantiere e lwet nyikwa Daudi. Adieri un kod jolweny mangʼeny kendo un kod nyiroye mag dhahabu mane Jeroboam oloso mondo obed nyisecheu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.8",
            "verseOrgIds": [
              "2CH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "To donge nuriembo jodolo mag Jehova Nyasaye ma yawuot Harun kaachiel gi jo-Lawi kendo ne uyiero jodolo magu kaka jopinje mamoko timo? Ngʼato angʼata mobiro opwodhore gi nyarwath kod imbe abiriyo nyalo bedo jadolo mar gik ma ok nyiseche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.9",
            "verseOrgIds": [
              "2CH.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wan to Jehova Nyasaye en Nyasachwa kendo ok waseweye ngangʼ. Jodolo matiyone Jehova Nyasaye gin yawuot Harun kendo jo-Lawi konyogi e tijno.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okinyi godhiambo gichiwone Jehova Nyasaye misengini miwangʼo pep kod gik mangʼwe ngʼar kendo giketo makati e mesa mopwodhi kendo gimoko teche moket e rachungi taya mar dhahabu godhiambo pile ka pile. Wan warito chike Jehova Nyasaye ma Nyasachwa, un to useweye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.11",
            "verseOrgIds": [
              "2CH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye ni kodwa; en e jatendwa. Jodolo mage biro goyo turumbete miluong ji mondo oked kodu. Jo-Israel, kik uked gi Jehova Nyasaye, ma Nyasach kwereu nikech ok ubiloyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.12",
            "verseOrgIds": [
              "2CH.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeroboam noseoro jolweny mondo oluor e tokgi mondo ni kane en e nyim Juda to jolweny moko mondo omonjgi gi ka tokgi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.13",
            "verseOrgIds": [
              "2CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane jo-Juda olokore moneno nine imonjogi gi ka tokgi kod e nyimgi eka negiywagore ni Jehova Nyasaye. To jodolo bende nogoyo turumbete",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.14",
            "verseOrgIds": [
              "2CH.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "eka jo-Juda nongʼiyo kendo kane gigiyo kamano Nyasaye nokeyo Jeroboam kaachiel gi jo-Israel duto e nyim Abija kod jo-Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.15",
            "verseOrgIds": [
              "2CH.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Israel noringo akeya nono e nyim jo-Juda nikech Nyasaye nochiwogi e lwet jo-Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.16",
            "verseOrgIds": [
              "2CH.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abija kod joge nonegogi malich ahinya ma joma nohinyore kuom jo-Israel marateke moyier ne gin ji alufu mia abich.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.17",
            "verseOrgIds": [
              "2CH.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamano e kaka ne olo jo-Israel chiengʼno, jo-Juda nolocho nikech negigeno kuom Jehova Nyasaye, ma Nyasach kweregi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.18",
            "verseOrgIds": [
              "2CH.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abija nolawo Jeroboam mokawo mieche kaka Bethel gi Jeshana kod Efron kod mier matindo mokiewo kode.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.19",
            "verseOrgIds": [
              "2CH.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loch Jeroboam ne ok ochako obedo motegno e kinde Abija. Bangʼe Jehova Nyasaye nogoye motho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.20",
            "verseOrgIds": [
              "2CH.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loch Abija nomedo gurore motegno. Nokendo mon apar gangʼwen kendo ne en gi yawuowi piero ariyo gariyo kod nyiri apar gauchiel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.21",
            "verseOrgIds": [
              "2CH.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weche moko mag loch Abija, timbene duto kod gik mane owacho ondiki e kitap Ido janabi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.22",
            "verseOrgIds": [
              "2CH.13.22"
            ]
          }
        }
      ]
    }
  ],
