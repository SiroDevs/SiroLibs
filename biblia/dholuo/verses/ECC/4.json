          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aseneno ni jogo duto mane odak kendo owuotho e bwo wangʼ chiengʼ noluwo bangʼ ngʼama tin, mane okawo kom ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.15",
            "verseOrgIds": [
