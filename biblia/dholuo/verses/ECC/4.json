              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato nyalo bedo ni oa e twech kata odhier, to bangʼe obedo ruoth e pinygi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.14",
            "verseOrgIds": [
              "ECC.4.14"
