  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "LUK 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Johana ja-Batiso loso yo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "E higa mar apar gabich mar loch Kaisar Teberio, kane Pontio Pilato ne ruodh Judea, to Herode ne ruodh Galili, kendo Filipo owadgi ne ruodh Iturea gi Trakoniti, to Lusania ne ruodh Abilen,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.1",
            "verseOrgIds": [
              "LUK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "e kinde ma jodolo madongo ne gin Anas gi Kaifas, wach Nyasaye ne obiro ne Johana wuod Zekaria e thim.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.2",
            "verseOrgIds": [
              "LUK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nodhi e piny duto molworo Jordan, koyalo batiso mar weyo richo mondo mi owenegi richo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.3",
            "verseOrgIds": [
              "LUK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka nondiki e kitabu mar weche mag Isaya janabi niya:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 3:4"
      },
      "items": [
        {
          "text": "\"Ngʼat moro kok e thim ni,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 3:4"
      },
      "items": [
        {
          "text": "'Losuru yo ne Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 3:4"
      },
      "items": [
        {
          "text": "losneuru yore moriere tir.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoho ka hoho nobugi mapongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 3:5"
      },
      "items": [
        {
          "text": "gode madongo gi matindo duto nopie.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 3:5"
      },
      "items": [
        {
          "text": "Yore mobam biro bedo moriere,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 3:5"
      },
      "items": [
        {
          "text": "yore motimo gogni nobed mayom.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo ji duto biro neno warruok mar Nyasaye.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.6",
            "verseOrgIds": [
              "LUK.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johana nowacho ne oganda mane biro mondo obatisgi niya, \"Un koth thuondegi! En ngʼa mane onyisou mondo uring utony ne mirima mager mabiro?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.7",
            "verseOrgIds": [
              "LUK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaguru olemo manyiso ni uselokoru uweyo richo. Kendo kik upar e kindu uwegi ni, 'Wan gi Ibrahim kaka wuonwa.' Nimar awachonu ni kata mana kitegi Nyasaye nyalo loko nyithind Ibrahim.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.8",
            "verseOrgIds": [
              "LUK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le oseketi e tiend yiende, kendo yien ka yien ma ok nyag olemo mabeyo ibiro tongʼ mi go piny kendo witi e mach.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.9",
            "verseOrgIds": [
              "LUK.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oganda nopenje niya, \"Kara en angʼo monego watim?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.10",
            "verseOrgIds": [
              "LUK.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johana nodwoko niya, \"Ngʼat man-gi sede ariyo owinjore chiw achiel okonygo nyawadgi ma ongego, kendo jalno man kod chiemo bende onego tim kamano.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.11",
            "verseOrgIds": [
              "LUK.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josol osuru bende nobiro ire mondo obatisgi. Negipenje niya, \"Japuonj. En angʼo mowinjore watim?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.12",
            "verseOrgIds": [
              "LUK.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonyisogi niya, \"Kik usol osuru moloyo kaka idwaro ni mondo usol.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.13",
            "verseOrgIds": [
              "LUK.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka askeche moko nopenje niya, \"To en angʼo mowinjore watim.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 3:14"
      },
      "items": [
        {
          "text": "Nodwokogi niya, \"Kik uma ngʼato pesa githuon kata donjo ne ji gi miriambo to misara maru muyudo mondo oromu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji ne pod rito gi geno ahinya kendo giduto ne giwuoro ka giparo e chunjegi ni nyalo bedo ni Johana e Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.15",
            "verseOrgIds": [
              "LUK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johana nodwokogi duto niya, \"An abatisou gi pi. To ngʼato moro biro bangʼa ma oloya gi duongʼ, ma ok awinjora gonyo tond wuochene. En obiro batisou gi Roho Maler kod mach.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.16",
            "verseOrgIds": [
              "LUK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odheru mare mar piedho cham ni e lwete mondo opiedhgo cham duto maler e kar dino cham, kendo ochok cham koketo e deche, to obiro wangʼo mihudhi gi mach ma ok nyal negi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "To gi weche moko mangʼeny Johana nojiwo ji kendo noyalo Injili ne ji.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.18",
            "verseOrgIds": [
              "LUK.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka Johana nokwero Ruoth Herode nikech wach Herodia, ma chi owadgi, kendo kuom gik mamoko maricho mane osetimo,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.19",
            "verseOrgIds": [
              "LUK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herode nomedo timo gima rachie moloyo kendo nomako Johana motero e od twech.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.20",
            "verseOrgIds": [
              "LUK.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Batiso gi anywola mar Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane ibatiso ji duto, Yesu bende ne obatisi. To kane olemo, polo noyawore",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.21",
            "verseOrgIds": [
              "LUK.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo Roho Maler mane obiro e kido mar akuru nolor mopiyo kuome, to dwol noa e polo mawacho niya, \"In e Wuoda, ma ahero; chunya mor kodi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
            "verseOrgIds": [
              "LUK.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro ka Yesu owuon nochako tichne ka hike dirom piero adek. Ne iparo nine en wuod Josef,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.23",
            "verseOrgIds": [
              "LUK.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "LUK 3:23"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "LUK 3:23"
      },
      "items": [
        {
          "text": "wuod Heli",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.23",
            "verseOrgIds": [
              "LUK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "wuod Mathat,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.24",
            "verseOrgIds": [
              "LUK.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "LUK 3:24"
      },
      "items": [
        {
          "text": "wuod Lawi, wuod Melki,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.24",
            "verseOrgIds": [
              "LUK.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "LUK 3:24"
      },
      "items": [
        {
          "text": "wuod Janai, wuod Josef,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.24",
            "verseOrgIds": [
              "LUK.3.24"
            ]
