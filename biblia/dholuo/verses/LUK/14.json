          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngʼat man-gi it mar winjo wach mondo owinji.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.35",
                "verseOrgIds": [
                  "LUK.14.35"
                ]
