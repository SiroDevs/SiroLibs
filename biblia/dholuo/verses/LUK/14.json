          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kata ka dibed ni ruoth moro dwaro dhiyo e lweny e kinde gi ruoth machielo. Donge mokwongo onego obed piny mondo opar anena ka ji alufu apar ma en-go bende onyalo kedogo gi jal mabiro monje man-gi ji alufu piero ariyo?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.31",
                "verseOrgIds": [
                  "LUK.14.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.31",
            "verseOrgIds": [
              "LUK.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka ok donyal, to obiro oro joote ka pod jal machielo pod ni kuma bor, mondo onyise ni odwaro mondo giwinjre e yor kwe.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.32",
                "verseOrgIds": [
                  "LUK.14.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.32",
            "verseOrgIds": [
              "LUK.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Machalre kamano bende, ngʼato kuomu ma ok oweyo gige duto ok onyal bedo japuonjrena.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.33",
                "verseOrgIds": [
                  "LUK.14.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chumbi ber, to ka ndhathe orumo, ere kaka dimiye obed gi ndhathe kendo?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.34",
                "verseOrgIds": [
                  "LUK.14.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.34",
            "verseOrgIds": [
              "LUK.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ok owinjore ne tich lowo kata mana pidh owuoyo, omiyo ipuke oko.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.35",
                "verseOrgIds": [
                  "LUK.14.35"
                ]
              }
            }
          ]
        }
