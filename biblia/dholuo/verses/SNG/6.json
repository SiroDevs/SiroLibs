          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaherani olal kune,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "yaye jaber mogik e dier nyiri mabeyo?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "Jaherani ne oluwo kanye,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "mondo wakonyi manye?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Nyako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaherana osedhi e puothe,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "kama gik mangʼwe ngʼar dongoe,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "mondo omeny ei puothe",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "kendo ochok ondanyo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaherana en mara kendo an bende an mare;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.3",
            "verseOrgIds": [
              "SNG.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:3"
      },
      "items": [
        {
          "text": "omiyo omenyo e dier ondanyo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.3",
            "verseOrgIds": [
              "SNG.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Wuowi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaherana, ijaber mana ka Tirza,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:4"
      },
      "items": [
        {
          "text": "ilongʼo mana ka Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:4"
      },
      "items": [
        {
          "text": "ichanori mana ka jolweny motingʼo bendeche.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gol wengegi kuoma;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "nikech giberna.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "Yie wiyi chalo kweth mag diek,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "malor koa e got Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lekeni tar mana ka kweth mag rombe",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "mowuok kar luok.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "Moro ka moro wuotho gi nyithinde ma rude",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "kendo onge moro man kende.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lembi ma iumo gi nanga",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.7",
            "verseOrgIds": [
              "SNG.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:7"
      },
      "items": [
        {
          "text": "chalo gi olemo mongʼinore mochiek makwar.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.7",
            "verseOrgIds": [
              "SNG.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth nigi mon piero auchiel",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:8"
      },
      "items": [
        {
          "text": "gi mon mamoko piero aboro,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:8"
      },
      "items": [
        {
          "text": "kod nyiri mapok ongʼeyo chwo mokadho akwana.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "To an ahero mana nyako achiel kende,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "ma jaber ka akuru, en e nyar min kende,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "mohero malich.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "Jotich ma nyiri konene, to luonge ni nyako mogwedhi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "to mond ruoth kod mon mamoko konene to pake.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Osiepe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma to en ngʼa mabiro apoya ka piny madwa ru?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:10"
      },
      "items": [
        {
          "text": "Adier, ober ka dwe kendo ongʼangʼni ka wangʼ chiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:10"
      },
      "items": [
        {
          "text": "bende ochanore ka sulwe moriedo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Wuowi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne alor mwalo nyaka e puoth mananas,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:11"
      },
      "items": [
        {
          "text": "mondo ane kaka gidongo e holo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:11"
      },
      "items": [
        {
          "text": "kendo mondo ane ka mzabibu osechako golo maua",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:11"
      },
      "items": [
        {
          "text": "kata ka olemo mongʼinore osechako chiek makwar.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apoya nono, kapok angʼeyo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.12",
            "verseOrgIds": [
              "SNG.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:12"
      },
      "items": [
        {
          "text": "gombona notingʼa motera nyaka dier geche joka ruoth.",
          "type": "text",
          "attrs": {
