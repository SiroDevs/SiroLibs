  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "SNG 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wer mamit moloyo wende moko nondiki gi ruoth Solomon.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.1",
            "verseOrgIds": [
              "SNG.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Nyako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi mondo inyodha gi dhogi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.2",
            "verseOrgIds": [
              "SNG.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:2"
      },
      "items": [
        {
          "text": "nikech herani kelo mor moloyo divai.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.2",
            "verseOrgIds": [
              "SNG.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Modhi miwirorigo dungʼ mamit;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.3",
            "verseOrgIds": [
              "SNG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:3"
      },
      "items": [
        {
          "text": "kendo nyingi chalo gi mo mangʼwe ngʼar ma pukore oko.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.3",
            "verseOrgIds": [
              "SNG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:3"
      },
      "items": [
        {
          "text": "Kare mano emomiyo nyiri duto oheri!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.3",
            "verseOrgIds": [
              "SNG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kawa idhi koda, waret piyo waa kae!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "Ruoth mondo odhi koda nyaka ei ode maiye.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "Osiepe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "Wail kendo chunywa mor kodi;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "wabiro pako herani moloyo divai.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "Nyako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "Gitimo gima kare ka gipuoyi!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "An nyako ma dichol kendo ma jaber,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:5"
      },
      "items": [
        {
          "text": "yaye nyi Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:5"
      },
      "items": [
        {
          "text": "an dichol mana ka hembe mag Kedar,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:5"
      },
      "items": [
        {
          "text": "kendo mana ka pasia molier e hembe Solomon.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik uchaya nikech an dichol,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:6"
      },
      "items": [
        {
          "text": "nimar chiengʼ ema oseloko denda kamano.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:6"
      },
      "items": [
        {
          "text": "Yawuot minwa nokecho koda,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:6"
      },
      "items": [
        {
          "text": "mine giketa jarit puothegi mag mzabibu;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:6"
      },
      "items": [
        {
          "text": "to puotha awuon mar mzabibu to ne ajwangʼo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye jaherana, nyisane kuma ikwayoe jambi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:7"
      },
      "items": [
        {
          "text": "kod kuma iweye rombi mondo oyweyee odiechiengʼ tir.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:7"
      },
      "items": [
        {
          "text": "Angʼo momiyo dachal mana gi dhako moumo wangʼe",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:7"
      },
      "items": [
        {
          "text": "e dier jamb osiepeni?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Osiepe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ok ingʼeyo, yaye jaber moloyo mon mamoko,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:8"
      },
      "items": [
        {
          "text": "lu bangʼ rombe kuonde ma gikwayoe,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:8"
      },
      "items": [
        {
          "text": "mondo ikwa nyidiek ma pod tindo",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:8"
      },
      "items": [
        {
          "text": "e bath hembe mag jokwath.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Wuowi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaherana, apimi mana gi faras madhako",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.9",
            "verseOrgIds": [
              "SNG.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:9"
      },
      "items": [
        {
          "text": "motwe but achiel kuom geche Farao.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.9",
            "verseOrgIds": [
              "SNG.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lembi nenore maber ka sitadi olierie;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.10",
            "verseOrgIds": [
              "SNG.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:10"
      },
      "items": [
        {
          "text": "ngʼuti bende nenore maber ka olierie tigo ma nengogi tek.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.10",
            "verseOrgIds": [
              "SNG.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabiro losoni thiwni mag dhahabu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.11",
            "verseOrgIds": [
              "SNG.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:11"
      },
      "items": [
        {
          "text": "kod tigo mag fedha.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.11",
            "verseOrgIds": [
              "SNG.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Nyako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane ruoth chiemo e mesane,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.12",
            "verseOrgIds": [
              "SNG.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:12"
      },
      "items": [
        {
          "text": "mo mangʼwe ngʼar man-gi tik mamit nopongʼo ot kadonjo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.12",
            "verseOrgIds": [
              "SNG.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaherana chalona gi mo mane-mane mobo matin ma nengone tek,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.13",
            "verseOrgIds": [
              "SNG.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:13"
      },
      "items": [
        {
