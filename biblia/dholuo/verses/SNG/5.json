  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "SNG 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Wuowi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asebiro e puotha, yaye jaherana;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "asechoko ubani gi modhi madungʼ tik mangʼwe ngʼar,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "asechamo pednina kaachiel kod mor kich mara;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "kendo asemadho divaina kod chak.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "Osiepe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "Yaye osiepena, chiemuru kendo methuru;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "yaye joherana, methuru ma romu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Nyako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne anindo, to chunya ne neno.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "Lingʼ uwinji! Jaherana dwongʼo kowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "\"Yaye jaherana, yawna kendo winja maber,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "yaye jaherana mamuol mana ka akuru.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "Tho opongʼo wiya,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "kendo yie wiya opongʼ gi ngʼich mar otieno.\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aselonyo lepa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:3"
      },
      "items": [
        {
          "text": "koro idwaro ni achak arwakra kendo?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:3"
      },
      "items": [
        {
          "text": "Aselwoko tienda,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:3"
      },
      "items": [
        {
          "text": "koro idwaro ni achak anyon lowo kendo?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaherana nosoyo lwete e otuchi mar dhoot;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.4",
            "verseOrgIds": [
              "SNG.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:4"
      },
      "items": [
        {
          "text": "chunya nochako gwecho ka dware.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.4",
            "verseOrgIds": [
              "SNG.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne aa malo mondo ayawne jaherana,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "kendo lwetena ne ton mo mangʼwe ngʼar ma nengone tek.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "Morno ma nengone tek mane ni e lith lweta nomieno",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "pata mar dhoot.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ayawone jaherana,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "mi ayudo ka jaherana osewuok kendo osea!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "Chunya norumo kane odhi oyomba.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "Ne amanye, to ne ok ayude.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "Ne aluonge, to ne ok odwoka.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jorito noromo koda",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "kane giwuotho gotieno e alwora mar dala.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "Ne gigoya marach ma gihinya;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "kendo jorito marichogo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "ne omaya lawa!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amiyou chik, un nyi Jerusalem",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "ni ka uyudo jaherana,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "to ubiro nyise nangʼo?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "Nyiseuru ni hera ma aherego odwaro nega?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Osiepe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere kaka jaherani oloyo chwo mamoko,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:9"
      },
      "items": [
        {
          "text": "yaye jaber mogik e dier nyiri mabeyo duto?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:9"
      },
      "items": [
        {
          "text": "Ere kaka jaherani oloyo chwo mamoko,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:9"
      },
      "items": [
        {
          "text": "momiyo imiyowa chik ma kamano?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Nyako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaherana rieny kendo rapudo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.10",
            "verseOrgIds": [
