        {
          "text": "Zaburi 113",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 113:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opak Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.1",
            "verseOrgIds": [
              "PSA.113.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 113:1"
      },
      "items": [
        {
          "text": "Pakuru Jehova Nyasaye, yaye un jotichne,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.1",
            "verseOrgIds": [
              "PSA.113.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:1"
      },
      "items": [
        {
          "text": "pakuru nying Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.1",
            "verseOrgIds": [
              "PSA.113.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 113:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nying Jehova Nyasaye mondo opaki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.2",
            "verseOrgIds": [
              "PSA.113.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:2"
      },
      "items": [
        {
          "text": "sani kendo nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.2",
            "verseOrgIds": [
              "PSA.113.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 113:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nying Jehova Nyasaye onego opaki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.3",
            "verseOrgIds": [
              "PSA.113.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:3"
      },
      "items": [
        {
          "text": "chakre kuma chiengʼ wuokie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.3",
            "verseOrgIds": [
              "PSA.113.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:3"
      },
      "items": [
        {
          "text": "nyaka kuma opodhoe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.3",
            "verseOrgIds": [
              "PSA.113.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 113:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nigi duongʼ moyombo ogendini duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.4",
            "verseOrgIds": [
              "PSA.113.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:4"
      },
      "items": [
        {
          "text": "kendo duongʼne maler oyombo polo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.4",
            "verseOrgIds": [
              "PSA.113.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 113:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ngʼa machalo gi Jehova Nyasaye ma Nyasachwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.5",
            "verseOrgIds": [
              "PSA.113.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:5"
      },
      "items": [
        {
          "text": "Jal mobet e kom loch kuma bor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.5",
            "verseOrgIds": [
              "PSA.113.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 113:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo makulore piny",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.6",
            "verseOrgIds": [
              "PSA.113.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:6"
      },
      "items": [
        {
          "text": "mondo ongʼi polo gi piny?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.6",
            "verseOrgIds": [
              "PSA.113.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 113:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otingʼo joma odhier malo kogolo piny e lowo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.7",
            "verseOrgIds": [
              "PSA.113.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:7"
      },
      "items": [
        {
          "text": "adier, ogolo joma ochando e pidh buru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.7",
            "verseOrgIds": [
              "PSA.113.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 113:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo oketogi gibet kaachiel gi ruodhi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.8",
            "verseOrgIds": [
              "PSA.113.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:8"
      },
      "items": [
        {
          "text": "mi kwan-gi kaachiel gi jotend jogi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.8",
            "verseOrgIds": [
              "PSA.113.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 113:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo dhako ma migumba bedo gi ode",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.9",
            "verseOrgIds": [
              "PSA.113.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:9"
      },
      "items": [
        {
          "text": "mi obed miyo mamor man-gi nyithinde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.9",
            "verseOrgIds": [
              "PSA.113.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 113:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 113:9"
      },
      "items": [
        {
          "text": "Opak Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.9",
            "verseOrgIds": [
              "PSA.113.9"
            ]
          }
        }
      ]
    }
  ],
