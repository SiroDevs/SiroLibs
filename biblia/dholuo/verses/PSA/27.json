  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "PSA 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye e lerna kendo e warruokna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:1"
      },
      "items": [
        {
          "text": "en ngʼa ma daluor?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:1"
      },
      "items": [
        {
          "text": "Jehova Nyasaye e kama ngimana opondoe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:1"
      },
      "items": [
        {
          "text": "En ngʼa ma dibwoga?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka joma richo lawa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:2"
      },
      "items": [
        {
          "text": "mondo oketh ngimana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:2"
      },
      "items": [
        {
          "text": "ka wasika kod joma kedo koda monja,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:2"
      },
      "items": [
        {
          "text": "to gibiro kier mi gipodhi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata ka jolweny ogoyona agengʼa koni gi koni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "to chunya ok bi luor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "kata ka lweny otugorena,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "to pod abiro mana bedo gi chir.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gimoro achiel kende ema akwayo Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "ma e gima adwaro moloyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "ni mondo adag e od Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "ndalo duto mag ngimana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "mondo achom wangʼa kuom ber mar Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "kendo amanye e hekalu mare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech chiengʼ ma chandruok omaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:5"
      },
      "items": [
        {
          "text": "obiro panda maber e kar dakne;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:5"
      },
      "items": [
        {
          "text": "obiro panda e kar pondo mar hembe maler",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:5"
      },
      "items": [
        {
          "text": "kendo obiro keta malo ewi lwanda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka abiro bedo jaloch",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "ka aloyo wasigu duto molwora;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "abiro timo misango mar pak ka akok gimor e hembe maler.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "Abiro wer kendo abiro loso wende mamit ne Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winj dwonda ka aluongo, yaye Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.7",
            "verseOrgIds": [
              "PSA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:7"
      },
      "items": [
        {
          "text": "kecha kendo idwoka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.7",
            "verseOrgIds": [
              "PSA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunya wuoyo kuomi kawacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.8",
            "verseOrgIds": [
              "PSA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:8"
      },
      "items": [
        {
          "text": "\"Many wangʼ Nyasaye ka ilemo!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.8",
            "verseOrgIds": [
              "PSA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:8"
      },
      "items": [
        {
          "text": "Wangʼi, yaye Jehova Nyasaye, ema abiro manyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.8",
            "verseOrgIds": [
              "PSA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik ipandna wangʼi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:9"
      },
      "items": [
        {
          "text": "kik iriemb jatichni ka mirima omaki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:9"
      },
      "items": [
        {
          "text": "in ema isebedo jakonyna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:9"
      },
      "items": [
        {
          "text": "Kik ikweda bende kik ijwangʼa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:9"
      },
      "items": [
        {
          "text": "yaye Nyasaye Jawarna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata obedo ni wuonwa gi minwa ojwangʼa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.10",
            "verseOrgIds": [
              "PSA.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:10"
      },
      "items": [
        {
          "text": "to Jehova Nyasaye biro rwaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.10",
            "verseOrgIds": [
              "PSA.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puonja yoreni, yaye Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.11",
            "verseOrgIds": [
              "PSA.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:11"
      },
      "items": [
        {
          "text": "telna e yo moriere tir,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.11",
            "verseOrgIds": [
              "PSA.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:11"
      },
      "items": [
        {
          "text": "nikech joma sanda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.11",
            "verseOrgIds": [
              "PSA.27.11"
            ]
          }
        }
      ]
    },
