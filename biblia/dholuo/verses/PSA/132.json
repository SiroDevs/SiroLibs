  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "132",
        "style": "c",
        "sid": "PSA 132"
      },
      "items": [
        {
          "text": "132",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 132",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Wer ma ji wero kadhi e hekalu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 132:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Parie Daudi, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.1",
            "verseOrgIds": [
              "PSA.132.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:1"
      },
      "items": [
        {
          "text": "parie Daudi gi chandruok duto moseneno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.1",
            "verseOrgIds": [
              "PSA.132.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 132:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne okwongʼore kane osingore ne Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.2",
            "verseOrgIds": [
              "PSA.132.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:2"
      },
      "items": [
        {
          "text": "kendo ne okwongʼore ne Nyasaye Maratego mar Jakobo kama:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.2",
            "verseOrgIds": [
              "PSA.132.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 132:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ok anadonji e oda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.3",
            "verseOrgIds": [
              "PSA.132.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:3"
      },
      "items": [
        {
          "text": "kata dhi e kitandana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.3",
            "verseOrgIds": [
              "PSA.132.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 132:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok anayie nindo tera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.4",
            "verseOrgIds": [
              "PSA.132.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:4"
      },
      "items": [
        {
          "text": "kata ayula wangʼ lo wengena,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.4",
            "verseOrgIds": [
              "PSA.132.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 132:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kapok aloso ne Jehova Nyasaye kare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.5",
            "verseOrgIds": [
              "PSA.132.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:5"
      },
      "items": [
        {
          "text": "kapok ayudo ne Nyasaye Maratego mar Jakobo kar dak.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.5",
            "verseOrgIds": [
              "PSA.132.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 132:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne wawinjo wachno Efratha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.6",
            "verseOrgIds": [
              "PSA.132.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:6"
      },
      "items": [
        {
          "text": "ee, ne wayude e puothe mag Jaar:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.6",
            "verseOrgIds": [
              "PSA.132.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 132:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wadhiuru kare modakie;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.7",
            "verseOrgIds": [
              "PSA.132.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:7"
      },
      "items": [
        {
          "text": "wadhiuru mondo walame e nyim kom duongʼne, ka wawacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.7",
            "verseOrgIds": [
              "PSA.132.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 132:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Aa malo, yaye Jehova Nyasaye, aa malo ibi kari mar yweyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.8",
            "verseOrgIds": [
              "PSA.132.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:8"
      },
      "items": [
        {
          "text": "in kaachiel gi Sandug Muma ma en kido mar tekoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.8",
            "verseOrgIds": [
              "PSA.132.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 132:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad jodolo magi rwakre gi tim makare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.9",
            "verseOrgIds": [
              "PSA.132.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:9"
      },
      "items": [
        {
          "text": "kendo mad jogi maler wer gi mor.' \"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.9",
            "verseOrgIds": [
              "PSA.132.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 132:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech Daudi jatichni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.10",
            "verseOrgIds": [
              "PSA.132.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:10"
      },
      "items": [
        {
          "text": "kik idagi ngʼati miseyiero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.10",
            "verseOrgIds": [
              "PSA.132.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 132:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nokwongʼore kendo osingore ne Daudi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:11"
      },
      "items": [
        {
          "text": "kendo ne en kwongʼruok ma ok enoloki ngangʼ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 132:11"
      },
      "items": [
        {
          "text": "nokwongʼorene niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:11"
      },
      "items": [
        {
          "text": "\"Abiro keto achiel kuom kothi e lochni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 132:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka yawuoti orito singruokna",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:12"
      },
      "items": [
        {
          "text": "kod chike ma apuonjogi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 132:12"
      },
      "items": [
        {
          "text": "eka yawuotgi nobedi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:12"
      },
      "items": [
        {
          "text": "e lochni nyaka chiengʼ kendo nyaka chiengʼ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 132:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar Jehova Nyasaye oseyiero Sayun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.13",
            "verseOrgIds": [
              "PSA.132.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:13"
      },
      "items": [
        {
          "text": "osehere kaka kar dakne, osewacho ni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.13",
            "verseOrgIds": [
              "PSA.132.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 132:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e kar yweyona mochwere manyaka chiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.14",
            "verseOrgIds": [
              "PSA.132.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:14"
      },
      "items": [
        {
          "text": "kae ema abiro betie kom lochna, nimar asehere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.14",
            "verseOrgIds": [
              "PSA.132.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 132:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "abiro gwedhe gi gik moko mogundho,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.15",
            "verseOrgIds": [
              "PSA.132.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:15"
      },
      "items": [
        {
          "text": "kendo joge modhier abiro romo gi chiemo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.15",
            "verseOrgIds": [
              "PSA.132.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 132:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro rwako jodolo mage gi warruok",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.16",
            "verseOrgIds": [
              "PSA.132.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:16"
      },
      "items": [
        {
          "text": "kendo jomaler modak e iye biro siko ka wero wende mor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.16",
            "verseOrgIds": [
              "PSA.132.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
