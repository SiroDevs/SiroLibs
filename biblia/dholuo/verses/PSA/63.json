  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "63",
        "style": "c",
        "sid": "PSA 63"
      },
      "items": [
        {
          "text": "63",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 63",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi mar Daudi kane en e thim mar Juda.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 63:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Nyasaye, in e Nyasacha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "adwari gi tekra duto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "chunya riyo oloyo mar neni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "kendo denda duto dwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "e piny motwo kendo maliet,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "maonge pi modho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 63:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aseneni ei kari maler",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.2",
            "verseOrgIds": [
              "PSA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:2"
      },
      "items": [
        {
          "text": "kendo asengʼeyo tekoni gi duongʼni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.2",
            "verseOrgIds": [
              "PSA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 63:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech herani ber moloyo ngima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.3",
            "verseOrgIds": [
              "PSA.63.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:3"
      },
      "items": [
        {
          "text": "dhoga biro miyi duongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.3",
            "verseOrgIds": [
              "PSA.63.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 63:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro paki kapod angima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.4",
            "verseOrgIds": [
              "PSA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:4"
      },
      "items": [
        {
          "text": "kendo abiro tingʼo bedena malo e nyingi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.4",
            "verseOrgIds": [
              "PSA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 63:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunya biro romo mana ka ngʼama oromo gi chiemo mabeyo mogik;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.5",
            "verseOrgIds": [
              "PSA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:5"
      },
      "items": [
        {
          "text": "abiro yawo dwonda ka apaki gi wer.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.5",
            "verseOrgIds": [
              "PSA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 63:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka an e kitandana to apari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.6",
            "verseOrgIds": [
              "PSA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:6"
      },
      "items": [
        {
          "text": "pacha osiko pari seche duto mag otieno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.6",
            "verseOrgIds": [
              "PSA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 63:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech in e konyruokna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.7",
            "verseOrgIds": [
              "PSA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:7"
      },
      "items": [
        {
          "text": "awer ka an e bwo tipo mar bwombeni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.7",
            "verseOrgIds": [
              "PSA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 63:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunya omoko kuomi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.8",
            "verseOrgIds": [
              "PSA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:8"
      },
      "items": [
        {
          "text": "lweti ma korachwich orita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.8",
            "verseOrgIds": [
              "PSA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 63:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma dwaro kawo ngimana ibiro tieki;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.9",
            "verseOrgIds": [
              "PSA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:9"
      },
      "items": [
        {
          "text": "gibiro dhi piny nyaka ei bur kama tut.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.9",
            "verseOrgIds": [
              "PSA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 63:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibiro chiwgi ne ligangla",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.10",
            "verseOrgIds": [
              "PSA.63.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:10"
      },
      "items": [
        {
          "text": "kendo gibiro doko chiemb ondiegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.10",
            "verseOrgIds": [
              "PSA.63.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 63:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ruoth to biro bedo moil kuom Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.11",
            "verseOrgIds": [
              "PSA.63.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:11"
      },
      "items": [
        {
          "text": "ji duto masingore e nying Nyasaye biro pake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.11",
            "verseOrgIds": [
              "PSA.63.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:11"
      },
      "items": [
        {
          "text": "to dho jo-miriambo ibiro um mi lingʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.11",
            "verseOrgIds": [
              "PSA.63.12"
            ]
          }
        }
      ]
    }
  ],
