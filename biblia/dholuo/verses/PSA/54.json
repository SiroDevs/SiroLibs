  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "54",
        "style": "c",
        "sid": "PSA 54"
      },
      "items": [
        {
          "text": "54",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 54",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. Wer miwero gi thumbe man-gi waya.",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Maskil",
              "type": "text"
            }
          ]
        },
        {
          "text": "mar Daudi. Kane jo-Zif osedhi ir Saulo kendo onyise niya, \"Donge Daudi ma imanyo opondo e gwengʼwa?\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 54:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Resa gi nyingi, yaye Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.1",
            "verseOrgIds": [
              "PSA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:1"
      },
      "items": [
        {
          "text": "ngʼadna bura kare gi tekoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.1",
            "verseOrgIds": [
              "PSA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 54:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winj lamona, yaye Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.2",
            "verseOrgIds": [
              "PSA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:2"
      },
      "items": [
        {
          "text": "chik iti ne weche mawuok e dhoga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.2",
            "verseOrgIds": [
              "PSA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 54:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jopinje moko monja;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:3"
      },
      "items": [
        {
          "text": "acheje kawo ngimana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:3"
      },
      "items": [
        {
          "text": "gin joma ok dew Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.54.3",
                "verseOrgIds": [
                  "PSA.54.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 54:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adier, Nyasaye e jakonyna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.4",
            "verseOrgIds": [
              "PSA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:4"
      },
      "items": [
        {
          "text": "Ruoth owuon ema rita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.4",
            "verseOrgIds": [
              "PSA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 54:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad chandruok lwor joma ketho nyinga mi ketgi diere;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.5",
            "verseOrgIds": [
              "PSA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:5"
      },
      "items": [
        {
          "text": "tiekgi, nikech in ja-adiera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.5",
            "verseOrgIds": [
              "PSA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 54:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro timoni misango gi chiwo mar hera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.6",
            "verseOrgIds": [
              "PSA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:6"
      },
      "items": [
        {
          "text": "abiro pako nyingi, yaye Jehova Nyasaye, nikech nyingi ber.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.6",
            "verseOrgIds": [
              "PSA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 54:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech oseresa kuom gik mathaga duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.7",
            "verseOrgIds": [
              "PSA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:7"
      },
      "items": [
        {
          "text": "mi omiyo wengena ongʼiyo wasika tir bangʼ loyogi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.7",
            "verseOrgIds": [
              "PSA.54.9"
            ]
          }
        }
      ]
    }
  ],
