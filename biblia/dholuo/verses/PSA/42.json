            "id": "PSA.42-PSA.72"
          },
          "items": [
            {
              "text": "Zaburi 42–72",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer.",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Maskil",
              "type": "text"
            }
          ]
        },
        {
          "text": "mar yawuot Kora.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka mwanda gamo yweyo kamanyo kuonde ma pi nitie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.1",
            "verseOrgIds": [
              "PSA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:1"
      },
      "items": [
        {
          "text": "e kaka chunya dwari, yaye Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.1",
            "verseOrgIds": [
              "PSA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunya riyo oloyo mar dwaro Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.2",
            "verseOrgIds": [
              "PSA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:2"
      },
      "items": [
        {
          "text": "En riyo mar dwaro Nyasaye mangima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.2",
            "verseOrgIds": [
              "PSA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:2"
      },
      "items": [
        {
          "text": "Abiro dhi romo kod Nyasaye karangʼo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.2",
            "verseOrgIds": [
              "PSA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aseywak mi pi wangʼa osechalo chiemba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "odiechiengʼ gotieno,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "ka ji to wachona odiechiengʼ duto niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "\"Koro ere Nyasachino?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aparo gigi duto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "ka chunya opongʼ giywak:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "aparo kaka ne adhi gi oganda maduongʼ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "ka atelo ni ji madhi e od Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "Ka akok gimor kendo agoyo erokamano",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "E dier oganda maduongʼ matimo nyasi gi mor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angʼo momiyo ikuyo, yaye chunya?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "Angʼo momiyo inyosori yaye chunya?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "Ket genoni kuom Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "nikech pod abiro pake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "kaka Jawarna kendo Nyasacha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunya lit;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "omiyo abiro pari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "ka an e piny mar Jordan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "gi kuonde motingʼore mar Hermon kod e got Mizar.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kut luongore gi kut",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "ei abururu mar pi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "apaka magi duto gi ahiti mager",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "oseywera motera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye chiko herane godiechiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:8"
      },
      "items": [
        {
          "text": "to gotieno to wende ni e chunya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:8"
      },
      "items": [
        {
          "text": "ma e lamo ma alamogo Nyasach ngimana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awacho ni Nyasaye ma lwandana niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "\"Angʼo momiyo wiyi osewil koda?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "Angʼo momiyo asiko gi kuyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "ka jawasigu sanda?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chokena tho omako kendo rama malit",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:10"
      },
      "items": [
        {
          "text": "seche ma joma kedo koda yanya kochaya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:10"
      },
      "items": [
        {
          "text": "ka giwachona odiechiengʼ duto niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:10"
      },
      "items": [
        {
          "text": "\"Koro ere Nyasachino?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
