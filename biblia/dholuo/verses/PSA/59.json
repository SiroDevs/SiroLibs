  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "59",
        "style": "c",
        "sid": "PSA 59"
      },
      "items": [
        {
          "text": "59",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 59",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. E dwol mar \"Kik iketh gik moko.\"",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Miktam",
              "type": "text"
            }
          ]
        },
        {
          "text": "mar Daudi. Kane Saulo ooro ji mondo ocher od Daudi mondo onege.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 59:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Resa e lwet wasika, yaye Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.1",
            "verseOrgIds": [
              "PSA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:1"
      },
      "items": [
        {
          "text": "Rit ngimana kuom joma ogar koda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.1",
            "verseOrgIds": [
              "PSA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 59:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gola e lwet joma timo gik maricho",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.2",
            "verseOrgIds": [
              "PSA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:2"
      },
      "items": [
        {
          "text": "kendo resa kuom joma riyo mar chwero remo omako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.2",
            "verseOrgIds": [
              "PSA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 59:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neye kaka gibutona ka girita e yo!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:3"
      },
      "items": [
        {
          "text": "Joma kwiny chano kaka digihinya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:3"
      },
      "items": [
        {
          "text": "to an onge gima rach kata richo masetimo, yaye Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 59:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onge gima asetimo marach,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.4",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:4"
      },
      "items": [
        {
          "text": "to kata kamano gin to giikore monja.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.4",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:4"
      },
      "items": [
        {
          "text": "Aa malo ikonya; ne chandruokna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.4",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 59:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, ma Nyasaye Maratego,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:5"
      },
      "items": [
        {
          "text": "in Nyasach Israel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:5"
      },
      "items": [
        {
          "text": "aa malo ikum ogendini duto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:5"
      },
      "items": [
        {
          "text": "kik ikech andhoke ma timbegi richo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.59.5",
                "verseOrgIds": [
                  "PSA.59.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 59:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidwogo ka piny imore,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:6"
      },
      "items": [
        {
          "text": "ka gingʼur ka guogi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:6"
      },
      "items": [
        {
          "text": "kendo giwuotho koni gi koni e dala ka gingʼanjo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 59:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neye gik ma gingʼudho koa e dhogi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:7"
      },
      "items": [
        {
          "text": "gingʼudho ligengni gi dhogi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:7"
      },
      "items": [
        {
          "text": "kendo giwacho niya, \"En ngʼa manyalo winjowa?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 59:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "To in nyiergi, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.8",
            "verseOrgIds": [
              "PSA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:8"
      },
      "items": [
        {
          "text": "go siboi ne ogendinigo duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.8",
            "verseOrgIds": [
              "PSA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 59:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye tekona, in ema angʼiyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.9",
            "verseOrgIds": [
              "PSA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:9"
      },
      "items": [
        {
          "text": "in e kar pondona, yaye Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.9",
            "verseOrgIds": [
              "PSA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 59:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Nyasacha ma jahera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 59:10"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:10"
      },
      "items": [
        {
          "text": "Nyasaye biro telona",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:10"
      },
      "items": [
        {
          "text": "kendo obiro miyo asungra ne joma ketho nyinga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 59:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kik uneg-gi, yaye Ruoth ma okumbana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:11"
      },
      "items": [
        {
          "text": "nikech joga dipoka wigi owil.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:11"
      },
      "items": [
        {
          "text": "Mi giba abaya koni gi koni gi tekoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:11"
      },
      "items": [
        {
          "text": "kendo mi gidog piny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 59:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech richo ma gitimo gi dhogi kuom wuoyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:12"
      },
      "items": [
        {
          "text": "nikech weche mawuok e dhogi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:12"
      },
      "items": [
        {
          "text": "wegi mondo sungagi ogajgi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:12"
      },
      "items": [
        {
          "text": "Nikech gikwongʼo ji kendo gi wuondo ji,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 59:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "tiekgi gi mirimbi mager,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.13",
            "verseOrgIds": [
              "PSA.59.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:13"
      },
      "items": [
        {
          "text": "tiekgi mi kargi lal nono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.13",
            "verseOrgIds": [
              "PSA.59.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:13"
      },
      "items": [
        {
