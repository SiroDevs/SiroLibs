        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiwoni chunya, yaye Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.1",
            "verseOrgIds": [
              "PSA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "In ema aketo genona kuomi, yaye Nyasacha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 25:2"
      },
      "items": [
        {
          "text": "Kik iwe ane wichkuot,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:2"
      },
      "items": [
        {
          "text": "bende kik iwe wasika loya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onge ngʼama oketo genone kuomi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:3"
      },
      "items": [
        {
          "text": "manyalo neno wichkuot,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 25:3"
      },
      "items": [
        {
          "text": "to joma timo timbe maricho",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:3"
      },
      "items": [
        {
          "text": "ema biro neno wichkuot.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyisa yoreni, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.4",
            "verseOrgIds": [
              "PSA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:4"
      },
      "items": [
        {
          "text": "puonja mondo aluwgi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.4",
            "verseOrgIds": [
              "PSA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "telna gi adierani, kendo puonja,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:5"
      },
      "items": [
        {
          "text": "nikech in Nyasaye ma Jawarna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:5"
      },
      "items": [
        {
          "text": "kendo genona ni kuomi odiechiengʼ duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Par kechni maduongʼ gi herani, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.6",
            "verseOrgIds": [
              "PSA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:6"
      },
      "items": [
        {
          "text": "nikech gisebedo ka gintie nyaka aa chon.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.6",
            "verseOrgIds": [
              "PSA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik ipar richo mane atimo kapod an rawere",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:7"
      },
      "items": [
        {
          "text": "kod yorena mobam;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 25:7"
      },
      "items": [
        {
          "text": "para kaluwore gi herani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:7"
      },
      "items": [
        {
          "text": "nikech iber, yaye Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye ber kendo yorene oriere tir;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.8",
            "verseOrgIds": [
              "PSA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:8"
      },
      "items": [
        {
          "text": "mano emomiyo opuonjo joricho yorene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.8",
            "verseOrgIds": [
              "PSA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otelo ni joma muol kuom gima nikare",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.9",
            "verseOrgIds": [
              "PSA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:9"
      },
      "items": [
        {
          "text": "kendo opuonjogi yore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.9",
            "verseOrgIds": [
              "PSA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yore duto mag Jehova Nyasaye opongʼ gihera kod adiera",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.10",
            "verseOrgIds": [
              "PSA.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:10"
      },
      "items": [
        {
          "text": "ni joma rito gik moko duto ma singruokne dwaro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.10",
            "verseOrgIds": [
              "PSA.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena richona nikech nyingi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.11",
            "verseOrgIds": [
              "PSA.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:11"
      },
      "items": [
        {
          "text": "kata obedo ni richona duongʼ ahinya, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.11",
            "verseOrgIds": [
              "PSA.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro ere ngʼat ma oluoro Jehova Nyasaye?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.12",
            "verseOrgIds": [
              "PSA.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:12"
      },
      "items": [
        {
          "text": "Obiro puonje luwo yo moyierne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.12",
            "verseOrgIds": [
              "PSA.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obiro dak e ngima momew,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.13",
            "verseOrgIds": [
              "PSA.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:13"
      },
      "items": [
        {
          "text": "kendo nyikwaye nokaw piny kaka girkeni margi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.13",
            "verseOrgIds": [
              "PSA.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye en osiep joma miye luor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.14",
            "verseOrgIds": [
              "PSA.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:14"
      },
      "items": [
        {
          "text": "omiyo gingʼeyo singruok mage.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.14",
            "verseOrgIds": [
              "PSA.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achomo wangʼa kuom Jehova Nyasaye ndalo duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.15",
            "verseOrgIds": [
              "PSA.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:15"
      },
      "items": [
        {
          "text": "nikech en kende ema obiro golo tiendena mobadho omako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.15",
            "verseOrgIds": [
              "PSA.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duog ira kendo bedna mangʼwon,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.16",
            "verseOrgIds": [
              "PSA.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:16"
      },
      "items": [
        {
          "text": "nikech adongʼ kenda kendo an gi kuyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.16",
            "verseOrgIds": [
              "PSA.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 25:17"
          },
