  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "PSA 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwneuru Jehova Nyasaye, yaye un malaike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.1",
            "verseOrgIds": [
              "PSA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:1"
      },
      "items": [
        {
          "text": "chiwneuru Jehova Nyasaye duongʼ kod teko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.1",
            "verseOrgIds": [
              "PSA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwneuru Jehova Nyasaye duongʼ mowinjore gi nyinge;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.2",
            "verseOrgIds": [
              "PSA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:2"
      },
      "items": [
        {
          "text": "lamuru Jehova Nyasaye e dier lerne maduongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.2",
            "verseOrgIds": [
              "PSA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwond Jehova Nyasaye mor ewi pige;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:3"
      },
      "items": [
        {
          "text": "Nyasaye mar duongʼ mor ka polo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:3"
      },
      "items": [
        {
          "text": "Jehova Nyasaye mor ewi pige madongo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwond Jehova Nyasaye nigi teko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.4",
            "verseOrgIds": [
              "PSA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:4"
      },
      "items": [
        {
          "text": "dwond Jehova Nyasaye nigi duongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.4",
            "verseOrgIds": [
              "PSA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwond Jehova Nyasaye muko yiende mag sida,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.5",
            "verseOrgIds": [
              "PSA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:5"
      },
      "items": [
        {
          "text": "Jehova Nyasaye turo yiende sida mag Lebanon matindo tindo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.5",
            "verseOrgIds": [
              "PSA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Lebanon chikore ka nyaroya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.6",
            "verseOrgIds": [
              "PSA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:6"
      },
      "items": [
        {
          "text": "Sirion lengʼore ka jowi ma pod tin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.6",
            "verseOrgIds": [
              "PSA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwond Jehova Nyasaye mor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.7",
            "verseOrgIds": [
              "PSA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:7"
      },
      "items": [
        {
          "text": "omor ka mil polo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.7",
            "verseOrgIds": [
              "PSA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwond Jehova Nyasaye yiengo piny motimo ongoro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.8",
            "verseOrgIds": [
              "PSA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:8"
      },
      "items": [
        {
          "text": "Jehova Nyasaye yiengo ongoro mar Kadesh.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.8",
            "verseOrgIds": [
              "PSA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwond Jehova Nyasaye ma dolo yiend bungu miyo mwanda nywol",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.9",
            "verseOrgIds": [
              "PSA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:9"
      },
      "items": [
        {
          "text": "kendo omiyo yiend bungu dongʼ kolwerore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.9",
            "verseOrgIds": [
              "PSA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 29:9"
      },
      "items": [
        {
          "text": "Ji duto kok ei hekalu mare kagiwacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.9",
            "verseOrgIds": [
              "PSA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:9"
      },
      "items": [
        {
          "text": "\"Duongʼ odog ni Jehova Nyasaye!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.9",
            "verseOrgIds": [
              "PSA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye obet e kom loch mare ewi ataro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.10",
            "verseOrgIds": [
              "PSA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:10"
      },
      "items": [
        {
          "text": "Jehova Nyasaye obet e kom loch kaka Ruoth nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.10",
            "verseOrgIds": [
              "PSA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye miyo joge teko;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.11",
            "verseOrgIds": [
              "PSA.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:11"
      },
      "items": [
        {
          "text": "Jehova Nyasaye gwedho joge gi kwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.11",
            "verseOrgIds": [
              "PSA.29.11"
            ]
          }
        }
      ]
    }
  ],
