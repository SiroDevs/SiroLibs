          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tingʼuru bedeu malo e kare maler mar lemo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.134.2",
            "verseOrgIds": [
              "PSA.134.2"
            ]
