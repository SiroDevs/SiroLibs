      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 134:2"
      },
      "items": [
        {
          "text": "kendo upak Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.134.2",
            "verseOrgIds": [
              "PSA.134.2"
            ]
          }
        }
