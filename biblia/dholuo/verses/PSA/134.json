          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad Jehova Nyasaye ma jachwech polo gi piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.134.3",
            "verseOrgIds": [
              "PSA.134.3"
            ]
