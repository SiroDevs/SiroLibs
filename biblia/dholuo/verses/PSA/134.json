      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 134:1"
      },
      "items": [
        {
          "text": "kendo matiyo gotieno e od Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.134.1",
            "verseOrgIds": [
              "PSA.134.1"
            ]
          }
        }
      ]
    },
    {
