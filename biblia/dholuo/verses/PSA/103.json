            "sid": "PSA 103:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pak Jehova Nyasaye, yaye chunya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.1",
            "verseOrgIds": [
              "PSA.103.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:1"
      },
      "items": [
        {
          "text": "chunya maiye duto mondo opak nyinge maler.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.1",
            "verseOrgIds": [
              "PSA.103.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 103:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pak Jehova Nyasaye, yaye chunya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.2",
            "verseOrgIds": [
              "PSA.103.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:2"
      },
      "items": [
        {
          "text": "kendo kik wiyi wil gi konyruok mochiwo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.2",
            "verseOrgIds": [
              "PSA.103.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 103:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "en ema oweyoni richoni duto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.3",
            "verseOrgIds": [
              "PSA.103.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:3"
      },
      "items": [
        {
          "text": "kendo ochango tuocheni duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.3",
            "verseOrgIds": [
              "PSA.103.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 103:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "oreso ngimani kogolo e bur matut",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.4",
            "verseOrgIds": [
              "PSA.103.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:4"
      },
      "items": [
        {
          "text": "kendo osidhi gihera kod kech,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.4",
            "verseOrgIds": [
              "PSA.103.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 103:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "oromo chunyi gi gik mabeyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.5",
            "verseOrgIds": [
              "PSA.103.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:5"
      },
      "items": [
        {
          "text": "momiyo tin-ni osiko nyien ka mar ongo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.5",
            "verseOrgIds": [
              "PSA.103.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 103:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye timo gik makare",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.6",
            "verseOrgIds": [
              "PSA.103.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:6"
      },
      "items": [
        {
          "text": "kendo otimo maber ne joma isando duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.6",
            "verseOrgIds": [
              "PSA.103.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 103:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonyiso Musa timbe mane ochano timo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.7",
            "verseOrgIds": [
              "PSA.103.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:7"
      },
      "items": [
        {
          "text": "nomiyo jo-Israel oneno timbene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.7",
            "verseOrgIds": [
              "PSA.103.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 103:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye kecho ji kendo ongʼwon,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.8",
            "verseOrgIds": [
              "PSA.103.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:8"
      },
      "items": [
        {
          "text": "iye ok wangʼ piyo kendo en gihera mangʼeny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.8",
            "verseOrgIds": [
              "PSA.103.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 103:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok osik komanyo ketho kuom ji,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.9",
            "verseOrgIds": [
              "PSA.103.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:9"
      },
      "items": [
        {
          "text": "bende ok okan mirimbe nyaka chiengʼ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.9",
            "verseOrgIds": [
              "PSA.103.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 103:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ok otimnwa mowinjore gi richowa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.10",
            "verseOrgIds": [
              "PSA.103.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:10"
      },
      "items": [
        {
          "text": "bende ok ochulwa kaluwore gi kethowa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.10",
            "verseOrgIds": [
              "PSA.103.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 103:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar kaka polo ni malo moyombo piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.11",
            "verseOrgIds": [
              "PSA.103.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:11"
      },
      "items": [
        {
          "text": "e kaka herane duongʼ ne joma omiye luor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.11",
            "verseOrgIds": [
              "PSA.103.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 103:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana kaka wuok chiengʼ bor gi podho chiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.12",
            "verseOrgIds": [
              "PSA.103.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:12"
      },
      "items": [
        {
          "text": "e kaka osepogowa mabor gi kethowa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.12",
            "verseOrgIds": [
              "PSA.103.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 103:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka wuoro kecho nyithinde,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:13"
      },
      "items": [
        {
          "text": "e kaka Jehova Nyasaye kecho joma omiye luor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 103:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimar ongʼeyo kaka ochweyowa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.14",
            "verseOrgIds": [
              "PSA.103.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:14"
      },
      "items": [
        {
          "text": "ongʼeyo e pache ni wan mana buch lowo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.14",
            "verseOrgIds": [
              "PSA.103.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 103:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhano to ndalone chalo gi lum,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.15",
            "verseOrgIds": [
              "PSA.103.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:15"
      },
      "items": [
        {
          "text": "oloth piyo ka maua mopidhi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.15",
            "verseOrgIds": [
              "PSA.103.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 103:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "to ka yamo okudhe matin nono to kare orumo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.16",
            "verseOrgIds": [
              "PSA.103.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:16"
      },
      "items": [
        {
          "text": "kendo ok chak pare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.16",
            "verseOrgIds": [
              "PSA.103.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 103:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hera ma Jehova Nyasaye oherogo joma omiye luor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.17",
            "verseOrgIds": [
              "PSA.103.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:17"
      },
      "items": [
        {
          "text": "to osiko manyaka chiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.17",
            "verseOrgIds": [
              "PSA.103.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:17"
      },
      "items": [
        {
          "text": "kendo osiko otimo maber ne nyithind nyithindgi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.17",
            "verseOrgIds": [
              "PSA.103.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 103:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma gin joma orito singruokne kendo jogo maparo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.18",
            "verseOrgIds": [
              "PSA.103.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:18"
      },
      "items": [
        {
          "text": "mondo orit chikene.",
