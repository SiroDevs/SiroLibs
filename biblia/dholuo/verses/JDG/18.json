  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JDG 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jo-Dan odak Laish",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalogo jo-Israel ne onge gi ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.1",
            "verseOrgIds": [
              "JDG.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 18:1"
      },
      "items": [
        {
          "text": "Kendo e ndalogo joka Dan ne manyo kargi giwegi ma ginyalo dakie, nikech ne pod ok giyudo kar dak e dhout jo-Israel.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.1",
            "verseOrgIds": [
              "JDG.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo jo-Dan nooro jolweny abich moa Zora gi Eshtaol mondo onon pinyno kendo ongʼe kaka pinyno chalo. Jogi nochungʼne dhout gigo duto. Negiwachonegi niya, \"Dhiuru mondo unon pinyno.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.2",
            "verseOrgIds": [
              "JDG.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 18:2"
      },
      "items": [
        {
          "text": "Jogo nodonjo e piny gode mag Efraim kendo negidhi e od Mika, kama ne ginindoe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.2",
            "verseOrgIds": [
              "JDG.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gichopo machiegni gi od Mika, ne giwinjo dwond ja-Lawi moro ma wuowi; omiyo negidonjo kanyo mi gipenje niya, \"Ngʼama nokeli ka? Angʼo ma itimo ka? Angʼo ma omiyo in ka?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.3",
            "verseOrgIds": [
              "JDG.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonyisogi gima Mika nosetimone, kendo owacho niya, \"Osekawa kaka jatije kendo an jadolo mare.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.4",
            "verseOrgIds": [
              "JDG.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka negiwachone niya, \"Kiyie to penjnwa Nyasaye ka wuodhwa dhi bedo maber.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.5",
            "verseOrgIds": [
              "JDG.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jadolo nodwokogi niya, \"Dhiuru gi kwe. Wuodhu osepwodhi gi Jehova Nyasaye.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.6",
            "verseOrgIds": [
              "JDG.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo ji abichgo noa mi gichopo Laish, kama negineno ka ji odak kanyo gi kwe, mana kaka jo-Sidon, maonge paro moro amora kata kibaji kendo negidak gi kwe. To nikech pinygi ne ok ochando gimoro amora, ne gin joma omewo. Bende, negidak mochwolore gi jo-Sidon kendo ne gionge gi osiep gi ngʼato angʼata.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.7",
            "verseOrgIds": [
              "JDG.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gidwogo Zora kod Eshtaol, owetegi nopenjogi niya, \"Ne uyudo gik moko chalo nade kuno?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.8",
            "verseOrgIds": [
              "JDG.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negidwokogi niya, \"Biuru mondo wamonjgi! Waseneno ka piny cha ber ahinya. Donge udhi timo gimoro? Kik udeki ma ok udhi kuno kendo ukaw pinyno.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.9",
            "verseOrgIds": [
              "JDG.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka uchopo kuno, to unuyud jogo ma ok oikore ne lweny kendo gi piny malach ma Nyasaye oseketo e lwetu, piny maonge gima ochando kendo man-gi gik moko duto.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.10",
            "verseOrgIds": [
              "JDG.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka ji mia auchiel moa e dhood joka Dan, mane oikore ne lweny, nowuok oa Zora kod Eshtaol.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.11",
            "verseOrgIds": [
              "JDG.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane pod gidhi negiloso kambi but Kiriath Jearim manie piny Juda. Mano ema omiyo piny mantiere yo podho chiengʼ mar Kiriath Jearim pod iluongo ni Mahane Dan nyaka chil kawuono.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.12",
            "verseOrgIds": [
              "JDG.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gia kanyo negidhi e piny gode mag Efraim ma gichopo e od Mika.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.13",
            "verseOrgIds": [
              "JDG.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka chwo abich mane obiro nono piny Laish nowachone owetegi niya, \"Bende ungʼeyo ni achiel kuom udigi nigi law mayom mar dolo miluongo ni efod, nyiseche moko manono, kod kido mobaw gi fedha mag nyiseche manono? Koro ungʼeyo gima onego utim.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.14",
            "verseOrgIds": [
              "JDG.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo negidhi kanyo ma gidonjo e od ja-Lawi ma wuowi mane ni ka Mika kendo gimose.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.15",
            "verseOrgIds": [
              "JDG.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jolweny mia auchiel ma jo-Dan moikore ne lweny nochungʼ e dhorangach.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.16",
            "verseOrgIds": [
              "JDG.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji abich mane osetimo nonro matut mar pinyno nodonjo ei ot mokawo kido mopa machalo gi law mayom mar dolo miluongo ni efod, gi nyiseche manono mag udi, kod mago mopa, ka jadolo kod jolweny mia auchiel to ochungʼ e dhorangach.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.17",
            "verseOrgIds": [
              "JDG.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane jogi odhi e od Mika ma gikawo kido mopa, law mayom mar dolo miluongo ni efod, nyiseche manono mag udi kod nyiseche mopa, jadolo nowachonegi niya, \"Angʼo mutimono?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.18",
            "verseOrgIds": [
              "JDG.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negidwoke niya, \"Lingʼ thi! Kik iwach gimoro amora. Dhi kodwa, kendo ibed wuonwa kendo jadolowa. Donge ber ka itiyone anywola kod dhoot Israel kaka jadolo moloyo mana tiyone jood ngʼato achiel?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.19",
            "verseOrgIds": [
              "JDG.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe jadolo nobedo gi mor. Nokawo law mayom mar dolo miluongo ni efod, nyiseche manono mag udi kod kido mopa kendo nodhi gi jogo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.20",
            "verseOrgIds": [
              "JDG.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negichako wuoth ma gia ka nyithindgi matindo gi jambgi kod gigegi otelo e nyimgi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.21",
            "verseOrgIds": [
              "JDG.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gisedhi mochwolore gi od Mika, jogo mane odak machiegni gi Mika noluong kanyakla kendo negilawo jo-Dan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.22",
            "verseOrgIds": [
              "JDG.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gigoyo koko bangʼ-gi, jo-Dan nolokore kendo owacho ne Mika niya, \"En angʼo marach kodi momiyo ne ioro wach ne jowu mondo oked kodwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.23",
            "verseOrgIds": [
              "JDG.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nodwoko niya, \"Ne ukawo nyiseche mane aloso, kod jadolo matiyona kendo mi uwuok. En angʼo kendo makoro an-go? Ere kaka unyalo penjo, 'En angʼo marach kodi?' \"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.24",
            "verseOrgIds": [
              "JDG.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Dan nodwoko niya, \"We dwokori kodwa, ka ok kamano, to joma igi wangʼ moingo tekregi biro monji, bangʼe in kod joodi ibiro negi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.25",
            "verseOrgIds": [
              "JDG.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo jo-Dan nodhi nyime gi wuoth, kendo ka Mika noneno ka tekregi pekne, nowuok mi odok dalane.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.26",
            "verseOrgIds": [
              "JDG.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe negikawo gigo mane Mika oseloso, kod jadolo mare, kendo negidhi Laish, mondo giked gi jogo man-gi kwe kendo maonge gi ikruok moro amora mar kedo. Negimonjogi gi lingangla kendo negiwangʼo dala maduongʼno gi mach.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.27",
            "verseOrgIds": [
              "JDG.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onge ngʼama ne nyalo resogi nikech negidak mochwolore gi Sidon kendo ne onge watgi moro amora kanyo. Dala maduongʼno ne nitie e holo man but Beth Rehob.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.28",
            "verseOrgIds": [
              "JDG.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 18:28"
      },
      "items": [
        {
          "text": "Jo-Dan nochako gero dala maduongʼno kendo negidak kanyo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.28",
            "verseOrgIds": [
              "JDG.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negichako kanyo ni Dan bangʼ kwargi Dan, mane wuod Israel; kata obedo ni dala maduongʼno ne iluongo chon ni Laish.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.29",
            "verseOrgIds": [
              "JDG.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joka Dan nochungo kido manono kanyo mondo gilam, kendo negiketo Jonathan wuod Gershom, ma wuod Musa, kod yawuote obedo jodolo ne dhood joka Dan nyaka ne ochopo kinde mane oter pinyno e twech.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.30",
            "verseOrgIds": [
              "JDG.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negidhi nyime ka gitiyone nyiseche manono mane Mika oseloso, to kindegi duto od Nyasaye neni Shilo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.31",
            "verseOrgIds": [
              "JDG.18.31"
            ]
          }
        }
      ]
    }
