      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:6"
      },
      "items": [
        {
          "text": "Ebed wuod Jonathan, kaachiel kode ji piero abich;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.6",
            "verseOrgIds": [
              "EZR.8.6"
            ]
          }
        }
