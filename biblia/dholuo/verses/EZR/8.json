    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:9"
      },
      "items": [
        {
          "text": "Obadia wuod Jehiel, kaachiel kode ji mia ariyo gi apar gaboro;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.9",
            "verseOrgIds": [
              "EZR.8.9"
            ]
          }
        }
      ]
    },
    {
