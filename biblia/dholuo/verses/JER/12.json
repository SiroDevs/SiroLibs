      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:13"
      },
      "items": [
        {
          "text": "gini nyagre gi tich to onge ohala ma giniyudi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:13"
      },
      "items": [
        {
          "text": "Omiyo yuduru wichkuot mar",
          "type": "text",
          "attrs": {
