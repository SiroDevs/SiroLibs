  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "DEU 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kendo mar misango man e Got Ebal",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa kod jodong Israel duto ne ochiko oganda niya, \"Rituru chikegi ma amiyou kawuono",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.1",
            "verseOrgIds": [
              "DEU.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka usengʼado aora Jordan ma uchopo e piny ma Jehova Nyasaye ma Nyasachu miyou, keturu kite moko kendo uwirgi maber.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.2",
            "verseOrgIds": [
              "DEU.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikuru kuomgi weche duto manie chike ka usengʼado ma uchopo e piny ma Jehova Nyasaye ma Nyasachu miyou ma en piny mopongʼ gi chak kod mor kich, mana kaka Jehova Nyasaye ma Nyasach kwereu nosingonu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.3",
            "verseOrgIds": [
              "DEU.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka usengʼado aora Jordan, chunguru kitegi e Got Ebal mana kaka achikou kawuono ka uwirogi maber.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.4",
            "verseOrgIds": [
              "DEU.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geruru kendo mar misango ne Jehova Nyasaye ma Nyasachu, ma en kendo mar misango molos gi kite. Kitego kik paa gi chuma.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.5",
            "verseOrgIds": [
              "DEU.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geruru kendo mar misango mar Jehova Nyasaye ma Nyasachu gi kite ma ok opa, kendo utim misango miwangʼo pep kanyo ne Jehova Nyasaye ma Nyasachu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.6",
            "verseOrgIds": [
              "DEU.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timuru misengini mag lalruok kanyo, ka uchiemo kendo ubedo gi mor e nyim Jehova Nyasaye ma Nyasachu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.7",
            "verseOrgIds": [
              "DEU.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo ndikuru weche duto mag chikni mochanore e kite ma usechungono.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.8",
            "verseOrgIds": [
              "DEU.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Weche mag kwongʼ moa e Got Ebal",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Musa kod jodolo ma gin jo-Lawi nowachone jo-Israel duto niya, \"Lingʼuru, yaye Israel, bende chikuru itu! Koro usebedo jo-Jehova Nyasaye ma Nyasachu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.9",
            "verseOrgIds": [
              "DEU.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luor Jehova Nyasaye ma Nyasachi kendo mondo iluw chikene kod buchene ma amiyi kawuono.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.10",
            "verseOrgIds": [
              "DEU.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "E odiechiengʼ onogono Musa nochiko oganda kowachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.11",
            "verseOrgIds": [
              "DEU.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka usengʼado aora Jordan, to dhoudigi nobi e Got Gerizim mondo gigwedh ji: Simeon, Lawi, Juda, Isakar, Josef kod Benjamin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.12",
            "verseOrgIds": [
              "DEU.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo dhoudigi nochungʼ e Got Ebal ka gihulo weche mag kwongʼ: Reuben, Gad, Asher, Zebulun, Dan kod Naftali.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.13",
            "verseOrgIds": [
              "DEU.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Lawi biro somone jo-Israel gi dwol maduongʼ niya,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.14",
            "verseOrgIds": [
              "DEU.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Okwongʼ ngʼat moloso kido milamo, kata nyiseche mopa, ma en gima mono e nyim Jehova Nyasaye, tij lwedo mar japecho kendo mochungi kama opondo.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pr",
        "vid": "DEU 27:15"
      },
      "items": [
        {
          "text": "Eka ji duto nodwok niya, \"Amin!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Okwongʼ ngʼat ma ok oluoro wuon kata min.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.16",
            "verseOrgIds": [
              "DEU.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pr",
        "vid": "DEU 27:16"
      },
      "items": [
        {
          "text": "Eka ji duto nodwok niya, \"Amin!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.16",
            "verseOrgIds": [
              "DEU.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Okwongʼ ngʼat masudo tongʼ mar jakiepe.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.17",
            "verseOrgIds": [
              "DEU.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pr",
        "vid": "DEU 27:17"
      },
      "items": [
        {
          "text": "Eka ji duto nodwok niya, \"Amin!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.17",
            "verseOrgIds": [
              "DEU.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Okwongʼ ngʼat ma wito muofu e yo.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.18",
            "verseOrgIds": [
              "DEU.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pr",
        "vid": "DEU 27:18"
      },
      "items": [
        {
          "text": "Eka ji duto nodwok niya, \"Amin!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.18",
            "verseOrgIds": [
              "DEU.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Okwongʼ ngʼat maketho buch japiny moro, nyathi kich kod dhako ma chwore otho.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.19",
            "verseOrgIds": [
              "DEU.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pr",
        "vid": "DEU 27:19"
      },
      "items": [
        {
          "text": "Eka ji duto nodwok niya, \"Amin!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.19",
            "verseOrgIds": [
              "DEU.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Okwongʼ ngʼat ma terore gi chi wuon, nimar odwanyo kitanda wuon.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.20",
            "verseOrgIds": [
              "DEU.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pr",
        "vid": "DEU 27:20"
      },
      "items": [
        {
          "text": "Eka ji duto nodwok niya, \"Amin!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.20",
            "verseOrgIds": [
              "DEU.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Okwongʼ ngʼat ma oterore gi chiayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.21",
            "verseOrgIds": [
              "DEU.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pr",
        "vid": "DEU 27:21"
      },
      "items": [
        {
          "text": "Eka ji duto nodwok niya, \"Amin!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.21",
            "verseOrgIds": [
              "DEU.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Okwongʼ ngʼat ma terore gi nyamin kata nyar wuon kata nyar min mare.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.22",
            "verseOrgIds": [
              "DEU.27.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pr",
        "vid": "DEU 27:22"
      },
      "items": [
        {
          "text": "Eka ji duto nodwok niya, \"Amin!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.22",
            "verseOrgIds": [
              "DEU.27.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Okwongʼ ngʼat ma oterore gi mar-mare.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.23",
            "verseOrgIds": [
              "DEU.27.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pr",
        "vid": "DEU 27:23"
      },
      "items": [
        {
          "text": "Eka ji duto nodwok niya, \"Amin!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.23",
            "verseOrgIds": [
              "DEU.27.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Okwongʼ ngʼat ma onego nyawadgi lingʼ-lingʼ.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.24",
            "verseOrgIds": [
              "DEU.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pr",
        "vid": "DEU 27:24"
      },
      "items": [
        {
          "text": "Eka ji duto nodwok niya, \"Amin!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.24",
            "verseOrgIds": [
              "DEU.27.24"
            ]
          }
