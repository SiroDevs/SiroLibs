  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "ISA 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kawuru rombe koa Sela",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:1"
      },
      "items": [
        {
          "text": "kungʼadogo thim mondo uterne ruodh piny,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:1"
      },
      "items": [
        {
          "text": "modak e got mar Nyar Sayun kaka gir chiwo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka nyithind winy",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:2"
      },
      "items": [
        {
          "text": "moketh odgi mafuyo koni gi koni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:2"
      },
      "items": [
        {
          "text": "e kaka mond jo-Moab nodongʼ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:2"
      },
      "items": [
        {
          "text": "e kar otuodo manie Aora Arnon.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngʼadnwauru rieko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "nyiswa gima onego watim.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "Pandwauru mondo kik yudwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "kendo panduru jowa moringo lweny,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "kendo kik uyie mondo omaki joma oseringo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "We jo-Moab moringo lweny odag kodu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "kendo bednegi ragengʼ kuom jakethgi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 16:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "Ngʼatno masandogi tekone norum,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "kendo kethruok notieki;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "mi jathir ji nolal nono e piny.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom hera, loch nogur;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "kuom adiera ngʼato nobedie lojno,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "ngʼatno nowuogi e od Daudi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "ma en ngʼat mangʼado bura kare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "kendo ojiwo timbe mag adieri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasewinjo sunga mar Moab,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "kaka otingʼore malo gi wuondruok,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "kopongʼ gi sunga kod achaya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "to dhialruokneno en kayiem nono.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano jo-Moab dengo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:7"
      },
      "items": [
        {
          "text": "gidengo kaachiel nikech Moab.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:7"
      },
      "items": [
        {
          "text": "Ywaguru kendo ubed gi lit nikech jo-Kir Hareseth.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puothe mag Heshbon ner,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "kaachiel gi mzabibu mag Sibma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "Jotelo mag ogendini oseketho divai mane berie moloyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "mane ndalo moro ochopo nyaka Jazer,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "kendo olandore nyaka kar ongoro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "Bedene nolawore malach mochopo nyaka nam.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo aywak mana kaka Jazer ywak",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "nikech mzabibu mag Sibma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "Yaye Heshbon, yaye Eleale,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "analuoku gi pi wangʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "Mor ma un-go nikech olembeu mosechiek",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "kendo nikech keyo maru osetieki.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mor kod ilo norum chuth e puotheu mag olemo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:10"
      },
      "items": [
        {
          "text": "kendo onge wer mano wer kata koko manogo e puotheu mag mzabibu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:10"
