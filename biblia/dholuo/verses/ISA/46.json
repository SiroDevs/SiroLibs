  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "46",
        "style": "c",
        "sid": "ISA 46"
      },
      "items": [
        {
          "text": "46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyiseche mag Babulon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bel kod Nebo ma nyisechegi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "miywayo gi farese opodho piny.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "Nyisechegi mosebedo kitingʼo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "atingʼa osekelo chandruok ma giolo joma otingʼogi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gipodho piny giduto;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:2"
      },
      "items": [
        {
          "text": "ma ok ginyal kelo resruok ne joma lamogi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:2"
      },
      "items": [
        {
          "text": "ka gin giwegi otergi e twech.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjuru wachna, yaye od Jakobo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "un jo-Israel duto modongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "un duto ma aseyiero nyaka aa chakruok",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "kendo ma aserito nyaka aa e nywolu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata ka udoko moti ma wiu otimo lwar,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:4"
      },
      "items": [
        {
          "text": "to pod An mana en, An ema abiro tingʼou mi aresu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "To en ngʼa ma unyalo pimago",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.5",
            "verseOrgIds": [
              "ISA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:5"
      },
      "items": [
        {
          "text": "kata ma unyalo kwano ni rom koda?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.5",
            "verseOrgIds": [
              "ISA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:5"
      },
      "items": [
        {
          "text": "Koso ere ngʼama dichal koda ma dwapimrego?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.5",
            "verseOrgIds": [
              "ISA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jomoko olo dhahabu piny koa ei okepegi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "kendo pimo fedha e ratil;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "bangʼe gichulo jatheth,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "mondo olesnegigo nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "kendo gikulore piny mi gilame.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gitingʼe malo ma gikete e gokgi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "eka gikete e kare monego obedie kendo kanyo ema osikoe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "Kama oketeno ok onyal chorore.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "Kata bed ni ngʼato nyalo ywagorene to ok onyal dwoko;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "bende ok onyal rese e chandruokne.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paruru wachni, keturu e pachu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.8",
            "verseOrgIds": [
              "ISA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:8"
      },
      "items": [
        {
          "text": "kendo pareuru e chunyu un joma ongʼanyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.8",
            "verseOrgIds": [
              "ISA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paruru gik mosekadho,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:9"
      },
      "items": [
        {
          "text": "gigo mane otimore chon,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:9"
      },
      "items": [
        {
          "text": "An e Nyasaye kendo onge moro machielo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:9"
      },
      "items": [
        {
          "text": "bende An e Nyasaye kendo onge moro machalo koda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyiso giko mar gimoro mana e kinde mochakore,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "bende asebedo kahulo gik mapok otimore.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "Awacho ni: Gima awacho nyaka timre",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "kendo abiro timo gimoro amora mahero.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koa yo wuok chiengʼ nakel winyo mager,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "koa e piny mabor anakel ngʼato machopo dwarona.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "Gima asewacho nyaka chop kare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "gima asechano ema abiro timo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjauru, un joma chunygi tek",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.12",
            "verseOrgIds": [
              "ISA.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
