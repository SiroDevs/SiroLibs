  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "ISA 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wach mokor nibiro timore ne jo-Moab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wach nofwenyore kuom jo-Moab ni:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:1"
      },
      "items": [
        {
          "text": "Ar manie Moab okethi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:1"
      },
      "items": [
        {
          "text": "omuke ei otieno achiel!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:1"
      },
      "items": [
        {
          "text": "Kir manie Moab bende okethi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:1"
      },
      "items": [
        {
          "text": "omuke ei otieno achiel!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Dibon dhiyo e kargi mar lemo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "gidhiyo e hembko mag-gi mondo giywagi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "kendo jo-Moab goyo nduru nikech Nebo gi Medeba osekethi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "Ngʼato ka ngʼato oliel wiye kod tike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "E yore, girwako pien gugru;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:3"
      },
      "items": [
        {
          "text": "to ewi udi kod laru maduongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:3"
      },
      "items": [
        {
          "text": "giduto giywak ka gidengo kendo gingʼielore e lowo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Heshbon kod jo-Eleale ywak,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.4",
            "verseOrgIds": [
              "ISA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:4"
      },
      "items": [
        {
          "text": "kendo ywakgi winjore nyaka Jahaz.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.4",
            "verseOrgIds": [
              "ISA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:4"
      },
      "items": [
        {
          "text": "Kuom mano jolweny mag jo-Moab ywak",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.4",
            "verseOrgIds": [
              "ISA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:4"
      },
      "items": [
        {
          "text": "kendo kihondko omakogi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.4",
            "verseOrgIds": [
              "ISA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunya ywago jo-Moab;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "nimar ogandane ringo kadhi pondo Zoar,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "ma gichopo nyaka Eglath Shelishiya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "Gidhi ka giluwo yo mochomo Luhith ka giywak,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "e yo madhi Horonaim giywak malit nikech kethruokgi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pige mag Nimrim oseduono,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.6",
            "verseOrgIds": [
              "ISA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:6"
      },
      "items": [
        {
          "text": "kendo lum bende osener,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.6",
            "verseOrgIds": [
              "ISA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:6"
      },
      "items": [
        {
          "text": "kendo oboke orumo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.6",
            "verseOrgIds": [
              "ISA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:6"
      },
      "items": [
        {
          "text": "maonge gimoro amora modongʼ ka ngʼich.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.6",
            "verseOrgIds": [
              "ISA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo mwandu mane giseloso",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.7",
            "verseOrgIds": [
              "ISA.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:7"
      },
      "items": [
        {
          "text": "kendo kano negitingʼo magingʼadogo Holo ma Omburi otiye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.7",
            "verseOrgIds": [
              "ISA.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ywakgi winjore nyaka e tongʼ Moab,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.8",
            "verseOrgIds": [
              "ISA.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:8"
      },
      "items": [
        {
          "text": "nduru margi chopo nyaka Eglaim,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.8",
            "verseOrgIds": [
              "ISA.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:8"
      },
      "items": [
        {
          "text": "kendo dengo margi landore nyaka Beer Elim.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.8",
            "verseOrgIds": [
              "ISA.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pige mag Dimon opongʼ gi remo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.9",
            "verseOrgIds": [
              "ISA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:9"
      },
      "items": [
        {
          "text": "to kata kamano named kelo masiche ne Dimon,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.9",
            "verseOrgIds": [
              "ISA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:9"
      },
      "items": [
        {
          "text": "ne joge maringo koa Moab",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.9",
            "verseOrgIds": [
              "ISA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:9"
      },
      "items": [
        {
          "text": "mondo opondi kod jogo modongʼ e pinyno nomak gi sibuor.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.9",
            "verseOrgIds": [
              "ISA.15.9"
            ]
          }
        }
      ]
    }
  ],
