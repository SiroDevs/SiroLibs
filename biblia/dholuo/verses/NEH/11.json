              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Lawi mamoko mane ni Juda nopog mondo odag e piny Benjamin.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.36",
            "verseOrgIds": [
              "NEH.11.36"
            ]
