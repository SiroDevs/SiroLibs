      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:13"
      },
      "items": [
        {
          "text": "Ruodhgi nokwong okadh kotelonegi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.13",
            "verseOrgIds": [
              "MIC.2.13"
            ]
          }
