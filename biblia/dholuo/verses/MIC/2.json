      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:13"
      },
      "items": [
        {
          "text": "Ginimuom rangach mi gitony.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.13",
            "verseOrgIds": [
              "MIC.2.13"
            ]
          }
        }
      ]
    },
