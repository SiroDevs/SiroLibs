          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jal mayawo yore modinore nodhi nyimgi kotelonegi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.13",
            "verseOrgIds": [
              "MIC.2.13"
            ]
          }
        }
      ]
