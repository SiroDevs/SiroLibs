      "attrs": {
        "style": "q2",
        "vid": "EXO 15:17"
      },
      "items": [
        {
          "text": "kendo ibiro miyo gibedi ewi godi mar girkeni,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.17",
            "verseOrgIds": [
              "EXO.15.17"
            ]
          }
        }
      ]
    },
    {
