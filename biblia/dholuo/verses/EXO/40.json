            "number": "36",
            "style": "v",
            "sid": "EXO 40:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "E wuodhe duto mag jo-Israel, e kinde moro amora ma bor polo ne oa ewi Hemb Romo negichako wuoth,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.36",
            "verseOrgIds": [
              "EXO.40.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 40:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "to ka bor polo ne ok otingʼore malo ne ok gichak wuoth nyaka chop odiechiengʼ motingʼore.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.37",
            "verseOrgIds": [
              "EXO.40.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 40:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano bor polo mar Jehova Nyasaye ne nitie ewi Hemb Romo godiechiengʼ, to mach ne nitie ei bor polono gotieno e nyim jo-Israel duto e wuodhegi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.38",
            "verseOrgIds": [
              "EXO.40.38"
