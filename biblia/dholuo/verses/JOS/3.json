  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JOS 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jo-Israel ongʼado Aora Jordan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gokinyi mangʼich Joshua kod jo-Israel duto nowuok koa Shitim, mi gidhi nyaka e aora Jordan, negibiro kanyo kapok giidho loka.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.1",
            "verseOrgIds": [
              "JOS.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ ndalo adek jotelo nowuotho e kuonde kambi duto,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.2",
            "verseOrgIds": [
              "JOS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka gimiyogi chike niya, \"Ka uneno ka Sandug Muma mar singruok mar Jehova Nyasaye ma Nyasachu, otingʼ gi jodolo, ma jo-Lawi, to nyaka uwuog oko e kuonde muchungʼie mondo uluwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.3",
            "verseOrgIds": [
              "JOS.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe ubiro ngʼeyo yo mudhiyoe, nikech ne pok uluwo yorni nyaka nene. Makmana, beduru mochwalore gi sandugno, madirom fut alufu ariyo mia ochiko gi piero abich gadek; kendo kik usud machiegni kode.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.4",
            "verseOrgIds": [
              "JOS.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua nokone oganda Israel niya, \"Pwodhreuru, nikech kiny Jehova Nyasaye biro timo gigo miwuoro e kindu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.5",
            "verseOrgIds": [
              "JOS.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua nowachone jodolo niya, \"Kawuru Sandug Muma mar singruok kendo utel kode e nyim ji.\" Omiyo ne gikawe mi gidhi nyimgi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.6",
            "verseOrgIds": [
              "JOS.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo Jehova Nyasaye nowachone Joshua niya, \"Kawuono abiro tingʼi malo e wangʼ jo-Israel duto, eka ginyalo ngʼeyo ni An kodi mana kaka ne an gi Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.7",
            "verseOrgIds": [
              "JOS.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyis jodolo matingʼo Sandug Muma mar singruok ni, 'Ka uchopo e geng pige mag aora Jordan, to dhiuru kendo uchungʼ ei aora.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.8",
            "verseOrgIds": [
              "JOS.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua nowachone jo-Israel niya, \"Biuru kae kendo uchik itu ne weche Jehova Nyasaye ma Nyasachu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.9",
            "verseOrgIds": [
              "JOS.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kawuononi ubiro neno ranyisi ni Nyasaye mangima nikodu kendo enoriemb e nyimu jo-Kanaan, jo-Hiti, jo-Hivi, jo-Perizi, jo-Girgash, jo-Amor kod jo-Jebus.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.10",
            "verseOrgIds": [
              "JOS.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne, Sandug Muma mar singruok mar Jehova Nyasaye Manyalo Gik Moko Duto biro dhi nyimu nyaka aora Jordan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.11",
            "verseOrgIds": [
              "JOS.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro omiyo, yier ji apar gariyo koa e dhout Israel, ngʼato achiel koa e dhoot ka dhoot.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.12",
            "verseOrgIds": [
              "JOS.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "E sa ma jodolo motingʼo Sandug Muma mar singruok mar Jehova Nyasaye ma en Ruoth Nyasaye mar piny duto, nonyon aora Jordan, pige-ge mamol koluwo aora tir nochungʼ kogingore ka pith.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.13",
            "verseOrgIds": [
              "JOS.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo ka ji noke oa e kambi mag-gi mondo gingʼad aora Jordan, jodolo motingʼo Sandug Muma mar singruok notelo nyimgi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.14",
            "verseOrgIds": [
              "JOS.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aora Jordan koro notimo ataro kuonde duto nyaka ndalo mag keyo. Omiyo ka jodolo mane otingʼo Sandug Muma mar singruok nochopo e aora Jordan mi tiendegi omulo geng aora,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.15",
            "verseOrgIds": [
              "JOS.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "pige mane mol koa malo nochungʼ. Nogingore malo kaka pith, e dala miluongo ni Adam man but Zarethan. Pi mane mol kadhi e nam mar Araba (ma tiende ni Nam Chumbi) nochungʼ chuth, omiyo ji nongʼado modhi loka komachielo, momanyore gi Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.16",
            "verseOrgIds": [
              "JOS.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jodolo mane otingʼo Sandug Muma mar singruok mar Jehova Nyasaye nochungʼ motegno e lowo motwo e dier aora Jordan, nyaka ogendini mag jo-Israel notieko kadho ka giwuotho e lowo motwo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.17",
            "verseOrgIds": [
              "JOS.3.17"
            ]
          }
        }
      ]
    }
  ],
