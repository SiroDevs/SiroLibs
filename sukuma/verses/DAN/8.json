          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kūlwa mbika ya katongeelele kakwe akwenheleja būnyecha wiyongeje, alīyo ū wei akwibona gīkī alī higūlya no. Akūbisanganīja banhū bingī ababipye ng'wikanza īlo bakwiganikaga gīkī balī mu mhola; hama akūbūūka kwilwisha nū Ntaale wa basugi. Alīyo akūkenaagūlwa mu būtūtūmamīla nguzu ja banhū.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.25",
            "verseOrgIds": [
              "DAN.8.25"
            ]
          }
        }
