              "DAN.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho ataalī wīhaya ī mihayo yenīyo, liiza ilaka kūfuma ng'wigūlū līlīng'wīla, “Ntemi Nebukadineza, gūūyū ūyo gūhelilwe kūlwa nguno yako: Ū būdūla wako wa nyatemi wīngījiagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.31",
            "verseOrgIds": [
              "DAN.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūkūpeejiwa ū mu banhū ūkikale hamò na ndimu ja mu masaka, ūyūlya maswa gītī mitugo. Gakūbīta makanza mpungatī ūlī kwenūko, kūshisha ūdeebe gīkī Ūyo alī Higūlya no hū ng'wene ū nsugi wa mabūtemi ga banhū, na akang'winhaga ose ose ūyo antogilwe we.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.32",
            "verseOrgIds": [
              "DAN.4.32"
            ]
          }
        }
      ]
    },
