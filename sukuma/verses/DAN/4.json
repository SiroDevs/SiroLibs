            "number": "23",
            "style": "v",
            "sid": "DAN 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ū bebe baba Ntemi ūkamona ntūng'wa ng'wela, alika kūfuma ng'wigūlū, ūhaya gīkī, ‘Gūbbutagi ū ntī mugūkenaagūle, alīyo ī līshikī mulīleke lītungilwe chūma na shaba, likale mu maswa ga mu malaale, ī miji yalyo īlī hasī. Nekagi alobiwe lūme lwa kūfuma kwigūlū, ikale gītī ndimu ja mu matogolo; kūshisha makanza 7 mpungatī gabīte alī kwenūko.’",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.23",
            "verseOrgIds": [
              "DAN.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
