              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ng'hana a ba Shadulaka nū Meshaki nū Abedinego būfuma ū mu moto, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.26",
            "verseOrgIds": [
              "DAN.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "a basugi na a batwaale na a bataale ba basugi na a baganikīji ba ntemi būbitinja. Būbona gīkī ū moto gūtabīītile mhayo gose gose ī mibīlī yabo, nūūlū ni lūywīlī lwa kū ntwe gwabo lūtagemile kwihinya na hado yaya; nī shizwalo shabo shitajigile, nūūlū lūnung'ho lwa moto dūhū baalī batī nalo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.27",
            "verseOrgIds": [
              "DAN.3.27"
            ]
