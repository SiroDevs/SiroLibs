              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuma ya henaho ū Sang'weli wīnga ūshoka Lama; ū Saulo ūja kū ng'wakwe Gibea ya ng'wa Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.34",
            "verseOrgIds": [
              "1SA.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lyaakashika ī likanza lya kūcha kwakwe ū Sang'weli atajile kūmona hangī ū Saulo, nūūl'īkī ū Sang'weli walīlaga ng'hangala ningī kūlwa ng'wa Saulo. Alīyo ū SEEBA akapīnīhala nguno walī wang'wīta ū Saulo kūbiza ntemi wa Baisilaeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.35",
