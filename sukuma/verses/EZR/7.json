              "EZR.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akumīlījiwe ū SEEBA, ū Mulungu wa bakūlūgenji bise, ūyo akatūūla mhayo gītī gwenūyū ū mu ng'holò ya ntemi, kūlwa kwībeeja chiza gīko ī numba ya ng'wa SEEBA īyo īlī mu Yelusalemu. ",
