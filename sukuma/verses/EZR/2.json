          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bagabīji ba numba ya ng'wa Yedaya, (bahilya Yeshua) baalī magana kenda na makūmi mpungatī na badatū. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.36",
            "verseOrgIds": [
              "EZR.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZR 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba numba ya ng'wa Imeeli baalī shihūmbī na makūmi atanò na babīlī. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.37",
            "verseOrgIds": [
              "EZR.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZR 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba numba ya ng'wa Pashuli baalī shihūmbī na magana abīlī na makūmi anè na mpungatī. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.38",
            "verseOrgIds": [
              "EZR.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
