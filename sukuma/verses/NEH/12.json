              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Hoshaya ūja nalyo ī ligelè lyenīlo, hamò na nusu ya basugi ba Yuda; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.32",
            "verseOrgIds": [
              "NEH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
