              "NEH.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Alilūūlū kūlwa yose yenīyī, tūlībeeja ilagane lya kūshinga ho, īlo tūlīlyandīka; hūna a batongeeji bise, na a Balawī, na a bagabīji bise balītūūlīle meng'ho jabo.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.38",
            "verseOrgIds": [
              "NEH.9.38"
            ]
          }
        }
