          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.20",
            "verseOrgIds": [
              "JER.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaka lya kūlīla līlīfuma",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.21",
            "verseOrgIds": [
              "JER.3.21"
            ]
          }
        }
      ]
    }
