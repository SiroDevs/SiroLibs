          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganoolagi a masonga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.11",
            "verseOrgIds": [
              "JER.51.11"
            ]
          }
