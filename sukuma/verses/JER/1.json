          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī yenīyī mihayo ya ng'wa Yelemia ng'witūnja o ng'wa Hilikia, ūmò wa bagabīji ba Anasosi, mu sī ya Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū mhayo go ng'wa SEEBA gūkang'wizīīla mu ng'waka gw'ikūmi n'idatū gwa būsugi bo ng'wa Yosia, ng'witūnja o ng'wa Amoni ntemi wa Yuda; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mu shikū ja ng'wa Yehoyakimu ng'witūnja o ng'wa Yosia ntemi wa Yuda, kūshisha mu ng'weji gwa katanò, ng'waka gw'ikūmi na gūmò gwa būsugi bo ng'wa Sedekia ng'wintūnja o ng'wa Yosia ntemi wa Yuda; ikanza lya banhū ba Yelusalemu kūsaamiwa na kūtwalwa mu būding'wa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yelemia kwitanwa kūbiza ng'hangi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
