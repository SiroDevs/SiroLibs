              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū mhayo go ng'wa SEEBA gūkanizīīla gūlīhaya gīkī.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.4",
            "verseOrgIds": [
              "JER.1.4"
            ]
