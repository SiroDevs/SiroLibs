          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū mhayo go ng'wa SEEBA gwiza hangī ū kūlī Yelemia; gūhaya: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.23",
            "verseOrgIds": [
              "JER.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūtaalī ū kwigwa ūmo bakūhayīlaga a banhū benaba; ī gīkī, “Ū SEEBA wajiponya ī kaya jenījo būbīlī wajo, nūūlū īkī wajikoma wei ng'wenekīlī? Hūna lūūlū babibengelegije a banhū bane; booya ū kūbisaaba gīkī nabo bal'ihanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
