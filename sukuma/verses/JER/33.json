              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.18",
            "verseOrgIds": [
              "JER.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū mhayo go ng'wa SEEBA gwiza ū kūlī Yelemia; gūhaya: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ū SEEBA alīhaya gīkī, ‘Ūlū ng'ūdūla kūlībūlaga ī lilagane lyane īlo līlīho a ha gatī yane na a makanza ga līīmi na a ga būjikū, kūshisha a makanza ga līīmi na a ga būjikū gooye ū kwiza ūmo galagīīlīlilwe, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "a henaho numho līkūcha nī lilagane lyane īlo nabeeja na ntūmani wane Daūdi, nī lilagane lyane īlo nabeeja na Balawī, a bagabīji abo bakanitūmamīlaga; nū Daūdi atūpandīka ng'wingīji wa kūsuga a h'isumbī lyakwe lya būtemi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.21",
            "verseOrgIds": [
              "JER.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūmo sonda ja ng'wigūlū jitūdūla kūbalwa, na a maseni ga ha nyanza gatūdūla kūping'wa, h'ūmo nakūbongegeja nū būbyīle bo ntūmami wane Daūdi, na a Balawī abo bakanitūmamīlaga.’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.22",
            "verseOrgIds": [
              "JER.33.22"
            ]
          }
        }
      ]
    },
    {
