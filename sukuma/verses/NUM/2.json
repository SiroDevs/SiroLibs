          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lūdanga lwa ng'wa Benjamini lūkūtūūla ng'hambī kwihela nabo; ū ntongeeji wa banhū ba lūganda lwenūlo Abidani, ng'witūnja o ng'wa Gidioni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.22",
            "verseOrgIds": [
              "NUM.2.22"
            ]
          }
        },
        {
