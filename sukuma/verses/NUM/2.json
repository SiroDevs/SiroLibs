              "NUM.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lūganda lo Zabuloni lūkūtūūla ng'hambī kwihela nabo; ū ntongeeji wa banhū ba lūganda lwenūlo Eliabu, ng'witūnja o ng'wa Heloni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.7",
            "verseOrgIds": [
              "NUM.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī libità lyakwe līlī na banhū shihūmbī makūmi atanò na mpungatī, na magana anè. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.8",
            "verseOrgIds": [
              "NUM.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bagosha pye abo bahelilwe kūbiza ha sīlīlī ya ng'hambī ya lūganda lo Yuda, ū kūlondeela mabità gabo baalī banhū shihūmbī igana na makūmi anaane na shitandatū, na magana anè. A benabo hū bakūyūtonga ū kūbūūka ū lūgendo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.9",
            "verseOrgIds": [
              "NUM.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū kwipandī lya Dakama gakūbiza ko mabità ga ng'hambī ya lūganda lo Lubeni, ha sīlīlī ya lūbembeela lwabo. Ū ntongeeji wa banhū ba numba ya ng'wa Lubeni, Elizuli ng'witūnja o ng'wa Shedeuli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.10",
            "verseOrgIds": [
              "NUM.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī libità lyakwe līlī na banhū shihūmbī makūmi anè na shitandatū, na magana atanò. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.11",
            "verseOrgIds": [
              "NUM.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lūganda lo Simioni lūkūtūūla ng'hambī kwihela nabo; ū ntongeeji wa banhū ba numba ya ng'wa Simioni, Shelumieli ng'witūnja o ng'wa Zulishadai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.12",
            "verseOrgIds": [
              "NUM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī libità lyakwe līlī na banhū shihūmbī makūmi atanò na kenda, na magana adatū.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.13",
            "verseOrgIds": [
              "NUM.2.13"
            ]
          }
        }
      ]
    },
