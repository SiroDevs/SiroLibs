          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī libità lyakwe līlī na banhū shihūmbī makūmi adatū na shitanò, na magana anè. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.23",
