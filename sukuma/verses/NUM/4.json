          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babalage pye a bagosha kwandīja ba myaka makūmi adatū kūshisha ba myaka makūmi atanò, abo bakatūmamaga ng'wiheema lya kwibilingīla. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.30",
            "verseOrgIds": [
              "NUM.4.30"
            ]
          }
        },
        {
