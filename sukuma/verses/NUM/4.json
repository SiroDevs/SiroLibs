          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū nīmo gwabo ūyo bahelelilwe kūgwīta ū ng'wiheema lya kwibilingīla gūūyū, Bakūyūjibūūcha ī mbawa ja kūlyīmīlīkīja ī lipandī lya kwikala, nī papi jalyo nī ng'hīngī jalyo na a makīndīkīlo ga ng'hīngī. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
              "NUM.4.31"
            ]
          }
        },
        {
