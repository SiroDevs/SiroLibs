          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū wenūbū hū būtūmami wa banhū ba numba ya ng'wa Gelishomu ū ng'wiheema lya kwibilingīla. Ī milīmo yabo īkūbiza ha sīlīlī ya būtongeeji bo ng'wa Itamaali ng'witūnja wa ngabīji Alooni.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.28",
            "verseOrgIds": [
              "NUM.4.28"
            ]
          }
        }
      ]
