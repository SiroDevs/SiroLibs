          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī ng'ondi ī songi ījo mpungatī, būlī yene hamò na kilo īmò. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.15",
