{
  "id": "NUM.27",
  "number": "27",
  "bookId": "NUM",
  "reference": "Kūbala 27",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
