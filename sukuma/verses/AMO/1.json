            }
          ]
        },
        {
          "text": "Mihayo ya ng'wa Amosi ūyo walī ūmò wa badīīmi ba ng'holo ba mu Tekoa; akībona kūlwa Isilaeli myaka ībīlī aho nyahīnga ītaalī kwilonga. Jalī shikū ja ng'wa Uzia ntemi wa Yuda, na Yeloboamu ng'witūnja o ng'wa Yehoashi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.1",
            "verseOrgIds": [
              "AMO.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:1",
              "type": "text"
            },
            {
              "text": "Yehoashi:",
              "type": "text"
            },
            {
              "text": "Shihebulania Yoashi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " aho alī ntemi wa Isilaeli.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.1",
            "verseOrgIds": [
              "AMO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bazenganwa ba Isilaeli bakūlamulwa",
          "type": "text"
        }
      ]
