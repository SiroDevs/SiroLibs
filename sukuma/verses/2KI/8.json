            }
          ]
        },
        {
          "text": "Mu ng'waka gw'ikūmī n'ībīlī go ng'wa Yolamu ng'witūnja o ng'wa Ahabu alī ntemi wa Isilaeli, Ahazia ng'witūnja o ng'wa Yeholamu ntemi wa Yuda wandya kūtema. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.25",
            "verseOrgIds": [
              "2KI.8.25"
            ]
          }
        },
        {
