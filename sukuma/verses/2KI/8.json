          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akayūshimīzīla mu nhūngwa ja kaya ya ng'wa Ahabu, wīta yabūbi ū mu miso ga ng'wa SEEBA, gīt'ūmo yalī yītīla dūhū ī numba ya ng'wa Ahabu, nguno walīho būdūgū nī numba ya ng'wa Ahabu, ūbo būkenhelejiwa būtooji.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        },
        {
          "name": "note",
