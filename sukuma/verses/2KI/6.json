            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī likanza lyenīlo ū Elisha walī wigasha mu numba yakwe, na banamhala baalī bigasha nang'hwe. Ū ntemi ūtūma munhū atonge koi, alīyo aho ataalī ū kūshika, ū Elisha ūhaya, “Mulībona ī mihayo ya mūlagi ng'wenūyū? Ī haha watūma munhū kwiza kūnibbuta ntwe! Kalaganagi hoi, ūlū alashike ū ntūmījiwa wakwe mugūlugale ū nyango muhandatīle ho atizingīla. Mutigwaga ū kūshaadūka kwa mhambala ja ng'wa ise būgonzo a ha numa yakwe?” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.32",
            "verseOrgIds": [
              "2KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho ataalī ūbawīla gīko, ūshika ūyo walī watūng'wa kūlī we, nū ntemi ūshika; ūyomba, “A makoye genaya pye gaafumile kūlī SEEBA, numho nalī na nguno kī lūūlū ū kwikala nanindīīlaga SEEBA?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        }
