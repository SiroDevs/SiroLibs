        },
        {
          "text": "Ūyū gwene mhayo go ng'wa Seeba ūyo gūkang'wizīīla Zefania ng'witūnja o ng'wa Kushi ng'wana Gedalia, ūyo walī ng'witūnja o ng'wa Amalia, nang'hwe ng'witūnja o ng'wa Hezekia. Jalī shikū ja būsugi bo ng'wa Yosia ng'witūnja o ng'wa Amoni ntemi wa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.1",
            "verseOrgIds": [
              "ZEP.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Būhūgūji kūlwa ng'henaagūla īyo īliza",
          "type": "text"
        }
      ]
    },
