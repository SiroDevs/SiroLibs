        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.5",
            "verseOrgIds": [
              "JOS.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A batemi benaba Musa ntūmami o ng'wa SEEBA akabapyena alī hamò na Basilaeli; ū Musa ū ntūmami o ng'wa SEEBA, ī sī yenīyo ūbinha banhū ba lūganda lwa Lubeni, na lwa ng'wa Gadi na ba nusu ya lūganda lwa Manase; ūbinha kūbiza ya wingīji wabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.6",
            "verseOrgIds": [
              "JOS.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
