              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.27",
            "verseOrgIds": [
              "ROM.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna lūūlū, kūlwa kūbona gīkī batī na nguno ya kūmana ū Mulungu, nang'hwe ū Mulungu abalekanīgije bikale mu masala mahūganu, bīīte mihayo īyo ītigelile kwītwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
              "ROM.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balī banhū abo bokalile būbi wa būlī mbika, būsoso, kwikūmva kwabūbi, wilu, būbūlagi, wilwisha, būlemba lembi, būlembekeja, na būsīgani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
              "ROM.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hama basong'hanya, nīyo batantogagwa ū Mulungu. Banhū b'ibengwe, badooshi, bikumīlīja, bandya ba mihayo yabūbi, hangī batī na wigwi kū babyaji babo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
              "ROM.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bachilū chilū, babūlagi ba būlagane, naabo batamanile kūsaatwa banhū, nūūlū kūchīla shigongo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.31",
            "verseOrgIds": [
              "ROM.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nīyo hangī nūūlū īkī bamanile ūmo ahelelile ū Mulungu, ī gīkī abo bakīītaga īlī gīko bigeleelilwe nsango gwa kūcha, nahene batagelelaga dūhū a ha kwīyīta ī yenīyo, alīyo bakizunīlījaga nabo abo bakīyītaga!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.32",
            "verseOrgIds": [
              "ROM.1.32"
            ]
          }
        }
      ]
