  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "MAT 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwihela kwa shibyalīlwe sha ng'wa Yesu Kilisito",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūyū kūlī kwihela kwa shibyalīlwe sha ng'wa Yesu Kilisito wa lūganda lwa ng'wa Daūdi, mu būbyīle wa ng'wa Abulahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.1",
            "verseOrgIds": [
              "MAT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Abulahamu walī ise wa ng'wa Isaka, Isaka ūmyala Yakobo, Yakobo ūmyala Yuda na baana ba ng'wawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.2",
            "verseOrgIds": [
              "MAT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda ūmyala Falesi na Zela, kūfuma mulī Tamali. Falesi ūmyala Hezelomu, Hezelomu ūmyala Alamu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.3",
            "verseOrgIds": [
              "MAT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alamu ūmyala Aminadabu, Aminadabu ūmyala Naasoni, Naasoni ūmyala Salimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.4",
            "verseOrgIds": [
              "MAT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salimoni ūmyala Boazi kūfuma mulī Lahabu, Boazi ūmyala Obedi kūfuma mulī Luzi, Obedi ūmyala Yese.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.5",
            "verseOrgIds": [
              "MAT.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.5",
            "verseOrgIds": [
              "MAT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Yese akamyala ntemi Daūdi, Daūdi ūmyala Solomoni kūfuma mulī nkīma ūyo walī nke wa ng'wa Ulia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.6",
            "verseOrgIds": [
              "MAT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Solomoni ūmyala Lehoboamu, Lehoboamu ūmyala Abia, Abia ūmyala Asa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.7",
            "verseOrgIds": [
              "MAT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa ūmyala Yosafati, Yosafati ūmyala Yolamu, Yolamu ūmyala Uzia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.8",
            "verseOrgIds": [
              "MAT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzia ūmyala Yotamu, Yotamu ūmyala Ahazi, Ahazi ūmyala Hezekia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.9",
            "verseOrgIds": [
              "MAT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia ūmyala Manase, Manase ūmyala Amosi, Amosi ūmyala Yosia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.10",
            "verseOrgIds": [
              "MAT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosia ūmyala Yekonia na baana ba ng'wawe; ū mu shikū jenījo a banhū būsaamiwa, būtwalwa Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.11",
            "verseOrgIds": [
              "MAT.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.11",
            "verseOrgIds": [
              "MAT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho lyabīta ī likanza lya kūsaamījiwa Babuloni, ū Yekonia akamyala Shealtieli, Shealtieli ūmyala Zelubabeli. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.12",
            "verseOrgIds": [
              "MAT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zelubabeli ūmyala Abiudi, Abiudi ūmyala Eliakimu, Eliakimu ūmyala Azoli. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.13",
            "verseOrgIds": [
              "MAT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azoli ūmyala Achimu, Achimu ūmyala Eliudi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.14",
            "verseOrgIds": [
              "MAT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliudi ūmyala Eleazali, Eleazali ūmyala Mathani, Mathani ūmyala Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.15",
            "verseOrgIds": [
              "MAT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Yakobo akamyala Yosefu ū ngoshi wa ng'wa Malia, ū nina wa ng'wa Yesu, ūyo akitanagwa Kilisito. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.16",
            "verseOrgIds": [
              "MAT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna lūūlū, ū kūfuma ū kūlī Abulahamu kūshika halī Daūdi, ī shibyalīlwe ī shose shilī ikūmi na shine; nū kwīnga a halī Daūdi kūshika ng'wikanza lya banhū kūsaamījiwa Babuloni, shibyalīlwe ikūmi na shine. Hama nū kūfuma ū ng'wikanza lya banhū kūsaamījiwa Babuloni kūshika halī Kilisito, nasho ikūmi na shine.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.17",
            "verseOrgIds": [
              "MAT.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kūbyalwa kwa ng'wa Yesu Kilisito",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.17",
            "verseOrgIds": [
              "MAT.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna lūūlū, ū kūbyalwa kwa ng'wa Yesu Kilisito kūkaja gīkī, ū nina ū Malia walī alūnjiwe na Yosefu; alīyo aho bataalī kwitoola, ūbonwa alī nda kūlwa būdūla bo ng'wa Moyo Ng'wela! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.18",
            "verseOrgIds": [
              "MAT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Yosefu aho wagūdeeba ū mhayo gwenūyo, ūbona aneke. Alīyo īkī walī munhū ntūngīlīja, akandya kwiganika nzīla ya kūneka chiza; atizūngoola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.19",
            "verseOrgIds": [
              "MAT.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lūlū aho ataalī ūyiganika ī mihayo yenīyo, malaika wa ng'wa Seeba ūng'wilongela mu shilooti; ūng'wīla gīkī, “Yosefu ng'wana wa ng'wa Daūdi, ūtogohage ū kūnsola ū nke wako ū Malia; nguno ū Ng'wana ūyo alī ū mu nda yakwe alīho kūlwa būdūla bo ng'wa Moyo Ng'wela. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.20",
            "verseOrgIds": [
              "MAT.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akūbyala Ng'wana ngosha, ū bebe ūkūng'wilīka ī lina lyakwe Yesu; nguno hū ng'wene ūyo akūbapīja a banhū bakwe kūfuma mu shibi shabo.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.21",
            "verseOrgIds": [
              "MAT.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.21",
            "verseOrgIds": [
              "MAT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī yose yenīyī īkaja gīko kūlwa kūshikīlījiwa kwa mhayo ūyo Seeba walī wagūhaya kūfuma kale kūbītīla mulī ng'hangi wakwe; gīkī, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.22",
            "verseOrgIds": [
              "MAT.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Munhya ng'wilindu akūbūūcha nda,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.23",
            "verseOrgIds": [
              "MAT.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.23",
            "verseOrgIds": [
              "MAT.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Yosefu aho wamisha kūfuma ū mu tūlo, wīta gīt'ūmo akawīlīlwa nū malaika wa ng'wa Seeba; ūnsola ū nke wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.24",
            "verseOrgIds": [
              "MAT.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna lūlū atalaalile nang'hwe kūshisha ūmyala ū Ng'wana, hūna ūng'wilīka ī lina lyakwe ī lya Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.25",
            "verseOrgIds": [
              "MAT.1.25"
            ]
          }
        }
      ]
    }
  ],
