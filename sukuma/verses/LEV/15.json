            }
          ]
        },
        {
          "text": "“Ū nkīma ūlū ūbiza mu makoye ga kūfuma mininga ikanza lya shikū ningī īlo lītī mu shikū ja ng'weji gwakwe, nūūlū a mininga ga ng'wikanza lyakwe gūūfuma kūshisha kūlībīta ī likanza lyenīlo, akūbiza nsoso pyī ī likanza īlo akūfumagwa mininga; akwīta gīt'ūmo akīītīlaga mu shikū jakwe ja ng'weji. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.25",
            "verseOrgIds": [
              "LEV.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Būlīīlī bose bose ūbo ūbūlaalīla aho ataalī akūfumagwa mininga būkūbiza būsoso, gīt'ūmo būkabizīlaga ū mu shikū jakwe ja ng'weji; na būlī shikolo īsho ūshigaasīja shikūbiza shisoso, gīt'ūmo shikabizīlaga mu shikū jakwe ja ng'weji. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.26",
            "verseOrgIds": [
              "LEV.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ose ose ūyo ūshikuumya akūbiza nsoso, akūfula ī shizwalo shakwe, ooga na kooga mu minzī; hama wikala alī nsoso gīko kūshisha līīmi kūlibīla.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.27",
            "verseOrgIds": [
              "LEV.15.27"
            ]
          }
        }
      ]
    },
