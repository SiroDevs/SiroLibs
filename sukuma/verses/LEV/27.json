            "number": "26",
            "style": "v",
            "sid": "LEV 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gwike ī mbyalwa ja kwandya ū mu mitugo, jibize ng'ombe nūūlū ng'holo, ī jene ja ng'wa SEEBA ng'hana ng'hana, munhū ose ose atazunīlījiwe kūjifunya mu nzīla yose yose. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūlū gūlī ntugo gūmò gwaho gwa yīyo ītazunīlījiwe kūfunyiwa kūlwa ng'wa SEEBA, ū munhū adūgije kūgūgūla kūlenganīla nū mpango ūyo gūhelilwe, oongeja īmò y'itanò ya mpango gwenūyo. Ūlū atatogilwe kūgūkomoola ū ntugo gwenūyo, gūkūjinjiwa kūlenganīla na mpango ūyo gūhelilwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sabo ya munhū ose ose ūlū yūlinda yūfunyiwa kūlwa ng'wa SEEBA, ītīīko kūjinjiwa nūūlū kūkomoolwa; shose shose īsho shūfunyiwa kūlwa ng'wa SEEBA gīko, abize munhū nūūlū ntugo, nūūlū ilaale lya mu kaya, ī shenīsho shilī sha ng'wa SEEBA gete. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūlū munhū ūfunyiwa gīkī abūlagwe atīīko kūkomoolwa, shiigelile abūlagwe ū ng'wenūyo.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kūkomoola īmò ya ng'wikūmi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
