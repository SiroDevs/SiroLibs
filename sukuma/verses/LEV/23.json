            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū SEEBA ūng'wīla hangī ū Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.23",
            "verseOrgIds": [
              "LEV.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawīlage a Baisilaeli gīkī, “Ū lūshikū lwa kwandya lwa ng'weji gwa mpungatī, lūkūbiza lwing'we lwa kwifuula; lūshikū lwa kūfuula mhembe kūlwa kwiyizūkīja kwibilinga kwela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.24",
            "verseOrgIds": [
              "LEV.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaya kwīta milīmo yose yose īyo mukīītaga na kale; alīyo mukūfunīja ū SEEBA shitambò sha kūpemva mu moto.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.25",
            "verseOrgIds": [
              "LEV.23.25"
            ]
          }
        }
      ]
    },
