              "LEV.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū SEEBA ūng'wīla hangī ū Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.33",
            "verseOrgIds": [
              "LEV.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawīlage a Baisilaeli gīkī, “Ū lūshikū lw'ikūmi n'itanò lwa ng'weji gwa mpungatī, lūkūbiza lwa kwandya shigukulu sha ng'wa SEEBA sha maduku; shikūshinga kūshisha ikanza lya shikū mpungatī. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.34",
            "verseOrgIds": [
              "LEV.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū lūshikū ūlo shikwandya lūkūbiza lwa kwibilinga kwela, yaya ū kwīta ī milīmo īyo mukīītaga na kale. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.35",
            "verseOrgIds": [
              "LEV.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna līkūbīta ikanza lya shikū mpungatī mukūfunyaga kūlwa ng'wa SEEBA shitambò sha kūpemva mu moto; hama a ha lūshikū lwa kanaane mukūbiza na kwibilinga kwela hangī, ng'ūmfunīja hangī ū SEEBA shitambò sha kūpemva mu moto; ū lwenūlo lūlī lūshikū lwa kūmalīīja libilinga, yaya ū kwīta ī milīmo īyo mukīītaga na kale. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ī shenīshi h'ī shigukulu sha ng'wa SEEBA īsho shihelilwe; īsho īng'wigeleelilwe mushikumūche gīkī shilī sha kwibilinga kwela, na kwenha shakwinha kūlwa ng'wa SEEBA, sha kūmfunīja mu nzīla ya moto; shakwinha gītī, shitambò sha kūpemva, shakwinha sha būsu, shitambò, na shakwinha sha kūng'wiwa. Būlī shene shikūfunyiwa mu lūshikū ūlo lūhelilwe kūlwa nguno yasho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.37",
            "verseOrgIds": [
              "LEV.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī shakwinha shenīshi shikūyūfunyiwa ītī kūlwa gīkī shileke kūfunyiwa īsho shikafunyiagwa ha Sabato ja ng'wa SEEBA, nī shisho shikafunyiagwa būlī lūshikū, nī sha kūfunyiwa kūlwa kūshikīlīja mihayo īyo banhū baalahīla, nī shakwinha sha wiyaabī īsho shikenhagwa kū būtongi bo ng'wa SEEBA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.38",
            "verseOrgIds": [
              "LEV.23.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.38",
            "verseOrgIds": [
              "LEV.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na lūūlū ūlū ng'ūmala kūkuminga magesa kūfuma mu migūnda, ī likanza lya shigukulu sha ng'wa SEEBA līkūshika. Ī shoi shikūsola shikū mpungatī, kwandīja lūshikū lwa ikūmi n'itanò ū mu ng'weji gwa mpungatī. Ū lūshikū lwa kwandīja lūkūbiza lwa kwifuula, nū lwa kanaane nalo lwa kwifuula. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.39",
            "verseOrgIds": [
              "LEV.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū mu lūshikū lwa kwandīja mukūsolanhya matwajo ga kūfuma mu mitī misoga, ng'ūbbuta na matambī ga mitī ya būkīndū, na ga mitī ya madūūtū mingī, na ga magobeko kūfuma kū ng'hilimva ya mongo. Mukūmala shikū mpungatī mukūyegaga kū būtongi bo ng'wa SEEBA Mulungu wing'we. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.40",
            "verseOrgIds": [
              "LEV.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na lūūlū shidimagi ī shigukulu shenīshi; būlī ng'waka mukūshiyegela shikū mpungatī kū būtongi bo ng'wa SEEBA. Ī shenīshi shilī shilagīlo sha kūshinga ho shikū jose, pyī ū mu shibyalīlwe shing'we īsho shiliza; ī shigukulu shenīshi shikūbiza mu ng'weji gwa mpungatī. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.41",
            "verseOrgIds": [
              "LEV.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwikala mu maduku ikanza lya shikū mpungatī; pye a bana byalwa ba mu sī ya Isilaeli bakwikala ū mu maduku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.42",
            "verseOrgIds": [
              "LEV.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū mu gīko, a banhū ba shibyalīlwe shing'we bakūdeeba gīkī, a Baisilaeli aho nalīībīnja mu sī ya Misili nakabikaja mu maduku. Ū nene nalī SEEBA Mulungu wing'we. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.43",
            "verseOrgIds": [
              "LEV.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na lūūlū ū Musa ūbakumūkīja a Baisilaeli, ī shikū ja shigukulu sha ng'wa SEEBA ījo jalī jihelilwe.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.44",
            "verseOrgIds": [
              "LEV.23.44"
            ]
          }
        }
      ]
    }
