            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.27",
            "verseOrgIds": [
              "LEV.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū SEEBA ūng'wīla ū Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.28",
            "verseOrgIds": [
              "LEV.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawīlage a Baisilaeli gīkī, “Būlī munhū ūyo wenha shakwinha sha būsangī kūlī SEEBA, ibbudīka lyasho līkūbiza shitambò sha kūmfunīja SEEBA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.29",
            "verseOrgIds": [
              "LEV.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī shakwinha sha kūmfunīja SEEBA mu nzīla ya moto, ū mfunya washo akūshenha wei ng'wenekīlī na makono gakwe. A maguta akūgenha hamò nī shiguuku; hūna ī shiguuku ashiyengeeje kū būtongi bo ng'wa SEEBA, shibize shakwinha sha kūyengeejiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.30",
            "verseOrgIds": [
              "LEV.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū ngabīji akūgapemba a maguta ha ng'walīlo, alīyo ī shiguuku, ī shene shilī nyama ya ng'wa Alooni na bitūnja bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.31",
            "verseOrgIds": [
              "LEV.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū kūlūmbū kwa būlyo kwa shakwinha shing'we sha būsangī, ng'winhagi ngabīji, gūbize inong'ho ling'we kūlī we. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.32",
            "verseOrgIds": [
              "LEV.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū ng'witūnja o ng'wa Alooni ūyo alīgafunya a mininga na a mazezele ga shakwinha sha būsangī, akūsola ū kūlūmbū kwa būlyo gūbize ngabo gwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.33",
            "verseOrgIds": [
              "LEV.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū kūfuma mu shakwinha sha būsangī īsho Baisilaeli bakūfunya, ī shiguuku īsho shikayengeejiagwa naashisolaga, pyī nū kūlūmbū ūyo gūkafunyiagwa; nang'winhaga Alooni na bitūnja bakwe. Ū gwenūyo hū ngabo gwabo gwa būlī lūshikū ū kūfuma ū kū Baisilaeli.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.34",
            "verseOrgIds": [
              "LEV.7.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.34",
            "verseOrgIds": [
              "LEV.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū ngabo gwenūyo gūfumile ha shakwinha īsho akafunījiagwa SEEBA mu nzīla ya moto; h'ūyo Alooni na bitūnja bakwe bakahelelwa mu lūshikū lwa kūtūūlwa ha nīmo gwa būgabīji kū būtongi bo ng'wa SEEBA. Nūūlū gīkī, (Ī lyenīlī līl'ibbudīka lya kwīngīīla ha shakwinha īsho akafunījiagwa SEEBA mu nzīla ya moto; h'īlo Alooni akahelelwa hamò na bitūnja bakwe mu lūshikū lwa kūtūūlwa ha nīmo gwa būgabīji kū būtongi bo ng'wa SEEBA?) ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū mu lūshikū lwa kwitīīlwa kwabo maguta, ū SEEBA akalagīla gīkī a Baisilaeli bayūbinha ī shenīshi, gūbize ngabo gwabo gwa būlī lūshikū, ū mu shibyalīlwe shose īsho shiliza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na lūūlū a kenaka h'a kahelele ka mihayo ya shitambò sha kūpemva, shakwinha sha būsu, shitambò sha shibi, shitambò sha kwihīga, shakwinha sha kūtūūlwa ha nīmo, shakwinha sha būsangī. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "H'īsho SEEBA akang'winha Musa kū lūgūlū lwa Sinai mu lūshikū lwene wabalagīlaga a Baisilaeli kwenha shakwinha shabo kūlwa ng'wa SEEBA aho balī ng'witogolo lya kū lūgūlū lwa Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        }
      ]
    }
