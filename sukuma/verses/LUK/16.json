              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Abulahamu ūng'wīla hangī gīkī, ‘Balī nang'hwe ū Musa na a bahangi, ni babigwage benabo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.29",
            "verseOrgIds": [
              "LUK.16.29"
            ]
          }
        },
        {
          "name": "verse",
