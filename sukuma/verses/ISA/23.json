          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī myaka makumi mpungatī ūlū yūshikana, ū SEEBA akwīgeniha ī sī ya Tulo, hūna īkūshoka ū kū nīmo gwayo gwa būmalahya, yandye hangī kwīta būmalahya nago a mabūtemi gose ayo galī mu sī. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
              "ISA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwike ī solobo nī mheela ījo īlayūpandīka jikūtūūlwa kūlwa nguno ya ng'wa SEEBA; jitūbīkwa nūūlū kūbiswa hanhū; alīyo īsho akūyūshipandīka shikūbiza sha kūbagunanha abo bakikalaga mulī SEEBA, bayūpandīka shilīwa na shizwalo shawiza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.18",
            "verseOrgIds": [
              "ISA.23.18"
            ]
          }
        }
      ]
