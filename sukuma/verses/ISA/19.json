        "style": "s1"
      },
      "items": [
        {
          "text": "Būhangi wa kūkenaagūlwa Misili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
