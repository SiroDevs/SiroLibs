          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī y'ikūmi n'itandatū yūngwīla Hanania na baana bakwe na badūgūye; banhū ikūmi na babīlī. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.23",
