            }
          ]
        },
        {
          "text": "Ī y'ikūmi na kenda yūngwīla Maloti na baana bakwe na badūgūye; banhū ikūmi na babīlī. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.26",
