          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī y'ikūmi na īmò yūngwīla Azaleli na baana bakwe na badūgūye; banhū ikūmi na babīlī. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.18",
            "verseOrgIds": [
