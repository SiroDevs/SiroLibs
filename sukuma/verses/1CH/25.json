          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī y'ikūmi n'itanò yūngwīla Yelimoti na baana bakwe na badūgūye; banhū ikūmi na babīlī. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.22",
