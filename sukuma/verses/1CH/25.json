            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī y'ikūmi n'inè yūngwīla Maatisia na baana bakwe na badūgūye; banhū ikūmi na babīlī. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.21",
