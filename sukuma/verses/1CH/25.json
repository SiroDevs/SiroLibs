            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī y'ikūmi n'ibīlī yūngwīla Hashabia na baana bakwe na badūgūye; banhū ikūmi na babīlī. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.19",
