            "number": "1",
            "style": "v",
            "sid": "HAG 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu lūshikū lwa kwandya ng'weji gwa katandatū, ng'waka gwa kabīlī gwa Ntemi Dalio, mhayo go ng'wa SEEBA gūkiza mu nzīla ya ng'hangi Hagai; gwiza kūlwa nsugi wa Yuda, Zelubabeli ng'witūnja o ng'wa Shatieli; na ngabīji ntaale Yoshwa,",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.1",
            "verseOrgIds": [
              "HAG.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:1",
              "type": "text"
            },
            {
              "text": "Yoshwa:",
              "type": "text"
            },
            {
              "text": "Nūūlū, Yeshua.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ng'witūnja o ng'wa Yehozadaki.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.1",
            "verseOrgIds": [
              "HAG.1.1"
            ]
          }
        }
      ]
    },
    {
