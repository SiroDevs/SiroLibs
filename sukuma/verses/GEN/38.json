        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lyahayūshika ī likanza lya kūbyala kwakwe, yīīlonga gīkī walī na mabasa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.27",
            "verseOrgIds": [
              "GEN.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho alībyala, ū ng'wana ū wa kwandya akafunya nkono, ū ng'witūūja ūsola būlūba waza ūgūtunga ū nkono alīhaya, “Ū ntongi ū kūfuma ūūyū.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.28",
            "verseOrgIds": [
              "GEN.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alīyo kwimanīla wagūshokeja ū nkono gwakwe, ū ng'wiye h'ūyo ūfuma; ū ng'witūūja ng'wenūyo ūhaya, “Ni kinehe hangī ū bebe nang'ho wachiibīlīja gīko?” Na lūūlū ī lina lyakwe witanwa Pelezi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "38:29",
              "type": "text"
            },
            {
              "text": "Pelezi:",
              "type": "text"
            },
            {
              "text": "Īlī na mūkūlū ga kūchiibya, kwingīla, nūūlū kūfuma haanhū bo kūtūmamīla nguzu. Ūlū ni Nsukuma ni witanwa Machiibya.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna nū ng'wiye, ūyo walī nū būlūba ū waza ūfuma; ū ng'wene winhwa lina lya Zeela.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.30",
            "verseOrgIds": [
              "GEN.38.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "38:30",
              "type": "text"
            },
            {
              "text": "Zeela:",
              "type": "text"
            },
            {
              "text": "Būlabangīzu, nūūlū būūza (gītī shikolo shaza).",
              "type": "text"
            }
          ]
        }
      ]
