          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kūlwa koolecha gīkī ī shikū ja Pulimu jenīji shiigelile jiyūyegelwa ū ng'wikanza īlo lītūūlilwe ho, gīt'ūmo walī wabandīkīla ū Modekai ū Nyudaya nū ngole Esita, nū mumo baalī babonela gīkī shiigelile bīīte a boi benekīlī nī shibyalīlwe shabo ī sha ha numa yabo, ū mu mhayo gwenūyū ū gwa kūfunga na kūpīnīhala kwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
        },
        {
          "name": "verse",
