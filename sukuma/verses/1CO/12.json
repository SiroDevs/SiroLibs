  "reference": "1 Bakolinto 12",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
