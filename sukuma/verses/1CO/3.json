{
  "id": "1CO.3",
  "number": "3",
  "bookId": "1CO",
  "reference": "1 Bakolinto 3",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
