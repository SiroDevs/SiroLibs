      },
      "items": [
        {
          "text": "Mihayo ya kūmalīja ya ng'wa Daūdi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
