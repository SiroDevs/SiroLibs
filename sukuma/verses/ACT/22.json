          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna abo bahayaga kūmūgīlīja bisunda ha mhelo ī likanza lyenīlo; ū ntaale wa mabita akogoha no aho wabona gīkī gashinaga ū Paulo walī ūmò wa Balumi, alīyo hū walī wantunga!",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.29",
            "verseOrgIds": [
              "ACT.22.29"
            ]
          }
        }
