          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ng'waka gwa kadatū go būtemi bo ng'wa Asa ū ntemi wa Yuda, Baasha ng'witūnja o ng'wa Ahiya ūbiza ntemi wa Isilaeli ī yose; ūtema ikanza lya myaka makūmi abīlī n'īnè alī mu Tiliza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
            "verseOrgIds": [
              "1KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
