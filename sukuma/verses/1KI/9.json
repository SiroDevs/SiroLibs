              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Hilamu ūbatūma a banhū bakwe abo baalī bamanīīlile mihayo ya mu nyaza, būja kūtūmama ū mu meli hamò na a banhū ba ng'wa Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
            "verseOrgIds": [
              "1KI.9.27"
            ]
          }
        },
        {
          "name": "verse",
