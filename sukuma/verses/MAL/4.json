              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Managi gīkī nakūmutūmī ng'hangi Eliya aho lūtaalī kūshika ū lūshikū lwenūlo, ū lwa ng'wa SEEBA; ūlo lūlī lūtaale na lwa koogohya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akūbagalūcha a babyaji; ī ng'holò jabo jibagalūkīle a baana babo, na a baana ī ng'holò jabo jibagalūkīle babyaji babo; ūlū ītī chene nakwiza nītūle ī sī n'izumo.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.6",
            "verseOrgIds": [
              "MAL.4.6"
            ]
          }
        }
      ]
