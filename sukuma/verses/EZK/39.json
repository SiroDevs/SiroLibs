              "EZK.39.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 39:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alilūūlū, ū Seeba MULUNGU alīhaya gīkī, Ī haha lūūlū nakūng'wenha ū Yakobo kūfuma ū kū būding'wa, hama nakūbachīla shigongo pye a banhū ba Isilaeli, na nakūbiza na wilu kūlwa lina lyane lyeela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.25",
            "verseOrgIds": [
              "EZK.39.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī minala yabo bakwīyība, nū būlekūsanyiwa wabo pyī ū bose ūbo baanoolekejaga ū mu shikū jene bikalaga mhola aho balī mu sī yabo, ndūhū na wa kūbogohya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.26",
            "verseOrgIds": [
              "EZK.39.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 39:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūlū nalabashoshe kūfuma ū kū mahanga nūbabilinga kūfuma ū kū sī ja banishi babo, nakwiyoolecha kūbiza ng'wela mu nzīla yabo kū būtongi wa mahanga mingī. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.27",
            "verseOrgIds": [
              "EZK.39.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 39:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "A henaho hū bakūdeeba gīkī ū nene nalī SEEBA Mulungu wabo, nguno nūūlū īkī naalī nabatwala mu būsaamiwa kū sī ja mahanga, alīyo nahene nakūbabilinga hangī bize mu sī yabo, hama natūleka kū numa nūūlū ūmò wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.28",
            "verseOrgIds": [
              "EZK.39.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū būshū wane natalabūbisa hangī ū kūbo, nguno ī numba ya Isilaeli nakwīyitīīla Moyo wane, alīhaya Seeba MULUNGU.",
          "type": "text",
