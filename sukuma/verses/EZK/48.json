          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī mibita idatū ya kū lwande lo sukuma īkūbiza, mita gwa Lubeni, mita gwa Yuda, na mita gwa Lawī. Ī mibita ya nzengo pyī ī yose īkwitanwa a mina gayo kūlondeela ng'anda ja Isilaeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        }
