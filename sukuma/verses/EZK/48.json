          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lūganda lwa Yuda lūkūbīmbīkanwa nū lwa Lubeni kūfuma kīya kūshisha ng'weli, ngabo gūmò.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
