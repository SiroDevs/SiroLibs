  "reference": "2 Mihayo Ya Shikū 15",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
