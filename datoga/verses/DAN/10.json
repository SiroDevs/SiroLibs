{
  "id": "DAN.10",
  "number": "10",
  "bookId": "DAN",
  "reference": "Danieli 10",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
