{
  "id": "DAN.2",
  "number": "2",
  "bookId": "DAN",
  "reference": "Danieli 2",
  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
