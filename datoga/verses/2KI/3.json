{
  "id": "2KI.3",
  "number": "3",
  "bookId": "2KI",
  "reference": "2 Sugoodiga 3",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "2KI 3"
      },
      "items": [
        {
