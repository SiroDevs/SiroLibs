          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwayi buuneeda saw, ea measha ng'asheandaanyi, aba gideaba ghayi sirukusa buuneeda gideaba, “Adoashaayi ng'asheandaanyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
            "verseOrgIds": [
              "2KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu hean Eliyakimu, orjeeda Hilkiya ghayi was siida haw ambal gheeda sugoocheanda ea Shebina was ng'oorshoocheanda, ea Yoa, orjeeda Asafu was ng'oorshoocheanda geeweay heeda Hesekiya nea nibeara hang'weaka nyaawa ak geerukusa ng'asheega rugu shirikarajeandida hawiin.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.37",
            "verseOrgIds": [
              "2KI.18.37"
            ]
          }
        }
