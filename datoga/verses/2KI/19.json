              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghang'eat Senakeribu was sugoocheanda Ashuru, ak ghang'eat gabiikta ak gawa goobiida Ninawi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.36",
