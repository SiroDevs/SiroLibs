{
  "id": "EXO.33",
  "number": "33",
  "bookId": "EXO",
  "reference": "Riteayda 33",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "EXO 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "NG'UTAMIIDA ghwanung' ghang'amwa fuga Israeli giijeeda Sinayi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha NG'UTAMIIDA Musa, “Ang'eatng'eada aweayeena ang'iing'i ea buuneeda ghayi iiruuni ng'eanyiida Misri, ea ghwahita ng'eanyiida ghayi eayeaksi habeawooda Abrahamu, Isaka, ea Yakobo, nea geayeeshi, ‘Ng'eanyiini gaydaadaw jeacheengaagu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.1",
            "verseOrgIds": [
              "EXO.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaydeajeagu malaykajeandeanyu goosheedeaweey ak gaydahoan dearuuta fuga Ganaani, ea Hamori, ea Hiti, ea Berisi, ea Hafiti, ea Yebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.2",
            "verseOrgIds": [
              "EXO.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ascheang'da ea ahita ng'eanyiida gulda eanooga ea maleeda, ak ea mwajeascheang'da aniini ea agooga, gajiidu ghaanung' ooshealana aba naweeda, aba gideaba goowooschi fuga hang'oonyi iheeni.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.3",
            "verseOrgIds": [
              "EXO.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.3",
            "verseOrgIds": [
              "EXO.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iiyiiy buuneeda ng'asheesu munyasiin, hean geenyahuushi, ak ea manda siida akwa hang'weaka miyaas. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.4",
            "verseOrgIds": [
              "EXO.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda NG'UTAMIIDA ak gwayeesha Musa, “Eeshiina fuga Israeli, ‘Agooga goowooschi fuga hang'oonyi iheeni, inyas geashamnyeegwa ak ghaahidu bugusteang'wa, gaydaduulneegwa, asi biissa afwakta eagweegeagwa miyaasiin ak ghaanali gichea dasimaneegwa.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.5",
            "verseOrgIds": [
              "EXO.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghafwakta fuga Israeli eagweega nyaawa miyaasiin ghang'eada giijeeda Horebu ea ghwahita mwadi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.6",
            "verseOrgIds": [
              "EXO.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maheemajeanda mida madeeda NG'UTAMIIDA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.6",
            "verseOrgIds": [
              "EXO.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyeesa Musa gageanu maheemajeanda ak ghamiinda aba jarooda, was murdeeda museasooda nea goosheagiida museasooda, ak gaguura maheemajeanda siroondooscheesa. Ak siida wassean gasa gil aba heeda NG'UTAMIIDA inyeesa gawa jarooda heeda maheemajeanda siroondooscheesa, sheageewa museasooda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.7",
            "verseOrgIds": [
              "EXO.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea gwarita Musa gaweesa maheemajeanda, hean ghang'eatng'eat buuneesean, ak gaba siisi miinaada aba ghuuta maheemajeandaanyi, ak geeng'ula Musa, ea gawa jeeda maheemajeanda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.8",
            "verseOrgIds": [
              "EXO.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean nea gawa Musa jeeda maheemajeanda, ng'ata ghwararang'aan daraneeda shamooghooda ak ghamiinaada aba ghuuta maheemajeanda, ak abeeda goobalool NG'UTAMIIDA Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.9",
            "verseOrgIds": [
              "EXO.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean nea ghwadaah fuga sean daraneedida bea shamooghoodean, nea ghamiinaada aba ghuuta maheemajeanda, ghang'eatng'eat buuneesean ak gaba nih ghadoawan aba ghuuta maheemajeandaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.10",
            "verseOrgIds": [
              "EXO.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata goobalool NG'UTAMIIDA Musa aba ghuutaanyi, gawuurji gidabaloolda siida dea duupchi. Ak ghwayam geaw Musa gabiikta jeeda gheeda, nea siidaanyi bea gadiyeeda was Yoshuwa was orjeeda Nuni nea gudea baleanda, ea mang'amwana heeda maheemajeanda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.11",
            "verseOrgIds": [
              "EXO.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Heeleesiinda NG'UTAMIIDA sea fugaaschi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.11",
            "verseOrgIds": [
              "EXO.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda Musa ak gwayeesha NG'UTAMIIDA, “Ng'ula giyeeshiinean, ‘Ascheang'da fiisu’; nea minung' danal siida jea ajeakta deadeayi. Ak giyeeni, ‘Aniini ghaanaleay aba gheawungaagu, ak ea ninyasi dagheerjeanduumeeda aba madeedeanyu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.12",
            "verseOrgIds": [
              "EXO.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ghamneawa geamuscheey, iinaanyaschi dagheerjeanduumeeda aba madeadaang'u, ak ghaanaleay ak ghaanyaschi dagheerjeanduumeeda aba madeadaang'u. Apkaada gideaba eemeeni fugaagu.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.13",
            "verseOrgIds": [
              "EXO.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwayeesha, “Gajeeteayeena sea ang'iing'i, ak gaydagoonyi fuufta.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.14",
            "verseOrgIds": [
              "EXO.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda Musa ak gwayeesha niny, “Ak inyas ea meeteayeeni, abeeda adiing'aamwaneasa hiji. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.15",
            "verseOrgIds": [
              "EXO.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaydanaldaan gideaba naanyaschi dagheerjeanduumeeda aba madeadaang'u, aniini sea fugaagu? Inyas ea meeteayeeni, inyas geeteayi abeeda aniini ea fugaagu gajeewoosa fuga huumwa aba jeeda fuga sean bea badayda ng'eanyiida?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.16",
            "verseOrgIds": [
              "EXO.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.16",
            "verseOrgIds": [
              "EXO.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda NG'UTAMIIDA ak gwayeesha Musa, “Gaydasin eara ng'asheanji iriguun, aba gideaba ninyasi dagheerjeanduumeeda aba madeedeanyu, ak gaydanalnyi aba gheawungaagu.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.17",
            "verseOrgIds": [
              "EXO.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda Musa ak gwayeesha, “Geamuscheey ahiimnaan giigheambiitaang'u.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.18",
            "verseOrgIds": [
              "EXO.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwayeesha, “Gaydeasiik madeadaang'u miyindeanyu sean, ak gaydarukwiida gheawungeasu aba madeadaang'u ‘geawooschi NG'UTAMIIDA’; ak gaydaweat dea jea daweat, ak ghaadawji baydeayda dea jea dabayda.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.19",
            "verseOrgIds": [
              "EXO.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha, “Mwaydaaha gheamamdeanyu, aba gideaba manda siida jea ghwadaahan ak ea mwami.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.20",
            "verseOrgIds": [
              "EXO.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda NG'UTAMIIDA ak gwayeesha, “Ng'ula, hiji bea meatkweedeanyuun gaymiinaadawana badayda harearacheanda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.21",
            "verseOrgIds": [
              "EXO.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak damanda ng'ataawa gheambiiteanyu gaydayiinyi jeeda beashadeeda harearacheanda, ak gaydadukuteawaneey geatindeanyu bwak ea dang'ata, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.22",
            "verseOrgIds": [
              "EXO.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaydageanda geatindeanyu, abeeda gaydeaknanean bwadaw, nea gheamamdeanyu ea mwaydaaha.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.23",
            "verseOrgIds": [
              "EXO.33.23"
            ]
          }
        }
      ]
    }
  ],
