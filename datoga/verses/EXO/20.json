          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Adishisi ghaang' gheeda gischeewoocheandaang'u, adishisi ghaang' gatmooda gischeewoocheandaang'u ghana soomjeandaanyi, ghana hudaanyi bea gadiyeeda, ghana deadaanyi, ghana digeadaanyi, ghana gili wassean mideawa gischeewoocheandaang'u.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.17",
            "verseOrgIds": [
              "EXO.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Buuneeda ghabeal",
          "type": "text"
        }
      ]
    },
    {
