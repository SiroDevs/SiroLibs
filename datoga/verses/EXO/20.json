          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sisiina mureeda gweanu ea geamadu, ak abeeda ghwasaang'ayiit eawoojigaagu aba jeeda ng'eanyiida goonyi NG'UTAMIIDA was ASEATAANG'U.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.12",
            "verseOrgIds": [
              "EXO.20.12"
            ]
          }
        }
      ]
