          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Apkaada eaweeda Sabaato ak giimiidu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.8",
            "verseOrgIds": [
              "EXO.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gadiyeena eawooji lah, sina gadiyoojigaagu sean, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.9",
            "verseOrgIds": [
              "EXO.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "sighus eaweedeaba ispwa ea Sabaatoheeda NG'UTAMIIDA was ASEATAANG'U gil, eaweecheanji adisini gadiyeeda wassean ang'iing'i ghana orjeedang'u, ghana hudaang'u, ghana soomjeandaang'u, ghana hudaang'u bea gadiyeeda, ghana deadaang'u ghana rabascheandaang'u bea gheang'u ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.10",
            "verseOrgIds": [
              "EXO.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba gideaba NG'UTAMIIDA gagadiiy eawooji lah, ak gwasin humng'eeda ea ng'eanyiida ea basooda, ea haleanjeeda sean mida jeeda, ak gafuuf eaweedeaba ispwa, ng'ata ghoadaw NG'UTAMIIDA ghawooda eaweeda Sabaato nea ghoaghaydiit.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.11",
            "verseOrgIds": [
              "EXO.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
