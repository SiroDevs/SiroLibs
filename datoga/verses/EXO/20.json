            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gabaloola ASEETA ng'asheesu seaniin nea gwayi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.1",
            "verseOrgIds": [
              "EXO.20.1"
            ]
          }
        }
