              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gighasti hang'dida bea beashoodean aba ghunoojiga ak giyeadu sandakwajeanda muuwuunooda ak giyiini badayda, ak hang'dida bea beashoodean gaygooheeli heeda ghaydit ea heeda ghaydit muuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
