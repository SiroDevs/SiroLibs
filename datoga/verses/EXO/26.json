              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iina hoorgeeda baydeayda badayda sandakwajeanda muuwuunooda aba heeda ghaydit muuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
