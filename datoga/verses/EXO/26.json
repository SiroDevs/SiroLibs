          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gighasti aba uhuuda daranaji ang'wan bea rabeangheeda ak gidukuti aba dahaabu, ea gifungajeega dahaabu, mida uhuuda hoorgaji ang'wan bea lapiya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.32",
