        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.34",
            "verseOrgIds": [
              "EXO.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwalas NG'UTAMIIDA buuneeda aba geeyooda, aba meaydida sisin ghayi sin Haruniin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.35",
            "verseOrgIds": [
              "EXO.32.35"
            ]
          }
        }
