          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ak gaysina hoorgeeda gheaboonyaneeda sisna dahaabooda miyaas. Nea heeda hiing'aada ea darearjeanda hoorgeeda gheaboonyaneeda gajeataay; nea gikoombajeegaaschi, ea daghaniipkaaschi, ea deakghweadaanyi gaygwarina hijagi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.31",
            "verseOrgIds": [
              "EXO.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeeda gaygwanda dameal lah riteawa murdajeagaaschi, dameal samwagu bea hoorgeeda gheaboonyanga mida murdajeagaaschi gwarina meatkweanagi nea dameal samwagu gwarina murdeeda hoorgeeda gheaboonyaga aba meatkweeda niirja; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.32",
            "verseOrgIds": [
              "EXO.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea bayookcheew samwagu sisinda deakghweeda almondi, nea gaba nih mideawa daghaniipka ea deakghweeda, aba damealeandaanyi, ea bayookcheew samwagu sisinda deakghweeda almondi, nea gaba nih mideawa daghaniipka ea deakghweeda, aba uhuuda damealeanda nuut ak ea damealga alah rinna hoorgeeda gheaboong'nyeanda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.33",
            "verseOrgIds": [
              "EXO.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea uhuuda gheaboonyaneeda gwanda bayookcheew ang'wan sisinda almondi, nea manang'i mananuunat geeng'ooriida deakghweeda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.34",
            "verseOrgIds": [
              "EXO.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea manamba agi gaygwanda hing'eadayda damealeanjagi, ak gaba nih mida hiing'eadayba giliwas damwaalaan aba damealga alah rinna murdajeega hoorgeeda gheaboonyanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.35",
            "verseOrgIds": [
              "EXO.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea daghaniipkaaschi ea damealgaaschi gajea gilagi gil ak sean gajea gilagi aba gadiyeeda gidayda bea dahaabooda miyaas. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.36",
            "verseOrgIds": [
              "EXO.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaysisiina gheaboonyan ispwa ak gajeamiinda ak gayghaghwarda ghwayeat aba heeda was madeadaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.37",
            "verseOrgIds": [
              "EXO.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea ng'ushaptaanyi ea gweerajeagaaschi gajeesna dahaabooda miyaas. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.38",
            "verseOrgIds": [
              "EXO.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gajeesin aba dalaanteeda dahaabooda miyaas, ea dabita sean. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.39",
            "verseOrgIds": [
              "EXO.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ng'ula haleanjeeda sean sinda gidaahiimdaaydi aba uhuuda giijeeda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.40",
            "verseOrgIds": [
              "EXO.25.40"
            ]
          }
        }
      ]
