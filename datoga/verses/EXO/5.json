{
  "id": "EXO.5",
  "number": "5",
  "bookId": "EXO",
  "reference": "Riteayda 5",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
