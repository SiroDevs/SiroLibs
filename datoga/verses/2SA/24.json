{
  "id": "2SA.24",
  "number": "24",
  "bookId": "2SA",
  "reference": "2 Samweli 24",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
