            "number": "31",
            "style": "v",
            "sid": "2SA 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Dawdi Yoabu sea fuga sean mideawa, “Abwaashaada hang'weakeagwa, ak gookweali hang'weaka guniyajeega, ak gooyeawdi aba badayda Abneri.” Ak ghwaat geeshta daleanda sugoocheanda was Dawdi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.31",
            "verseOrgIds": [
              "2SA.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geebuy Abneri aba Hebroni; ak ghwajaat ghuut sugoocheanda ak gooyeawda aba heeda bung'eeda Abneri; ak gooyeawda buuneesean. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.32",
            "verseOrgIds": [
              "2SA.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gagutu sugoocheanda heareega Abneri, nea gwayi,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
