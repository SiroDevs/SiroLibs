          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea Adoramu goombal fuga gadiyeeda; nea Yehoshafati orjeeda Ahiludi ea siida adiiwi ng'asheega; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.24",
            "verseOrgIds": [
              "2SA.20.24"
            ]
          }
        },
        {
