          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea Shefa ea siida ng'oorshachi; nea Sadoki ea Abiyatari ea ashoohoodiga; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.25",
            "verseOrgIds": [
