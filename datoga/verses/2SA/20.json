              "type": "text"
            }
          ]
        },
        {
          "text": "Nea Yoabu abeeda ea shirikarajeanda haw ambal shirikareesean bea Israeli; nea Benaya orjeeda Yehoyada ea shirikarajeanda ambal fuga Gereti gil sea fuga Beleti; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
            "verseOrgIds": [
              "2SA.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
