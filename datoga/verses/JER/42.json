  "bookId": "JER",
  "reference": "Yeremiya 42",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "JER 42"
      },
      "items": [
        {
          "text": "42",
