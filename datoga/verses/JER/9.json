          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayi NG'UTAMIIDA, “Ng'ula gayghapka eawoojiga jea deargweaksa fuga siiyiil nea ghwasam fuga miyeeyiil– ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.25",
            "verseOrgIds": [
              "JER.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "was fuga Misri, ea Yuda, ea Edomu, was orjooga Amoni, ea fuga Moabu, ea fuga sean abiita jeeda eeshtearajeanda reegwa iheenga nyaawa goonuweagi buudeega nyaawa, aba gideaba eemoojisu miyeeyiil, nea gheeda sean bea Israeli ea miyeeyiil gurooruunatka.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.26",
            "verseOrgIds": [
              "JER.9.26"
            ]
          }
        }
      ]
