              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayi NG'UTAMIIDA: “Adiidu siida weaghoot ghaghwar geaw aba weaghuumeadaanyi, nea siida haw uur adiidu ghaghwar geaw aba uurdaanyi, ak eara meanang'ocheanda adiidu ghaghwar geaw aba meanang'oocheanduumeedanyi; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayi NG'UTAMIIDA, siida ghwar geaw ea daghwara geaw aba ng'asheanji, gideaba ghwanal gideaba geawooschi NG'UTAMIIDA ahiimu bariinyeega huumwa, ea doobiiwnata, ea alooheeda aba badayda ng'eanyiida, aba gideaba suh gea ahoosaneani gil.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.24",
            "verseOrgIds": [
              "JER.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
