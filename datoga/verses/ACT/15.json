  "bookId": "ACT",
  "reference": "Gadiyeeda Giijasoodiga 15",
  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "ACT 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Girgweageeda aba Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu ghapka fiisu ng'ay leabu ng'eanyiida Yahudi ak ghoanaal fuga siduupcheewi, nea gwayeesha, “Iimeeyaadeagwa ghasmeahooda gawuurji gidaghayi bea deaweedeeda Musa, abeeda ea majeelealneegwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.1",
            "verseOrgIds": [
              "ACT.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'asheanji ghwanung' gwardu sheang'nyeeda ak goobalool Bawlo ea Barnaba sea saawa, ak gealoat Bawlo ea Barnaba sea buuneeda mwaatkwa ak geanung' gaweay Yerusalemu heeda giijasoodiga ea heeda gweargwa ghoanyaashta ng'asheanji. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.2",
            "verseOrgIds": [
              "ACT.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea goojeakta ganiisa gaweay gwasik dageascheeda Foynike ea dea Samariya, nea gwaruku gideaba fuga Eemoojiga niyamsa geat ASEETA, ak gahoosan buuneesean aba badayda fuga siduupcheewi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.3",
            "verseOrgIds": [
              "ACT.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gaweay amahita Yerusalemu, ghwadeapta fuga ganiisa bea hooweaniin ea giijasoodiga ea gweargwa, hean geerukuta ng'asheega sean sin ASEETA aba badahuuka nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.4",
            "verseOrgIds": [
              "ACT.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu ghang'eat fih suuk mideawa masaweega was fuga Farisaayo, ak gwayi, “Ghwahit gideaba gajeayaat fiisu ghasmeahooda, ak geerukusi ghoang'waay deaweedeeda ghayi bea Musa.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.5",
            "verseOrgIds": [
              "ACT.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.5",
            "verseOrgIds": [
              "ACT.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghabwat geat giijasoodiga ea gweargwa ak gabaloola badaydeaba ng'asheanji. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.6",
            "verseOrgIds": [
              "ACT.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geebalool ea gageawiit baloolda, hean ghang'eat Betaro ak gwayeesha, “Ea fuga eaduupcheewi, agooga ghoanali gideaba ghayi aba mwadi ASEETA ghwaloadan aba bugusteang'wa, ak aba ghuuteanyu ghwayiiy fuga Eemoojiga ng'asheanda giijasta miy ak ghamwas. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.7",
            "verseOrgIds": [
              "ACT.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea ASEETA nal gurooruunatka buuneeda gamuuwu ng'asheanji ak ghoadaw saawa Guroorooda Ghaydit gawuurji gidaghayi goondaneasa aseasa; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.8",
            "verseOrgIds": [
              "ACT.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ea masina shiitmeeda aba aseasa ea saawa, ak goohuun gurooruunatka nyaawa aba masaweega. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.9",
            "verseOrgIds": [
              "ACT.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ghwasaan anda goosimsimnyi ASEETA ak ghoayiinyi gheatkweaka giinealanga yooki nea eara ghweanigaasa ghana aseasa ea mwoamu usi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.10",
            "verseOrgIds": [
              "ACT.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geamwaschi gideaba aseasa gajeelealneasa aba naweeda dagheerjeanduumeeda Ng'utamiida was Yesu eewuurjeewana saawa.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.11",
            "verseOrgIds": [
              "ACT.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.11",
            "verseOrgIds": [
              "ACT.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayi buuneesean saw; ak gooleeysiit Barnaba ea Bawlo nea gwarukwiisa buuneeda gwadeagooda ea ng'asheega deamdeameadi sin ASEETA aba jeenyaawa aba jeeda fuga Eemoojiga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.12",
            "verseOrgIds": [
              "ACT.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiit baloolda nyaawa, ghwasha Yakobo nea gwayeesha, “Fuga eaduupcheewi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.13",
            "verseOrgIds": [
              "ACT.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simon ghwasaan nea nirugu gidaghayi deaptaayda ASEETA fuga Eemoojiga, ak ghwaloat fiisu ng'ay aba jeenyaawa ghoah fugaaschi. Ak aba nih ghamwas ng'asheega sibanga, gawuurji gissing'oarda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.14",
            "verseOrgIds": [
              "ACT.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea ng'asheanji ghamwas muuchi ng'asheega sibanga, gawuurji gissing'oarda,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.15",
            "verseOrgIds": [
              "ACT.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.18",
            "verseOrgIds": [
              "ACT.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi girgweageedeanyu nihi, adoodeawiichi fuga Eemoojiga yamsa geat ASEETA, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.19",
            "verseOrgIds": [
              "ACT.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ging'oorsi gideaba adoayaaji hamichoojiga mideawa ririnnyeanda sanaamu ak ghwasaja geat hiseadayeanduumeeda ea gida siing'waay ghuuta ea foojeanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.20",
            "verseOrgIds": [
              "ACT.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba ghang'eada seaygoojiga gwandeawa Musa fuga rukwiida ng'asheagaaschi aba jeesinga giliwas mujiini, iissa geasoamwa gilinyoo ea sabaato gil aba jeesinga ghoorajeega siinealshacheewa.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.21",
            "verseOrgIds": [
              "ACT.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Barawajeanda sing'oorsa fuga Eemoojiga mideawa masaweega",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.21",
            "verseOrgIds": [
              "ACT.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghwadaah giijasoodiga ea gweargwa gideaba aamiy ea fuga sean bea ganiisa, gideaba ghwaloat fih iyeenya aba jeenyaawa ak ghwanung' gaweay ng'eanyiida Antiyokiya sea Bawlo ea Barnaba. Hean gealoat Yudayda siguura Barsaba, ea Sila, ak fiisu geanaal muuchi aba jeeda fuga siduupcheewi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.22",
            "verseOrgIds": [
              "ACT.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ghwaat barawajeanda sing'waardunu, “Fuga eaduupcheewi was giijasoodiga ea gweargwa, heeda fuga siduupcheewi was fuga Eemoojiga mida Antiyokiya ea Shaamu ea Gilikiya, ghaaghacheegwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.23",
            "verseOrgIds": [
              "ACT.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geeyiinyi gideaba gwanda fiisu ng'ay leabu ng'eang'deanya ak ghamwanmwaneegwa aba ng'asheega nyaawa, nea ghwanung' ea moapta ng'eanyi fughareengeagwa, nea ng'asheesu sin fiisuun ea meatawi aseasa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.24",
            "verseOrgIds": [
              "ACT.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak aba heedeanya aamiy gideaba gajeeneajeata gilagi, ak gealoat buuneeda ak geecheagu ng'eang'deang'wa nea goodeana fuga sibwariinyi was Barnaba ea Bawlo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.25",
            "verseOrgIds": [
              "ACT.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "fuga ghayi ramagu gabeagu eaweega nyaawa aba badayda Ng'utamiida was Yesu Gristo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.26",
            "verseOrgIds": [
              "ACT.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghamneawa geecheagu heedeang'wa Yuda ea Sila, ak gaygwarukuneegwa saawa ng'asheega uurji suh aba ghuusiga nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.27",
            "verseOrgIds": [
              "ACT.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak aamiy aba heeda Guroorooda Ghaydit ea heedeanya gideaba majeesareeneegwa seareani nuut geaghus haleanjeedida miiseegwean: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.28",
            "verseOrgIds": [
              "ACT.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea gideaba anung'waada hamichoojiga sighadoawana sanaamu ea foojeanda adoayaaji banyeega gidasiing'waay ghuuta ea hiseadayeanduumeeda. Abeeda iyooheeleewi geat haleanjeeni abeeda ghoatoabiiwji. Eebea seayu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.29",
            "verseOrgIds": [
              "ACT.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.29",
            "verseOrgIds": [
              "ACT.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu geecheakta gaweay, ng'eanyiida Antiyokiya ghabwada geat fuga mwas ASEETA, amahit geetayda barawajeanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.30",
            "verseOrgIds": [
              "ACT.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean nea geasoamwa barawajeandida ghwanung' gahoosan aba ng'asheega amajeek saawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.31",
            "verseOrgIds": [
              "ACT.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea Yuda ea Sila, abeeda saawa ea sibanga gil, hean goomajeek fuga siduupcheewi aba ng'asheega saang'a ak ghwanung' gamajeekcheewiidi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.32",
            "verseOrgIds": [
              "ACT.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata nea niibiida hoowa askwearjoojisu ng'ay goojeakta fuga siduupcheewi nea ghabeawa weada gabiiksa fugiga ghayi ajeaguun. [ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.33",
            "verseOrgIds": [
              "ACT.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'asheesu manda jeeda ng'ooruutkeaba garayi, Ghwadaa Sila gideaba ghwahit goobiida hoowa.] ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.34",
            "verseOrgIds": [
              "ACT.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean iidu goobiida Bawlo ea Barnaba Antiyokiya, nea goonealshi nea geerukwiida ng'asheanda Ng'utamiida, sea fih suuk saang'a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.35",
            "verseOrgIds": [
              "ACT.15.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bawlo ea Barnaba gwaheeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
