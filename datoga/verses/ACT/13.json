{
  "id": "ACT.13",
  "number": "13",
  "bookId": "ACT",
  "reference": "Gadiyeeda Giijasoodiga 13",
  "verseCount": 45,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
