            "sid": "2CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawlo, was giijasoocheanda Gristo Yesu aba gidabwariiyda ASEETA, ea Dimoteo was orjeedaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heeda ganiiseeda ASEETA mida Gorinto, sea fuga ghaydidi sean mida jeeda ng'eanyiida sean bea Akaya:",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gagasa anyasa dagheerjeanduumeeda ea weayda leabu heeda ASEETA was Ghweandeanya ea heeda Ng'utamiida was Yesu Gristo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bawlo gabadiischeesa ASEETA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gagasa eakghaambiida ASEETA, Bwaabeeda Ng'utamiideanya was Yesu Gristo, Bwaabeeda mideawa baydeayda, ASEETA geaniida salgheang'da sean, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.3",
            "verseOrgIds": [
              "2CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "geaniida salgheang'deanya sean ea sawanadeeda, ak abeeda geamuuschi eara aseasa eegeandeawana salgheang'da fugiga mida jeeda sawanaduutka seaniin, aba salgheang'da geandeawaneasa ASEETEAN. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.4",
            "verseOrgIds": [
              "2CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawuurji gissipareanyeata muuchi sawanaduutka Gristo, gwasunu aba naweeda Gristo geepareanyi muuchi eara geandeayda salgheang'da. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.5",
            "verseOrgIds": [
              "2CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu aseasa iisisawaneasa, gweagu geandeayda oogeandeawaneasa salgheang'da, ea lealeanooda; ama sigeandeawaneasa salgheang'da, gweagu geandeayda oogeandi salgheang'da, ak ghoanali aba damanda oamilikghtaawi nea ghoarjeang'di aba sawanaduutkiga sisawaneasa aseasaan. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.6",
            "verseOrgIds": [
              "2CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea gidida sirarji aba heedeang'wean ea majeetuumduum; aba gideaba geanali gidida oopareanyeati sawanaduutkaasaan, abeeda gajoopareanyeana geandeayda salgheang'deanya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba aseasa meegasi adasheahiita, fuga eaduupcheewi, aba badayda sawanadeedida sinyaschi aba ng'eanyiida Asiyahiin; aba gideaba aseasa geewooschi hidaat, gearaanyi eamilikghta ak ghang'aleasa ea ealagaana eara aba eaweega. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.8",
            "verseOrgIds": [
              "2CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasaan, geaghanyi gili ninyas girgweaksiinda miyeeda; gabaysiina gideaba gayghwanung' eahuuwa fuga huumwa ak ea mii aseasa gil eara aba heeda ASEETA aduutu fuga nimeewa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.9",
            "verseOrgIds": [
              "2CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "niny ghoaghuuhaneasa jeeda washta haw bea miyeeda, ak gaygabiikta ghoaghuuheasa; nea aseasa ea sirarji niny gideaba gaygabiikta ghoaghuuheasa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.10",
            "verseOrgIds": [
              "2CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eara agooga aweadeasa aba mooshta ASEETA, ak abeeda gabadiischeesa fuga saang'a aba badahuukaasa aba badiischeesiindida ghayi sigooneasa aseasa aba sheayda mooshcheenga saang'a aba heeda ASEETEAN.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giyamwaata badiida Bawlo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba aseasa geaghwari geat ng'asheanji, nea gidida muuwu fughareengaasaan gil ak ghoah gissibeadi aba jeeda ng'eanyiida, ak gabiissa ghwaraanya muuchi aba heedeang'wa, aba ghaydidanda ea badita ASEETA bea huumwa, nea mii aba weaghuumeeda ng'eanyiida gil geaghus aba dagheerjeanduumeeda ASEETA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.12",
            "verseOrgIds": [
              "2CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea manda ng'asheanda sing'oorneegwa geaghus giika oamuuschi oasoamwana ak ghoanaliin; ak ghaararji aniini gideaba gajanala ng'asheesu muuchi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.13",
            "verseOrgIds": [
              "2CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "gawuurji gidida oanaldi gilimwanang' ng'asheega mwaatkwaan, ak abeeda googwareesi aba badahuukaasa gawuurji gichea eebeaheataneegwa aseasa aba eaweeda Ng'utamiida was Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghaanali ng'asheanji, hean geagasayi doan heedeang'wa aba mwadi, ak abeeda ghoanyaschi hooseaneega deabiyeenya; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.15",
            "verseOrgIds": [
              "2CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak geegasayi dabareeseegwa nea ghaang'ati dawa Makedoniya, amang'ata geayamu geaw doan Makedoniya, ak geabiigu ng'eang'deang'wa ak abeeda ghaanyaschi weeta aba heedeang'wa aba bareanyeekeasu jea dawa ng'eanyiida Yahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.16",
            "verseOrgIds": [
              "2CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neada aniini ghaayamyamnyi geawi iyeagasayi dasin ng'asheanji? Neada geasinyi badiideanyu aniini ak geawuurjeewi siida ng'eanyiida, ak ghwahit iyeayeenyi Ea ghana Manda aba damanagi? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.17",
            "verseOrgIds": [
              "2CO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea aba huumwa aba gidadoabiiwaata ASEETA, ng'asheandeanya aba heedeang'wa ea mii Ea gil ea Manda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.18",
            "verseOrgIds": [
              "2CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba Orjeeda ASEETA, was Gristo Yesuun ghayi siruku iitaanyi aba jeedeang'wa, Silwano ea Dimoteo ea aniini, mii Eahi ghana Manda; nea aba jeedeaba niny galeagasean iissa ea Ea gil. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.19",
            "verseOrgIds": [
              "2CO.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba heeleesiinda sean bea ASEETA iissa ghwanyas Ea aba jeadaanyi. Nih gissirukuuni Amin gil aba badaydaanyi, aba giigheambiita ASEETA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.20",
            "verseOrgIds": [
              "2CO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea ASEETA gil dea amajeegiideasa aba naweeda Gristo, ak ghoah dea rukuneasa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.21",
            "verseOrgIds": [
              "2CO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea niny ea siida ghayi arooreasa gil, ak gagoaneasa Gurooroadaanyi ak ghwayiin jeesinga gurooruunatkaasa ak gawuurji raduutka.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.22",
            "verseOrgIds": [
              "2CO.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.22",
            "verseOrgIds": [
              "2CO.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu geeguursi ASEETA ghoah muushoocheandeanyu, ak abeeda iyaawunyi ea moanyasi sawanadeeda ak ghoah gissiiteelsiinanean hinnooda Gorinto. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.23",
            "verseOrgIds": [
              "2CO.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CO 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea mii gideaba geegasayi eepala masaweegeagwa; geegadiiyi sea agooga aba hooseaneegeagwa, aba gideaba ghoamiinaadi muuchi aba masaweegeagwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.24",
            "verseOrgIds": [
              "2CO.1.24"
            ]
          }
        }
      ]
    }
  ],
  "next": {
