  "reference": "2 Gorinto 10",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "2CO 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bawlo ghaweat geaw aba gadiyeadaanyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniini Bawlo, geamuscheegwa nea gabwageaw, aba garbabanda ea ng'eeninda Gristo, nea iissa geawooschi ng'eeni aba gheanyangeagwa, nea iyeawooschi sheageewaneegwa geawooschi daruus!– ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.1",
            "verseOrgIds": [
              "2CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi geamuscheegwa gideaba iisindeayi ea mwaahiimni dargooda aba gidida aamwaschiin ak geahiimsi fuga rar gideaba aseasa geayaachi geeshta ng'asheega gasa ng'eanyiida. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.2",
            "verseOrgIds": [
              "2CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Earapeadi sindi ng'eanyiidean aseasa meeng'ucheewani fuga mida ng'eanyiida, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.3",
            "verseOrgIds": [
              "2CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba gideaba dabiteanya sing'ucheati maba saseeda suh gwandeawa uurda ASEETA ak gwanyarja uurda lugooda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.4",
            "verseOrgIds": [
              "2CO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geenyarji fughareenga sean gasa goodiing'u geat aba badayda fughareeda ASEETA, ak geaghaschi giliwas fughara ak abeeda gwasissa mureeda Gristo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.5",
            "verseOrgIds": [
              "2CO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea geewooschi hidaat eayaagana ghoorjooda fuga manda mureeda, damanda hida mureedeang'wa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.6",
            "verseOrgIds": [
              "2CO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.6",
            "verseOrgIds": [
              "2CO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ang'ula haleanjeeda mida madeeda gheanyangeagwa. Siida iirar gideaba gaba Gristo ea dapkaatunu niny gideaba niny siida Gristo, ada abeeda eara aseasa geawooschi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.7",
            "verseOrgIds": [
              "2CO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Earapeadi aaghwarji geaw gil mwanang'iin aba gheambalmeeda sindeawi, ghayi gooneasa Ng'utamiida ak abeeda gedeekneegwa nea mii gideaba gajeenyarjaneegwa, ghanyea majeapwaaspwaasan. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.8",
            "verseOrgIds": [
              "2CO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meagasi eadaah gideaba geagasayi deamuuweegwa aba barawajeega. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.9",
            "verseOrgIds": [
              "2CO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba gwayeena, “Barawajeegaaschi ea durumani nea gwandeawa uurda nea saseadaanyi iimida hiji ea ng'arng'ar, nea eara girgweageadaanyi geefool.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.10",
            "verseOrgIds": [
              "2CO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuga sunu gagasa ghwanal gideaba ng'asheega sirugu aba barawajeanda damanda meandeewani hiji, iissa geesinyi iimida hiji. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.11",
            "verseOrgIds": [
              "2CO.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mii gideaba geegasayi eebadaksiina eahaadana geat fuga gwara geadi ghana eegalana geat fuga adiing'u geat gil. Hean nea gaba siisi adeena geaw niirja, ak gaba siisi gala geaw niirja, ak ghanyea manda gida nal.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.12",
            "verseOrgIds": [
              "2CO.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.12",
            "verseOrgIds": [
              "2CO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak aseasa ea mwajeaghwara geat ea ghwanaawda, geaghus gheadeendida gooneasa ASEETEAN, nea gideaba gajeamuusa eahina heedeang'wa gil. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.13",
            "verseOrgIds": [
              "2CO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea meataardani geat ea ghwanaawa gheadeendeanya, nea eara gwasa ghanyea miyeehina heedeang'wa; aba gideaba geewooschi fuga madeeda asheeda ghwahidu heedeang'wa nea geeyeadu Giijasta miy bea Gristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.14",
            "verseOrgIds": [
              "2CO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea mwajeaghwara geat ea ghwanaawa deascheeda aba sawanadeeda buuneeda suurja gil; abeeda geandeawi rarooda gideaba gaygwaheedu masaweegeagwa gagasa gwaheedu gadiyeedeanya aba jeedeang'wa, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.15",
            "verseOrgIds": [
              "2CO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak abeeda gajeamuusa eerukwiida giijasta miy aba darooraka suurja sheageewaneegwa, nea meaghwari geat aba gadiyeeda ning'ata sinooda aba jeemba madamnyeamba sih nuut. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.16",
            "verseOrgIds": [
              "2CO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Neada siida ghwargeaw, ghaghwara geaw Ng'utamiida.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba mii siida gwara geawiin gil jea eamwas geaghus siidida jea ghaghwar Ng'utamiidean.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.18",
            "verseOrgIds": [
              "2CO.10.18"
            ]
          }
        }
      ]
    }
  ],
