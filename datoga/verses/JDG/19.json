        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.26",
            "verseOrgIds": [
              "JDG.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghang'eat sakteayda siyeadaanyi, ak ghwajaat ghuusiga gealga, ak gwarita jarooda gagasa gawa, ak ging'ulayi, gatmoodida was gwealeadaanyiin niibeedeaysa ghuuta gheeda nea geatingaaschi ghoang'waanya gidaghuudi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.27",
            "verseOrgIds": [
              "JDG.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
