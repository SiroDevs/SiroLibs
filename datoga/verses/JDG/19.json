            "number": "29",
            "style": "v",
            "sid": "JDG 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean nea nuwa jeedeaba gheanyi, gageanu barda, ak ghoang'waayi gwealeadaanyi, ak gwalaku banyeega saseadaanyi ea ghwanyiit mooneeda was damaniyeenya, ak ghwaat moonghajeega sean bea Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.29",
            "verseOrgIds": [
              "JDG.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean fuga sean daah ng'asheandida gwayi, “Ng'asheanda uurji nih miyeesin nea ea miyeedaah gidang'eada eaweeda rinna diibiga Israeli ng'eanyiida Misri bwak ea ghoah ghamneawa, asi ooteemsheena, ak ghoalaji girgweageeda, ak goorugu.”",
          "type": "text",
