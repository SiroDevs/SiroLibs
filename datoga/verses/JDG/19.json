          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha, “Asi ng'eada eeweaya.” Ak ea mwanya ghuuta, hean gagatkat, ak ghwayiin badayda digeeda, hean ghang'eat gawa siidida, ak gawa hichpa geaw. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.28",
            "verseOrgIds": [
              "JDG.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
