          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Shimron-meroni, sugoocheanjagi bea Akshafu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.20",
            "verseOrgIds": [
              "JOS.12.20"
            ]
          }
        },
        {
          "name": "verse",
