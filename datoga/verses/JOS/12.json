          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Afeki, sugoocheanjagi bea Lasharoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.18",
            "verseOrgIds": [
              "JOS.12.18"
            ]
          }
        },
        {
