          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Makeda, sugoocheanjagi bea Beteli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.16",
            "verseOrgIds": [
              "JOS.12.16"
            ]
          }
        },
        {
          "name": "verse",
