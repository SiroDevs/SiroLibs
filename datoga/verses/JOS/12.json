          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Madoni, sugoocheanjagi bea Hasori, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.19",
            "verseOrgIds": [
              "JOS.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
