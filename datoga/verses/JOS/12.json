          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Dirsa, ak sugoodiga sean ea diktam ea damwanagi.",
          "type": "text",
          "attrs": {
