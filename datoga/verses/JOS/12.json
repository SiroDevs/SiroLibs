            "sid": "JOS 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Daanaki, sugoocheanjagi bea Megido, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.21",
            "verseOrgIds": [
              "JOS.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Gedeshi, sugoocheanjagi bea Yoknemu bea Garmeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.22",
            "verseOrgIds": [
              "JOS.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Dori bea Nafat-dori, sugoocheanjagi bea Goimu bea Galilaya, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.23",
            "verseOrgIds": [
              "JOS.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
