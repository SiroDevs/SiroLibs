          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Dapua, sugoocheanjagi bea Heferi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.17",
            "verseOrgIds": [
              "JOS.12.17"
            ]
          }
        },
        {
          "name": "verse",
