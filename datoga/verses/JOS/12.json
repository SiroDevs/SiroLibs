          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.6",
            "verseOrgIds": [
              "JOS.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh sugoodiga ng'eanyiida ghayi joar Yoshuwa gil sea fuga Israeli laabwa Yordani heeda biyeara ghang'eada Baal-gadi mida moangoachiyda Lebanoni ea ghwahita Giijeeda Halaki, deaschi sea Seyiri (ak Yoshuwa ghoadaw ng'eanyiida nyaawa eemeeda Israeli goombal ak gaba nih bea ng'eanyiidaanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.7",
            "verseOrgIds": [
              "JOS.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "jeeda ng'eanyiida heayeeniga, ea moohajeega, ea ng'eanyiida Araba, ea gea gudung'unyoojiga, mida dareapcheeda, ea Negebu, ea ng'eanyiida Hiti, ea Amori, ea Ganaani, ea Berisi, ea Hafiti, ea Yebusi): ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.8",
            "verseOrgIds": [
              "JOS.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sugoocheanjagi bea Yeriko, sugoocheanjagi bea Ayi, mida murdeeda Beteli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.9",
            "verseOrgIds": [
              "JOS.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Yerusalemu, sugoocheanjagi bea Hebroni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.10",
            "verseOrgIds": [
              "JOS.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Yarmuti, sugoocheanjagi bea Lakishi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.11",
            "verseOrgIds": [
              "JOS.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Egloni, sugoocheanjagi bea Geseri, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.12",
            "verseOrgIds": [
              "JOS.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Debiri, sugoocheanjagi Gederi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.13",
            "verseOrgIds": [
              "JOS.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Horma, sugoocheanjagi bea Aradi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.14",
            "verseOrgIds": [
              "JOS.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "sugoocheanjagi bea Libina, sugoocheanjagi bea Adulamu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.15",
            "verseOrgIds": [
              "JOS.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
