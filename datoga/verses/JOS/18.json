        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lachooda ng'eanyiida abit",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghabwat geat fuga sean bea Israeli aba ng'eanyiida Shilo, ak geamiinda maheemajeanda siroondooscheesa aba hoowa; nea abeeda ea nijoar fuga Israeli fugeaba ng'eanyiita.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.1",
            "verseOrgIds": [
              "JOS.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.1",
            "verseOrgIds": [
              "JOS.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda aba jeeda fuga Israeli siipuut eemooji ispwa gea miyeelakiisa heechea gwahearan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.2",
            "verseOrgIds": [
              "JOS.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Yoshuwa fuga Israeli, “Heapi gajawoosa ng'arng'ari ea ghoah eeju aba beata jea aweayeena ak googeandi ng'eanyiida, ghayi gooneegwa NG'UTAMIIDA was ASEETA ghweanigeagwa? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.3",
            "verseOrgIds": [
              "JOS.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi daba eemeeni loat fih samwagu ak gaydeajeakta saawa ak gayghang'eatng'eat ghwararang'aada gaweay ng'eanyiida ak ghang'oar haleanjeeda nyaawa jea gwahearan ak gabiigu heedeanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.4",
            "verseOrgIds": [
              "JOS.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak fiisu gaygwalaja ng'eanyiida niba ispwa, Yuda gaygoobiida ng'eanyiidaanyi bea wiilooda ng'eanyiida biyeara, ak fuga gheeh Yosefu gaygoobiida ng'eanyiida nyaawa bea wiilooda ng'eanyiida ghayeawa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.5",
            "verseOrgIds": [
              "JOS.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gajalaja ng'eanyiida niba ispwa amwahit gooyeadu ng'ooruutka heedeanyu, ak gaydaloat aba badaydaang'u, aba hiji bea madeeda NG'UTAMIIDA was ASEETEANg'wean. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.6",
            "verseOrgIds": [
              "JOS.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak fuga Lawi majeatawa gil aba bugusteang'wa, aba gideaba ashoohoocheanduumeeda NG'UTAMIIDA gichea gwahearan gil; nea Gadi ea Rubeni ea eemeeda silach bugusta nibiyeenya bea Manase ea ninyas hearaniischooda nyaawa aba giigheawda Yordani bea heeda ghayeawa, ghayi adaw Musaheeda was siida gadiyeeda NG'UTAMIIDA saawa.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.7",
            "verseOrgIds": [
              "JOS.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.7",
            "verseOrgIds": [
              "JOS.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghoang'eat buuneeda bareanyeeka nyaawa; ak goobalool Yoshuwa fugiga weay ghang'oar ng'asheegeaba ng'eanyiita, nea gwayeesha, “Aweayeena Ascheang'da ak ghoang'waarji ng'asheega ng'eanyiida, ak goobiigu heedeanyu; ak gaydaloat aba hiji bea madeeda NG'UTAMIIDEAN aba ng'eanyiida Shilo.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.8",
            "verseOrgIds": [
              "JOS.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gaweay buuneeda ak gwasik bugusta ng'eanyiida nea geeng'oorsa ng'asheagaaschi jeeda gitaabu, nea gwalaja mujiinajeagaaschi ghoah ispwa, ng'ata geebiiksa Yoshuwa aba museasooda aba Shilo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.9",
            "verseOrgIds": [
              "JOS.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ghwaloat Yoshuwa aba badahuuka nyaawa aba madeeda NG'UTAMIIDA aba Shilo, ng'ata gwalakiisa Yoshuwa fuga Israeli ng'eanyiida ak gaba nih adaw headaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.10",
            "verseOrgIds": [
              "JOS.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng'eanyiida silaksa Benjamini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.10",
            "verseOrgIds": [
              "JOS.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu ghwahidu loota eemeeda Benjamini sea fuga gealga nyaawa, ak ng'eanyiida siloat gwarina bugusta eemeeda Yuda ea eemeeda Yosefu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.11",
            "verseOrgIds": [
              "JOS.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moonghooda nyaawa aba wiilooda ng'eanyiida ghayeawa ghang'eada Yordani; hean gawa moonghooda ea gwascheeng'sa wiilooda ng'eanyiida ghayeawa mida gayeewda Yeriko, ak gwascheeng'sa ng'eanyiida heayeeniga biyeara; ak gamuudeana dareapcheeda Bet-afeni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.12",
            "verseOrgIds": [
              "JOS.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghang'eada moonghooda hoowa ak gawa gwasik wiilooda ng'eanyiida biyeara nea gagal Lusa, ak gwadiyeesa Lusa (nea Beteli gil) hean ghwararang'aada moonghooda ea ghwahita Ataroti-adari neekeewa giijeeda mida wiilooda ng'eanyiida biyeara bea Bet-horoneeda hiing'aada. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.13",
            "verseOrgIds": [
              "JOS.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gawa moonghooda meatkweeda nuut, ak gwayamna geaw heeda biyeara bea meatkweeda wiilooda ng'eanyiida biyeara, ak ghang'eada giijeeda mida wiilooda ng'eanyiida biyeara, duukusa Bet-horoni, ak gamuudeana Giriat-baali (nea nih ea Giriat-yeariimu), was mujiineeda eemeeda Yuda. Mida meatkweeda biyeara. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.14",
            "verseOrgIds": [
              "JOS.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba meatkweeda wiilooda ng'eanyiida biyeara ghang'eada murdeeda Giriat-yeariimu; ak gawa moonghooda ghang'eada hoowa ea ghwahita Efroni, mida gheang'deenda Neftowa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.15",
            "verseOrgIds": [
              "JOS.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "hean gawa moonghooda ghwararang'aada ea gawa moonghooda giijeeda deaschi moangoachiyda orjeeda Hinomu; mida wiilooda ng'eanyiida ghayeawa mida moangoachiyda fuga Refayimu, hean gawa nea ghwararang'aada ea ghwahita moangoachiyda Hinomu, mida wiilooda ng'eanyiida biyeara bea murdeeda fuga Yebusi, ak ghwararang'aada ea gawa Enrogeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.16",
            "verseOrgIds": [
              "JOS.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "hean geenung' gagal wiilooda ng'eanyiida heeda ghayeawa ak gawa ea ghwahita En-shemeshi, ak gwarita ea ghwahita Geliloti, deaschi Adumimu; ak ghwararang'aada ea ghwahita lagheaneeda Bohani was orjeeda Rubeni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.17",
            "verseOrgIds": [
              "JOS.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gwasik wiilooda ng'eanyiida ghayeawa mida murdeeda Bet-araba, ak ghwararang'aada ea gawa Araba; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.18",
            "verseOrgIds": [
              "JOS.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "hean gawa moonghooda gwasik wiilooda ng'eanyiida ghayeawa mida murdeeda Bet-hogla; ak moonghooda gabiikna wiilooda ng'eanyiida ghayeawa bea ghwanadeeda Basooda Balang'da, mida wiilooda ng'eanyiida biyeara bea Yordani; nih moonghooda gil aba wiilooda ng'eanyiida biyeara. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.19",
            "verseOrgIds": [
              "JOS.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak Yordani ea moonghoadaanyi gil aba meatkweeda ghayeawa. Nih gwahearan eemeeda Benjamini sea fuga gheanyaawa, ak gwaneaweesa moonghooda meadajeega sean.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.20",
            "verseOrgIds": [
              "JOS.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.20",
            "verseOrgIds": [
              "JOS.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak mujiinajeega eemeeda Benjamini sea fuga gheanyaawa ea Yeriko gil, ea Bet-hogla, ea Emek-gesisi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.21",
            "verseOrgIds": [
              "JOS.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bet-araba, ea Semaraimu, ea Beteli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.22",
            "verseOrgIds": [
              "JOS.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afimu, ea Bara, ea Ofra, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.23",
            "verseOrgIds": [
              "JOS.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gefar-amoni, ea Ofni, ea Geba mujiinaji damaniyeenya sea gharang'weakaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.24",
            "verseOrgIds": [
              "JOS.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibeoni, ea Rama, ea Be-eroti, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.25",
            "verseOrgIds": [
              "JOS.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mispa, ea Gefira, ea Mosa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.26",
            "verseOrgIds": [
              "JOS.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rekemu, ea Irpeli, ea Darala, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.27",
            "verseOrgIds": [
              "JOS.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 18:28"
          },
          "items": [
            {
