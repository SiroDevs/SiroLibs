{
  "id": "JOS.15",
  "number": "15",
  "bookId": "JOS",
  "reference": "Yoshuwa 15",
  "verseCount": 63,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JOS 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng'eanyiida siitaw Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'eanyiida siloat siitaw eemeeda Yuda ea fuga gheanyaawa ghang'eada wiilooda ng'eanyiida biyeara ea ghwahita moonghooda Edomu, ea ghwahita dareapcheeda Sini mida wiilooda ng'eanyiida biyeara. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.1",
            "verseOrgIds": [
              "JOS.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moonghooda nyaawa bea wiilooda ng'eanyiida biyeara ghang'eada muudeanooda Basooda Balang'da, ea ghwahita geatindida gal wiilooda ng'eanyiida biyearean; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.2",
            "verseOrgIds": [
              "JOS.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gawa nea gagal wiilooda ng'eanyiida biyeara ak ghwascheang'da gawa Akrabimu, ak gawa ea ghwahita Sini, ak gawa ea ghwahita wiilooda ng'eanyiida biyeara bea Gadesh-barneya, ak gawa ea gwaneekiisa Hesroni ea ghwahita Adari, ak gwaneaweesa ea gawa Garka, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.3",
            "verseOrgIds": [
              "JOS.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ghang'ata ea gawa Asmoni, ak gawa ea ghwahita eenda Misri, ak ghwahidu ea gagul muudeanooda basooda. Nih moonghoodeang'wa gil aba meatkweeda wiilooda ng'eanyiida biyeara. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.4",
            "verseOrgIds": [
              "JOS.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak moonghooda aba heeda ghayeawa gajea Basooda Balang'da gil, ea ghwahita ghuuta Yordani. Ea ghwahita moonghooda wiilooda ng'eanyiida ghayeawa, ghang'eada geatinda basooda bea ghuuta Yordani; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.5",
            "verseOrgIds": [
              "JOS.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gawa moonghooda ghwascheang'da ea ghwahita Bet-hogla, ak gawa gwasik wiilooda ng'eanyiida ghayeawa bea Bet-araba; ea moonghooda siyeang'da ea ghwahita lagheaneeda Bohani was orjeeda Rubeni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.6",
            "verseOrgIds": [
              "JOS.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghwascheang'da moonghooda ea ghwahita Debiri ak ghang'eada moangoachiyda Akori, ak gawa nea gagal wiilooda ng'eanyiida ghayeawa, nea gagal Gilgali, duukusa meatkweeda Adumimu, mida meatkweeda wiilooda ng'eanyiida biyeara bea moangoachi, ea moonghooda sik ghuuta beega En-shemeshi, ea muudeanooda Enrogeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.7",
            "verseOrgIds": [
              "JOS.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "hean gawa moonghooda ghwascheang'da nea gwasik moangoachiyda orjeeda Hinomu mida wiilooda ng'eanyiida biyeara mida ng'eanyiida fuga Yebusi (nea Yerusalemu gil); ea moonghooda weah ghwascheang'da ea ghwahita uhuuda giijeeda duukusa moangoachiyda Hinomu, mida heeda biyeara, bea wiilooda ng'eanyiida ghayeawa bea muudeanooda moangoachiyda fuga Refayimu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.8",
            "verseOrgIds": [
              "JOS.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "hean geang'eada moonghooda uhuuda giijeeda mida gheang'deenda Neftowa, ak ghang'eada hoowa ea ghwahita mujiineeda Efroni; ak gawa moonghooda ea gwaneaweesa Baala (nea Giriyat-yearimu gil); ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.9",
            "verseOrgIds": [
              "JOS.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ghwala moonghooda dirbeayda Baala ak gawa nea gwarakta ea ghwahita giijeeda Seyiri ak ghang'eada hoowa ea gawa meatkweeda giijeeda Yearimu mida meatkweeda wiilooda ng'eanyiida ghayeawa (nea Gesaloni gil), ak ghwararang'aadawa Bet-shemeshi ak gawa ea gwaneekiisa Dimna; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.10",
            "verseOrgIds": [
              "JOS.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gawa moonghooda ea ghwahita meatkweeda heayeeda Ekroni, mida wiilooda ng'eanyiida ghayeawa, ak gawa ea ghwahita Shikroni, ak gawa ea ghwahita Giijeeda Baala, ak gawa ea ghwahita Yabneeli; ak ghwahidu moonghooda ea gagul muudeanooda basooda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.11",
            "verseOrgIds": [
              "JOS.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea moonghooda mida heeda biyeara gawa ea ghwahita basooda haw moonghoadaanyi. Nih moonghooda neaweesa fuga Yudahi gawuurji giteena fuga nyaawa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.12",
            "verseOrgIds": [
              "JOS.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Galebu ghoang'waay ng'eanyiida Hebroni ea Debiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.12",
            "verseOrgIds": [
              "JOS.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gidarukusiinda NG'UTAMIIDA Yoshuwa, gideaba ghoadaw Galebu orjeeda Yefune ng'eanyiida aba bugusta fuga Yuda, was Giriat-arba, nea Hebroni gil (Araba abeeda ghweanda Anaki gil). ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.13",
            "verseOrgIds": [
              "JOS.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu Galebu ghahoana hoowa orjoogiga asamwagu bea Anakiin, nea Sheshai gil ea Ahimani ea Dalmayi, nea jeata Anakihi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.14",
            "verseOrgIds": [
              "JOS.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwascheang'daawa hoowa ak gaweesa fuga Debiri; gheawunga Debiri ghayi aba mwadi was Giriat-seferi gil. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.15",
            "verseOrgIds": [
              "JOS.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda Galebu ak gwayi, “Siida jea ghabwar ak ghwajoar Giriat-seferi, abeeda gaydaadaw hudeanyu was Agsa ghoah gatmoadaanyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.16",
            "verseOrgIds": [
              "JOS.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwajoar Otieli was orjeeda Genasi, was orjeeda geenyea Galebu, ak ghoadaw niny Agsa was hudaanyi ghoah gatmoadaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.17",
            "verseOrgIds": [
              "JOS.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea gawa gatmoodida gheenda, hean ghwalamda siyeadaanyi ak gwayeesha musa gweanu madamnyeanda, hean ghwararang'aana gatmoodida badayda digeadaanyi ak ghwalamda Galebu ak gwayeesha, “Gigasayi naaha?” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.18",
            "verseOrgIds": [
              "JOS.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha niny, “Goonean gidamiy; ghang'eada ng'eanyiida ghayi igoonyean bea Negebu, goona eara gheanyanga eeniga.” Hean ghoadaw Galebu gheanyanga eeniga mida heetiyeada ea gea mida heeda hiing'aada.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.19",
            "verseOrgIds": [
              "JOS.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mujiinajeega Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.19",
            "verseOrgIds": [
              "JOS.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nih gichea gwahearan fuga Yuda gil sea fuga gheanyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.20",
            "verseOrgIds": [
              "JOS.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mujiineeda fuga Yuda gwanda wiilooda ng'eanyiida biyeara, sigal moonghooda Edomu, ak ea Gabseli gil ea Ederi, ea Yaguri, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.21",
            "verseOrgIds": [
              "JOS.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gina, ea Dimona, ea Adada, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.22",
            "verseOrgIds": [
              "JOS.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedeshi, ea Hasori, Itinani, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.23",
            "verseOrgIds": [
              "JOS.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sifu, ea Delemu, ea Bealoti, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.24",
            "verseOrgIds": [
              "JOS.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasor-hadata, ea Geriyot-hesroni (nea Hasori gil) ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.25",
            "verseOrgIds": [
              "JOS.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amamu, ea Shema, ea Molada, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.26",
            "verseOrgIds": [
              "JOS.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasar-gada, ea Heshmoni, ea Bet-beleti, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.27",
            "verseOrgIds": [
              "JOS.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasar-shuali, ea Beer-sheba, ea Bisiotiya, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.28",
            "verseOrgIds": [
              "JOS.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baala, ea Iimu, ea Esemu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.29",
            "verseOrgIds": [
              "JOS.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elitoladi ea Gesili, ea Horma, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.30",
            "verseOrgIds": [
