{
  "id": "HAG.1",
  "number": "1",
  "bookId": "HAG",
  "reference": "Hagayi 1",
  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
