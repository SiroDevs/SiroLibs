{
  "id": "1CH.9",
  "number": "9",
  "bookId": "1CH",
  "reference": "1 Damanyoojiga 9",
  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
