          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea Adina orjeeda Shisa bea eemeeda Rubeni, was siida haweewa fuga Rubeni, sean fih diktam ea damanamughuush mideawa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.42",
            "verseOrgIds": [
              "1CH.11.42"
            ]
