          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea Uriya bea eemeeda Hiti, ea Sabadi orjeeda Alayi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.41",
            "verseOrgIds": [
              "1CH.11.41"
            ]
