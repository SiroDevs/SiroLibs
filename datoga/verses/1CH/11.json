          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashemu bea eemeeda Gisoni, ea Yonatan orjeeda Shagee bea eemeeda Harari, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.34",
            "verseOrgIds": [
              "1CH.11.34"
            ]
          }
        },
