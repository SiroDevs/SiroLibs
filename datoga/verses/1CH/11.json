          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea Elieli bea eemeeda Mahawi, ea Yeribayi, ea Yoshafiya, orjooga Elnaamu, ea Itma bea eemeeda Moabu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.46",
            "verseOrgIds": [
              "1CH.11.46"
            ]
          }
        },
