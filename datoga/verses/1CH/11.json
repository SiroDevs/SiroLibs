          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea Heferi bea eemeeda Makati, ea Ahiya bea eemeeda Beloni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.36",
            "verseOrgIds": [
              "1CH.11.36"
            ]
          }
        },
