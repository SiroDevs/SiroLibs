          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea Usiya bea eemeeda Ashterati, ea Shama sea Yeieli orjooga Hotamu bea eemeeda Aroweri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.44",
            "verseOrgIds": [
              "1CH.11.44"
            ]
          }
        },
