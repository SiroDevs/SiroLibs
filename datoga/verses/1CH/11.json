          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea Seleki bea eemeeda Amoni, ea Naharai leah Beroti was siida eada dabita ng'ucheeda bea Yoabu orjeeda Seruya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.39",
            "verseOrgIds": [
              "1CH.11.39"
            ]
          }
        },
