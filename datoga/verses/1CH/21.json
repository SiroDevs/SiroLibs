{
  "id": "1CH.21",
  "number": "21",
  "bookId": "1CH",
  "reference": "1 Damanyoojiga 21",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "1CH 21"
      },
      "items": [
        {
          "text": "21",
