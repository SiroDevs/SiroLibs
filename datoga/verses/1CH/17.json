{
  "id": "1CH.17",
  "number": "17",
  "bookId": "1CH",
  "reference": "1 Damanyoojiga 17",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
