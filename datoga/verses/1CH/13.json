{
  "id": "1CH.13",
  "number": "13",
  "bookId": "1CH",
  "reference": "1 Damanyoojiga 13",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
