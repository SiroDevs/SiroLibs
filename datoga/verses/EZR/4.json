          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghamiinaada gadiyeeda deekshooda gheeda ASEETA aba Yerusalemu; ea ghwahita gweaydeaba iyeenya bea sugoocheanduumeeda Dariyo was sugoocheanda Ajemi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.24",
