  "reference": "Dito 3",
  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "TIT 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Searoojiga fuga Gristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "TIT 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apkeasiina saawa gweada geat ng'eanyi aba heeda fuga ahaaghwa ng'eanyiida ea gea mideawa gheambalmeeda, ak gwasissa mureeda, nea hidaat aba gilinyoo ea gadiyeeda miy gil, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.1",
            "verseOrgIds": [
              "TIT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "TIT 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "adagoong'eawi siida wassean, amulsiina jaliida, ahuwa eemoojiga miyaas, nea ghoahiimu garbabanda sean aba heeda buuneesean. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.2",
            "verseOrgIds": [
              "TIT.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "TIT 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba ghayi aba mwadi geewooschi dasheahi, ak ea meendeawani mureeda ak geewooschi roodanga, ea giing'oonyanga aba miyeenooda muunda ng'eanyiida, nea geepiidi jeeda ng'asheega munyas, ea lajoodeaba ghuut, nea ghwasteagwa buuneeda nea goostayi geat agooga; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.3",
            "verseOrgIds": [
              "TIT.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak miyinda ea bariinyeega ASEETA was lealnoocheandeanya geataajiit, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.4",
            "verseOrgIds": [
              "TIT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "TIT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "hean gwalealneasa, ea meebaysiinana sinaweagaasa doobiiweadi sisinyi aseasa niny gwalealneasa ak geejilneasa niba iyeenya ak ghwanung' eahuuwa fuga eashish aba Guroorooda Ghaydit, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.5",
            "verseOrgIds": [
              "TIT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea gagoaneasa nea gooheedu aba naweeda Yesu Gristoyda was lealnoocheandeanya, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.6",
            "verseOrgIds": [
              "TIT.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak abeeda geegooneasa doobiiwnata aba dagheerjeanduumeadaanyi ak geararji hearanda eaweega manda muudeanooda. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.7",
            "verseOrgIds": [
              "TIT.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'asheanji earguun huumwa gil.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.8",
            "verseOrgIds": [
              "TIT.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geagasayi rukuta ng'asheesu nea giimajeegi, aba gideaba fugiga mwas ASEETEAN goobiida jeeda sinooda ng'asheega miyaas; nea suh ea miyaasiin nea ghwadoabiiw aba heeda buuneeda. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.8",
            "verseOrgIds": [
              "TIT.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak giing'aami geaw ng'asheega jaleadinga, ea ng'asheega siroaproabwaada, ea foolayda ea sheang'nyeeda aba badayda deaweeda, aba gideaba mayghwaloat gil ak ea mwahida. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.9",
            "verseOrgIds": [
              "TIT.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi siida foolayda iinireekusi dea madeeda ghana deabiyeenya, adagudisimi eara gil, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.10",
            "verseOrgIds": [
              "TIT.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "TIT 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ginali gideaba siida uurji nih niramwas, aba gideaba gwasin riing'eeda, ak ea niirgweaksa geaw.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.11",
            "verseOrgIds": [
              "TIT.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng'asheega huuydean bea gichea eabeada",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "TIT 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.11",
            "verseOrgIds": [
              "TIT.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "TIT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu iyeajeagu headaang'u Atema ea Dikiko, abeeda gisini badiida hini heedeanyu ng'eanyiida Nikopoli, aba gideaba neabaday gideaba gaydeaksa hoowa meahooda. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.12",
            "verseOrgIds": [
              "TIT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sina badiida aba bareanyeeka Sena, was diinagiida ea Apolo aba buweanooda nyaawa; ng'ula adaghoashoanya gil. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.13",
            "verseOrgIds": [
              "TIT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eara fugaasa saawa gammiisa gideaba ghoanaal geat giibinda jeeda sinooda ng'asheega miyaas, ak gwasisin ng'asheega gasa ealamwach sinooda, ak ea mawoosa gea manda haghweega.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghoaghanyi fuga sean eandeawi. Aghada giika bwariinyeasa aba naweeda masaweegean.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.15",
            "verseOrgIds": [
              "TIT.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gagasa anyasa dagheerjeanduumeeda oogasean.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.15",
            "verseOrgIds": [
              "TIT.3.15"
            ]
          }
        }
      ]
    }
  ],
