          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.44",
            "verseOrgIds": [
              "LUK.20.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 20:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean nea gwayiing'shi buuneesean gwayeesha ginealangaaschi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.45",
            "verseOrgIds": [
              "LUK.20.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ashageada ng'oorshoodiga, fuga bwariiy gwaleamideawa hang'weaka geawi bwariiy eeyeeniisa seayu aba naadajeega, ea hoorgajeega miyaasiin aba gealga siinealshacheewa, nea eara iiweay gealga ghweelmeeda ghwanyoahaada hoorgajeega madeeda, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.46",
            "verseOrgIds": [
              "LUK.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "fuga inyeesa gweagiisachi aba gealga masiinung'weega nea aba giimiinoodeaba geat inyeesa ghamwaash ASEETA nea googeawiit. Asi gayghwanyas girgweaksiinda haw.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.47",
            "verseOrgIds": [
              "LUK.20.47"
            ]
          }
        }
      ]
