            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lameki gaba Metusela, Metusela gaba Henoko, Henoko gaba Yaredi, Yaredi gaba Mahaleli, Mahaleli, gaba Genani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.37",
