          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawdi gaba Yese, Yese gaba Obedi, Obedi gaba Boasi, Boasi gaba Sala, Sala gaba Nashoni, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.32",
            "verseOrgIds": [
              "LUK.3.32"
            ]
          }
