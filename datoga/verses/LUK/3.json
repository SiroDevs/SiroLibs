          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahori gaba Serugi, Serugi gaba Reu, Rewu gaba Belegi, Belegi gaba Eberi, Eberi gaba Shela, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.35",
            "verseOrgIds": [
              "LUK.3.35"
            ]
          }
