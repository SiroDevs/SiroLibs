          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawi gaba Simon, Simon gaba Yuda, Yuda gaba Yosefu, Yosefu gaba Yonamu, Yonamu gaba Eliyakimu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.30",
            "verseOrgIds": [
