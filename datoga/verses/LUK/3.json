          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda gaba Yakobo, Yakobo gaba Isaka, Isaka gaba Abrahamu, Abrahamu gaba Dera, Dera gaba Nahori, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.34",
            "verseOrgIds": [
