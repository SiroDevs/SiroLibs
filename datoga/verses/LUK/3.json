          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nashoni gaba Aminadabu, Aminadabu gaba Adimini, Adimini gaba Aramu, Aramu gaba Hesroni, Hersoni gaba Beresi, Beresi gaba Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.33",
            "verseOrgIds": [
              "LUK.3.33"
            ]
          }
        },
