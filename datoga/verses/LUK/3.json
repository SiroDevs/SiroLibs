          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyakimu gaba Meleya, Meleya gaba Mena, Mena gaba Matata, Matata gaba Natani, Natani gaba Dawdi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.31",
            "verseOrgIds": [
              "LUK.3.31"
            ]
          }
        },
