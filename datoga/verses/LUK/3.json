          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shela gaba Genani, Genani gaba Arfaksadi, Arfaksadi gaba Shemu, Shemu gaba Nuhu, Nuhu gaba Lameki, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.36",
