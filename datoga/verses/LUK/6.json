          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Asi ashageada agoogeeni oowooschi baruurjeewiin, aba gideaba noanyaschi hawdeayda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.24",
            "verseOrgIds": [
              "LUK.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.24",
            "verseOrgIds": [
              "LUK.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ashageada agoogeeni oowooschi lang'uudeat ghamneawean, aba gideaba gajadaaha jalooda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.25",
            "verseOrgIds": [
              "LUK.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ashageada agoogeeni oayaaji reari ghamneawean, aba gideaba gajagutuuni heareega nea gooyeawdi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.25",
            "verseOrgIds": [
              "LUK.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.25",
            "verseOrgIds": [
              "LUK.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ashageada agoogeeni, jea gagwarseegwa buuneesean iin aba gideaba eara ghweaniga nyaawa ghayi gwahindunu sibanga ng'uyeega.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.26",
            "verseOrgIds": [
              "LUK.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bariinyeega weajoodiga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.26",
            "verseOrgIds": [
              "LUK.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Asi Geayeeshiineegwa agoogeeni ooyiing'shiin, abwariinya weajoodigeagwa, asisiina gea miyaasiin fuga sideagwa, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.27",
            "verseOrgIds": [
              "LUK.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abadiischeesiina fuga mooriidaneegwa, amwaasha ASEETA aba badahuuka fuga ghabwaseegwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.28",
            "verseOrgIds": [
              "LUK.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida iilas madeang'daang'u, giidawi eara meatkweeda niirja; iyareanyi sih hang'daang'u ginung'usi eara shaateadaang'u. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.29",
            "verseOrgIds": [
              "LUK.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida musnyi gil adawa, nea siida areanyi haleanjeadaang'u ea adimaseawi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.30",
            "verseOrgIds": [
              "LUK.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi gidoogasayi gwasinneegwa buuneeda agooga, asisina eara saawa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.31",
            "verseOrgIds": [
              "LUK.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.31",
            "verseOrgIds": [
              "LUK.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iyoabwariinyi fuga bariinyeagwa, abeeda ghoahiimu naaha miy? Aba gideaba eara fuga riing'eega ghabwariiy fuga bwariiy saawa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.32",
            "verseOrgIds": [
              "LUK.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyoosissi gea miyaasiin fuga sinuneegwa gea miyaas, abeeda ghoahiimu naaha miy? Aba gideaba eara fuga riing'eega gwasina gea uurjunu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.33",
            "verseOrgIds": [
              "LUK.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyoonung' gooleakshi fuga oanali gideaba gay ghoaghuumneegwa abeeda ghoahiimu naaha miy? Aba gideaba eara fuga riing'eega gooleaksheewa heeda fuga riing'eega, aba gideaba ghwanal gideaba gay ghoaghuumu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.34",
            "verseOrgIds": [
              "LUK.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi abwariinya weajoodigeagwa, nea goosinyi gea miyaas, nea ghoanung' gooleakshi, nea adoofurdi goodeelneegwa gil; abeeda giimeardeang'wa gajaahaw, ak gajahuuwa orjooga ASEETA haw mida humng'eeda; aba gideaba niny aamiy aba fuga mabadiischeesiina ea gea geawi gheanyan. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.35",
            "verseOrgIds": [
              "LUK.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andeawana baydeayda, ak gawuurji gidamideayeata Ghweandeang'wa baydeayda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.36",
            "verseOrgIds": [
              "LUK.6.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Girgweaksiinda buuneeda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.36",
            "verseOrgIds": [
              "LUK.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Adoorgweakiisi buuneeda, ak ea majeergweakseegwa; adooyeati ghuusi, buuneeda ak ea majeeyeateeweegwa ghuusi; asamiisiina buuneeda, ak gajeesamseegwa; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.37",
            "verseOrgIds": [
              "LUK.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "oatawa buuneeda haleanjeeda ak gajeegooneegwa; dea nyiit, sidaksa, siituumduum, ea ghwanaawda, ea gichea gagooneegwa. Aba gideaba giideenooda ooteeniidi gichea eeteeneegwa.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.38",
            "verseOrgIds": [
              "LUK.6.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.38",
            "verseOrgIds": [
              "LUK.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabalool nea gagala geat ng'asheega, nea gwayeesha: “Heapi siida ng'oaw gayghoamu ghoadoabiiw siinuut ng'oawi? May ghoabita duwaawi jeeda shoomanda? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.39",
            "verseOrgIds": [
              "LUK.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giinealaneeda mwang'ala giinealshoocheandaanyi, geaghus ea niduulu giinealshooda abeeda gaygwadeenyi sea giinealshoocheandaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.40",
            "verseOrgIds": [
              "LUK.6.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasaan anda ging'ulayi hararooyeanda mida jeeda gheang'da orjeeda geamadu nea ming'uli geeta mida jeeda gheang'daang'u? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.41",
            "verseOrgIds": [
              "LUK.6.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gajamuustaan eeshiina orjeeda geamadu, ‘Orjeeda iya, nung' dageanu hararooyeanda mida gheang'daang'u,’ nea midaahi geeta mida gheang'daang'u ang'iing'i. Siida amiitu geaw, nyooh ghanyi geanda geeta mida gheang'daang'u, abeeda gaydaaha muuchi gichea geandeayda hararooyeanda mida gheang'da orjeeda geamadu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.42",
            "verseOrgIds": [
              "LUK.6.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Geeta ea haghweagaaschi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.42",
            "verseOrgIds": [
              "LUK.6.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 6:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Geeta miy majiila haghweega munyas, eara geeta muy ea majiila haghweega miyaas; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.43",
            "verseOrgIds": [
              "LUK.6.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 6:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba gideaba gilinyoo ea geadi geenala haghweagaaschi. Aba gideaba moang'wa eebina gulageetka geeta halaghweenga, ghana moang'wa eebina sabiibu heeda yuudeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.44",
            "verseOrgIds": [
              "LUK.6.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 6:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida miy aba jeeda gheaseadaanyi miy bea gurooroadaanyi gooruutu gea miyaas, nea siida muy aba jeeda gheaseadaanyi muy iissa gooruutu gea munyas; aba gideaba ghuuta gabaloola gea nyiit jeeda gurooroadaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.45",
            "verseOrgIds": [
              "LUK.6.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fih iyeenya deekshi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 6:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.45",
            "verseOrgIds": [
              "LUK.6.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 6:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghwasaan anda googuureewean ‘Ng'utamiida, Ng'utamiida,’ nea moosini gidearukuneegwa? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.46",
            "verseOrgIds": [
              "LUK.6.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 6:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida wassean wuh heedeanyu ak ghwayiiy ng'asheegeasu ak gwasin, gaydaahiimu giduurji: ",
