              "type": "text"
            }
          ]
        },
        {
          "text": "Ghamneawa nea ghwahidu orjeeni itaang'uun duulu haleanjeadaang'u sea gadeemga hiseadean ginuuksi meayda riishaat!’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.30",
            "verseOrgIds": [
