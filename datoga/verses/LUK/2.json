          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeata Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Askwearjoojigiga ghoadayda Gaysari Agusto diigheanda nea gwayeesha, ang'waara mooneeda buuneassean mida jeeda ng'eanyiida. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.1",
            "verseOrgIds": [
              "LUK.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'oordi dea madeeda, nea gwanda sugoocheanduumeeda Shaamu Gireniyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.2",
            "verseOrgIds": [
              "LUK.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaba siisi weah eang'waar aba mujiineeda ng'eang'da nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.3",
            "verseOrgIds": [
              "LUK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghwascheang'da Yosefu ghabeawa Galilaya, nea ghabeawa mujiineeda Nasareti, ak gawa Yudeya, ea ghwahita mujiineeda Dawdi, siguura Betlehemu, aba gideaba gaba dooshta Dawdi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.4",
            "verseOrgIds": [
              "LUK.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawa eang'waar sea Mariyayda was huda anyeari, nea abeeda ea gweayiideat. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.5",
            "verseOrgIds": [
              "LUK.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damanda mideewa hooweani ghwahita damanda jea gwajiila. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.6",
            "verseOrgIds": [
              "LUK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwaji duweacheadaanyi was orjeeda ak gookwealsa hang'weaka jeepcheanduumeeda ak gooluul aba jeeda daghwalda leeha dugwa beega, aba gideaba mwanyasa heeda jea gwalla aba ghooriida rabasta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.7",
            "verseOrgIds": [
              "LUK.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeagiischoodiga ea malaykajeega",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.7",
            "verseOrgIds": [
              "LUK.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea aba damandida abeeda gwanda ng'eanyiita Jeagiischoodiga fur gisilga nyaawa eawa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.8",
            "verseOrgIds": [
              "LUK.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabussa saawa Malaykajeanda Ng'utamiida, ak ghoabwaay murdajeega nyaawa sean giigheambiita Ng'utamiida, ak ghang'ut muuwda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.9",
            "verseOrgIds": [
              "LUK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwayeesha Malaykajeanda, “Adoabeali; ang'ula geayeaneegwa giijasta miy bea hooseaneega jea gwahissa buuneesean. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.10",
            "verseOrgIds": [
              "LUK.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba eanean aba mujiineeda Dawdi siji aba badahuukeagwa, lealnoocheanda, niny Gristoyda was Ng'utamiida gil. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.11",
            "verseOrgIds": [
              "LUK.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea gwadeagooda jea adaaha ea nihi; gajadaaha baleanda siikwealsa hang'weaka jeepcheanduumeeda nea geeluul aba jeeda daghwalda leeha dugwa beega.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.12",
            "verseOrgIds": [
              "LUK.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deagheata gwandeayi sea malaykajeanji lugooda saang'a bea humng'eeda ak gwaduumsheesa ASEETA nea gwayi,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.13",
            "verseOrgIds": [
              "LUK.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.14",
            "verseOrgIds": [
              "LUK.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea nibiikta Malaykajeega humng'eeda, gwayeeniissa geat Jeagiischoodiga, “Asi eeweaya Betlehemu eadaaha gidabunu, rukuneasa Ng'utamiida.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.15",
            "verseOrgIds": [
              "LUK.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaweay nea ghwalamwajaada ak geanyasa Mariya ea Yosefu heeda mida baleanda nea gwalil aba jeeda daghwalda leeha dugwa beega. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.16",
            "verseOrgIds": [
              "LUK.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daah gwarukuta gidagwachi sirugu aba badaydeaba jeebi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.17",
            "verseOrgIds": [
              "LUK.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ghahamng'eanyi fugiga sean iiyiiy gidarukusa jeagiischoodigean. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.18",
            "verseOrgIds": [
              "LUK.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea Mariya goong'ooysa jeadaanyi ng'asheesu seaniin, nea gooteemsheesa geaw. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.19",
            "verseOrgIds": [
              "LUK.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu gabiikta jeagiischoodiga nea ghoaghaambiit nea gwaduumsheesa ASEETA aba ng'asheega siyiiy ea gea sidaah, gawuurji gisirukusiinda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.20",
            "verseOrgIds": [
              "LUK.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu geeng'assa gheawunga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.20",
            "verseOrgIds": [
              "LUK.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata eawooji sis nea siyaat ghasmeahooda geeguura Yesu, gheawunga ghayi ng'assa malaykajeanda nea mii ghwanyas ghaamwat gweayuumeeda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
            "verseOrgIds": [
              "LUK.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu geayaat gheeda sibata ASEETA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
            "verseOrgIds": [
              "LUK.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimuchu nea ghwahita damanda nyaawa bea giimiinnooda gawuurji ginyaashta deaweedeeda Musa, hean geayaat niny Yerusalemu ak geataw Ng'utamiida ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.22",
            "verseOrgIds": [
              "LUK.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "(gawuurji gissing'oarda aba jeeda deaweedeeda Ng'utamiida, “Gilinyoo ea orjeeda was duweacheeda gil gajeeguura siida ghaydit bea Ng'utamiida”) ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.23",
            "verseOrgIds": [
              "LUK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ghoadayda haleanjeeda sisapa geadi gawuurji gidanyaashta deaweedeeda Ng'utamiida, “was bakpakchooji iyeenya ghana dayi iyeenya bea ghariibajeanda.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.24",
            "verseOrgIds": [
              "LUK.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea abeeda gwanda Yerusalemu, siisi siguura gheawungaaschi Simon, nea siisi abeeda ea doabiiwaat, nea gabada ASEETA, nea goomuuku hawdeayda fuga Israeli, nea gwanda badaydaanyi Guroorooda Ghaydit. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.25",
            "verseOrgIds": [
              "LUK.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea ea nigeawiit goohiimsa Guroorooda Ghaydit gideaba mayghami nea miighwadaah Gristoyda Ng'utamiida. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.26",
            "verseOrgIds": [
              "LUK.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwaat Guroorooda Ghaydit gawa jeeda gheeda sibata ASEETA; nea ghwaat ghwaan ea ghaamwat Yesu jeeda gheeda nea geehinda giduurji ng'asheega deaweeda, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.27",
            "verseOrgIds": [
              "LUK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ghoang'waay aba geatingaaschi ak gabadiischeesa ASEETA nea gwayi,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.28",
            "verseOrgIds": [
              "LUK.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.32",
            "verseOrgIds": [
              "LUK.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean eara Ghwaan ea ghaamwat ghahamng'eanyi aba gissirgu aba badaydaanyi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.33",
            "verseOrgIds": [
              "LUK.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gang'usha Simon saawa nea gwayeesha Mariyayda was ghaamwat,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.34",
            "verseOrgIds": [
              "LUK.2.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.35",
            "verseOrgIds": [
              "LUK.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghayi gwanda gatmooni was sibaneeda, siguura Ana, was hudeaba Fanueli, bea eemeeni siyi Asheri; ak ea niwaasiit muuchi, ghayi geaghi nea miyeasat ak gwandeawa siyeeda gweanyeew ispwa, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.36",
            "verseOrgIds": [
              "LUK.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "goobiida masinung'weanduumeeda gweanyeew seedam ea aang'waan. Nea mii gwaheeli gheeda sibata ASEETA, nea gagadoowani nea gooluulda geaw nea gamoora ASEETA eawa ea askweari. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.37",
            "verseOrgIds": [
              "LUK.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwardu aba damandida ak gabadiischeesa ASEETA, ak goobaloola niny ng'asheega sean bea fuga amuuku lealnooda Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.38",
            "verseOrgIds": [
              "LUK.2.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Biikteayda Nasareti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.38",
            "verseOrgIds": [
              "LUK.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea niihiit sinooda ng'asheega sean gawuurji ginyaashta deaweedeeda Ng'utamiida, gabiikta Galilaya, mujiineeda nyaawa was Nasareti. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwahissa heeda baleanda nea ghwanyas uurda, ak geanyiit weaghuumeeda; nea gwandeawa dagheerjeanduumeeda ASEETA.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Orjeeda was Yesu aba jeeda gheeda sibata ASEETA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea Ghwaan ea ghaamwat gabadiini gilakweay Yerusalemu aba damanda ghweelmeeda Basaaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.41",
            "verseOrgIds": [
              "LUK.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea nihita gweanyeew damaniyeenya, ghwascheang'da gawuurji gideajusu bea gealaan; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.42",
            "verseOrgIds": [
              "LUK.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "duulean ghweelmeeda, damanda biikteawa, geepuussa bwadaw orjeeda was Yesu aba Yerusalemu nea ghwaan ea ghaamwat ea majeeng'na. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.43",
            "verseOrgIds": [
              "LUK.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gearar gideaba gwanda jeeda bareanda ak gaweay ea gamikta, geang'eat ghuuta gasooda aba jeeda buweadeega ea fuga sinal; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.44",
            "verseOrgIds": [
              "LUK.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "ama duu nea mudu eanyas, geebiikta Yerusalemu nea geegaseadayi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.45",
            "verseOrgIds": [
              "LUK.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchu nea ning'ata eawooji samwagu geanyasa jeeda gheeda sibata ASEETA, nea goopteada aba bugusta giinealshoodiga, nea gooleeysiit nea goonyeariida ng'asheega; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.46",
            "verseOrgIds": [
              "LUK.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea fuga sean iiy ghahamng'eanyi iisidaa gidabwaraayda uhuuda ea gisheahiida ng'asheega siinyaash. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.47",
            "verseOrgIds": [
              "LUK.2.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 2:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaah niny geahamng'eanyi; ak gwayeesha ghaamwat, “Orjeeda, ghwasaan anda gihindineasa? Ng'ula, aniini ea gweanu sinyarji aba gasoadaang'u.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.48",
            "verseOrgIds": [
              "LUK.2.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwayeesha saawa, “Ghwasaan anda googaseadayean? Neada ea moanali gideaba gamiisean giibinda jeeda ghooriida Bwaabwa?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.49",
            "verseOrgIds": [
              "LUK.2.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea saawa ea majeeng'na ng'asheanda rukusa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.50",
            "verseOrgIds": [
              "LUK.2.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 2:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwararang'aada goodeayi ea ghwahita Nasareti, nea gwasissa mureeda; nea ghaamwat ghwayiin jeadaanyi ng'asheesu seaniin.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.51",
            "verseOrgIds": [
              "LUK.2.51"
            ]
          }
        }
      ]
    },
