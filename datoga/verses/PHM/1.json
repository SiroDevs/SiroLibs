          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.24",
            "verseOrgIds": [
              "PHM.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dagheerjeanduumeeda Ng'utamiida was Yesu Gristo gagasa goobiida jeeda gurooruunatkeagwa.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.25",
            "verseOrgIds": [
              "PHM.1.25"
            ]
          }
        }
