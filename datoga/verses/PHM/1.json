      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawlo siida ghealooniga aba badayda Gristo Yesu, ea Dimoteo orjeeda giyeanya, heeda Filimoniheeda was siideanya sibwariinyi siweecheewi aba gadiyeeda ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.1",
            "verseOrgIds": [
              "PHM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea Afiyayda was huda giyeanya, ea heeda Arkipa was shirikarajeanda Gristo siweecheewi bea ganiiseeda mida jeedeaba gheang'u:",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.2",
            "verseOrgIds": [
              "PHM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.2",
            "verseOrgIds": [
              "PHM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gagasa anyasa dagheerjeanduumeeda ea hoyyoo leabu heeda ASEETA was ghweandeanya ea heeda Ng'utamiida was Yesu Gristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.3",
            "verseOrgIds": [
              "PHM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bariinyeega ea Masaweega Filimoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.3",
            "verseOrgIds": [
              "PHM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geabadiischeesi ASEETEANYU galeagasean iyaapkaacheey nea ghaamwaashchi ASEETA, ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.4",
            "verseOrgIds": [
              "PHM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba gideaba naayiinyi bariinyeagaagu ea masaweega indeawi aba badayda Ng'utamiida was Yesu ea heeda fuga ghaydidi sean, ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.5",
            "verseOrgIds": [
              "PHM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ghaamwaashchi ASEETA aba masaweagaagu siguuyeesi nyagu fughareeda miy bea haleanjeeda sean ikaasa aba jeeda Gristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.6",
            "verseOrgIds": [
              "PHM.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba naanyaschi hooseaneega muuchi ea hawdeayda aba bariinyeagaagu orjeediyya, aba gideaba gurooruunatka fuga ghaydidi nihawda aba badaydaang'u.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.7",
            "verseOrgIds": [
              "PHM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musiischooda aba badayda Onesmo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.7",
            "verseOrgIds": [
              "PHM.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba earapeadi eawooschi muraneeda hidaat aba naweeda Gristo ak geerukuneey sina gidasigasa, ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.8",
            "verseOrgIds": [
              "PHM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "iidu aba badayda bariinyeega geamuscheey gideaba, aniini Bawlo, was siida siicheagu ak ghamneawa geawooschi siida ghealooniga aba badayda Gristo Yesu– ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.9",
            "verseOrgIds": [
              "PHM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geamuscheey aba badayda jeepteanyu was Onesmo, nea naahuuyi ghwaan aba damanda eandeewi ghealooniga, ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.10",
            "verseOrgIds": [
              "PHM.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ghayi niny mwaloada gil aba headaanyi, ak ghamneawa gwalooseey gil agooga ea aniini). ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.11",
            "verseOrgIds": [
              "PHM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geajeagu gabiigu headaang'u, aba gideaba niny gurooroodeanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.12",
            "verseOrgIds": [
              "PHM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaydahoosan aniini iyabiida heedeanyu ak ghaweadan aba meatkweedeang'wa damani eandeawi ghealooniga aba badayda giijasta miyiin, ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.13",
            "verseOrgIds": [
              "PHM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak geagasayi ea measini gil nea mimwasi ak abeeda ea meediing'seey alooheadaang'u geaghus aba gida igassiidi.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.14",
            "verseOrgIds": [
              "PHM.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.14",
            "verseOrgIds": [
              "PHM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nih ghaaghanyi ghoah gidasiheeleewaneey aba gheadi nuwaasiin, ak iidu goobiiksiinyi gicha ak goopiidi hijagi damanda manda muudeanooda, ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.15",
            "verseOrgIds": [
              "PHM.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "niny mudu gawuurji giing'oonyaneeda, niny ning'al giing'oonyaneeda, niny gawuurji orjeediyya aabwariinyi, raanya aba heedeanyu ak gaygawuurjiin muuchi aba headaang'u, aba saseeda ea heeda Ng'utamiida. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.16",
            "verseOrgIds": [
              "PHM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iyoonung' doaw siida ooguuyeewi, deaptaayda niny gida gwachi jea deaptaaydanaan aniini. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.17",
            "verseOrgIds": [
              "PHM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama iideepa ea niidiiyseey aba gida was sean, ghana gwandeawa siileadaang'u was sean, abeeda ging'oornean siileeni. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.18",
            "verseOrgIds": [
              "PHM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniini Bawlo aang'oarji ng'asheesu aba geatindeanyu, gaydawalu aniini, Mearukuni ak gindeawi siileedeanyu aba jeeda Gristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.19",
            "verseOrgIds": [
              "PHM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaha, orjeediyya, sinnean ng'asheega miyaasiin ak ghaanyagaadi aba badayda Ng'utamiida, ak gihoosani guroroodeanyu aba naweeda Gristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.20",
            "verseOrgIds": [
              "PHM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.20",
            "verseOrgIds": [
              "PHM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghaamwaschi aba mureadaang'u, ak geang'oorneey ang'iing'i nea ghaanali gideaba gaysina ng'asheesu ea ghwanaawa gea earukuneey. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.21",
            "verseOrgIds": [
              "PHM.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi aba damani, asina ghooriida rabasta jea deabiida, aba gideaba ghaararji aba mooshteang'wa bea ASEETA gajanyasaan.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.22",
            "verseOrgIds": [
              "PHM.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giighata huuydean",
          "type": "text"
        }
      ]
    },
