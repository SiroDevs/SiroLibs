{
  "id": "1KI.19",
  "number": "19",
  "bookId": "1KI",
  "reference": "1 Sugoodiga 19",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
