{
  "id": "1KI.15",
  "number": "15",
  "bookId": "1KI",
  "reference": "1 Sugoodiga 15",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "1KI 15"
      },
      "items": [
