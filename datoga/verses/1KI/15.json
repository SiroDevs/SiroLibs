          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gweaydeaba samwagu waseewa Asa sugoocheanda Yuda, ghang'eat Baashaheeda was orjeeda Ahiya ghang'eat goombal fuga sean bea Israeli aba Dirsa, hean goombaliischi gweanyeew diktam ea ang'wan. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
            "verseOrgIds": [
              "1KI.15.33"
            ]
          }
        },
        {
