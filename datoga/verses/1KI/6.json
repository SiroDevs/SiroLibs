{
  "id": "1KI.6",
  "number": "6",
  "bookId": "1KI",
  "reference": "1 Sugoodiga 6",
  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
