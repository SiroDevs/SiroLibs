{
  "id": "2TI.2",
  "number": "2",
  "bookId": "2TI",
  "reference": "2 Dimoteo 2",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
