  "reference": "2 Dimoteo 4",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "2TI 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gearukuneey ng'asheesu aba madeeda ASEETA ea madeeda Gristo Yesu diita jea goorgweaksa fuga majeekcheew ea gea nimeewean aba giidaheachtaanyi ea aba gheambalmeadaanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.1",
            "verseOrgIds": [
              "2TI.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "rukwiida giijasta woosa hidaat (damanda miiseey ea damanda mamiiseey), awoowsiina ajuursiina nea gireekusi aba milikghteayda sean ea giinealshooda. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.2",
            "verseOrgIds": [
              "2TI.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba gayghwahidu damanda jea eaheawa giinealshooda mideawa eaweega ak ghwaat geeshta naweeda gidagasiida saawa ak gwanyaksa geat gheamughuushcheeka giinealshoodiga aba gideaba gwandeawa iidiga jea gwasikiideawa ng'asheega. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.3",
            "verseOrgIds": [
              "2TI.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygoodiilda geat ea mwayiinya ng'asheega was gea huumwa ak gwayamsa geat deanghoochka ng'uyeega, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.4",
            "verseOrgIds": [
              "2TI.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ang'iing'i mideawana gheadeenda aba haleanjeeda sean, milighteaysiina gea munyas sina gadiyeeda rukwiideayda giijasta miy ahiida gadiyeadaang'u nea giidoabiiwi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.5",
            "verseOrgIds": [
              "2TI.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba aniini ghamneawa gajeetaydanaan doaw gujaweeda ak ea nihita damanda jea dameawa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.6",
            "verseOrgIds": [
              "2TI.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neang'uchi ng'ucheeda miy, neang'ucheewi, ak ea naahiichi ng'weega, ak masaweega ea neafurji, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.7",
            "verseOrgIds": [
              "2TI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ama ng'ata suh geegoonan shiipka aba doobiiwnata dea iidu eaweeda jea gagoonan Ng'utamiida nea niny ea dea doabiiwaat girgweaga ak ea mii aniini gil ak ghwahit eara fugiga sean gasa giidaheachtaanyiin.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.8",
            "verseOrgIds": [
              "2TI.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng'asheagaaschi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.8",
            "verseOrgIds": [
              "2TI.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sina badiida ak gihidu heedeanyu nea gilamwajaani. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.9",
            "verseOrgIds": [
              "2TI.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba Dema ghabwariiy haleanjeeda muunda ng'eanyiida ak ghang'eat gwanung'usean heeda ak gawa Desalonike, ak Greske gawa ng'eanyiida Galatiya, nea Dito gawa ng'eanyiida Dalmatiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.10",
            "verseOrgIds": [
              "2TI.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luka geandeayeesi hiji nea gabageaw. Gasa Marko ak giideani aba gideaba niny gayghaweadan aba gadiyeedeanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.11",
            "verseOrgIds": [
              "2TI.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak Dikiko ea neajeakti gawa Efeso. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.12",
            "verseOrgIds": [
              "2TI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iihidu giyeadu hang'deanyu gul ng'eanyi ghayi eanung'si heeda Garpo bea ng'eanyiida Drowa, ea gitaabwajeegiga ghwaraanya giika sisna muuchkean. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.13",
            "verseOrgIds": [
              "2TI.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iskanda diita was gidang'oocheandean nisinnean ng'asheega munyas saang'a gayghawalda Ng'utamiida gawuurji gidasinda niny. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gishageadi siisi, aba gideaba ghaheawa muuchi ng'asheagaasa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.15",
            "verseOrgIds": [
              "2TI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damanda ghayi siirgweaksiinanean bea madeedean manda eara siyagi weah meatkweedeanyu ghaweadan, hean gwanung'usean heeda sean ak geamuschi gideaba giidiinyeanji adeeyiin badahuuka nyaawa! ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.16",
            "verseOrgIds": [
              "2TI.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea nimiinaadawa Ng'utamiida meatkweedeanyu ak gagoonan uurda aba gideaba gagasa niny darukwiida giijasta miy, ea ghwayiiy eemoojiga sean, ak ghaalaalaani ghuuta ng'adiida. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.17",
            "verseOrgIds": [
              "2TI.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygwalealneani Ng'utamiida aba ng'asheanda wassean muy, ak gayghaghamwadan ea dahita gheambalmeadaanyi bea humng'eeda. Giigheambiita daanyi gil ea ghoah eaweega manda muudeanooda. Amin.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.18",
            "verseOrgIds": [
              "2TI.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giighata huydean",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.18",
            "verseOrgIds": [
              "2TI.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2TI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agata Briska ea Akila, ea fugiga mida gheeh Onesiforon. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.19",
            "verseOrgIds": [
              "2TI.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2TI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erasto gahuuydean aba ng'eanyiida Gorinto. Drofimo geanung'usi Mileto aba gideaba ghamnyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.20",
            "verseOrgIds": [
              "2TI.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2TI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sina badiida hini damanda miighwahina gooroogeeda. Googateey geaba Eubulo ea Bude ea Lino ea Glaudio ea orjooga sean. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.21",
            "verseOrgIds": [
              "2TI.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2TI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gagasa ghoahaaghwa gurooroadaang'u Ng'utamiida. Gagasa anyasa dagheerjeanduumeeda.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.22",
            "verseOrgIds": [
              "2TI.4.22"
            ]
          }
        }
      ]
    }
  ],
