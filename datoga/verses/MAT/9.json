          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi amoasha Ng'utamiida bea booga goojeagu fuga gadiyeeda ghapka ghwalach boagaaschi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.38",
            "verseOrgIds": [
              "MAT.9.38"
            ]
