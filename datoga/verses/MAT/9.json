          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwaneayeewa Yesu jeeda mujiinajeega sean ea gharang'weaka nea goonealshi aba jeesinga ghoorajeega nyaawa siinealshacheewa ikaanyaawa nea gwarukwiida Giijasta miy bea sugoocheanduumeeda, nea ghoahaap geeyoonung'weaka sean ea gili nyooh ea sawanadeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.35",
            "verseOrgIds": [
              "MAT.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean dea eemeetuw nea gabadageat ghabwayda aba jeadaanyi aba gideaba ghwadaah gwateemban gawuurji gisilga nyaah jeagiischoochean. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.36",
            "verseOrgIds": [
              "MAT.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda ak gwayeesha giinealangaaschi, “Booga aasaang'a, ak eang'ay fuga gadiyeeda; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
            "verseOrgIds": [
              "MAT.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
