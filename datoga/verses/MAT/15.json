{
  "id": "MAT.15",
  "number": "15",
  "bookId": "MAT",
  "reference": "Matayo 15",
  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "MAT 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng'asheega siing'wanyaana fugeaba garayi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gaweesa Farisaayajeega ea ng'oorshoodiga nea gwaleabu Yerusalemu ak ghapka heeda Yesu ak ghoanyaash, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.1",
            "verseOrgIds": [
              "MAT.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghwasaan anda giinealangaagu maduupa ng'asheega siing'wanyaana fugeaba garayi bea ghaheanya? Iissa gweagiischi nea meahuuna geatinga.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.2",
            "verseOrgIds": [
              "MAT.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasha nea gwayeesha, “Anda eara agooga iissa goofooli diigheanda ASEETA aba ng'asheegeagwa oang'waanyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.3",
            "verseOrgIds": [
              "MAT.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayi ASEETA; ‘Sissiina mureeda gweanu ea geamadu,’ nea ‘Siida ang'eawi ghwaan ghana ghaamwat ea deenuusa.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.4",
            "verseOrgIds": [
              "MAT.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gooyeenyi agooga, ‘Siida iiyeesha ghwaan ghana ghaamwat, gidida gwachi jea dagoonyi, naadawji ASEETA.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.5",
            "verseOrgIds": [
              "MAT.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi aba seareeda ghaheang'wa, noanung' ghoah ng'asheanda ASEETA gidamwadaagha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.6",
            "verseOrgIds": [
              "MAT.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ea fuga amitu geat! Nidoabiiw ng'asheanda ghayi ramoaran sibaneeda siguura Isaya aba badahuukeagwa nea gwayi,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.7",
            "verseOrgIds": [
              "MAT.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Haleanjeeda ng'uta fih ririnnyeanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.9",
            "verseOrgIds": [
              "MAT.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaguursa eemeeda bwat geat ak gwayeesha, “Oaleaydiit ak ghoanali: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.10",
            "verseOrgIds": [
              "MAT.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "manda gichea gwasik ghuut ak ghang'uda siida ririnnyeanda, geaghus gidarina ghuuta, nih dea jea ghang'uda siida ririnnyeanda.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.11",
            "verseOrgIds": [
              "MAT.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gaweay heeda giinealangaaschi ak gwayeesha, “Heapi ginali gideaba gwachi Farisaayajeega iiyiiy ng'asheandida gwanyareesi?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.12",
            "verseOrgIds": [
              "MAT.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasha nea gwayeesha, “Gilinyoo ea histeanyeanda gil iimahista Bwaabeeda bea humng'eeda gajealoata. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.13",
            "verseOrgIds": [
              "MAT.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anung'waada saawa, suh fuga adoobiiwshi ng'oowi. Nea siida ng'oaw iyadoabiiw siida ng'oaw, gayghoabita duwaawi jeeda shoomanda.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.14",
            "verseOrgIds": [
              "MAT.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Betaro niny, “Ng'acha iidigaasa aba galeesu.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.15",
            "verseOrgIds": [
              "MAT.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha, “Eara agooga mandaneegwa fughareenga? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.16",
            "verseOrgIds": [
              "MAT.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mii anala eara ghamneawa gideaba gidanyooh gwasik ghuuta siida iissa ghang'ata gawa jeeda, amadu gwarita jarooda? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.17",
            "verseOrgIds": [
              "MAT.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaduuku ng'asheega rituuna ghuuta gwaleapu guroorooda, amadu ghang'uda siida ririnnyeanda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.18",
            "verseOrgIds": [
              "MAT.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba jeeda guroorooda gwarituuna giiteemshajeega munyas, nuusta siida, mealuuleega, hiseadayeanduumeeda, mareanghuumeeda, muuwuunooda ng'uyyeega, ea beeshta siida. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.19",
            "verseOrgIds": [
              "MAT.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'asheesu seaniin geang'uta siida ririnnyeanda; duuku gideaba geeyeagiischi nea meehuuna geatinga moamu ghang'uda siida ririnnyeanda.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.20",
            "verseOrgIds": [
              "MAT.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gatmooda mideawa masaweega",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.20",
            "verseOrgIds": [
              "MAT.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghabeawa Yesu hoowa ak gawa meatkwajeega Diro ea Sidoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.21",
            "verseOrgIds": [
              "MAT.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghwahidu headaanyi gatmoomba fuga Gananayo bea ng'eanyiita goojuur muuchi, nea gwayeesha, “Bwaydanaan, Ng'utamiida, Orjeeda Dawdi, gabearji hudeanyu meangeenda.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.22",
            "verseOrgIds": [
              "MAT.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ea marukusiina eara ng'ashaan. Ng'ata ghwahidu heeda giinealangaaschi ak gamus niny nea gwayeesha, “Nung'waada gawa, aba gideaba goojuura geeshteanya.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.23",
            "verseOrgIds": [
              "MAT.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasha nea gwayeesha, “Meecheaksean buuneesean geecheaksean gisilga roodeadi bea gheeh Israeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.24",
            "verseOrgIds": [
              "MAT.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwahidu gatmoodida ak gwatkuy aba madeadaanyi ak gwayeesha, “Ea Ng'utamiida weadaan.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.25",
            "verseOrgIds": [
              "MAT.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasha nea gwayeesha, “Miimiy gideaba geegeanu hamita diibiga ak geejaksa gudajeega.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.26",
            "verseOrgIds": [
              "MAT.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha, “Huumwa gil, Ng'utamiida, eara gudajeega iissa ghwaak lajanga abitpina heeda agiischeewa ghweanda nyaawa.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.27",
            "verseOrgIds": [
              "MAT.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwayeesha Yesu, “Ea Gatmooda, ang'iing'i masaweagaagu aahaw! Gagasa nyasa gidida igasayiin.” Ghahaap hudaanyi aba geeshangiga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.28",
            "verseOrgIds": [
              "MAT.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ghoahaap fuga saang'a",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.28",
            "verseOrgIds": [
              "MAT.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghabeawa Yesu hoowa ak gawa ghuuta basooda Galilaya, ak gwading'da giijeeda ak goopteada. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.29",
            "verseOrgIds": [
              "MAT.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaweay heeda eemeetuw nea geeyeassa fuga badoojiga, ea fuga manda geeshanga, ea fuga ng'oowi, ea fuga manda ghuusiga, ea suuk gea saang'a ak geayiin madeadaanyi ak ghoahaap. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.30",
            "verseOrgIds": [
              "MAT.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghaham ng'eanyi eemeeda iidaah nea gabalool fuga manda ghuusiga nea gamajeegiidi fuga badoojiga, nea gaweelweel fuga manda geeshanga, nea ghoang'wearda fuga ng'oowi, ak ghoaghaambiit ASEETA Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.31",
            "verseOrgIds": [
              "MAT.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ghoang'aata fih sagalamnyooji ang'wan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.31",
            "verseOrgIds": [
              "MAT.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaguursa Yesu giinealangaaschi ak gwayeesha, “Geasamsi eemeeni aba gideaba neandeawi eawooji samwagu nea mandeawana gilak; mabwariinya gideaba gaydasiksa gaweay nea mwaaga gil, gajiidu goohiili aba naweeda.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.32",
            "verseOrgIds": [
              "MAT.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha giinealangaaschi, “Aba hiji geendi dareapcheeda gajeanyasana yeenu hamita jea goolang'u eemeeda saang'a deenu?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.33",
            "verseOrgIds": [
              "MAT.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghoanyaash Yesu gideaba, “Goondeawi mukaataji hada?” Gwayeesha, “Ispwa ea ghweayeesu ng'ay manang'i.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.34",
            "verseOrgIds": [
              "MAT.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghwanung' goobiitpiit eemeeda aba ng'eanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.35",
            "verseOrgIds": [
              "MAT.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "gageanu mukaatajeegiga as ispwaan ea ghweayeegiga, ak ghamwaash ghawooda ak ghabwanajaada ak ghoadaw giinealanga, ak ghoadaw giinealanga eemeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.36",
            "verseOrgIds": [
              "MAT.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gweagiischi sean ea gwalang'u, ng'ata ghoawaam gheaptanga ak ghwanyiit sooscheew ispwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.37",
            "verseOrgIds": [
              "MAT.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea fuga gwachi agiischi ea sagalamnyooji ang'wan headiga ak ghwahit nea meeyiita gadeemga ea diibiga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.38",
            "verseOrgIds": [
              "MAT.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu gwaheeli eemeeda ak gwading'da maleambooda ak gawa meatkweeda Magadani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.39",
            "verseOrgIds": [
              "MAT.15.39"
            ]
          }
        }
      ]
    }
