          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidaah eemeetuw, gwading'da giijeeda, hean nea goopteada gaweay headaanyi giinealangaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.1",
            "verseOrgIds": [
              "MAT.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghoang'eat ghuuta giinealshoadaanyi nea gwayi:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.2",
            "verseOrgIds": [
              "MAT.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hooseaneega huumwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
