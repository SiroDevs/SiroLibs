          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghang'wana fuga barbari gurooruunat, aba gideaba sugoocheanduumeeda humng'eeda daanyaawa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.3",
            "verseOrgIds": [
              "MAT.5.3"
            ]
          }
        }
      ]
    },
    {
