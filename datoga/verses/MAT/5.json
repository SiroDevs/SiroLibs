          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.6",
            "verseOrgIds": [
              "MAT.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghang'wana fuga mideawa baydeayda, aba gideaba eara saawa gajeabwayda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.7",
            "verseOrgIds": [
              "MAT.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.7",
            "verseOrgIds": [
              "MAT.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghang'wana fuga mideawa gurooruunatka miyaas, aba gideaba gayghwadaah ASEETA.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.8",
            "verseOrgIds": [
              "MAT.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.8",
            "verseOrgIds": [
              "MAT.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghang'wana fuga aduuptooschi suurja, aba gideaba fiisu gajeeguura diibiga ASEETA.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.9",
            "verseOrgIds": [
              "MAT.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.9",
            "verseOrgIds": [
              "MAT.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghang'wana fuga sisawana aba doobiiwnata, aba gideaba sugoocheanduumeeda humng'eeda daanyaawa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.10",
            "verseOrgIds": [
              "MAT.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.10",
            "verseOrgIds": [
              "MAT.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghoang'wani agooga iyang'eaweegwa buuneeda nea geesawaneegwa nea geerukuna badahuukeagwa ng'asheega munyas sean aba ng'uyyeega aba badaydeanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.11",
            "verseOrgIds": [
              "MAT.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahoosana nea goong'weelayi, aba gideaba giimeardeang'wa aahaw aba humng'eeda, nih gidaghayi bay gwasawanda buuneeda sibanga ashooynaneegwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.12",
            "verseOrgIds": [
              "MAT.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Balang'da ea gheaboong'nyeanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.12",
            "verseOrgIds": [
              "MAT.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Agooga goowooschi balang'da ng'eanyiida; ama balang'da iimudugwasamu gil, gajeahindaan iijea gwasamu gil? Mudugwarachi gil geaghus eahiisa jarooda ak ghoalaaplaap buuneeda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.13",
            "verseOrgIds": [
              "MAT.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.13",
            "verseOrgIds": [
              "MAT.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Agooga goowooschi weeshinda ng'eanyiida. Mujiineeda sideeksa uhuuda heayeeda moamu ea funyaat. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.14",
            "verseOrgIds": [
              "MAT.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eara buuneeda meayeeta gheaboong'nyeanda ak geedukuteawa dahuuda iissa ghwayiin uhuuda ghamarda ak ghoabwaay buuneesean mida jeeda gheeda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.15",
            "verseOrgIds": [
              "MAT.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi eara weeshindeang'wa gagasa ghoabwaay buuneesean, amadu nea ghwadaah gadiyoojigeagwa miyaasiin ghoaghaambiit Ghweandeang'wa mida humng'eeda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.16",
            "verseOrgIds": [
              "MAT.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giinealshooda iita deaweeda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.16",
            "verseOrgIds": [
              "MAT.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Adoaghanyi gili aawunyi dayam deaweeda ghana sibanga; mwawuni dayam ghaawunyi danung' gwasa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.17",
            "verseOrgIds": [
              "MAT.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba huumwa geayeeshiineegwa; eara ghang'ata humng'eeda ea ng'eanyiida, ghanyea manda eara hiji mwanang', ghana roobadeanagi mwanang', muuchi bea deaweeda majeegeanda ea gwasa ng'asheega sean. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.18",
            "verseOrgIds": [
              "MAT.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi siida wassean jea ghwalach diigheanjagi mwanang'eawa sean, aba jeedeaba diigheanyeeksu ak ghoanaaldunu buuneeda, gajeeguura dea mwanang' muuchi aba jeeda sugoocheanduumeeda humng'eeda; amadu siidida jea gwasin nea ghoanaal suurjeaniin, nih gajeeguura dea haw aba jeeda sugoocheanduumeeda humng'eeda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.19",
            "verseOrgIds": [
              "MAT.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba geayeeshiineegwa, doobiiwnateang'wa iimaburdeawana dea ng'oorshoodiga ea dea Farisaayajeega, majaghanyi aweayeena jeeda sugoocheanduumeeda humng'eeda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.20",
            "verseOrgIds": [
              "MAT.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giinealshooda iita nyarasta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.20",
            "verseOrgIds": [
              "MAT.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghayi noayiinyi nea geerukusa fugeaba garayi gideaba, ‘Adinuusi siida; siida nuus siida gammiisa girgweaksiinda.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.21",
            "verseOrgIds": [
              "MAT.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak aniini geayeeshiineegwa, siida wassean jea gwanyareeksa orjeeda ghaamwat gammiisa girgweaksiinda; ama dea ang'eawi orjeeda ghaamwat gammiisa eata madeeda gweargwa, ama dea eesha orjeeda ghaamwat, ‘Guwoosi leekghteanda!’ Gammiisa beasta maloonghajeega. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.22",
            "verseOrgIds": [
              "MAT.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iyeadu haleanjeeda isabi geadi bea ghadooweeda badayda heeda wagiida ama deagheata giipkaadi gideaba gwanda gidindeayeesi orjeeda geamadu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.23",
            "verseOrgIds": [
              "MAT.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nung'usiina haleanjeadaang'u isabi geadi bea ghadooweeda heeda wagiida ak guwi ghanyi aduupcheena sea orjeeda geamadu, ama ng'ata gibiigu ak giidaydi haleanjeadaang'u isabi geadi bea ghadooweeda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.24",
            "verseOrgIds": [
              "MAT.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bay aduupcheewana geaw siida ahaaktaneey, damanda duu andeawana naweeda nea goondaageat heeda oogaleewi gheeda girgweageeda, amasa gayghwaanyi siida ahaaktaneey heeda siida laja girgweaguutka, ak ghwayiinyi ada geatinga furiischoocheanda ak gwajakseey ghealooniga; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.25",
            "verseOrgIds": [
              "MAT.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba huumwa geayeeshiineey, mayrinana jeeni ea eaghus ea niidayda heelajeanda huuydean.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.26",
            "verseOrgIds": [
              "MAT.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giinealshooda iita mealuuleega",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.26",
            "verseOrgIds": [
              "MAT.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghayi noayiinyi nea geeyi, ‘Adiidu goomealuuli!’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.27",
            "verseOrgIds": [
              "MAT.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghamneawa geayeeshiineegwa siida jea gang'ula gatmooda seechmeeda nigeawiit gamealuul aba jeadaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.28",
            "verseOrgIds": [
              "MAT.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iissa iinung' gheang'daang'u bea geatinda dugwa adiinya, giloati ak gijakti gwasheagiit; aba gideaba aamiy ghwashoadeeweey damealeanjagi ak ea meejaksiina saseadaang'u sean jeeda maloonghajeega. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.29",
            "verseOrgIds": [
              "MAT.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama nung' geatindaang'u bea dugwa adiinya, gilaji ak gijakti asheagiidana geaw; aba gideaba ghang'wana ghwashoadeeweey damealeanjagi ak ea meejaksiina saseadaang'u sean jeeda maloonghajeega.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.30",
            "verseOrgIds": [
              "MAT.5.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giinealshooda iita nung'wiischooda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.30",
            "verseOrgIds": [
              "MAT.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghayi sirugu gicha gideaba, ‘Siida iinung'usa heeda gatmoadaanyi ea daadawa barawajeanda nung'ooda.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.31",
            "verseOrgIds": [
              "MAT.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak aniini geayeeshiineegwa siida wassean nung' gatmoadaanyi, nea mwanung'wa aba gideaba gamealuuli, gayghwanung' gamealuul; ak siida jea ghaghi gatmooda sinung' earada gamealuuli.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.32",
            "verseOrgIds": [
              "MAT.5.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giinealshooda iita agita habeawooda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.32",
            "verseOrgIds": [
              "MAT.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gicha ea noayiinyi nea geeyeesha fugeaba garayi, ‘Adiidu giyaagi habeawooda ng'uyyeega, ak giihiidi habeawajeagaagu aba heeda Ng'utamiida.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.33",
            "verseOrgIds": [
              "MAT.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak aniini geayeeshiineegwa, adiidu ghoayaaji habeawooda eara gili mwanang', eara aba humng'eeda aba gideaba hoorgeeda sugoocheanduumeeda ASEETA gil, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.34",
            "verseOrgIds": [
              "MAT.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ghana eara aba ng'eanyiida, aba gideaba hoorgeeda iina geeshangaaschi, ghana eara aba Yerusalemu, aba gideaba mujiineeda sugoocheanda hawi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.35",
            "verseOrgIds": [
              "MAT.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adiidu giyeaksi habeawooda eara uhuudaang'u, aba gideaba miimuusi yamwa buudeanjagi nung' gaweeshiit ghana gwatuudu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.36",
            "verseOrgIds": [
              "MAT.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea ng'asheegeagwa ghoanung' ghoah ‘Ea’ ghana ‘Manda’; gili wassean nyooh ghwanaawda gwaleabu heedeaba diita muyiin.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.37",
            "verseOrgIds": [
              "MAT.5.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giinealshooda iita waldeayda mureandooda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.37",
            "verseOrgIds": [
              "MAT.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghayi noayiinyi nea geerugu gideaba, ‘Gheang'da ea gheang'da, ea geeshadeeda ea geeshadeeda.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.38",
            "verseOrgIds": [
              "MAT.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak aniini geayeeshiineegwa, adigali geaw siida muy. Siida iilas madeang'daang'u bea geatinda dugwa, giidawi eara meatkweeda niirja. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.39",
            "verseOrgIds": [
              "MAT.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea siida jea ghoahaaktaneey ak gageanda shaateadaang'u, ginung'usi eara hang'daang'u; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.40",
            "verseOrgIds": [
              "MAT.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "siida iidiing'seey beata neeki adeayeewana niba iyeenya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.41",
            "verseOrgIds": [
              "MAT.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adawa dea musnyi, dea gasa ghoalaajaneey gida ea adifuursi muwuuta.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.42",
            "verseOrgIds": [
              "MAT.5.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bariinyeega weajoodiga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.42",
            "verseOrgIds": [
              "MAT.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghayi noayiinyi nea geeyi, ‘Bwariinya giischeewoocheandaang'u ak gisti weajoocheandaang'u.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.43",
            "verseOrgIds": [
              "MAT.5.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 5:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geayeeshiineegwa, abwariinya weajoodigeagwa amoasha ghawooda aba badahuuka fuga sawaneegwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.44",
            "verseOrgIds": [
              "MAT.5.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 5:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda gajahuuwa orjooga Ghweandeang'wa mida humng'eeda; aba gideaba niny iissa daknoadaanyi gooboong'sa fuga munyas ea gea miyaas, ak gwaroobassa roopta fuga doobiiweadi ea gea mii doobiiweadi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.45",
            "verseOrgIds": [
              "MAT.5.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 5:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba iyoabwariinyi gea bariinyeagwa agooga, gajanyasa anagiimwaar? Neada eara fuga ang'oonyi gwaadi",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.46",
            "verseOrgIds": [
              "MAT.5.46"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:46",
              "type": "text"
            },
            {
              "text": "Fuga ang'oonyi gwaadi: Ghayi aba fuga Yahudi geanung' ghoah fuga munyas.",
              "type": "text"
            }
          ]
        },
        {
          "text": " saawa ea masiniidunu? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.46",
            "verseOrgIds": [
              "MAT.5.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 5:47"
          },
          "items": [
            {
              "text": "47",
