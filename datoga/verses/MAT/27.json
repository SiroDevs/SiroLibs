{
  "id": "MAT.27",
  "number": "27",
  "bookId": "MAT",
  "reference": "Matayo 27",
  "verseCount": 66,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "MAT 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu geayaat madeeda Bilato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimuchu nea ghaghar gayeew gagasa Ashoohoodiga hees ea gweargwa gichea gwanuusta Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.1",
            "verseOrgIds": [
              "MAT.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geerada aba biingu ak geayaat heeda Bilato nea siida ambal ng'eanyiita gil.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.2",
            "verseOrgIds": [
              "MAT.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miyeeda Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.2",
            "verseOrgIds": [
              "MAT.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghwadaah Yudayda heeta lah bwadaw Yesu gideaba sirgweaksa, ghang'ut giiseaneega ak googuumsa ashoohoodiga hees ea gweargwa shiliingajeegiga atiktam ea damanamughuushiin. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.3",
            "verseOrgIds": [
              "MAT.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha, “Neadiinyi aba gideaba ghaadaydi siida manda giidiinyeanda eenuus.” Gwayeesha Saawa, “Neada ghwadaseasaani aseasa? Ng'asheanji gabeacheeweey ang'iing'i.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.4",
            "verseOrgIds": [
              "MAT.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwahisa niny shiliingajeegiga jeeda gheeda sibata ASEETA, ak ghang'eat gawa ea mwahita ghwarata geaw. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.5",
            "verseOrgIds": [
              "MAT.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gageanda ashoohoodiga hees shiliingajeegiga nea gwayi, “Mamiisiina gideaba gajeayiina jeeda gheaseeda aba gideaba suh lapiyeeda foojeanda gil.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.6",
            "verseOrgIds": [
              "MAT.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwaneaji ak ghwashaaha lapiyeedida madamnyeamba siisi sineadayi dahuundiga ak ghoah heeda jea eebunyiisa rabasta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.7",
            "verseOrgIds": [
              "MAT.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghoaw gida duu eeguureewa madamnyeandida madamnyeanda foojeanda ea ghoah ghamneawa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.8",
            "verseOrgIds": [
              "MAT.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwasa ng'asheega ghayi rukuta sibaneeda siguura Yeremiya gideaba, “Gageanda lapiyaji diktam ea damanamughuush mooneeda ghayi bea siida mwas fuga Israeli gideaba gayghoadayda, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.9",
            "verseOrgIds": [
              "MAT.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ghwashaaha madamnyeanda siida sina dahuundiga gawuurji gidaghayi eeshiindanean Ng'utamiida sinda.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.10",
            "verseOrgIds": [
              "MAT.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bilato goonyeari Yesu ng'asheega",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.10",
            "verseOrgIds": [
              "MAT.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geanung' ghamiinaada Yesu aba madeeda siida haw bea ng'eanyiita. Hean ghoanyaash Siidida haw bea ng'eanyiidean nea gwayeesha, “Ang'iing'i guwoosi sugoocheanda fuga Yahudi?” Gwayeesha Yesu, “Girgu ang'iing'i.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.11",
            "verseOrgIds": [
              "MAT.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea aba damandida argweaksiina ashoohoodiga hees ea gweargweeni ghanyea mwasha eara ng'ashaan. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.12",
            "verseOrgIds": [
              "MAT.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwayeesha Bilato, “Miyiinyi ng'asheesu sean simuuwunaneeyiini?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.13",
            "verseOrgIds": [
              "MAT.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghanyea mwasha Yesu eara ng'asheanjagi ea ghahamng'eanyi siidida haw bea ng'eanyiita muuchi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.14",
            "verseOrgIds": [
              "MAT.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu geergweaksiina miyeeda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.14",
            "verseOrgIds": [
              "MAT.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iissa eaweeda ghweelmeeda gageanu siida haw bea ng'eanyiida ak gootin siyagi wassean mida ghealooniga gasa eemeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.15",
            "verseOrgIds": [
              "MAT.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba damandida gwanda siisi nalaat muuchi was siida ghealooniga siguura gheawungaaschi Baraba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.16",
            "verseOrgIds": [
              "MAT.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean iidu nea ghabwat geat buuneeda ghoanyaash Bilato gideaba, “Googasayi deatin ng'eaha, Barabahi ghana Yesuheeda siguura Gristo?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.17",
            "verseOrgIds": [
              "MAT.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghoanyaashtaaydunu nea ghwanal gideaba geayaat headaanyi aba lachng'eanyiida. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.18",
            "verseOrgIds": [
              "MAT.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damanda mideawa Bilato uhuuda hoorgeeda argweacha goojeakta gatmoadaanyi siida weah gwayeesha, “Adiidu gighasi geaw siisi doabiiwaadiin, aba gideaba geesawanan muuchi aba jeeda giirgweatka aba badaydaanyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.19",
            "verseOrgIds": [
              "MAT.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gageanu ashoohoodiga hees ea gweargwa ak ghaghoash buuneeda nea gwayeesha, amusa eetineegwa Baraba ak geenuus Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.20",
            "verseOrgIds": [
              "MAT.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghoanyaash siida haw bea ng'eanyiita nea gwayeesha, “Googasayi deatin ng'eaha aba jeedeaba fiisu asiyeenyean?” Gwayeesha saawa, “Baraba.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.21",
            "verseOrgIds": [
              "MAT.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabiikta Bilato ghoanyaash nea gwayeesha, “Ghamneawa googasayi dahindaan Yesuheeda siguura Gristo?” Gwayeesha sean, “Angoora.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.22",
            "verseOrgIds": [
              "MAT.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghoanyaashta Bilato nea gwayeesha, “Aba naaha? Neada ea niidiinya naaha?” Gabiikta saawa ghoaraanya giijuureanda nea gwayeesha, “Angoora.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.23",
            "verseOrgIds": [
              "MAT.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daah Bilato gideaba mwanyasa gil ghoahaada nyarasta, gageanu beega ak goohuun geatingaaschi aba madeeda eemeeda ak gwayeesha, “Aniini manda gichea ghwaagan aba foojeandeaba siisi asawsiina agooga nea goobea geat.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.24",
            "verseOrgIds": [
              "MAT.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasha buuneesean nea gwayeesha, “Nung'waada foojeandeaba siisi ghapka badahuukaasa ea gea diibigaasa!” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.25",
            "verseOrgIds": [
              "MAT.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gageanu ak gootissa Baraba, hit bayiiga Yesu aba mughoowooda ghoadayda Yesu eengoorsa uhuuda beehiida.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.26",
            "verseOrgIds": [
              "MAT.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shirikara gwajuuga Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.26",
            "verseOrgIds": [
              "MAT.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gageanu shirikarajeanda siida haw bea ng'eanyiita ak ghwaat Yesu jeeda gheeda sugoocheanda, ak gabassa geat shirikareeda sean. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.27",
            "verseOrgIds": [
              "MAT.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geafwakta hang'weakaaschi ak geekwealsa hang'da oomu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.28",
            "verseOrgIds": [
              "MAT.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geanap shiipka halaghweenga, ak geayiin uhuuda Yesu, nea geegeanu muudeanda ak geayiin geatindaanyi bea dugwa. Iissa geetkuy aba madeadaanyi nea geejuuga nea geeyeesha, “Seayu, Sugoocheanda Yahudi!” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.29",
            "verseOrgIds": [
              "MAT.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geeng'uriisa ng'usheega nea geegeanu muudeanda ak geabwara uhuuda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.30",
            "verseOrgIds": [
              "MAT.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iing'ata juukooda geegeanda hang'dida ak geeshuup hang'weakaaschi hean geayaat eengoor.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.31",
            "verseOrgIds": [
              "MAT.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu geengoor",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.31",
            "verseOrgIds": [
              "MAT.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea gaweay geadaah siyagi siguura Simoneeda ng'eanyiida Girene, ak geediing'sa ghwasar beehiidaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.32",
            "verseOrgIds": [
              "MAT.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sihita hiji siguura Golgota (nea gideaba dea Geapkeeda Uhuuda gil,) ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.33",
            "verseOrgIds": [
              "MAT.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "geataw difaayeeda siikuuyi sea gidang'weanda, hean samu niny ghaheawa ghwali. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.34",
            "verseOrgIds": [
              "MAT.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ning'ata giingoorda geelaja hang'weakaaschi nea geeng'alealeesa; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.35",
            "verseOrgIds": [
              "MAT.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "goobiitpiit nea gafur. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.36",
            "verseOrgIds": [
              "MAT.27.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 27:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geayiin deascheeda uhuudaanyi ng'asheega siihaaktaawa sing'waardunu, “Nih Yesu gil sugoocheanda Yahudi.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.37",
            "verseOrgIds": [
              "MAT.27.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda gwanda fih iyeenya was mareanghooga siingooruudayi sea niny, dea manda meatkweadaanyi bea geatinda dugwa, niirja gwanda meatkweeda geatinda ghaadaam. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.38",
            "verseOrgIds": [
              "MAT.27.38"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.38",
            "verseOrgIds": [
              "MAT.27.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 27:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iissa fuga ng'ata aba naweeda goong'eawi nea goodiindiil iheenga nyaawa nea gwayeesha, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.39",
            "verseOrgIds": [
              "MAT.27.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 27:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ang'iing'eeda jea gwanyarja gheeda sibata ASEETA ak ghwadeas aba eawooji samwagu, asi lealni geaw! Iiwoosi Orjeeda ASEETA, girarang'aanani uhuuda beehiida.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.40",
            "verseOrgIds": [
              "MAT.27.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 27:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwasunu eara ashoohoodiga hees ea ng'oorshoodiga ea gweargwa, gabara budeay nea gwayeesha, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.41",
            "verseOrgIds": [
              "MAT.27.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gwalealu suurja ak ea moamu gwalealu geaw. Niny sugoocheanda Israeli gil; asi dararang'aanana uhuuda beehiida ghamneawa ak abeeda eara aseasa gajeamwasa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.42",
            "verseOrgIds": [
              "MAT.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niny ghaghus ASEETA ea dalealna ghamneawa iigasa, aba gideaba gwayi, ‘Aniini Orjeeda ASEETA.’” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.43",
            "verseOrgIds": [
              "MAT.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eara fugiga was mareanghooga siingooruudayi sea ninyiin goong'eawi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.44",
            "verseOrgIds": [
              "MAT.27.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miyeeda Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.44",
            "verseOrgIds": [
              "MAT.27.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 27:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghang'eada aseeteaba lah ea ghwahita aseeteaba shageash gwadukuta ng'eanyiisean misaneeda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.45",
            "verseOrgIds": [
              "MAT.27.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 27:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea nihita aseeteaba shageash gooyeawuda Yesu nea gooheedu daghata nea gwayi, “Eloi, Eloi lama sabaktaani?” Nea gideaba, “ASEETEANYU, ASEETEANYU, anda ninung'usean heeda?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.46",
            "verseOrgIds": [
              "MAT.27.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 27:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iing'shi fugiga gwachi miinaada aba hooweani ng'asheesu gwayeena, “Gaguursa Eliya.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.47",
            "verseOrgIds": [
              "MAT.27.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 27:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghafwach Siyagi ak gageanu gheabuuscheanda ak ghoanyiit beega ng'weani ak ghwayiin uhuuda muudeanda ak ghoadaw ghwali. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.48",
            "verseOrgIds": [
              "MAT.27.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 27:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha buuneeda mwaatkwa, “Oomeasa eadaaha ea jea ghwaan gwalealu.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.49",
            "verseOrgIds": [
              "MAT.27.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 27:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabiikta Yesu gooyeawda nea gooheedu daghata amang'ata ghoabita guroorooda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.50",
            "verseOrgIds": [
              "MAT.27.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MAT 27:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghabwaasha, hang'da sibwaasha gheeda sibata ASEETA nibiyeenya, ghang'eada humng'eeda ea gagul ng'eanyi, gwasim geaw ng'eanyiida ak gabearshachi lagheanga hees; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.51",
            "verseOrgIds": [
              "MAT.27.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "MAT 27:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "ghwajaada ghuusiga bung'eadinga ak ghang'eatng'eat sasanuuka saang'a bea fuga ghayi lil. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.52",
            "verseOrgIds": [
              "MAT.27.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "MAT 27:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rinna jeesinga bung'eadinga nyaawa iing'ata duunoadaanyi, gaweay jeeda mujiineeda ghaydit ak goohiimsa geat fuga saang'a. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.53",
            "verseOrgIds": [
              "MAT.27.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "MAT 27:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean dea shirikarajeanda haw ea fuga gwachi fur Yesu gidasimda geaw ng'eanyiida ea ng'asheegiga ghwanyawa bunuun, ghabeal muuchi nea gwayi, “Aba huumwa siisi Orjeeda ASEETA gil!” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.54",
            "verseOrgIds": [
              "MAT.27.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "MAT 27:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda aba hoowa gwanda gadeemga saang'a ng'ula nea sheagi. Suh gadeemga ghayi eadu geeshta Yesu nea gwaleabu Galilaya nea gagadiiyeesa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.55",
            "verseOrgIds": [
              "MAT.27.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "MAT 27:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba jeenyaawa gwanda Mariyayda siguura Magdalena ea Mariya gheamata Yakobo ea Yosefu, ea gheamata orjooga Sebedayo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.56",
            "verseOrgIds": [
              "MAT.27.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bunyita Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "MAT 27:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.56",
            "verseOrgIds": [
              "MAT.27.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "MAT 27:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghoah shing'ada ghwahidu siyagi was meanang'oocheanda bea ng'eanyiida Arimataya siguura Yosefu. Nea abeeda eara niny ea giinealaneeda Yesu gil. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.57",
            "verseOrgIds": [
              "MAT.27.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "MAT 27:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawa heeda Bilato ak gamus saseeda Yesu, hean ghwanung' Bilato eatawa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.58",
            "verseOrgIds": [
              "MAT.27.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "MAT 27:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gageanda Yosefu saseeda Yesu ak gookwealsa hang'deesh miy. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.59",
            "verseOrgIds": [
              "MAT.27.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "MAT 27:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwayiin jeeda bung'eadaanyi eesh ghayi gurgursa jeeda harearacheanda amwahit gooreakreaksa lagheaneeda haw ghuuta bung'eeda ak gawa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.60",
            "verseOrgIds": [
              "MAT.27.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "MAT 27:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damandida goobiitpiit Mariyayda Magdalena ea Mariya niirja nea goofuursa jeesinga nyaawa bung'eeda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.61",
            "verseOrgIds": [
              "MAT.27.61"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Furita bung'eeda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "MAT 27:61"
          },
          "items": [
