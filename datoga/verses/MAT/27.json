              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.61",
            "verseOrgIds": [
              "MAT.27.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "MAT 27:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hita eaweeteaba iyeenya was eaweeda giidiing'diing'deayda, gabassa geat ashoohoodiga hees sea Farisaayajeega heeda Bilato, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.62",
            "verseOrgIds": [
              "MAT.27.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "MAT 27:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "gwayeesha, “Ea Siida mureeda, siipkaachi gidaghayi rugu siidida milmiliin damanda mii ghameawa gideaba, ‘Iing'ata eawooji samwagu gaydaduudu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.63",
            "verseOrgIds": [
              "MAT.27.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "MAT 27:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nung' eefur bung'eeda muuchi ea ghang'ata eawooji samwagu, aba gideaba gajiidu ghapka giinealangaaschi ak gwajagwat amadu gwayeeniisa buuneeda, ‘Niduuna miyeeda,’ reengaweega huuydean gayghwalaabwa hoowa dea madeeda.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.64",
            "verseOrgIds": [
              "MAT.27.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "MAT 27:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Bilato saawa, “Goondeawi furiischoodiga aweayeena afura muuchi aba gidoamuusti.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.65",
            "verseOrgIds": [
              "MAT.27.65"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "MAT 27:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gaweay ak gafur muuchi heeda sibunyiisa buuneeda nea geeroor lagheaneedida ak geayiin furiischoocheanda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.66",
            "verseOrgIds": [
              "MAT.27.66"
            ]
          }
        }
      ]
