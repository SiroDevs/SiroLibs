{
  "id": "MAT.24",
  "number": "24",
  "bookId": "MAT",
  "reference": "Matayo 24",
  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
