              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama eara haweega ghaamwat sean ea meendeawani aba hiji? Abeeda ghwanyasa yeenu siisi ng'asheesu seaniin?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.56",
            "verseOrgIds": [
              "MAT.13.56"
            ]
          }
        },
        {
