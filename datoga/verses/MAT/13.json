          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ea mudu gwasissa hoowa deamdeamang'su saang'a aba gideaba mandeawana masaweega.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.58",
