{
  "id": "MAT.13",
  "number": "13",
  "bookId": "MAT",
  "reference": "Matayo 13",
  "verseCount": 56,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "MAT 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gida sigala siida weah histeayda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eaweedida gwariteawa Yesu ghoah ak gawa goobideada aba ghuuta basooda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.1",
            "verseOrgIds": [
              "MAT.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabassa geat eemeetuw, ak geeyi bwak ea gwading'da maleambooda; ak goobideada nea ghamiinaada eemeeda aba ghuuta basooda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.2",
            "verseOrgIds": [
              "MAT.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwarukusa buuneeda ng'asheega saang'a nea gagala geat nea gwayeesha, “Ghayi gawa sih histeayda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.3",
            "verseOrgIds": [
              "MAT.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damani histeawean gwanda gea abitpisa jeeda naweeda, ghwahidu dariidaka ak ghwaak. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.4",
            "verseOrgIds": [
              "MAT.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suurja goobitpisa badahuuka harearatka, heeda manda sigeeda saang'a, deagheata gwardu iidu ea manda sigeeda ang'waay hawunga, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.5",
            "verseOrgIds": [
              "MAT.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "iidu nea gwadagu daknooda ghoaseal beasta daknooda; ak ghwasis aba gideaba manda hawunga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.6",
            "verseOrgIds": [
              "MAT.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suuk goobitpisa jeeda halaghweenga, ridu halaghweenga ghaminighis. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.7",
            "verseOrgIds": [
              "MAT.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suuk goobitpisa heeda mida sigeeda miyaas, gwardu ak gwaji akaleala bughala, gwaji niirja laadam, gwaji niirja diktam ea damanamughuush. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.8",
            "verseOrgIds": [
              "MAT.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida mideawa iidiga, ea dayiing'shi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.9",
            "verseOrgIds": [
              "MAT.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gissibaysiina galoodeaba geat bea ng'asheega",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.9",
            "verseOrgIds": [
              "MAT.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghapka headaanyi giinealanga ak gwayeesha, “Ghwasaan anda gibalooli saawa nea gigali geat ng'asheega?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.10",
            "verseOrgIds": [
              "MAT.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasha nea gwayeesha saawa, “Agooga sigooneegwa nalooda makcheameeda sugoocheanduumeeda humng'eeda, nea saawa ea miyeataw. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.11",
            "verseOrgIds": [
              "MAT.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba siida wassean mideawa gil gajeeheasa ea ghwanaawda, nea siidida mandeawana giliin, eara gidida mideawean gajeareat. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.12",
            "verseOrgIds": [
              "MAT.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nih gideabaysiini giibaloolda nyaawa nea geagali geat ng'asheegean, aba gideaba saawa iyang'wearda ea mwadaaha, ghoaleaydiit ak ea mwayiinya nea mwanala. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.13",
            "verseOrgIds": [
              "MAT.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba heanyaawa gwasa ng'asheanda rugu sibaneeda siyi Isaya nea gwayi:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.14",
            "verseOrgIds": [
              "MAT.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu gwarugu ganeega gala siida weah histeayda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.17",
            "verseOrgIds": [
              "MAT.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Asi agooga oaleaydiit gideagali siida weah histeayda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.18",
            "verseOrgIds": [
              "MAT.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida wassean iiy ng'asheanda sugoocheanduumeeda ak ea mwanala, ghwahidu gidida muyiin ak ghoasealda gidida sihisa guroroadaanyiin. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.19",
            "verseOrgIds": [
              "MAT.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea dea sihisa jeeda harearatkean ea siidida iiy ng'asheandideaniin gil ama deagheata ghoang'waay nea gang'weela. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.20",
            "verseOrgIds": [
              "MAT.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadu ea mandeawana hawunga aba jeadaanyi iissa ghoang'waay ng'asheandida gilinuwaas, ama hidu sawanadeeda ghana gapnu ghabasta aba badaydeaba ng'asheanji gabay ghoabeada. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.21",
            "verseOrgIds": [
              "MAT.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea dea abissa jeeda geediga halaghweenga, ea siidida iiy ng'asheanda amadu aba geawunda gheang'da baruureega badayda ng'eanyiida, ghaminighis ak ea mudu gwaji haghweega. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.22",
            "verseOrgIds": [
              "MAT.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea dea sihisa heeda sigeeda miyaasiin ea siidida iiy ng'asheandideaniin ak gwajeeng'uuni; nih dea jih haghweega, gwaji akaleala bughala, ak gwaji nih laadam, ak gwaji nih diktam ea damanamughuush.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.23",
            "verseOrgIds": [
              "MAT.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gida sigala morooka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.23",
            "verseOrgIds": [
              "MAT.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwarukuta gicha galeega nea gwayeesha, “Sugoocheanduumeeda humng'eeda gawuurji siida weah gwahista histeanga miyaasiin aba jeeda madamnyeandaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.24",
            "verseOrgIds": [
              "MAT.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea nilil buuneeda, ghwahidu weajoocheanda ak gwahisa morooka dang'adiga ngaano ak ghang'eat gawa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.25",
            "verseOrgIds": [
              "MAT.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ridu ngaano nea ghamwanmwan nea gwaji geadaah gaguuyi sea moorooka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.26",
            "verseOrgIds": [
              "MAT.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaweay soomjooga ak gwayeesha siidida bea madamnyeandean, ‘Ea Siida mureeda, mwaaghanyi ghayi gihisti mbeeyooda miyaasiin aba jeeda madamnyeandaang'u? Amadu gwarina yeenu moorooka?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.27",
            "verseOrgIds": [
              "MAT.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha niny, ‘Nih gwasin weajoocheanda.’ Ghoanyaash soomjooga nea gwayeesha niny, ‘Gigasayi eeweaya eamughuusha?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.28",
            "verseOrgIds": [
              "MAT.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha, ‘Manda; iyoamughuushchi morooka gajiidu ghoaloachi eara ngaano. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.29",
            "verseOrgIds": [
              "MAT.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anung'waada gwaheetu sean ea ghwahita damanda lajita; damandida gaydayeesha fugiga jea ghwalajiin, oosheeda oamughuusha morooka ak ghoarachi gharmucheeka ak geaghwarda, nea ngaano gooweamsi gijigoodeanyu.’”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.30",
            "verseOrgIds": [
              "MAT.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gida sigala ghajiileanda haradaali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.30",
            "verseOrgIds": [
              "MAT.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwarukuta gicha galeega nea gwayeesha, “Sugoocheanduumeeda humng'eeda gawuurji sea ghajiileanda geeta siguura haradaali ghayi geanu siida ak gwahisa jeeda madamnyeandaanyi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.31",
            "verseOrgIds": [
              "MAT.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "gabiissa ea mwanang'eawa ghajilga sean amadu nea gwardu gwaheedu ak geadaah nea niiw geeta haw, ghwahidu dariidaka ak gwadeeksa ghoorajeega nyaawa damealgaaschi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.32",
            "verseOrgIds": [
              "MAT.13.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gida sigala gidamwataw",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.32",
            "verseOrgIds": [
              "MAT.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwarukusa saawa gicha galeega, “Sugoocheanduumeeda humng'eeda geegala sea hamiirayda geanu gatmooda, ak googuuyi sea dearang'spa gweeraji samwagu ak geeyi bwak ea ghaghuut geaw sean.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.33",
            "verseOrgIds": [
              "MAT.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu gagadiyeata galeega",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.33",
            "verseOrgIds": [
              "MAT.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh seaniin goobaloola Yesu eemeetuw aba galeega nea moang'wa gwarukuta ng'ashaan nea manda gidagala. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.34",
            "verseOrgIds": [
              "MAT.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda ghoah huumwa ng'asheanda ghayi rugu sibaneeda nea gwayi:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.35",
            "verseOrgIds": [
              "MAT.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu gwarugu ganeega gala morooka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.35",
            "verseOrgIds": [
              "MAT.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu gwaheeli eemeetuw ak gawa ghoah. Gamaseaw giinealangaaschi ak gwayeesha “Goona ganeega ng'asheanda gwachi iigali geat sea morooka madamnyeandean.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.36",
            "verseOrgIds": [
              "MAT.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha, “Siida hista histeanga miyaasiin Orjeeda Siida; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.37",
            "verseOrgIds": [
              "MAT.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "madamnyeandida ea ng'eanyiida gil, histeanga miyas orjooga sugoocheanduumeeda; nea moorookiga ea orjoogeaba diita muyiin. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.38",
            "verseOrgIds": [
              "MAT.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea weajoocheandida histean ea meang'nyeandeenda, nea lajita ea muudeanooda ng'eanyiida, nea fuga lach ea malaykajeega. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.39",
            "verseOrgIds": [
              "MAT.13.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi gidida siimuguuriida morooka ak geang'uda beastean, ea gichea gawuurji muudeanooda ng'eanyiida. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.40",
            "verseOrgIds": [
              "MAT.13.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orjeeda Siida gaygoojeagu malaykajeagaaschi, ak ghoawaam aba jeeda sugoocheanduumeadaanyi haleanjeeda sean eadu riing'eeda ea fuga sean sina ng'asheega munyas. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.41",
            "verseOrgIds": [
              "MAT.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geehisa jeeda duwayda beasta; ak gooyeawda fuga nyaawa aba hoowa nea goowiiri geeshatka aba sawanadeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.42",
            "verseOrgIds": [
              "MAT.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda gea doobiiweadi gayghoameang'daayda ASEETA aba jeeda sugoocheanduumeeda Bwaabeeda nyaawa. Siida mideawa iidiga ea dayiinya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.43",
            "verseOrgIds": [
              "MAT.13.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gissigala lapiyeeda funyaat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.43",
            "verseOrgIds": [
              "MAT.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gicha sugoocheanduumeeda humng'eeda gawuurji gheaseeda funyaat aba jeeda madamnyeanda, ama dea siida ghafuy; aba ng'weeloadaanyi gawa ak ghwashaayda haleanjeadaanyi sean mideawa ak ghwasha madamnyeandida.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.44",
            "verseOrgIds": [
              "MAT.13.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gissigala booshcheanda haw sheayeat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.44",
            "verseOrgIds": [
              "MAT.13.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gicha sugoocheanduumeeda humng'eeda gawuurji sea siida sheahiida haleanjeeda gasa sageeka miyaas, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.45",
            "verseOrgIds": [
              "MAT.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "geeyi bwak ama dea booshcheanjagi mideawa sheayeeda haw, gawa ak ghwashaayda haleanjeadaanyi sean ak ghwasha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.46",
            "verseOrgIds": [
              "MAT.13.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gissigala gheareedanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.46",
            "verseOrgIds": [
              "MAT.13.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gicha sugoocheanduumeeda humng'eeda gawuurji sea gheareedanga siipuuta jeeda basooda, ak ghoang'waay heeluutka sean bea ghweayeega; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.47",
            "verseOrgIds": [
              "MAT.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "geeyi bwak ama nyiit, goongiiru buuneeda ea ghwahidu ghuuta basooda ak ghaghwal ghweayeega miyaasiin ak ghwayiin jeesinga dabita nyaawa nea gea munyas gwahista. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.48",
            "verseOrgIds": [
              "MAT.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nih gichea gawuurji gil eaweeda muudeanooda ng'eanyiida aba gideaba eaweedida gayghwahidu malaykajeega ak gooheeli fuga munyas ea gea doobiiweadi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.49",
            "verseOrgIds": [
              "MAT.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gwahisa fuga munyas jeeda duwayda beasta; abeeda gaygwanda buuneeda nea giiwiirda geeshatka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.50",
            "verseOrgIds": [
              "MAT.13.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Meanang'oocheanduumeeda eesh ea dea waas",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.50",
            "verseOrgIds": [
              "MAT.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MAT 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Heapi noojeeng'u ng'asheesu seaniin?” Ghwalamda Saawa ak gwayeesha, “Ea.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.51",
            "verseOrgIds": [
              "MAT.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "MAT 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha saawa, “Asi gilinyoo ea ng'oorshoocheanda gil was giinealaneeda sugoocheanduumeeda humng'eeda, gawuurji sea siida mideawa gheeda geanu aba jeeda gheaseadaanyi haleanjeeda eashish ea gea woosi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.52",
            "verseOrgIds": [
              "MAT.13.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu geaheawa aba Nasareti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "MAT 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.52",
            "verseOrgIds": [
              "MAT.13.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "MAT 13:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghoahiit Yesu galeegiga ghang'eat gawa, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.53",
            "verseOrgIds": [
              "MAT.13.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "MAT 13:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "gawa ng'eang'da nyaawa hita hoowa goonealshi aba jeeda ghooriida nyaawa siinealshacheewa, ak goonealshi ea ghahamng'eanyi buuneeda nea gwayi, “Siisi ghwanyasa yeenu weaghuumeeni ea ng'asheesu deamdeameadiin? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.54",
            "verseOrgIds": [
              "MAT.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "MAT 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neada siisi ea mii baleandeaba siidida sina beehajeegeani? Neada ghaamwat ea meeguureewana Mariya? Nea orjooga ghaamwat ea mii Yakobo gil ea Yosefu ea Simon ea Yudahi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.55",
            "verseOrgIds": [
              "MAT.13.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "MAT 13:56"
          },
          "items": [
