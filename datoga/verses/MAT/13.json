            "sid": "MAT 13:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deagheata geenyareesi aba ng'asheagaaschi. Hean gwayeesha Yesu saawa, “Sibaneeda majaghanyi ea meatawa mureeda, geaghus ea meatawa aba ng'eanyiidaanyi ea gheanyaawa.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.57",
            "verseOrgIds": [
              "MAT.13.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
