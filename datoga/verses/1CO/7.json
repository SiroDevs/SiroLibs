              "1CO.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gatmooda aaradaat iiduugwanda siyeadaanyi. Amadu nea nimi siyeadaanyi, ea niibal geaw ak ghoamu ghaghi siida gasa niny, ak geaghus fuga mida jeeda Ng'utamiida. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.39",
            "verseOrgIds": [
              "1CO.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea aba girgweageedeanyu gaygahoosan ak ghang'wana muuchi inyeeda goobideada ea meaghi. Aba gideaba eara aniini iyeang'ulayi geandeawi Guroorooda ASEETA.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.40",
            "verseOrgIds": [
              "1CO.7.40"
            ]
          }
        }
