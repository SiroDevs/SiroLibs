          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.35",
            "verseOrgIds": [
              "1CO.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi siida iidaah gideaba masisiina huda jea ghaghi gidahaguuw, nea geawundaanyi bea gheang'da gwandeawa uurda, ak ea mayghwashiy gidagasa, gidabal gwasin gidida gasean: ghang'wana gageenyi, masina riing'eeda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.36",
            "verseOrgIds": [
              "1CO.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea siida wassean hang'waanyiit aba jeeda gurooroadaanyi, ak ghanyea meediing'siina nea ghoamu ghoadeal gidida gasean, ak ea nimanya aba jeeda gurooroadaanyi, gideaba gaygwandeawa ghoah gatmoadaanyi, abeeda ghoadoabiiw. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.37",
            "verseOrgIds": [
              "1CO.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea eara siida adayda hudaanyi ghoadoabiiw; nea dea meaghi ghoadoabiiw muuchi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        }
      ]
    },
