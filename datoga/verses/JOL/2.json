          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gabiisa ghwalaja ghuut NG'UTAMIIDA ng'eanyiidaanyi,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.18",
            "verseOrgIds": [
              "JOL.2.18"
            ]
          }
        }
