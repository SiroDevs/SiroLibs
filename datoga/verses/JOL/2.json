          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ak gaydaahiimu ng'asheega deamdeameadi aba humng'eeda ea ng'eanyiida, foojeanda, ea beasta, ea arooscheeka miinaada. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.30",
            "verseOrgIds": [
              "JOL.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOL 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gajeayam aseeta ak gamisaniit, nea ghoah sheeda foojeanda, nea mii ghwahidu eaweeda haw bea NG'UTAMIIDA abeeli fih. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.31",
            "verseOrgIds": [
              "JOL.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOL 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea abeeda siida wassean jea gaguura gheawunga NG'UTAMIIDA gayghaghu; aba gideaba aba giijeeda Sayuni ea Yerusalemu gaygwanda fuga jea ghaghu, gawuurji gidanyaashta NG'UTAMIIDA; nea fuga abit gayghaghu.’”",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.32",
            "verseOrgIds": [
              "JOL.2.32"
            ]
          }
        }
      ]
    }
