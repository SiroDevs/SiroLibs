        "style": "s1"
      },
      "items": [
        {
          "text": "Deashamga gawuurji miinda gheang'da aba eaweeda NG'UTAMIIDA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Guurnooda Duukuunooda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "ASEETA ghwanung' gabiikta gwaduudu ng'eanyiida",
          "type": "text"
        }
      ]
    },
    {
