{
  "id": "1PE.2",
  "number": "2",
  "bookId": "1PE",
  "reference": "1 Betaro 2",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
