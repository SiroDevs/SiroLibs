          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gajoatayda haleanjeeda ghadooweeda bea NG'UTAMIIDA sighwarda, ghoah shearooda ng'andit, gajea heeyda mwanang' gil, ea lagweenjeanjagi, ea dayi ispwa bea gisilga was lagweendiga bea gwanyagi; ak ea maygaba siirja; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.8",
            "verseOrgIds": [
              "NUM.29.8"
            ]
          }
        },
        {
