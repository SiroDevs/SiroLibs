          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gang'ula siida Geni, ak ghoang'eat ghwasiildeangaaschi, nea gwayi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.21",
            "verseOrgIds": [
              "NUM.24.21"
            ]
          }
        }
      ]
