          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghang'eat Balaamu, ak gabiikta ghoah; ak eara Balaki gawa heechea gawa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.25",
