        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.20",
            "verseOrgIds": [
              "NUM.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
