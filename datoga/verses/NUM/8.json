      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miindeayda gheaboonyanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata goobalool NG'UTAMIIDA Musa, ak gwayeesha, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.1",
            "verseOrgIds": [
              "NUM.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abaloola Haruni ak giyeeshi, damanda jea miindaawana gheaboonyanga, gheaboonyang'su asispwaan gayghoabwaay madeeda hoorgeeda siyiina gheaboonyaneeda.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.2",
            "verseOrgIds": [
              "NUM.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwasin Haruni; ak ghwayiin gheaboonyangaaschi ghoabwaay madeeda heeda siyiina gheaboonyanga, gawuurji gidarukusiinda NG'UTAMIIDA Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.3",
            "verseOrgIds": [
              "NUM.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea nih ea gadiyeedeaba hoorgeeni bea gheaboonyaneedean, geesin nea geetaamdaamwa dahaabu; ghang'eada ng'eanyi ea ghwahita uhuuda aba gisiitaamdaamda; nea geanung' gawuurji sea gidahiimsa NG'UTAMIIDA Musa, nih gisinda hoorgeeda gheaboonyanga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.4",
            "verseOrgIds": [
              "NUM.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giimiinooda ea giighaydiita fuga Lawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.4",
            "verseOrgIds": [
              "NUM.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata goobalool NG'UTAMIIDA Musa, ak gwayeesha, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.5",
            "verseOrgIds": [
              "NUM.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Saja fuga Lawi ak giing'aami jeeda fuga Israeli, ak giighaydiidi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.6",
            "verseOrgIds": [
              "NUM.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaysisiina saawa ng'asheesu ak giimiidu; saksiina iheenga nyaawa beega ahuuni riing'eeda, ak ghwareaghwa weembe saseenuuka nyaawa sean, nea goohuuna hang'weaka nyaawa, ak ghoamiidu geat. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.7",
            "verseOrgIds": [
              "NUM.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ea dageana heewi mwanang' was eeshpajakcheanda, ea haleanjeadaanyi bea ghadooweeda was dearanga, dearanga miyaasiin guuyi sea nagheeda, ak gigeanu heew nuut mwanang' was eeshpajakcheanda ghoah haleanjeeda ghadooweeda aba badayda riing'eeda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.8",
            "verseOrgIds": [
              "NUM.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaynung' ghabwat geat fuga Lawi aba madeeda maheemajeanda siroondooscheesa; ak gajaroonyeena fuga sean bwat geat bea Israeli; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.9",
            "verseOrgIds": [
              "NUM.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gajaada fuga Lawi madeeda NG'UTAMIIDA; ama ng'ata gayghwayiin fuga Israeli geatinga nyaawa iheenga fuga Lawi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.10",
            "verseOrgIds": [
              "NUM.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gayghwaat Haruni fuga Lawi madeeda NG'UTAMIIDA ghoah haleanjeeda ghadooweeda sigatkat siikeal humng'eeda, aba badahuuka fuga Israeli, ak ghoah fuga jea gwasina gadiyeeda NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.11",
            "verseOrgIds": [
              "NUM.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak abeeda gayghwayiin fuga Lawi geatinga nyaawa iheengeaba dusu; ak gigeanu ang'iing'i danyagi ak ghoah haleanjeeda ghadooweeda aba badayda riing'eeda aba heeda NG'UTAMIIDA, nea nih bea iyeenyean ginung' ghoah haleanjeeda ghadooweeda jea eaghwarda, ak gwasin giiduupcheeda aba badahuuka fuga Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.12",
            "verseOrgIds": [
              "NUM.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gajiina fuga Lawi madeeda Haruni, ea madeeda orjoagaaschi ak ghwaat madeeda NG'UTAMIIDA ghoah haleanjeeda ghadooweeda jea eegatkat gagal humng'eeda.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.13",
            "verseOrgIds": [
              "NUM.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.13",
            "verseOrgIds": [
              "NUM.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nih gichea sachta fuga Lawi ak giiruuteawi jeeda fuga Israeli; ak gayghoah fuga Lawi fugeasu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.14",
            "verseOrgIds": [
              "NUM.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean abeeda gaygaweay fuga Lawi gah, ak gwasin gadiyeeda maheemajeanda siroondooscheesa; ak gajamiini saawa, ak giyeadu ghoah haleanjeeda ghadooweeda sigatkat. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.15",
            "verseOrgIds": [
              "NUM.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba aniini sigoonan fiisu muuchi aba jeeda fuga Israeli; gaweay hoorgajeega duweachajeega sean, aba gideaba, duweachajeega sean bea fuga sean bea Israeli, neageandi ghoah geasu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.16",
            "verseOrgIds": [
              "NUM.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba duweachajeega sean aba jeeda fuga Israeli geasu, gea buuneeda ea gea dugwa; damanda ghayi aalasi duweachajeega sean bea ng'eanyiida Misri ghamiidu aba badaydeanyu aniini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.17",
            "verseOrgIds": [
              "NUM.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak aniini ea neageanu fuga Lawi ghoaghiis hoorgeeda duweachajeega sean bea fuga Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.18",
            "verseOrgIds": [
              "NUM.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea aniini ea naadawji Haruni fiisu bea Lawiin ghoah gaaschi ea diibigaaschi, nea gwarina jeeda fuga Israeli, ak gwasin gadiyeeda jea gagadiiyeesa fuga Israeli aba jeeda maheemajeanda siroondooscheesa, ak gwasin giiduupcheeda aba badahuuka fuga Israeli; ea manda geeyoonung'weaka jeeda fuga Israeli, aba damanda jea gwaneekiisa heeda ghaydit.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.19",
            "verseOrgIds": [
              "NUM.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.19",
            "verseOrgIds": [
              "NUM.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gageanu Musa ea Haruni sea fuga bwat geat bea Israeli ak gwasissa fuga Lawi ng'asheesu; gawuurji ng'asheega sean rukusa NG'UTAMIIDA Musa aba badahuukeaba fiisu bea Lawiin, nih gidasissa saawa fuga Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.20",
            "verseOrgIds": [
              "NUM.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghoamiidu geat fuga Lawi aba riing'eeda, ak goohuun hang'weaka nyaawa; ak ghwaat Haruni madeeda NG'UTAMIIDA ghoah haleanjeeda ghadooweeda sigatkat; ak gwasin Haruni ng'asheanji aba badahuuka nyaawa ak ghoamiidu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.21",
            "verseOrgIds": [
              "NUM.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata hiji ghwahidu fuga Lawi gwasin gadiyeeda aba jeeda maheemajeanda siroondooscheesa aba madeeda Haruni ea madeeda orjoagaaschi; gawuurji gidarukusiinda NG'UTAMIIDA Musa aba iiteaba fiisu bea Lawiin, nih gidasissa saawa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.22",
            "verseOrgIds": [
              "NUM.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.22",
            "verseOrgIds": [
              "NUM.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata goobalool NG'UTAMIIDA Musa ak gwayeesha, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.23",
            "verseOrgIds": [
              "NUM.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ng'asheega jea ghwanyas fiisu bea Lawiin suh, ghang'eada fuga bea gweanyeew diktam ea muut ghana ghwanaawa gaygaweay gah gagadiiy aba gadiyeeda maheemajeanda siroondooscheesa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.24",
            "verseOrgIds": [
              "NUM.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea gidang'eada fuga bea gweanyeew haradam ea damanamughuush gayghwanung'waada sinoodeaba gadiyeani, ak ea maygudu gwasin, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.25",
            "verseOrgIds": [
              "NUM.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "geaghus gagadiiyeesa fuga gheanyaawa aba jeeda maheemajeanda siroondooscheesa, gwasin gadiyeeda weeta, ak ea maygudu gabiikta gagadiiy gicha. Nih gichea sisiina fuga Lawi aba iita furiischooda nyaawa.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.26",
            "verseOrgIds": [
              "NUM.8.26"
            ]
          }
        }
      ]
    }
