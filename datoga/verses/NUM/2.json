          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea fuga jea ghamway murdeadaanyi ea eemeeda Asheri, ak siida haw aba orjooga Asheri ea Bagieli orjeeda Okrani; ",
          "type": "text",
          "attrs": {
