          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea murdeadaanyi gaygwanda eemeeda Manase; siida nyaawa haw aba orjooga Manase ea Gamalieli orjeeda Bedasuri; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.20",
            "verseOrgIds": [
              "NUM.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea lugoadaanyi, sea fuga siyiitiisa gheanyaawa, buuneeda ea sagalamnyooji diktam ea damaniyeenya ea bughalaji iyeenya; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.21",
            "verseOrgIds": [
              "NUM.2.21"
            ]
          }
        },
        {
