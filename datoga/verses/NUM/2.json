          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak eemeeda Gadi; siida haw aba orjooga Gadi ea Eliyasafu orjeeda Deueli; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.14",
            "verseOrgIds": [
              "NUM.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea lugoadaanyi, ea fuga siyiitiisa gheanyaawa, buuneeda ea sagalamnyooji haradam ea muut ea bughalaji lah ea haradam ea damanamughuush. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.15",
            "verseOrgIds": [
              "NUM.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buuneesean siyiida aba museasooda Rubeni ea sagalamnyooji bughala ea haradam ea damwanagi ea bughalaji ang'wan ea haradam ea damanamughuush. Suh fugeaba iyeenya jea gabassa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.16",
            "verseOrgIds": [
              "NUM.2.16"
            ]
          }
        }
      ]
