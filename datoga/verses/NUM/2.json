          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea lugoadaanyi, sea fuga siyiitiisa gheanyaawa buuneeda ea sagalamnyooji haradam ea bughalaji muut. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.19",
            "verseOrgIds": [
