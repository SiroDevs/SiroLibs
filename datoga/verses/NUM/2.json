          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea lugoadaanyi, sea fuga siyiitiisa gheanyaawa, buuneeda ea sagalamnyooji diktam ea damanamuut ea bughalaji ang'wan ",
          "type": "text",
          "attrs": {
