            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghwalamda NG'UTAMIIDA ak gwayeesha Musa ea Haruni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.1",
            "verseOrgIds": [
              "NUM.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Fuga Israeli gaygaba siisi miinaada aba guumda beendeerajeanda, was giirooraneeda gealga ghweaniga nyaawa, ak gaygooduuw nea gwadeaschi maheemajeanda siroondooscheesa ak gayghamway nea gwaneaweesa meadajeega sean. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.2",
            "verseOrgIds": [
              "NUM.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea fiisu jea ghamway meatkweeda ghayeawaan, nea gwaduukusa meatkweeda arearuuna aseeta, gajea fuga mida hing'eadayda beendeerajeanda Yudahi nea siida haweewa saawa gajea Nashoni orjeeda Aminadaabu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.3",
            "verseOrgIds": [
              "NUM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "sea lugoadaanyi, sea fuga siyiitiisa gheanyaawa, buuneeda ea sagalamnyooji laadam ea damanang'wan ea bughalaji lah. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.4",
            "verseOrgIds": [
              "NUM.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea fuga jea ghamway giischeewdaanyi fuga eemeeda Isakari; was siida haweewa fuga Isakari gajea Natanaeli orjeeda Suari; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.5",
            "verseOrgIds": [
              "NUM.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea lugoadaanyi, sea fuga siyiitiisa gheanyaawa, buuneeda ea sagalamnyooji haradam ea damanang'wan ea bughalaji ang'wan; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.6",
            "verseOrgIds": [
              "NUM.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea eemeeda Sabuloni; siida haw aba jeeda orjooga Sabuloni gajea Eliyabu orjeeda Heloni; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.7",
            "verseOrgIds": [
              "NUM.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea lugoadaanyi, ea fuga siyiitiisa gheanyaawa, buuneeda ea sagalamnyooji haradam ea damanispwa ea bughalaji ang'wan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.8",
            "verseOrgIds": [
              "NUM.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buuneesean siyiida aba maheemajeanda Yuda buuneeda ea sagalamnyooji bughala ea seedam ea lah ea bughalaji ang'wan. Suh fuga jea goosheeda gaweay.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.9",
            "verseOrgIds": [
              "NUM.2.9"
            ]
          }
        }
      ]
    },
    {
