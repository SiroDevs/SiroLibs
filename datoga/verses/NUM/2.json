          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ea lugoadaanyi, sea fuga siyiitiisa gheanyaawa, buuneeda ea sagalamnyooji laadam ea iyeenya ea bughalaji ispwa. ",
          "type": "text",
          "attrs": {
