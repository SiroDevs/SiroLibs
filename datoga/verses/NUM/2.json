          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Meatkweeda duukusa wiilooda ng'eanyiida biyeara gaygwanda fuga jea gwanda hing'eadayda beendeerajeanda mughuusheanda fuga Rubeni ea lugoadaanyi; nea siida haw aba jeeda orjooga Rubeni gayghoah Elisuri orjeeda Shedeuri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.10",
            "verseOrgIds": [
              "NUM.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ea lugoadaanyi, ea fuga siyiitiisa gheanyaawa, buuneeda ea sagalamnyooji haradam ea lah ea bughalaji muut. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.11",
            "verseOrgIds": [
              "NUM.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea fuga jea ghamway giischeewdaanyi ea fuga eemeeda Simeoni; nea siida haw aba orjooga Simeoni gajea Shelumieli was orjeeda Suri-shadayi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.12",
            "verseOrgIds": [
              "NUM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea lugoadaanyi, ea fuga siyiitiisa gheanyaawa, buuneeda ea sagalamnyooji haradam ea damashageash ea bughalaji samwagu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.13",
            "verseOrgIds": [
              "NUM.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
