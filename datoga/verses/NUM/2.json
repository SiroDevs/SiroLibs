            }
          ]
        },
        {
          "text": "ea lugoadaanyi, sea fuga siyiitiisa gheanyaawa, buuneeda ea sagalamnyooji haradam ea agi ea bughalaji muut; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.28",
