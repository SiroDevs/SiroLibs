        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Deareeda deeda areara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata goobaloola NG'UTAMIIDA Musa ea Haruni ak gwayeesha, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.1",
            "verseOrgIds": [
              "NUM.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nih huumeanda deaweedeeda NG'UTAMIIDA gil rugu nea gwayi, ‘Eeshiina fuga Israeli, ayeani deeda areara miy manda sirjeeda, ak ea miyeayiin gheata yooki; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.2",
            "verseOrgIds": [
              "NUM.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gajayeani heeda ashoohoocheanda was Eliyasari, ak gaygooruuteawa jeeda museasooda, ak geenuus aba madeadaanyi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.3",
            "verseOrgIds": [
              "NUM.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygageanu ashoohoocheanda was Eliyasari foojeandaanyi aba mooneadaanyi, ak ghwasakta foojeandaanyi nea googeal madeeda maheemajeanda siroondooscheesa niba ispwa; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.4",
            "verseOrgIds": [
              "NUM.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gayghabeash siyagi danyi aba madeadaanyi; muundaanyi, ea banyeagaaschi, ea foojeandaanyi, ea fiyeagaaschi earaga gayghaghwarda; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.5",
            "verseOrgIds": [
              "NUM.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygageanu ashoohoocheanda geeta was gubooyeanda ea hisoopo ea gheabuuscheanda areara, ak gwahisa jeedeaba beastida ak deedean. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.6",
            "verseOrgIds": [
              "NUM.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygoohuun ashoohoocheanda hang'weakaaschi, ak goohuun saseadaanyi aba jeeda beega, ak abeeda gawa jeeda museasooda, ak gaygaba ririnnyaan ashoohoocheanda ea ghwahita shing'ada. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.7",
            "verseOrgIds": [
              "NUM.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak siidida ghwarda deeda aba jeeda beastean gaygoohuun hang'weakaaschi aba beega, ak goohuun saseadaanyi aba beega, ak gaygaba ririnnyaan ea ghwahita shing'ada. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.8",
            "verseOrgIds": [
              "NUM.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygageanda deareedeaba danyi siyagi miy, ak goodiing'da aba jarooda heeda miy aba riteayda museasooda, ak gajeetiiw aba fuga bwatgeat bea Israeli, ak gwasin beega jea gageanda riing'eeda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.9",
            "verseOrgIds": [
              "NUM.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea siidida raghwata deareedeaba deedidean gaygoohuun hang'weakaaschi, ak gaygaba ririnnyaan ea ghwahita shing'ada; ak ng'asheanji gayghoah diigheanda damanda manda muudeanooda, aba heeda fuga Israeli, ea heeda rabascheanda mida jeenyaawa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.10",
            "verseOrgIds": [
              "NUM.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Siida ang'waay musta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.10",
            "verseOrgIds": [
              "NUM.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nea siida ang'waay musta wassean gaygaba ririnnyaan eawooji ispwa; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.11",
            "verseOrgIds": [
              "NUM.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gayghoamiidu geaw aba beegiga eawooji samwagu, ak eaweeteaba ispwa gayghamiidu; ama moamiina geaw aba eawooji samwagu, abeeda eaweeteaba ispwa ea mayghamiidu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.12",
            "verseOrgIds": [
              "NUM.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida wassean ang'waay musta siida meah, ak ea moamiina geaw, ghang'uda ririnnyeanda maheemajeanda ghaydit bea NG'UTAMIIDA; ak siisi gajeasach aba jeeda fuga Israeli; aba gideaba miyeesaksa beegiga bea giimiinoodean, gaygaba ririnnyaan; aba gideaba gudu gwandeawa ririnnyeanda.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.13",
            "verseOrgIds": [
              "NUM.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.13",
            "verseOrgIds": [
              "NUM.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nih diigheanda gil aba siida meewsa jeeda maheemajeanda; giliwas sih weah jeedeaba maheemajeanji, ea giliwas sih mida heedeaba maheemajeanji, gaygaba ririnnyaan askwearjooji ispwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.14",
            "verseOrgIds": [
              "NUM.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak giliwas dabicheanda abwaraghuut, meedukuta aba ganyamda, gaba ririnnyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.15",
            "verseOrgIds": [
              "NUM.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea siida wassean mida jarooda jea ghoang'waay siida sibwar ghami ghana siida meah miyeeda gealaan nea mameewsiina ghoah, ghana ghoang'waay geapkeeda siida ghana bung'eeda, gaygaba ririnnyaan askwearjooji ispwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.16",
            "verseOrgIds": [
              "NUM.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak aba siida mideawa ririnnyeanda gaygageanu deareeda haleanjeeda ghadooweeda sighwarda, ak geekuuyi sea beega eenda gulda aba jeeda dabicheanda; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.17",
            "verseOrgIds": [
              "NUM.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'ata gaygageanu siyagi miy geeta siguura hisoopo ak ghang'uda jeeda beega, ak gwasaksa uhuuda maheemajeanda, ea badahuuka dabita sean, ea badahuuka fuga mida hiji, ea badayda siida ang'waay geapkeeda, ghana siida sibwar, ghana musta, ghana bung'eeda; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.18",
            "verseOrgIds": [
              "NUM.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eaweeteaba samwagu ea eaweeteaba ispwa, gaygwasaksa siida miy beesu, siisi mideawa ririnyeandean, ak gaygoohuun hang'weakaaschi nea goohuushi, ak shing'ada gajea niimmiidu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.19",
            "verseOrgIds": [
              "NUM.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nea siida mideawa ririnnyeanda ak ea moamiina geaw siidida gajeasach aba jeeda fuga bwatgeat, aba gideaba nibwara ririnnyeanda heeda ghaydit bea NG'UTAMIIDA; aba gideaba miyeesaksa beega jea ghoamiidu; niny gudugaba ririnnyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.20",
            "verseOrgIds": [
              "NUM.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gayghoah diigheanda aba heanyaawa galeagasean; nea siidida sakiida beega giimiinoodean gaygoohuun hang'weakaaschi; ak siida jea ghoang'waay beesu bea ririnyeandean gaygaba ririnnyaan ea ghwahita shing'ada. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.21",
            "verseOrgIds": [
              "NUM.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gida wasean jea ghoang'waay siida mideawa ririnnyeanda gaygaba ririnnyaan; nea siida ang'waay gil gaygaba ririnnyaan ea ghwahita shing'ada.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.22",
            "verseOrgIds": [
              "NUM.19.22"
            ]
          }
        }
      ]
    }
  ],
