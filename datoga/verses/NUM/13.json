{
  "id": "NUM.13",
  "number": "13",
  "bookId": "NUM",
  "reference": "Iitooda 13",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "NUM 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fuga ghwalda ghaang'",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghwalamda NG'UTAMIIDA ak gwayeesha Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.1",
            "verseOrgIds": [
              "NUM.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ajeakta fuga jea gaweay ghaghwalda ghaang' aba jeeda ng'eanyiida Ganaani, was dea ghayi aadawji fuga Israeli; ak aba giliwas eamwa aba gealga ghweaniga nyaawa gajageani siyagi, ak giliwas sih gajaahaw aba jeenyaawa.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.2",
            "verseOrgIds": [
              "NUM.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak goojeakta Musa ghabeawa dareapcheeda Barani gawuurji gidarukuteayda NG'UTAMIIDA; nea fiisu seaniin ea fuga heesi aba jeeda fuga Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.3",
            "verseOrgIds": [
              "NUM.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gheawunga nyaawa ea suh; aba jeeda eemeeda Rubeni, Shaamuwa orjeeda Sakuri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.4",
            "verseOrgIds": [
              "NUM.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba jeeda eemeeda Simeoni, Shafati orjeeda Hori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.5",
            "verseOrgIds": [
              "NUM.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba jeeda eemeeda Yuda, Galebu orjeeda Yefune. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.6",
            "verseOrgIds": [
              "NUM.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba jeeda eemeeda Isakari, Igali orjeeda Yosefu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.7",
            "verseOrgIds": [
              "NUM.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba jeeda eemeeda Efraimu, Hosheya orjeeda Nuni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.8",
            "verseOrgIds": [
              "NUM.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba jeeda eemeeda Benjamini, Balti gil orjeeda Rafu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.9",
            "verseOrgIds": [
              "NUM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba jeeda eemeeda Sabuloni, Gadieli orjeeda Sodi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.10",
            "verseOrgIds": [
              "NUM.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba jeeda eemeeda Yosefu, nea ea fuga eemeeda Manaseehi, Gadi orjeeda Susi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.11",
            "verseOrgIds": [
              "NUM.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba jeeda eemeeda Dani, Amieli orjeeda Gemali. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.12",
            "verseOrgIds": [
              "NUM.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba jeeda eemeeda Asheri, Seturi orjeeda Mikaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.13",
            "verseOrgIds": [
              "NUM.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba jeeda eemeeda Naftali, Nabi orjeeda Wofsi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.14",
            "verseOrgIds": [
              "NUM.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba jeeda eemeeda Gadi, Geueli orjeeda Maki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.15",
            "verseOrgIds": [
              "NUM.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh gheawunga fuga ajeakta Musa gaweay gagwalsa ghaang' ng'eanyiida. Nea Hosheya orjeeda Nuni, gang'asa Musa gheawunga siguura Yoshuwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.16",
            "verseOrgIds": [
              "NUM.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.16",
            "verseOrgIds": [
              "NUM.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak goojeakta Musa gaweay gagwalsa ghaang' ng'eanyiida Ganaani, ak gwayeesha, “Ascheang'da aweayeena ea ahita Negebu ak gooscheeng'si ng'eanyiida giijeega, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.17",
            "verseOrgIds": [
              "NUM.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ghoadaayi ng'eanyiida, giduurji; ea fuga mida jeeda, ea fuga meanyi gil ghana ea fuga heali, ak ea ng'ay ghana saang'a; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.18",
            "verseOrgIds": [
              "NUM.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ng'eanyiida abiita ea ng'eanyiida miyi ghana muy; ak goobiita museasooda ghana gealga siimajeek; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.19",
            "verseOrgIds": [
              "NUM.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ea ng'eanyiida uurjiini, ng'eanyiida miyeeneadi ghana bearji jalooda, ak gwanda dareabeeta ghana mandana. Asi oomajeega geat ak gooyeadu haghweega ng'eanyiida.” Nea aba damandida ea damanda heasa haghweega madeeda bea sabiibu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.20",
            "verseOrgIds": [
              "NUM.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.20",
            "verseOrgIds": [
              "NUM.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghwascheang'da ghaghwalda ghaang' ng'eanyiida ghang'eada dareapcheeda Sini ea ghwahita Rehobu, ea ghwahita jeeda Hamati. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.21",
            "verseOrgIds": [
              "NUM.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwascheang'da ea ghwahita Negebu, ak ghwahita Hebroni; ak ghwanyas hoowa Ahimani, ea Sheshayi, ea Dalmayi, ea orjooga Anaki. (Nea Hebroni ghayi geadeas ak ghang'ata gweanyeew ispwa nea miyeadeas mujiineeda Soani mida ng'eanyiida Misri.) ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.22",
            "verseOrgIds": [
              "NUM.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghwahita moangoachiyda Eshkoli, ak gwalagu aba hoowa damealeanda sabiibu mideawa haghweega, ak ghwasareana fih iyeenya geeta aba gheatkweaka nyaawa; ak gweadu eara goomamaanga ea shaboogheeta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.23",
            "verseOrgIds": [
              "NUM.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwangwachiydida geeguura moangoachiyda Eshkoli aba damealeandida ghayi lagu fuga Israeli aba hoowa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.24",
            "verseOrgIds": [
              "NUM.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.24",
            "verseOrgIds": [
              "NUM.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gabiigu nea nigwalsa ghaang' ng'eanyiida, nea ning'ata eawooji haradam. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.25",
            "verseOrgIds": [
              "NUM.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaweay ea ghwahita heeda Musa, ea heeda Haruni, ea heeda fuga bwat geat sean bea Israeli, aba dareapcheeda Barani, aba Gadeshi; ak gweasa saawa iita, ea fuga sean bwat geat, ak goohiimsa saawa haghweega ng'eanyiida. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.26",
            "verseOrgIds": [
              "NUM.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geeyeesha niny, “Aseasa geeleabu ng'eanyiida oocheaktaneasa; gagulda eanooga ea maleeda, ak ea sukwa haghweagaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.27",
            "verseOrgIds": [
              "NUM.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu buuneeda abiita ng'eanyiita ea meanyi nea mujiinajeega nyaawa ea majeekcheewi, ak ea hees muuchi; ak geabwadi geadaayi aba hoowa orjooga Anaki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.28",
            "verseOrgIds": [
              "NUM.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaleki goobiita ng'eanyiida Negebu; ea fuga Hiti, ea fuga Yebusi, ea fuga Amori nea goobiita giijeega, ea fuga Ganaani goobiita ghuuta basooda; ea murdeeda giigheawda Yordani.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.29",
            "verseOrgIds": [
              "NUM.13.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.29",
            "verseOrgIds": [
              "NUM.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwanung' Galebu ghwasiinda buuneeda aba madeeda Musa, ak gwayeesha, “Eaniyean anung' eascheang'da nea gealamwajaadi, ak geaghaschi; aba gideaba geamuuschi eajoara.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.30",
            "verseOrgIds": [
              "NUM.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwayi fugiga gwachi adeayi sea ninyiin. “Meamuusi eascheang'da eeng'ucheewana fugiga; aba gideaba gwandeawa uurjeenga ea gaburdeaweesa.” ",
          "type": "text",
