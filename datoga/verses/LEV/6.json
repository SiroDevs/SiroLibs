              "LEV.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwayeesha NG'UTAMIIDA Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.24",
            "verseOrgIds": [
              "LEV.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eeshiina Haruni sea orjoagaaschi, nih deaweedeeda haleanjeeda sighadoawana aba badayda riing'eeda. Aba heeda sigwardeaysa haleanjeeda sighadoawanda was heeda sinuuksa gida abeeda gajeenuus haleanjeeda sighadoawanda aba riing'eeda aba madeeda NG'UTAMIIDA; nih ea ghaydit muuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea ashoohoocheanda adayda aba badayda riing'eeda gayghwaak ak gajeeyeaksa heeda ghaydit, was madeeda maheemajeanda siroondooscheesa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.26",
            "verseOrgIds": [
              "LEV.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gida wassean jea ghawaas saseeda gayghaghaydiit; nea foojeandaanyi iiweaysa hang'da, gajahuuna hang'dida siweayeesean aba heeda ghaydit. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.27",
            "verseOrgIds": [
              "LEV.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea dahuuda sheang'weeda siiwaala gajeenyarja; ama siiwaala dabicheanda gharinyeanda areara, gajeafwaar ak geasasaja beega. ",
