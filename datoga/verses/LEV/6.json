          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwayeesha NG'UTAMIIDA Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.1",
            "verseOrgIds": [
              "LEV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ama deepa gwasin siyagi riing'eeda ak gwasin gidameateayi sea masaweega aba heeda NG'UTAMIIDA ak gwareengani giischeewoocheandaanyi aba haleanjeeda siiteaga ghana gafur, ghana ghoareat, ghana gwajirif giischeewoocheandaanyi ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.2",
            "verseOrgIds": [
              "LEV.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ghana ghwanyas gidaroat ak gwanaba ng'uyeega aba badayda, ak ghwaak habeawooda aba badayda gida wassean aba jeeda haleanjeeda sean sin siida ak gwasin riing'eeda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.3",
            "verseOrgIds": [
              "LEV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ama sin siyagi riing'eeda ak ghwanyas giidiinyeanda, gayghoadealda gidageanda aba giireeta, ghana gidanyas aba ghabasta, ghana haleanjeeda siitaw goodiiw, ghana gidaroat ghayi nyas, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.4",
            "verseOrgIds": [
              "LEV.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ghana gida wassean aksa habeawooda aba ng'uyeega; gayghoadealda gidida nea ghoanyiit, ak gayghwayiin uhuuda gideaba muut, ak ghoadaw ninyeeda was dea bea gida, aba eaweeda adaydaawa haleanjeadaanyi ghadoawana giidiinyeanda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.5",
            "verseOrgIds": [
              "LEV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygweadu heeda ashoohoocheanda haleanjeadaanyi ghadeawanda aba badayda giidiinyeanda aba heeda NG'UTAMIIDA, was lagweenda manda sirjeeda bea jeeda hawanda nooga, nea gagala sheayeeda dea haleanjeeda sighadoawanda aba badayda giidiinyeanda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwasin ashoohoocheanda giiduupcheeda aba badaydaanyi aba madeeda NG'UTAMIIDA, ak gajeesamsa aba gida wassean aba jeeda haleanjeeda deepa ea nisin ak ghwanyas giidiinyeanda.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lukghumajeega sighwarda sean",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha NG'UTAMIIDA Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.8",
            "verseOrgIds": [
              "LEV.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rukusiina Haruni ea orjoagaaschi gideaba, Nih deaweedeeda haleanjeeda ghadooweeda sighwarda. Haleanjeeda jea eaghwarda aba heeda wagiida eaweesean ea gamuchu, ak beasta heeda wagiida gajeanung'waada ghwayeat. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.9",
            "verseOrgIds": [
              "LEV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygookwa ashoohoocheanda hang'daanyi bumbun, ak gooshuup geaw hang'weaka bumbuni dukiisa jih, ak gaygageanu deareeda haleanjeeda ghadooweeda sighwarda aba heeda wagiida, ak ghwayiin murdeeda heeda wagiida. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.10",
            "verseOrgIds": [
              "LEV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gayghafwatka hang'weakaaschi, ak gookwa hang'weaka suuk, ak gooruuteawa deareeda jeeda maheemajeanda ak ghwaat heeda miy. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.11",
            "verseOrgIds": [
              "LEV.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea beasta mida heeda wagiida gayghwanung'waada ghwayeat, ak ea maygamis; ak gayghaghwar ashoohoocheanda ghweenga aba uhuuda giliwas sakteayda, ak gay gwajip muuchi haleanjeeda ghadooweeda sighadoawanda bea hoyyoo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.12",
            "verseOrgIds": [
              "LEV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gajeanung'waada ghwayeat beasta aba heeda wagiida galeagasean; nea manuusa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Booga ghadooweeda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nih deaweedeeda dearanga sighadoawanda. Gayghoadaw orjooga Haruni NG'UTAMIIDA, aba heeda wagiida. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.14",
            "verseOrgIds": [
              "LEV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygageanu siyagi ghoanyiit geatinda dearanga miyaasiin bea booga sighadoawanda ea nagheadaanyi ea geediga sean ng'andidi mida badayda booga ghadooweeda, ak ghaghwarda ghoah gichea goopkeata aba heeda wagiida, ghoah shearooda ng'andit aba heeda NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.15",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea gea abit gayghwaak Haruni sea orjoagaaschi; gajeayaat nea meanung' gamatawiidi aba heeda ghaydit; ak ghwaak aba jeeda maheemajeanda siroondooscheesa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.16",
            "verseOrgIds": [
              "LEV.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwajeawu nea geamwatawiit. Ak ghaadaydi ghoah aba heanyaawa haleanjeeda ghadooweeda sighwarda aba beasta; nih gajea gidaghaydit muuchi, gawuurji sea haleanjeeda sighadoawanda aba badayda riing'eeda ea haleanjeeda simeajanda aba badayda giidiinyeanda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.17",
            "verseOrgIds": [
              "LEV.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gilinyo ea ng'eedeeda gil aba jeeda diibiga Haruni gayghwaak ghoah raghasta galeagasean aba jeeda seaygoojigaagu, aba haleanjeeda ghadooweeda sighwarda bea NG'UTAMIIDA; nea siida wassean iisat haleanjeeni gayghaghaydiit.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
