          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gayghoadayda ashoohoocheanda agi sighadoawanda aba badayda riing'eeda nea niirja gaygaba haleanjeeda ghadooweeda sighwarda; ak gaygwasin ashoohoocheanda giiduupcheeda aba badaydaanyi aba madeeda NG'UTAMIIDA aba ririnnyeanda neaweesiina eaghwada.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.30",
            "verseOrgIds": [
              "LEV.15.30"
            ]
          }
        }
      ]
