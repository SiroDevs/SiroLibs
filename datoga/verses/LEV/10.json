    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Riing'eeda Nadabu sea Abihu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean Nadabu sea Abihu, was orjooga Haruni, gaba siisi geanu rabagiidaanyi, ak ghwayiin jeeda beasta, ak ghwayiin badayda hideeda ng'andit, ak ghoadayda beasta miighaydit aba madeeda NG'UTAMIIDA, ak gwasinda gidameerukusinda saawa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.1",
            "verseOrgIds": [
              "LEV.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwahidu beasta leabu madeeda NG'UTAMIIDA ak ghwaak saawa, ak gameewa aba madeeda NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.2",
            "verseOrgIds": [
              "LEV.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Musa Haruni, “Nih gidarugu NG'UTAMIIDA, ‘Gaydaahiimu geaw gideaba geawooschi ghaydit aba heeda fuga neekeewean, ak gajeakghaambiidan aba madeeda buuneesean.’” Hean ghwasiinda Haruni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gaguursa Musa Mishaeli sea Elisafani, was orjooga Usieli was orjeeda ghamagheamata Haruni, ak gwayeesha saawa, “Aneekiida, asareana orjeeda giyeang'wa aba madeeda maheemajeanda ghaydit siroondooscheesa.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.4",
            "verseOrgIds": [
              "LEV.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwaneekiit, ak ghwasar muscheeka nyaawa ak gooruuteawa jeeda maheemajeanda, gawuurji gidarukuteayda Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.5",
            "verseOrgIds": [
              "LEV.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Musa Haruni, sea Eleasari sea Asamari, was orjoagaaschi, “Adoanung'unyi gafararan buudeega iheengeagwa, ak ea adoabwaashaadi hang'weakeagwa, aba gideaba gajiidu goomeewayi, aba gideaba gajiidu ghwahidu nyarasta aba badahuuka buuneesean; nea orjooga giyeang'wa, sea gheesean bea Israeli, gaygooyeawda aba beasta ghwar NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.6",
            "verseOrgIds": [
              "LEV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea adooriteawi gidaghuuta maheemajeanda siroondooscheesa, aba gideaba gajiidu goomeewayi; aba gideaba nagheeda giimeardeayda bea NG'UTAMIIDA gwanda badahuukeagwa.” Ak gwasinda gidanyaashta ng'asheanda Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.7",
            "verseOrgIds": [
              "LEV.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Deaweedeeda Ashoohoodiga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.7",
            "verseOrgIds": [
              "LEV.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean goobalool NG'UTAMIIDA Haruni nea gwayeesha, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.8",
            "verseOrgIds": [
              "LEV.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Adiidu gileahi difaayi ghana gida jea goobooginyi, ang'iing'i ghana orjoagaagu, iyooweayi jeeda maheemajeanda siroondooscheesa gajiidu goomeewayi: ak gayghoah deaweeda damanda manda muudeanooda aba jeeda seaygoojigeagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.9",
            "verseOrgIds": [
              "LEV.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gajaheeleena gidaghaydit ea gidagealaan, ea gidamuy ea gidamiy; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.10",
            "verseOrgIds": [
              "LEV.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gajanaala fuga Israeli deaweedajeega sean ghayi rukuneegwa NG'UTAMIIDA aba ghuuta Musa.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.11",
            "verseOrgIds": [
              "LEV.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.11",
            "verseOrgIds": [
              "LEV.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Musa Haruni sea Eleasari sea Itamari, was orjoagaaschi siipuut, “Ageani dearanga ghadooweeda abit aba haleanjeeda ghadooweeda sighwarda siitaw NG'UTAMIIDA, ak ghoayaaji nea meamwatawiida aba murdeeda heeda wagiida, aba gideaba ea ghaydit muuchi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.12",
            "verseOrgIds": [
              "LEV.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gajaga aba heeda ghaydit, aba gideaba saruutaang'u gil ea dea orjoagaagu, aba haleanjeeda ghadooweeda sighwarda bea NG'UTAMIIDA; aba gideaba nih gidasirukuneani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.13",
            "verseOrgIds": [
              "LEV.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea giyoodida sigatgat siikeal humng'eeda ea jeatida sigoonyiin gajayaaga aba heeda miy, ang'iing'i sea orjoagaagu ea haweagaagu; aba gideaba geegooneegwa ghoah saruutaang'u ea dea orjoagaagu, was lukghumeeda was haleanjeeda ghadooweeda bea hoyyoo bea fuga Israeli ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.14",
            "verseOrgIds": [
              "LEV.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea jeatida siitaydaan ea giyoodida sigatgat ekeal humng'eedean gaygweaduudayi sea haleanjeeda ghadooweeda bea beasta was ghashneeda, ak gagatkat googeal humng'eeda ghoah haleanjeeda ghadooweeda sigatgat siikeal humng'eeda aba madeeda NG'UTAMIIDA, ak gayghoah daang'u, ea orjoagaagu, ghoah saruuteang'wa damanda manda muudeanooda; gawuurji gidarukuteayda NG'UTAMIIDA.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.15",
            "verseOrgIds": [
              "LEV.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.15",
            "verseOrgIds": [
              "LEV.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gagasa Musa mbooyda was haleanjeeda jea eaghadoawanda aba badayda riing'eeda, ak geadaah nea sighwarda! Ak ghwanyareas Eleasari sea Itamari, was orjooga Haruni siipuut nea gwayeesha, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.16",
            "verseOrgIds": [
              "LEV.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghwasaan anda meayaagi haleanjeeda sighadoawanda aba badayda riing'eeda aba heeda ghaydit, aba gideaba gidaghaydit muuchi ak ea sigooneegwa ageanda munyinda buuneeda, ak goosinyi giiduupcheeda aba badahuuka nyaawa aba madeeda NG'UTAMIIDA? ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.17",
            "verseOrgIds": [
              "LEV.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ula, foojeandaanyi meeyeana heeda ghaydit, gammiisa gideaba gaygweaksa heeda ghaydit, gawuurji gidearukuteaydi.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.18",
            "verseOrgIds": [
              "LEV.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwayeesha Haruni Musa, “Ng'ula, askweareani niidayda haleanjeeda nyaawa ghadoawanda aba badayda riing'eeda sea haleanjeeda nyaawa bea ghadooweeda sighwarda aba madeeda NG'UTAMIIDA; ak ng'asheesu sunuun ea naanyaschi! Ama inyeeda gwachi ghaayaaji haleanjeeda sighadoawanda aba badayda riing'eeda askweareani, gwachi gayghwahit aba madeeda NG'UTAMIIDA?” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.19",
            "verseOrgIds": [
              "LEV.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghwayiiy Musa ng'asheanji, ghamwas.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.20",
            "verseOrgIds": [
              "LEV.10.20"
            ]
          }
        }
      ]
    }
  ],
