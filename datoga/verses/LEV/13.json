          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwasikteawa ashoohoocheanda, ama niyamwa buudeega heeda mida dearjooda ak gaweeshiit ak gabubuga ea ghang'al mughoowooda saseeda, abeeda nih udamusuura; nibwaasha aba heeda sighwarda, ak gaygwargu ashoohoocheanda gideaba gaba ririnnyaan; nih geeyooda udamusuura. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.25",
            "verseOrgIds": [
              "LEV.13.25"
            ]
          }
        },
        {
