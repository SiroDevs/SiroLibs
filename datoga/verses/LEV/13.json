          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha NG'UTAMIIDA Musa sea Haruni, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.1",
            "verseOrgIds": [
              "LEV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Siida iideepa gwandeawa aba saseadaanyi giipkeanda ghanea umwang'da ghanea hiidoonda, ak ghwayamwa ghoah geeyooda udamusuura aba mughoowooda saseadaanyi, abeeda gajeeyeadu heeda Haruni was ashoohoocheanda ghanea heeda orjeanagi was daanyi aba jeeda ashoohoodiga; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.2",
            "verseOrgIds": [
              "LEV.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwasikteawa ashoohoocheanda geeyoodida was hiidoonda mida saseadaanyi; nea buudeega heeda mida hiidoonda iiyamwa gaweeriidi nea gabubuga heeda apka ea mawuurji sea mughoowooda saseadaanyi, nih geeyooda udamusuura; iing'ata nea nisikteawa ashoohoocheanda gaygwargu gideaba siisi gaba ririnnyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.3",
            "verseOrgIds": [
              "LEV.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu heeda was hiidoonda ii eesh aba badayda mughoowooda saseadaanyi, ak ea mabubuuga ea ea mawuurji mughoowooda saseeda, nea buudeega ea mii ghwayamwa gaweeriidi, gayghwarat ashoohoocheanda siida miyaan eawooji ispwa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.4",
            "verseOrgIds": [
              "LEV.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwasikteawa ashoohoocheanda niny eaweeteaba ispwa, amwadaah aba gheang'da ak ea mii ghaghayda geeyooda aba mughoowooda, abeeda gayghwasach aba eawooji ispwa suuk; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.5",
            "verseOrgIds": [
              "LEV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygabiikta ashoohoocheanda gwasikteawa gicha eaweeteaba ispwa, ama deepa ea nisuunya dearjooda ak ea mii ghaghayda aba badayda mughoowooda, abeeda gaygwargu ashoohoocheanda gideaba niimmiidu; nih gabeachi giipkeanda; ak gaygoohuun hang'weakaaschi, ak ghamiidu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.6",
            "verseOrgIds": [
              "LEV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama deepa ghaghayda giipkeanda aba mughoowooda, iing'ata nea niihiimsa geaw ashoohoocheanda aba giimiinoadaanyi, gaygabiikta gicha madeeda ashoohoocheanda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.7",
            "verseOrgIds": [
              "LEV.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwasikteawa ashoohoocheanda, ama deepa ea nighayda giipkeanda aba mughoowooda, abeeda gaygwargu ashoohoocheanda gideaba gaba ririnnyaan; nih udamusuura.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.8",
            "verseOrgIds": [
              "LEV.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.8",
            "verseOrgIds": [
              "LEV.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Siida wassean iideepa ea nisawan udamusuura, gajeeyeadu heeda ashoohoocheanda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.9",
            "verseOrgIds": [
              "LEV.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwasikteawa ashoohoocheanda, dea gaweeshiit hiidoonda aba badayda mughoowooda, niyam buudeega gaweeriidi, ak gwanda biyeeyda nibumbuniit aba giipkeanda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.10",
            "verseOrgIds": [
              "LEV.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nih abeeda ea udamusuureeda waasi aba mughoowooda saseadaanyi, ak gaygwargu ashoohoocheanda gideaba gaba ririnnyaan; mayghwasach, aba gideaba gaba ririnnyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.11",
            "verseOrgIds": [
              "LEV.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama nighayda udamusuura aba mughoowooda, ak gwadukuta udamusuura mughoowooda sean bea siida miyaan ghang'eada uhuuda ea ghwahita baneakta geeshta, ea ghoamu ghwadaah ashoohoocheanda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.12",
            "verseOrgIds": [
              "LEV.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeeda gaygwasikteawa ashoohoocheanda, ama nidukuta saseadaanyi sean udamusuura, gaygwargu gideaba maba ririnnyaan aba geeyooda; aba gideaba niyamwa sean gaweeshiit, ak ea niimmiidu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.13",
            "verseOrgIds": [
              "LEV.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama sidaah biyeeyda bumbuniit aba saseadaanyi, gaygaba ririnnyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.14",
            "verseOrgIds": [
              "LEV.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygwasikteawa ashoohoocheanda biyeeyda bumbuniit, ak gaygwargu gideaba siida gaba ririnnyaan; biyeeyda bumbuniit ririnnyeanda, aba gideaba nih udamusuura. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.15",
            "verseOrgIds": [
              "LEV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea biyeeyda bumbuniit iiyamwa gicha ak ghwayamwa gaweeshiit, abeeda gayghoan heeda ashoohoocheanda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.16",
            "verseOrgIds": [
              "LEV.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwasikteawa ashoohoocheanda siida, ama niyamwa geeyooda gaweeshiit, abeeda gaygwargu ashoohoocheanda gideaba siida miyaan aamiy; ak ea niimmiidu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.17",
            "verseOrgIds": [
              "LEV.13.17"
            ]
          }
        }
      ]
    },
