            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygwasikteawa ashoohoocheanda geeyooda, ak ghwasach gidida mideawa geeyoodean eawooji ispwa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
