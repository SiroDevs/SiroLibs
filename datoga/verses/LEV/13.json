              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ama abuugeada buudeega uhuuda siida, nih mearumeeda gil maba ririnnyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.40",
            "verseOrgIds": [
