          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ama mida giipkeanda mughoowooda saseeda siida ak ea nihaap, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.18",
            "verseOrgIds": [
              "LEV.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "hean gwarina heeda apka giipkeandeesh ghanea giipkeanda areara bwada eeshinda, abeeda gajeehiimsa ashoohoocheanda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.19",
            "verseOrgIds": [
              "LEV.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwasikteawa ashoohoocheanda, ama dea gideaba nighurghura muuchi ea ghang'al mughoowooda saseeda ak eara buudeega ea niyamwa gaweeriidi, abeeda gaygwargu ashoohoocheanda gideaba gaba ririnnyaan; gida udamusuura, nibwaasha ak gwardu jarooda aba jeeda giipkeanda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.20",
            "verseOrgIds": [
              "LEV.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama sikteawa ashoohoocheanda, ak ghwadaah buudeega mida badayda nea mii eashish ak ea mii gapseada muuchi ea ghang'al mughoowooda saseeda, nea gapseada, abeeda gayghwasach ashoohoocheanda aba jeemba eawooji ispwa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.21",
            "verseOrgIds": [
              "LEV.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ama deepa ea nighayda aba badayda mughoowooda, abeeda gaygwargu ashoohoocheanda gideaba gaba ririnnyaan, ninyas geeyooda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.22",
            "verseOrgIds": [
              "LEV.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama abiida hiidoonda hijagi nea mwaghayda, abeeda dearjooda deaneadeeda; abeeda gaygwargu ashoohoocheanda gideaba maba ririnnyaan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.23",
            "verseOrgIds": [
              "LEV.13.23"
            ]
          }
        }
      ]
