          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama mida uhuuda meara ghana oormeeda eesh aba gheamamda, abeeda ea udamusuureeda ghayda aba uhuuda mida mearumeeda ghana eesheeda mida gheamamda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.42",
