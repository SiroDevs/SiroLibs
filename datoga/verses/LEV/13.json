              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama ghayda nyawiishta aba mughoowooda iing'ata giimiinoadaanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.35",
            "verseOrgIds": [
