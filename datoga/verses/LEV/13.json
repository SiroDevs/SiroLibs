          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama abuugeada buudeega gheamamda siida gwandeawa mearumeeda, abeeda ea meara ak ea maba ririnnyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.41",
