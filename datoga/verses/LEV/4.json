            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwayeesha NG'UTAMIIDA Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.1",
            "verseOrgIds": [
              "LEV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eeshiina fuga Israeli, Iyadiiy siida wassean nea mabaysiina aba jeeda haleanjeeda sean rugu NG'UTAMIIDA gideaba adoosinyi, ak gwasin, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.2",
            "verseOrgIds": [
              "LEV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "amadeepa ea ashoohoocheanda simwaar jea ghwanung' ghwanyas buuneeda riing'eeda, abeeda gayghoadayda niny dea riing'eeda ghayi nisin was eeshpajakcheanda manda sirjeeda ak ghoadaw NG'UTAMIIDA aba badayda riing'eeda ghoah haleanjeeda ghadooweeda aba badayda riing'eeda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.3",
            "verseOrgIds": [
              "LEV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaygweadu jurukuta ghuuta maheemajeanda siroondooscheesa aba madeeda NG'UTAMIIDA, ak ghwayiin geatindaanyi uhuuda jurukuta, ak gwanuus jurukuta aba madeeda NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.4",
            "verseOrgIds": [
              "LEV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda ashoohoocheanda simwaar gaygageanu foojeanda jurukuta ak gweadu jeeda maheemajeanda siroondooscheesa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.5",
            "verseOrgIds": [
              "LEV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gayghang'uda ashoohoocheanda mooneadaanyi jeeda foojeanda ak ghoahiida foojeanda mwaatkwa niba ispwa aba madeeda NG'UTAMIIDA ea madeeda hang'da beashooda ghaydit. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.6",
            "verseOrgIds": [
              "LEV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygageanu ashoohoocheanda foojeanda mwaatkwa ak ghwayiin ghwanadeeda heeda wagiida ng'andit was madeeda NG'UTAMIIDA mida jeeda maheemajeanda siroondooscheesa, nea foojeanda suurja bea jurukuta gaygoohiisa badayda heeda wagiida ghoah haleanjeeda ghadooweeda sighwarda mida gidaghuuta maheemajeanda siroondooscheesa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.7",
            "verseOrgIds": [
              "LEV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea ghashneeda sean bea jurukuta sighadoawanda aba riing'eeda gaygageana ghashneeda shaghwanga dukuta gealeeda ea ghashneeda sean dukuta gealeeda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.8",
            "verseOrgIds": [
              "LEV.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak manyiinyaka asiyeenya ea ghashneeda akwa mida mananda, sea beashadeeda guwooyda gaygageanda sea manyiinyaka ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.9",
            "verseOrgIds": [
              "LEV.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "(gwasunu eara suh geegeana heeda heeyda lukghumeeda bea ghadooweeda mideawa hoyyoo), ak gayghaghwarda ashoohoocheanda aba heeda wagiida sighwariideaysa haleanjeeda ghadooweeda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.10",
            "verseOrgIds": [
              "LEV.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea muunda jurukuta ea banyeagaaschi sean, ea uhuudaanyi, ea geeshangaaschi, ea gealeedaanyi, ea heelgaaschi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.11",
            "verseOrgIds": [
              "LEV.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "gayghwasareanda jurukuta sean gooruuteawa jeeda museasooda ak ghwaat heeda miy, was heeda jea eehiisa deareeda, ak gayghaghwarda aba badayda ghweenga beasta; was heeda sihisa deareeda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.12",
            "verseOrgIds": [
              "LEV.4.12"
            ]
          }
        }
      ]
    },
    {
