          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ama deepa gwasin eemeesean bea Israeli riing'eeda nea mabaysiina nea gili geafuy aba gheanyanga eemeeda, ak gwasin ng'asheanjagi aba jeeda ng'asheega rugu NG'UTAMIIDA nea gwayi majeesin was giidiinyeanda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.13",
            "verseOrgIds": [
              "LEV.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeeda riing'eeda sin iisiyi bwak ea eanal, abeeda gayghoadayda eemeeda eeshpajakcheanda ghoah haleanjeeda sighadoawanda aba riing'eeda ak gweadu madeeda maheemajeanda siroondooscheesa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.14",
            "verseOrgIds": [
              "LEV.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gayghwayiin gweargwa geatinga nyaawa uhuuda jurukuta aba madeeda NG'UTAMIIDA, ak geenuus jurukuta aba madeeda NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.15",
            "verseOrgIds": [
              "LEV.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda gaygweadu ashoohoocheanda simwaar foojeanda mwaatkwa bea jurukuta heeda maheemajeanda siroondooscheesa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.16",
            "verseOrgIds": [
              "LEV.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gayghoabuuta ashoohoocheanda mooneadaanyi jeeda foojeanda ak gwasaksa niba ispwa madeeda NG'UTAMIIDA aba madeeda hang'da beashooda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.17",
            "verseOrgIds": [
              "LEV.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gayghwayiin foojeanda mwaatkwa gujaka heeda wagiida mida heeda maheemajeanda siroondooscheesa mida madeeda NG'UTAMIIDA; nea foojeanda abit gaygoohiisa heeda wagiida sigwariideaysa haleanjeeda ghadooweeda mida gidaghuuta maheemajeanda siroondooscheesa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.18",
            "verseOrgIds": [
              "LEV.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygageanda ghashneadaanyi sean ak ghaghwarda aba heeda wagiida ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.19",
            "verseOrgIds": [
              "LEV.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygwasindunu aba jurukuta; gawuurji gidasinda aba jurukuta siitayda ghoah haleanjeeda ghadooweeda bea riing'eeda, ak gaygwahindunu eara aba nih; ak abeeda gayghoadayda ashoohoocheanda aba badahuuka nyaawa ak gooduupchi ak gajeesamsa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.20",
            "verseOrgIds": [
              "LEV.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygooruuteawa jurukuta jeeda maheemajeanda, ak ghaghwardaayda gidaghayi ghwardaayda jurukuta madeeda; nih haleanjeeda sighadoawanda aba badayda riing'eeda eemeeda gil.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.21",
            "verseOrgIds": [
              "LEV.4.21"
            ]
          }
        }
      ]
