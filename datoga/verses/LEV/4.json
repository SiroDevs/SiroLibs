          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea riing'eeda deepa ea nisin iisinung' ghwanal, gajeenung' gweadu ghwarayda ghoah haleanjeeda ghadooweeda, ghwarayda manda sirjeeda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.23",
            "verseOrgIds": [
              "LEV.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gayghwayiin geatindaanyi uhuuda mbooyda, ak gwanuus aba heeda ghayi sinuuksa haleanjeeda ghadooweeda sighwarda aba madeeda NG'UTAMIIDA; nih haleanjeeda sighadoawanda aba badayda riing'eeda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.24",
            "verseOrgIds": [
              "LEV.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygageanu ashoohoocheanda foojeanda mwaatkwa bea haleanjeeda sighadoawanda aba badayda riing'eedean aba mooneadaanyi ak ghwayiin murdajeega heeda wagiida sigwardeay haleanjeeda sighadoawanda ak goohiisa foojeanda abit heeda wagiida sigwariideaysa haleanjeeda ghadooweeda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.25",
            "verseOrgIds": [
              "LEV.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea ghashneadaanyi sean gayghaghwarda aba heeda wagiida, gawuurji ghashneeda lukghumeeda hoyyoo sighadoawanda; abeeda ashoohoocheanda gayghoadayda aba badayda siida ea riing'eadaanyi, ak gajeesamsa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.26",
            "verseOrgIds": [
              "LEV.4.26"
            ]
          }
        }
      ]
