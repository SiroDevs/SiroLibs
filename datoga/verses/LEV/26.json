          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh deaweedajeega gil ea digheanyeeka ea huumeanyeeka sin NG'UTAMIIDA aba dageascheadaanyi sea dea fuga Israeli aba uhuuda giijeeda Sinayi aba geatinda Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        }
