          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gayghoah aba heedeang'wa sabaatoheeda jea eefuufa; ak gajarada jalooda; eaweeteaba shageash bea sheeda ghang'eada shing'ada, ghang'eada shing'ada ea ghwahita shing'ada gajeang'waanya sabaatoheedeang'wa.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.32",
            "verseOrgIds": [
              "LEV.23.32"
            ]
          }
        }
      ]
    },
