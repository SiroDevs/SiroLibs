    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Haruni ghoadayda Lukghumeeda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eaweedeaba sis gaguursa Musa Haruni sea orjoagaaschi sea gweargwa Israeli; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.1",
            "verseOrgIds": [
              "LEV.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gwayeesha Haruni, “Geanda meayda was heeyda ghoah lukghumeeda riing'eeda, ea lagweenda ghoah haleanjeeda ghadooweeda sighwarda, nea manda dea mideawa sirjeeda, ak ghoataydi aba madeeda NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.2",
            "verseOrgIds": [
              "LEV.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak giyeeshi fuga Israeli, ‘Ageani mbooyda was ghwarayda ghoah haleanjeeda sighadoawanda aba badayda riing'eeda, ea meayda ea lagweenda, bea gwanyagi manda sirjeeda, ghoah haleanjeeda ghadooweeda jea eaghwarda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.3",
            "verseOrgIds": [
              "LEV.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea heeyda ea laghweenda ghoah haleanjeeda ghadooweeda bea hoyyoo, ghoah lukghumeeda aba madeeda NG'UTAMIIDA, sea dearanga ghadooweeda siikuuyi sea nagheeda; aba gideaba askweareani gaygoohiimseey geaw NG'UTAMIIDA.’” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.4",
            "verseOrgIds": [
              "LEV.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gweadu gidaghayi rukusa Musa aba madeeda maheemajeanda siroondooscheesa; ak gwaneekiit buuneesean ak ghamiinaada aba madeeda NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.5",
            "verseOrgIds": [
              "LEV.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwayeesha Musa, “Nih gidarukuneegwa NG'UTAMIIDA; ak gaygabusseey giigheambiita NG'UTAMIIDA.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.6",
            "verseOrgIds": [
              "LEV.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Musa Haruni, “Neekiisiina heeda wagiida, ak giidaydi haleanjeadaang'u ighadoawandi aba badayda riing'eeda ea haleanjeadaang'u bea ghadooweeda sighwarda, ak giimiidu geaw ea aba badahuuka buuneeda; ak giyeadu haleanjeeda buuneeda bea ghadooweeda, giimiidu saawa; gawuurji gidarukuteayda NG'UTAMIIDA.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.7",
            "verseOrgIds": [
              "LEV.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.7",
            "verseOrgIds": [
              "LEV.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwaneekiisa Haruni heeda wagiida, ak gwanuus meayda sighadoawanda aba badayda riing'eeda, was daanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.8",
            "verseOrgIds": [
              "LEV.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwaat orjooga Haruni foojeanda headaanyi, ak ghang'uda mooneadaanyi jeeda foojeanda ak goobuutpuusa murdajeega heeda wagiida, ak goohiisa foojeanda hing'eadayda heeda wagiida; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.9",
            "verseOrgIds": [
              "LEV.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea ghashneeda ea manyiinyaka sea beashadeeda guwooyda bea gidasighadoawanda aba badayda riing'eeda gayghaghwarda aba heeda wagiida, gawuurji gidarukusiinda NG'UTAMIIDA Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.10",
            "verseOrgIds": [
              "LEV.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea banyeega ea muunda gayghaghwarda aba beasta aba murdeeda museasooda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.11",
            "verseOrgIds": [
              "LEV.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.11",
            "verseOrgIds": [
              "LEV.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwanuus gidasighadoawanda sighwarda; ak ghoadaw orjooga Haruni niny foojeanda, ak gwasaksa heeda wagiida nea gooneaweesa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.12",
            "verseOrgIds": [
              "LEV.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghoadayda niny haleanjeeda sighwarda bea ghadooweeda, was saruudaka, sea uhuuda: ak ghaghwarda aba heeda wagiida. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.13",
            "verseOrgIds": [
              "LEV.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak goohuun hiineega ea geeshanga, ak ghaghwarda sea haleanjeeda ghadooweeda sighwarda aba heeda wagiida.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.14",
            "verseOrgIds": [
              "LEV.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.14",
            "verseOrgIds": [
              "LEV.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghoadayda haleanjeeda buuneeda bea ghadooweeda, ak gageanu mbooyda sighadoawanda aba badayda riing'eeda bea buuneeda, ak gwanuus, ak ghoadayda aba badayda riing'eeda, gawuurji dea madeeda sighadoawanda aba badayda riing'eeda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.15",
            "verseOrgIds": [
              "LEV.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghoadayda haleanjeeda ghadooweeda sighwarda, ak ghoadaydaayda gidanyaashta deaweeda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.16",
            "verseOrgIds": [
              "LEV.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghoadayda dearanga ghadooweeda, ak ghoanyiit baneakta, ak ghaghwarda aba heeda wagiida, nea ghwanung' goodeayi sea haleanjeeda ghadooweeda sigwariida sakteayda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.17",
            "verseOrgIds": [
              "LEV.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.17",
            "verseOrgIds": [
              "LEV.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwanuus heeyda ea lagweenda, was lukghumeeda was haleanjeeda ghadooweeda bea hoyyoo aba badahuuka buuneeda; ak ghoadaw niny orjooga Haruni foojeanda, ak gwasaksa heeda wagiida nea gooneaweesa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.18",
            "verseOrgIds": [
              "LEV.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea ghashneeda heeyda ea dea lagweenda, was shoomng'eanda riishaat, sea ghashneeda mida badayda gealeeda, sea manyiinyaka, sea beashadeeda guwooyda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.19",
            "verseOrgIds": [
              "LEV.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "hean ghwayiin ghashneeda badayda giygweega, ak ghaghwarda ghashneeda aba heeda wagiida, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.20",
            "verseOrgIds": [
              "LEV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea giygweega ea jeata geatinda dugwa gagatkat Haruni googeal humng'eeda ghoah haleanjeeda ghadooweeda sigatkat eekeal humng'eeda aba madeeda NG'UTAMIIDA; gawuurji gidarukuteayda Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghamiinda Haruni geatingaaschi nea googeal buuneeda ak ghoadaw saawa ghawooda; ak ghwararang'aana heeda haleanjeeda ghadooweeda sighadoawanda aba badayda riing'eeda ea haleanjeeda ghadooweeda sighwarda ea haleanjeeda ghadooweeda bea hoyyoo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.22",
            "verseOrgIds": [
              "LEV.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gawa Musa sea Haruni jeeda maheemajeanda siroondooscheesa; iidu nea gwardu ghoadaw buuneeda ghawooda, ak gabussa buuneesean giigheambiita NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.23",
            "verseOrgIds": [
              "LEV.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghwahidu beasta leabu heeda NG'UTAMIIDA ak ghwaak haleanjeeda ghadooweeda sighwarda ea ghashneeda aba heeda wagiida; iidu nea ghwadaah buuneeda, goojuur, ak goobeedeayi ak gagula gheamamuunatka nyaawa ng'eanyi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.24",
            "verseOrgIds": [
              "LEV.9.24"
            ]
          }
        }
      ]
    }
