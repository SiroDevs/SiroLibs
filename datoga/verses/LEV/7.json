    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Haleanjeeda ghadooweeda bea leadeeda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nih deaweedeeda haleanjeeda ghadooweeda bea giidiinyeanda. Nih ea ghaydit muuchi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.1",
            "verseOrgIds": [
              "LEV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba heeda sinuuksa haleanjeeda ghadooweeda sighwarda gaygwanuus gidasighadoawanda aba badayda giidiinyeanda, ak gajeesaksa foojeandaanyi heeda wagiida nea geeneaweesa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.2",
            "verseOrgIds": [
              "LEV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gajeatayda ghashneadaanyi sean, shoomng'eanda riishaat, ea ghashneeda dukuta gealeeda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.3",
            "verseOrgIds": [
              "LEV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "manyiinyaka asiyeenya ea ghashneeda dukuta mida mananda, ea beashadeeda guwooyda jea ghwanung' goodeayi sea manyiinyaka; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.4",
            "verseOrgIds": [
              "LEV.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "gayghaghwarda ashoohoocheanda aba heeda wagiida ghoah haleanjeeda ghadooweeda sighwarda bea NG'UTAMIIDA; nih haleanjeeda ghadooweeda bea giidiinyeanda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.5",
            "verseOrgIds": [
              "LEV.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gilinyoo ea ng'eedeeda gil aba jeeda ashoohoodiga gayghwaak ak gajeayaak aba heeda ghaydit; nih ea ghaydit muuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.6",
            "verseOrgIds": [
              "LEV.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haleanjeeda ghadooweeda bea giidiinyeanda gawuurji sea haleanjeeda sighadoawanda aba badayda riing'eeda, deaweedeeda nyaawa ea agi; ashoohoocheanda sin giiduupcheeda aba gili siida jea ghwak ninyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.7",
            "verseOrgIds": [
              "LEV.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea ashoohoocheanda adayda haleanjeeda ghadooweeda sighwarda bea siida gayghwanyas niny muunda gidasighadoawanda sighwarda ghayi adayda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.8",
            "verseOrgIds": [
              "LEV.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea dearanga sighadoawanda siiwu nea geekghajaam aba beasta ea gea siiwaala buurda ghana furinya gaygaba ashoohoocheanda adayda haleanjeeni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.9",
            "verseOrgIds": [
              "LEV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea dearanga sighadoawanda, siikuuyi sea nagheeda ghana ea gajeami, gaygaba orjooga sean bea Haruni, nea geanung' gaba nih deena deaba niirja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.10",
            "verseOrgIds": [
              "LEV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Haleanjeeda ghadooweeda bea baditeaba geat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.10",
            "verseOrgIds": [
              "LEV.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nih deaweedeeda lukghumajeega gil was haleanjeeda ghadooweeda bea hoyyoo ammu siida ghoadaw NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.11",
            "verseOrgIds": [
              "LEV.7.11"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.11",
            "verseOrgIds": [
              "LEV.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama adayda aba badiischeesiinda, gayghoadayda sea haleanjeeda ghadooweeda bea badiischeesiinda was mukaatajeega meematawiita siikuuyi sea nagheeda, ea mukaatajeega manang'i siikuuyi nagheeda, ea mukaatajeega dearanga miyaasiin sidaksiinyi muuchi sea nagheeda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.12",
            "verseOrgIds": [
              "LEV.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sea lukghumeeda haleanjeeda ghadooweeda bea hoyyoo aba gisiitaydaawa badiischooda ak gaygweadu haleanjeeda ghadooweeda bea ghadooweeda sea mukaatajeega simatawiidi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.13",
            "verseOrgIds": [
              "LEV.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygageanu aba jeedeaba suh ak ghoadayda mukaateeheanagi aba jeeda gilakil aba jeedeaba haleanjeedida bea ghadooweedean, ghoah haleanjeeda ghadooweeda bea NG'UTAMIIDA; ak gaygaba ashoohoocheanda ahiida foojeanda haleanjeeda ghadooweeda bea hoyyoo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.14",
            "verseOrgIds": [
              "LEV.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea banyeega gidalukghumeeda was haleanjeadaanyi bea ghadooweeda bea hoyyoo siitaydaawa badiischooda gajeayaak eaweeda ghadooweadaanyi; mayghwanung'waada eara gil ea ghwahita sakteayda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.15",
            "verseOrgIds": [
              "LEV.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadu lukghumeadaanyi bea ghadooweeda ii haleanjeeda ghadooweeda sirat gil ghanea haleanjeeda sighadoawanda nea gagasa siida, gajeayaak eaweedida adaydaawa lukghumeadaanyiin, nea iimuchu gajeayaak gidida abidiin, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.16",
            "verseOrgIds": [
              "LEV.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea banyeega abit bea gidida was lukghumeedean gajeaghwarda eaweeteaba samwagu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.17",
            "verseOrgIds": [
              "LEV.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama siyaak banyeega wasean bea lukghumeeda was haleanjeadaanyi bea ghadooweeda eaweeteaba samwagu, siida adayda mwajeamwas, ak ea manda gichea ghwanyas aba badaydaanyi; nih gidaanyi, nea siida ak gayghwanyas ng'asheega munyas.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.18",
            "verseOrgIds": [
              "LEV.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.18",
            "verseOrgIds": [
              "LEV.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Banyeega waas geat sea gida wassean miimiy ea majeayaak; gajeaghwarda aba beasta. Fuga sean miyas gayghwaak banyeega, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.19",
            "verseOrgIds": [
              "LEV.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea siida ak banyeega lukghumeeda NG'UTAMIIDA bea hoyyoo was haleanjeeda ghadooweeda nea gwanda badayda munyinda, siisi gajeasach aba jeeda fugaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.20",
            "verseOrgIds": [
              "LEV.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea siida iisat gida mideawa ririnnyeanda, ada ea siispa ririnnyaan gil ghanea diyeayda muy ghanea gida wasean muy, ama ng'ata ghwaak banyeega lukghumeeda NG'UTAMIIDA was haleanjeeda ghadooweeda bea hoyyoo, nea gideaba siidida gajeasach aba jeeda fugaaschi.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.21",
            "verseOrgIds": [
              "LEV.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.21",
            "verseOrgIds": [
              "LEV.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha NG'UTAMIIDA Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.22",
            "verseOrgIds": [
              "LEV.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eeshiina fuga Israeli, majayaaga ghashneeda, dea heeyda, ghana dea gisilleanda, ghana mbooyda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.23",
            "verseOrgIds": [
              "LEV.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghashneeda diyeayda meah nea gaba geaw, ea ghashneeda diyeayda bwaashaada suurja, gajeasach aba gadiya nuut nea aba gheatkweaka sean ghanyi ea majayaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.24",
            "verseOrgIds": [
              "LEV.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba siida ak ghashneeda diyeayda ghadooweeda sighwarda bea NG'UTAMIIDA gajeeheeli sea fugaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.25",
            "verseOrgIds": [
              "LEV.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwasunu ghwaraanya majayaaga foojeanda, adagaba dariideanda ghana gaba diyeayda, aba hiji wassean oondi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.26",
            "verseOrgIds": [
              "LEV.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida wassean iiyaak foojeanda, siisi gajeasach aba jeeda fugaaschi.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.27",
            "verseOrgIds": [
              "LEV.7.27"
            ]
          }
        }
      ]
    },
