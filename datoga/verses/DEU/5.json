            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Apkaada eaweeda sabaato, ak giighaydiidi, ghoah gidarukuneataneey NG'UTAMIIDA was ASEATAANG'U. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eawooji lah gadiyeena, sina gadiyoojigaagu sean; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.13",
            "verseOrgIds": [
              "DEU.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea eaweeteaba ispwa ea sabaatoheeda NG'UTAMIIDA was ASEATAANG'U, eaweecheanji adigadiiyi ang'iing'i ea orjoagaagu ghana haweagaagu ghana soomjoagaagu headiga ea gea gadeemga ghana heeyda ea digeadaang'u, ghana rabascheanda mida jeedeaba gheang'u, hean eara soomjooga headiga ea gea gadeemga gaygafuufta gidifuufti ang'iing'i. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eaweecheanji bea fuufteani gaygoopkeaneegwa gideaba ang'iing'i gajapkaada gideaba ghayi guwoosi soomjeanda aba ng'eanyiida Misri, ak gooruuneegwa NG'UTAMIIDA was ASEETA aba geatingaaschi hoauur, ghoah gidearukuneegwa gideaba asisiina mureeda eaweeda sabaato.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        }
      ]
    },
