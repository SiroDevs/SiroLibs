              "DEU.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Adiidu goosisi geat sanaamu jea gawuurji giliwas sean mida humng'eeda ghana gwanda ng'eanyi, ghana gida mida jeeda beega uuta ng'eanyiida. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.8",
            "verseOrgIds": [
              "DEU.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adiidu gootkuysi sanaamu ghana aghadoawana aba gideaba Aniini NG'UTAMIIDA geawooschi ASEETEANG'WA ng'waan jih gaydeang'easa diibiga riing'eega ghweaniga nyaawa ea gagul seaygeedeaba samwagu ea deaba ang'wan ea gea mabwariinyaan, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.9",
            "verseOrgIds": [
              "DEU.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea geahiimsi bariinyeegeasu huumwa seaygooji sagalamnyoojiga bea fuga bwariinyan nea gwasissa mureeda diigheanyeekeasu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.10",
            "verseOrgIds": [
              "DEU.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
