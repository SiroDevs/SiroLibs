{
  "id": "DEU.15",
  "number": "15",
  "bookId": "DEU",
  "reference": "Giipkeata Diigheanda 15",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
