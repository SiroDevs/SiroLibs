              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Oaleaydiit, ea humng'eeda, ak gaydabalool,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.1",
            "verseOrgIds": [
              "DEU.32.1"
            ]
          }
        }
