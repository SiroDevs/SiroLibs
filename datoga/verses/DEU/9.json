              "type": "text"
            }
          ]
        },
        {
          "text": "Apkaada fugaagu bea gadiyeeda was Abrahamu ea Isaka ea Yakobo, adiidu ging'ulayi rootoodeaba fiisu, ghana ramaseanyeeka nyaawa ghana riing'eeda nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.27",
            "verseOrgIds": [
