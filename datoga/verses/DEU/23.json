{
  "id": "DEU.23",
  "number": "23",
  "bookId": "DEU",
  "reference": "Giipkeata Diigheanda 23",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
