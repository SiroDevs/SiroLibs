              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea iiheeleewi geaw radita gida, abeeda ea manda riing'eeda jea nyasa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi fura ng'asheega rinna ghuutaang'u ak gisini, aba gideaba giradi gida aba gidigasiidi aba heeda NG'UTAMIIDA was ASEATAANG'U aba badayda gidiheeleesi sea niny ak girgu aba ghuutaang'u.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
        }
      ]
    },
