          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean goombaliischi Sulemani aba badayda fuga Israeli gweanyeew haradam. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghami Sulemani ak geebung'sa murdeeda ghweanigaaschi, ak geebung'sa jeeda mujiineeda Dawdeeda was ghweandaanyi; ak Rehoboameeda was orjeedaanyi goombaliischi aba hoorgeadaanyi.",
          "type": "text",
