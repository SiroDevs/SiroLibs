{
  "id": "2CH.14",
  "number": "14",
  "bookId": "2CH",
  "reference": "2 Damanyoojiga 14",
  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
