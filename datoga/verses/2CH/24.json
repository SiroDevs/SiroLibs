{
  "id": "2CH.24",
  "number": "24",
  "bookId": "2CH",
  "reference": "2 Damanyoojiga 24",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
