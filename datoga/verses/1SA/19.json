{
  "id": "1SA.19",
  "number": "19",
  "bookId": "1SA",
  "reference": "1 Samweli 19",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
