{
  "id": "1SA.16",
  "number": "16",
  "bookId": "1SA",
  "reference": "1 Samweli 16",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
