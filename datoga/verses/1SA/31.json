  "bookId": "1SA",
  "reference": "1 Samweli 31",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "1SA 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miyeeda Sawli ea orjoagaaschi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimuchu gang'uchi fuga Filisti sea fuga Israeli; ak gamng'aw fuga Israeli aba madeeda fuga Filisti, ak geabwar aba Giijeeda Gilbowa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.1",
            "verseOrgIds": [
              "1SA.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghoang'waay fuga Filisti Sawli sea orjoagaaschi; ak ghabwar fuga Filisti Yonatan ea Abinadabu ea Malkishuwa, was orjooga Sawli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.2",
            "verseOrgIds": [
              "1SA.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghang'waaniit ng'ucheeda muuchi aba badayda Sawli, ak gafu fuga mideawa ghuweanga niny; ak gwasawan muuchi fuga mideawa ghuweanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.3",
            "verseOrgIds": [
              "1SA.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Sawli siida sareeni dabitaanyi bea ng'ucheeda, “Fakni ng'utaang'u, ak gung'udanaan, adiidu ghwahidu fiisu miyeeyiiliin ak ghang'udan nea gwashikean.” Ak ghaheawa siidaanyi sareeni dabita ng'ucheeda; aba gideaba ghabeal muuchi. Hean gageanu Sawli ng'utaanyi, ak goobeedeaysa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.4",
            "verseOrgIds": [
              "1SA.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghwadaah siidaanyi sareeni dabita ng'ucheeda gideaba nimi Sawli, eara niny goobeedeaysa ng'utaanyi, ak gameewuudayi sea niny. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.5",
            "verseOrgIds": [
              "1SA.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghami Sawli, sea orjoagaaschi asamwagu, ea siidaanyi sareeni dabitaanyi bea ng'ucheeda, sea fugaaschi sean eaweedida. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.6",
            "verseOrgIds": [
              "1SA.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean nea ghwadaah fuga Israeli mida giigheawda mooheeda ea giigheawda Yordani gideaba nimng'aw fuga Israeli, ea gideaba nimi Sawli sea orjoagaaschi, gwanung'usa heeda mujiinajeega nyaawa, ak gwasalda; ak gaweay fuga Filisti ak ghamway jeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.7",
            "verseOrgIds": [
              "1SA.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimuchu nea ghwahidu fuga Filisti nea gagasa gageanda haleanjeeda miyaasiin bea fuga meewa, ghwahita nea Sawli ea orjoagaaschi ea nimeewa aba uhuuda Giijeeda Gilbowa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.8",
            "verseOrgIds": [
              "1SA.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwalach gheataanyi, ak ghang'aw dabitaanyi bea ng'ucheeda, ak geecheakta giijasoodiga gaweay murdajeega sean bea ng'eanyiida Filisti, gwarukusa iita gealga sanaamajeega nyaawa ea buuneeda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.9",
            "verseOrgIds": [
              "1SA.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geayiin dabitaanyi jeeda gheeda bata aseeta Ashtaroti; ak geeng'oorsa saseadaanyi ghamarda Bet-shani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.10",
            "verseOrgIds": [
              "1SA.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean nea gwayiing'shi fuga Yabesh-gileyadi iita gidanisima fuga Filisti Sawli, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.11",
            "verseOrgIds": [
              "1SA.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ghang'eat ng'eat fuga sean daruusi, ak gaweay eaweesean, ak gageanda musta Sawli ea muscheeka orjoagaaschi aba ghamarda aba Bet-shani; ak ghapka Yabeshi ak ghaghwarda sean aba hoowa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.12",
            "verseOrgIds": [
              "1SA.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gageanda geaka nyaawa ak gabung'sa guumda ghuyeanda aba Yabeshi, ak gooluulda geat eawooji ispwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.13",
            "verseOrgIds": [
              "1SA.31.13"
            ]
          }
        }
      ]
    }
  ],
