          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghwanung'waada fiisu asamwaguun sheayda ghuuta Ayubu, aba gideaba aba madeeda gheanyangaaschi nea gaba geaw. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.1",
            "verseOrgIds": [
              "JOB.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwanyareas Elihu was orjeeda Barakeli bea eemeeda Busi, bea gheeh Ramu, ak gwanyareeksa Ayubu aba gideaba Ayubu ghwadaah geaw gideaba ea doabiiwaat ea ghang'al ASEETA; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.2",
            "verseOrgIds": [
              "JOB.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghwayeat nyarastaanyi aba badahuukeaba orjoogiga asamwagu rooroochiin aba gideaba measha ghuuta, earapeadi rugu gideaba Ayubu gwandeawa giidiinyeanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.3",
            "verseOrgIds": [
              "JOB.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda Elihu ghoamuughu gabalool sea Ayubu aba gideaba buuneeda suurja ea woosi ea ghwanaawa niny. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.4",
            "verseOrgIds": [
              "JOB.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean nea ghwadaah Elihu manda ng'asheanda rinna ghuusigeaba fiisu asamwaguun, hean ghwanyareas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.5",
            "verseOrgIds": [
              "JOB.32.5"
            ]
          }
        }
      ]
    },
