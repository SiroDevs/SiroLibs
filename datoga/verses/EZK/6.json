{
  "id": "EZK.6",
  "number": "6",
  "bookId": "EZK",
  "reference": "Esekieli 6",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
