          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwayeeshiinean, ghooriini mida meatkweeda wiilooda ng'eanyiida biyearean gaba ashoohoodiga was gea gadiiyi aba gheeda sibata ASEETA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.45",
