        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ea gatmooda Samariya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimuchu nea ninal Ng'utamiida gideaba niyiiy Farisaayajeega gideaba Yesu ninyas giinealanga saang'a burdeawa Yohana nea goobaatiisan ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.1",
            "verseOrgIds": [
              "JHN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "(nea Yesu niny ea miigoobaatiisan buuneeda, goobaatiisan ginealangaaschi), ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.2",
            "verseOrgIds": [
              "JHN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ghabeawa ng'eanyiida Yudeya ak gabiikta gicha Galilaya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.3",
            "verseOrgIds": [
              "JHN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba beadi gaygwasik jeeda ng'eanyiida Samariya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.4",
            "verseOrgIds": [
              "JHN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwahita mujiineeda Samariya siguura Sikari, neekeewa madamnyeanda ghayi adaw Yakobo orjeedaanyi siguura Yosefu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.5",
            "verseOrgIds": [
              "JHN.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda gwanda hoowa healadeeda Yakobo, hean ea nibur Yesu aba beata, ak goopteada aba murdeeda healadeeda. Nea abeeda gaba aseeta lah.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.6",
            "verseOrgIds": [
              "JHN.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.6",
            "verseOrgIds": [
              "JHN.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu ghwahidu gatmoomba Samariya ghwaram beega. Gwayeesha Yesu niny, “Goonean beesu aaleayi.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.7",
            "verseOrgIds": [
              "JHN.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda aba damandida niweay ginealangaaschi mujiini ghwasha hamita. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.8",
            "verseOrgIds": [
              "JHN.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Gatmoodida bea Samariyahiin niny, “Ang'iing'i guwoosi siida Yahudi, nea aniini geawooschi gatmooda Samariya giimuustiin gideaba gaymusean beega?” Aba gideaba fuga Yahudi maguuyi haleanja sea fuga Samariya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.9",
            "verseOrgIds": [
              "JHN.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasha Yesu nea gwayeesha niny, “Inyeeda ghwanyawa ginali haleanjeeda goona ASEETA ak ea ng'eaha gil siida eeshiineey, ‘Goonean beega jea dali,’ ghwanyawa gaymusa niny ak gaygagoonyi beega mideawa eaweega.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.10",
            "verseOrgIds": [
              "JHN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Gatmoodida niny, “Ea orjeeda siida mureeda ang'iing'i mindeawani geammooda jea ramnana beega, ak ghabwada nih healadeeda easheagi jih; abeeda gaygeannana yeenu beesu mideawa eaweegean? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.11",
            "verseOrgIds": [
              "JHN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neada ang'iing'i guwoosi haweewa ghweandeanya was Yakobo gooneasa healadeani nea ghwali niny beega sea diibigaaschi ea dugwaaschi?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.12",
            "verseOrgIds": [
              "JHN.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Yesu gatmoodida, “Siida wassean nyooh ghwali beesu gaygabiikta ghwaak muwoash, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.13",
            "verseOrgIds": [
              "JHN.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "amaduuku siichea ghwali beega jea daadaw aniini mayghwaak muwoash earahay; aba gideaba beegiga jea daadawiin gayghoah aba jeadaanyi gheang'deenda nea goobeakbeaksa eaweega manda muudeanooda.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.14",
            "verseOrgIds": [
              "JHN.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Gatmoodida niny, “Siida mureeda, eaniyean goonean beesu, ea mabiikta ghwaagan muwoash gicha nea meabiikni hiji daram beega.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.15",
            "verseOrgIds": [
              "JHN.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.15",
            "verseOrgIds": [
              "JHN.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Yesu niny, “Una, guursiina siyeadaang'u ak giideani hiji.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.16",
            "verseOrgIds": [
              "JHN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha gatmoodida niny, “Meandeawani siyeeda.” Gwayeesha Yesu gatmoodida, “Asi girgu huumwa gideaba, ‘Mindeawani siyeeda’; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.17",
            "verseOrgIds": [
              "JHN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba gideaba nindeawi siyeendi muut, ak ghamneawa nih indeawiin ea mii siyeadaang'u gil. Asi aba hiji girgu huumwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.18",
            "verseOrgIds": [
              "JHN.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Gatmoodida niny, “Siida mureeda, aniini iyeang'ulayi guwoosi sibaneeda. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.19",
            "verseOrgIds": [
              "JHN.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghweanigaasa ghayi iissa ghaghadoawan ASEETA aba uhuudeaba giijeeni, amadu gooyeenyi agooga heeda miisa ghadoawanda ASEETA Yerusalemu gil.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.20",
            "verseOrgIds": [
              "JHN.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Yesu gatmoodida, “Iya, mwasaan, ghwaan damanda jea ea majaghadoawana Bwaabwa aba uhuudeaba giijeeni, ghana hoowa bea Yerusalemuun. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.21",
            "verseOrgIds": [
              "JHN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agooga iissa ghoaghadoawanyi gida moanali, duuku aseasa geanali gida sighadoawanyi, aba gideaba lealeanooda gwaleabu heeda fuga Yahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.22",
            "verseOrgIds": [
              "JHN.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghamneawa ghwaan damanda, nea damanda gwanda, nea fuga ghadoawan bea huumwa gayghadoawan Bwaabwa aba guroorooda ea huumwa, aba gideaba Bwaabwa gagaseadayi ghaghadoawan fuga sunu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.23",
            "verseOrgIds": [
              "JHN.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ASEETA guroorooda gil nea fuga ghadoawan niny gammiisa ghaghadoawan aba guroorooda ea huumwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.24",
            "verseOrgIds": [
              "JHN.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Gatmoodida niny, “Ghaanali gideaba gayghwahidu Masiyeeda (siguura Gristo), eaweeda hina gayghoahiimneasa ng'asheega sean.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.25",
            "verseOrgIds": [
              "JHN.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Yesu gatmoodida, “Aniineani ghamneawa abaloolnyiin niny gil.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.26",
            "verseOrgIds": [
              "JHN.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.26",
            "verseOrgIds": [
              "JHN.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deagheata ghapka Ginealangaaschi ak ghahamng'eanyi iidaah nea goobalool gatmooda, ghanyi ea manda siida eesha, “Gigasayi naaha?” ghana “Ghwasaan anda gibalooli sea gatmooda?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.27",
            "verseOrgIds": [
              "JHN.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwanung'usa Gatmoodida sirbiidaanyi heeda ak gawa mujiini amahita gwarukusa buuneeda gideaba, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.28",
            "verseOrgIds": [
              "JHN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Apkaani adaaha siida rukunean ng'asheegeasu sean ghayi easinyi! Siisi gajea mii Gristohi?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.29",
            "verseOrgIds": [
              "JHN.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghabeawa buuneeda mujiini ak gaweay headaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.30",
            "verseOrgIds": [
              "JHN.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.30",
            "verseOrgIds": [
              "JHN.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba damandida gamearmearani Ginealangaaschi nea gwayeesha, “Rabi, agiischeena.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.31",
            "verseOrgIds": [
              "JHN.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwayeesha niny saawa, “Aniini geandeawi hamita jea daak moanali agooga.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.32",
            "verseOrgIds": [
              "JHN.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean goonyeari geat giinealanga gideaba, “Gwadeepa gwanda siida niyeassa hamita?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.33",
            "verseOrgIds": [
              "JHN.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Yesu saawa, “Hamiteanyu sinooda gidabwariiy siida ghayi ajeaknean gil, ak ghaahiichi gadiyeadaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.34",
            "verseOrgIds": [
              "JHN.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neada ea mooyeeni agooga, ‘Ghwashoada sheeh ang'wan ak ghwahit, ak gay ghwahidu damanda lajita booga’? Ak geayeeshiineegwa aniini, oang'weerda ak ghoadaayi beadooda madameega nigeawiit gaweeriidi aba lajita. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.35",
            "verseOrgIds": [
              "JHN.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida lach booga ninyas mushaahareadaanyi, nea iissa ghoawaam haghweega aba eaweega manda muudeanooda, ak abeeda gaygahoosan duwaawi siida heeta hista ea dea lach. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.36",
            "verseOrgIds": [
              "JHN.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghoah huumwa ng'asheanda ghayi sirugu bea gideaba, ‘Gwahista siyagi ak ghwalach siinuut.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.37",
            "verseOrgIds": [
              "JHN.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniini geajeaktaneegwa alaja booga mii agadiyeesiina, ghayi gagadiiy fih suuk ak ghamneawa agooga ea nooweayi jeeda gadiyeeda nyaawa.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.38",
            "verseOrgIds": [
              "JHN.4.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.38",
            "verseOrgIds": [
              "JHN.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghamwas fuga saang'a bea Samariya niny aba jeedeaba mujiineedida aba badayda muuwuunoodeaba gatmoodida, bea gideaba, “Gwarukunean ng'asheega sean ghayi easinyiin.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.39",
            "verseOrgIds": [
              "JHN.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaweay fuga Samariya heeda ak gamus gwandeayi saawa, ak goobiida hoowa eawooji iyeenya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.40",
            "verseOrgIds": [
              "JHN.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghamwas fuga saang'a muuchi aba badayda ng'asheandaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.41",
            "verseOrgIds": [
              "JHN.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha saawa gatmoodida, “Aseasa meamwasi aba ng'asheagaagu irugu, aseasa siyiinyi, ak geanali gideaba aba huumwa siisi lealnoocheanda ng'eanyiida.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.42",
            "verseOrgIds": [
              "JHN.4.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ghoahaap orjeeda siida haw",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.42",
            "verseOrgIds": [
              "JHN.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iing'ata eawooji iyeenya ghabeawa hoowa ak gawa ng'eanyiida Galilaya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.43",
            "verseOrgIds": [
              "JHN.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba Yesu gamuuwu gideaba sibaneeda moamu ghwanyas mureeda aba ng'eanyiidaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.44",
            "verseOrgIds": [
              "JHN.4.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 4:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean hita Galilaya, ghwadeapta fuga Galilaya, aba gideaba eara saawa abeeda gwanda jeeda ghweelmeeda, ak ea nidaah ng'asheega sean sin aba Yerusalemu damandida bea ghweelmeedean. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.45",
            "verseOrgIds": [
              "JHN.4.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 4:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabiikta gicha mujiineeda Ganeeda Galilaya heeda ghayi yamwa beega ak ghoah difaayeeda. Abeeda gwanda Gapernaumu siisi haw mideawa orjeeda miyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.46",
            "verseOrgIds": [
              "JHN.4.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 4:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghwayiiy siidida gideaba Yesu niwuna ng'eanyiida Yudeya ak ea nihidu Galilaya gawa heeda ak gamus gideaba beeni ahaabwa orjeedeanyu ghabwar miyeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.47",
            "verseOrgIds": [
              "JHN.4.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 4:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwayeesha Yesu, “Iimoadaahi gwadeagooda ea haleanjeeda deamdeameadi ea majamwasa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.48",
            "verseOrgIds": [
              "JHN.4.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 4:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Siidida hawiin niny, “Siida mureeda, eaniyean nung' eeweaya heeda miighameawa jeepteanyu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.49",
            "verseOrgIds": [
              "JHN.4.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 4:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Yesu niny, “Una; orjeedang'u eamajeek.” Hean ghamwas Siidida ng'asheega Yesu ak ghang'eat gawa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.50",
            "verseOrgIds": [
              "JHN.4.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 4:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damandida duu ghwararang'aadawaan, gwaroonyi sea soomjoagaaschi ak geerukusa gideaba orjeedaanyi eamajeek. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.51",
            "verseOrgIds": [
              "JHN.4.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 4:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghoanyaashta niny damanda haabwa baleanda, gwayeesha saawa, “Ghabeawa sheagheeda heeta askweari nea gaba aseeta ispwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.52",
            "verseOrgIds": [
              "JHN.4.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 4:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu ghoapkaat ghwaan gideaba damandida rukusiina Yesu gideaba, “Orjeedaang'u ea majeegiin”; hean ghamwas niny, sea fugeaba gheanyi sean. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.53",
            "verseOrgIds": [
              "JHN.4.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JHN 4:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nih gwadeagoodeaba iyeenya sin Yesu gil damanda leapna ng'eanyiida Yudeya nea gawa Galilaya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.54",
            "verseOrgIds": [
              "JHN.4.54"
            ]
          }
        }
      ]
    }
  ],
