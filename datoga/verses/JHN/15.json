{
  "id": "JHN.15",
  "number": "15",
  "bookId": "JHN",
  "reference": "Yohana 15",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JHN 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu sabiibooda huumwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aniini geawooschi sabiibooda huumwa, nea Bwaabwa ea siida bea madamnyeanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.1",
            "verseOrgIds": [
              "JHN.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gilinyoo ea damealeanda gil mida jeedeanyu iimaji haghweega, iissa ghwalach, nea gilinyoo ea damealeanda jihi iissa gwasisin, ak abeeda gwaji muuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.2",
            "verseOrgIds": [
              "JHN.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agooga siimiineegwa aba ng'asheanda earukuneegwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.3",
            "verseOrgIds": [
              "JHN.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oopiidana jeedeanyu, nea geabiidi jeesingeagwa. Gawuurji gidamoamuusta damealeanda gwaji haghweega nea gaba geaw, nea mwanoasa sabiibu, gwasunu eara agooga, moamuusi ajiila haghweega iimoopiidani jeedeanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.4",
            "verseOrgIds": [
              "JHN.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniini geawooschi sabiibu, goowooschi agooga damealga. Siida abiida jeedeanyu, nea geabiidi aniini jeadaanyi, siisi gaygwaji haghweega saang'a, aba gideaba iimeandani aniini ea moamuusi asina eara gil. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.5",
            "verseOrgIds": [
              "JHN.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida wassean meabiidana jeedeanyu, gajealach ak ghaghajaamiit; iissa gageanu damealga ak ghoamughuush, ak gwajaksa jeeda beasta ak goosha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.6",
            "verseOrgIds": [
              "JHN.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyoopiidi jeedeanyu, nea goobiida ng'asheegeasu jeesingeagwa, abeeda amusa gida wassean oogasayi ak gajeesineegwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.7",
            "verseOrgIds": [
              "JHN.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba nih geakghambiit Bwaabwa, iissa iyoojiili haghweega saang'a, nea ghoahuuyi giinealangeasu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.8",
            "verseOrgIds": [
              "JHN.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gidabwariiydanaan Bwaabwa, eara aniini ghabwariiyduneegwa; asi oopiidana jeeda bariinyeegeasu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.9",
            "verseOrgIds": [
              "JHN.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyoang'waanyi diigheanyeekeasu, gajoopiidana jeeda bariinyeegeasu, ak gawuurji gida aang'oaydi digheanyeeka Bwaabwa nea geabiidi jeeda bariinyeagaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.10",
            "verseOrgIds": [
              "JHN.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nearukuneegwa ng'asheesu ak abeeda goobiida hooseaneegeasu jeesingeagwa, ak abeeda ghwahit hooseaneegeagwa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.11",
            "verseOrgIds": [
              "JHN.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.11",
            "verseOrgIds": [
              "JHN.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nih digheandeanyu gil, ak goobariinyiidi geat gidabwariiydaneegwa aniini. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.12",
            "verseOrgIds": [
              "JHN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manda siida mideawa bariinyeega huumwa ea ghwalaabwa hoowa nih, bea gideaba ghoaghaashta siida eaweagaaschi aba badahuuka fuga duupchiin gil. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.13",
            "verseOrgIds": [
              "JHN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agooga goowooschi fuga eaduupcheewi iyoosinyi ng'asheega earukuneegwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.14",
            "verseOrgIds": [
              "JHN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maygudu gabiikta daguureewaneegwa soomjooga aba gideaba soomjeanda iissa ea mwanala gissin siidaanyi haw, ak ghamneawa aniini ea neaguureewaneegwa fuga eaduupcheewi aba gideaba nearukuneegwa ng'asheega sean eayiing'si heeda Bwaabwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.15",
            "verseOrgIds": [
              "JHN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniini moaloadaan agooga, ghaaloacheagwa aniini ak ghaanung' aweayeena ak goojiili haghweega jea ghwashng'u; ak abeeda gagooneegwa Bwaabwa gida wassean iyoomuschi aba gheawungeasu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.16",
            "verseOrgIds": [
              "JHN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi geagonyeegwa diigheanji, abwariinya geat.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.17",
            "verseOrgIds": [
              "JHN.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sicheeda ng'eanyiida",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.17",
            "verseOrgIds": [
              "JHN.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Agooga iisideagwa ng'eanyiida, ghoapkaachi gideaba ghayi nibay ghwastan heeda mii ghwastaneagwa agooga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.18",
            "verseOrgIds": [
              "JHN.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyeeda ghwanyawa goobeayi ng'eanyiida, gwachi gayghabwariiy ng'eanyiida fugaaschi; asi aba gideaba moabeahi ng'eanyiida, geaghus gideaba ghaaloacheagwa aba jeeda ng'eanyiida, aba sareani ghwasteagwa ng'eanyiida. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.19",
            "verseOrgIds": [
              "JHN.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oapkaada ng'asheanda ghayi earukuneegwa, bea gideaba, ‘Soomjeanda miihaweewa siida haw.’ Iinukwa nisawanan aniini, eara agooga gaygwasawaneegwa; inyeeda gwachi ghoang'waay ng'asheandeanyu, gayghoang'waay eara ng'asheegeagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.20",
            "verseOrgIds": [
              "JHN.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadu gaygwasineegwa ng'asheesu seaniin aba badaydeanyu, aba gideaba saawa mwanala dea ajeaknean. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.21",
            "verseOrgIds": [
              "JHN.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyeeda ea mwaawuni ak gearukusi saawa ghwanyawa ea maygwandeawa riing'eeda; ak ghamneawa ea manda gichea ghwashaang'da aba riing'eeda nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.22",
            "verseOrgIds": [
              "JHN.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida sidan aniini abeeda ghwasit eara Bwaabwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.23",
            "verseOrgIds": [
              "JHN.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyeeda ea measisiini gadiyeeda dageascheeda nyaawa gadiyoojiga manda siida nisin, gwachi ea maygwandeawa riing'eeda; ak ghamneawa ea nidaah ak ghwastan aniini ea Bwaabwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.24",
            "verseOrgIds": [
              "JHN.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwasa gidasung'oar aba jeeda deaweeda gideaba, ‘Ghwastan mwadaagha.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.25",
            "verseOrgIds": [
              "JHN.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eaweeda hina Weedaneeda jea deajeagu ghwaan heedeang'wa nea gwaleabu heeda Bwaabwa, nea Guroorooda huumeanda, jea gwaleabu heeda Ghweanda, gaygamuuwunean; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.26",
            "verseOrgIds": [
              "JHN.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "eara Agooga goowooschi muushoodiga, aba gideaba geendeayi ghang'eada mwadi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.27",
            "verseOrgIds": [
              "JHN.15.27"
            ]
          }
        }
      ]
    }
  ],
