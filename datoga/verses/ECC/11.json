          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ang'iing'i gheareemaneeda, hoosana aba gheareemaneanduumeadaang'u, sina gidabwariiy gurooroadaang'u, ea gidagasa gheanyangaagu; ak ginali gideaba aba ng'asheesu seaniin gaygoorgweakseey ASEETA.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
