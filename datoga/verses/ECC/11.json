          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sakteayda hista boagaagu, nea shing'ada ea adiideali geatindaang'u. Aba gideaba ang'iing'i minali akeega gil gea jea gwardu ea nih gil ghana ea nihi, ghana ea jea ghoah sean.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
