            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawuurji gidaminaldani ang'iing'i naweeda jeameeda aneeda, gidaheetiideayda geaka aba jeeda bungaroocheanda; gwasunu minali gadiyeeda ASEETA, sina haleanjeeda sean.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
