          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea siida iyabiida ng'eanyiida gweanyeeka saang'a, gagasa gahoosana sean; ak ea dapkaada askwearjoojiga jea ghwahidu bea misaneeda, aba gideaba gajea saang'a. Ng'asheega sean jea ghwahidu marachi gil.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng'asheega siitaw gheareemanga",
          "type": "text"
        }
      ]
    },
    {
