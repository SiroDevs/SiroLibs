            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weeshinda aamiy ak aamiy aba gheang'da iing'ulayi aseeta.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.7",
            "verseOrgIds": [
              "ECC.11.7"
