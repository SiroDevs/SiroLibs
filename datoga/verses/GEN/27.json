              "GEN.27.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 27:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda Isakeeda was ghwaan ak gwayeesha;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.39",
            "verseOrgIds": [
              "GEN.27.39"
            ]
          }
        }
