          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Rebeka Isaka, “Aniini neaburji nea ghoamiyaanan gatmooda eemeeda Hiti. Nea Yakobo earada iigheah huda eemoojiga uurji nih, ghana gatmoodeaba ng'eanyiita, abeeda eaweegeasu mii niisha?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.46",
            "verseOrgIds": [
              "GEN.27.46"
            ]
          }
        }
