              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.40",
            "verseOrgIds": [
              "GEN.27.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 27:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghwasit Esawu Yakobo aba badayda ghawooda adaw ghwaan, ng'ata gwayeesha geaw, “Askwearjoojiga jea deayeawda bwaabwa nineekiit; ak abeeda gaydanuus Yakobo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.41",
            "verseOrgIds": [
              "GEN.27.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimuchu nea ghwayiiy Rebeka ng'asheega orjeedaanyi haw was Esawu; hean gawa ak gaguursa orjeedaanyi mwanang' was Yakobo, ak gwayeesha, “Ng'ula, orjeeda geamadu gayghawalda mureandooda ak gagasa gwanuusnyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.42",
            "verseOrgIds": [
              "GEN.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi orjeedeanyu, aleeysiiniit ng'asheegeasu; asi ng'eada, ak gimng'awsi gheeh Labani was orjeediyya mida ng'eanyiida Harani, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.43",
            "verseOrgIds": [
              "GEN.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ginyo ghanyi mideewana gili nuwaas, ea ghanyi ghahawda nyarasta orjeeda geamadu; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.44",
            "verseOrgIds": [
              "GEN.27.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 27:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "geaghus eeyi bwak ea ghahawda nyarasta orjeeda geamadu, ea gwaroosa gida isimi niny; abeeda gaydeajeagu siida jea goodeelneey. Neada ghwasaan inyas gaydahuteawi orjoogeasu duwaawi aba eaweecheanjagi?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.45",
            "verseOrgIds": [
              "GEN.27.45"
            ]
          }
        }
      ]
    },
