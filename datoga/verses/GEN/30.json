          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.36",
            "verseOrgIds": [
              "GEN.30.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 30:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gageanu Yakobo ng'aritka shabeadi bea seegiida ea gooseamng'eanda, ea lagawjeanda, ak ghawaas badatka mwaatkwa ak gaweeriidi ng'ooruutka nyaawa, ak ghwadaajiit ng'ooruutka ng'aritka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.37",
            "verseOrgIds": [
              "GEN.30.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 30:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwayiin ng'aritsu waawiin madeeda simeeda nooga, leehha nooga beega, aba gideaba gwatkwiischi hawanda nea ghapka ghwaleayda, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.38",
            "verseOrgIds": [
              "GEN.30.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 30:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "hean gwatkwiischi ghwarayga aba madeeda ng'aritka, ng'ata gwaji hnooga gea beari, ea gea buscheenyeewi ea gea murearajeega. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.39",
            "verseOrgIds": [
              "GEN.30.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 30:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gooheeldooschi Yakobo dayeega gisilga ak ghwanung' gagal iheenga nooga heeda gea beari nea gea duwas sean mida jeeda nooga Labani; ak ghwajap jaboadaanyi nea gooheeli sea dea nooga Labani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.40",
            "verseOrgIds": [
              "GEN.30.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 30:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean iissa nooga majeekcheewi gageanu Yakobo ak ghwayiin ng'aritka madeeda nooga, ak abeeda gwatkwiischi aba dageascheeda ng'aritka, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.41",
            "verseOrgIds": [
              "GEN.30.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 30:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ea mwayiina ng'aritka madeeda nooga ribeacheewi; ak nooga ribeacheewi gaba Labani nea nooga majeekcheewi gaba Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.42",
            "verseOrgIds": [
              "GEN.30.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 30:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gabaruur siida muuchi, ak gwasin nooga saang'a, ak ghwanyas haweega gadiyeeda ea soomjooga was headiga, ak ghwanyas ngamiyajeega ea digeeniga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.43",
            "verseOrgIds": [
              "GEN.30.43"
            ]
          }
        }
