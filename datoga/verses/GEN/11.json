          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh jeacheenga Shemu. Ghayi nea gaba Shemu gweanyeew bughala, gwaji Arpakshadi iing'ata gweanyeew iyeenya asheala guldeayda haw; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goobiida Shemu ng'eanyiida iing'ata jeata jih Arpakshadi gweanyeew bughalaji muut, ak gwaji orju suuk ea haweega.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
      ]
    },
