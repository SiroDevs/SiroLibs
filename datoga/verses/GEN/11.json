          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghwaat Dera orjeedaanyi was Abramu ea Lutu ea Sarayiheeda was gatmooda orjeedaanyi, ea gatmooda orjeedaanyi was Abramu, ak goodeayi ghabeawa ng'eanyiida Uru mida ng'eanyiida Galdayo ak gaweay ng'eanyiida Ganaani; muchu nea ghwahita ng'eanyiida Harani, goobiida. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gweanyeeka Dera ea bughalaji iyeenya ea muut; ak gameewsa Dera ng'eanyiida Harani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
            "verseOrgIds": [
              "GEN.11.32"
            ]
          }
        }
      ]
