              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayi bwak aba bea Arpakshadi ng'eanyiida gweanyeew diktam ea damanamuut, gwaji Shela; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
