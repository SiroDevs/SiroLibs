            "number": "32",
            "style": "v",
            "sid": "GEN 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eara ghamneawa fuga Israeli mayghwaak biyeeyda jeeda riirda, aba gideaba ghwasat gibeesta Yakobo nooschi sea mananda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
