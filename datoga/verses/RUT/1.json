{
  "id": "RUT.1",
  "number": "1",
  "bookId": "RUT",
  "reference": "Ruti 1",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "RUT 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elimeleki ea fugeaba gheanyi gabalaksa Moabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "RUT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea aba damanda ambaliischeewa fuga laja girgweaguutka abeeda gwanda jeeda ng'eanyiida geejeeda, ak siyagi bea Betlehemeeda Yuda gawa ghamway ng'eanyiida Moabu, niny ea gatmoadaanyi ea orjoagaaschi asiyeenya. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.1",
            "verseOrgIds": [
              "RUT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gheawungeaba siidida geeguura Elimeleki nea gheawunga gatmoadaanyi geeguura Naomi, ak gheawunga orjoagaaschi asiyeenya geeguura Maloni ea Gilioni; saawa gaba eemeeda Furati bea Betlehemeeda Yuda. Gaweay jeeda ng'eanyiida Moabu ak goobiida hoowa. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.2",
            "verseOrgIds": [
              "RUT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghami Elimelekiheeda was siyeeda Naomi, hean geepuussa orjoagaaschi asiyeenya. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.3",
            "verseOrgIds": [
              "RUT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gageena haweega eemeeda Moabu; gheawungeaba agi geeguura Orba ak gheawungeaba niirja geeguura Ruti. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.4",
            "verseOrgIds": [
              "RUT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goobiida hoowa gweanyeew damanamughuush; ak gameewa Maloni ea Gilioni, hean gatmoodida gameewa orjoagaaschi asiyeenya ea siyeadaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.5",
            "verseOrgIds": [
              "RUT.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naomi ea Ruti gabiikta Betlehemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.5",
            "verseOrgIds": [
              "RUT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghang'eat gaweewa ng'eanyiida Moabu niny ea gadeemga orjoagaaschi, aba gideaba ghwayiiy gideaba NG'UTAMIIDA nibareasa fugaaschi aba Moabu ak ghoadaw hamita. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.6",
            "verseOrgIds": [
              "RUT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghang'eat gwariteawa heeda eawoojisu abiita, niny ea gadeemga orjoagaaschi asiyeenya, ak ghwaat naweeda gabiikta ng'eanyiida Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.7",
            "verseOrgIds": [
              "RUT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Naomi gadeemga orjoagaaschi asiyeenya, “Aweayeena, daba siisi biikta heeda ghaamwat. Gagasa gagooneegwa alooheeda NG'UTAMIIDA, gawuurji gidoosimi fiisu nimeewean ea aniini. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.8",
            "verseOrgIds": [
              "RUT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gagasa gagooneegwa NG'UTAMIIDA gheamamda miy jea anyasa gealga, ak gaba siisi nyas gheeda siyeadaanyi!” Hean ghwadeapta, ak ghwajaat ghuusiga nyaawa ak gooyeawda. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.9",
            "verseOrgIds": [
              "RUT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama ng'ata gwayeesha saawa niny, “Manda, gajeebiikta sea ang'iing'i heeda fugaagu.” ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.10",
            "verseOrgIds": [
              "RUT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwayeesha Naomi, “Abiikta haweegeasu googasayi eeteayeena aba naaha? Iyoong'ulayi geandeawi aba jih diibiga orjooga jea ghoah siyeenndigeagwa? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.11",
            "verseOrgIds": [
              "RUT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiikta haweegeasu, ayaada naweedeang'wa, aba gideaba naawaasiichi mudu gwanda siichea ghagheanan. Aba inyas geayeenyi geandeawi masaweega, ghana danyas siyeeda eaweani ak geajiili baleanda, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.12",
            "verseOrgIds": [
              "RUT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "gajeamuusa eamuukghuna ea gwaheetu? Gajeamuusa afura geat ea meegheaneegwa? Manda, haweegeasu, aba gideaba ahang'waay aba heedeanyu aba gideaba ninung'wanaan heeda NG'UTAMIIDA.” ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.13",
            "verseOrgIds": [
              "RUT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean goorareang'u shooka ak gooyeawda gicha; hean ghwadeapta Orba ghamasiyeadaanyi, nea ghwaat Ruti geeshtaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.14",
            "verseOrgIds": [
              "RUT.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.14",
            "verseOrgIds": [
              "RUT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwayeesha, “Ng'ula, gatmooda orjeeda ghamasiyeadaang'u nibiikta heeda fugaaschi ea heeda aseecheekaaschi; biikta aada geeshta gatmooda orjeeda ghamasiyeadaang'u.” ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.15",
            "verseOrgIds": [
              "RUT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Ruti, “adiidu gimuschean danung'waneey heeda, dabiikta ea meeteayeeni; aba gideaba heeda uwi eara aniini gaydawa, nea eara heeda jea abiidana gaydeabiida; fugaagu gayghoah geasu, ak eara ASEATAANG'U gayghoah ASEETEANYU; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.16",
            "verseOrgIds": [
              "RUT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "heechea meewsiina gaydameewsa, ak abeeda gajeebung'sean hiji. Gagasa gwasinnean NG'UTAMIIDA ng'asheanji ak ghwaraanya muuchi, iyaheelanean miyeeda sea ang'iing'i.” ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.17",
            "verseOrgIds": [
              "RUT.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean daah Naomi gideaba gamanyiisa giideayeedaanyi, hean ghwanung'waada giibalooldaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.18",
            "verseOrgIds": [
              "RUT.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.18",
            "verseOrgIds": [
              "RUT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gaweay iyeenyeeda nyaawa ea ghwahita Betlehemu. Ng'ata nea nihita Betlehemu, hean ghahamng'eanyi fuga sean mida jeeda mujiini damanda nyas iita nyaawa; ak hean gwayi gadeemga, “Nih mii Naomihi?” ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.19",
            "verseOrgIds": [
              "RUT.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha saawa, “Adooguureewean Naomi, aguureeweani Mara, aba gideaba ASEETA hoauur nisimanean ng'asheega ng'weani. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.20",
            "verseOrgIds": [
              "RUT.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghaabeawi hiji nea geawooschi baruur, ak goodeelneani NG'UTAMIIDA nea meandeawani gil. Ghwasaan inyas googuureewean Naomi nea NG'UTAMIIDA ea niyamsean geaw nea ASEETA hoauur ea nisawanan?”",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.21",
            "verseOrgIds": [
              "RUT.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.21",
            "verseOrgIds": [
              "RUT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "RUT 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gabiikta Naomi sea Ruti gatmooda orjeedaanyi was gatmooda eemeeda fuga Moabu, abeeda biikna ng'eanyiida Moabu. Ak ghwahita Betlehemu damanda giing'eeta lajita ngaano.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.22",
            "verseOrgIds": [
              "RUT.1.22"
            ]
          }
        }
      ]
    }
  ],
