          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.13",
            "verseOrgIds": [
              "HEB.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwasunu eara diibiga gaguuyi saseeda ea foojeanda, gwasunu eara niny gwandeawa saseeda uurji nih, ak aba naweeda miyeeda abeeda ghwadatas diita mideawa uurda miyeedean, nea meang'nyeandeenda, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.14",
            "verseOrgIds": [
              "HEB.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeeda gwalealu fugiga sean mida jeeda gheawalmeeda miyeedean goobiida jeeda eaweega geawi bea soomjeandumeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.15",
            "verseOrgIds": [
              "HEB.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea daachi gideaba mwaweada malaykajeega niny ghaweat jeata Abrahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.16",
            "verseOrgIds": [
              "HEB.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi gajeenung' gawuurji sea fuga duupchi aba gheatkweaka sean, ak abeeda ghoah siida bayiida buuneeda ea dea doabiiwaat was ashoohoocheanda haw bea gadiyeeda ASEETA, ak gaygoohuun riing'eeda buuneeda. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.17",
            "verseOrgIds": [
              "HEB.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba niny ghayi gwasawana nea geesimsim, niny ghoamu ghaweat fugiga sisimsimiin.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.18",
            "verseOrgIds": [
              "HEB.2.18"
            ]
          }
        }
      ]
