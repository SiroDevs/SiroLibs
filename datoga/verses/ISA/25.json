        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sarmeeda giigheambiita",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ea NG'UTAMIIDA, ang'iing'i guwoosi ASEETEANYU;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.1",
            "verseOrgIds": [
              "ISA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "ASEETA goodiing'diing'da ghweelmeeda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.5",
            "verseOrgIds": [
              "ISA.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak aba uhuudeaba giijeeni NG'UTAMIIDA bea lugweega gaygwasissa buuneesean ghweelmeeda, haleanjeeda riisheadi, ea ghweelmeeda difaayeeda miy, ea banyeega miyaas, ea nagheeda, ea difaayeeda miyaas. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea aba uhuudeaba giijeeni gaygageanda NG'UTAMIIDA shamooghooda, gurmeahiida dukuta buuneesean, ea sawanadeeda dukuta eemoojiga sean. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.7",
            "verseOrgIds": [
              "ISA.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygageanda miyeeda damanda manda muudeanooda, NG'UTAMIIDA was ASEETA gaygoobuus dabeaka mida gheanyanga sean, nea gageanda baspaseega fugaaschi aba badayda ng'eanyiisean, aba gideaba nih gwarugu NG'UTAMIIDA.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda eaweecheanji gajeeyi, “Nih ASEETEANYA gil ghayi siimuughu; nea gwandeawa uurda jea ghaweadaneasa. Nih NG'UTAMIIDA; ghayi siimuughu gil, eehoosana nea geeng'weelayi aba gideaba nilealneasa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "ASEETA gayghwalas uhuuda fuga Moabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba geatinda NG'UTAMIIDA gaygoobiida uhuudeaba giijeeni, nea fuga Moabu gajeeleapsa ng'eanyi aba hoowa midean, gawuurji gidasiilaapta nyeega gajeami aba jeeda shoomanda sururuuda. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.10",
            "verseOrgIds": [
              "ISA.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygagatkat geatingaaschi gawuurji siida bwar lughunya aba jeeda beega, ak NG'UTAMIIDA gayghwahiing'u ghwarjeadaanyi aba fughareeda, ea searoojiga munyas bea geatingaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.11",
            "verseOrgIds": [
              "ISA.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygwanyarja mujiinajeega nyaawa bea Moabu sideasa ghamarjeeka geawi, ak ghwanung' gaweay ng'eanyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.12",
            "verseOrgIds": [
              "ISA.25.12"
            ]
          }
        }
      ]
    }
  ],
