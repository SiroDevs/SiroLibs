              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 66:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayi NG'UTAMIIDA, “Gwanda fuga amiitu geat nea goohuushi aba gideaba gaygaweay jeeda boostaani heeda sibata aseecheeka, hean ghoaream nea gwanda bugusta nyaawa ashoohoocheanda. Fiisu inyeesa ghwaak banyeega ukurmeeda, ea murjeanga ea hamichoojiga suuk meeyeaka. Aba huumwa fiisu gaygoosha sean.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.17",
            "verseOrgIds": [
              "ISA.66.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 66:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.17",
            "verseOrgIds": [
              "ISA.66.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 66:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ak aniini ghaanali sinaweega nyaawa ea gida ateemsheata, gayghwahidu damanda jea dabwadageat eemoojiga sean iita sean ak gayghapka ak gayghwadaah giigheambiiteanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.18",
            "verseOrgIds": [
              "ISA.66.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 66:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaydayiin gwadeagooda bugusta nyaawa, ak giika ghuhiin gaydeajeakta heeda eemoojiga, mida Darshishi ea Buli, ea Ludi, mida fuga nal ng'ucheeda ghuweang'da, ak gaygaweay eara Dubali ea Yafani ng'eanyiida sheagi mida ghuuta basooda, fuga mii ghwayiiy ng'asheegeasu, nea mwadaaha giigheambiiteanyu ak gaygwarukwiida giigheambiiteanyu aba jeeda eemoojiga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.19",
            "verseOrgIds": [
              "ISA.66.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 66:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea gaygweana fugeagwa sean ooduupcheewi eemoojiga sean, gawuurji haleanjeeda sisapa geadi bea ghadooweeda aba heeda NG'UTAMIIDA, aba badayda digeeniga ea mutukwajeega ea badayda ghabearanga ea badayda digeeniga, ea badahuuka diyeanga asasi, bwak ea ghwahita giijeedeanyu ghaydit Yerusalemu gwarugu NG'UTAMIIDA. Gawuurji gida eatiideayda fuga Israeli haleanjeeda nyaawa sisapa geadi bea ghadooweeda gheeda NG'UTAMIIDA aba dabicheanda miy. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.20",
            "verseOrgIds": [
              "ISA.66.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 66:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaydaloat mwaatkwa aba jeenyaawa ghoah ashoohoodiga, nea mwaatkwa ghoah fuga Lawi gwarugu NG'UTAMIIDA.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.21",
            "verseOrgIds": [
              "ISA.66.21"
            ]
          }
        }
      ]
    },
    {
