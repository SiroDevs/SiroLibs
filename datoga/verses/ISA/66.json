            "verseOrgIds": [
              "ISA.66.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 66:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ak gaygwarita jarooda ak ghwadaah muscheeka fuga heawanaan. Aba gideaba ghuughuutka nyaawa maygameewa, nea eara beasta nyaawa ea maygamis, ak saawa gayghoah gidamuy aba madeeda buuneesean.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.24",
            "verseOrgIds": [
              "ISA.66.24"
            ]
          }
        }
      ]
