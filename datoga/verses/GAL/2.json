{
  "id": "GAL.2",
  "number": "2",
  "bookId": "GAL",
  "reference": "Galatiya 2",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "GAL 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bawlo ea Giijasoodiga suurja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ng'ata gweanyeew damanang'wan geabiikti dascheeng'da gicha dawa Yerusalemu nea geadeayeewi Barnaba, ak eara Dito geadeayeewi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.1",
            "verseOrgIds": [
              "GAL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghaascheang'di aba giidaheachta; ak ghayiinyi madeenyaawa (ak ghayiinyi aba makcheameeda madeedeaba fugiga siiwal gheanyangean) giijasta miy earukwiidi aba jeeda eemoojiga, amadu ea mwaafwaji ghana dafwach mwadaagha. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.2",
            "verseOrgIds": [
              "GAL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eara Ditoyda eadeayeewi earapeadi siida eemeeda Yunani gil, ea miyeediing'sa eadita ghasmeahooda. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.3",
            "verseOrgIds": [
              "GAL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu aba badayda orjoogiyya bea ng'uyyeega siyeana makcheameeda, ahuudaan ak ghamwaal giibaldeanya bea geat aba jeeda Gristo Yesu, ak gagasa ghwaadeasa jeeda soomjeandumeeda– ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.4",
            "verseOrgIds": [
              "GAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "duuku aseasa ea meamwasi iita nyaawa eara gilimwanang', aba gideaba geegasayi goobiida heedeang'wa huumeanda giijasta miy. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.5",
            "verseOrgIds": [
              "GAL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea ng'asheega leabu heeda fuga siiwal gheanyangean nea geanung' ghoah giliin (aba heedeanyu mwayamwa gil; aba gideaba ASEETA mashiita buuneeda) fugiga eayeenyi, fuga siiwal gheanyangean manda gichea gooheanean aniini; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.6",
            "verseOrgIds": [
              "GAL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "hean iidu gwajeeng'u saawa gideaba sigoonan darukwiida giijasta miy aba heeda fuga meayaada ghasmeahooda, gawuurji Betaro gwarukwiida giijasta miy aba heeda fuga siyaat ghasmeahooda ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.7",
            "verseOrgIds": [
              "GAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(aba gideaba siidida gadiiyi sea Betaro aba gadiyeeda ghasmeahoodean gagadiiy eara niny aba heedeanyu aba badayda Eemoojiga), ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.8",
            "verseOrgIds": [
              "GAL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "iidu nea ghwanyas dagheerjeanduumeeda ghayi sigoonan, Yakobo ea Gefa ea Yohana, siiwal gheanyangean, gagoonan sea Barnaba geatinda dugwa bea weecheeda, bea gideaba gajeeweaya heeda fuga Eemoojiga nea gaweay saawa heeda fuga ghasmeahooda; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.9",
            "verseOrgIds": [
              "GAL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak goopkaaneasa gideaba eapkaada fuga barbari, was gidida easawani aba gasooda sinoodean.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bawlo goowoowsa Betaro aba Antiyokiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghwahidu Gefa ng'eanyiida Antiyokiya, geawoowsi niny aba gideaba niny ghamiinaada nea niidiiy. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.11",
            "verseOrgIds": [
              "GAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damandida mii ghapkaana fiisu ng'ay ajeagu Yakobo, abeeda goombuuchi sea fuga Eemoojiga; ama iidu nea ghapka hean ghwanung'waada giimbuucheeda ak gabiikta bwadaw ak gooheeli geaw aba gideaba ghoawal fuga siyaat ghasmeahooda. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.12",
            "verseOrgIds": [
              "GAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eara fuga mwaatkwa bea Yahudi ghwayam geat sea niny, eara Barnaba iidu ghwaat geeshta nyaawa aba giimiinoodeaba geat. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.13",
            "verseOrgIds": [
              "GAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghaadaayi gideaba fugiga madoobiiwsiina giijasta miy bea huumwa, geayeeshi Gefa aba madeeda buuneesean, “Earapeadi iwoosi siida Yahudi, ak giibiideati siida Eemoojiga nea muwuurjeewani siida Yahudi, gaydiing'siindaan siida Eemoojiga gideaba gaygoobiideata siida Yahudi?”",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fuga Yahudi ea fuga Eemoojiga gajeelealu aba masaweega",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aseasa, bean eewoosa fuga Yahudi aba jeata ak ea meewasi fuga Eemoojiga bea riing'eega, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.15",
            "verseOrgIds": [
              "GAL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea geanali gideaba siida majeataw doobiiwnata aba sinooda deaweeda, geaghus aba masaweega Yesu Gristo, aseasa ghayi geamwaschi Gristo Yesu ak abeeda geegooneasa doobiiwnata aba masaweega Gristo, nea mii aba sinooda deaweeda, aba gideaba aba sinooda deaweeda manda siida jea eataw doobiiwnata. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.16",
            "verseOrgIds": [
              "GAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak aseasa iisigakiisi geat doobiiwnata aba madeeda Gristo, geadaah gideaba geebea riing'a, heapi Gristo niiw siida gadiyeeda bea riing'eeda? Manda! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.17",
            "verseOrgIds": [
              "GAL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba iyaadeaschi gicha giika ghayi eanyarjiin, ghaahiimu gideaba aniineesean geandeawi giidiinyeanda. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.18",
            "verseOrgIds": [
              "GAL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba aniini aba naweeda deaweeda geameewsi deaweeda, ak abeeda geandeawi ASEETA. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.19",
            "verseOrgIds": [
              "GAL.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geengooran sea Gristo, ak geawooschi majeek ak ea mii aniini gil, Gristo eamajeek aba jeedeanyu, ak majeeknata eandeawi ghamneawa aba saseeda, geandeawi aba masaweega Orjeeda ASEETA, dea bwariinyan ak gabeagu eaweagaaschi aba badaydeanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.20",
            "verseOrgIds": [
              "GAL.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meagasi daheawa dagheerjeanduumeeda ASEETA; ak doobiiwnata iisinyasa naweeda deaweeda, asi Gristo ghami mwadaagha.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.21",
            "verseOrgIds": [
              "GAL.2.21"
            ]
          }
        }
      ]
    }
  ],
