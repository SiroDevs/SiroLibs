{
  "id": "GAL.1",
  "number": "1",
  "bookId": "GAL",
  "reference": "Galatiya 1",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "GAL 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawlo giijasoocheanda, nea maleapna heeda buuneeda ghana gwasku naweeda siida, gwasku heeda Yesu Gristo ea heeda ASEETA was Ghweanda, ak gooduuna niny jeeda miyeeda– ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.1",
            "verseOrgIds": [
              "GAL.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea orjooga giyeanya sean eandeawi, aba heeda ganiisajeega mida Galatiya: ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.2",
            "verseOrgIds": [
              "GAL.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gagasa anyasa dagheerjeanduumeeda ea hoyyooyda leabu heeda ASEETA was Bwaabwa ea Ng'utamiideanya was Yesu Gristo, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.3",
            "verseOrgIds": [
              "GAL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea gabeagu geaw aba riing'eegaasa ak gwalealnaneasa aba jeeda seaygeani bea ghamneawa munyasiin, gawuurji gidagasiida ASEETA was Ghweanda; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.4",
            "verseOrgIds": [
              "GAL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "niny gwandeawa giigheambiita ea ghoah damanda manda muudeanooda. Amin.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.5",
            "verseOrgIds": [
              "GAL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giijasta miy asagi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.5",
            "verseOrgIds": [
              "GAL.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniini nihamwan ng'eanyi aba gidoobay anung'usiinda heeda dea ghayi guurneegwa aba jeeda dagheerjeanduumeeda Gristo ak gooyamsi geat giijasta miy nuut– ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.6",
            "verseOrgIds": [
              "GAL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mii gideaba gwanda giijasta miy nuut gil, iidu gwanda fuga mwaatkwa adeawiideegwa nea gagasa ghoaschoarda giijasta miy bea Gristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.7",
            "verseOrgIds": [
              "GAL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuku aseasa ghana malaykajeanda humng'eeda, iirukuneegwa giijasta wassean mawoosa dea ghayi sirukuneegwa, gagasa eamwaashta. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.8",
            "verseOrgIds": [
              "GAL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawuurji gidagwachi sibean eerukuna, ak eara ghamneawa geerugu gicha, gideaba siida wassean iirukuneegwa giijasta mawoosa dea ghayi oadeapti, gagasa eamwaashta.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.9",
            "verseOrgIds": [
              "GAL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.9",
            "verseOrgIds": [
              "GAL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neada ghoaghanyi gili eagasayi dashiit buuneeda, ghana ASEETA? Ghana eagasayi deahoosan buuneeda? Asi iidu deahoosani buuneeda, ea maydoaw soomjeanda Gristo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.10",
            "verseOrgIds": [
              "GAL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gidaghayi huuwda Bawlo Giijasoocheanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.10",
            "verseOrgIds": [
              "GAL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orjoogiyya geagasayi gideaba gajanala gideaba giijasta miy ghayi earukwiidi maleapna heeda buuneeda. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.11",
            "verseOrgIds": [
              "GAL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba mwaanyasani hichpa sih, ak ea moanaalaan sih, gwaleabu naweeda giidaheachta Yesu Gristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.12",
            "verseOrgIds": [
              "GAL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agooga noayiinyi iita ghayi bea giibindeanyu aba jeeda diineeda fuga Yahudi gideaba geasawanyi muuchi fuga Ganiiseeda ASEETA nea geagasayi dalas uhuuda; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.13",
            "verseOrgIds": [
              "GAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak geandi mwadi aba ng'asheega diineeda Yahudi ea daadaraam fuga seaygeedeanyu aba jeeda buuneedeanyu, ak geabiisi dawoos ng'waan aba searoojiga ghweanigaasa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.14",
            "verseOrgIds": [
              "GAL.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean iidu nea niloadaan ASEETA nea miyeejiilan, ak gaguurnean aba dagheerjeanduumeadaanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.15",
            "verseOrgIds": [
              "GAL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak geanung' ghoahiimnaan Orjeedaanyi, ak abeeda geerukwiidi aniini iitaanyi aba jeeda Eemoojiga, aniini mwaawunani saseeda ea foojeanda, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.16",
            "verseOrgIds": [
              "GAL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ghana dascheang'da dawa Yerusalemu heeda orjooga asheedeawean ghoah giijasoodiga, aniini geawi ng'eanyiida Arabiya; ak geabiigu Dameski.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.17",
            "verseOrgIds": [
              "GAL.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.17",
            "verseOrgIds": [
              "GAL.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gweanyeew samwagu, geawi Yerusalemu dabareesa Gefa, ak geabiidi gheanyi eawooji damanamuut. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.18",
            "verseOrgIds": [
              "GAL.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea manda giijasoocheanji naadaayi nuut geaghus Yakobo orjeeda gheamata Ng'utamiida. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.19",
            "verseOrgIds": [
              "GAL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nea ng'asheega eang'oorneegwa, aba madeeda ASEETA mii ng'uyyeega gil!) ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.20",
            "verseOrgIds": [
              "GAL.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu geawi meatkwajeega ng'eanyiida Shaamu ea Gilikiya. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.21",
            "verseOrgIds": [
              "GAL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea abeeda ea mii ghwadaahan aba gheanyanga fuga Ganiisajeega Gristo mida Yudeya; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.22",
            "verseOrgIds": [
              "GAL.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GAL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabeachi gideaba ghwayiiy iita gideaba, “Siida ghayi sawaneasa ghamneawa gwarukwiida giijasta miy bea masaweegiga ghayi gasa ghwalas uhuudean.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.23",
            "verseOrgIds": [
              "GAL.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean geekghaambiit ASEETA aba badaydeanyu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.24",
            "verseOrgIds": [
              "GAL.1.24"
            ]
          }
        }
      ]
    }
  ],
