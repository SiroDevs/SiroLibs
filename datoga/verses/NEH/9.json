              "NEH.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba aba badaydeaba suh seaniin geesinyi neajeeda huumwa, ak geang'waarji, nea fugaasa hees, ea fugaasa bea Lawi, ea ashoohoodigaasa ghwayiin neajeeda nyaawa giirooraneeda.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.38",
