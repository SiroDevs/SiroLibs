          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean geadiing'di fuga hees bea Yuda uhuuda ghamarda, ak ghaanung' ghabwat geat gheamughuushcheew iyeenya hees nea gabadiischeesa ASEETA ak gaweay nea ghwaroap geat. Akaleala gawa meatkweeda geatinda dugwa nea gagal dooshta raghwata; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.31",
            "verseOrgIds": [
              "NEH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'ata gaweay nea goodeayi Hoshaya ea fuga hees silach bugusta nibiyeenya bea Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.32",
            "verseOrgIds": [
              "NEH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
