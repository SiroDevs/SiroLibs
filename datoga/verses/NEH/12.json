          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea ashoohoodiga mwaatkwa ea orjooga weay nea googuuleada: nea Sakariya gil orjeeda Yonatan, ea orjeeda Shemaya, ea orjeeda Mataniya, ea orjeeda Mikaya, ea orjeeda Sakuri, ea orjeeda Asafu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.35",
            "verseOrgIds": [
              "NEH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea fugaaschi duupchi, ea Shemaya ea Asareli, ea Milalai, ea Gilalayi, Maayi, ea Netaneli, ea Yuda, ea Hanani, nea abeeda gwandeawa haleanjeeda sarmeeda siguuda bea Dawdi was siida ASEETA; nea goosheedeawa saawa Esra was ng'oorshoocheanda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.36",
            "verseOrgIds": [
              "NEH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean sihita dooshta gheang'deenda, hean geascheang'da, aba madeanyaawa ak geala gidingeayoojiga mujiineeda Dawdi, bea ghamarda naawa gheeh Dawdi ea eahita heeda beega laabwa dooshta heeda ghayeawa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.37",
            "verseOrgIds": [
              "NEH.12.37"
            ]
          }
        }
      ]
    },
    {
