              "2KI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo imfumu yatuma umukalamba wa bashilika pamo na bashilika bakwe amakumi yasano (50). Umukalamba wa bashilika aya fika kuli Eliya, amusanga naikala pa mulu wa lupili no kumweba ati, “We muntu wakwa Lesa, imfumu ilekwita ika!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        }
      ]
