            "number": "12",
            "style": "v",
            "sid": "2KI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya ayasuka ati, “Nga cakuti ndi muntu wakwa Lesa, umulilo naufume ku mulu no koca iwe pamo na bashilika uli nabo amakumi yasano (50).” Elyo umulilo wapona ukufuma ku mulu no koca umukalamba wa bashilika pamo na bashilika ali nabo amakumi yasano (50).",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.12",
            "verseOrgIds": [
              "2KI.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
