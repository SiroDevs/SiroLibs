              "items": [
                {
                  "text": "Mako 1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bayasuka abati, “Aciba muntu umwaume nafwala ne cakufwala icamasako. Afwele no mushipi wa mpapa mu musana wakwe.” Imfumu aiti, “Ni Eliya umwina Tishibe.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
