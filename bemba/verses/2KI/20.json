            "sid": "2KI 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.13"
              },
              "items": [
                {
                  "text": "2 Isham 24:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Imila 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inshita ileisa ilyo ifintu fyonse mu ŋanda yobe iye sano, na fyonse ifyo ifikolwe fyenu fyatutile ukushinta ilelo fili nokusendwa ku Babiloni. Ala takwakashale nangu kamo, efyasosa Yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.17",
            "verseOrgIds": [
              "2KI.20.17"
            ]
          }
        },
