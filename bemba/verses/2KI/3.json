            "verseOrgIds": [
              "2KI.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo ilyo abena Moabu baisa fika pa nkambi ya bena Israeli, abena Israeli babemina no kubalwisha mpaka bafulumuka. Kabili abena Israeli bakumana mpanga yonse no kwipaya abena Moabu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.24",
            "verseOrgIds": [
              "2KI.3.24"
            ]
          }
        }
      ]
    },
    {
