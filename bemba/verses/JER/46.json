          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ili e shiwi Yawe aebele kasesema Yeremia, ilyo Nebukadinesa imfumu ya ku Babiloni aishile kukulwisha icalo ca Egupto.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.13",
            "verseOrgIds": [
              "JER.46.13"
            ]
          }
        }
