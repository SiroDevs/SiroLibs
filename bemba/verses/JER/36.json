            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Yeremia afwayapo icitabo cimbi, apeela kalemba wakwe Baruki, nao Baruki alembamo amashiwi yonsefye ayo Yeremia alemweba ukulemba. Alembamo amashiwi yalya yene yonsefye ayali muli cilya citabo ico Yehoyakimu imfumu ya bena Yuda yaocele. Yeremia alundamo na mashiwi yambi ayengi aya musango umo wine.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
            "verseOrgIds": [
              "JER.36.32"
            ]
          }
        }
