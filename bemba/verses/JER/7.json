          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pantu abena Yuda nabacita icintu icibi. Utulubi twabo uto ine napatisha, bena etuntu babikile mu ŋanda iyitwa peshina lyandi, no kuikowesha nabaikowesha.” Ifi efyasosa Yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.21"
              },
              "items": [
                {
                  "text": "Levi 18:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.10"
