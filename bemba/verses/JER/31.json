              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe aletila ati, “Pali ilya nshita ine nkaba Lesa wa mikowa yonse iya bena Israeli, nabo bakaba abantu abandi.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.1",
            "verseOrgIds": [
              "JER.31.1"
            ]
          }
        }
      ]
    },
