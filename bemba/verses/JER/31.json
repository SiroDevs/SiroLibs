          "type": "text",
          "attrs": {
            "verseId": "JER.31.6",
            "verseOrgIds": [
              "JER.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
