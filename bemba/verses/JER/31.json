                "loc": "HEB.8.8+HEB.8.9+HEB.8.10+HEB.8.11+HEB.8.12"
              },
              "items": [
                {
                  "text": "Bahi 8:8-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe aletila ati, “Moneni, inshiku shikesa ilyo ine nkapangana icipangano icipya na ba ŋanda yakwa Israeli pamo na ba ŋanda yakwa Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.31",
            "verseOrgIds": [
              "JER.31.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cena tacakabe nge cipangano ico napangene na bashibo, pa bushiku nabekete pa maboko pakubafumya mu calo ca Egupto. Bena balisuulile icipangano candi, nangu ine nali ngo mulume kuli bena.” Ifi efyasosa Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.32",
            "verseOrgIds": [
              "JER.31.32"
            ]
          }
        }
      ]
    },
    {
