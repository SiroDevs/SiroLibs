          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ubushiku bumo bukafika ilyo bamalonda bakalapunda pa mpili sha mu calo ca Efulemu abati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.6",
            "verseOrgIds": [
              "JER.31.6"
            ]
          }
        }
