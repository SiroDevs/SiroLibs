                {
                  "text": "2 Imila 36:9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ilyo Konia",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.24",
            "verseOrgIds": [
              "JER.22.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22:24",
              "type": "text"
            },
            {
              "text": "Konia:",
              "type": "text"
            },
            {
              "text": "Ishina limbi Yehoiyakini, moneni kabili mu 22:28.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwana Yehoyakimu aleteeka icalo ca Yuda, Yawe amwebele ati, “Napalifye ine ne Mumi, iwe nangu wingabafye nge mbalaminwe yabufumu ku kulyo kwandi, ala kuti nakusotolako, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.24",
            "verseOrgIds": [
              "JER.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkakuposa na mu minwe ya bantu abalefwaya ukukwipaya, balya bene bantu iwe utiinisha. Nkakuposa kuli Nebukadinesa imfumu ya ku Babiloni na ku bashilika bakwe abena Kaludea. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.25",
            "verseOrgIds": [
              "JER.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe pamo na noko ine ndemufwintila ku calo cimbi ico mushafyalilwamo, no kufwila imwe bonse babili eko mukafwila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.26",
            "verseOrgIds": [
              "JER.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imwe tamwakatale amubwelela muli cino calo ico mufuluka ukubwelelako.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.27",
            "verseOrgIds": [
              "JER.22.27"
            ]
          }
        }
      ]
    },
