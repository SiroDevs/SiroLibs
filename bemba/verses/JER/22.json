            "caller": "#"
          },
          "items": [
            {
              "text": "\n        2 Isham 23:36—24:6",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7"
              },
              "items": [
                {
                  "text": "2 Imila 36:5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kanshi ifi efyo Yawe asosa palwa mfumu Yehoyakimu mwana Yosia imfumu ya calo ca Yuda ukuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
        }
