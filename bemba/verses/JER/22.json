                "loc": "2KI.23.31+2KI.23.32+2KI.23.33+2KI.23.34"
              },
              "items": [
                {
                  "text": "2 Isham 23:31-34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.1+2CH.36.2+2CH.36.3+2CH.36.4"
              },
              "items": [
                {
                  "text": "2 Imila 36:1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pantu ifi efyasosa Yawe palwakwa Shalumu mwana Yosia, imfumu ya bena Yuda, uwali imfumu pa cifulo cakwa wishi Yosia uwafumine kuli ino ncende. “Ena takatale abwelela nakalya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulya kwine ku calo bamusendele bunkole, no kufwila eko akaya fwila. Cino calo takatale nakabili acishimpamo ilinso.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        }
      ]
    },
    {
