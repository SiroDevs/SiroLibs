            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bushe kanshi ulya muntu Konia ali nge nongo iyitobeke, iyo baposele, iyo umuntu nelyo umo ashingafwaya, mwa? Nga nomba ena pamo na bamwane cinshi ico babafwintile mu calo ico bashaishiba?",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        }
      ]
