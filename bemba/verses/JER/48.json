                {
                  "text": "Sefa 2:8-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Palwa calo ca Moabu, Yawe umwine wa fita, Lesa wakwa Israeli, alilandilepo ati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.1",
            "verseOrgIds": [
              "JER.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.10",
            "verseOrgIds": [
              "JER.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe aletila ati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.11",
            "verseOrgIds": [
              "JER.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.11",
            "verseOrgIds": [
              "JER.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kanshi nomba kwalaisa inshiku shimo, ilyo ine ne Yawe nalatuma abakwisa itila icalo ca Moabu nga filya betila umwangashi. Tamwaise shala kantu mu mitondo yaciko iya mwangashi, ne mitondo ine balaisa itobaula. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.12",
            "verseOrgIds": [
              "JER.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abena Moabu baleikatwa ne nsoni pa mulandu wakwa Kemoshi umulungu wabo, nga filya fine aba mu ŋanda yakwa Israeli baiketwe ne nsoni ku Betele pa mulandu wa mulungu wabo, uo bashintilemo imitima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.13",
            "verseOrgIds": [
              "JER.48.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.20",
            "verseOrgIds": [
              "JER.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inshita naifika iyakupingwilapo imisumba iyaba mu calo icabatama neyi misumba ni Holoni, na Yasa, na Mefati, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.21",
            "verseOrgIds": [
              "JER.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Diboni, na Nebo, na Beti Dibulataimu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.22",
            "verseOrgIds": [
              "JER.48.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "no musumba wa Kiriataimu, ne misumba ya Beti Gamuli, na Beti Meoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.23",
            "verseOrgIds": [
              "JER.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Kerioti, no musumba wa Bosira. Inshita naifika iyakupingwilapo ne misumba yonse ya mu calo ca Moabu, iyakutali ne yamupepi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.24",
            "verseOrgIds": [
              "JER.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubulamba bwa bena Moabu nababupwisha, amaka yabo nayapela. Ifi efyasosa Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.25",
            "verseOrgIds": [
              "JER.48.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yawe apesha icalo ca Moabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.25",
            "verseOrgIds": [
              "JER.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lengeni abena Moabu bakolwe, pantu balintalamina ine ne Yawe. Abena Moabu bakulaalanganafye mu malushi yabo, na bantu bambi bakulabawela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.26",
            "verseOrgIds": [
              "JER.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bushe temwe mwalewela abena Israeli? Bushe mwasangilishe bali pamo na bapupu, icakuti lyonse ilyo mwalebalandapo, mwalekuntafye imitwe pakubasuula?",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.27",
            "verseOrgIds": [
              "JER.48.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.33",
            "verseOrgIds": [
              "JER.48.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abena Heshiboni na bena Eleale baleloosha, ne misowa yabo ileumfwika na ku musumba wa Yahasi, na bena Soa nabo baleyumfwa. Ileumfwika na ku mushi wa Holonaimu, ukuya fikafye na ku misokolo ya Egilati Shelishiya, pantu no mumana wa Nimurimu nao naukama. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.34",
            "verseOrgIds": [
              "JER.48.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ne Yawe Lesa ndepesha abena Moabu, pakuti cipwe icakutuula amalambo yakoca mu ncende ishasansama ne cakufutumwina milungu yabo ububani. Ee, nine ne Yawe ndelanda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.35",
            "verseOrgIds": [
              "JER.48.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.35",
            "verseOrgIds": [
              "JER.48.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 48:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eico ine ndelililakofye Moabu, na bantu bene abena Kiri Haleseti, ndi kwati muntu uulelisha ulwimbo lwa malilo muli mutolilo, pantu ifintu fyonse ifyo bali nafyo, nafiloba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.36",
            "verseOrgIds": [
              "JER.48.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 48:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaume bonse nababeya inkuso ne myefu pakulanga ubulanda. Nabaitetaula bonse ku minwe, kabili bonse nabafwala insalu shabulanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.37",
            "verseOrgIds": [
              "JER.48.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 48:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mitenge ya mayanda yonse aya mu Moabu paleumfwikafye imisowa, na mu mansa shonse misowafye yeka ilimo, pantu ine ningonaula Moabu, kwati mutondo ntobawile uo umuntu nangu umo ashilefwaya. Nine ne Yawe ndelanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.38",
            "verseOrgIds": [
              "JER.48.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 48:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yangu ifyo icalo ca Moabu caonaika ee! We misowa nobe! Ee, icalo ca Moabu casebana. Nacisanguka icasebana, na bantu ba mishobo yonse iyacishinguluka baleciwelafye.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.39",
            "verseOrgIds": [
              "JER.48.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 48:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.39",
            "verseOrgIds": [
              "JER.48.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 48:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pantu ifi efyasosa Yawe ati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.40",
            "verseOrgIds": [
              "JER.48.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JER 48:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apa epapwila ubupingushi bwakwa Yawe pali Moabu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.47",
            "verseOrgIds": [
              "JER.48.47"
            ]
          }
        }
      ]
    }
  ],
