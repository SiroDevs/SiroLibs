          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo na ine nasosa nati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.15",
            "verseOrgIds": [
              "JER.15.15"
            ]
          }
        }
