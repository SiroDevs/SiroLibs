                "loc": "1SA.7.5+1SA.7.6+1SA.7.7+1SA.7.8+1SA.7.9"
              },
              "items": [
                {
                  "text": "1 Sam 7:5-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ishiwi lyakwa Yawe lyaishile kuli ine ne Yeremia aliti, “Nangufye Mose na Samwele bengeminina pa cinso candi, no kubapapatilako kuli ine, awe ine teti nangulukileko aba bantu iyoo. Bena ubatamfyefye, ine nshilefwaya na kubamona pano ndi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.10"
              },
              "items": [
                {
                  "text": "Ubuso 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nga bakwipusha uko balefwaya ukuya, bebefye ifyo ine nsosele nati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
