        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifi efyasosa Yawe umwine wa fita aletila ati, “Ubo bushiku ilyo bukafika, ine nkakontaula amakoli ayaba mu mikoshi yabo, kabili nkaputaula iminyololo, awe ninshi capwa tabakateekwe busha nakabili ku benafyalo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo bena bakalabombela ine ne Yawe, ne Lesa wabo, no kulabombela Davidi uo ine nkasonta ukuba imfumu yabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    },
