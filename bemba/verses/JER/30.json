              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishiwi lyakwa Yawe lyaishile kuli ine ne Yeremia aliti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.1",
            "verseOrgIds": [
              "JER.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ifi efyasosa Yawe Lesa wakwa Israeli ati, ‘Fyonsefye ifyo ine nkweba, ufilembe mu citabo cimo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "pantu inshita yalafika,’ efyasosa Yawe, ‘ilyo ine nalaleka abantu bandi abena Israeli na bena Yuda babwele nakabili. Nalababwesesha muli cino calo ico napeele ifikolwe fyabo, calaba nakabili icabofye.’ Efyasosa Yawe.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        }
      ]
    },
    {
