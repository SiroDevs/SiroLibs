          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alanda ku bena Israeli na bena Yuda amashiwi ayakuti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.4",
            "verseOrgIds": [
              "JER.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ifi efyasosa Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
            "verseOrgIds": [
              "JER.30.5"
            ]
          }
        }
      ]
    },
