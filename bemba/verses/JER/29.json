                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Imila 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kasesema Yeremia epakulemba kalata ukufuma mu Yerusalemu iyakuya ku bakalamba abashelepo pali bankole, na kuli bashimapepo, na kuli bakasesema, na ku bantu bonse abo Nebukadinesa aikete mu Yerusalemu no kubasenda muli bunkole ku Babiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.1",
            "verseOrgIds": [
              "JER.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alembele uyu kalata panuma ninshi imfumu Yekonia yalifuma mu Yerusalemu, pamo na nyina wa mfumu, kumo kwine na bamutungwi, ne ntungulushi sha mu calo ca Yuda ne sha mu Yerusalemu, na bantu abacenjela mu fyakubasabasa ne fyakufulafula. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.2",
            "verseOrgIds": [
              "JER.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasendele iyi kalata bali ni Elasa mwana Shafani na Gamalia mwana Hilikiya, abo Sedekia imfumu ya ku Yuda atumine kuli Nebukadinesa uwali imfumu ya ku Babiloni. Ne fyali muli iyi kalata fyali nifi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.3",
            "verseOrgIds": [
              "JER.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eba Shemaia umwina Nelamu amashiwi aya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.24",
            "verseOrgIds": [
              "JER.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifi efyasosa Yawe umwine wa fita Lesa wakwa Israeli aleti, “Iwe Shemaia waitendekefye ukutuma kalata ku bena Yerusalemu bonse, na kuli shimapepo Sefania mwana Maaseya, na kuli bashimapepo bambi bonse, umo walembele auti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.25",
            "verseOrgIds": [
              "JER.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Yawe niwe Sefania abika pali bushimapepo, Yehoiyada ena alimusha, nomba niwe mubomfi mukalamba mu ŋanda yakwa Yawe. Kanshi iwe waba no mulimo uwakumona ukuti ishilu lyonse ilileicita nga kasesema, iwe ulelikaka iminyololo, no kulibika mwikoli lya cela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.26",
            "verseOrgIds": [
              "JER.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga nomba cinshi ico iwe usha cilimina uyo Yeremia umwina Anatoti, uusesemena abantu kwati ni kasesema? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.27",
            "verseOrgIds": [
              "JER.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremia alilembela ifwe fwe bali ku Babiloni ukuti tukakokolako nganshi muli bunkole, eico tuli nokulakuula amayanda ayakwikalamo, no kulalima amabala, no kulalya ifyo tulelimako.’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimapepo Sefania nao epakubelengelako kasesema Yeremia uyu wine kalata. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.29",
            "verseOrgIds": [
              "JER.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ishiwi lyakwa Yawe lyaishile kuli Yeremia ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.30",
            "verseOrgIds": [
              "JER.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukutuma amashiwi kuli bankole bonse abali ku Babiloni, no kubebako amashiwi ayo Yawe umwine alandile pali Shemaia umwina Nelamu ayakutila, “Pantu Shemaia alemweba imwe amashiwi kwati ni kasesema nelyo tene namutuma nakalya, kabili ena nalenga nokuti imwe musuminefye ifyabufi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.31",
            "verseOrgIds": [
              "JER.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "eico ine ne Lesa ndetila, ala Shemaia nkamukanda, na bamwane bene nkabakandila kumo. Ena takashalepo no mwana nelyo umo uukasangwako kukushuukila ifisuma ifyo ine nkapeela abantu bandi, pantu ewasongelekanya abantu pakuti bansangukile.” Ifi efyasosa Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.32",
            "verseOrgIds": [
              "JER.29.32"
            ]
          }
        }
      ]
    }
