        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.26",
            "verseOrgIds": [
              "JER.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe na cine bacilolo bonse baisa kuli Yeremia. Balamwipusha, nao abasukilafye umo imfumu yamwebele ukwasuka. Awe bafilwa ne cakucitapo, pantu tapali nelyo umo uwaumfwileko ifyo imfumu Sedekia yalelanda na Yeremia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.27",
            "verseOrgIds": [
              "JER.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.21"
              },
              "items": [
                {
                  "text": "Esek 33:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao Yeremia epakulasungwa mulya mwine mu lubansa lwa bakalinda ukushintafye no bushiku bapokele umusumba wa Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
            "verseOrgIds": [
              "JER.38.28"
            ]
          }
        }
      ]
