                "loc": "2KI.25.1+2KI.25.2+2KI.25.3+2KI.25.4+2KI.25.5+2KI.25.6+2KI.25.7+2KI.25.8+2KI.25.9+2KI.25.10+2KI.25.11"
              },
              "items": [
                {
                  "text": "2 Isham 25:1-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "2 Imila 36:17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Mukwai, twipushisheniko kuli Yawe, pantu Nebukadinesa imfumu ya ku Babiloni natubushisha inkondo. Nakalimo Yawe kuti atucitilapo icipeshamano cakwe cimo pamo nga kale, no kulenga Nebukadinesa abwelelemo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
