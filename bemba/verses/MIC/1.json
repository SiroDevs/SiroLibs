              "type": "text"
            }
          ]
        },
        {
          "text": "Ishiwi lyakwa Yawe lyaishile kuli Mika, uwaikele mu mushi wa Moresheti, pa nshita Yotamu ateekele icalo ca Yuda, na pa nshita Ahasi nao akonkelepo ukuciteeka, na pa nshita Hesekia nao aciteekelepo. Yawe alisokolwelele Mika ifi fintu palwa musumba wa Samaria na palwa musumba wa Yerusalemu mu cimonwa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.1",
            "verseOrgIds": [
              "MIC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ukuloosha umusumba wa Yerusalemu na Yuda",
          "type": "text"
        }
      ]
    },
