          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ilyo lyonse muletuula umutuulo wakutotela kuli Yawe, utuuleni mu nshila yakuti ukapokelelwe mukumwimininako. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufwile ukuliwa pa bushiku bwine ubo mwautuula. Tewakushako nangu kamo mpaka ulucelo. Nine Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        }
      ]
    },
