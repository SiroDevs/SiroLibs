            "number": "32",
            "style": "v",
            "sid": "LEV 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tecakwesha ukusebanya ishina lyandi ilyamushilo. Mfwile ukwishibikwa kuli imwe mwe bena Israeli ukuti ine ndi wamushilo. Nine Yawe, ne ulenga ukuti mube abamushilo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
