          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umwaume onse uwasendama na nafyala, umukashi wa mwana wakwe, bonse babili bafwile ukwipaiwa. Pantu icintu bacita, lishiku. Umulopa wabo ukaba pa mitwe yabo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.12",
            "verseOrgIds": [
              "LEV.20.12"
            ]
          }
        }
