          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kabili umwaume nga asendama no mwaume mubiye, ifyo balala no mwanakashi, bonse babili ninshi bacita icamuselu. Eico bonse bafwile ukwipaiwa. Umulopa wabo ukaba pa mitwe yabo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.13",
            "verseOrgIds": [
              "LEV.20.13"
            ]
          }
        }
