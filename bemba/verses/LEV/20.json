          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umwaume onse uwasendama ne citekwa, afwilefye ukwipaiwa. Kabili ici citekwa cifwile naco ukucipaya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.15",
            "verseOrgIds": [
              "LEV.20.15"
            ]
          }
        }
      ]
