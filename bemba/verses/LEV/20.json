                  "text": "Amaf 27:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Umwaume nga aupa umwanakashi kabili aupa na nyinafyala kumo, ninshi ici acita cabubifi. Bonse umwaume elyo na banakashi bene bafwile ukocewa mu mulilo, epakuti ubu bubifi bwikatwalilila pakati kenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.14",
            "verseOrgIds": [
              "LEV.20.14"
            ]
          }
        }
