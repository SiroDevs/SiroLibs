              "LEV.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umwanakashi onse nga apalama ku citekwa conse kukusendama naco, ipayeni umwanakashi pamo pene ne citekwa. Umulopa uli nokuba pa mutwe wa muntu ne citekwa cine.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.16",
            "verseOrgIds": [
              "LEV.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
