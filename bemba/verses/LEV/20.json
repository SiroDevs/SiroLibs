              "type": "tag",
              "attrs": {
                "loc": "LEV.18.7+LEV.18.8+LEV.18.9+LEV.18.10+LEV.18.11+LEV.18.12+LEV.18.13+LEV.18.14+LEV.18.15+LEV.18.16+LEV.18.17+LEV.18.18+LEV.18.19+LEV.18.20+LEV.18.21+LEV.18.22+LEV.18.23"
