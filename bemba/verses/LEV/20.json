              "items": [
                {
                  "text": "Mako 7:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Nga cakuti umuntu alapisha wishi nangufye ni nyina, wena uyo afwile ukwipaiwa. Pa mulandu wakuti nalapisha wishi nangu nyina, umulopa wakwe ukaba pa mutwe wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.9",
            "verseOrgIds": [
              "LEV.20.9"
            ]
