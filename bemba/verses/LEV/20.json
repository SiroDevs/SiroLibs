            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umwaume onse uwasendama na muka wishi, ninshi asebanya wishi. Eico bonse umwaume no mwanakashi wine, bafwile ukwipaiwa. Umulopa wabo ukaba pa mitwe yabo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.11",
            "verseOrgIds": [
              "LEV.20.11"
            ]
          }
        }
