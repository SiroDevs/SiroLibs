              "items": [
                {
                  "text": "Levi 19:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nkafutatila uyo onse uukangalukila no kuya kuli bakabuka nangu ababomba ne mipashi, no kucita nabo bucilende bwakukonka ifyo bacita, kabili ndi nokumutamfya pebumba lya bantu bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.6",
            "verseOrgIds": [
              "LEV.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muleba abasanguluka no kuba abamushilo, pantu nine Yawe Lesa wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.7",
            "verseOrgIds": [
              "LEV.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulebaka amafunde yandi no kuyakonka. Nine Yawe ne umulenga ukuba abamushilo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.8",
            "verseOrgIds": [
              "LEV.20.8"
            ]
          }
        }
      ]
    },
