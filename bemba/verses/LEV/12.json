                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe aeba Mose ati, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.1",
            "verseOrgIds": [
              "LEV.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sosa ku bena Israeli auti, ‘Umwanakashi nga aba pa bukulu no kupapa umwana umwaume, ninshi aba uwakowela pa nshikufye cine lubali, nga filya fine ciba nga aba kumpepo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.2",
            "verseOrgIds": [
              "LEV.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.12"
              },
              "items": [
                {
                  "text": "Icite 17:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.21"
              },
              "items": [
                {
                  "text": "Luka 2:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na pa bushiku bwalenga cine konse konse, umwana ali nokusembululwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.3",
            "verseOrgIds": [
              "LEV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo umwanakashi ali nokupembela pa nshiku amakumi yatatu na shitatu (33), pakuti asangululwe no mulopa wakwe uwamishiwe. Talingile ukwikata ku cintu nelyo cimo icili icamushilo, nangufye kwingila mu cifulo camushilo mpakafye inshiku shakusangululwa shapwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.4",
            "verseOrgIds": [
              "LEV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo nga cakuti apapa umwana umwanakashi, lyena cili nokusendafye imilungu ibili umwanakashi alifye uwakowela, nga filya fine aba nga ali kumpepo. Elyo ali nokupembela pa nshiku amakumi mutanda na mutanda (66), pakuti asangululwe no mulopa wakwe uwamishiwe.’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inshiku shakwe ishakusanguluka nga shapwa isho apapilepo umwana umwaume nangu umwanakashi, alingile ukuleta kuli shimapepo pa mwinshi we Tenti Lyakukumaninamo umwana wa mpaanga uwa mwaka umo nge lambo lya cakoca, ukubikapo na kabondo ka nkunda nangu icipele ngo mutuulo wakwelelwa pa bubifi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.6",
            "verseOrgIds": [
              "LEV.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimapepo ali nokumutuulilako kuli Yawe pakumufutilako, elyo lyena ali nokuba uwasanguluka kukufumishiwa kwa mulopa. Aya e mafunde ya pa mwanakashi onse uwapapa umwana umwaume nangu umwanakashi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.7",
            "verseOrgIds": [
              "LEV.12.7"
            ]
          }
        }
      ]
    },
    {
