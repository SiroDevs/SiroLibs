                  "text": "Imp 18:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Takuli icintu nelyo cimo pafyo umuntu akwata nangu ico apeela kuli Yawe kukucilofya",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:28",
              "type": "text"
            },
            {
              "text": "Ili shiwi mu Cihibulu lipilibula ukulubwila kuli Lesa icintu nangu umuntu ukwabula ukulapulula, ilingi line ni mukonaulwa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " icingashitishiwa nangu ukulubulwa, cibefye nangu muntu wine, nangu inama, nangu impanga ya lupwa. Conse icapeelwa kukonaulwa, cena camushilo nganshi kuli Yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takuli umuntu nelyo umo uyo uwapeelwa kukonaulwa uwingalubulwa, lelo afwile ukwipaiwafye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
