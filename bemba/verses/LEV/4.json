          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.31",
            "verseOrgIds": [
              "LEV.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kabili nga aleta umwana wa mpaanga ukuba umutuulo wakwelelwa pa bubifi, alingile ukuleta iyikota iyabula akalema. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.32",
            "verseOrgIds": [
              "LEV.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali nokutambalika ukuboko kwakwe pa mutwe wa mutuulo wakwelelwa pa bubifi, elyo ali nokuipaila pa ncende iyo bepailapo ilambo lyakoca. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.33",
            "verseOrgIds": [
              "LEV.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo shimapepo ali nokubuulapo umulopa pa mutuulo wakwelelwa pa bubifi ku munwe no kushinga ku nsengo sha ku bulambo bwe lambo lyakoca. Umulopa washalapo ali nokuwitila mwisamba lya bulambo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.34",
            "verseOrgIds": [
              "LEV.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali nokufumyako yonse amafuta, pamo ngefyo amafuta ya mwana wa mpaanga yafumishiwa ku mutuulo wakwampana, elyo shimapepo ali nokufyocela pa bulambo pamo ne mituulo ya kuli Yawe. Iyi e nshila shimapepo ali nokutuulilamo umutuulo wakwelelwa pa bubifi acitile, ninshi uyu muntu akelelwa.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.35",
            "verseOrgIds": [
              "LEV.4.35"
            ]
          }
        }
      ]
