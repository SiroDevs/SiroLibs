            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbushi ine iyi eili nokusenda ububifi bonse mu ncende umushaba bantu, na uyu muntu uwasalwa ukusenda iyi mbushi ali nokuileka ukuya mu matololo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.22",
            "verseOrgIds": [
              "LEV.16.22"
            ]
          }
        }
      ]
    },
