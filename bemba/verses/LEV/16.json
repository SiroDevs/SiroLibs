                  "text": "Esek 44:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Elyo Aroni ali nokuya mwi Tenti Lyakukumaninamo no kufuula ifyakufwala fya bushimapepo, ifyo acifwala pakwingila mu Muputule wamushilo icine cine, no kufisha mulya mwine mwi Tenti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.23",
            "verseOrgIds": [
              "LEV.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni ali nokowa umubili onse na menshi mu ncende yamushilo elyo nokufwala ifyakufwala fyakwe. Nga apwisha ukufwala, ali nokuya panse mukuleka ilambo lyakoca ilyakwefye umwine ne lambo lyakoca ilya bantu bonse, mukuifutilako umwine elyo na bantu bonse. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.24",
            "verseOrgIds": [
              "LEV.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili ali nokoca aya mafuta pa bulambo ngo mutuulo wakwelelwa pa fyabubifi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.25",
            "verseOrgIds": [
              "LEV.16.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.25",
            "verseOrgIds": [
              "LEV.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uyu muntu uwasendele imbushi no kuya ileka ileya kuli Asaseli, ali nokucapa ifyakufwala fyakwe no kowa umubili onse na menshi. Elyo nomba kuti aingila mu nkambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.26",
            "verseOrgIds": [
              "LEV.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.11"
              },
              "items": [
                {
                  "text": "Bahi 13:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cilume wa ŋombe pamo pene ne mbushi ifyalekelwe ngo mutuulo wakwelelwa pa bubifi, no mulopa wafiko watwalwa mu Muputule wamushilo icine cine nga ifyakuifutilako kuli Yawe, fifwile ukufifumisha kunse ya nkambi. Imikupo yafiko, iminofu ne fya mu mala fyonse fili nokocewa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.27",
            "verseOrgIds": [
              "LEV.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu uwaoca ifi fyonse afwile ukucapa ifyakufwala fyakwe no kowa umubili onse na menshi. Elyo nomba panuma kuti aingila mu nkambi.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.28",
            "verseOrgIds": [
              "LEV.16.28"
            ]
          }
        }
      ]
    },
