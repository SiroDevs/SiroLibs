        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.23",
            "verseOrgIds": [
              "PHM.1.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.7"
              },
              "items": [
                {
                  "text": "Kolo 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.12"
              },
              "items": [
                {
                  "text": "4:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Epafula, uo tuli nao mu cifungo pa mulandu wakwa Kristu Yesu, alekuposha. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.23",
            "verseOrgIds": [
              "PHM.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHM 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mako, Alistako, Dema na Luka, ababomfi banandi, nabo bakuposha.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.24",
            "verseOrgIds": [
              "PHM.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
