  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "MRK 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilya bwaca ulucelo, bashimapepo bacindami, pamo na bakalamba, bakafundisha bamafunde na bashicilye",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.1",
            "verseOrgIds": [
              "MRK.15.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:1",
              "type": "text"
            },
            {
              "text": "Bashicilye:",
              "type": "text"
            },
            {
              "text": "Aba e bakalamba balelongana mu cilye cikalamba ca Bayuda ico baleita “Sanhedrin.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " bonse, balongene balepandana ifyakucita. Awe bakaka Yesu, bamusenda, bamutwala na kuli Pilato. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.1",
            "verseOrgIds": [
              "MRK.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Pilato amwipusha ati, “Bushe iwe niwe mfumu ya Bayuda?” Yesu amwasuka ati, “Nausosa.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.2",
            "verseOrgIds": [
              "MRK.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashimapepo bacindami bena balamwebelela imilandu iyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.3",
            "verseOrgIds": [
              "MRK.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato nakabili aipusha Yesu ati, “Bushe tawayasukepo nelyo cimo? Mona imilandu ubwingi balekwebelela iwe!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.4",
            "verseOrgIds": [
              "MRK.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo Yesu tewakwasukapo nelyo cimo. Awe Pilato camupesha amano.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.5",
            "verseOrgIds": [
              "MRK.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.5",
            "verseOrgIds": [
              "MRK.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba cila nshikunkulu ye Pasaka iya Cakucilila, Pilato alebakakwilapo lyonse umufungwa umo uo abantu balefwaya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.6",
            "verseOrgIds": [
              "MRK.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi kwaliko umuntu umo uo baleita Balaba, uo baposele mu cifungo pamo na babiye ico baipeye abantu ilyo balelwisha ubuteko. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.7",
            "verseOrgIds": [
              "MRK.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ibumba lyaisa kuli Pilato, lyalamulomba ukuti acite ifyo abacitila lyonse. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.8",
            "verseOrgIds": [
              "MRK.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato nao abepusha ati, “Bushe mulefwaya ukuti mukakwile imfumu ya Bayuda?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.9",
            "verseOrgIds": [
              "MRK.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato alishibe ukuti ni ku mufimbilafye bashimapepo bacindami bamuletele Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.10",
            "verseOrgIds": [
              "MRK.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba bashimapepo bacindami balasokawila ibumba ukuti lilombe Pilato abakakwile Balaba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.11",
            "verseOrgIds": [
              "MRK.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato kabili abepusha ati, “Nga kanshi nalacita shani noyu mutila ni mfumu ya Bayuda?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.12",
            "verseOrgIds": [
              "MRK.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo balapundafye abati, “Mutanikenifye!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.13",
            "verseOrgIds": [
              "MRK.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato abepusha ati, “Nga kanshi cinshi ico abifya?” Nabo elyo bacishamo ukupunda abati, “Mutanikenifye!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.14",
            "verseOrgIds": [
              "MRK.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Pilato ico alefwaya ukusansamusha ibumba, abakakwila Balaba. Abeba no kuma Yesu ifikoti, elyo abalubwila ukuti baye mutanika.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.15",
            "verseOrgIds": [
              "MRK.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.15",
            "verseOrgIds": [
              "MRK.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ifita fyatwala Yesu mukati ka lubansa lwa mwisano, fyalonganya ne mpuka yonse iya fita. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.16",
            "verseOrgIds": [
              "MRK.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fyamufwika umwingila wakashika, fyalema iŋana ya myunga, fyamufwika na ku mutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.17",
            "verseOrgIds": [
              "MRK.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo fyatendeka ukulamuposha fileti, “Tupole Mulopwe, we mfumu ya Bayuda!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.18",
            "verseOrgIds": [
              "MRK.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fyalamufupaula ne tete ku mutwe, fyalamusaka amate. Kabili fyalamufukamina pakumutotela. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.19",
            "verseOrgIds": [
              "MRK.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo fyaleka ukumupumya, fyamufuula umwingila wakashika, fyamufwika ne nsalu shakwe. Elyo fyamutwala kunse kukumutanika.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.20",
            "verseOrgIds": [
              "MRK.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.20",
            "verseOrgIds": [
              "MRK.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nshila bakumanya umuntu alepita ukufuma mu mpanga, Simoni umwina Kurene, wishi wakwa Alekisanda na Rufusi, eo bapatikisha ukumusendelako umusalaba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.21",
            "verseOrgIds": [
              "MRK.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo batwala Yesu ku ncende iyo beta Gologota, emukutila, “Pa cipanga.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.22",
            "verseOrgIds": [
              "MRK.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bamupeela no mwangashi uo basakenyemo umuti muri,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.23",
            "verseOrgIds": [
              "MRK.15.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:23",
              "type": "text"
            },
            {
              "text": "Muri:",
              "type": "text"
            },
            {
              "text": "Muti balesakanya no mwangashi, uo balepeela umuntu batanika pakucefyako ukumfwa ubukali.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nomba akaana ukunwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.23",
            "verseOrgIds": [
              "MRK.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.22.18"
              },
              "items": [
                {
                  "text": "Amalu 22:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awe elyo bamutanika. Nomba pakwakana ifyakufwala fyakwe pena, balapendula pakumona ico cila muntu alebuulapo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.24",
            "verseOrgIds": [
              "MRK.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamutanike cilya akasuba kasansama pa nshita ya 09:00. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.25",
            "verseOrgIds": [
              "MRK.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umulandu walembelwepo uo bamwipailepo wakuti, “Ni Mfumu ya Bayuda.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.26",
            "verseOrgIds": [
              "MRK.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabinge batanike pamo nankwe ifipondo fibili, cimo ku kulyo cimbi naco ku kuso. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.27",
            "verseOrgIds": [
              "MRK.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.12"
              },
              "items": [
                {
                  "text": "Esaya 53:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Epakufikilisha ifyalembwa mu Malembo Yamushilo ayakuti, “Apendelwe pamo ne fipondo.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.28",
            "verseOrgIds": [
              "MRK.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.28",
            "verseOrgIds": [
              "MRK.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.29",
            "verseOrgIds": [
              "MRK.15.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.31+EXO.26.32+EXO.26.33"
              },
              "items": [
                {
                  "text": "Ukuf 26:31-33",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi abantu abalepitapo balemutuka balekunta ne mitwe balati, “Eya! Tewe waleti, ‘nkabongolole Tempele, elyo nkalikuula mu nshiku shitatu?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.29",
            "verseOrgIds": [
              "MRK.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi ipusushe we mwine, ika na pa musalaba!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.30",
            "verseOrgIds": [
              "MRK.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu musango umo wine bashimapepo bacindami na bakafundisha bamafunde balalanshanya balemuseka abati, “Alepususha bambi, nomba afilwa ukuipususha umwine! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.31",
            "verseOrgIds": [
              "MRK.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lekeni Kristu Imfumu ya bena Israeli ike pa musalaba uleke tumone, tusumine!” Kabili nabo bene batanikwe nankwe, nabo balamusaalula.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.32",
            "verseOrgIds": [
              "MRK.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.32",
            "verseOrgIds": [
              "MRK.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilya akasuba kafikile pakati ka mutwe pa nshita ya 12:00, imfifi yakupile icalo conse, ukufikafye na lilya kasendeme pa nshita ya 15:00. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.33",
            "verseOrgIds": [
              "MRK.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo cilya akasuba kasendama pa nshita ya 15:00, Yesu apunda ne shiwi ilikalamba ati, “Eloi, Eloi, lama sabakatani?” Ekutila, “Lesa wandi, Lesa wandi, cinshi wandekelesesha?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.34",
            "verseOrgIds": [
              "MRK.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abantu bamo abaiminine mupepi ilyo baumfwa, balasosa abati, “Umfweni, aleita Eliya!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.35",
            "verseOrgIds": [
              "MRK.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo umo abutuka, aya tumpika umwepu mu mwangashi uwakantuka, autunga na kwitete, amutambika ukuti anwe. Asosa nokuti, “Pembeleni, lekeni tumone Eliya nga alaisa mwishapo!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.36",
            "verseOrgIds": [
              "MRK.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Yesu apunda ishiwi ilikalamba aleka no mweo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.37",
            "verseOrgIds": [
              "MRK.15.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.37",
            "verseOrgIds": [
              "MRK.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.38",
            "verseOrgIds": [
              "MRK.15.38"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.31+EXO.26.32+EXO.26.33"
              },
              "items": [
                {
                  "text": "Ukuf 26:31-33",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe icisalu balecinga mwi Tempele calepuka pakati, ukufuma pamulu ukufika na panshi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.38",
            "verseOrgIds": [
              "MRK.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo umukalamba wa fita umwanda umo uwaiminine apalungatene na Yesu, pakumona umusango afwilamo, asosa ati, “Cine cine uyu muntu ni Mwana Lesa.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.39",
            "verseOrgIds": [
              "MRK.15.39"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.39",
            "verseOrgIds": [
              "MRK.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwali na banakashi bamo abaiminine akatalamukila baletamba. Pali aba, palipo Maria Mandalena, bambi ni Maria nyina wakwa Yakobo mwaice na Yose, elyo na Salome. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.40",
            "verseOrgIds": [
              "MRK.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba banakashi ebalekonka Yesu no kumutangata ilyo ali mu Galile. Elyo kwalifye abanakashi abengi abaishile nankwe ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.41",
            "verseOrgIds": [
              "MRK.15.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.41",
            "verseOrgIds": [
              "MRK.15.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 15:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba bwali bushiku bwakupekanya, emukutila pa bushiku bwaletangilile Sabata. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.42",
            "verseOrgIds": [
              "MRK.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nshita ya cungulo kwaishile Yosefu wa ku Alimateya, shicilye umo uwacindikwe nganshi. Nao wine alelolela ukwisa kwa Bufumu bwakwa Lesa. Aya napama kuli Pilato, aya lomba icitumbi cakwa Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.43",
            "verseOrgIds": [
              "MRK.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe Pilato asunguka pakumfwa ukuti Yesu nafwa kale. Elyo aita umukalamba wa fita umwanda umo, alamwipusha nga cacine Yesu nafwa kale. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.44",
            "verseOrgIds": [
              "MRK.15.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo aumfwa ku mukalamba wa fita umwanda umo ukuti nifyo fine, Pilato asuminisha ukupeela Yosefu icitumbi cakwa Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.45",
            "verseOrgIds": [
              "MRK.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MRK 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu nao ashita insalu iyabuuta. Asamuna icitumbi cakwa Yesu, acipomba mu nsalu, acibika mu nindi iyo bafukwile mu cilibwe. Elyo akunkulushishapo ilibwe pa mwinshi wa nindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.46",
            "verseOrgIds": [
              "MRK.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MRK 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maria Mandalena na Maria nyina wakwa Yose balemonako umo balemubika.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.47",
            "verseOrgIds": [
              "MRK.15.47"
            ]
          }
        }
      ]
    }
