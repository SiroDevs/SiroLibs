          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.5",
            "verseOrgIds": [
              "GAL.3.5"
            ]
          }
        },
        {
