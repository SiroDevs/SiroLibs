              "NAM.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NAM 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe we musumba wa Ninife, bushe walicila umusumba wa Tebesi ku busuma? Ngefyo Tebesi nao wine ali mu lulamba lwa mumana wa Nailo, kabili washingulwikwe na Nailo wine uwali nge linga ilyakuipokolwelako. Amenshi eyali nge cibumba ca musumba. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NAM 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icalo ca Kushi ne calo ca Egupto, emwali amaka yauko ayapelele pelelefye. Abena Puti, na bena Libia baleumfwana na bena Tebe. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.9",
            "verseOrgIds": [
              "NAM.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba abena Tebe nabo bene balibekete no kubasenda bunkole. Mu finshoko fya misebo ya mu Tebe emo utwana twabo baletunyankwila pakutwipaya. Abacindami abalimo babasendele mu minyololo, balecita ukupendula pakwakana abakankala babo kubabekete.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NAM 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nemwe bene mwe bena Ninife mukawa nga bantu abakolelwe ubwalwa. Mukafulumuka abalwani benu no kufisama. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.11",
            "verseOrgIds": [
              "NAM.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NAM 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalinga yenu yonse yakabafye nge mikunyu iliko amakunyu ayapya, icakuti umo nga apukunyako, ninshi ne fitwalo kulalukutila mu kanwa kakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.12",
            "verseOrgIds": [
              "NAM.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NAM 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashilika benu balifye nga banakashi, ne calo cenu tacikwete fyakuicingililako ku balwani benu. Imipilikisho ya mpongolo sha musumba wenu naitutaika ku mulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.13",
            "verseOrgIds": [
              "NAM.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NAM 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aleni bangilileni ukutapa amenshi ilyo abalwani benu bashilati bamulibile. Kosheni amalinga yenu. Akukandileni iloba ilyakutamamo amatafwali, fwayeni ifikombola. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.14",
            "verseOrgIds": [
              "NAM.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NAM 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nangu mucite ifyo, ala nalyo line mukatutaika ku mulilo, atemwa mukafwa ku nkondo. Mukapwa nge fisabo ifyo makanta alile.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.15",
            "verseOrgIds": [
              "NAM.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NAM 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musande nga yensa, mufyalane nga makanta. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.15",
            "verseOrgIds": [
              "NAM.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NAM 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalifyala bashimakwebo abacila ne ntanda ku bwingi. Ndakai tabalipo, baliya, baya nga makanta uwansa amapindo yakwe no kupupukila kumbi panuma yakupulula no kulya fyonse. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.16",
            "verseOrgIds": [
              "NAM.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NAM 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bacilolo benu bafula nga makanta, na bamushika benu nga makanta umwingi ulya uwikala ku fibumba ubushiku ilyo kuli impepo. Uwakuti cilya akasuba kabalika, ninshi apupuka, ukwabula nelyo umo uwakwishiba uko ele.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.17",
            "verseOrgIds": [
              "NAM.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NAM 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.17",
            "verseOrgIds": [
              "NAM.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NAM 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe we mfumu we wateeka icalo ca Asiria, ala abalashi bobe nabafwa, bacilolo bobe abacindami nacipwa nabapona mu tulo uto bashakatale ababuukamo. Abantu bobe basalanganine pa mpili, takuli nelyo umo uwakubalonganya nakalya. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.18",
            "verseOrgIds": [
              "NAM.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NAM 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe teti kumoneke umuti uwakuti waposha ifilonda fyobe nakalya, ifilaso fyobe naficilamo, te fyakundapwa iyoo. Bonsefye abaleumfwako ifyo iwe cili, ala bakulaombafye indupi kulwa nsansa, pantu takwaba nelyo umo nakalya uo iwe ushateeka ku kalili.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.19",
            "verseOrgIds": [
              "NAM.3.19"
            ]
          }
        }
      ]
    }
  ],
