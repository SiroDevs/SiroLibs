    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ilyo mukalaakanya inko shonse imo imo impanga nge cikwatwa, mukampatwilako ine ne Yawe Lesa icitungu cimo icikaba icamushilo. Mubutali cili nokulepa amakubiti amakana amakumi yabili na yasano (25,000)",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.1",
            "verseOrgIds": [
              "EZK.45.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:1",
              "type": "text"
            },
            {
              "text": "amakubiti 25,000:",
              "type": "text"
            },
            {
              "text": "Ekutila calepele amakilomita ikumi limo na yabili na citika (12.5 km)",
              "type": "text"
            }
          ]
        },
        {
          "text": ", mubufumo mwena amakubiti amakana amakumi yabili (20,000)",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.1",
            "verseOrgIds": [
              "EZK.45.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:1",
              "type": "text"
            },
            {
              "text": "amakubiti 20,000:",
              "type": "text"
            },
            {
              "text": "Ekutila calepele amakilomita ikumi limo (10 km). Lelo muli Baibele ya mu Cihibulu paleti amakubiti amakana ikumi limo (10,000) ekutila amakilomita yasano (5 km).",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Incende yonse ikalaba iyamushilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.1",
            "verseOrgIds": [
              "EZK.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muli ico citungu muli nokubamo incende imo iyalingana ubukulu monse monse amakubiti imyanda isano (500)",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.2",
            "verseOrgIds": [
              "EZK.45.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:2",
              "type": "text"
            },
            {
              "text": "amakubiti 500:",
              "type": "text"
            },
            {
              "text": "Ekutila yalepele bamita imyanda ibili, na makumi yane na bane (244m).",
              "type": "text"
            }
          ]
        },
        {
          "text": ", eikabamo icifulo camushilo ice Tempele. Elyo mu mbali yaiko monse monse mukashala ulubansa ulukafunguluka amakubiti amakumi yasamo (50)",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.2",
            "verseOrgIds": [
              "EZK.45.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:2",
              "type": "text"
            },
            {
              "text": "amakubiti 50:",
              "type": "text"
            },
            {
              "text": "Ekutila yalepele bamita amakumi yabili na bane (24m).",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.2",
            "verseOrgIds": [
              "EZK.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukufuma pali iyo ncende kukapimwa incende imo, mubutali ikabe amakubiti amakana amakumi yabili na yasano (25,000)",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.3",
            "verseOrgIds": [
              "EZK.45.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:3",
              "type": "text"
            },
            {
              "text": "amakubiti 25,000:",
              "type": "text"
            },
            {
              "text": "Ekutila calepele amakilomita ikumi limo na yabili na citika (12.5 km).",
              "type": "text"
            }
          ]
        },
        {
          "text": ", mubukulu mwena amakubiti amakana ikumi limo (10,000)",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.3",
            "verseOrgIds": [
              "EZK.45.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:3",
              "type": "text"
            },
            {
              "text": "amakubiti 10,000:",
              "type": "text"
            },
            {
              "text": "Ekutila amakilomita yasano (5 km).",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Mukati emukaba icifulo icamushilo, ikaba ni ncende iyamushilo icine cine. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.3",
            "verseOrgIds": [
              "EZK.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "E citungu cikaba icamushilo mu calo, icapatwilwa bashimapepo ababombela ne Yawe mu cifulo camushilo kabili abapalama kuli ne Yawe kukuntumika. Emukaba amayanda yabo, kabili eikaba incende iyamushilo iyikabamo iŋanda yandi iyamushilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.4",
            "verseOrgIds": [
              "EZK.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili mukaba incende na imbi, nayo ine ikabe amakubiti amakana amakumi yabili na yasano (25,000)",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.5",
            "verseOrgIds": [
              "EZK.45.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:5",
              "type": "text"
            },
            {
              "text": "amakubiti 25,000:",
              "type": "text"
            },
            {
              "text": "Ekutila calepele amakilomita ikumi limo na yabili na citika (12.5 km).",
              "type": "text"
            }
          ]
        },
        {
          "text": " mubutali, mubufumo mwena amakubiti amakana ikumi limo (10,000)",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.5",
            "verseOrgIds": [
              "EZK.45.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:5",
              "type": "text"
            },
            {
              "text": "amakubiti 10,000:",
              "type": "text"
            },
            {
              "text": "Ekutila amakilomita yasano (5 km).",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Iyo ncende eikaba iya bena Levi abakalabomba imilimo mwi Tempele, emukuti emukaba imishi yabo iyo bakalaikalamo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.5",
            "verseOrgIds": [
              "EZK.45.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili kuli nokuba icitungu cimbi icakukuulamo umusumba, cili nokulepa mubufumo amakubiti amakana yasano (5,000)",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.6",
            "verseOrgIds": [
              "EZK.45.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:6",
              "type": "text"
            },
            {
              "text": "amakubiti 5,000:",
              "type": "text"
            },
            {
              "text": "Ekutila amakilomita yabili na citika (2.5 km).",
              "type": "text"
            }
          ]
        },
        {
          "text": " na mubutali mwena amakubiti (25,000)",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.6",
            "verseOrgIds": [
              "EZK.45.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:6",
              "type": "text"
            },
            {
              "text": "amakubiti 25,000:",
              "type": "text"
            },
            {
              "text": "Ekutila calepele amakilomita ikumi limo na yabili na citika (12.5 km).",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Ico citungu cili nokubeela lubali lwa citungu icamushilo, kabili ico citungu ecikaba ica ba ŋanda yakwa Israeli bonse.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.6",
            "verseOrgIds": [
              "EZK.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.6",
            "verseOrgIds": [
              "EZK.45.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kateeka ali nokukwatako impanga ku mbali shonse shibili isha citungu ca mu ncende yonse iyamushilo na ku cikwatwa ca musumba. Cili nokuba mumbali pa ncende iyamushilo ne ya musumba mukulola ku lubali lwa ku masamba, elyo lubali lwa ku kabanga. Ukutula ku mupaka wa ku kabanga ukuya na ku wa ku masamba, cili nokulinganafye ubukulu nge fitungu fimbi ifikakwatako inko sha bena Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.7",
            "verseOrgIds": [
              "EZK.45.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi e citungu ico kateeka akakwatako nao mu calo ca Israeli. Bakateeka abo nsonta tabakalecusha abantu kabili, lelo bakalaleka inko sha ba ŋanda yakwa Israeli nabo bakaleikwatila ifitungu mu calo.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.8",
            "verseOrgIds": [
              "EZK.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.8",
            "verseOrgIds": [
              "EZK.45.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imfumu Yawe alisosele ati, “Imwe mwe bakateeka ba bena Israeli, awe mwabifya pafula. Lekeni ubukakashi bwenu no mucusha wenu. Akuciteni ifyalungama, kwateni no mulinganya. Mwikabwekeshapo nakabili ukulatamfya abantu bandi mu mpanga shabo. Nine ne Mfumu Yawe ndemwebelapo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.9",
            "verseOrgIds": [
              "EZK.45.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonsefye muli nokulakwata ifipimo ifyaba bwino. Muli nokulapiminako icipimo ca efa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:10",
              "type": "text"
            },
            {
              "text": "Efa:",
              "type": "text"
            },
            {
              "text": "Cipimo cakupiminako ifya bunga ifyafina amakilo ikumi limo (10kg).",
              "type": "text"
            }
          ]
        },
        {
          "text": " icalinga, ne cipimo ca bafa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:10",
              "type": "text"
            },
            {
              "text": "Bafa:",
              "type": "text"
            },
            {
              "text": "Cipimo ca fintu fya menshi menshi ifyalingana na malita amakumi yabili na yabili (22l).",
              "type": "text"
            }
          ]
        },
        {
          "text": " icalinga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efa na bafa fifwile ukuba ifyalingana. Babafa ikumi ebalingana na homeri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:11",
              "type": "text"
            },
            {
              "text": "Homeri:",
              "type": "text"
            },
            {
              "text": "Cipimo ca fintu ifyalingana mupepi na amakilo umwanda umo (100).",
              "type": "text"
            }
          ]
        },
        {
          "text": " umo, elyo na ba efa ikumi ebalingana na homeri umo. Homeri e cipimo ecakulisha pali fyonse kabili ecakulingako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi ifipimo fyenu fili nokulaba ifi, indalama ishekeli limo ikalingane na magera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:12",
              "type": "text"
            },
            {
              "text": "Amagera:",
              "type": "text"
            },
            {
              "text": "Cipimo ca tuntu utushifinine sana. Gera imo ni 0.6 grammes.",
              "type": "text"
            }
          ]
        },
        {
          "text": " amakumi yabili (20). Amashekeli amakumi yabili (20) ukubikapo amashekeli amakumi yabili na yasano (25) elyo ukubikapo na yambi ikumi limo na yasano (15) eyo yakalingane ne ndalama ya mina",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:12",
              "type": "text"
            },
            {
              "text": "Amashekeli amakumi mutanda (60) eyalingana ne ndalama ya mina imo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " imo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        }
      ]
    },
    {
