              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.24",
            "verseOrgIds": [
              "EZK.45.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 45:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pa nshikunkulu ya Nsakwe iyitampa pa bushiku ubwalenga ikumi na shisano (15), mu mweshi walenga cine lubali, pa nshiku shonse cine lubali, kateeka ali nokulatuula ayo yene amalambo ayakwelelwa pa fyabubifi, na malambo yakoca no mutuulo wa cabunga elyo na mafuta ya miolifa.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.25",
            "verseOrgIds": [
              "EZK.45.25"
            ]
          }
        }
      ]
    }
  ],
