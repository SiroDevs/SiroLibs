            },
            {
              "text": "amakubiti 40:",
              "type": "text"
            },
            {
              "text": "Ekutila calepele bamita ikumi na basano (15m)",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
