              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo kabili uyo muntu antwala mu lubansa lwa mwilinga lyakunse, ampisha na mu mpela shaluko shonse shine. Namona ukuti mwitungi lyonse ilya lubansa mwali akalubansa akanono, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.21",
            "verseOrgIds": [
              "EZK.46.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "emukuti mu matungi yonse aya cibansa mwali utumansa utunono tune. Mubutali cila kalubansa kalepele amakubiti amakumi yane",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.22",
            "verseOrgIds": [
              "EZK.46.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "46:22",
              "type": "text"
            },
            {
              "text": "amakubiti 40:",
              "type": "text"
            },
            {
              "text": "Ekutila calepele bamita amakumi yabili (20m)",
              "type": "text"
            }
          ]
        },
        {
          "text": ", mubufumo mwena kali amakubiti amakumi yatatu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.22",
            "verseOrgIds": [
              "EZK.46.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
