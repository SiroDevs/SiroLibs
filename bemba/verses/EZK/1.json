              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icayanshile pa mulu wa mitwe ya fyamweo calemoneka ngo lwelele, naco cali icabengeshima nge cilola kabili icakusungusha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.22",
            "verseOrgIds": [
              "EZK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwisamba lya lwelele fyalifungulwile amapindo ya fiko no kusuntinkanya ku mapindo ya cinankwe, elyo na cila cimo cali na mapindo yabili ayafimbile umubili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.23",
            "verseOrgIds": [
              "EZK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 1:24"
