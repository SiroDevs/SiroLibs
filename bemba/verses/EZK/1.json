              "type": "text"
            }
          ]
        },
        {
          "text": "Ici camoneke ngo bucindami bwakwa Yawe. Pakumona ifi nawile ubukupeme panshi, elyo naumfwa ishiwi lya umo uulelanda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
