              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo kwafuma ishiwi pa mulu wa lwelele ulwali pa mulu wa mitwe yafiko, ilintu fyaiminine ninshi nafiponya na mapindo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
            "verseOrgIds": [
              "EZK.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 1:26"
          },
          "items": [
