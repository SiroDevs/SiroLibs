                  "text": "Ubuso 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.6"
              },
              "items": [
                {
                  "text": "19:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ilyo ifyamweo fyaleenda, naumfwile iciunda ca mapindo ngo kupooma kwa menshi, kwati lishiwi lya Mwine wa maka yonse, kwati kubolokota kwa fita. Kutifye cilya fyaiminina fyaponya amapindo yafiko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        }
