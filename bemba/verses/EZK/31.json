            "style": "v",
            "sid": "EZK 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.17",
            "verseOrgIds": [
              "EZK.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uyo muti, ala ni Farao wine, imfumu ya Egupto, pamo na bantu bakwe abafulisha efyasosa Imfumu Yawe. Mu Edeni tamwali muti uwalepeshe no kupulamisha ngoyo muti. Elyo nomba ukaposwa mu calo ca bafwa pamo pene ne miti ya mu Edeni, kukuya ikala pamo na bantu abashasembululwa, balya abafwile ku lupanga. Ifi efyasosa imfumu Yawe.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.18",
            "verseOrgIds": [
              "EZK.31.18"
            ]
          }
        }
      ]
    }
