        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.22",
            "verseOrgIds": [
              "EZK.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
