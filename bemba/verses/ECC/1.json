            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.29+1KI.4.30+1KI.4.31"
              },
              "items": [
                {
                  "text": "1 Isham 4:29-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine pano ndi naletifye nati, “Bonsefye abantangilila pa bufumu bwa muno Yerusalemu, awe mwandi ine nimbacila amano. Ine nimfikapo apo umuntu engapela ukukwata amano, napo engapela ukwishiba ifintu.” ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.16",
            "verseOrgIds": [
              "ECC.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi efyo ine nabikishe umutima kukwishiba amano, elyo no kwishiba ubushilu no bupuba. Elyo kabinge nailuka ukuti kanshi naco cine cimo cinefye no kutamfya inshiku.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.17",
            "verseOrgIds": [
              "ECC.1.17"
            ]
          }
        }
      ]
    }
