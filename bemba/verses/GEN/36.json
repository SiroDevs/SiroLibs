      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubu e butantiko bwa lupwa lwakwa Esau, ishina limbi ni Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.1",
            "verseOrgIds": [
              "GEN.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.34"
              },
              "items": [
                {
                  "text": "Icite 26:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Esau aupile abanakashi abena Kenani. Aupile Ada mwana Eloni umwina Hiti, na Olibama mwana Ane, kabili umwishikulu wakwa Sibeoni umwina Hifi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.2",
            "verseOrgIds": [
              "GEN.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.9"
              },
              "items": [
                {
                  "text": "Icite 28:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aupile na Basemati mwana Ishimaeli, kabili e nkashimbiye wakwa Nebaiyoti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.3",
            "verseOrgIds": [
              "GEN.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ada afyele kuli Esau, Elifasi. Basemati nao afyele Reueli, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.4",
            "verseOrgIds": [
              "GEN.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "elyo Olibama afyele Yeushi, Yalamu na Kora. Aba e bana abaume Esau afyele mu calo ca Kenani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.5",
            "verseOrgIds": [
              "GEN.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.5",
            "verseOrgIds": [
              "GEN.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Esau asendele abakashi bakwe, abana abaume na banakashi na bonse aba mu ŋanda mumwakwe, elyo ne fitekwa fyakwe ne nama shonse shimbi ne fintu fyonse anonkele mu calo ca Kenani. Esau epakuya ku calo cimbi icatalwike no kwali Yakobo munyina. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.6",
            "verseOrgIds": [
              "GEN.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifintu bakwete fyalifulishe nganshi icakuti bafilwa ukulaikala pamo. Icalo baleikalamo casuka cacepa ku mulandu wa fitekwa fyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.7",
            "verseOrgIds": [
              "GEN.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Esau, ishina limbi ni Edomu, epakuya ikala mu calo ca mpili isha mu Seiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.8",
            "verseOrgIds": [
              "GEN.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.8",
            "verseOrgIds": [
              "GEN.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulu e lupwa lwakwa Esau, icikolwe ca bena Edomu, abaleikala mu calo ca mpili isha mu Seiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.9",
            "verseOrgIds": [
              "GEN.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya e mashina ya bana baume bakwa Esau: Ni Elifasi, umwana umwaume uo Esau afyele mu mukashi wakwe Ada, elyo na Reueli, umwana umwaume uo afyele mu mukashi wakwe Basemati. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.10",
            "verseOrgIds": [
              "GEN.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abaume abakwa Efasi, ni Temani, Oma, Sefo, Gatamu na Kenasi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.11",
            "verseOrgIds": [
              "GEN.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elifasi mwana Esau alikwetepo no mukashi uo ashaupile mu bwinga, ishina lyakwe ni Timuna umo afyele Amaleki. Aba e beshikulu abaume abakwa Ada muka Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.12",
            "verseOrgIds": [
              "GEN.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abaume abo Reueli afyele ni Nahati, Sera, Shamaya na Misa. Aba e beshikulu bakwa Basemati muka Esau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.13",
            "verseOrgIds": [
              "GEN.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.13",
            "verseOrgIds": [
              "GEN.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abaume abo Esau afyele mu mukashi wakwe Olibama mwana Ane, kabili mwishikulu wakwa Sibeoni ni Yeushi, Yalamu na Kora.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.14",
            "verseOrgIds": [
              "GEN.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.14",
            "verseOrgIds": [
              "GEN.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba ebali ifikolwe fya mikowa pa ba mu lupwa lwakwa Esau. Pa bana abaume bakwa Elifasi, ibeli lyakwa Esau, abali fikolwe fya mikowa ni Temani, Oma, Sifo, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.15",
            "verseOrgIds": [
              "GEN.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kora, Gatamu na Amaleki. Aba ebali ifikolwe fya mikowa mu lupwa lwakwa Elifasi mu Edomu. Kabili bali beshikulu bakwa Ada.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.16",
            "verseOrgIds": [
              "GEN.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.16",
            "verseOrgIds": [
              "GEN.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa bana abaume abakwa Reueli mwana Esau, abali fikolwe fya mikowa ni Nahati, Sera, Shamaya na Misa. Aba ebali ifikolwe fya mikowa mu lupwa lwakwa Reueli mu Edomu. Kabili aba bali beshikulu bakwa Basemati muka Esau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.17",
            "verseOrgIds": [
              "GEN.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.17",
            "verseOrgIds": [
              "GEN.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa bana abaume abo Esau afyele mu mukashi wakwe Olibama, abali ifikolwe fya mikowa ni Yeushi, Yalamu na Kora. Aba ebali ifikolwe fya mikowa ifya mu lupwa lwakwa Olibama muka Esau, kabili Olibama ali umwana umwanakashi wakwa Ane. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.18",
            "verseOrgIds": [
              "GEN.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bonse bali ba mu lupwa lwakwa Esau, ishina limbi Edomu, kabili bali e fikolwe fya mikowa yabo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.19",
            "verseOrgIds": [
              "GEN.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.19",
            "verseOrgIds": [
              "GEN.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba e bana abaume abakwa Seiri umwina Hori, abaleikala muli cilya calo ni Lotani, Shobali, Sibeoni, Ane, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.20",
            "verseOrgIds": [
              "GEN.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dishoni, Eseri na Dishani. Aba bonse ni bamwana Seiri abaleikala mu Edomu, e fikolwe fya mikowa ya bena Hori. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.21",
            "verseOrgIds": [
              "GEN.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwana Lotani abaume ni Hori na Homamu. Nkashi yakwe ena ali ni Timuna. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.22",
            "verseOrgIds": [
              "GEN.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwana Shobali abaume bali ni Alifani, Manaati, Ebali, Shefo na Onamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.23",
            "verseOrgIds": [
              "GEN.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwana Sibeoni abaume ni Aia na Ane. Uyu Ane eulya wasangile utumfukumfuku twa menshi yakaba mu matololo ilyo alecema bapunda bakwa Sibeoni wishi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.24",
            "verseOrgIds": [
              "GEN.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwana Ane bena ni Dishoni na Olibama umwana mwanakashi wakwa Ane. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.25",
            "verseOrgIds": [
              "GEN.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwana Dishoni abaume ni Hemudani, Eshibani, Itirani na Kerani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.26",
            "verseOrgIds": [
              "GEN.36.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwana Eseri abaume ni Biluani, Safani na Akani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.27",
            "verseOrgIds": [
              "GEN.36.27"
