              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abali fikolwe fya mikowa ya bena Hori ni Lotani, Shobali, Sibeoni, Ane, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.29",
            "verseOrgIds": [
