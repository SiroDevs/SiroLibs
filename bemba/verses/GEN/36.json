          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwana Dishani abaume ni Usi na Arani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.28",
            "verseOrgIds": [
              "GEN.36.28"
