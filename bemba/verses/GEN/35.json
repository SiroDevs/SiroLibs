              "items": [
                {
                  "text": "Icite 13:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili Yakobo alimine abwelelamo kumwabo kuli wishi Isaki ku Mamure, mupepi na Kiriati Aba, kabili e Hebuloni wine, uku Abrahamu na Isaki baleikala nga beni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.27",
            "verseOrgIds": [
              "GEN.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaki aikele umumi pano calo imyaka umwanda umo na makumi cine konse konse (108). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.28",
            "verseOrgIds": [
              "GEN.35.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaki epakuleka umweo. Afwa nokufwa ninshi ali umukote uwa myaka iyingi, epakuya ukwalala ifikolwe fyakwe. Elyo bamwane abaume Esau na Yakobo bamushiika.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.29",
            "verseOrgIds": [
              "GEN.35.29"
            ]
          }
        }
