          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lubafu afumishe ku muntu umwaume, Yawe Lesa abumbako umwanakashi, amutwala na ku mwaume. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.22",
            "verseOrgIds": [
              "GEN.2.22"
            ]
          }
        },
