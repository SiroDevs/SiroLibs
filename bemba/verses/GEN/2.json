              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo umwaume asosa ati,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.23",
            "verseOrgIds": [
              "GEN.2.23"
            ]
