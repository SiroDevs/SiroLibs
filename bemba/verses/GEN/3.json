              "items": [
                {
                  "text": "Bahi 6:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuli Adamu atile, “Pantu wacumfwila umukashi obe, elyo walya na ku muti nakukonkomeshe ukuti, ‘Taufwile ukulyako,’",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.17",
            "verseOrgIds": [
              "GEN.3.17"
            ]
          }
        }
