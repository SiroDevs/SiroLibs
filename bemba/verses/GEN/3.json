          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Yawe Lesa aebele insoka ati,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
