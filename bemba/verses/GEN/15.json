              "GEN.15.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.4.13+JOB.4.14"
              },
              "items": [
                {
                  "text": "Yobo 4:13-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo akasuba kaba mukuwa, Abramu apona mu tulo utwingi, elyo imfifi ikalamba kabili iyakutiina yamukupa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.12",
            "verseOrgIds": [
              "GEN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.1+EXO.1.2+EXO.1.3+EXO.1.4+EXO.1.5+EXO.1.6+EXO.1.7+EXO.1.8+EXO.1.9+EXO.1.10+EXO.1.11+EXO.1.12+EXO.1.13+EXO.1.14"
              },
              "items": [
                {
                  "text": "Ukuf 1:1-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.6"
              },
              "items": [
                {
                  "text": "Imili 7:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Yawe amweba ati, “Wishibe icine cine ukuti aba mu lupwa lobe bakaba abeni mu calo icishili cabo. Muli ico calo bakaba abasha, kabili bakabacusha nganshi pa myaka imyanda ine (400). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.13",
            "verseOrgIds": [
              "GEN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.20+EXO.12.21+EXO.12.22+EXO.12.23+EXO.12.24+EXO.12.25+EXO.12.26+EXO.12.27+EXO.12.28+EXO.12.29+EXO.12.30+EXO.12.31+EXO.12.32+EXO.12.33+EXO.12.34+EXO.12.35+EXO.12.36+EXO.12.37+EXO.12.38+EXO.12.39+EXO.12.40+EXO.12.41"
              },
              "items": [
                {
                  "text": "Ukuf 12:20-41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.7"
              },
              "items": [
                {
                  "text": "Imili 7:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lelo nkakanda uyo mushobo ukabateeka ubusha. Elyo panuma bakafumamo nabasenda ifyuma ifingi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.14",
            "verseOrgIds": [
              "GEN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo iwe ukaya mu cibote ukwaba ifikolwe fyobe, kabili bakakushiika mu bukote bwine bwine. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.15",
            "verseOrgIds": [
              "GEN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nkulo yalenga shine, elyo aba mu lupwa lobe bakabwelela muli cino calo pantu ububi bwa bena Amoli tabulati bubipishe ukufikapo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.16",
            "verseOrgIds": [
              "GEN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo akasuba kawa no kufiita kwafiita, elyo kwamoneka inongo umulefuuka icushi no lubingu lulebilima, fyapita pakati ka fipande fya nama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.17",
            "verseOrgIds": [
              "GEN.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.5"
              },
              "items": [
                {
                  "text": "Imili 7:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pali ubo bwine bushiku Yawe apangene icipangano na Abramu, asosa ati, “Aba mu lupwa lobe ebo napeela ici calo, ukufuma ku mumana wa mu Egupto ukufika na ku mumana ukalamba Yufurate, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.18",
            "verseOrgIds": [
              "GEN.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "icalo ca bena Keni, ica bena Kenasi, ica bena Kadimo, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.19",
            "verseOrgIds": [
              "GEN.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ica bena Hiti, ica bena Perisi, ica bena Refaimu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.20",
            "verseOrgIds": [
              "GEN.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ica bena Amoli, ica bena Kenani ica bena Girigashi ne ca bena Yebusi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.21",
            "verseOrgIds": [
              "GEN.15.21"
            ]
          }
        }
      ]
    }
