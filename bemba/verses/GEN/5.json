        },
        {
          "text": "Ilyo Lesa abumbile umuntu, amubumbile mu cata cakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
              "GEN.5.1"
            ]
          }
        },
        {
