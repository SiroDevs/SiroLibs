                "loc": "MRK.10.6"
              },
              "items": [
                {
                  "text": "Mako 10:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ababumbile umwaume no mwanakashi elyo abapaala. Ilyo ababumbile abetile nokuti, “Bantu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:2",
              "type": "text"
            },
            {
              "text": "Bantu:",
              "type": "text"
            },
            {
              "text": "Mu lulimi lwa Cihibulu batila, “muntu.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
