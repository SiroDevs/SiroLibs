            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.23+DEU.12.24"
              },
              "items": [
                {
                  "text": "23-24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.23"
              },
              "items": [
                {
                  "text": "15:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lelo tamufwile ukulya inama umuli umulopa, pantu mu mulopa emwaba ubumi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.4",
            "verseOrgIds": [
              "GEN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili pa mulopa wenu uwabumi nkafwaya ukulubwililapo. Na pa mulopa wa nama wine nkafwaya ukulubulwilapo. Kabili nkalandula pa muntu onse uwasumya umulopa mukwipaya umuntu munankwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.5",
            "verseOrgIds": [
              "GEN.9.5"
            ]
          }
        }
      ]
    },
    {
