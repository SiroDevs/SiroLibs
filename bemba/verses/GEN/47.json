              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.29+GEN.49.30+GEN.49.31+GEN.49.32"
              },
              "items": [
                {
                  "text": "Icite 49:29-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
