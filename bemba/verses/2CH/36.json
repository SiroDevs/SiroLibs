          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoiyakini akwete imyaka yakufyalwa ikumi limo na cine konse konse (18)",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:9",
              "type": "text"
            },
            {
              "text": "18:",
              "type": "text"
            },
            {
              "text": "Ba Baibele Bamo batila ali ne myaka cine konse konse.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ilyo atendeke ukuteeka pa bufumu, kabili aikele pa bufumu imyeshifye itatu mu Yerusalemu ne nshiku ikumi limo. Acitile ifyabipa pa cinso cakwa Yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 36:10"
