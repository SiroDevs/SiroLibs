            }
          ]
        },
        {
          "text": "Yehoyakimu akwete imyaka yakufyalwa amakumi yabili na isano (25) ilyo atendeke ukuteeka pa bufumu, kabili ateekele imyaka ikumi limo na umo (11) mu Yerusalemu. Acitile ifyabipa pa cinso cakwa Yawe, Lesa wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.5",
            "verseOrgIds": [
              "2CH.36.5"
            ]
          }
        },
