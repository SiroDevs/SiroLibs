        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abantu ba mu calo babuulile Yehoahasi mwana Yosaya eo bapyanika pa bufumu mu Yerusalemu pa cifulo cakwa wishi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoahasi akwete imyaka yakufyalwa amakumi yabili na itatu (23) ilyo atendeke ukuteeka pa bufumu, kabili ateekele icalo pa myeshifye itatu mu Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo imfumu ya mu Egupto yaisa mutamfya pa bufumu mu Yerusalemu, yapingula na bena Yuda ukulipila umusonko amatalanta umwanda umo (100)",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:3",
              "type": "text"
            },
            {
              "text": "amatalanta 100:",
              "type": "text"
            },
            {
              "text": "Ekutila amakilo amakana yatatu ne myanda ine (3,400) aya silifa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " aya silifa, elyo ne talanta limo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:3",
              "type": "text"
            },
            {
              "text": "talanta limo:",
              "type": "text"
            },
            {
              "text": "Ekutila amakilo amakumi yatatu na yane (34) aya golide.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ilya golide. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.11+JER.22.12"
              },
              "items": [
                {
                  "text": "Yere 22:11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Imfumu ya ku Egupto yasonta na Eliakimu, munyina wakwa Yehoahasi ukuba imfumu ya bena Yuda na mu Yerusalemu, elyo yapilibula ne shina lyakwa Eliakimu ukuti akulaitwa Yehoyakimu. Lelo Yehoahasi munyina kwa Eliakimu ena Neko amusenda ku Egupto.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
    },
