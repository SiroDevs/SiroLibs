        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palwa fintu fimbi ifya pa bufumu bwakwa Yehoyakimu, ne fintu ifyamakankamike ifyo acitile, fyonse fyalilembwa mu citabo ca milandu ya shamfumu sha bena Israeli na bena Yuda. Elyo umwana wakwe Yehoiyakini amupyana pa bufumu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        }
      ]
    },
