                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo imfumu Nebukadinesa iya ku Babiloni yamusansa, yamukaka ku minyololo ya mukuba, yamusenda na ku Babiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili Nebukadinesa asenda ne fipe fimo ifya mu ŋanda yakwa Yawe kulya kwine no kufibika mwisano lyakwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        }
      ]
    },
