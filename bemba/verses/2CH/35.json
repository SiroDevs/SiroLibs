              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palwa fintu fimbi ifya pa bufumu bwakwa Yosaya nefyo acitile pakuipeelesha ukulingana ne fyalembwa mu mafunde yakwa Yawe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
