          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremia ashika ne nyimbo sha pali Yosaya, kabili ukufika na ino nshita bonse abaume na banakashi bakemba balebukisha Yosaya mu nyimbo. Ici caishile pilibuka caba no lutambi mu Israeli no kulembwa mu nyimbo shabulanda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.25",
            "verseOrgIds": [
              "2CH.35.25"
            ]
