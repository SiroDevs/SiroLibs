            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilikiya elyo na bantu imfumu yatumine pamo nankwe baya kuli Hulida kasesema mwanakashi, uwali umukashi wakwa Shalumu mwana Tokati, nao uwali umwana wakwa Hasira, uwalesunga ifyakufwala fya mfumu. Uyu mwanakashi aleikala mu Yerusalemu, mu ciputulwa cabubili",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.22",
            "verseOrgIds": [
              "2CH.34.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "34:22",
              "type": "text"
            },
            {
              "text": "iciputulwa cabubili:",
              "type": "text"
            },
            {
              "text": "Emukutila incende iyipya iyalundilwe ku musumba.",
              "type": "text"
            }
          ]
        },
        {
          "text": " awe baya mushimikila umulandu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.22",
            "verseOrgIds": [
              "2CH.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
