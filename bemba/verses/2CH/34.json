              "2CH.34.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosaya epakufumya utulubi twamuselu mu calo conse ica bena Israeli, elyo alenga na bekalacalo bonse abaliko ukwamba ukutumika Yawe Lesa wabo. Kanshi na bantu tabalekele ukutumika Yawe Lesa wa fikolwe fyabo mu nshiku shonse ishakwa Yosaya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        }
      ]
