              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ayambile ukukuula Itempele ilye shina lyakwa Yawe elyo ne sano lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.1",
            "verseOrgIds": [
              "2CH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apekenye abantu amakana amakumi cine lubali (70,000) abakusenda ifipe, elyo na bantu amakana amakumi cine konse konse (80,000) abakutoba amabwe mu mpili, elyo na bantu amakana yatatu ne myanda mutanda (3,600) nga bakangalila wa babomfi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.2",
            "verseOrgIds": [
              "2CH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 2:3"
          },
          "items": [
