              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.2+1KI.5.3+1KI.5.4+1KI.5.5+1KI.5.6+1KI.5.7+1KI.5.8+1KI.5.9+1KI.5.10+1KI.5.11"
              },
              "items": [
                {
                  "text": "1 Isham 5:2-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Solomoni atuma amashiwi kuli Hiramu imfumu ya ku Turi ayakuti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.3",
            "verseOrgIds": [
              "2CH.2.3"
            ]
          }
        }
      ]
    },
