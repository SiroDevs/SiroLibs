        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.10",
            "verseOrgIds": [
              "2CH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu imfumu ya ku Turi yayasuka Solomoni mu nkalata aiti, “Pantu Yawe alitemwa abantu bakwe, eco akubikile pa bufumu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.11",
            "verseOrgIds": [
              "2CH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu alundapo amashiwi yakuti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.12",
            "verseOrgIds": [
              "2CH.2.12"
            ]
          }
        }
      ]
    },
    {
