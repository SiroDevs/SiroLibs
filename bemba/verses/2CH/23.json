          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.19",
            "verseOrgIds": [
              "2CH.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo asenda abakalamba ba pa fita imyanda (100), abacindami bakwe, intungulushi sha bantu elyo na bekalacalo bonse baya fumya imfumu mu ŋanda yakwa Yawe, baileta ku ŋanda ye sano ukupitila pa mpongolo ya pamulu no kwisa ibika pa cipuna cabufumu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.20",
            "verseOrgIds": [
              "2CH.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo na bantu bonse mu calo basekelela. Kabili na mu musumba mwaba icibote, pa mulandu wakuti Ataliya bamwipaya ku lupanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.21",
            "verseOrgIds": [
              "2CH.23.21"
            ]
          }
        }
      ]
    }
