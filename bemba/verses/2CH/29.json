              "2CH.29.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eico Hesekia na bantu bonse basansamwike nganshi pafyo Yawe acitile pakati ka bantu bakwe, pantu imilimo yonse yabombeke mukwangufyanya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.36",
