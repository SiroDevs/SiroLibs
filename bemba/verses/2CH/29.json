              "2CH.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekia epakubakonkomesha ukutuula ilambo lyakoca pa bulambo. Cilyafye bayamba ukutuula ilambo na ba nyimbo shakulumbanya Yawe nabo bayamba ukwimba, balelisha amapenga ne filimba ifyo Davidi imfumu ya bena Israeli apekenye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.27",
            "verseOrgIds": [
              "2CH.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulukuta lonse lwakontama no kwamba ukupepa, ninshi abakwimba baleimba na bakulisha amapenga balelisha. Kanshi uyu musango watwalililefye mpaka umulimo wakutuula ilambo lyakoca wapwililika.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.28",
            "verseOrgIds": [
              "2CH.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.28",
            "verseOrgIds": [
              "2CH.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bapwishafye ukutuula ilambo, imfumu na onse uwasangilwepo bafukama panshi balapepa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.29",
            "verseOrgIds": [
              "2CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo imfumu Hesekia na bacilolo bakwe bakonkomesha abena Levi ukuti bambe ukulumbanya Yawe mu mashiwi Davidi na Asafu kamona balebomfya pakulumbanya. Kanshi bonse epakwamba ukulumbanya ninshi nabasansamuka, bakontamina panshi no kupepa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo imfumu Hesekia yaeba abantu aiti, “Ino nshita mwaba abatuulwa kuli Yawe. Eico ambeniko ukuleta imituulo pamo ne yakutotela ku ŋanda yakwa Yawe.” Kanshi ulukuta lonse epakwima no kwamba ukuleta imituulo pamo ne yakutotela, elyo na bonse abali ne mitima yakuitemenwa baletele amalambo yakoca. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.31",
            "verseOrgIds": [
              "2CH.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifya malambo yakoca ifyo ulukuta lwaletele kuli Yawe fyali bacilume wa ŋombe amakumi cine lubali (70), basukusuku umwanda umo (100) elyo no twana twa mpaanga utulume nato imyanda ibili (200). Shonse shali she lambo lyakocela Yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.32",
            "verseOrgIds": [
              "2CH.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inama shonse ishasangulwilwe ku mulimo we lambo lyakoca shafikile iŋombe ishilume imyanda mutanda (600) elyo ne mpaanga ne mbushi shali amakana yatatu (3,000). ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.33",
            "verseOrgIds": [
              "2CH.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo bashimapepo balicepele nganshi abakuti bafunde inama shonse isha malambo yakoca. Kanshi ecalengele bamunyinabo abena Levi bese babafweko mpaka ilyo bapwisha incito kabili basangulwilapo bambi bashimapepo. Pantu abena Levi bena baposele amano mukuisangulula abene ukucila ifyali bashimapepo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.34",
            "verseOrgIds": [
              "2CH.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalifulile nganshi imituulo ya cakoca, pamo pene na mafuta ya mutuulo wakwampana elyo ne fya mutuulo wa fyakwampana uo baletuulila pamo. Kanshi ifi efyo Iŋanda yakwa Yawe yabweseshiwemo umulimo wakupepelamo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
            "verseOrgIds": [
              "2CH.29.35"
            ]
          }
        }
      ]
    },
