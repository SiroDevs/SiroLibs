            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishi e ntungulushi sha mu fitungu fya calo ishaikala mu Yerusalemu na mu misumba ya bena Yuda. Nomba bamo abena Israeli, bashimapepo, abena Levi, ababomfi be tempele pamo na bana ba babomfi bakwa Solomoni baleikala mu misumba ya mu Yuda. Onse mu mpanga yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.3",
            "verseOrgIds": [
              "NEH.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo abantu bambi abafumine mu lupwa lwakwa Yuda na Benjamini, bena baleikala mu Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.4",
            "verseOrgIds": [
              "NEH.11.4"
            ]
          }
        }
      ]
    },
    {
