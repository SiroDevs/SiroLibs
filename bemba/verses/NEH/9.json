          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Yeshua, Bani, Kadimieli, Shebaniya, Buni, Sherebia, Bani elyo na Kenani, bonse ninshi beminine pa matabo ya bena Levi, balebilikisha ne shiwi ilikalamba kuli Yawe, Lesa wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.4",
            "verseOrgIds": [
              "NEH.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili abali abena Levi, Yeshua, Kadimieli, Bani, Hashabineya, Sherebia, Hodiya, Shebaniya elyo na Petaya batile, “Imeni no kupaala Yawe Lesa wenu na matotelo, uwabako ukufuma umuyayaya no kuya umuyayaya!",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.5",
            "verseOrgIds": [
              "NEH.9.5"
            ]
          }
        }
