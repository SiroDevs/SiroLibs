              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba aba e bantu abafwatikepo inshimbi elyo no kulembapo amashina yabo,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.1",
            "verseOrgIds": [
              "NEH.10.1"
            ]
          }
        }
