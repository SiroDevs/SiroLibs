              "items": [
                {
                  "text": "Ukuf 30:11-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili twaipeela ne fyebo ifyakuti cila mwaka twakulapeela ulupiya lumo",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:32",
              "type": "text"
            },
            {
              "text": "ulupiya lumo:",
              "type": "text"
            },
            {
              "text": "Mu Cihibulu mwatila iciputulwa cacitatu ica shekeli umo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ulwakwafwa mukubomba imilimo ya mu ŋanda yakwa Lesa wesu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twasumina ukupeela ifyakubomba ku mukate wakutuula, imituulo ya cabunga iya pe na pe, ilambo lya cakoca, imituulo ya pa Masabata, iya pa mweshi uupya, iyakubomfya pa nshikunkulu, kabili ku fyabupe ifyamushilo elyo na ku mituulo ya pa fyabubifi iyakufutila abena Israeli, elyo na pa fya milimo yonse iya pa ŋanda yakwa Lesa wesu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        }
      ]
    },
