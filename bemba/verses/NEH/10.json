                  "text": "Amaf 7:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Twalapa ukukanaufya abana besu abanakashi ku bana ba benafyalo abatushinguluka, nangu ukufwaya abana babo ukuupwa ku bana besu abaume.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
