              },
              "items": [
                {
                  "text": "Amaf 15:1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nga cakuti abantu mu calo baleta ifyakushitisha nangufye ifyakulya ifya misango misango, tatwakatale atushitako nga cakuti baleta pa bushiku bwe Sabata",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:31",
              "type": "text"
            },
            {
              "text": "Isabata:",
              "type": "text"
            },
            {
              "text": "Calola mukuti ubushiku bwakwa Lesa ubwakutuusha.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", nangufye ni pa bushiku bwamushilo bumbi. Eico kanshi lyonsefye ilyo umwaka wa cine lubali wafika, tuli nokuleka umushili ukubafye elyo no kufuuta ifyamisha fyonse.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        }
      ]
    },
