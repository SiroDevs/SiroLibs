        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.13",
            "verseOrgIds": [
              "NEH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili intungulushi sha bantu nasho shali ni Paroshi, Pahati Moabu, Elamu, Satu na Bani,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.14",
            "verseOrgIds": [
              "NEH.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.27",
            "verseOrgIds": [
              "NEH.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo pali na bantu bambi pamo nga bashimapepo, abena Levi, bakalinda wa mpongolo, bakemba, ababomfi be Tempele, na bonsefye abatalwike ku benafyalo pakukonka amafunde yakwa Yawe. Kabili bali pamo pene na bakashi babo pamo na bana babo abaume na banakashi bene. Bonsefye abali ne myaka yakucenjela no kwiluka ifintu abene. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.28",
            "verseOrgIds": [
              "NEH.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bauminkana pamo na bamunyinabo, abasambashi babo, ilyo balelaya pakuitipwila, na mukulapa ukukonka amafunde yakwa Lesa ayo apeele ku kanwa kakwa Mose umubomfi wakwa Lesa. Twasuminishanya capamo ukubeela bwino amafunde, ifipope na malango yonse ayakwa Yawe, Imfumu yesu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.29",
            "verseOrgIds": [
              "NEH.10.29"
            ]
          }
        }
      ]
    },
