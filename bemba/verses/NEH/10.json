          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifwe nga bashimapepo, abena Levi, elyo na bantu bonse natucita icipendwilo cakwishiba ifyo aba muli cila lupwa bali nokupeela inkuni ku ŋanda yakwa Lesa wesu pa nshita iyasontwa mu mwaka no mwaka. Ishi ni nkuni shakukosha pa bulambo bwakwa Yawe, Lesa wesu, pamo ngefyo calembwa mu mafunde.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
        }
      ]
    },
