          },
          "items": [
            {
              "text": "\n        2 Isham 14:23—15:7; 15:32—16:20; 18:1—20:21; 2 Imila 26:1—27:8; 28:1—32:33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishiwi lyakwa Yawe lyaishile kuli Hosea mwana Beri pa nshita icalo ca Yuda caleteekwa ne shamfumu Usia, Yotamu, Ahasi na Hesekia, nelyo Yeroboamu mwana Yoashi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:1",
              "type": "text"
            },
            {
              "text": "Yoashi:",
              "type": "text"
            },
            {
              "text": "Ba Baibele bamo batila, “Yehoashi.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ateekele icalo ca Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        }
      ]
