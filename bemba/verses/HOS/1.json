              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.26"
              },
              "items": [
                {
                  "text": "Roma 9:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nangu cibe ifyo abena Israeli bakafula ngo musensenga wa mu lulamba lwa bemba, uushingapimwa nangufye ukupendwa. Nomba palya casoselwe palwa bena ukuti, “Imwe tamuli bantu bandi iyoo,” lelo ilyo lyena akalabeba ati, “Imwe muli bana bandi ine ne Lesa Umumi.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abena Yuda bakakumbinkana pamo na bena Israeli. Abene ebakalaisontela intungulushi imofye iyakubateeka, nakabili bakafula, no kushuka bakalashuka mu calo cabo. Ubo bushiku bwakwa Yesireli bukaba ubukalamba.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
      ]
