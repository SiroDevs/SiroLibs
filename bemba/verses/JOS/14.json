              "JOS.14.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.30"
              },
              "items": [
                {
                  "text": "Imp 14:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba abantu aba mu luko lwakwa Yuda baile kuli Yoshua ku Giligali, elyo Kalebu mwana Yefune umwina Kenasi atile kuli ena, “Nawishiba ifyo Yawe aebele Mose umuntu wakwa Lesa ku Kadeshi Banea pa mulandu obe elyo na ine. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.6",
            "verseOrgIds": [
              "JOS.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.1+NUM.13.2+NUM.13.3+NUM.13.4+NUM.13.5+NUM.13.6+NUM.13.7+NUM.13.8+NUM.13.9+NUM.13.10+NUM.13.11+NUM.13.12+NUM.13.13+NUM.13.14+NUM.13.15+NUM.13.16+NUM.13.17+NUM.13.18+NUM.13.19+NUM.13.20+NUM.13.21+NUM.13.22+NUM.13.23+NUM.13.24+NUM.13.25+NUM.13.26+NUM.13.27+NUM.13.28+NUM.13.29+NUM.13.30"
              },
              "items": [
                {
                  "text": "Imp 13:1-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ine nali ne myaka amakumi yane iyakufyalwa lintu Mose umubomfi wakwa Yawe antumine ukufuma ku Kadeshi Banea mukufwailisha no kulengula icalo. Elyo na ine ilyo nabwelulwikeko, namuletele akasebo ukulingana nefyo naile sanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.7",
            "verseOrgIds": [
              "JOS.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba bamunyinane abo naile nabo, banenwine abantu nokulenga baba no mwenso. Lelo ine nakonkelefye no mutima onse ifyo Yawe Lesa wandi anjebele ukucita. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
              "JOS.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.24"
              },
              "items": [
                {
                  "text": "Imp 14:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eico kanshi pali bulya bushiku bwine, Mose alapile umulapo kuli ine ati, ‘Icalo ico waile nyantamo amakasa yobe cili nokuba icakaniko ca cishilano cobe pamo pene na bana bobe pe na pe. Pantu walikonka no mutima obe onse ifyo Yawe Lesa wandi afwaya.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.9",
            "verseOrgIds": [
              "JOS.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eico nomba, pamo ngefyo wamona, Yawe ansunga ukuba uwamweo pa myaka amakumi yane na isano (45) ukufuma inshita Yawe asosele ifi kuli Mose. Cali lintu abena Israeli baleendauka mu matololo. Eico mona ine ilelo ndi ne myaka amakumi cine konse konse na isano (85)! ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na lelo line ine ncili uwamaka nga filya fine nali mu bushiku Mose antuminemo. Na ndakai line ncili na maka yakuya ku bulwi no kubwela, ngefyo nali pali ilya inshita. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.11",
            "verseOrgIds": [
              "JOS.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.4"
              },
              "items": [
                {
                  "text": "Icite 6:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.33"
              },
              "items": [
                {
                  "text": "Imp 13:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.2"
              },
              "items": [
                {
                  "text": "Amaf 9:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.11.21"
              },
              "items": [
                {
                  "text": "Yosh 11:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eico kanshi nomba mpeela ici calo ca ku mpili ico Yawe andaile pa bushiku bulya. Pantu walyumfwile we mwine pali ilya inshita ukuti abena Anaki eko bacili, kabili imisumba yabo ikalamba nganshi, iya malinga. Ndecetekela Yawe alengafwa, mbafulumunemo, pamo ngefyo asosele.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe Yoshua epakupaala Kalebu umwana mwaume wakwa Yefune no kupeela icalo ca Hebuloni ukuba icakaniko ca cishilano cakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.13",
            "verseOrgIds": [
              "JOS.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eico icalo ca Hebuloni ukushinta na pali lelo ecaba icishilano cakwa Kalebu, umwana mwaume wakwa Yefune, umwina Kenasi, pa mulandu wakuti akonkele amashiwi yakwa Yawe Lesa wa bena Israeli no mutima onse. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.14",
            "verseOrgIds": [
              "JOS.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishina lyakale ilya Hebuloni ni Kiriati Ariba, pantu Ariba ali umuntu uwacindamisha pakati ka bena Anakimu. Kabili mu calo ubulwi bwalipwile, mwabafye tondolo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    }
  ],
