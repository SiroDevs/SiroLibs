              "items": [
                {
                  "text": "10:39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Umuntu nga acita umulandu ukulu nganshi, bamwipailapo, bakulikila icitumbi cakwe na ku muti, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.22",
            "verseOrgIds": [
              "DEU.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
