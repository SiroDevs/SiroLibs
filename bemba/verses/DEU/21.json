            "number": "23",
            "style": "v",
            "sid": "DEU 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.13"
              },
              "items": [
                {
                  "text": "Gal 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "icitumbi cakwe tacili nakulala ku cimuti iyoo. Mufwile ukucishiika ubo bwine bushiku, pantu umuntu uwakulikwa pa cimuti ninshi alitipwa kuli Lesa. Mukaleshiika ifitumbi epakukanakowesha icalo Yawe Lesa wenu ali mukumupeela.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.23",
            "verseOrgIds": [
              "DEU.21.23"
            ]
          }
        }
