                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.16"
              },
              "items": [
                {
                  "text": "27:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Nga cakuti umuntu umo alikwata umwana uwatalama kabili cintomfwa, umwana uushumfwila bafyashi bakwe, nangufye bamukande shani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.18",
            "verseOrgIds": [
              "DEU.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafyashi bakwe, wishi na nyina bali nokumutwala ku ntungulushi sha mu musumba pa mpongolo ya musumba wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.19",
            "verseOrgIds": [
              "DEU.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafyashi balaeba intungulushi abati, ‘Uyu mwana wesu ni cintomfwa, kabili alitutalamina. Takonka nefyo tumweba kabili ni cakolwa.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.20",
            "verseOrgIds": [
              "DEU.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abaume bonse aba mu musumba wenu bamupole amabwe imfwila. Lyena mukalapwisha ubo bubi pakati kenu. Umuntu onse mu calo ca Israeli ilyo akomfwako akalatiina.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.21",
            "verseOrgIds": [
              "DEU.21.21"
            ]
          }
        }
      ]
    },
