            "number": "10",
            "style": "v",
            "sid": "DEU 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.10",
            "verseOrgIds": [
              "DEU.7.10"
            ]
          }
        }
      ]
