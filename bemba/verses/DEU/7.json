              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili Mose atile, “Ilyo Yawe Lesa wenu akamutwala mu calo ico mukengilamo kukucipoka, akatamfyamo imishobo ya bantu iyingi. Akatamfyamo imishobo cine lubali iyikalamba kabili iyamaka ukumucila imwe, abena Hiti, abena Girigashi, abena Amoli, abena Kenani, abena Perisi, abena Hifi na bena Yebusi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.1",
            "verseOrgIds": [
              "DEU.7.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.19"
              },
              "items": [
                {
                  "text": "Imili 13:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.1",
            "verseOrgIds": [
              "DEU.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili nga Yawe Lesa wenu abaposa mu minwe yenu no kubacimfya mwabacimfya, mukapeela bonsefye kukonaulwa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.2",
            "verseOrgIds": [
              "DEU.7.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:2",
              "type": "text"
            },
            {
              "text": "ukupeela kukonaulwa:",
              "type": "text"
            },
            {
              "text": "Ili shiwi mu Cihibulu lipilibula ukulubwila kuli Lesa icintu nangu umuntu ukwabula ukulapulula, ilingi line ni mukonaulwa.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Tecakwesha kupangana nabo bucibusa, kabili takuli kubabelela luse.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.2",
            "verseOrgIds": [
              "DEU.7.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
