                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kanshi mwishibe ukuti Yawe Lesa wenu, e Lesa eka, uwacishinka, alasunga icipangano no kulanga icitemwiko icishipwa ku bantu abamutemwa, abakonka na mafunde yakwe, ukufikafye na ku nkulo ikana limo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.9",
            "verseOrgIds": [
              "DEU.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
