                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1 Pet 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pantu imwe muli bantu bamushilo abakwa Yawe Lesa wenu. Yawe Lesa wenu, alimupatula ku bantu bonse mpanga yonse pano isonde lyonse, nimwefye aisalila ukuba abantu bakwe abo acindamika.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.6",
            "verseOrgIds": [
              "DEU.7.6"
            ]
          }
        }
      ]
    },
    {
