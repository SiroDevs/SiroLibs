              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kanshi mulebaka amafunde, amalango ne fipope ifyo namupeela ilelo.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.11",
            "verseOrgIds": [
