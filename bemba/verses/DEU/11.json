              "DEU.11.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.6+DEU.6.7+DEU.6.8+DEU.6.9"
              },
              "items": [
                {
                  "text": "Amaf 6:6-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kanshi bikeni amashiwi yandi aya mu mitima yenu na mu mano yenu. Muleyakakila na ku maboko yenu, no kuyafwala pa mpumi shenu, nge fishibilo fyakwibukishishako. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.18",
            "verseOrgIds": [
              "DEU.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muleyasambilisha na ku bana benu. Muleyakomailapo ilyo mwikele pa mayanda yenu, na lintu muletandala mu misebo, na pakusendama kabili na lintu mwabuka mu tulo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.19",
            "verseOrgIds": [
              "DEU.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muleyalemba na pa filu fya minshi ya mayanda yenu, na pa mpongolo shenu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.20",
            "verseOrgIds": [
              "DEU.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakuti lyena inshiku shenu pamo ne sha bana benu shikabe ishingi ishakwikala muli cilya calo, ico Yawe alapile ukupeela ifikolwe fyenu, ukushinta napo umulu ukekalila pa mulu wa calo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.21",
            "verseOrgIds": [
              "DEU.11.21"
            ]
          }
        }
      ]
    },
    {
