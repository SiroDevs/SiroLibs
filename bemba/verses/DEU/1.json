                "loc": "HEB.3.16"
              },
              "items": [
                {
                  "text": "Bahi 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Lelo imwe tamwalefwaya ukuya muli cilya calo, mwasangukile ifyo Yawe Lesa wenu amukonkomeshe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.26",
            "verseOrgIds": [
              "DEU.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaleisosha mu matenti yenu amuti, ‘Yawe alitupatafye, ico atufumishishe mu Egupto ni kukwisa tuposa mu minwe ya bena Amoli, pakuti batulofye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.27",
            "verseOrgIds": [
              "DEU.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.4"
              },
              "items": [
                {
                  "text": "Icite 6:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.33"
              },
              "items": [
                {
                  "text": "Imp 13:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bushe ni kwi twingaya? Awe ifwe natwikatwa no mwenso. Bamunyinefwe nabatufuupula imitima, batile, “Abantu abekala muli cilya calo, bamaka kabili batali ukutucila. Bena bekala mu misumba iyikalamba iyakuulwa na malinga ayafika na mu mulu. Twamweneko na bena Anaki, ifipokapoka fya bantu.” ’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.28",
            "verseOrgIds": [
              "DEU.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.28",
            "verseOrgIds": [
              "DEU.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nomba ine namwebele nati, ‘Mwibatiina, kabili mwitutuma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.29",
            "verseOrgIds": [
              "DEU.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe Lesa wenu ewakulamutungulula, kabili ewakulamulwilako, nga filya fine mwaimwenene na menso yenu ifyo acitile mu calo ca Egupto. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.30",
            "verseOrgIds": [
              "DEU.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.18"
              },
              "items": [
                {
                  "text": "Imili 13:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabili nga filya fine mwayimwenene mu matololo ifyo Yawe Lesa wenu amusendele, nga filya wishi asenda umwana wakwe umwaume, mu nshilafye yonse mwaendelemo, mpaka ukwisa fika na pali cino cifulo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.31",
            "verseOrgIds": [
              "DEU.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.19"
              },
              "items": [
                {
                  "text": "Bahi 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nomba nangu cali ifyo, nalyo line imwe tamwatetekele Yawe Lesa wenu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.32",
            "verseOrgIds": [
              "DEU.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwalemutangilila pa bulendo bwenu, mu nshita ya bushiku mu ntumba ya mulilo, elyo akasuba nalyo mwikumbi, pakuti amufwaile icifulo apakucita inkambi no kumulanga umwakuya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.33",
            "verseOrgIds": [
              "DEU.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 1:33"
          },
          "items": [
