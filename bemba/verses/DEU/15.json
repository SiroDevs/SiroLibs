              },
              "items": [
                {
                  "text": "Imp 18:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Amabeli yonse ayalume aya ŋombe shenu na ya fitekwa fyenu muleyapatwila Yawe Lesa wenu. Kanshi isho ŋombe mwikalaesha kushibomfya ku milimo, kabili ne mpaanga nasho mwikalashibeya masako. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.19",
            "verseOrgIds": [
              "DEU.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cila mwaka imwe pamo na ba mu lupwa lwenu, mukaleshilya pa cinso cakwa Yawe Lesa wenu pa ncende iyo akasala. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
              "DEU.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba nga cakuti inama nga yalikwata akalema, nangu yalitulika amenso, nangu ilasunta, nangu yaba na kalema kambi akabipisha nganshi, yena tamuli nakulekela Yawe Lesa wenu ilambo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
          }
        },
        {
          "name": "verse",
