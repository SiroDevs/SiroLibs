            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.39+LEV.25.40+LEV.25.41+LEV.25.42+LEV.25.43+LEV.25.44+LEV.25.45+LEV.25.46"
              },
              "items": [
                {
                  "text": "Levi 25:39-46",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nga cakuti Umuhibulu munobe, umwaume nangu umwanakashi, aishitisha ubusha kuli iwe, akubombela na pa myaka mutanda, mu mwaka walenga cine lubali ufwile ukumulekako abe umuntungwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.12",
            "verseOrgIds": [
              "DEU.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili ilyo wamuleka ukuti abe umuntungwa, wikaleka aye iminwe nkutwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.13",
            "verseOrgIds": [
              "DEU.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukamupeele ifyabupe ukwabula ukusalulula ukufuma pafyo Yawe Lesa obe akupaalilapo, impaanga, iŋanu no mwangashi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.14",
            "verseOrgIds": [
              "DEU.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwibukishe ukuti na imwe bene mwali abasha mu calo ca Egupto, kabili Yawe Lesa wenu amulubula. Kanshi e mulandu wine na ine namupeelela ili funde ilelo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.15",
            "verseOrgIds": [
              "DEU.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
