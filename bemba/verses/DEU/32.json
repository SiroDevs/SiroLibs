                "loc": "DEU.3.23+DEU.3.24+DEU.3.25+DEU.3.26+DEU.3.27"
              },
              "items": [
                {
                  "text": "Amaf 3:23-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pa bushiku bumo bwine Yawe aebele Mose ati, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.48",
            "verseOrgIds": [
              "DEU.32.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 32:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nina ulupili lwa Nebo, ulwa mu mpili sha Abarimu, mu calo ca Moabu, ukulungatana no musumba wa Yeriko, utambe icalo ca Kenani, ico ine nalapeela abena Israeli ukuba icuma cabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.49",
            "verseOrgIds": [
              "DEU.32.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "DEU 32:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pali lulya lwine lupili walanina epo uleya fwila no kuya lala ukwalala abantu bobe, nga filya fine munonko Aroni afwilile pa lupili lwa Hori no kuya lala ukwalala abantu bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.50",
            "verseOrgIds": [
              "DEU.32.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "DEU 32:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pantu imwe bonse babili tamwancetekele pa cinso ca bena Israeli pa cishima ca ku Meriba Kadeshi mu matololo ya Sini, kabili pantu tamwalangile ukuti ndi wamushilo pa cinso ca bena Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.51",
            "verseOrgIds": [
              "DEU.32.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "DEU 32:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eico ulemonakofye cilya calo akatalamukila, tawakengilemo mu calo ndepeela abena Israeli.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.52",
            "verseOrgIds": [
              "DEU.32.52"
            ]
          }
        }
      ]
