            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21+NUM.18.22+NUM.18.23+NUM.18.24+NUM.18.25+NUM.18.26+NUM.18.27+NUM.18.28+NUM.18.29+NUM.18.30+NUM.18.31+NUM.18.32"
              },
              "items": [
                {
                  "text": "Imp 18:21-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Cila mwaka pafyo mukalasombola mu mabala yenu, mukalebuulapo icekumi pekumi limo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.22",
            "verseOrgIds": [
              "DEU.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukalelya icapekumi ca ŋanu shenu, umwangashi upya na mafuta, kabili ne beli lya ŋombe ne fitekwa fyenu fyonse pa cinso cakwa Yawe Lesa wenu pa ncende akasala nge cifulo ce shina lyakwe, pakuti mukasambilile ukukwatila Yawe Lesa wenu akatiina inshita yonse. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.23",
            "verseOrgIds": [
              "DEU.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba nga ilya ncende yaba ukutali noko mwikala, icakuti mwafilwa no kusenda ifyekumi pafyo Yawe Lesa wenu amupaala, (pantu incende iyo Yawe Lesa wenu akasala nge cifulo ce shina lyakwe ili ukutali nganshi), ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "lyena mulekabula ifyapekumi ne ndalama, elyo mukalesenda isho ndalama no kuya nasho ku ncende iyo Yawe Lesa wenu akasala. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.25",
            "verseOrgIds": [
              "DEU.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isho shine indalama esho mukalebomfya ukushitamo fyonse ifyo mulefwaya pamo nge ŋombe, impaanga, umwangashi nangu icakunwa icikola, nangu fimbi ifyo mwingatemwa. Kulya kwine pa cinso cakwa Yawe Lesa wenu, imwe pamo na ba mu ŋanda yenu eko mukalelya no kusansamuka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba mwikalaba kubaka abena Levi mukalaikala nabo mu misumba yenu, pantu tabaikwatila citungu nangu icacishilano cabo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.27",
            "verseOrgIds": [
              "DEU.14.27"
            ]
          }
        }
      ]
    },
