                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabili Mose atile, “Imwe muli bana bakwa Yawe Lesa wenu. Tecakwesha ukuitetaula mwe bene, nangu ukubeya inkuso",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:1:",
              "type": "text"
            },
            {
              "text": "Ukubeya inkuso:",
              "type": "text"
            },
            {
              "text": "Mu ntambi sha bena Israeli, nga bafwilwa balebeya iciteta, emukutila ukufuma pakati ka mutwe ukwisa fika pa mpumi.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", pa mulandu waufwile, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.5"
              },
              "items": [
                {
                  "text": "Ukuf 19:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
