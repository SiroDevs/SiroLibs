              ]
            }
          ]
        },
        {
          "text": "“Kambone umo tekuti ashinine umuntu uupeelwe umulandu uuli onse nangu icilubo ico nalimo acicita. Pakuti kube ukupeela umulandu, kano kwaba bakambone babili nangu batatu abakushininkisha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.15",
            "verseOrgIds": [
              "DEU.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga cakuti kambone walufyengo aiminina pakubepesha umuntu umulandu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.16",
            "verseOrgIds": [
              "DEU.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "bonse babili abali mu mulandu bali nokwiminina pa cinso cakwa Yawe pantanshi ya bashimapepo na bakapingula abakabapo pali iyo nshita. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.17",
            "verseOrgIds": [
              "DEU.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakapingula bakafwailishe umulandu bwino. Kabili nga basanga ukuti kambone wabufi, alebepesha umunankwe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.18",
            "verseOrgIds": [
              "DEU.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.13"
              },
              "items": [
                {
                  "text": "1 Kol 5:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ninshi uyo kambone wabufi mumucitile ifyo acilafwaya umunankwe bamucitile. Kanshi efyo mufwile ukufumya ububi pakati kenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.19",
            "verseOrgIds": [
              "DEU.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bonse bakomfwako, bakalatiina, kabili takwakabe nangu umo uukabwekeshapo ukucita nakabili icintu icabipa ifyo pakati kenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.20",
            "verseOrgIds": [
              "DEU.19.20"
            ]
          }
        },
