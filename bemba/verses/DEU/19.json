                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwikalasesha amabwe ya mipaka ya banenu, iyapiminwe kale na bantu babalilepo mu calo ico Yawe Lesa wenu ali nokumupeela ukucipoka.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
