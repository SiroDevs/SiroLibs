          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.10",
            "verseOrgIds": [
              "DEU.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nomba nga cakuti umuntu alipata umubiye, kabili amubelamina, amusansa, amwipaya no kumwipaya, elyo abutukila ku musumba umo pali ilya itatu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.11",
            "verseOrgIds": [
              "DEU.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "lyena abakalamba ba mu musumba wakwe bakatume abakuya mubwesha kuli ulya musumba no kwisa mulubwila kuli kalandula wa mulopa, pakuti nao amwipaye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.12",
            "verseOrgIds": [
              "DEU.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwikalamukwatila luse. Kanshi mufwile ukufumya umulandu wakusumya umulopa wakaele mu Israeli, epakuti cikalemuwamina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.13",
            "verseOrgIds": [
              "DEU.19.13"
            ]
          }
        }
      ]
    },
