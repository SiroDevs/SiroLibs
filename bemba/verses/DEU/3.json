              "DEU.3.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.12+JOS.1.13+JOS.1.14+JOS.1.15"
              },
              "items": [
                {
                  "text": "Yosh 1:12-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Elyo pa nshita ine ilya namukonkomeshe nati, ‘Yawe Lesa wenu namupeela ici calo ukuti cibe cenu. Nomba abaume bonse amalamba nabaipangashe ifyanso fyabulwi, babukile kwishilya lya mumana wa Yordani, batangilile bamunyinenwe bambi abena Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.18",
            "verseOrgIds": [
              "DEU.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanofye abakashi benu na bana benu ebali nokushala mu misumba namupeela pamo ne fitekwa fyenu, (ninjishiba namukwata ifitekwa ifingi), ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.19",
            "verseOrgIds": [
              "DEU.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpakafye Yawe akapeele na bamunyinenwe ukutuusha pamo nga imwe. Bakaikwatile nabo icalo ico Yawe Lesa wenu akabapeela kwishilya lya mumana wa Yordani. Lyena elyo mukabwelela cila umo ku citungu cakwe ico namupeela.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.20",
            "verseOrgIds": [
              "DEU.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.20",
            "verseOrgIds": [
              "DEU.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Elyo pa nshita ilya nakonkomeshe Yoshua nati, ‘Nauimwena na menso yobe we mwine fyonse ifyo Yawe Lesa obe acitile kuli shilya mfumu shibili. Yawe akalacita cimo cine ku shamfumu shonse isha uko muleya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.21",
            "verseOrgIds": [
              "DEU.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tecakwesha kushitiina, pantu Yawe Lesa obe e ukalakulwishishako.’",
          "type": "text",
          "attrs": {
