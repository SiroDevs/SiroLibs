          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kanshi ifwe epakwikala mwishika mupepi no musumba wa Beti Peori.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.29",
            "verseOrgIds": [
              "DEU.3.29"
            ]
          }
