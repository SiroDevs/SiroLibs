                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1 Pet 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabili Yawe nao nasosa ilelo ukuti muli bantu bakwe abo acindamika, nokuti muli nokulasunga amafunde yakwe yonse. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.18",
            "verseOrgIds": [
              "DEU.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe nasosa ukuti akamucita ukuba abalulumbi, abatashiwa kabili abacindami ukucila imishobo yonse iyo apanga, kabili nokuti mukaba abantu bamushilo abakwa Yawe Lesa wenu ngefyo alaile.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.19",
            "verseOrgIds": [
              "DEU.26.19"
            ]
          }
        }
