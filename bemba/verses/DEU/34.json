          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.33.11"
              },
              "items": [
                {
                  "text": "Ukuf 33:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.6+NUM.12.7+NUM.12.8"
              },
              "items": [
                {
                  "text": "Imp 12:6-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ukufuma lilya line, takwatala akuba kasesema nangu umo mu Israeli uwaba nga Mose uo Yawe aishibe no kuloleshanya nankwe amenso. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili takwatala akuba uwacitile ifipeshamano ne finjelengwe nga filya Yawe atumine Mose ukuti aye acite mu Egupto, kuli Farao na kuli bacilolo bakwe, kabili na ku calo cakwe consefye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.11",
            "verseOrgIds": [
              "DEU.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili takwaba kasesema nangu umo uwatala acita ifintu ifyamaka kabili ifyakutiinya nga filya Mose alecita pa cinso ca bena Israeli bonse.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.12",
            "verseOrgIds": [
              "DEU.34.12"
            ]
          }
        }
      ]
    }
