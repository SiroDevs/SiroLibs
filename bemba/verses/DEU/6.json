              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mu nshiku sha kuntanshi umwana obe nga akwipusha ati, ‘Bushe calola mwi ici Yawe Lesa wesu amukonkomeshe ukulakonka amafunde, ifyebo ne fipope fyakwe?’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.20",
            "verseOrgIds": [
              "DEU.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti mwamweba ati, ‘Ifwe twali abasha bakwa Farao mu Egupto, nomba Yawe atufumishe mu Egupto ku kuboko kwakwe ukwabulamba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.21",
            "verseOrgIds": [
              "DEU.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twalimwene na menso yesu uko Yawe alecita ifipeshamano ne finjelengwe ifikalamba kabili ifyabipisha pa bena Egupto na Farao kumo na ba ŋanda yakwe yonse. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.22",
            "verseOrgIds": [
              "DEU.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo atufumyako no kutuleta kuno, atupeela na cino calo alaile no mulapo ku fikolwe fyesu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.23",
            "verseOrgIds": [
              "DEU.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alitukonkomeshe ukulabeela ifipope ifi fyonse, no kukwatila Yawe Lesa wesu akatiina pakuti cikatuwamine lyonse, tuleenda abomi, ngefi fine cili ilelo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.24",
            "verseOrgIds": [
              "DEU.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili nga twalabeela amafunde aya pa cinso cakwa Yawe Lesa wesu ngefyo atukonkomesha, cikaba e bololoke bwesu.’”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.25",
            "verseOrgIds": [
              "DEU.6.25"
            ]
          }
        }
      ]
    }
