        },
        {
          "text": "“Wikalafwaya kulundapo pafyo munonko akongola pa ndalama, ifyakulya nangu pa fintu fimbi ifyo wingamwenapo nga wakongwesha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.19",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwinafyalo ena kuti alundapo pafyo akukongola, nomba umwina Israeli mubiyo ena iyoo, pakuti Yawe Lesa wenu akalemupaala muli fyonse ifyo mukalacita mu calo mwalaingilamo mukucipoka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.20"
            ]
          }
        }
      ]
    },
