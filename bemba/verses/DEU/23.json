        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.29"
              },
              "items": [
                {
                  "text": "Levi 19:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwikalaba umwaume nangu umwanakashi umwina Israeli uwakuba cilende wa ku mfuba.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.17",
            "verseOrgIds": [
              "DEU.23.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23:17",
              "type": "text"
            },
            {
              "text": "cilende wa ku mfuba:",
              "type": "text"
            },
            {
              "text": "Muntu uwasuminishiwe ukucita ubulalelale mu ncende ya mapepo ya milungu yabufi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.17",
            "verseOrgIds": [
              "DEU.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulupiya ulo cilende umwaume nangu umwanakashi akwila telwakwesha kutwala mu ŋanda yakwa Yawe Lesa wenu pakufuta pafyo balaile, pantu Yawe Lesa wenu alibapata bonse babili.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.18"
            ]
          }
        }
      ]
    },
