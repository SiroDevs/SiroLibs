              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nga cakuti mu musumba umwaume akumanya nacisungu uwakobekelwa, elyo asendama nankwe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "bonse babili mukalebatwala pa mpongolo ya musumba no kubalasaula amabwe mpaka bafwa. Pantu umukashana ali mu musumba, kabili tapundile mutuule, nao umwaume pantu aonaula icupo ca mwine. Efyo mufwile ukufumya ububi pakati kenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
      ]
    },
    {
