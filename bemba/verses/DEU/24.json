              "items": [
                {
                  "text": "1 Kol 5:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Nga cakuti umuntu asangwa mukwiba umwina Israeli munankwe no kumucita umusha, nangu ukumushitisha, uwamwibile wakwipayafye. Efyo mufwile ukulapwisha ububi pakati kenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.7",
