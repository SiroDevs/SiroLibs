        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tecakwesha kubuula impelo shonse shibili nangu umwana wa mpelo ukuba icikatilo ca pa nkongole, pantu cimo no kubuula ubumi bwa muntu ukuba icikatilo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
          }
        }
      ]
    },
