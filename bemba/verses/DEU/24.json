                "loc": "JAS.5.4"
              },
              "items": [
                {
                  "text": "Yako 5:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Wikalacenjelela mubomfi uo waingisha incito umulanda kabili uukabila, nangu engaba mwina Israeli mubiyo, nangufye umwinafyalo uwikala mu musumba wenu umo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.14",
            "verseOrgIds": [
              "DEU.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cila bushiku ilyo akasuba takalawa uli nokumulipila, pantu mulanda alekabila ayo malipilo yene. Nga taulemulipila kuti akulilila kuli Yawe, nobe ninshi ukakwatilapo umulandu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        }
      ]
    },
