          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Levi 13:1—14:54\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nga ni pa mulandu wa malwele ya fibashi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "24:8",
              "type": "text"
            },
            {
              "text": "ifibashi:",
              "type": "text"
            },
            {
              "text": "Lishiwi mu Cihibulu balelibomfya pakulondolola amalwele yonse ya nkanda ayambukila.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", mukalesakamana ukulacita ngefyo bashimapepo abena Levi bakulamweba. Mufwile ukukonka bwino ifyo nabakonkomesesha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.10"
              },
              "items": [
                {
                  "text": "Imp 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muleibukisha ifyo Yawe Lesa wenu acitile kuli Miriamu mu nshila ilyo mwafumine mu Egupto.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        }
      ]
    },
    {
