                }
              ]
            }
          ]
        },
        {
          "text": "“Ilyo mulelobolola ifisabo mwibala lyenu, nomba mwalaba umwanshi, mwikabwelelamo kukuya buula. Ifyo fisabo mukalefishila abenafyalo, bakashiwa na bamukamfwilwa pakuti Yawe Lesa wenu akalemupaala mu fintu fyonse ifyo mukalabomba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.19",
            "verseOrgIds": [
              "DEU.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
