                "loc": "MRK.10.4"
              },
              "items": [
                {
                  "text": "Mako 10:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabili Mose atile, “Nga cakuti umwaume aupa umwanakashi uushimusekeshe pantu amonamo kamo akabi, elyo alemba kalata wakumulekelapo, apeela no mwanakashi, amutamfya na mu ŋanda yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili nga cakuti afuma mu ŋanda yakwe aya upwa ku mwaume umbi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.2",
            "verseOrgIds": [
              "DEU.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "no mulume wacibili nao amupata, kabili amulembela na kalata wakumulekelapo, amupeela, amutamfya na mu ŋanda yakwe, nangu nga cakuti uyu mulume wacibili afwa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.3",
            "verseOrgIds": [
              "DEU.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "lyena ninshi umwaume wapakubala uwamutamfishe tasuminishiwe ukumubwesha nakabili. Pantu balimukowesha. Elyo nga amubwesha, cintu cabipa mu menso yakwa Yawe. Mwikalaleta ububifi pa calo Yawe Lesa wenu ali mukumupeela nge cacishilano.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
