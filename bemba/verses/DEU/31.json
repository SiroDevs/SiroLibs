        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.21",
            "verseOrgIds": [
              "DEU.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Mose ubo bwine bushiku epakulemba ulu lwimbo no kulusambilisha ku bena Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.22",
            "verseOrgIds": [
              "DEU.31.22"
            ]
          }
        }
      ]
