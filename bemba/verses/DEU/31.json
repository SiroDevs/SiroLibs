        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Mose asosele amashiwi ya lwimbo ulu ukufuma pakwamba mpaka pa mpela, ninshi ibumba lyonse ilya bena Israeli lilekutika.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.30",
