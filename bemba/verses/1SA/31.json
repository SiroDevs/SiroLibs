                {
                  "text": "2 Sam 1:6-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.10.1+1CH.10.2+1CH.10.3+1CH.10.4+1CH.10.5+1CH.10.6+1CH.10.7+1CH.10.8+1CH.10.9+1CH.10.10+1CH.10.11+1CH.10.12"
              },
              "items": [
                {
                  "text": "1 Imila 10:1-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nomba ilyo Abafilisiti balwile na bena Israeli, abena Israeli balifulumwike. Elyo na bengi babepaile pa lupili lwa Giliboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.1",
            "verseOrgIds": [
              "1SA.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafilisiti bakonkele Saulo pamo na bana bakwe abaume pa maka nganshi. Kabili baipaya abana bakwe Yonatani, Abinadabu na Malikishua. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.2",
            "verseOrgIds": [
              "1SA.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe ubulwi bwabipisha nganshi pali Saulo. Elyo abamata basuka bamusanga no kumucena bubi bubi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.3",
            "verseOrgIds": [
              "1SA.31.3"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.3",
            "verseOrgIds": [
              "1SA.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Saulo aeba kasenda wa fyanso fyakwe ati, “Somona ulupanga lobe umpwishishishe, epali aba bantu abashasembululwa ebo bese banjipaye babikepo no kunseka.” Lelo kasenda wa fyanso aba no mwenso, akaana ukumucita ifyo aebelwe. Kanshi Saulo epakubuula ulupanga lwakwe no kuwilapo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.4",
            "verseOrgIds": [
              "1SA.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo kasenda wa fyanso fyakwe amona ukuti Saulo afwa, nao epakuwila pa lupanga lwakwe no kufwila pamo nankwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.5",
            "verseOrgIds": [
              "1SA.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Saulo, abana bakwe abaume batatu, kasenda wa fyanso fyakwe elyo na bantu bakwe bonse bafwilile pamo muli bulya bwine ubushiku.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.6",
            "verseOrgIds": [
              "1SA.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.6",
            "verseOrgIds": [
              "1SA.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo abena Israeli abali ku lubali lumbi ulwe shika na bonse abalungatene na Yordani bamona ukuti ifita fya bena Israeli fyafulumuka, nokuti Saulo na bana bakwe abaume nabafwa, awe nabo basha imisumba yabo no kufulumuka. Elyo na Bafilisiti baishile no kwamba ukulaikala muli iyi imisumba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.7",
            "verseOrgIds": [
              "1SA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.7",
            "verseOrgIds": [
              "1SA.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubushiku bwakonkelepo, ilyo Abafilisiti baishile kukutapa ifintu ku bafwile, elyo basanga Saulo na bana bakwe batatu abaume nabafwa pa lupili lwa Giliboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.8",
            "verseOrgIds": [
              "1SA.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baputula umutwe wakwa Saulo no kumufuula ifyanso fyakwe elyo batuma intumi mu calo conse ica Bafilisiti mukubila imbila mu matempele ya tulubi twabo, elyo na ku bantu bonse. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.9",
            "verseOrgIds": [
              "1SA.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babika ifyanso fyakwe mwitempele lyakwa Ashitoreti, elyo bapampamina icitumbi cakwe ku cibumba ca Beti Shani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.10",
            "verseOrgIds": [
              "1SA.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba ilyo abantu ba ku Yabeshi Gileadi baumfwile ifyo Abafilisiti bacitile kuli Saulo, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.11",
            "verseOrgIds": [
              "1SA.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "abantu babo bonse ababulamba balimine no kwenda ubushiku bonse ukuya ku Beti Shani. Basenda ifitumbi fyonse ifyakwa Saulo elyo ne fya bana bakwe abaume ukufuma ku cibumba ca Beti Shani no kuya ku Yabeshi, eko baya fyocela. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.12",
            "verseOrgIds": [
              "1SA.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo basendele amafupa yabo no kuya yashiika mwisamba lya cimuti ca Tamarisiki ku Yabeshi. Kabili bafungile ukulya pa nshiku cine lubali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.13",
            "verseOrgIds": [
              "1SA.31.13"
            ]
          }
        }
      ]
    }
  ],
