                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.13.5+1CH.13.6+1CH.13.7"
              },
              "items": [
                {
                  "text": "1 Imila 13:5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo abaume ba ku Kiriati Yarimu baishile no kusenda Imbokoshi ya Cipangano iyakwa Yawe, baleta ku ŋanda yakwa Abinadabu iyabelele pa lupili. Kabili bacita umwana wakwe umwaume Eleasa abe uwapatulwa pakuti alelinda Imbokoshi yakwa Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palipitile inshita iyitali ukulingana ne myaka amakumi yabili (20) yonse pamo, apo Imbokoshi ya Cipangano yaikalile ku Kiriati Yarimu, icalengele na bena Israeli bonse ukulaloosha no kufwaisha ukulakonka Yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Samwele epakusosa ku ba ŋanda yakwa Israeli yonse ati, “Nga cakuti mulebwelela kuli Yawe ne mitima yenu yonse, italusheni ku milungu ya benafyalo na ku ba Ashitoreti, no kuipeelesha mwe bene kuli Yawe no kulamubombela ekafye, lyena nao akamupususha ku minwe ya Bafilisiti.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi abena Israeli epakutaluka ku milungu ba Baali na ba Ashitoreti, no kwamba ukulabombela Yawe eka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Samwele atile, “Longaneni mwe bena Israeli bonse ku Misipa pakuti ine mupapatileko kuli Yawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi abantu bonse epakulongana ku Misipa, batapa na menshi no kwitila panshi ku cinso cakwa Yawe. Na pa bushiku ubo, bafunga ukulya balanda nokuti, “Natubifya kuli Yawe.” Kabili Samwele ewali umupingushi wa bena Israeli ku Misipa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili ilyo Abafilisiti baumfwile ukuti abena Israeli nabalongana ku Misipa, bacilolo ba Bafilisiti balimine no kuya kukubalwisha. Lelo ilyo abena Israeli baumfwile, batiinine nganshi Abafilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.7",
            "verseOrgIds": [
              "1SA.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abena Israeli baebele Samwele abati, “Wileka ukutupapatila kuli Yawe Lesa wesu, pakuti atupusushe ukufuma ku kuboko kwa Bafilisiti.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Samwele abuula akana ka mpaanga akashilasumuka no kukatuula nge lambo lyakoca kuli Yawe. Alilile kuli Yawe, mukupapatilako abena Israeli, elyo Yawe nao amwasuka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nshita ine ilya Samwele acili aletuula ilambo lyakoca kuli Yawe, Abafilisiti bapalama kukulwisha abena Israeli. Lelo pali bulya bushiku, Yawe abulukuta nge mfula kwishiwi ilikalamba no kubafulunganya icakuti bafulumuka ukufuma ku cinso ca bena Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.10",
            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abena Israeli epakufuma mu Misipa no kukunkunika Abafilisiti, baya balebakomaula nshila yonse mpakafye ku mutentemuko wa Beti-Kari. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Samwele abuula ilibwe, alibika pakati ka Misipa na Yeshana, alinika ne shina lya Ebenesa,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:12",
              "type": "text"
            },
            {
              "text": "Ebenesa:",
              "type": "text"
            },
            {
              "text": "Ili shiwi lilepilibula ukuti, “ilibwe lyabwafwilisho.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " elyo atile, “Ukufika na pano Yawe ewatwafwile.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Abafilisiti epakucimba, kabili tababwekeshepo ukufwaya ukupokolola icalo ca bena Israeli nakabili. Elyo na pa nshita ya bumi bwakwa Samwele, ukuboko kwakwa Yawe kwalifye ukwafina pa Bafilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne misumba Abafilisiti bapokolwele ku bena Israeli ukufuma ku Ekironi ukufika ku Gati, yalibweshiwe. Abena Israeli bapokolola ne ncende shabo ishapalamineko ukufuma ku maka ya Bafilisiti. Elyo kwaba umutende pakati ka bena Israeli na bena Amoli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwele atwalilile ngo mupingushi pakati ka bena Israeli mu nshiku shonse isha bumi bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.15",
            "verseOrgIds": [
              "1SA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cila mwaka aleenda ukufuma ku Betele, Giligali na ku Misipa, mukupingula abena Israeli mu ncende shonse ishi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.16",
            "verseOrgIds": [
              "1SA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aleti nga apwisha elyo alebwelelamo ku Rama ukwali iŋanda yakwe, kabili nako kwine alepingula abena Israeli. Elyo akuula no bulambo bwakwa Yawe kulya kwine.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.17",
            "verseOrgIds": [
              "1SA.7.17"
            ]
          }
        }
      ]
    }
  ],
