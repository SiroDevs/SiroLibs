                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili atila nokuti,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
