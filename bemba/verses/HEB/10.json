          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo ifwe tatuli bantu abafutatila kuli Lesa kabili no kuloba baliloba. Ifwe tuli bantu abasumina no kupusuka twalipusuka.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.39",
