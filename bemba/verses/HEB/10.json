            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.25",
            "verseOrgIds": [
              "HEB.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pantu ifwe fwe bapokelela icishinka, nga cakuti ku mufulofye twakonkanyapo ukubifya, awe takwakabe lambo nelyo limo ilyakufumya ifyabubifi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.26",
            "verseOrgIds": [
              "HEB.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.11"
              },
              "items": [
                {
                  "text": "Esaya 26:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awe lyena icikashalakofye, kulolela mwenso mwenso ukupingulwa ukukaba nokwisa no mulilo uukali uukonaula abo abapata Lesa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.27",
            "verseOrgIds": [
              "HEB.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.6"
              },
              "items": [
                {
                  "text": "Amaf 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umuntu onse uwapula Amafunde yakwa Mose, nga bantu babili nangu batatu bapeela bukambone, ninshi kumwipayafye ukwabula uluse. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.28",
            "verseOrgIds": [
              "HEB.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga kanshi ni shani umuntu uwasuula Umwana wakwa Lesa? Ni shani uyo muntu uumona ukuti cafyefye umulopa wa cipangano cakwa Lesa uwamusangulwile ukufuma ku bubifi? Ni shani umuntu uusaalula Mupashi wacikuuku? Kanshi tontonkanyenipo pafyo cikalinga uyu muntu ukukandwa icabipisha! ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.29",
            "verseOrgIds": [
              "HEB.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.35+DEU.32.36"
              },
              "items": [
                {
                  "text": "Amaf 32:35-36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pantu twalishiba uwasosele ati, “Nine nkalandula, nine nkacita umulinganya.” Kabili atila nokuti, “Imfumu eikaputula imilandu ya bantu baiko.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.30",
            "verseOrgIds": [
              "HEB.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala cintu cakutiina icakwikatwa mu minwe yakwa Lesa wamweo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "HEB 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muleibukisha shilya nshiku shakale ilyo mwapokelele ulubuuto. Lyena mwalishangile nganshi no kulwisha na maka nangu mwalecula. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.32",
            "verseOrgIds": [
              "HEB.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "HEB 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Limo limo balemutukaula no kulamucusha pa menso ya bantu, elyo limbi mwaleikumika no kucula pamo nabo balecushiwa mu musango umo wine. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.33",
            "verseOrgIds": [
              "HEB.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "HEB 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalelangulukilako na bali mu cifungo, elyo kabili ilyo balemupokolola ifyuma fyenu, imwe mwalesansamuka, pantu mwalishibe ukuti mwalikwata icintu icicililepo ku busuma, kabili te cakonaika. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.34",
            "verseOrgIds": [
              "HEB.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi mwilafupuka, icilambu mukapoka cikalamba. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.35",
            "verseOrgIds": [
              "HEB.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "HEB 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulekoselela ukucita ifyo Lesa afwaya elyo mukapokelela ifyo alaya. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.36",
            "verseOrgIds": [
              "HEB.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "HEB 10:37"
          },
          "items": [
