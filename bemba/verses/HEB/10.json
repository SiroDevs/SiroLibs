        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amafunde yakwa Mose yalifye icakwishibilako ifintu ifisuma ifyali nokwisa, lelo tayali e fintu fisuma fine iyoo. Eico kanshi amalambo ya mu Mafunde yakwa Mose, ayo baleka cila mwaka tekuti yalenge abantu abesa kukupepa Lesa ukuba abapwililika. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.1",
            "verseOrgIds": [
              "HEB.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pantu abo bantu abesa kukupepa Lesa abalashininkisha ukuti ifyabubifi fyabo nafifuma, nga balileka ukutuula amalambo yonse, ico baleumfwa ukuti tabali na cabubifi nelyo cimo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.2",
            "verseOrgIds": [
              "HEB.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo mukutuula amalambo, cilenga abantu ukwibukisha ifyabubifi fyabo cila mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.3",
            "verseOrgIds": [
              "HEB.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pantu umulopa wa ŋombe ishilume no wa mbushi tekuti ufumye ifyabubifi nakalya, cakaana.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.4",
            "verseOrgIds": [
              "HEB.10.4"
            ]
          }
        }
      ]
    },
    {
