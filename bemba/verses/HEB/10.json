        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mupashi Wamushilo nao ni kambone wesu pali uyu mulandu. Pakubalilapo atila ati,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.15",
            "verseOrgIds": [
              "HEB.10.15"
            ]
          }
        }
      ]
    },
