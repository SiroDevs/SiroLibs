                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.26.23"
              },
              "items": [
                {
                  "text": "2 Imila 26:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mu mwaka imfumu Usia yafwilemo, ine nalimwene Imfumu ine ine iya mu mulu. Yaikele pa cipuna caiko icabufumu icasansama, ninshi ne cakufwala caiko nacikumana mwi Tempele. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mulu waiko ninshi napeminina na Baselafi abalebengeshima, bonse umo umo bali na mapindo mutanda mutanda. Bonse umo umo bafimbile amapindo yabili pa menso yabo, elyo yabili nayo bafimbile amakasa yabo, elyo yambi yabili yena eyakupupukilako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Ubuso 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ninshi balepokanina baleti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
    },
    {
