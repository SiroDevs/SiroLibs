          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ukakilile ubunte ubu, kabili ukonkomeshe amafunde aya mu basambi bandi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.16",
            "verseOrgIds": [
              "ISA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.13"
              },
              "items": [
                {
                  "text": "Bahi 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yawe aliifisa ku ba ŋanda yakwa Yakobo, lelo ine nalimutetekela, no kumulolela ine ndamulolela.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.17",
            "verseOrgIds": [
              "ISA.8.17"
            ]
          }
        }
      ]
    },
