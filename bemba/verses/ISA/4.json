              "type": "text"
            }
          ]
        },
        {
          "text": "Ubo bushiku nga bwafika, abanakashi cine lubali bakasakatila umwaume umo no kulamweba abati,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
