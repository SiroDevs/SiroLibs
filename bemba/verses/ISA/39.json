              "ISA.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekia epakwiluka ukuti pa nshita akakokola pano calo, kanshi ena akulaikalilafye ku matwi tondolo, nao epakwasuka Esaya ati, “Ishiwi lyakwa Yawe ilyo walanda lisuma.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
