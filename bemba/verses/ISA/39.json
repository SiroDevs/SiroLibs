              "items": [
                {
                  "text": "2 Isham 24:10-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Imila 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabili na pali ba mu lupwa lobe, aba mubili no mulopa obe, abo waifyalila we mwine, bakasendapo bamo no kuya bacita bamutungwi abakubombela imfumu ya ku Babiloni kwisano lyaiko.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        }
      ]
    },
