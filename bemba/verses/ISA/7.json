                "loc": "2KI.16.5"
              },
              "items": [
                {
                  "text": "2 Isham 16:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.28.5+2CH.28.6"
              },
              "items": [
                {
                  "text": "2 Imila 28:5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwalibuukile inkondo ilyo imfumu Ahasi aleteeka icalo ca bena Yuda. Ahasi ali ni mwana Yotamu, kabili ali ni mwishikulu Usia. Awe Resini imfumu ya ku Siria, pamo na Peka imfumu ya bena Israeli uwali mwana Remaliya, basansa umusumba wa Yerusalemu, nomba bafilwa ukuucimfya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.1",
            "verseOrgIds": [
              "ISA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo baletele umulandu ku ba ŋanda yakwa Davidi ukutila, “Ifita fya bena Siria nafyampana na bena Efulemu.” Eico imfumu pamo na bantu baiko bonse balitiinine, balaisokonenafye ku mwenso kwati miti ya mu mutengo iyilepukana ku mwela.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.2",
            "verseOrgIds": [
              "ISA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.2",
            "verseOrgIds": [
              "ISA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Yawe aeba Esaya ati, “Buula Sheari Yashubu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.3",
            "verseOrgIds": [
              "ISA.7.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:3",
              "type": "text"
            },
            {
              "text": "Sheari Yashubu mu Cihibulu ekutila, “Abashalako bakabwela.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " umwana obe umwaume, kabiye nankwe, mukumanye Ahasi. Muleya musanga mu musebo, mulekumanina palya bakacapa wa nsalu babombela, pa mpela ya munyangala ulya upitamo amenshi ya mu cishiba cabela pa mulundu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.3",
            "verseOrgIds": [
              "ISA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye mucenjeshako auti, ‘Teka umutima, wilatiina kabili wilasakamana iyoo. Pantu icipyu ca mfumu Resini pamo na bantu baiko abena Siria, ne cipyu ca mfumu Peka, ala teti ficite umuntu nangu cimo. Abo bantu balifye nge cushi icilefutumuka ku tushishi tubili utulefuuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.4",
            "verseOrgIds": [
              "ISA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icalo ca Siria, ne ca Efulemu pamo ne mfumu yaciko Peka, filekupangila. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.5",
            "verseOrgIds": [
              "ISA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filepanga afiti, “Natuye sansa icalo ca Yuda, tutiinye abantu baciko pakuti bawile uko tuli, epakuti tufumye Ahasi pa cipuna cabufumu, tubikepo mwana Tabeli.” ’",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.6",
            "verseOrgIds": [
              "ISA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.6",
            "verseOrgIds": [
              "ISA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lelo Imfumu Yawe nasosa ukuti, ico cintu tacakabale acicitika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.7",
            "verseOrgIds": [
              "ISA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.9",
            "verseOrgIds": [
              "ISA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakabili Yawe alilandile kuli Ahasi ati, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.10",
            "verseOrgIds": [
              "ISA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ipusha Yawe Lesa obe pakuti akulangepo icishibilo cimo. Naco cibe icakosa icashika nga ku mbo atemwa icayafya icalepa nga ku mulu.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.11",
            "verseOrgIds": [
              "ISA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apali Ahasi wena ayasukafye ati, “Awe ndai, ine nshaipushepo cishibilo. Ine nshilefwaya kwesha Yawe.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.12",
            "verseOrgIds": [
              "ISA.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.12",
            "verseOrgIds": [
              "ISA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo nao Esaya aposapo ishiwi ati, “Umfweni imwe mwe ba ŋanda yakwa Davidi. Imwe mwalishiba ukuti ukutendusha abantu, cintu icabipa. Nga nomba cinshi kabili mulefwaila ukutendusha na Lesa wine? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.13",
            "verseOrgIds": [
              "ISA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Yawe umwine ewalamulanga icishibilo cimo. Kukaba umukashana",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.14",
            "verseOrgIds": [
              "ISA.7.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:14",
              "type": "text"
            },
            {
              "text": "umukashana:",
              "type": "text"
            },
            {
              "text": "Mu Baibele wa mu Cigiriki mwalembwa ukuti “umukashana nacisungu”",
              "type": "text"
            }
          ]
        },
        {
          "text": " umo uukaba pabukulu. Nao akafyala umwana umwaume, uo akenika ishina lya Imanueli",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.14",
            "verseOrgIds": [
              "ISA.7.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:14",
              "type": "text"
            },
            {
              "text": "Imanueli:",
              "type": "text"
            },
            {
              "text": "Ekutila, “Lesa twaba nankwe.”",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.14",
            "verseOrgIds": [
              "ISA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akalalya umukaka no buci mpaka ilyo akeshiba ukukaana icibi no kusala icisuma. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.15",
            "verseOrgIds": [
              "ISA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo inshita ya uyu mwana ishilati ifike iyakukaana icibi no kusala icisuma, ninshi ifyalo fya shamfumu shibili ishikutiinya iwe Ahasi fyalishala amatololo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.16",
            "verseOrgIds": [
              "ISA.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.16",
            "verseOrgIds": [
              "ISA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iwe pamo na bantu bobe, kumo kwine no lupwa lobe lonse ulwabufumu, Yawe alaswa amufishe ku nshiku isha macushi, nayo ayashatala ayamoneka ukutula apo ubufumu bwa Efulemu bwapatulukene no bwa Yuda. Alaswa akukuutilile imfumu ya Asiria.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iyo nshita nga yafika, Yawe akalisha umunsoli pakwita abena Egupto, nabo bakesa nga balunshi, bakatula mu milonga iyawila mu mumana wa Nailo. Kabili akalishisha abena Asiria umunsoli, pakuti nabo bakese kubuuba nge nshimu ukutula mu calo cabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.18",
            "verseOrgIds": [
              "ISA.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakesa kupa mu mikonko mu fimabwe, na mu ninga mu fimabwe, bakesa tebelela na mu fimpusa fyonse ifya myunga, no kukupa monse umwakucemena ifitekwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.19",
            "verseOrgIds": [
              "ISA.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.19",
            "verseOrgIds": [
              "ISA.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iyo nshita nga yafika, Yawe akaya kwishilya lya mumana wa Yufurate, kukuya buulako umuntu umo uwaishiba ukubeya, nao e mfumu ya Asiria. Nayo ikesa mubeya imishishi no bupipi pa mibili yenu, ikamubeya ne myefu ine.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.20",
            "verseOrgIds": [
              "ISA.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.20",
            "verseOrgIds": [
              "ISA.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iyo nshita nga yafika, nangu umuntu umo akateekafye iŋombe imo iyikota, ne mpaanga shibili, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.21",
            "verseOrgIds": [
              "ISA.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ifyo fitekwa fikalamuletela umukaka uwingi, icakuti takalekabila kantu. Bonse abakashalamo mu calo bakalanwa umukaka no kulalya ubuci.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.22",
            "verseOrgIds": [
              "ISA.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 7:22"
