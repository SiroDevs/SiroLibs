{
  "id": "JHN.10",
  "number": "10",
  "bookId": "JHN",
  "reference": "Yoani 10",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JHN 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndemweba icine cine, umuntu uushingilila mwicinka lya mpaanga pa mwinshi, lelo aninina pa mbilibili, ninshi mupupu, kabili cipondo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.1",
            "verseOrgIds": [
              "JHN.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwingilila pa mwinshi e kacema wa mpaanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.2",
            "verseOrgIds": [
              "JHN.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalinda alamwiswila iciibi ca pecinka, aingila. Impaanga shilomfwa ishiwi lyakwe ilyo aleita impaanga shakwe mu mashina. Elyo ashifumisha panse. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.3",
            "verseOrgIds": [
              "JHN.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo ashifumisha shonse panse, ashitangilila. Elyo impaanga nasho shalamukonka, pantu shalishiba ishiwi lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.4",
            "verseOrgIds": [
              "JHN.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tashikonka muntu umbi nakalya. Umuntu umbi shilamubutuka, pantu tashishibe ishiwi lyakwe.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.5",
            "verseOrgIds": [
              "JHN.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.5",
            "verseOrgIds": [
              "JHN.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni Yesu wabomine uyu mulumbe. Lelo tabaumfwile umo walolele.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.6",
            "verseOrgIds": [
              "JHN.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.6",
            "verseOrgIds": [
              "JHN.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alabeba nakabili ati, “Ndemweba icine cine, nine mwinshi we cinka lya mpaanga.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.7",
            "verseOrgIds": [
              "JHN.10.7"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.7",
            "verseOrgIds": [
              "JHN.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonse ababalilepo ukwisa bena bapupu kabili fipondo, lelo impaanga tashabomfwile. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.8",
            "verseOrgIds": [
              "JHN.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nine mwinshi. Onse uwingilila pali ine akapusuka. Akalaingila no kufuma apo atemenwe, kabili akulasanga icakulya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.9",
            "verseOrgIds": [
              "JHN.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umupupu teshila cimbi kanofye ukwiba, ukwipaya no konaula. Ine ico naishila ni kukupeela umweo nokuti bakwatishe umweo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.10",
            "verseOrgIds": [
              "JHN.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.10",
            "verseOrgIds": [
              "JHN.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ine ndi kacema musuma. Kacema musuma ni uyo uuleka umweo wakwe pa mpaanga shakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.11",
            "verseOrgIds": [
              "JHN.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwancito, ico tali kacema, kabili te mwine wa mpaanga, ilyo amona umumbulu uleisa, abutuka, asha impaanga sheka. Elyo umumbulu wafukukila impaanga, washisalanganya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.12",
            "verseOrgIds": [
              "JHN.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwancito abutuka ico wancitofye, tasakamene impaanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.13",
            "verseOrgIds": [
              "JHN.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndi kacema musuma. Nalishiba impaanga shandi ne mpaanga shandi nasho shalinjishiba. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.14",
            "verseOrgIds": [
              "JHN.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi nga filya fine Tata anjishiba na ine nalishiba Tata. Eco na ine ndekela umweo wandi pa mpaanga shandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.15",
            "verseOrgIds": [
              "JHN.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalikwata impaanga na shimbi, ishishilati shibe muli lino icinka. Nasho shine ndi nokushiletamo, shili nokumfwa ishiwi lyandi. Epakuti kukabefye umukuni umo na kacema nao umo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.16",
            "verseOrgIds": [
              "JHN.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata alintemwa, pantu ndeleka umweo wandi, elyo nakabili nkaubuule. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.17",
            "verseOrgIds": [
              "JHN.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tapali nelyo umo uulempoka umweo wandi. Awe iyoo, ni ku kutemwafye kwandi ndeleka umweo wandi. Nalikwata amaka yakuulekamo. Nalikwata na maka yakuubuula nakabili. Ici e cebo Tata ampeele.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.18",
            "verseOrgIds": [
              "JHN.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.18",
            "verseOrgIds": [
              "JHN.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe Abayuda nakabili bapusana pa mulandu wa aya mashiwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.19",
            "verseOrgIds": [
              "JHN.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abengi balasosa abati, “Aliba no mupashi wakowela! Alipena! Bushe ewakumfwako?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.20",
            "verseOrgIds": [
              "JHN.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bambi bena balati, “Awe ifi tefilanda umuntu uwaba no mupashi wakowela! Bushe mupashi wakowela kuti waposha ubupofu?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.21",
            "verseOrgIds": [
              "JHN.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.21",
            "verseOrgIds": [
              "JHN.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cali mu nshita yamibundo. Ku Yerusalemu kwali Inshikunkulu yakwibukisha Ukusangululwa kwe Tempele",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.22",
            "verseOrgIds": [
              "JHN.10.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:22",
              "type": "text"
            },
            {
              "text": "Ukusangululwa kwe Tempele:",
              "type": "text"
            },
            {
              "text": "Mu mweshi walenga pabula ukutampa pa bushiku bwalenga amakumi yabili na busano cila mwaka Abayuda baleibukisha ifyo Yuda Makabe asangulwile cipya cipya ubulambo bwa mwi Temple lyakwa Lesa mu Yerusalemu mu mwaka 165 BC (imyaka umwanda umo na makumi mutanda na isano ilyo Yesu talafyalwa). Baposele inshiku cine konse konse pakusefya iyi nshikunkulu.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.22",
            "verseOrgIds": [
              "JHN.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aletandala mu ncende ye Tempele, iyo baleti, “Lukungu lwakwa Solomoni.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.23",
            "verseOrgIds": [
              "JHN.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayuda baisa mushinguluka balamweba abati, “Bushe ukaleka lilali ukutumika imitima? Nga niwe Kristu, twebe, twishibe!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.24",
            "verseOrgIds": [
              "JHN.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abasuka ati, “Nalimweba, nomba tamusumina. Imilimo momba ku maka yakwa Tata einjebela. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.25",
            "verseOrgIds": [
              "JHN.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba imwe tamusumina, ico mushili mpaanga shandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.26",
            "verseOrgIds": [
              "JHN.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impaanga shandi shilomfwa ishiwi lyandi. Nalishishiba, nasho shilankonka. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.27",
            "verseOrgIds": [
              "JHN.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndashipeela umweo wape, kabili tashakalobe nakalya. Takwakabe nelyo umo uwakushifyombotola mu minwe yandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.28",
            "verseOrgIds": [
              "JHN.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata uwashimpeela, wa maka ukucila bonse. Teti pabe nelyo umo uwakushifyombotola mu minwe yakwa Tata. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.29",
            "verseOrgIds": [
              "JHN.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata na ine twabafye umo.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.30",
            "verseOrgIds": [
              "JHN.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.30",
            "verseOrgIds": [
              "JHN.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Abayuda batola amabwe balafwaya ukumulasa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.31",
            "verseOrgIds": [
              "JHN.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu epakubeba ati, “Mwalimona imilimo ikankala iyingi iyo Tata ampeela ukubomba. Bushe mulimo nshi pali iyi uo mulefwailapo ukundasa amabwe?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.32",
            "verseOrgIds": [
              "JHN.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.16"
              },
              "items": [
                {
                  "text": "Levi 24:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abayuda bamwasuka abati, “Tatulefwaya kukulasa amabwe pa milimo isuma ubomba, lelo ni pa musaalula obe kuli Lesa. Pantu iwe we muntufye niwe uleitunga ukuba Lesa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.33",
            "verseOrgIds": [
              "JHN.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.82.6"
              },
              "items": [
                {
                  "text": "Amalu 82:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu abasuka ati, “Bushe tacalembwa mu Mafunde yakwa Mose ukuti, ‘Lesa atila, muli milungu?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.34",
            "verseOrgIds": [
              "JHN.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga kanshi apo Lesa aeba aba bantu abo ishiwi lyakwe lyafikileko ukuti muli milungu, elyo Amalembo Yamushilo tayali yakutwishika. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.35",
            "verseOrgIds": [
              "JHN.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga ine neo Tata aisalila umwine, antuma na pano isonde, bushe nine mwingatila amuti, asaalula Lesa, ico nasosa ukuti, ‘Ndi Mwana Lesa?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.36",
            "verseOrgIds": [
              "JHN.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwilansumina kumfwa nga nshilebomba milimo yakwa Tata. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.37",
            "verseOrgIds": [
              "JHN.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo nga ndabomba imilimo yakwa Tata, ninshi nangu mushinsumine, sumineni kanshi mu milimo momba. Mushininkishe nokuti Tata aba muli ine na ine naba muli Tata.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.38",
            "verseOrgIds": [
              "JHN.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakabili balafwaya ukumwikata, nomba abapusumuka.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.39",
            "verseOrgIds": [
              "JHN.10.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.39",
            "verseOrgIds": [
              "JHN.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Yesu ayabukila kwishilya lya mumana wa Yordani, kulya kwine Yoani atampile ukulabatisha eko aya ikala. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.40",
            "verseOrgIds": [
              "JHN.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abengi balaisa uko ali. Balasosa abati, “Yoani kwena tabalile acita icishibilo, lelo fyonse ifyo asosele pali uyu muntu fyacishinka.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.41",
            "verseOrgIds": [
              "JHN.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe na bengi bamusumina.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.42",
            "verseOrgIds": [
              "JHN.10.42"
            ]
          }
        }
      ]
    }
  ],
