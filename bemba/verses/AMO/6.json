              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ŋanda imo nga mukashalamo abaume ikumi limo (10), ala nabo bene bakafwa bonse. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
            "verseOrgIds": [
              "AMO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wa mu lupwa lwa bantu abafwile, akalati nga aisa mu ŋanda kukubuula icitumbi ca muntu wakwe uufwile, pakuti aye acoce, elyo akalaipusha onsefye uukabelamamo ati, “Bushe kucili na bambi abali umo?” Uyo muntu uubelememo nga ayasuka ati, “Awe.” Elyo kabili akatila, “Iwe talalafye tondolo. Ala twilalumbula ishina lyakwa Yawe.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        }
      ]
    },
