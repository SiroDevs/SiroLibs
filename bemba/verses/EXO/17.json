                "loc": "EXO.14.12"
              },
              "items": [
                {
                  "text": "Ukuf 14:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.3"
              },
              "items": [
                {
                  "text": "16:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nomba abantu baiketwe ne cilaka nganshi kulya, kanshi balailishanya na kuli Mose abati, “Cinshi watufumishe mu Egupto? Bushe ni kukwisa twipaila pamo na bana besu ne fitekwa fyesu ku cilaka?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.3",
            "verseOrgIds": [
              "EXO.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.3",
            "verseOrgIds": [
              "EXO.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Mose akuuta kuli Yawe ati, “Bushe ncite shani naba bantu? Aba bantu balantoba amabwe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.4",
            "verseOrgIds": [
              "EXO.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.4",
            "verseOrgIds": [
              "EXO.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe aebele Mose ati, “Tangilila abantu. Usendepo na bakalamba ba mu bena Israeli bamo, kabili usende mu minwe yobe ne nkonto ilya waumine pa mumana wa Nailo elyo uleya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.5",
            "verseOrgIds": [
              "EXO.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ine ndeiminina ku ntanshi yobe pa cilibwe ca Holebu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.6",
            "verseOrgIds": [
              "EXO.17.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:6",
              "type": "text"
            },
            {
              "text": "Holebu:",
              "type": "text"
            },
            {
              "text": "E shina limbi ilya lupili lwa Sinai, ulupili lwakwa Lesa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ume mu cilibwe, na menshi yakuti abantu banwe yalefumamo.” Awe Mose nao acita ifyo fine ilyo abakalamba ba bena Israeli balemonako.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.6",
            "verseOrgIds": [
              "EXO.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.6",
            "verseOrgIds": [
              "EXO.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ainike pa ncende palya Masaya na Meriba ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:7",
              "type": "text"
            },
            {
              "text": "Masaya na Meriba:",
              "type": "text"
            },
            {
              "text": "Mu Cihibulu “Masaya” ipilibula ukwesha, “Meriba” nayo ipilibula ukuilishanya.",
              "type": "text"
            }
          ]
        },
        {
          "text": " pantu palya epo abana bakwa Israeli bailishenye, kabili epo baeseshe Yawe ilyo batile, “Bushe Yawe aba na ifwe nangu iyoo?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abena Amaleki baishile ku Refidimu kukulwisha abena Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.8",
            "verseOrgIds": [
              "EXO.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose aebele Yoshua ati, “Salapo abaume bamo abakuti mukaye nabo kukulwa na bena Amaleki. Na ine mailo nkaya iminina pa lupili ninjikata inkonto yakwa Lesa mu minwe yandi.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.9",
            "verseOrgIds": [
              "EXO.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Yoshua nao acitile ifyo Mose amukonkomeshe, alwisha na bena Amaleki. Mose, Aroni na Huri nabo banina pa mulu wa lupili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.10",
            "verseOrgIds": [
              "EXO.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba Mose alati nga aimya amaboko yakwe mumulu, abena Israeli balacimfya abena Amaleki. Elyo nga aponya amaboko yakwe, abena Amaleki nabo ninshi balacimfya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.11",
            "verseOrgIds": [
              "EXO.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo amaboko yakwa Mose yanaka, Aroni na Huri babuula ilibwe balibika apo ali, epo aikala. Elyo baimya amaboko yakwe umo lubali lumo umbi lubali lubiye. Kanshi amaboko yakwe yashele ifyo fine mpaka akasuba kasuka kawa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.12",
            "verseOrgIds": [
              "EXO.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi efyo Yoshua acimfishe abena Amaleki ku lupanga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.13",
            "verseOrgIds": [
              "EXO.17.13"
            ]
          }
        }
      ]
    },
