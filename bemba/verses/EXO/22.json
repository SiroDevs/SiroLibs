          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22:26",
              "type": "text"
            },
            {
              "text": "Icakufimbana:",
              "type": "text"
            },
            {
              "text": "Ekutila icakufwala ico balefwala pa mulu wa mwingila, ubushiku balecibomfya na kukufimbana.",
              "type": "text"
            }
          ]
        },
        {
          "text": " pakuti cibe e cikatila umulandu, ufwile ukumubwesesha ilintu akasuba takalati kawe, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
              "EXO.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "pantu e cakufimbana akwatafye. Cinshi cimbi engafimbana pakulala? Ilyo akuuta kuli ine nkomfwa pantu ndi waluse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.27",
            "verseOrgIds": [
              "EXO.22.27"
            ]
          }
        }
