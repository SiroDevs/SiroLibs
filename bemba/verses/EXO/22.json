            "number": "6",
            "style": "v",
            "sid": "EXO 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.6",
            "verseOrgIds": [
              "EXO.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
