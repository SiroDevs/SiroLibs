    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nga cakuti umuntu aiba iŋombe nangu impaanga, elyo aipaya nangu aishitisha, afwile ukufutilapo iŋombe shisano pa ŋombe imo, ne mpaanga shine pa mpaanga imo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.1",
            "verseOrgIds": [
              "EXO.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.1",
            "verseOrgIds": [
              "EXO.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nga cakuti umupupu asangwa aletoba iŋanda elyo uwamusanga amupuma mpaka afwa, uwamwipaya tafwile kupeelwa mulandu wamisoka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.2",
            "verseOrgIds": [
              "EXO.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo nga cakuti amwipaya ilyo akasuba katula, lyena akaba wamisoka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umupupu afwile ukufuta pafyo ebile. Lelo nga cakuti takwete ifyakufuta, afwile ukushitishiwa pakulipila pafyo aibile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nga cakuti icitekwa ebile casangwa ukuti acili naco icabula ukufwa, nga ni ŋombe nangu punda nangu impaanga, afwile ukufutilapo inama shibili.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.4",
            "verseOrgIds": [
              "EXO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.4",
            "verseOrgIds": [
              "EXO.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nga cakuti umuntu alecemena ifitekwa fyakwe mu cilime nangu mwibala lya myangashi, nomba aleka fyafumamo fyaya lya mwibala lya mwine, uyo muntu afwile ukufutilapo ifisabo ifyawamisha pa fya mu cilime cakwe nangu pa fya mwibala lyakwe ilya myangashi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.5",
            "verseOrgIds": [
              "EXO.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.5",
            "verseOrgIds": [
              "EXO.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nga cakuti umuntu aoca umulilo nomba waya ulepya mu mpanga, waoca ne ŋanu batutila nangu isho bashilaseepa nangu ibala lyonse, uyo uocele umulilo afwile ukufutilapo fyonse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.6",
            "verseOrgIds": [
              "EXO.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
