                "loc": "DEU.24.10+DEU.24.11+DEU.24.12+DEU.24.13"
              },
              "items": [
                {
                  "text": "Amaf 24:10-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nga cakuti wapoka umubiyo icakufimbana",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
              "EXO.22.26"
            ]
          }
        },
        {
          "name": "note",
