            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.28"
              },
              "items": [
                {
                  "text": "Amaf 22:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.29"
              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Nga cakuti umwaume asembeleka umukashana nacisungu uushilakobekelwa no kusendama nankwe, afwile ukulipila impango elyo no kumuupa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo nga cakuti wishi wa mukashana akaanininafye ukuti amuupe, lyena uyo muntu afwile ukulipilafye impango balipila pali nacisungu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        }
      ]
    },
