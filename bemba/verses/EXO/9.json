          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imfula yacitalawe iya mabwe yaonawile utumiti twa kolokondwe ne mbuto sha bale, pantu bale alitwele, na kolokondwe nao alibalwile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.31",
            "verseOrgIds": [
              "EXO.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo iŋanu na masaka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
            "verseOrgIds": [
              "EXO.9.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:32",
              "type": "text"
            },
            {
              "text": "Amasaka:",
              "type": "text"
            },
            {
              "text": "Mu Cihibulu muleti, “imbuto isha sipeliti,” umusango umbi uwa ŋanu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " fyena tafyaonaike pantu tafipakula bwangu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
            "verseOrgIds": [
              "EXO.9.32"
            ]
          }
        }
