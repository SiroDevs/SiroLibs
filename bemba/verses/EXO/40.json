          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba ikumbi nga talifuminepo tabaleima no kulaya mpakafye no bushiku likafumapo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.37",
            "verseOrgIds": [
              "EXO.40.37"
            ]
          }
        },
