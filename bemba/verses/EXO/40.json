            }
          ]
        },
        {
          "text": "Abena Israeli mu nyendo shabo shonse, ilyo ikumbi lyalefuma pe Tenti lyakwa Lesa elyo baleima nokulaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.36",
