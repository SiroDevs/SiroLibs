            }
          ]
        },
        {
          "text": "Abika no musambilo pakati, uku ubulambo elyo uku Itenti Lyakukumaninamo. Abikamo na menshi yakusamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.30",
