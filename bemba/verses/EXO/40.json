            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abika no bulambo bwa golide wine wine mwi Tenti Lyakukumaninamo lwa pantanshi ya cisalu cakucingako. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.26",
            "verseOrgIds": [
              "EXO.40.26"
            ]
          }
        },
