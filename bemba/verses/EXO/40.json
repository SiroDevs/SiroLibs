            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abikile ne cakutekapo ifisaniko mwi Tenti Lyakukumaninamo, ukulungatana ne tebulo lubali lwa ku kapinda ka ku kulyo kwe Tenti lyakwa Lesa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.24",
