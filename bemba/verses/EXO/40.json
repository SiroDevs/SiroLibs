          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili Mose abika ne tebulo mwi Tenti Lyakukumaninamo, lubali lwa ku kapinda ka ku kuso kwe Tenti lyakwa Lesa, kunse ya cisalu cakucingako. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.22",
            "verseOrgIds": [
              "EXO.40.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abikapo ne mikate yakuba pa cinso cakwa Yawe, ngefyo Yawe akonkomeshe Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.23",
            "verseOrgIds": [
              "EXO.40.23"
            ]
          }
        },
