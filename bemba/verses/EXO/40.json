          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abikapo ne fisaniko pa cinso cakwa Yawe, ngefyo Yawe akonkomeshe Mose.",
          "type": "text",
          "attrs": {
