              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lyonse pakwingila mwi Tenti Lyakukumaninamo na pakupalama ku bulambo baletala basamba, ngefyo Yawe akonkomeshe Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.32",
