          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana baume bakwa Kora bali ni Ashili, Elikana na Abiasafu. Aba e bakalamba ba ndupwa sha mu mukowa wakwa Kora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.24",
            "verseOrgIds": [
              "EXO.6.24"
            ]
          }
        },
        {
