              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni aba bene Mose na Aroni ebo Yawe aebele ati, “Kafumyeni indupwa shonse ne mikowa yonse iya bena Israeli mu Egupto mu mpuka shabo.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.26",
            "verseOrgIds": [
              "EXO.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni Mose na Aroni ebaebele Farao imfumu ya Egupto ukuti ileke abena Israeli bafume mu Egupto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.27",
