          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleasa, mwana Aroni, aupile umwana mwanakashi umo uwakwa Putieli. Afyelemo na Fineasi. Aba e bakalamba ba ndupwa sha mu luko lwakwa Levi, ukukonka umo bafyalilwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.25",
            "verseOrgIds": [
              "EXO.6.25"
            ]
          }
        }
      ]
