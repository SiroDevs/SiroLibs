              "type": "text"
            }
          ]
        },
        {
          "text": "Mose alongenye ulukuta lonse ulwa bena Israeli pamo, abeba ati, “Ifi efyo Yawe amukonkomesha ukulacita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.1",
            "verseOrgIds": [
              "EXO.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
