                "loc": "EXO.23.12"
              },
              "items": [
                {
                  "text": "Ukuf 23:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.31.12+EXO.31.13+EXO.31.14+EXO.31.15+EXO.31.16+EXO.31.17"
