          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bapangile akalilata ka golide wine wine akamushilo, bafukwilepo ne filembo nga pa cifwatiko ukuti, “Uwamushilo kuli Yawe” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.30",
            "verseOrgIds": [
              "EXO.39.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 39:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bakakakile ku katambo kacifufya no kukekasha ku nsalu yakupomba ku mutwe, ngefyo Yawe akonkomeshe Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.31",
            "verseOrgIds": [
              "EXO.39.31"
            ]
          }
        }
      ]
