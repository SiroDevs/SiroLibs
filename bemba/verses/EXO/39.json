          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nsalu yakupomba ku mutwe, ifisote fya nsalu ishabuuta ubusaka, pamo na bakaputula bamukati ku nsalu iyabuuta iyapikulwa ubusaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.28",
