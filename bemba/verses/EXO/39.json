          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilamba lyapikwilwe ku nsalu iyabuuta iyapikulwa ubusaka na ku bushishi bwacifufya, ubwakashikila no bwakashika cee, ngefyo Yawe akonkomeshe Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.29",
            "verseOrgIds": [
              "EXO.39.29"
            ]
          }
        }
