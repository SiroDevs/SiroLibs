          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi imilimo yonse iyakupanga Itenti lyakwa Lesa ilyakukumaninamo yalipwile. Abena Israeli bacitilefye fyonse ukulingana ngefyo Yawe akonkomeshe Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 39:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili baletele kuli Mose Itenti lyakwa Lesa, itenti line pamo ne fibombelo fyaliko fyonse, imikofyo yaliko yonse, impanda, imyalo, inceshi no twakwimikamo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.33",
            "verseOrgIds": [
              "EXO.39.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 39:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "icakufimba pe tenti ica mpapa sha basukusuku ishatumpwa mu muti uwakashika, ne ca mpapa ishisuma ishatelela, elyo ne cisalu ca pa mwinshi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.34",
            "verseOrgIds": [
              "EXO.39.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 39:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbokoshi ya Cipangano, ifimuti fyakupingilako fyaiko ne Nkupiko yaiko apakufutilwa ifyabubifi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.35",
            "verseOrgIds": [
              "EXO.39.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 39:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "itebulo ne fibombelo fyaliko fyonse elyo ne mikate yakuba pa cinso cakwa Lesa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.36",
            "verseOrgIds": [
              "EXO.39.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 39:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "icakutekapo ifisaniko ica golide wine wine ne fisaniko fyaciko, ifibombelo fyaciko fyonse elyo na mafuta yakusanika, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.37",
            "verseOrgIds": [
              "EXO.39.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 39:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubulambo bwa golide, amafuta yakusuba, ububani ubwanunka ubusaka elyo ne cisalu ca pa mwinshi we Tenti, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.38",
            "verseOrgIds": [
              "EXO.39.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 39:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubulambo bwa mukuba ne cafipunda ngo lunyungo cabuko ica mukuba, ifimuti fyakubupingilako ne fibombelo fyabuko fyonse, umusambilo elyo ne cakuutekapo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.39",
            "verseOrgIds": [
              "EXO.39.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 39:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "insalu sha ku lupango lwa lubansa, inceshi shaluko ne fyakushimikamo, icisalu ca pa mwinshi wa lupango lwa lubansa, imyando ne mpopo sha ku lupango lwa lubansa, elyo ne fintu fyonse ifyakubomfya mwi Tenti lyakwa Lesa, Itenti lyakukumaninamo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.40",
            "verseOrgIds": [
              "EXO.39.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 39:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "insalu ishapikulwa ubusaka shakufwala pakubomba mu Muputule wamushilo, pamo pene ne nsalu shamushilo ishakwa Aroni shimapepo ne sha bana bakwe abaume, ishakubombelamo umulimo wa bushimapepo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.41",
            "verseOrgIds": [
              "EXO.39.41"
            ]
          }
        }
      ]
