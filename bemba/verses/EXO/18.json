        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.26",
            "verseOrgIds": [
              "EXO.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
