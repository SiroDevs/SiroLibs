              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuli silifa uwashelepo uwafinine amashekeli ikana limo imyanda cine lubali na makumi cine lubali na yasano (1,775)",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.28",
