                  "text": "Mateo 17:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umuntu apeele indalama beka umo, ekutila citika we shekeli",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.26",
            "verseOrgIds": [
              "EXO.38.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
