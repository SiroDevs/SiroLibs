          "items": [
            {
              "text": "38:25",
              "type": "text"
            },
            {
              "text": "Silifa uyu afinine amakilo amakana yatatu ne myanda ine na makumi yatatu (3,430 kg).",
              "type": "text"
            }
          ]
        },
        {
          "text": " ukulingana ne cipimo ca mu cifulo camushilo. ",
          "type": "text",
