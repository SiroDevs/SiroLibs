              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Besaleli abomfeshe silifa uwafina amatalanta umwanda umo (100) pakwenga utwakwimikamo inceshi umwanda umo isha cifulo camushilo ne sha ku cisalu cakucinga. Ku kakwimikamo kamo alebomfya silifa uwafina italanta limo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.27",
            "verseOrgIds": [
              "EXO.38.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
