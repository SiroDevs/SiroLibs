              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abomfeshe umukuba kukupanga utwakwimikamo inceshi sha ku mwinshi we Tenti Lyakukumaninamo no bulambo bwa mukuba, icafipunda ngo lunyungo ica ku bulambo ica mukuba ne fibombelo fya ku bulambo fyonse, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.30",
            "verseOrgIds": [
              "EXO.38.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
