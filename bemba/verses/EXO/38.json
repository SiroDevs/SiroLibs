            "caller": "#"
          },
          "items": [
            {
              "text": "38:27",
              "type": "text"
            },
            {
              "text": "Italanta limo:",
              "type": "text"
            },
            {
              "text": "Ecafinine amakilo amakumi yatatu na yane (34 kg).",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.27",
            "verseOrgIds": [
              "EXO.38.27"
            ]
          }
        },
        {
