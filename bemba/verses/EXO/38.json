          },
          "items": [
            {
              "text": "38:28",
              "type": "text"
            },
            {
              "text": "Amashekeli 1,775:",
              "type": "text"
            },
            {
              "text": "Efyafinine mupepi na makilo amakumi yabili (20kg).",
              "type": "text"
            }
          ]
        },
        {
          "text": " apangileko imikofyo ya ku nceshi, alambatikeko na pa mulu wa nceshi, kabili apangileko no tufyela twa ku nceshi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.28",
            "verseOrgIds": [
              "EXO.38.28"
            ]
