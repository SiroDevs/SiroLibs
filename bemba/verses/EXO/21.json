          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nga cakuti umuntu auma umusha wakwe umwaume nangu umwanakashi pa linso nalyo lyatulika, afwile ukuleka umusha abe umuntungwa pakumufuta pa linso lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.26",
            "verseOrgIds": [
              "EXO.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo nga akuula ilino lya musha wakwe umwaume nangu umwanakashi, afwile ukuleka umusha abe umuntungwa pakumufuta pa lino lyakwe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        }
