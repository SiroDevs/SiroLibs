          ]
        },
        {
          "text": "ilinso pa linso, ilino pa lino, ukuboko pa kuboko, ulukasa pa lukasa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.24",
            "verseOrgIds": [
