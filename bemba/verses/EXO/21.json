                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Uyo onse uwauma umuntu no kumwipaya, nao wine ali nokufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.12",
            "verseOrgIds": [
