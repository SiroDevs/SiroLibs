          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nga cakuti abaume abalelwa bapunka umwanakashi uuli pa bukulu ne fumo lyapona, lelo tacenekwe, ninshi ulya amupunkile afwile afuta fyonse ifyo umulume apingula ne cilye nga casuminisha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.22",
            "verseOrgIds": [
              "EXO.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo umwanakashi nga nacenekwa lyena ubupingushi ninshi bumi pa bumi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.23",
            "verseOrgIds": [
              "EXO.21.23"
            ]
          }
        },
