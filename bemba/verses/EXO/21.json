                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lelo nga tacipanga ukumwipaya, nomba Lesa ewalenga ukuti cicitike, ninshi ali nokufulumukila ku ncende uko ine nkasonta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo umuntu nga apangila umunankwe no kumwipaya ku mumbo, ninshi mufumyenifye na ku bulambo bwandi no kumwipaya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
      ]
