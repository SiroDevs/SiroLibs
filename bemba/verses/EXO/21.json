              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya e mafunde yakuti ubebe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.1",
            "verseOrgIds": [
              "EXO.21.1"
            ]
          }
        },
        {
