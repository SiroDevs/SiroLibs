              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nga cakuti iŋombe ilume nga yatunkula umuntu umwaume nangu umwanakashi ku nsengo no kufwa afwa, iyo ŋombe ifwile ukulaswa amabwe mpaka yafwa, kabili teyakulyako inama yaiko. Lelo umwine wa iyo ŋombe ilume tafwile kupeelwa mulandu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.28",
            "verseOrgIds": [
              "EXO.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba nga cakuti iyo ŋombe ilatunkula abantu ku nsengo, kabili no mwine wa ŋombe balimusokapo, lelo tasakamana kulaisungila mwitanga, elyo yaipaya umwaume nangu umwanakashi, iyo ŋombe ifwile ukulaswa amabwe mpaka yasuka yafwa, no mwine wa ŋombe wine afwile ukwipaiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.29",
            "verseOrgIds": [
              "EXO.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba nga cakuti bamweba ukuti kupeela icifuta mulandu pakuti alubule umweo wakwe, lyena afwile ukupeela fyonse ifyo bamupingula. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.30",
            "verseOrgIds": [
              "EXO.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ili funde limo line lili nokukonkwa nga cakuti iŋombe yatunkula ku nsengo umulumendo nangu umukashana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.31",
            "verseOrgIds": [
              "EXO.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga cakuti iŋombe ilume yatunkula ku nsengo umusha umwaume nangu umwanakashi, umwine wa ŋombe afwile ukufuta umwine wa musha indalama sha mashekeli ya silifa amakumi yatatu (30), ne ŋombe ifwile ukulaswa amabwe mpaka yafwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.32",
            "verseOrgIds": [
              "EXO.21.32"
            ]
          }
        }
      ]
    },
