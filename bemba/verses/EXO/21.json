          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nga cakuti umuntu auma umusha wakwe umwaume nangu umwanakashi ku nkonto, no kufwa afwa apopene, uyo muntu afwile ukukandwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.20",
            "verseOrgIds": [
              "EXO.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba nga cakuti papita ubushiku bumo nangu shibili umusha tafwile ninshi umwine wa musha tafwile kukandwa, pantu umusha cuma cakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
            "verseOrgIds": [
              "EXO.21.21"
            ]
          }
        }
      ]
    },
