            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abantu nga baleumana elyo umo atoba umunankwe ilibwe nelyo amuma ikofi nomba tafwile lelo aba wakulalafye pa musengele, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.18",
