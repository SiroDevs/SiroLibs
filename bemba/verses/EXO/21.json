          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nga cakuti umuntu asha icilindi icacenama nangu aimba icilindi elyo acisha icacenama, elyo mwawila iŋombe nangu punda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
              "EXO.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "umwine wa cilindi afwile ukufuta pa citekwa. Afwile ukufuta umwine wa citekwa indalama, elyo nao asende inama iyafwa ibe yakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
            "verseOrgIds": [
              "EXO.21.34"
            ]
          }
        }
