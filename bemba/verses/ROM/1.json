            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.12",
            "verseOrgIds": [
              "ROM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.13",
            "verseOrgIds": [
              "ROM.1.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.21"
              },
              "items": [
                {
                  "text": "Imili 19:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamunyinane, ndefwaya mwishibe ukuti, ala imikufye iyingi napanga ukwisa mupempula, lelo ukufika na ndakai kulaba fimo ifyakundesha. Ndefwaya na kuli imwe mwe bena Roma nkamwenepo na bambi abakunakila Kristu, nga filya nacita ku Benafyalo bambi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.13",
            "verseOrgIds": [
              "ROM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pantu ine ndi nokubombela abantu bonse, umuntungwa no ushili muntungwa, uwasambilila no ushasambilila. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.14",
            "verseOrgIds": [
              "ROM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi ndefwaisha nganshi ukwisa bila Imbila Nsuma na kuli imwe, mwe bena Roma.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.15",
            "verseOrgIds": [
              "ROM.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
