              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Davidi aeba inkombe ati, “Eba Yoabu utile, ‘Ici, ciikusakamika, ulupanga lwena lwipaya uyu elyo noyu wine. Ikatishafye ukulwisha umusumba no kuonaula. Umwebe Yoabu ifi pakumukoselesha.’”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.25",
            "verseOrgIds": [
              "2SA.11.25"
            ]
          }
