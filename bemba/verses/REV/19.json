                "loc": "PSA.115.13"
              },
              "items": [
                {
                  "text": "Amalu 115:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ku cipuna ca Mfumu kwafuma ishiwi aliti,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.8",
            "verseOrgIds": [
              "REV.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo malaika anjeba ati, “Lemba utile ‘Balishuka abo baitwa ku mitebeto ya bwinga bwa Mwana wa Mpanga!’” Malaika atila nokuti, “Aya mashiwi yakwa Lesa cine cinefye.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.9",
            "verseOrgIds": [
              "REV.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo namufukamina ukuti mupepe, lelo anjeba ati, “Awe wicita ifyo! Ndifye mubomfi mubiyo nga bamunonko bonse abeminina bukambone palwakwa Yesu. Ulepepafye Lesa. Pantu amashiwi ya bukambone bwakwa Yesu e mupashi wa bakasesema.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.10",
            "verseOrgIds": [
              "REV.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.10",
            "verseOrgIds": [
              "REV.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili namona umulu wacenama, namona na kabalwe uwabuuta. Uunininepo ishina lyakwe ni Mucetekelwa kabili Cishinka. Ni mu mulinganya apingula no kuya mu bulwi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.11",
            "verseOrgIds": [
              "REV.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.6"
              },
              "items": [
                {
                  "text": "Dan 10:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amenso yakwe yaba kwati lubingu lwa mulilo. Kabili ku mutwe wakwe afwala ifisote fyabufumu ifingi. Alilembwapo ne shina ilyo muntu nelyo umo ashaishiba, kanofye umwine eka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.12",
            "verseOrgIds": [
              "REV.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afwele umwingila uwatumpwa mu mulopa. Ishina lyakwe batila, “Lishiwi lyakwa Lesa.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.13",
            "verseOrgIds": [
              "REV.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifita fya mu mulu nafimukonka, fininine pali bakabalwe ababuuta, fifwele ne nsalu ishabusaka, ishabuuta tuutu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.14",
            "verseOrgIds": [
              "REV.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.9"
              },
              "items": [
                {
                  "text": "Amalu 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.63.3"
              },
              "items": [
                {
                  "text": "Esaya 63:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.13"
              },
              "items": [
                {
                  "text": "Yoeli 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.20"
              },
              "items": [
                {
                  "text": "Ubuso 14:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo mu kanwa kakwe mwafuma ulupanga ulwatwa ulwakucimfishako imishobo. Akabateeka ne nkonto ya cela mu minwe. Akanyantaula na mu cakukaminamo umwangashi wa bukali bwakwa Lesa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.15",
            "verseOrgIds": [
              "REV.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mwingila wakwe na petanta lyakwe palembelwe ishina ilyakuti,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
