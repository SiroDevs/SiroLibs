            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lembela malaika wa lukuta lwa mu Laodikea ukuti,",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.14",
            "verseOrgIds": [
              "REV.3.14"
            ]
          }
        }
