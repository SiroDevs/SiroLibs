                "loc": "JOB.12.14"
              },
              "items": [
                {
                  "text": "Yobo 12:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Lembela malaika wa lukuta lwa mu Filadelfia ukuti,",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.7",
            "verseOrgIds": [
              "REV.3.7"
            ]
          }
        }
