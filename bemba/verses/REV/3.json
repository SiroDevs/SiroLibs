          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uuli na matwi, kanshi nakutike kufyo Mupashi alesosa ku nkuta.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.6",
            "verseOrgIds": [
              "REV.3.6"
            ]
          }
        }
