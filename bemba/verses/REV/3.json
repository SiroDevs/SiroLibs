            "sid": "REV 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.21",
            "verseOrgIds": [
              "REV.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uuli na matwi, kanshi nakutike kufyo Mupashi alesosa ku nkuta.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.22",
            "verseOrgIds": [
              "REV.3.22"
            ]
          }
