              },
              "items": [
                {
                  "text": "98:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo ifyamweo na bakalamba balaimba ulwimbo lupya abati,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        }
