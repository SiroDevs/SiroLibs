                "loc": "EZK.2.9+EZK.2.10"
              },
              "items": [
                {
                  "text": "Esek 2:9-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.11"
              },
              "items": [
                {
                  "text": "Esaya 29:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo namwene icitabo icapombwa mu minwe ya kuboko kwa kulyo kwa waikele pa cipuna ca Mfumu. Ico citabo calembelwe mukati na kunse. Kabili pakucifunga cakambatikilwepo inamba cine lubali. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.1",
            "verseOrgIds": [
              "REV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo namwene malaika uwamaka alebilikisha ne shiwi ilikalamba aleti, “Nani engalinga ukukakatulapo inamba no kukupukula icitabo?” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.2",
            "verseOrgIds": [
              "REV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo tapali nelyo umo mu mulu nangu ni pa calo, nangu panshi ya calo",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.3",
            "verseOrgIds": [
              "REV.5.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:3",
              "type": "text"
            },
            {
              "text": "Panshi ya calo:",
              "type": "text"
            },
            {
              "text": "Calola mukuti ku calo ca bafwa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " uwakuti akupukule icitabo nangu ukuloleshamo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.3",
            "verseOrgIds": [
              "REV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe na ine nalila icibi ico pashali nelyo umo uwakuti alinga ukukupukula icitabo nangu ukulolesha mukati. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.4",
            "verseOrgIds": [
              "REV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.9"
              },
              "items": [
                {
                  "text": "Icite 49:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo umo pa bakalamba anjeba ati, “Leka ukulila. Mona! Inkalamo ya mu luko lwakwa Yuda, uwa mu lupwa lwakwa Davidi uwalumbuka, alicimfya. Wena kuti akakatulapo inamba no kukupukula icitabo.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        }
      ]
    },
    {
