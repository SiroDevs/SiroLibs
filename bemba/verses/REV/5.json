            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo naumfwa ifibumbwa fyonse ifya mu mulu, ifya pano calo, ifya panshi ya calo, ifya muli bemba ne fibumbwafye fyonse fileimba afiti,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.13",
            "verseOrgIds": [
