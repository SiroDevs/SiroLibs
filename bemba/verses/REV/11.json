              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.14"
              },
              "items": [
                {
                  "text": "7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo malaika walenga cine lubali nao alisha ipenga lyakwe. Mu mulu mwaumfwika amashiwi ayakalamba yaleti, “Ubufumu bwa pano isonde bwayaluka bwaba ubwa Mfumu yesu na Kristu wakwe, kabili eukalateeka pe na pe.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.15",
            "verseOrgIds": [
              "REV.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abakalamba amakumi yabili na bane abekala pa fipuna fyabufumu pa cinso cakwa Lesa, bafukama, bainamina panshi, balapepa Lesa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.16",
            "verseOrgIds": [
              "REV.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balasosa abati,",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.17",
            "verseOrgIds": [
              "REV.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
