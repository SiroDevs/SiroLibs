        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.13",
            "verseOrgIds": [
              "REV.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi ishamo lyabubili lyapita, lelo ilyabutatu lyalaisafye bwangu bwangu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.14",
            "verseOrgIds": [
              "REV.11.14"
            ]
          }
        }
      ]
    },
