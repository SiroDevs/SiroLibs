                "loc": "DAN.7.13"
              },
              "items": [
                {
                  "text": "Dan 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo nati ndoleshe namona ikumbi ilyabuuta. Pali ili kumbi pekele umo uwapala Umwana wa muntu, afwele ne cisote cabufumu ica golide, na mu minwe yakwe ekete icikwakwa icatwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.14",
            "verseOrgIds": [
              "REV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.13"
              },
              "items": [
                {
                  "text": "Yoeli 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo malaika umbi afuma mwitempele aikatisha ishiwi alabilikisha ku wikele pekumbi ati, “Tampa ukuseepa ne cikwakwa cobe, pantu inshita yakuseepa naifika, ifyakuseepa pa calo nafipya.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.15",
            "verseOrgIds": [
              "REV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe uwaikele pekumbi atendeka no kulaseepa pa calo, alobolola na fyonse ifyali nokuseepwa pa calo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.16",
            "verseOrgIds": [
              "REV.14.16"
            ]
          }
        }
      ]
    },
