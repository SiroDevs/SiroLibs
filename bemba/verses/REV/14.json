                {
                  "text": "Esek 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.3"
              },
              "items": [
                {
                  "text": "Ubuso 7:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo nati ndoleshe, namona Umwana wa Mpanga eminine pa lupili lwa Sioni. Umwana wa Mpanga ali na bantu amakana umwanda umo na makanapo amakumi yane na yane (144,000). Aba bantu pa mpumi shabo palembelwe ishina lya Mwana wa Mpanga ne shina lyakwa Wishi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.1",
            "verseOrgIds": [
              "REV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili naumfwa ishiwi ukufuma ku mulu, lileumfwika kwati kupooma kwa menshi, kabili kwati ni mfula ilepanta nganshi. Elyo ukumfwika kwena lileumfwika kwati lwimbo lwa bakalisha wa maseese ilyo balelisha amaseese yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.2",
            "verseOrgIds": [
              "REV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bantu 144,000, aba benefye beka abalubwilwe pa bantu bonse aba pano calo, baiminine pantanshi ya cipuna ca Mfumu Lesa na filya ifyamweo fine na bakalamba. Aba bantu 144,000 baleimba ulwimbo lupya, ulo umuntu umbi ashingasambilila kanofye aba bene beka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.3",
            "verseOrgIds": [
              "REV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba tabatala abaikowesha na banakashi, pantu tabatala abakuma ku mwanakashi nelyo umo. Aba bena bakonkafye Umwana wa Mpanga konse uko aya. Aba bantu ebalubulwa pa bantu bonse, kabili ebabalilepo ukupeelwa kuli Lesa na ku Mwana wa Mpanga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.4",
            "verseOrgIds": [
              "REV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.13"
              },
              "items": [
                {
                  "text": "Sefa 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tababa na bufi iyoo, tabatala abalufyanya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.5",
            "verseOrgIds": [
              "REV.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
