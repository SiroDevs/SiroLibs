                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.2"
              },
              "items": [
                {
                  "text": "Ubuso 18:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo pakonkapo malaika walenga babili. Wena uyu asosa ati, “Naubongoloka! Umusumba ukalamba wa Babiloni naubongoloka! Umusumba uulenga imishobo yonse ukunwa umwangashi uukali wabulalelale wauko!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.8",
            "verseOrgIds": [
              "REV.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.8",
            "verseOrgIds": [
              "REV.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo pakonkapo malaika walenga batatu. Wena uyu alapunda ati, “Uyo onse uupepa iciswango ne cilubi caciko, kabili alisumina ukulembwa ne cishibilo pa mpumi nangu pa cisansa, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.9",
            "verseOrgIds": [
              "REV.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.51.17"
              },
              "items": [
                {
                  "text": "Esaya 51:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24"
              },
              "items": [
                {
                  "text": "Icite 19:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.22"
              },
              "items": [
                {
                  "text": "Esek 38:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ninshi uyo wena akanwa umwangashi wabukali bwakwa Lesa. Uyu mwangashi wa mu lukombo lwa bukali bwakwa Lesa untu wabula nokubikamo ifyakuunashako ubukali. Kabili akacushiwa mukumoca mu mulilo na mu fyanunka nga maluti pa cinso ca bamalaika bamushilo no Mwana wa Mpanga.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.10",
            "verseOrgIds": [
              "REV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.10"
              },
              "items": [
                {
                  "text": "Esaya 34:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo icushi ca kucula kwabo cakubelelela pe. Abo bonse abapepa iciswango ne cilubi caciko, abo bonse basumina ukulembwa icishibilo ce shina lyaciko, takwakabe kupemwinako akasuba nelyo ubushiku. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.11",
            "verseOrgIds": [
              "REV.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi ukushipikisha kulefwaikwa ku bantu bamushilo abasunga amafunde yakwa Lesa no kusumina muli Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.12",
            "verseOrgIds": [
              "REV.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
