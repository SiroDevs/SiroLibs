              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo naumfwa ishiwi ilikalamba ukufuma mwitempele mu mulu lilelanda kuli bamalaika cine lubali lileti, “Kabiyeni muye itila ubukali bwakwa Lesa pa calo ubuli mu nweno cine lubali!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        }
      ]
    },
