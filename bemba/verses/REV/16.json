                "loc": "PSA.78.44"
              },
              "items": [
                {
                  "text": "Amalu 78:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Malaika walenga batatu ena aitulwila ulunweno lwakwe pa mimana na pa tumfukumfuku twa menshi. Awe na menshi yayaluka umulopa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.4",
            "verseOrgIds": [
              "REV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo naumfwa malaika angalila amenshi asosa ati,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
