            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika walenga cine lubali wena aitulwila ulunweno lwakwe mu lwelele. Ku cipuna ca Mfumu mwitempele mu mulu kwafuma ishiwi ilikalamba, lyasosa aliti, “Nomba capwa!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.17",
            "verseOrgIds": [
              "REV.16.17"
            ]
          }
        },
        {
