              "items": [
                {
                  "text": "Luka 12:39-40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Umfweni! Nkesa kwati mupupu! Alishuka umuntu uwikala alelola nasunga ne fyakufwala fyakwe epakuti tele ubwamba, kabili insoni shamwikata!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
