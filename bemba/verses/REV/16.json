              "items": [
                {
                  "text": "Ukuf 10:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika walenga basano ena aitulwila ulunweno lwakwe pa cipuna ca bufumu bwa ciswango. Awe ubufumu bwa ciswango bwakupwa mu mfifi. Abantu ico balaumfwa ubukali, balasuma indimi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili neco balaumfwa ubukali bwa filonda, balasaalula Lesa wa mu mulu. Bakaana ukulapila no kupilibuka pa fibi balecita.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        }
      ]
    },
    {
