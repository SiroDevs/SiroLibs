                "loc": "ISA.60.11"
              },
              "items": [
                {
                  "text": "Esaya 60:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Impongolo sha musumba akasuba konse shikalaba ishacenama, tashakatale ashisalwa, pantu mu musumba tabwakatale abwila. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.25",
            "verseOrgIds": [
              "REV.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "REV 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ba mishobo yonse bakaletamo ubucindami ne fyuma fyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.26",
            "verseOrgIds": [
              "REV.21.26"
            ]
          }
        },
        {
