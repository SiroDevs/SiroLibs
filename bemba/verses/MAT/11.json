          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pantu ikoli lyandi talyayafya, ne cipe candi calyanguka.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.30",
            "verseOrgIds": [
              "MAT.11.30"
