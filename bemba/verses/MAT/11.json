          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tata alimpeela fyonse. Tapaba nangu umo waishiba Mwane, kano Wishi. Kabili tapaba waishiba Wishi, kano Mwane, elyo na bonse abo Mwane atemwa ukubasokolwela.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.27",
            "verseOrgIds": [
              "MAT.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
