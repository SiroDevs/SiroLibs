              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.13"
              },
              "items": [
                {
                  "text": "Ukuf 30:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.38.26"
              },
              "items": [
                {
                  "text": "38:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cilya Yesu na basambi bakwe bafikile mu musumba wa Kapenamu, bakalonganya wa musonko wa mwi Tempele baishile kuli Petelo, balamwipusha abati, “Bushe kafundisha wenu tasonka musonko we Tempele?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.24",
            "verseOrgIds": [
              "MAT.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
