          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu na basambi ilyo bayabukile bemba, bafikile mu calo ca Genasaleti. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.34",
            "verseOrgIds": [
              "MAT.14.34"
            ]
          }
        },
        {
