          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamupapata ukuti, engaleka abalwele balekumyafye nangu ni ku nsenkebele sha nsalu shakwe. Awe na bonse abalekumyako balepola.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.36",
            "verseOrgIds": [
              "MAT.14.36"
            ]
