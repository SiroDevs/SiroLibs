          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo abantu ba muli iyi ncende bamwishiba, nabo baishibisha abantu ba mu mishi ya mumbali. Awe abantu balaleta abalwele bonse kuli Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.35",
            "verseOrgIds": [
              "MAT.14.35"
            ]
          }
        },
        {
