              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abantu bali mu bwato balapakata Yesu abati, “Cine cine uli Mwana wakwa Lesa.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.33",
            "verseOrgIds": [
              "MAT.14.33"
