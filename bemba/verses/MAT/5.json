                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.21"
              },
              "items": [
                {
                  "text": "Amaf 19:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Mwalyumfwa ifyo casoselwe ukuti, ‘Nga linso nao linso, nga lino nao lino.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.38",
            "verseOrgIds": [
              "MAT.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo ine namweba nati, mwilalwishanya na muntu mubi. Umuntu nga akutoba ulupi pesaya lya ku kulyo, umupilibwile ne libiye line. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.39",
            "verseOrgIds": [
              "MAT.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu nga akutwala ku cilye camilandu, alefwaya ukukupoka umwingila, muleke asende ne cakufimbana",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.40",
            "verseOrgIds": [
              "MAT.5.40"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:40",
              "type": "text"
            },
            {
              "text": "Icakufimbana:",
              "type": "text"
            },
            {
              "text": "Ekutila icakufwala ico balefwala pa mulu wa mwingila, ubushiku balecibomfya na pakufimbana.",
              "type": "text"
            }
          ]
        },
        {
          "text": " cine. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.40",
            "verseOrgIds": [
              "MAT.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umo nga akupatikisha ukuya nankwe umulundu umo, wende nankwe imilundu ibili. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.41",
            "verseOrgIds": [
              "MAT.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umo nga akulomba icintu, umupeele. Elyo no ulefwaya ukuti umwashime icintu, wimutana.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.42",
            "verseOrgIds": [
              "MAT.5.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.42",
            "verseOrgIds": [
              "MAT.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwalyumfwa ifyo casoselwe ukuti, ‘Uletemwa umubiyo, ulepata umulwani obe.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.43",
            "verseOrgIds": [
              "MAT.5.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 5:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo ine namweba nati, muletemwa abalwani benu, mulepepelako na bamucusha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.44",
            "verseOrgIds": [
              "MAT.5.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 5:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pantu lyena elyo mukaba abana bakwa Shinwe wa mu mulu. Ena alenga akasuba kakwe ukubalikila pa basuma na pa babi, elyo atuma ne mfula ukulokela pa bawamya na pa babifya pene. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.45",
            "verseOrgIds": [
              "MAT.5.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 5:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga mwatemwafye abamutemwa, cilambu nshi mwingapokelapo? Bushe teficita na bakasonkesha? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.46",
            "verseOrgIds": [
              "MAT.5.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 5:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo nga muleposhafye bamunyinenwe beka beka, finshi mulecita ificililepo ifishicita bambi? Bushe tefyo na bashaishiba Lesa bacita? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.47",
            "verseOrgIds": [
              "MAT.5.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 5:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.2"
              },
              "items": [
                {
                  "text": "Levi 19:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.13"
              },
              "items": [
                {
                  "text": "Amaf 18:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eico kanshi mube abapwililika ku busuma, nga filya Shinwe wa mu mulu aba uwapwililika ku busuma.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.48",
            "verseOrgIds": [
              "MAT.5.48"
            ]
          }
        }
      ]
    }
