              "items": [
                {
                  "text": "Ukuf 20:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.18"
              },
              "items": [
                {
                  "text": "Amaf 5:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Mwalyumfwa ifyo casoselwe ukuti, ‘Wilabembuka.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.27",
            "verseOrgIds": [
              "MAT.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo ine namweba nati, uyo onse uwalolekesha umwanakashi no lunkumbwa lubi, ninshi nabembuka nankwe mu mutima wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.28",
            "verseOrgIds": [
              "MAT.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilinso lyobe ilya ku kulyo nga elyakulengesha ukubifya, ulitonkole, ulifwinte no kutali. Cawamishapo ukulufya icilundwa cimo ica mubili obe, ukucila ukuleka umubili obe onse ukuposwa mu mulilo wape. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.29",
            "verseOrgIds": [
              "MAT.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo nga cisansa cobe ica ku kulyo cakulengesha ukubifya, uciputule, ucifwinte ukutali. Cawamishapo ukulufya icilundwa cimo ica mubili obe, ukucila ukuti umubili obe onse waya mukupya mu mulilo wape.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.30",
            "verseOrgIds": [
              "MAT.5.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
