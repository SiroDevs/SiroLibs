                "loc": "NUM.30.2"
              },
              "items": [
                {
                  "text": "Imp 30:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Kabili mwalyumfwa ifyo baebele aba pakale ukuti, ‘Wilalapa bufi, lelo uli nokufikilisha ifyo walaya ku Mfumu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.33",
            "verseOrgIds": [
              "MAT.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo ine namweba nati, mwilalapa nelyo panono. Mwilalapa nangu umulu wine, pantu e cipuna cikatami cakwa Lesa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.34",
            "verseOrgIds": [
              "MAT.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwilalapa nangu icalo, pantu epo Lesa anyanta amakasa yakwe. Mwilalapa nangu Yerusalemu wine, pantu musumba wa Mfumu nkalamba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.35",
            "verseOrgIds": [
              "MAT.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili wilalapa no mutwe obe wine, pantu iwe tawakwata amaka yakuti ulenge umushishi obe ubuute nangu ufiite. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.36",
            "verseOrgIds": [
              "MAT.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi mulesosafye amuti, ‘ee’ nga ni ‘ee,’ nangu ‘iyoo’ nga ni ‘iyoo.’ Fimbi ifyacila pali ifi ninshi fyafuma kuli Satana.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.37",
            "verseOrgIds": [
              "MAT.5.37"
            ]
          }
        }
      ]
    },
