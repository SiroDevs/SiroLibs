            "sid": "EST 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Modekai aumfwa uyu mulandu. Kabili aeba namfumu Esta. Esta nao aeba imfumu mwishina lyakwa Modekai. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.22",
            "verseOrgIds": [
              "EST.2.22"
            ]
          }
        },
        {
