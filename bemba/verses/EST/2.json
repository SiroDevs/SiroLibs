          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nshiku shilya lilya Modekai aleikala pa mpongolo ya mfumu, Bigitani na Tereshi bamutungwi babili ba mfumu abalonda pa mpongolo bafulilwa imfumu, bafwaya nokwipaya imfumu Asuelusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.21",
            "verseOrgIds": [
              "EST.2.21"
            ]
          }
        },
        {
          "name": "verse",
