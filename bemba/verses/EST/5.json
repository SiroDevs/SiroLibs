          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.13",
            "verseOrgIds": [
              "EST.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo umukashi wakwe Sereshi na banankwe bamweba abati, “Fwayeni abakupanga ifimuti fyakukulikilapo abantu icilepele amakubiti amakumi yasano (50)",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.14",
            "verseOrgIds": [
              "EST.5.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:14",
              "type": "text"
            },
            {
              "text": "amakubiti 50:",
              "type": "text"
            },
            {
              "text": "Ekutila, calepele bamita amakumi yabili na basano (25m).",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Elyo ulucelo ukebe imfumu ikakulikilepo Modekai. Elyo ukaye pamo ne mfumu ku mitebeto ninshi nausansamuka.” Kanshi Hamani atemwa pali aya mano bamupandileko, apanga ne fimuti fyakukulikilapo abantu ba milandu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.14",
            "verseOrgIds": [
              "EST.5.14"
            ]
          }
        }
      ]
    }
