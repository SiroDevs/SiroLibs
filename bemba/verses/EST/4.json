          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Modekai aya cita fyonse ifyo Esta amwebele.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.17",
            "verseOrgIds": [
              "EST.4.17"
            ]
          }
