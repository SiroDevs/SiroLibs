          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.15",
            "verseOrgIds": [
              "JOB.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo amacushi yakwe yapwile, Yobo aikele pano calo imyaka umwanda umo na makumi yane (140). Amwene abana bakwe na beshikulu bakwe ukushinta na ku nkulo yalenga bune. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.16",
            "verseOrgIds": [
              "JOB.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asukile Yobo afwa ninshi ali umukote uwa nshiku ishingi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.17",
            "verseOrgIds": [
              "JOB.42.17"
            ]
          }
        }
      ]
    }
  ],
