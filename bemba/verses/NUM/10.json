          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi elyo baimine ukufuma pa lupili lwakwa Yawe, baendele inshiku shitatu. Muli ishi nshiku, Imbokoshi ya Cipangano cakwa Yawe lyonse eyaleba pantanshi, pakufwaya incende iyo bengacitapo inkambi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikumbi lyakwa Yawe lyali pa mulu wabo mu nshita ya kasuba ilyo baimine ukufuma pa nkambi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
              "NUM.10.34"
            ]
          }
        }
      ]
    },
