        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi abena Israeli baikele mu calo ca bena Amoli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.31",
            "verseOrgIds": [
              "NUM.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panuma elyo Mose atumine inengu ku Yaseri. Abena Israeli bapokolwele imishi ya mumbali, no kufulumunamo abena Amoli abaleikalamo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.32",
            "verseOrgIds": [
              "NUM.21.32"
            ]
          }
        }
      ]
