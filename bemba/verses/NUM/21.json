        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.1",
            "verseOrgIds": [
              "NUM.21.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.33.40"
              },
              "items": [
                {
                  "text": "Imp 33:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo imfumu ya bena Kenani iya ku Aradi, iyaleikala mu matololo ya Negebu, yaumfwile ukuti abena Israeli baleisa mu musebo walola ku Atarimu, yaya balwisha, yaikatapo na bamo bunkole. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.1",
            "verseOrgIds": [
              "NUM.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abena Israeli balaile kuli Yawe abati, “Nga wapeela aba bantu mu minwe yesu, na ifwe tukapeela imisumba yabo kukonaulwa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.2",
            "verseOrgIds": [
              "NUM.21.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:2",
              "type": "text"
            },
            {
              "text": "Ili shiwi mu Cihibulu lipilibula ukulubwila kuli Lesa icintu nangu umuntu ukwabula ukulapulula, ilingi line ni mukonaulwa.",
              "type": "text"
            }
          ]
        },
        {
          "text": ".” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.2",
            "verseOrgIds": [
              "NUM.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe abomfwa, abapeela na bena Kenani mu minwe yabo. Nabo abena Israeli balofeshe abena Kenani no konaula imisumba yabo. Eico icifulo ici cainikwa ne shina lya Homa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.3",
            "verseOrgIds": [
              "NUM.21.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:3",
              "type": "text"
            },
            {
              "text": "Homa:",
              "type": "text"
            },
            {
              "text": "Ili shina mu Cihibulu emukutila “ubonaushi”.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 21:3"
          },
          "items": [
            {
              "text": "3",
