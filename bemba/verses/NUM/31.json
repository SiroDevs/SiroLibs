          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi natuleta kuli Yawe umutuulo wa tuntu twa golide uto cila umo anonkele, amakosa, insambo, imbalaminwe na masikiyo, mukuifutilako pa fya bubifi bwesu pa cinso cakwa Yawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.50",
            "verseOrgIds": [
              "NUM.31.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
