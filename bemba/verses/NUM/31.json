          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifita bafipeele bapunda amakana amakumi yatatu ne myanda isano (30,500). Abakutuula Yawe babuulilepo bapunda amakumi mutanda na umo (61). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
