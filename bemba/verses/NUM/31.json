              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifyashele ukufuma ku fitapwa ifyo ifita fyaile ku nkondo fyasendele, fyali impaanga amakana imyanda mutanda, na makana amakumi cine lubali na yasano (675,000), ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.32",
