              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifita bafipeele abantu amakana ikumi na mutanda (16,000). Abakutuula Yawe babuulilepo abantu amakumi yatatu na babili (32). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.40",
            "verseOrgIds": [
