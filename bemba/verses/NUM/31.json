          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuuleko ku cakaniko ca fita no kupeela Eleasa shimapepo, ukuba ciputulwa cakwa Yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.29",
            "verseOrgIds": [
              "NUM.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukufuma ku cakaniko ca lukuta lwa bena Israeli, salenipo cimo pa fintu amakumi yasano, cibe ni pa bantu, iŋombe, bapunda, impaanga, imbushi nangu inama shimbi. Mupeele abena Levi, ababombela mwi Tenti lyakwa Yawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.30",
            "verseOrgIds": [
              "NUM.31.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Mose na Eleasa shimapepo epakucitila umo Yawe akonkomeseshe Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.31",
            "verseOrgIds": [
              "NUM.31.31"
            ]
          }
        }
      ]
