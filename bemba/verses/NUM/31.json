          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "balamweba abati, “Fwe babomfi bobe natupenda ifita twaletungulula tapali nangu umo uulubile. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.49",
            "verseOrgIds": [
              "NUM.31.49"
            ]
          }
