              "type": "text"
            }
          ]
        },
        {
          "text": "Citika wa bena Israeli, uo Mose abapatwililepo ukufuma pa fita fyaile ku nkondo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.42",
