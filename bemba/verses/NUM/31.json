          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose epakupeela Eleasa shimapepo umutuulo wakwa Yawe ngefyo Yawe amukonkomeshe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.41",
