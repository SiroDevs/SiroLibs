          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifita bafipeele iŋombe amakana amakumi yatatu na makanapo mutanda (36,000). Ishakutuula Yawe babuulilepo iŋombe amakumi cine lubali na shibili (72). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.38",
            "verseOrgIds": [
              "NUM.31.38"
            ]
          }
        },
        {
          "name": "verse",
