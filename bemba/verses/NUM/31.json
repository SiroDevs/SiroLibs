              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abakalamba abali pakati ka fita fya nkondo, abakalamba ba fita amakana na bakalamba ba fita imyanda, baile kuli Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.48",
            "verseOrgIds": [
              "NUM.31.48"
            ]
          }
        },
        {
          "name": "verse",
