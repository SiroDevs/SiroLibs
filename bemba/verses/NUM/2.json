          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ku kabanga kulya kutulila akasuba, kukaba iciputulwa ca nkambi cakwa Yuda no luunga lwabo. Cikaba mu mpuka mu mpuka sha mikowa yabo. Intungulushi ya bena Yuda ni Nashoni mwana Aminadabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.3",
            "verseOrgIds": [
              "NUM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impendwa ye bumba lyakwe, bantu amakana amakumi cine lubali na yane ne myanda mutanda (74,600).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.4",
            "verseOrgIds": [
              "NUM.2.4"
            ]
          }
        }
      ]
    },
