          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impendwa ye bumba lyakwe, bantu amakana amakumi yasano na yane ne myanda ine (54,400).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.6",
