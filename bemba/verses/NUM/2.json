          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impendwa ye bumba lyakwe, bantu amakana amakumi yane na limo ne myanda isano (41,500).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.28",
            "verseOrgIds": [
              "NUM.2.28"
            ]
          }
        }
      ]
