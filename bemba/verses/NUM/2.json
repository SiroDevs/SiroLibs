          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impendwa ye bumba lyakwe, bantu amakana amakumi mutanda na yabili ne myanda cine lubali (62,700).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.26",
            "verseOrgIds": [
              "NUM.2.26"
            ]
          }
        }
      ]
    },
    {
