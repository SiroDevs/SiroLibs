          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uluko lwakwa Naftali nao elukakonkapo. Intungulushi ya bena Naftali ni Aira mwana Enani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.29",
