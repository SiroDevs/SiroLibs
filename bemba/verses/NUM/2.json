          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impendwa ye bumba lyakwe, bantu amakana amakumi yasano na yatatu ne myanda ine (53,400). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.30",
            "verseOrgIds": [
              "NUM.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
