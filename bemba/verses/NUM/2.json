          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaume bonse abapendelwe mu ciputulwa ca nkambi icakwa Dani, mu mpuka mu mpuka, bali amakana umwanda umo na makumi yasano na cine lubali ne myanda mutanda (157,600). Aba bantu ebali nokulaba abakulalekeleshako nga bafuma pa nkambi mu mikowa yabo pa ncende apali uluunga lwabo.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.31",
            "verseOrgIds": [
              "NUM.2.31"
            ]
          }
        }
      ]
