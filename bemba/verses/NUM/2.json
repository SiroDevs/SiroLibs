            "number": "2",
            "style": "v",
            "sid": "NUM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abena Israeli bali nokulaimika amatenti yabo ukushinguluka Itenti Lyakukumaninamo pa nkambi, lelo bafwile ukutalushako amatenti yabo. Umuntu onse akabe mwibumba lya mpuka ya luko lwakwe akabike icishibilo ca luunga lwa luko pe tenti lyakwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.2",
            "verseOrgIds": [
              "NUM.2.2"
            ]
          }
        }
      ]
    },
