          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uluko lwakwa Asheri elukabakonkapo. Intungulushi ya bena Asheri ni Pagieli mwana Okirani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.27",
            "verseOrgIds": [
              "NUM.2.27"
            ]
          }
