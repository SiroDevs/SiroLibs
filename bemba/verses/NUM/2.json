          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga filya fine Yawe akonkomeshe Mose, abena Levi bena tabapendelwe pamo na bena Israeli bambi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.33",
