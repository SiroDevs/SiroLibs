          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaume bonse abapendelwe mu ciputulwa ca nkambi icakwa Yuda, mu mpuka mu mpuka, bali amakana umwanda umo na makumi cine konse konse na mutanda ne myanda ine (186,400). Aba bantu ebafwile ukuba pantanshi nga bafuma pa nkambi balipo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.9",
            "verseOrgIds": [
              "NUM.2.9"
            ]
          }
        }
