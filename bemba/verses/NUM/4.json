          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebakalasenda ifisalu fyakucinga kwi Itenti lyakwa Lesa, Itenti Lyakukumaninamo ne cakufimbako icamukati ne cakufimbapo cakunse ica mpapa ishisuma ishatelela, pamo pene ne fyakufimba pa mwinshi we Tenti Lyakukumaninamo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.25",
            "verseOrgIds": [
              "NUM.4.25"
            ]
          }
        },
        {
