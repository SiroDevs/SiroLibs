          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi e milimo abena Geshoni bakalabomba pamo no kulasenda ifipe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.24",
            "verseOrgIds": [
