          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imilimo bakalabomba yonse, cibe yakusenda ifipe nangu yakubombafye, Aroni na bana bakwe abaume ebo bakalebakonkomesha. Uli nokubalanga fyonse ifyo bali nokusenda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.27",
            "verseOrgIds": [
              "NUM.4.27"
            ]
