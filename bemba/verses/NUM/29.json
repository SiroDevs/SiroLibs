              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ŋombe iyilume, sukusuku no twana twa mpaanga mupekanishishepo umutuulo wa cabunga ne fyakunwa ukulingana ne mpendwa yapimwa. ",
          "type": "text",
          "attrs": {
