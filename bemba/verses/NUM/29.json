          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muli nokutuula ilambo lyakoca lya cena cisuma icisekesha Yawe, ilya ŋombe ilume imo, sukusuku umo no twana twa mpaanga utulume cine lubali utwa mwaka umo umo, fyonse ifyabula ubulema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.36",
            "verseOrgIds": [
              "NUM.29.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
