                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pa bushiku bwantanshi mu mweshi walenga cine lubali kuleba ukulongana kwamushilo, kabili tekwesha kubombamo imilimo ya cila bushiku. Bushiku bwenu ubwakulishamo amapenga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.1",
            "verseOrgIds": [
              "NUM.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngo mutuulo wa cena cisuma icisekesha Yawe, pekanyeni ilambo lyakoca ilya ciponti ca ŋombe cimo icilume, sukusuku umo no twana twa mpaanga utulume cine lubali utwa mwaka umo umo, fyonse ifyabula akalema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.2",
            "verseOrgIds": [
              "NUM.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ŋombe ilume, pekanishishenipo utwapekumi tutatu twa ku cipimo ca efa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:3,9,14",
              "type": "text"
            },
            {
              "text": "Efa:",
              "type": "text"
            },
            {
              "text": "Cipimo ca fintu ifishili fya menshi ifyafina amakilo ikumi limo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " wa bunga bwa ŋanu ubwapeleka bwino ubwasanshiwamo na mafuta ya miolifa. Pali sukusuku paleba utwapekumi tubili twakuli efa wa bunga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo pali cila kana ka mpanga pa twana twa mpaanga cine lubali, cipimo cimo pekumi ica efa wa bunga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.4",
            "verseOrgIds": [
              "NUM.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulundepo na sawe umo uwakumufutilapo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.5",
            "verseOrgIds": [
              "NUM.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifi fyonse fyakulundapofye pa malambo yakoca aya cila mweshi naya cila bushiku pamo no mutuulo wa cabunga no mutuulo wa fyakunwa ngefyo fyatantikwa. Ifi fyonse, mituulo yakoca iyakuletela Yawe iya cena cisuma icimusekesha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa bushiku bwalenga ikumi limo mu mweshi walenga cine lubali kuleba ukulongana kwamushilo. Mufwile ukuikaanya, mwilabombamo imilimo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.7",
            "verseOrgIds": [
              "NUM.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili muli nokutuula ilambo lyakoca ilya cena icisuma icisekesha Yawe, iciponti cimo, sukusuku umo no twana twa mpaanga utulume cine lubali utwa mwaka umo umo, fyonse ifyabula akalema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.8",
            "verseOrgIds": [
              "NUM.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ŋombe ilume, pekanishishenipo utwapekumi tutatu utwa ku cipimo ca efa wa bunga bwa ŋanu ubwapeleka bwino ubwasanshiwamo na mafuta ya miolifa. Pali sukusuku paleba utwapekumi tubili twa kuli efa wa bunga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.9",
            "verseOrgIds": [
              "NUM.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo pali cila kana ka mpanga pa twana twa mpaanga cine lubali, cipimo cimo pekumi ica efa wa bunga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.10",
            "verseOrgIds": [
              "NUM.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubikepo na sawe umo ngo mutuulo wakwelelwa pa fyabubifi, ukulunda pa mutuulo wakufuta pa fyabubifi, ilambo lyakoca ilyacila bushiku pamo pene no mutuulo wa cabunga no wa fyakunwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.11",
            "verseOrgIds": [
              "NUM.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
