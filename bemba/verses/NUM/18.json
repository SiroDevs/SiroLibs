              "items": [
                {
                  "text": "2 Imila 13:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ifyashalako ku mituulo yamushilo yonse iyo abena Israeli bakalatuula ine ne Yawe, napeela kuli iwe pamo na bana bobe abaume na banakashi, nge cakumwakanyako lyonse. Kanshi ici e cipangano ca pe ica mucele pa cinso cakwa Yawe kuli iwe na ku bana bobe abakakonkapo.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.19",
            "verseOrgIds": [
              "NUM.18.19"
            ]
          }
        }
      ]
    },
