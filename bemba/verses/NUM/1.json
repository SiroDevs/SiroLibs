          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu luko lwakwa Simeoni, bali amakana amakumi yasano na pabula ne myanda itatu (59,300).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.23",
