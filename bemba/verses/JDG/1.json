                "loc": "1CH.11.4"
              },
              "items": [
                {
                  "text": "1 Imila 11:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abena Benjamini balifililwe ukutamfya abena Yebusi abaleikala mu Yerusalemu, eico ukufika na lelo line abena Yebusi bacili baleikala pamo na bena Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.21",
            "verseOrgIds": [
              "JDG.1.21"
            ]
          }
        }
      ]
