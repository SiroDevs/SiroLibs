            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abena Naftali nabo bene tabafulumwine abo bonse abaleikala mu Beti Shemeshi nangu mu Beti Anati, lelo baikele pamo na bena Kenani abali abakaya ba calo. Nomba bonse abaleikala mu Beti Shemeshi na mu Beti Anati, bena babapatikishe ukulabomba umulaasa kuli bena.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.33",
            "verseOrgIds": [
              "JDG.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.33",
            "verseOrgIds": [
              "JDG.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili abena Amoli batamfishe abena Dani ku calo ca mpili no kubalesha ukulaisa ku mawanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
              "JDG.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe abena Amoli bena bakonkenyepofye ukulaikala mu fyalo fya mpili ifya Heresi, Aiyaloni na Shalibimu. Lelo ilyo aba ŋanda yakwa Yosefu baishile kwatisha amaka, babapatikisha no kulabomba umulaasa kuli bena. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.35",
            "verseOrgIds": [
              "JDG.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umupaka wa bena Amoli watulile pa mupokapoka wa Akarabimu, ukuya fika ku Sela elyo no kucilapo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.36",
            "verseOrgIds": [
              "JDG.1.36"
            ]
          }
        }
