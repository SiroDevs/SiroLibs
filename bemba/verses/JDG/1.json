                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili abena Manase balifililwe ukufulumuna abena Beti Shani, nangu abena Tanaki, nangu abena Dori, nangu abena Ibileamu nangu abena Megido, pamo pene ne mishi iyabashingulwike. Pantu abena Kenani bakoselepofye ukulaikala muli cilya calo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.27",
            "verseOrgIds": [
              "JDG.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo ilyo abena Israeli bakosele, batitikishe abena Kenani ukulabomba imilimo ya mulaasa, lelo ukubatamfya tababatamfishe iyoo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
            "verseOrgIds": [
              "JDG.1.28"
            ]
          }
        }
      ]
    },
