            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nangufye abena Kenani abaleikala mu musumba wa Gesa, abena Efulemu tababafulumwinemo muli uyu musumba, lelo batwalililefye ukwikala nabo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.29",
            "verseOrgIds": [
