      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.29",
            "verseOrgIds": [
              "JDG.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nangu na bena Sebuloni bene tabafulumwine abena Kenani abaleikala mu Kitiloni, nangu mu Naaloli, abo abashele pakati kabo, lelo babapeelefye umulimo wakubomba umulaasa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.30",
            "verseOrgIds": [
              "JDG.1.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 1:30"
          },
          "items": [
            {
              "text": "30",
