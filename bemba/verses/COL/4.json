              "items": [
                {
                  "text": "Efe 6:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwe bashikulwibo, mulesunga abasha benu mu nshila isuma, kabili iyalungama. Muleibukisha ukuti na imwe bene mwalikwata Shikulwinwe mu mulu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.1",
            "verseOrgIds": [
              "COL.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.1",
            "verseOrgIds": [
              "COL.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwilanenuka mukupepa. Mulebikako amano mukupepa, muletasha na Lesa. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.2",
            "verseOrgIds": [
              "COL.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muletupepelako na ifwe bene, pakuti Lesa atupekanishishe inshila pakubila amashiwi ya nkaama yakwa Kristu. Ni pa mulandu wine uyu epo bamposela mu cifungo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.3",
            "verseOrgIds": [
              "COL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eico kanshi mulepepa ukuti ndebila Imbila bwino bwino ngefyo mfwile ukucita.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.4",
            "verseOrgIds": [
              "COL.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.4",
            "verseOrgIds": [
              "COL.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulecenjela kufyo mulecita ku bantu abashasumina. Mulebomfya bwino ne nshita yonse iyo mwashukila. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.5",
            "verseOrgIds": [
              "COL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imilandile yenu ileba lyonse iyacikuuku ku bantu ne yakubafwilisha. Mwishibe ukwasuka cila muntu bwino bwino.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.6",
            "verseOrgIds": [
              "COL.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.6",
            "verseOrgIds": [
              "COL.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.21+EPH.6.22"
              },
              "items": [
                {
                  "text": "Efe 6:21-22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyinefwe uo twatemwa Tukiko, musha uwacetekelwa uubombela Imfumu pamo na ifwe, eukamweba fyonse pali ine. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namutuma kuli imwe kukwisa musansamushako no kumwebako ifyo bonse tuli. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.8",
            "verseOrgIds": [
              "COL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akesa na Onesimo, munyinefwe uo twatemwa kabili uwacetekelwa nganshi, kabili wa mwibumba lyenu. Bakesa mwebako fyonse ificitika kuno.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
            "verseOrgIds": [
              "COL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
            "verseOrgIds": [
              "COL.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alisitako, uo tuli nankwe mu cifungo amuposha, pamo na Mako umufyala wakwa Banaba. Eulya namwebele kale ukuti nga aisa uko mukamupokelele. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.10",
            "verseOrgIds": [
              "COL.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu, kabili uwitwa Yusito, nao amuposha. Aba benefye batatu e Bayuda abasumina, ababomba na ine umulimo wa Bufumu bwakwa Lesa, kabili ebankoseleshako nganshi.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epafula, uwaba nao wa mwibumba lyenu kabili umusha wakwa Kristu Yesu, nao amuposha. Lyonsefye alamupepelako pa maka. Alomba Lesa ukuti mube abakosa mu cisumino, abapwililika, abashitwishika mu cisumino, kabili abanakila Lesa muli fyonse. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala ine wine ndi kambone pafyo abombesha pali imwe pamo na ba mu Hielapoli na Laodikea. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.13",
            "verseOrgIds": [
              "COL.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luka shiŋanga wesu uo twatemwisha nganshi pamo na Dimasi bamuposha.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.14",
            "verseOrgIds": [
              "COL.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.14",
            "verseOrgIds": [
              "COL.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muposhepo bamunyinefwe aba mu Laodikea, na Numfa no lukuta ululongana mu ŋanda mumwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.15",
            "verseOrgIds": [
              "COL.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga mwapwisha ukubelenga iyo kalata, mumone ukuti babelengela no lukuta lwa mu Laodikea. Elyo na imwe mukabelenge kalata yandi imbi iyikafuma ku Laodikea. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.16",
            "verseOrgIds": [
              "COL.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili mwebe Akipo ukuti, afwile ukubikako amano ukupwisha umulimo untu apeelwe uwakubombela Imfumu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.17",
            "verseOrgIds": [
              "COL.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.17",
            "verseOrgIds": [
              "COL.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine, ne Paulo, nalemba no kuboko kwandi aya mashiwi yakumuposha. Muleibukisha ukuti naba mu cifungo! Icikuuku cileba na imwe.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.18",
            "verseOrgIds": [
              "COL.4.18"
            ]
          }
        }
      ]
    }
  ],
