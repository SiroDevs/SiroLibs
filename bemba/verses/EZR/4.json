            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panumafye yakubelenga kalata uwafumine ku mfumu Atakisesi, Reumu na Shimushai kalemba na banabo bambi bwangu bwangu baya ku Yerusalemu ku Bayuda no kubalesha ku maka ukukuula. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        },
