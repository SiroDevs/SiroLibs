          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reumu umukalamba wa bashilika na Shimushai kalemba balemba kalata walupato pali Yerusalemu ku mfumu Atakisesi mu musango uyu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        }
