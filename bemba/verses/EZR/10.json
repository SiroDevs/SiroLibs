      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EZR 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.43",
            "verseOrgIds": [
              "EZR.10.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EZR 10:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bonse ebaupile abanakashi abenafyalo, kabili balibatamfishe pamo na bana babo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.44",
            "verseOrgIds": [
              "EZR.10.44"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:44",
              "type": "text"
            },
            {
              "text": "Amashiwi ya mu Cihibulu yalikosa mukumfwikisha, limbi yatila, “Aba bonse ebaupile abanakashi abenafyalo kabili bamo balifyelemo na bana.”",
              "type": "text"
            }
          ]
        }
      ]
    }
