              "items": [
                {
                  "text": "29:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cali mu mwaka wakutendeka uwakuba pa bufumu bwakwa Sairasi imfumu ya ku Pesia, pakufikilisha ishiwi lyakwa Yawe ilyasosele kasesema Yeremia, Yawe aimishe umutima wakwa Sairasi imfumu ya ku Pesia ukuma imbila mu bufumu bwakwe no kuilemba ati,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 1:4"
          },
          "items": [
