              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.7",
            "verseOrgIds": [
              "EZR.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mweshi wabubili uwa mu mwaka wabubili apo babwelele ku ŋanda yakwa Lesa mu Yerusalemu, Serubabeli umwana wakwa Shealitieli, elyo na Yeshua umwana wakwa Yosadaki batampako ukubomba pamo na bamunyinabo bonse bashimapepo na bena Levi abo bafumine nabo mu busha no kubwelelamo ku Yerusalemu. Kanshi basala abena Levi ukwambila pa myaka amakumi yabili (20) no kucilapo pakuti bangalile umulimo wakukuula iŋanda yakwa Yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.8",
            "verseOrgIds": [
              "EZR.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Yeshua na bana bakwe pamo na bamunyina baikatana na Kadimieli na bamwane abaume abana bakwa Yuda pakwangalila umulimo wa mu ŋanda yakwa Lesa, pamo na bana baume abakwa Henadadi na bana baume ba bena Levi na bamunyinabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.9",
            "verseOrgIds": [
              "EZR.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.25.1"
              },
              "items": [
                {
                  "text": "1 Imila 25:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ilyo bakakuula bapwisha ukwimba umufula we Tempele lyakwa Yawe, bashimapepo baisa nabafwala ne fyakufwala fyabo, nabasenda na mapenga. Abena Levi bamwana Asafi nabo baisa nabasenda ne miwaya, baya ikala pa ncende yabo balalumbanya Yawe ukulingana nefyo Davidi imfumu ya bena Israeli asosele. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
