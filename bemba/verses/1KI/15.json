          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palwa fintu fimbi ifya pa bufumu bwakwa Nadabu, elyo na fyonse ifyo acitile, bushe tafyalembwa mwibuku lya milandu ya shamfumu sha bena Israeli? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paleba ukulwa pakati kakwa Asa na Baasha imfumu ya bena Israeli mu nshita yonse iya bufumu bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
            "verseOrgIds": [
              "1KI.15.32"
            ]
          }
        }
      ]
