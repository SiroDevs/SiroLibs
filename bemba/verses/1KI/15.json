            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka wabutatu uwa bufumu bwakwa Asa imfumu ya bena Yuda, Baasha ewatendeke ukuteeka icalo conse ica Israeli mu Tirisa, kabili aikele pa bufumu imyaka amakumi yabili na ine (24). ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
            "verseOrgIds": [
              "1KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acitile ifyabipa pa cinso cakwa Yawe, akonkafye mu nshila yakwa Yeroboamu na mu fyabubifi fyakwe ifyo aposelemo na bena Israeli ukuficita.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.34",
            "verseOrgIds": [
              "1KI.15.34"
            ]
          }
