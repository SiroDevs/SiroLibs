          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umufula wa ŋanda yakwa Yawe wapangilwe mu mwaka walenga bune mu mweshi wabubili ekutila umweshi washinde.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:37",
              "type": "text"
            },
            {
              "text": "umweshi wabubili:",
              "type": "text"
            },
            {
              "text": "Abahibulu batila, “umweshi wa Sifi.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka walenga ikumi limo na umo (11) mu mweshi wa lusuba lunono emukutila umweshi walenga cine konse konse,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:38",
              "type": "text"
            },
            {
              "text": "umweshi walenga cine konse konse:",
              "type": "text"
            },
            {
              "text": "Abahibulu batila, “umweshi wa Buli.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " emo bapwishishe ukukuula iŋanda muli fyonse ukulingana nefyo yapekanishiwe. Apwilepo imyaka cine lubali pakuti apwishe ukukuula.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        }
