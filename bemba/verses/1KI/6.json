          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili akuula ulubansa lwa mukati mu mitande itatu ku mabwe ayabaswa bwino no mutande umo ku milando iyasukulwa iya cimuti icalepesha ica keda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
