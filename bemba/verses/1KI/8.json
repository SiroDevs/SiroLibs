        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.21",
            "verseOrgIds": [
              "1KI.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Solomoni aiminine ku cinso ca bulambo bwakwa Yawe kuntanshi ukwalongene abena Israeli, asumbwila amaboko mu mulu, nokutila,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.22",
            "verseOrgIds": [
              "1KI.8.22"
            ]
          }
        }
      ]
    },
    {
