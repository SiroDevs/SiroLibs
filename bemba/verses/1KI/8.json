          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninshi ulukuta lwa bena Israeli lucili nalwiminina palya pene, imfumu yapilubuka no kulupaala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.14",
            "verseOrgIds": [
              "1KI.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo yalanda aiti,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.15",
            "verseOrgIds": [
              "1KI.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 8:21"
          },
          "items": [
