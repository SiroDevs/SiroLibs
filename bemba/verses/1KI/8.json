            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.53",
            "verseOrgIds": [
              "1KI.8.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1KI 8:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo Solomoni apwile ukupepa no kulomba kuli Yawe, elyo aiminina kuntanshi ya bulambo bwakwa Yawe pa ncende pene aciba afukeme ninshi nasumbula amaboko yakwe ku mulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.54",
            "verseOrgIds": [
              "1KI.8.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1KI 8:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiminina no kupaala ibumba lyonse ilya bena Israeli mwishiwi ilikalamba no kutila,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.55",
            "verseOrgIds": [
              "1KI.8.55"
            ]
          }
        }
      ]
    },
