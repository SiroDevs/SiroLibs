                "loc": "EXO.40.34+EXO.40.35"
              },
              "items": [
                {
                  "text": "Ukuf 40:34-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bashimapepo bafumine mu Muputule wamushilo elyo ikumbi lyaishile isula mu ŋanda yakwa Yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.10",
            "verseOrgIds": [
              "1KI.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na pa mulandu we kumbi ili bashimapepo bafilwa no kubomba imilimo yabo pantu ubucindami bwakwa Yawe bwaisula mu ŋanda yakwa Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.11",
            "verseOrgIds": [
              "1KI.8.11"
            ]
          }
        }
      ]
    },
    {
