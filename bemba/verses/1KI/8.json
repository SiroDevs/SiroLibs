                "loc": "2SA.6.12+2SA.6.13+2SA.6.14+2SA.6.15+2SA.6.16"
              },
              "items": [
                {
                  "text": "2 Sam 6:12-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.15.25+1CH.15.26+1CH.15.27+1CH.15.28+1CH.15.29"
              },
              "items": [
                {
                  "text": "1 Imila 15:25-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo imfumu Solomoni yaitile kwisano ku Yerusalemu abakalamba bonse aba mu Israeli, intungulushi sha nko shonse elyo na bakalamba ba ndupwa sha bena Israeli ukuti baye senda Imbokoshi ya Cipangano cakwa Yawe ukufuma ku Sioni, umusumba wakwa Davidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.1",
            "verseOrgIds": [
              "1KI.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.24"
              },
              "items": [
                {
                  "text": "Levi 23:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abaume bonse abena Israeli baisa longana pamo ku mfumu Solomoni pa nshita ya nshikunkulu mu mweshi uwalenga cine lubali ekutila umweshi wa Etanimu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.2",
            "verseOrgIds": [
              "1KI.8.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:2",
              "type": "text"
            },
            {
              "text": "Etanimu:",
              "type": "text"
            },
            {
              "text": "Ishina limbi ni Tishri ilyo babomfya panuma yakufuma ku Babiloni (September-October).",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.2",
            "verseOrgIds": [
              "1KI.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo abakalamba bonse aba mu Israeli bafikile, elyo bashimapepo baimishe Imbokoshi ya Cipangano iyakwa Yawe ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.3",
            "verseOrgIds": [
              "1KI.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "no kuleta Imbokoshi ya cipangano cakwa Yawe, Itenti lyakukumaninamo ne fipe fyonse ifyamushilo ifyali mukati. Bashimapepo na bena Levi ebasendele. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.4",
            "verseOrgIds": [
              "1KI.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imfumu Solomoni no lukuta lonse ulwa bena Israeli abalongene kulya ali, batangila pa ntanshi ya Mbokoshi no kutuula impaanga ne ŋombe ishingi isho bashingebukisha nangu ukupenda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.5",
            "verseOrgIds": [
              "1KI.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.5",
            "verseOrgIds": [
              "1KI.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashimapepo epakuleta Imbokoshi ya Cipangano cakwa Yawe pa cifulo caiko mu Muputule wa mukati ka ŋanda uwamushilo icine cine no kuiteeka mwisamba lya mapindo ya bakerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.6",
            "verseOrgIds": [
              "1KI.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amapindo ya bakerubi yayanshile pa mulu wa Mbokoshi icakuti yafimbilikisha kumo ne fimuti fyakupingilako fyaiko. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.7",
            "verseOrgIds": [
              "1KI.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifi fimuti fyali ifitali icalengele nokuti impela yafiko ilemoneka ku bali mu Muputule wamushilo, lwa kuntanshi ya Muputule wamushilo icine cine, nomba tashalemoneka ku bali kumbi iyoo. Kabili eko fyaba ukufika na nomba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.8",
            "verseOrgIds": [
              "1KI.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.5"
              },
              "items": [
                {
                  "text": "Amaf 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tamwali cintu cimbi mu Mbokoshi kanofye amabwe ayapapatala yabili ayo Mose abikilemo pa ncende ya ku Holebu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.9",
            "verseOrgIds": [
              "1KI.8.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:9",
              "type": "text"
            },
            {
              "text": "Holebu:",
              "type": "text"
            },
            {
              "text": "E shina limbi ilya lupili lwa Sinai ulupili lwakwa Lesa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " palya Yawe apangile icipangano na bena Israeli ukutula apo bafumine mu Egupto.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.9",
            "verseOrgIds": [
              "1KI.8.9"
            ]
          }
        }
      ]
    },
    {
