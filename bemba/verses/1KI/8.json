                "loc": "PSA.97.2"
              },
              "items": [
                {
                  "text": "97:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Solomoni atila, “Yawe alilanda ukuti akulaikala mwikumbi ilyafiita. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.12",
            "verseOrgIds": [
              "1KI.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ninkukuulila iŋanda iyacindama, incende iyakuti iwe uleikalamo pe na pe.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.13",
            "verseOrgIds": [
              "1KI.8.13"
            ]
          }
        }
      ]
    },
    {
