              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka walenga isano iya bufumu bwakwa Reoboamu, Shishaki imfumu ya ku Egupto yasansa umusumba wa Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.25",
            "verseOrgIds": [
              "1KI.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
