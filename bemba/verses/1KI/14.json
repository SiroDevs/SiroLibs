                  "text": "1 Isham 10:16-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.15+2CH.9.16"
              },
              "items": [
                {
                  "text": "2 Imila 9:15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Asenda icuma conse icali mu ŋanda yakwa Yawe ne cuma ca mu ŋanda ye sano. Asendafye fyonse, asendela kumo ne nkwela sha golide isho Solomoni apangile. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
              "1KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi imfumu Reoboamu epakupanga shimbi inkwela isha mukuba ishakupyanikishapo, yashipeela na ku bakalamba ba bashilika abalelonda pa mpongolo ya kwisano. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo lyonse imfumu yaya ku ŋanda yakwa Yawe, abashilika baya nabafwala, elyo pakubwela bashibwesesha mu muputule wakushisungilamo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        }
      ]
