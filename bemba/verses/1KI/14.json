                "loc": "2KI.17.9+2KI.17.10"
              },
              "items": [
                {
                  "text": "2 Isham 17:9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Baikuulila ne ncende shakupepelamo imilungu yabo, baimika amabwe ne nceshi sha mulungu Ashera pa mulu wa mpili shonse ishitali na pesamba lya cimuti conse icafumba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.23",
            "verseOrgIds": [
              "1KI.14.23"
            ]
          }
        },
        {
