            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.9",
            "verseOrgIds": [
              "1KI.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
