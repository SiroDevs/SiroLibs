                  "text": "Amaf 23:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwaba na bacilende ba ku mfuba abaume",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.24",
            "verseOrgIds": [
              "1KI.14.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:24",
              "type": "text"
            },
            {
              "text": "bacilende ba ku mfuba abaume:",
              "type": "text"
            },
            {
              "text": "Baume abasuminishiwe ukucita ubulalelale mu ncende ya mapepo ya milungu yabufi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mu calo. Abantu bonse baiposa mukucita ifyamakankamike ifyalecita abantu abo Yawe atamfishe ku cinso ca bena Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.24",
            "verseOrgIds": [
              "1KI.14.24"
            ]
          }
        }
