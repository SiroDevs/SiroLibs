            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.5",
            "verseOrgIds": [
              "1CH.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili Davidi alekanya abena Levi mu mabumba ukulingana na bana bakwa Levi, Geshoni, Koati na Merari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.6",
            "verseOrgIds": [
              "1CH.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
