          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana bakwa Merari bali ni Mali na Mushi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.21",
            "verseOrgIds": [
              "1CH.23.21"
            ]
