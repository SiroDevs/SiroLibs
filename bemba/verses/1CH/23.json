        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi ifi efyo abena Levi balebomba imilimo yabo iya mwi Tenti lyakukumaninamo, mu cifulo camushilo nelyo bali mu minwe ya bamunyinabo aba mu lupwa lwakwa Aroni, mu milimo ya mu ŋanda yakwa Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
            "verseOrgIds": [
              "1CH.23.32"
            ]
          }
        }
      ]
