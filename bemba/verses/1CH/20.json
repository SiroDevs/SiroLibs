                "loc": "2SA.11.1"
              },
              "items": [
                {
                  "text": "2 Sam 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili pakwaluka kwa mwaka pa nshita ilya mfumu shifuma ukuya ku nkondo, Yoabu elyo afumishe ifita aya kukonaula icalo ca bena Amoni. Kabili aile ku Raba no kuya cipokolola. Lelo Davidi ena, ashele mu Yerusalemu. Elyo Yoabu aya sansa Raba no kuonaula. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.1",
            "verseOrgIds": [
              "1CH.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi abuula ne cisote cabufumu ukufuma ku mutwe wa mfumu yabo. Ukufina kwaciko kwali italanta lya golide limo",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:2",
              "type": "text"
            },
            {
              "text": "italanta lya golide limo:",
              "type": "text"
            },
            {
              "text": "Ecintu icafinine amakilo amakumi yatatu na yane (34kg).",
              "type": "text"
            }
          ]
        },
        {
          "text": ", kabili mukati mwali no tumabwe utwauma umutengo. Baisa cibika pa mutwe wakwa Davidi. Kabili abuula ifitapwa ifingi nganshi ukufuma mu musumba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo afumya abantu abali mu musumba, abatwala kukubomba imilimo yakubomfya ifyakuputwilako imbao, bancinde elyo na masembe. Kanshi Davidi acitile ifi fine na ku misumba yonse iya bena Amoni. Elyo Davidi ne fita fyakwe fyonse babwelela ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        }
      ]
    },
    {
