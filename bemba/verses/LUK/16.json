            "sid": "LUK 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao umukankala ayasuka ati, ‘Iyoo, tata Abrahamu, ala nga cakuti umo pa bafwa aya uko bali, kuti balapila no kupilibuka.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.30",
            "verseOrgIds": [
              "LUK.16.30"
            ]
          }
        },
        {
          "name": "verse",
