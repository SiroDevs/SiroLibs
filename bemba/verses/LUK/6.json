              "LUK.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.22",
            "verseOrgIds": [
              "LUK.6.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.14"
              },
              "items": [
                {
                  "text": "1 Pet 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwalishuka imwe, abantu nga bamupata, no kumutamfya, no kumusebanya, no kumusaalula pa mulandu wa Mwana wa muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.22",
            "verseOrgIds": [
              "LUK.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.16"
              },
              "items": [
                {
                  "text": "2 Imila 36:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.52"
              },
              "items": [
                {
                  "text": "Imili 7:52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kanshi muli ubo bushiku mukaleyanga no kusansamuka, pantu icilambu cenu cikalamba mu mulu. Kabinge efyo ne fikolwe fyabo fyalecita bakasesema.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.23",
            "verseOrgIds": [
              "LUK.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
