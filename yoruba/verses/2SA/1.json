      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:23"
      },
      "items": [
        {
          "text": "ní ọjọ́ ayé, wọ́n fẹ́ràn ara, wọn sì dùn,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.23",
            "verseOrgIds": [
              "2SA.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:23"
      },
      "items": [
        {
          "text": "ní ikú, wọn kò sì yà ara wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.23",
            "verseOrgIds": [
              "2SA.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 1:23"
      },
      "items": [
        {
          "text": "Wọ́n yára ju idì lọ,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.23",
            "verseOrgIds": [
              "2SA.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:23"
      },
      "items": [
        {
          "text": "wọ́n lágbára ju kìnnìún lọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.23",
            "verseOrgIds": [
              "2SA.1.23"
            ]
          }
        }
      ]
    },
