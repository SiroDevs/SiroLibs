      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 1:24"
      },
      "items": [
        {
          "text": "ẹni tí ó fi aṣọ ọ̀gbọ̀ dáradára wọ̀ yín,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.24",
            "verseOrgIds": [
              "2SA.1.24"
            ]
          }
        }
      ]
