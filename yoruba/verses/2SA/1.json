      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:25"
      },
      "items": [
        {
          "text": "Jonatani, ìwọ tí a pa ní òkè gíga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.25",
            "verseOrgIds": [
              "2SA.1.25"
            ]
          }
        }
      ]
    },
