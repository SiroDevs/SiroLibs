          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkàn mi gbọgbẹ́ fún ọ Jonatani arákùnrin mi;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.26",
            "verseOrgIds": [
              "2SA.1.26"
            ]
          }
        }
