      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:20"
      },
      "items": [
        {
          "text": "kí àwọn ọmọbìnrin aláìkọlà má ba à dunnú.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.20",
            "verseOrgIds": [
              "2SA.1.20"
            ]
          }
        }
      ]
    },
