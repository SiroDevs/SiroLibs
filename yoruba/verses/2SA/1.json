      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 1:21"
      },
      "items": [
        {
          "text": "Nítorí ibẹ̀ ni asà alágbára ti ṣègbé,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.21",
            "verseOrgIds": [
              "2SA.1.21"
            ]
          }
        }
      ]
    },
