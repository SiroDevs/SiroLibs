      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 1:26"
      },
      "items": [
        {
          "text": "Ìfẹ́ rẹ sí mi jẹ́ ìyanu,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.26",
            "verseOrgIds": [
              "2SA.1.26"
            ]
          }
        }
      ]
