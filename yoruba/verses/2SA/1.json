      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:21"
      },
      "items": [
        {
          "text": "asà Saulu, bí ẹni pé a kò fi òróró yàn án.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.21",
            "verseOrgIds": [
              "2SA.1.21"
            ]
          }
        }
      ]
    },
