          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ̀yin òkè Gilboa,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.21",
            "verseOrgIds": [
              "2SA.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:21"
      },
      "items": [
        {
          "text": "kí ẹ̀yin kí ó má ṣe rí ìrì tàbí òjò,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.21",
            "verseOrgIds": [
              "2SA.1.21"
            ]
          }
        }
      ]
    },
    {
