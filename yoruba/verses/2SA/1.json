      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:21"
      },
      "items": [
        {
          "text": "tàbí oko tí ó mú èso ọrẹ wá.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.21",
            "verseOrgIds": [
              "2SA.1.21"
            ]
          }
        }
      ]
    },
    {
