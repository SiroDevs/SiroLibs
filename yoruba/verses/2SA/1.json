      "attrs": {
        "style": "q2",
        "vid": "2SA 1:24"
      },
      "items": [
        {
          "text": "ẹni tí ó fi wúrà sí ara aṣọ yín.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.24",
            "verseOrgIds": [
              "2SA.1.24"
            ]
          }
        }
