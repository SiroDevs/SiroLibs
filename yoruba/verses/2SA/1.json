      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:26"
      },
      "items": [
        {
          "text": "ìwọ ṣọ̀wọ́n fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.26",
            "verseOrgIds": [
              "2SA.1.26"
            ]
          }
        }
      ]
