          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọrun Jonatani kì í padà",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.22",
            "verseOrgIds": [
              "2SA.1.22"
            ]
