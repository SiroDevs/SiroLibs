      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:26"
      },
      "items": [
        {
          "text": "ó jẹ́ ìyanu ju ti obìnrin lọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.26",
            "verseOrgIds": [
              "2SA.1.26"
            ]
          }
        }
      ]
