          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wò ó bí alágbára ti ṣubú ní ojú ogun!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.25",
            "verseOrgIds": [
              "2SA.1.25"
            ]
          }
        }
      ]
