      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:22"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni idà Saulu kì í padà lásán,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.22",
            "verseOrgIds": [
              "2SA.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 1:22"
      },
      "items": [
        {
          "text": "láì kan ẹ̀jẹ̀ àwọn tí a pa,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.22",
            "verseOrgIds": [
              "2SA.1.22"
            ]
          }
        }
      ]
    },
