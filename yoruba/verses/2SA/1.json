      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:22"
      },
      "items": [
        {
          "text": "àti ẹran àwọn alágbára.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.22",
            "verseOrgIds": [
              "2SA.1.22"
            ]
