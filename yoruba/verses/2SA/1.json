              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu àti Jonatani—",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.23",
            "verseOrgIds": [
              "2SA.1.23"
            ]
          }
        }
      ]
    },
