  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "2SA 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A yan Dafidi ní ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn àkókò yìí, Dafidi wádìí lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2SA.2.1",
                "verseOrgIds": [
                  "2SA.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ó sì béèrè pé, \"Ṣé èmi lè gòkè lọ sí ọ̀kan lára àwọn ìlú Juda?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2SA.2.1",
                "verseOrgIds": [
                  "2SA.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí pé, \"Gòkè lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:1"
      },
      "items": [
        {
          "text": "Dafidi sì béèrè pé, \"Ní ibo ni kí èmi kí ó lọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2SA.2.1",
                "verseOrgIds": [
                  "2SA.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sì dá a lóhùn pé, \"Sí Hebroni.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Dafidi gòkè lọ síbẹ̀ pẹ̀lú ìyàwó rẹ̀ méjì Ahinoamu ará Jesreeli, àti Abigaili obìnrin opó Nabali ti Karmeli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.2",
            "verseOrgIds": [
              "2SA.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì mú àwọn ọkùnrin tí ó wà pẹ̀lú rẹ̀, olúkúlùkù pẹ̀lú ìdílé rẹ̀, wọ́n sì ń gbé ní Hebroni àti ìlú rẹ̀ mìíràn.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.3",
            "verseOrgIds": [
              "2SA.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà àwọn ọkùnrin ará Juda wá sí Hebroni, níbẹ̀ ni wọ́n ti fi àmì òróró yan Dafidi gẹ́gẹ́ bí ọba lórí ilé Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:4"
      },
      "items": [
        {
          "text": "Nígbà tí wọ́n sọ fún Dafidi pé, àwọn ọkùnrin ti Jabesi Gileadi ni ó sin òkú Saulu,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi rán oníṣẹ́ sí àwọn ọkùnrin Jabesi Gileadi láti sọ fún wọn pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.5",
            "verseOrgIds": [
              "2SA.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2SA.2.5",
                "verseOrgIds": [
                  "2SA.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "bùkún un yín fún fífi inú rere yín hàn sí Saulu ọ̀gá yín nípa sí sin ín.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.5",
            "verseOrgIds": [
              "2SA.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.6",
            "verseOrgIds": [
              "2SA.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2SA.2.6",
                "verseOrgIds": [
                  "2SA.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kí ó fi inú rere àti òtítọ́ fún un yín, èmi náà yóò sì san oore yìí fún un yín, nítorí tí ẹ̀yin ti ṣe èyí.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.6",
            "verseOrgIds": [
              "2SA.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ nísinsin yìí, ẹ mú ara yín le, kí ẹ sì ní ìgboyà, nítorí Saulu ọba yín ti kú, ilé Juda sì ti fi àmì òróró yàn mí ní ọba lórí wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.7",
            "verseOrgIds": [
              "2SA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ogun láàrín ilé Dafidi àti Saulu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lákòókò yìí, Abneri ọmọ Neri olórí ogun Saulu ti mú Iṣboṣeti ọmọ Saulu, ó sì mú un kọjá sí Mahanaimu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.8",
            "verseOrgIds": [
              "2SA.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì fi jẹ ọba lórí Gileadi Aṣuri àti Jesreeli àti lórí Efraimu àti lórí Benjamini àti lórí gbogbo Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.9",
            "verseOrgIds": [
              "2SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iṣboṣeti ọmọ Saulu sì jẹ́ ọmọ ogójì ọdún nígbà tí ó jẹ ọba lórí Israẹli, ó sì jẹ ọba fún ọdún méjì. Ilé Juda sì ń tọ Dafidi lẹ́yìn.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.10",
            "verseOrgIds": [
              "2SA.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àkókò tí Dafidi fi jẹ ọba ní Hebroni lórí ilé Juda sì jẹ́ ọdún méje àti oṣù mẹ́fà.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.11",
            "verseOrgIds": [
              "2SA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abneri ọmọ Neri pẹ̀lú àwọn ọkùnrin ti Iṣboṣeti ọmọkùnrin Saulu kúrò ní Mahanaimu, wọ́n sì lọ sí Gibeoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.12",
            "verseOrgIds": [
              "2SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu ọmọ Seruiah pẹ̀lú àwọn ọkùnrin Dafidi jáde lọ láti lọ bá wọn ní adágún Gibeoni. Ẹgbẹ́ kan sì jókòó ní apá kan adágún, àti ẹgbẹ́ kejì ní apá kejì adágún.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.13",
            "verseOrgIds": [
              "2SA.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, Abneri sọ fún Joabu pé, \"Jẹ́ kí díẹ̀ nínú àwọn ọ̀dọ́mọkùnrin yìí ó dìde láti bá ara wọn jà níwájú wa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.14",
            "verseOrgIds": [
              "2SA.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:14"
      },
      "items": [
        {
          "text": "Joabu sì dáhùn pé, \"Ó dára, jẹ́ kí wọ́n ṣe é.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.14",
            "verseOrgIds": [
              "2SA.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni wọ́n dìde sókè, a sì kà wọ́n sí ọkùnrin méjìlá fún Benjamini àti Iṣboṣeti ọmọ Saulu àti méjìlá fún Dafidi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.15",
            "verseOrgIds": [
              "2SA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà olúkúlùkù ọkùnrin gbá ẹnìkejì rẹ̀ mú ní orí, ó sì fi idà gún ẹnìkejì rẹ̀ lẹ́gbẹ̀ẹ́, wọ́n sì ṣubú lulẹ̀ papọ̀. Bẹ́ẹ̀ ni ibẹ̀ ni Gibeoni ti à ń pè ni Helikatihu Hasurimu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.16",
            "verseOrgIds": [
              "2SA.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogun náà ní ọjọ́ náà gbóná. Àwọn ọmọkùnrin Dafidi sì ṣẹ́gun Abneri pẹ̀lú àwọn ọkùnrin Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.17",
            "verseOrgIds": [
              "2SA.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọkùnrin Seruiah mẹ́tẹ̀ẹ̀ta ni ó wà níbẹ̀: Joabu, Abiṣai àti Asaheli. Nísinsin yìí ẹsẹ̀ Asaheli sì fẹ́rẹ̀ bí ẹsẹ̀ èsúró tí ó wà ní pápá.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.18",
            "verseOrgIds": [
              "2SA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaheli sì ń lépa Abneri, bí òun tí ń lọ kò sì yípadà sí ọ̀tún tàbí sí òsì láti máa tọ́ Abneri lẹ́yìn.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.19",
            "verseOrgIds": [
              "2SA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abneri bojú wo ẹ̀yìn rẹ̀, Ó sì béèrè pé, \"Ṣé ìwọ Asaheli ni?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.20",
            "verseOrgIds": [
              "2SA.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:20"
      },
      "items": [
        {
          "text": "Ó dáhùn pé, \"Bẹ́ẹ̀ ni.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.20",
            "verseOrgIds": [
              "2SA.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, Abneri sọ fún un pé, \"Yípadà sí ọ̀tún tàbí òsì; mú ọ̀kan lára àwọn ọ̀dọ́mọkùnrin kí o sì bọ́ ìhámọ́ra rẹ.\" Ṣùgbọ́n Asaheli kọ̀ láti dẹ́kun lílépa rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.21",
            "verseOrgIds": [
              "2SA.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abneri tún kìlọ̀ fún Asaheli, \"Dẹ́kun lílépa mi! Èéṣe tí èmi yóò fi lù ọ́ bolẹ̀? Báwo ni èmi yóò ti wo arákùnrin rẹ Joabu lójú?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.22",
            "verseOrgIds": [
              "2SA.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ó sí kọ̀ láti padà, Abneri sì fi òdì ọ̀kọ̀ gún un lábẹ́ inú, ọ̀kọ̀ náà sì jáde ní ẹ̀yìn rẹ̀: òun sì ṣubú lulẹ̀ níbẹ̀, ó sì kú ní ibi kan náà; ó sí ṣe gbogbo ènìyàn tí ó dé ibi tí Asaheli gbé ṣubú si, tí ó sì kú, sì dúró jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.23",
            "verseOrgIds": [
              "2SA.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu àti Abiṣai sì lépa Abneri: oòrùn sì wọ̀, wọ́n sì dé òkè ti Amima tí o wà níwájú Giah lọ́nà ijù Gibeoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.24",
            "verseOrgIds": [
              "2SA.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Benjamini sì kó ara wọn jọ wọ́n tẹ̀lé Abneri, wọ́n sì wá di ẹgbẹ́ kan, wọ́n sì dúró lórí òkè kan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.25",
            "verseOrgIds": [
              "2SA.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abneri sì pe Joabu, ó sì bi í léèrè pé, \"Idà yóò máa parun títí láéláé bí? Ǹjẹ́ ìwọ kò ì tí ì mọ̀ pé yóò korò níkẹyìn? Ǹjẹ́ yóò ha ti pẹ́ tó kí ìwọ tó sọ fún àwọn ènìyàn náà, kí wọ́n dẹ́kun láti máa lépa arákùnrin wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.26",
            "verseOrgIds": [
              "2SA.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu sì wí pé, \"Bí Ọlọ́run ti ń bẹ, bí kò ṣe bí ìwọ ti wí, nítòótọ́ ní òwúrọ̀ ni àwọn ènìyàn náà ìbá padà lẹ́yìn arákùnrin wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.27",
            "verseOrgIds": [
              "2SA.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu sì fọ́n ìpè, gbogbo ènìyàn sì dúró jẹ́ẹ́, wọn kò sì lépa Israẹli mọ́, bẹ́ẹ̀ ni wọn kò sì tún jà mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.28",
            "verseOrgIds": [
              "2SA.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abneri àti àwọn ọmọkùnrin rẹ̀ sì fi gbogbo òru náà rìn ní pẹ̀tẹ́lẹ̀, wọ́n sì kọjá Jordani, wọ́n sì rìn ní gbogbo Bitironi, wọ́n sì wá sí Mahanaimu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.29",
            "verseOrgIds": [
              "2SA.2.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu sì dẹ́kun àti máa tọ Abneri lẹ́yìn: ó sì kó gbogbo àwọn ènìyàn náà jọ, ènìyàn mọ́kàndínlógún ni ó kú pẹ̀lú Asaheli nínú àwọn ìránṣẹ́ Dafidi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.30",
            "verseOrgIds": [
              "2SA.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn ìránṣẹ́ Dafidi sì pa nínú àwọn ènìyàn Benjamini: nínú àwọn ọmọkùnrin Abneri; òjìdínnírinwó (360) ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.31",
            "verseOrgIds": [
              "2SA.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n si gbé Asaheli wọ́n sì sin ín sínú ibojì baba rẹ̀ tí ó wà ní Bẹtilẹhẹmu. Joabu àti àwọn ọmọkùnrin rẹ̀ fi gbogbo òru náà rìn, ilẹ̀ sì mọ́ wọn sí Hebroni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.32",
            "verseOrgIds": [
              "2SA.2.32"
            ]
          }
        }
      ]
    }
  ],
