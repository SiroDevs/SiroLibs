                "verseOrgIds": [
                  "2SA.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "náà wá, wọ́n sì gbé e kalẹ̀ sípò rẹ̀ láàrín àgọ́ náà tí Dafidi pa fún un. Dafidi sì rú ẹbọ sísun àti ẹbọ ìrẹ́pọ̀ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.17",
            "verseOrgIds": [
              "2SA.6.17"
            ]
          }
        },
