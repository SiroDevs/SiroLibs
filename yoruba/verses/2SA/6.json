          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì parí ìṣe ẹbọ sísun àti ẹbọ ìrẹ́pọ̀ náà, ó sì súre fún àwọn ènìyàn náà ní orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.18",
            "verseOrgIds": [
              "2SA.6.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
