                "verseOrgIds": [
                  "2SA.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.21",
            "verseOrgIds": [
              "2SA.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ó sì tún rẹ ara mi sílẹ̀ jú bẹ́ẹ̀ lọ, èmi ó sì ṣe aláìníyìn lójú ara mi, àti lójú àwọn ìránṣẹ́bìnrin náà ti ìwọ wí, lọ́dọ̀ wọn náà ni èmi ó sì ní ògo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.22",
            "verseOrgIds": [
              "2SA.6.22"
            ]
          }
        }
      ]
    },
