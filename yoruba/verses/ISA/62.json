    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Orúkọ Sioni tuntun",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 62:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí Sioni èmi kì yóò dákẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:1"
      },
      "items": [
        {
          "text": "nítorí i Jerusalẹmu èmi kì yóò sinmi ẹnu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:1"
      },
      "items": [
        {
          "text": "títí tí òdodo rẹ̀ yóò fi tàn bí òwúrọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:1"
      },
      "items": [
        {
          "text": "àti ìgbàlà rẹ̀ bí i fìtílà tí ń jó geere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 62:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn orílẹ̀-èdè yóò rí òdodo rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:2"
      },
      "items": [
        {
          "text": "àti gbogbo ọba ògo rẹ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:2"
      },
      "items": [
        {
          "text": "a ó sì máa pè ọ́ ní orúkọ mìíràn",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:2"
      },
      "items": [
        {
          "text": "èyí tí ẹnu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.62.2",
                "verseOrgIds": [
                  "ISA.62.2"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò fi fún un.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 62:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò sì jẹ́ adé dídán ní ọwọ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.3",
            "verseOrgIds": [
              "ISA.62.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.62.3",
                "verseOrgIds": [
                  "ISA.62.3"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.3",
            "verseOrgIds": [
              "ISA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:3"
      },
      "items": [
        {
          "text": "adé ọba ní ọwọ́ Ọlọ́run rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.3",
            "verseOrgIds": [
              "ISA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 62:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn kì yóò pè ọ́ ní ìkọ̀sílẹ̀ mọ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:4"
      },
      "items": [
        {
          "text": "tàbí kí wọ́n pe ilẹ̀ rẹ ní ahoro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:4"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n a ó máa pè ọ́ ní Hẹfsiba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:4"
      },
      "items": [
        {
          "text": "àti ilẹ̀ rẹ ní Beula;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:4"
      },
      "items": [
        {
          "text": "nítorí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.62.4",
                "verseOrgIds": [
                  "ISA.62.4"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò yọ́nú sí ọ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:4"
      },
      "items": [
        {
          "text": "àti ilẹ̀ rẹ ni a ó gbé níyàwó.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 62:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí ọ̀dọ́mọkùnrin tí í gbé ọ̀dọ́mọbìnrin níyàwó,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:5"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni àwọn ọmọkùnrin rẹ yóò gbé ọ níyàwó",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:5"
      },
      "items": [
        {
          "text": "Gẹ́gẹ́ bí ọkọ ìyàwó ṣe é yọ̀ lórí ìyàwó rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:5"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni Ọlọ́run rẹ yóò yọ̀ lórí rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 62:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ti fi olùṣọ́ ránṣẹ́ sórí odi rẹ ìwọ Jerusalẹmu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:6"
      },
      "items": [
        {
          "text": "wọn kì yóò lè dákẹ́ tọ̀sán tòru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:6"
      },
      "items": [
        {
          "text": "Ẹ̀yin tí ń ké pe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.62.6",
                "verseOrgIds": [
                  "ISA.62.6"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:6"
      },
      "items": [
        {
          "text": "ẹ má ṣe fúnra yín ní ìsinmi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 62:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti kí ẹ má ṣe fún òun pẹ̀lú ní ìsinmi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.7",
            "verseOrgIds": [
              "ISA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:7"
      },
      "items": [
        {
          "text": "títí tí yóò fi fi ìdí Jerusalẹmu múlẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.7",
            "verseOrgIds": [
              "ISA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:7"
      },
      "items": [
        {
          "text": "tí yóò sì fi ṣe ìyìn orí ilẹ̀ ayé.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.7",
            "verseOrgIds": [
              "ISA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 62:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.62.8",
                "verseOrgIds": [
                  "ISA.62.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ti búra pẹ̀lú ọwọ́ ọ̀tún rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:8"
      },
      "items": [
        {
          "text": "àti nípa agbára apá rẹ:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:8"
      },
      "items": [
        {
          "text": "\"Èmi kì yóò jẹ́ kí ìyẹ̀fun rẹ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:8"
      },
      "items": [
        {
          "text": "di oúnjẹ fún ọ̀tá rẹ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:8"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni àwọn àjèjì kì yóò mu wáìnì",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:8"
      },
      "items": [
        {
          "text": "tuntun rẹ mọ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:8"
      },
      "items": [
        {
          "text": "èyí tí ìwọ ti ṣe làálàá fún;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 62:9"
          },
          "items": [
