          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ohun tí Olúwa sọ fún mi: \"Láàrín ọdún kan, gẹ́gẹ́ bí ìwọ̀fà tí ó wà lábẹ́ ọgbà, í ti í kà á, gbogbo ògo ìlú Kedari yóò wá sí òpin.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.16",
            "verseOrgIds": [
              "ISA.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tafàtafà tí ó sálà, àwọn jagunjagun ìlú Kedari kò ní tó nǹkan.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.17",
            "verseOrgIds": [
              "ISA.21.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.21.17",
                "verseOrgIds": [
                  "ISA.21.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli ni ó ti sọ̀rọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.17",
            "verseOrgIds": [
              "ISA.21.17"
            ]
          }
        }
      ]
