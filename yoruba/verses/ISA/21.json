      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:11"
      },
      "items": [
        {
          "text": "\"Alóre, kí ló kù nínú òru náà?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.11",
            "verseOrgIds": [
              "ISA.21.11"
