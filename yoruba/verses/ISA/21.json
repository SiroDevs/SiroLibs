      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:12"
      },
      "items": [
        {
          "text": "kí o sì tún padà wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.12",
            "verseOrgIds": [
              "ISA.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àsọtẹ́lẹ̀ tó lòdì sí Arabia",
