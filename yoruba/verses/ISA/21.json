          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀-ìmọ̀ tí ó kan Arabia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.13",
            "verseOrgIds": [
              "ISA.21.13"
