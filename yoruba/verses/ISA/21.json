  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "ISA 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àsọtẹ́lẹ̀ tó lòdì sí Babeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀-ìmọ̀ tí ó kan aginjù lẹ́bàá Òkun.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:1"
      },
      "items": [
        {
          "text": "Gẹ́gẹ́ bí ìjì líle ti í jà kọjá ní gúúsù,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:1"
      },
      "items": [
        {
          "text": "akógunjàlú kan wá láti aginjù,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:1"
      },
      "items": [
        {
          "text": "láti ilẹ̀ ìpayà.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìran tí a ń fojú ṣọ́nà fún ni a ti fihàn mí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "ọlọ̀tẹ̀ ti tu àṣírí, fọ́lé fọ́lé ti kẹ́rù.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "Elamu kojú ìjà! Media ti tẹ̀gùn!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "Èmi yóò mú gbogbo ìpayínkeke dópin,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "ni ó búra.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú èyí, ìrora mu mi lára gírígírí,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "ìrora gbá mi mú, gẹ́gẹ́ bí i ti",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "obìnrin tí ń rọbí,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "mo ta gbọ̀nọ́ngbọ̀nọ́n nítorí ohun tí mo gbọ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "ọkàn mi pòruurù nípa ohun tí mo rí.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkàn mí dàrú,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:4"
      },
      "items": [
        {
          "text": "ẹ̀rù mú jìnnìjìnnì bá mi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:4"
      },
      "items": [
        {
          "text": "ìmọ́lẹ̀ tí mo ti ń fẹ́ ẹ́ rí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:4"
      },
      "items": [
        {
          "text": "ti wá di ìpayà fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n tẹ́ tábìlì,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "wọ́n tẹ́ ẹní àtẹ́ẹ̀ká,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "wọ́n jẹ, wọ́n mu!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "Dìde nílẹ̀, ẹ̀yin ọmọ-aládé,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "ẹ fi òróró kún asà yín!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ohun tí Olúwa sọ fún mi:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.6",
            "verseOrgIds": [
              "ISA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:6"
      },
      "items": [
        {
          "text": "\"Lọ, kí o bojúwòde",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.6",
            "verseOrgIds": [
              "ISA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:6"
      },
      "items": [
        {
          "text": "kí o sì wá sọ ohun tí ó rí.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.6",
            "verseOrgIds": [
              "ISA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó bá rí àwọn kẹ̀kẹ́ ogun",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "àti àkójọpọ̀ àwọn ẹṣin,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "àwọn tó ń gun kẹ́tẹ́kẹ́tẹ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "tàbí àwọn tí ó gun ìbákasẹ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "jẹ́ kí ó múra sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "àní ìmúra gidigidi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun sì kígbe pé, kìnnìún kan,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.8",
            "verseOrgIds": [
              "ISA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:8"
      },
      "items": [
        {
          "text": "\"Láti ọjọ́ dé ọjọ́, olúwa mi, mo dúró lórí ilé ìṣọ́ ní ọ̀sán,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.8",
            "verseOrgIds": [
              "ISA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:8"
      },
      "items": [
        {
          "text": "a sì fi mí ìṣọ́ mi ní gbogbo òru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.8",
            "verseOrgIds": [
              "ISA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wò ó, ọkùnrin kan ni ó ń bọ̀ wá yìí nínú kẹ̀kẹ́ ogun",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "àti àkójọpọ̀ àwọn ẹṣin.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "Ó sì mú ìdáhùn padà wá:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "'Babeli ti ṣubú, ó ti ṣubú!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "Gbogbo àwọn ère òrìṣà rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "ló fọ́nká sórí ilẹ̀!' \"",
