          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà adití yóò gbọ́ ọ̀rọ̀ ìwé kíká náà,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.18",
            "verseOrgIds": [
