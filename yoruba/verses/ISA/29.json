          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn tí ń rìn ségesège ní yóò jèrè ìmọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.24",
            "verseOrgIds": [
              "ISA.29.24"
            ]
          }
        }
      ]
    },
