      "attrs": {
        "style": "q2",
        "vid": "ISA 29:18"
      },
      "items": [
        {
          "text": "láti inú fìrífìrí àti òkùnkùn",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.18",
            "verseOrgIds": [
              "ISA.29.18"
            ]
          }
        }
      ]
    },
