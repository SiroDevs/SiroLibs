      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:13"
      },
      "items": [
        {
          "text": "\"Àwọn ènìyàn yìí súnmọ́ ọ̀dọ̀ mi pẹ̀lú ẹnu wọn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:13"
      },
      "items": [
        {
          "text": "wọ́n sì bọ̀wọ̀ fún mi pẹ̀lú ètè wọn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:13"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ọkàn wọn jìnnà sí mi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
    },
    {
