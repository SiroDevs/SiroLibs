      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:15"
      },
      "items": [
        {
          "text": "\"Ta ló rí wa? Ta ni yóò mọ̀?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.15",
            "verseOrgIds": [
              "ISA.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
