      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:14"
      },
      "items": [
        {
          "text": "ọgbọ́n àwọn ọlọ́gbọ́n ni yóò ṣègbé,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.14",
            "verseOrgIds": [
              "ISA.29.14"
            ]
          }
        }
      ]
    },
