      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:24"
      },
      "items": [
        {
          "text": "gbogbo àwọn tí ń ṣe àròyé yóò gba ìtọ́sọ́nà.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.24",
            "verseOrgIds": [
              "ISA.29.24"
            ]
