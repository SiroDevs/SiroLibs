      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:16"
      },
      "items": [
        {
          "text": "bí ẹni pé wọ́n rò pé amọ̀kòkò dàbí amọ̀!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.16",
            "verseOrgIds": [
              "ISA.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:16"
      },
      "items": [
        {
          "text": "Ǹjẹ́ ohun tí a ṣe le sọ fún olùṣe pé,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.16",
            "verseOrgIds": [
              "ISA.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:16"
      },
      "items": [
        {
          "text": "\"Òun kọ́ ló ṣe mí\"?",
