      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:15"
      },
      "items": [
        {
          "text": "tí wọ́n sì rò pé,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.15",
            "verseOrgIds": [
              "ISA.29.15"
            ]
          }
        }
      ]
    },
