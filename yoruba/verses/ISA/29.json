      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:13"
      },
      "items": [
        {
          "text": "Ìsìn wọn si mi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
    },
    {
