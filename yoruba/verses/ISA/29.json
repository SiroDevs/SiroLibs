      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:16"
      },
      "items": [
        {
          "text": "Ǹjẹ́ ìkòkò lè sọ nípa amọ̀kòkò pé,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.16",
            "verseOrgIds": [
              "ISA.29.16"
            ]
          }
        }
      ]
    },
