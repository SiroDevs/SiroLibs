            "sid": "ISA 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn tí wọ́n fi ọ̀rọ̀ kan mú ẹnìkan di ẹlẹ́bi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.21",
            "verseOrgIds": [
              "ISA.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:21"
      },
      "items": [
        {
          "text": "ẹni tí ń dẹkùn mú olùgbèjà ní ilé ẹjọ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.21",
            "verseOrgIds": [
              "ISA.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:21"
      },
      "items": [
        {
          "text": "tí ẹ fi ẹ̀rí èké dun aláìṣẹ̀ ní ìdájọ́.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.21",
            "verseOrgIds": [
              "ISA.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.22",
            "verseOrgIds": [
              "ISA.29.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.29.22",
                "verseOrgIds": [
                  "ISA.29.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹni tí ó ra Abrahamu padà sọ sí ilé Jakọbu:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.22",
            "verseOrgIds": [
              "ISA.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:22"
      },
      "items": [
        {
          "text": "\"Ojú kì yóò ti Jakọbu mọ́;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.22",
            "verseOrgIds": [
              "ISA.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:22"
      },
      "items": [
        {
          "text": "ojú wọn kì yóò sì rẹ̀wẹ̀sì mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.22",
            "verseOrgIds": [
              "ISA.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n bá rí i láàrín àwọn ọmọ wọn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.23",
            "verseOrgIds": [
              "ISA.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:23"
      },
      "items": [
        {
          "text": "àwọn iṣẹ́ ọwọ́ mi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.23",
            "verseOrgIds": [
              "ISA.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:23"
      },
      "items": [
        {
          "text": "wọn yóò ya orúkọ mi sí mímọ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.23",
            "verseOrgIds": [
              "ISA.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:23"
      },
      "items": [
        {
          "text": "wọn yóò tẹ́wọ́gbà mímọ́ Ẹni Mímọ́ Jakọbu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.23",
            "verseOrgIds": [
              "ISA.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:23"
      },
      "items": [
        {
          "text": "wọn yóò dìde dúró ní ìbọ̀wọ̀ fún Ọlọ́run Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.23",
            "verseOrgIds": [
              "ISA.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
