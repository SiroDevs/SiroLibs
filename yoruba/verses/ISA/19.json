      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:13"
      },
      "items": [
        {
          "text": "a ti tan àwọn ọmọ-aládé Memfisi jẹ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.13",
            "verseOrgIds": [
              "ISA.19.13"
            ]
          }
        }
      ]
    },
    {
