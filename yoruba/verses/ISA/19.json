                "verseId": "ISA.19.14",
                "verseOrgIds": [
                  "ISA.19.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ti da ẹ̀mí òòyì sínú wọn;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.14",
            "verseOrgIds": [
              "ISA.19.14"
            ]
          }
        }
      ]
