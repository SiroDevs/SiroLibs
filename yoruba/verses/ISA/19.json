      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:13"
      },
      "items": [
        {
          "text": "àwọn òkúta igun ilé tí í ṣe ti ẹ̀yà rẹ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.13",
            "verseOrgIds": [
              "ISA.19.13"
            ]
          }
        }
      ]
    },
    {
