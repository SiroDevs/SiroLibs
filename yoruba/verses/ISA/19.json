      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "àwọn ọlọ́gbọ́n olùdámọ̀ràn Farao",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "ń mú ìmọ̀ràn àìgbọ́n wá.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "Báwo ló ṣe lè sọ fún Farao pé,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
