      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "\"Mo jẹ́ ọ̀kan nínú àwọn ọlọ́gbọ́n ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
