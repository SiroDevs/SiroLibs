      },
      "items": [
        {
          "text": "ọ̀kan nínú àwọn ọmọ-ẹ̀yìn àwọn ọba àtijọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
