      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:12"
      },
      "items": [
        {
          "text": "Jẹ́ kí wọn fihàn ọ́ kí wọn sì sọ ọ́ di mí mọ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.12",
            "verseOrgIds": [
