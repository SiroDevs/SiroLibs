                "verseOrgIds": [
                  "ISA.19.12"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.12",
            "verseOrgIds": [
              "ISA.19.12"
            ]
          }
