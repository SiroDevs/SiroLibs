      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:12"
      },
      "items": [
        {
          "text": "ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.12",
            "verseOrgIds": [
              "ISA.19.12"
