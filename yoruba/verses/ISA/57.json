  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "57",
        "style": "c",
        "sid": "ISA 57"
      },
      "items": [
        {
          "text": "57",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 57:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olódodo ṣègbé",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "kò sí ẹnìkan tí ó rò ó lọ́kàn ara rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "a mú àwọn ẹni mímọ́ lọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "kò sì ṣí ẹni tó yé",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "pé a ti mú àwọn olódodo lọ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "láti yọ wọ́n kúrò nínú ibi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 57:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn tí ń rìn déédé",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:2"
      },
      "items": [
        {
          "text": "ń wọ inú àlàáfíà;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:2"
      },
      "items": [
        {
          "text": "wọ́n rí ìsinmi bí wọ́n ti ń sùn nínú ikú.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 57:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n ẹ súnmọ́ ìhìn-ín, ẹ̀yin ọmọ aláfọ̀ṣẹ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.3",
            "verseOrgIds": [
              "ISA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:3"
      },
      "items": [
        {
          "text": "ẹ̀yin irú-ọmọ panṣágà àti àgbèrè!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.3",
            "verseOrgIds": [
              "ISA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 57:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó fi ń ṣẹlẹ́yà?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "Ta ni o ń yọ ṣùtì sí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "tí o sì yọ ahọ́n síta?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "Ẹ̀yin kì í ha ṣe ọlọ̀tẹ̀ ènìyàn bí,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "àti ìran àwọn òpùrọ́?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 57:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gbinájẹ fún ìṣekúṣe láàrín igi óákù",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:5"
      },
      "items": [
        {
          "text": "àti lábẹ́ gbogbo igi tí ń gbilẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:5"
      },
      "items": [
        {
          "text": "ẹ fi àwọn ọmọ yín rú ẹbọ nínú kòtò jíjìn",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:5"
      },
      "items": [
        {
          "text": "àti lábẹ́ àwọn pàlàpálá òkúta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 57:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ère tí ó wà ní àárín òkúta dídán",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "wọ́n n nì, nínú kòtò jíjìn ni ìpín in yín;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "àwọ̀n ni ìpín in yín.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "Bẹ́ẹ̀ ni, sí wọn ni ẹ ti ta ọrẹ ohun mímu yín sílẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "àti láti ta ọrẹ ìyẹ̀fun.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "Nítorí àwọn nǹkan wọ̀nyí, ǹjẹ́ ó yẹ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "kí n dáwọ́ dúró?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 57:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti ṣe ibùsùn rẹ lórí òkè gíga tí ó rẹwà;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.7",
            "verseOrgIds": [
              "ISA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:7"
      },
      "items": [
        {
          "text": "níbẹ̀ ni ẹ lọ láti lọ ṣe ìrúbọ yín.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.7",
            "verseOrgIds": [
              "ISA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 57:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn àwọn ìlẹ̀kùn yín àti òpó ìlẹ̀kùn yín",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "níbẹ̀ ni ẹ fi àwọn àmì òrìṣà yín sí.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "Ní kíkọ̀ mí sílẹ̀, ẹ ṣí ibùsùn yín sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "ẹ gun orí rẹ̀ lọ, ẹ sì ṣí i sílẹ̀ gbagada;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "ẹ ṣe àdéhùn pẹ̀lú àwọn tí ẹ fẹ́ràn ibùsùn wọn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "ẹ̀yin sì ń wo ìhòhò wọn.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 57:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin lọ sí Moleki pẹ̀lú òróró olifi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:9"
      },
      "items": [
        {
          "text": "ẹ sì fi kún òórùn dídùn yín.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:9"
      },
      "items": [
        {
          "text": "Ẹ rán ikọ̀ yín lọ jìnnà réré;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:9"
      },
      "items": [
        {
          "text": "ẹ sọ̀kalẹ̀ sí ibojì pẹ̀lú!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 57:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀nà yín gbogbo ti mú àárẹ̀ ba á yín,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:10"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ẹ kò ní sọ pé, 'Kò sí ìrètí mọ́?'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:10"
      },
      "items": [
        {
          "text": "Ẹ rí okun kún agbára yín,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:10"
      },
      "items": [
        {
          "text": "nípa bẹ́ẹ̀ òòyì kò kọ́ ọ yín.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 57:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ta ni ó ń pá yín láyà tí ń bà yín lẹ́rù",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.11",
            "verseOrgIds": [
              "ISA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:11"
      },
      "items": [
        {
          "text": "tí ẹ fi ń ṣèké sí mi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.11",
            "verseOrgIds": [
              "ISA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:11"
      },
      "items": [
        {
          "text": "àti tí ẹ̀yin kò fi rántí mi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.11",
            "verseOrgIds": [
              "ISA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:11"
      },
      "items": [
        {
          "text": "tàbí kí ẹ rò yí nínú ọkàn yín?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.11",
            "verseOrgIds": [
              "ISA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:11"
      },
      "items": [
        {
          "text": "Ǹjẹ́ kì í ṣe nítorí dídákẹ́ jẹ́ẹ́ mi fún ìgbà pípẹ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.11",
            "verseOrgIds": [
              "ISA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:11"
      },
      "items": [
        {
          "text": "tí ẹ̀yin kò fi bẹ̀rù mi?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.11",
            "verseOrgIds": [
              "ISA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 57:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò ṣí òdodo yín páyà àti iṣẹ́ yín,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.12",
            "verseOrgIds": [
              "ISA.57.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:12"
      },
      "items": [
        {
          "text": "wọn kì yóò sì ṣe yín ní àǹfààní.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.12",
            "verseOrgIds": [
              "ISA.57.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 57:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ẹ bá kígbe fún ìrànlọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.13",
            "verseOrgIds": [
              "ISA.57.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:13"
      },
      "items": [
        {
          "text": "ẹ jẹ́ kí àkójọ àwọn ère yín gbà yín!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.13",
            "verseOrgIds": [
              "ISA.57.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:13"
      },
      "items": [
        {
          "text": "Atẹ́gùn yóò gbá gbogbo wọn lọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.13",
            "verseOrgIds": [
              "ISA.57.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:13"
      },
      "items": [
        {
          "text": "èémí lásán làsàn ni yóò gbá wọn lọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.13",
            "verseOrgIds": [
              "ISA.57.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:13"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n ẹni tí ó bá fi mí ṣe ààbò rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.13",
            "verseOrgIds": [
              "ISA.57.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:13"
      },
      "items": [
        {
          "text": "ni yóò jogún ilẹ̀ náà",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.13",
            "verseOrgIds": [
              "ISA.57.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:13"
      },
      "items": [
        {
          "text": "yóò sì jogún òkè mímọ́ mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.13",
            "verseOrgIds": [
              "ISA.57.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìtùnú fún àwọn oníròbìnújẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 57:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ó sì sọ wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.14",
            "verseOrgIds": [
              "ISA.57.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:14"
      },
      "items": [
        {
          "text": "\"Tún mọ, tún mọ, tún ọ̀nà náà ṣe!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.14",
            "verseOrgIds": [
              "ISA.57.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:14"
      },
      "items": [
        {
          "text": "Ẹ mú àwọn ohun ìkọ̀sẹ̀ kúrò ní ọ̀nà àwọn ènìyàn mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.14",
            "verseOrgIds": [
              "ISA.57.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 57:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èyí ni ohun tí Ẹni gíga àti ọlọ́lá jùlọ wí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.15",
            "verseOrgIds": [
              "ISA.57.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:15"
      },
      "items": [
        {
          "text": "ẹni tí ó wà títí láé, tí orúkọ rẹ̀ jẹ́ mímọ́:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.15",
            "verseOrgIds": [
              "ISA.57.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:15"
      },
      "items": [
        {
          "text": "\"Mo ń gbé ní ibi gíga àti ibi mímọ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.15",
            "verseOrgIds": [
              "ISA.57.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:15"
      },
      "items": [
        {
          "text": "ṣùgbọ́n pẹ̀lú ẹni n nì tí ó ní ìròbìnújẹ́ àti ẹ̀mí ìrẹ̀lẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.15",
            "verseOrgIds": [
              "ISA.57.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:15"
      },
      "items": [
        {
          "text": "láti sọ ẹ̀mí onírẹ̀lẹ̀ náà jí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.15",
            "verseOrgIds": [
              "ISA.57.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:15"
      },
      "items": [
        {
          "text": "àti láti sọ ẹ̀mí oníròbìnújẹ́ n nì jí.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.15",
            "verseOrgIds": [
              "ISA.57.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 57:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi kì yóò fẹ̀sùn kan ni títí láé,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.16",
            "verseOrgIds": [
              "ISA.57.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:16"
      },
      "items": [
        {
          "text": "tàbí kí n máa bínú sá á,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.16",
            "verseOrgIds": [
              "ISA.57.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:16"
      },
      "items": [
        {
          "text": "nítorí nígbà náà ni ọkàn ènìyàn yóò",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.16",
            "verseOrgIds": [
              "ISA.57.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:16"
      },
      "items": [
        {
          "text": "rẹ̀wẹ̀sì níwájú mi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.16",
            "verseOrgIds": [
              "ISA.57.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:16"
      },
      "items": [
        {
          "text": "èémí ènìyàn tí mo ti dá.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.16",
            "verseOrgIds": [
              "ISA.57.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 57:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inú bí mi nítorí ẹ̀ṣẹ̀ ọ̀kánjúwà rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.17",
            "verseOrgIds": [
              "ISA.57.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:17"
      },
      "items": [
        {
          "text": "mo fìyà jẹ ẹ́, mo sì fojú mi pamọ́ ní ìbínú;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.17",
            "verseOrgIds": [
              "ISA.57.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:17"
      },
      "items": [
        {
          "text": "síbẹ̀, ó tẹ̀síwájú nínú tinú-mi-ni n ó ṣe ọ̀nà rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.17",
            "verseOrgIds": [
              "ISA.57.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 57:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ti rí ọ̀nà rẹ̀ gbogbo, ṣùgbọ́n Èmi yóò wò ó sàn;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.18",
            "verseOrgIds": [
              "ISA.57.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:18"
      },
      "items": [
        {
          "text": "Èmi yóò tọ́ ọ ṣọ́nà n ó sì mú ìtùnú tọ̀ ọ́ wá,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.18",
            "verseOrgIds": [
              "ISA.57.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 57:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ní dídá ìyìn sí ètè àwọn tí ń ṣọ̀fọ̀ ní Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.19",
            "verseOrgIds": [
              "ISA.57.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:19"
      },
      "items": [
        {
          "text": "Àlàáfíà, àlàáfíà fún àwọn tí ó wà lókèèrè àti nítòsí,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.19",
            "verseOrgIds": [
              "ISA.57.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:19"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.19",
            "verseOrgIds": [
              "ISA.57.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.57.19",
                "verseOrgIds": [
                  "ISA.57.19"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, \"Àti pé, Èmi yóò wo wọ́n sàn.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.19",
            "verseOrgIds": [
              "ISA.57.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
