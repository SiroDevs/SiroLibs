            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà, obìnrin méje",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "yóò dì mọ́ ọkùnrin kan",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "yóò sì wí pé, \"Àwa ó máa jẹ oúnjẹ ara wa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "a ó sì pèsè aṣọ ara wa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "sá à jẹ́ kí a máa fi orúkọ rẹ̀ pè wá.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "Mú ẹ̀gàn wa kúrò!\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ̀ka",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "náà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà, ẹ̀ka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
            "verseOrgIds": [
              "ISA.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.4.2",
                "verseOrgIds": [
                  "ISA.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò ní ẹwà àti ògo, èso ilẹ̀ náà yóò sì jẹ́ ìgbéraga àti ògo àwọn ti ó sálà ní Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
            "verseOrgIds": [
              "ISA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó ṣẹ́kù ní Sioni, àwọn tí o kù ní Jerusalẹmu, ni a ó pè ní mímọ́, orúkọ àwọn ẹni tí a kọ mọ́ àwọn alààyè ní Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.3",
            "verseOrgIds": [
              "ISA.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olúwa yóò wẹ ẹ̀gbin àwọn obìnrin Sioni kúrò yóò sì fọ gbogbo àbàwọ́n ẹ̀jẹ̀ kúrò ní Jerusalẹmu pẹ̀lú ẹ̀mí ìdájọ́ àti ẹ̀mí iná.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.4",
            "verseOrgIds": [
              "ISA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.4.5",
                "verseOrgIds": [
                  "ISA.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò dá sórí òkè Sioni àti sórí i gbogbo àwọn tí ó péjọpọ̀ síbẹ̀, kurukuru èéfín ní ọ̀sán àti ìtànṣán ọ̀wọ́-iná ní òru, lórí gbogbo ògo yìí ni ààbò yóò wà.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni yóò jẹ́ ààbò àti òjìji kúrò lọ́wọ́ ooru ọ̀sán, àti ààbò òun ibi ìsádi kúrò lọ́wọ́ ìjì àti òjò.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
          }
        }
      ]
    }
  ],
