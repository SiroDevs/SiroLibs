  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "48",
        "style": "c",
        "sid": "EZK 48"
      },
      "items": [
        {
          "text": "48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pínpín ilẹ̀ náà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ̀nyí ni àwọn ẹ̀yà tí a kọ sílẹ̀ pẹ̀lú orúkọ wọn:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 48:1"
      },
      "items": [
        {
          "text": "\"Ní òpin àríwá, Dani yóò ni ìpín kan; èyí yóò tẹ̀lé ọ̀nà Hetiloni lọ sí Lebo-Hamati; Hasari-Enani àti ààlà àríwá tí Damasku tí ó kángun sí Hamati yóò jẹ́ ara ààlà rẹ̀ láti ìhà ìlà-oòrùn títí lọ sí ìhà ìwọ̀-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aṣeri yóò ní ìpín kan; yóò jẹ́ ààlà agbègbè Dani láti ìlà-oòrùn lọ sí ìwọ̀-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naftali yóò ní ìpín kan; èyí yóò jẹ́ ààlà agbègbè Aṣeri láti ìlà-oòrùn lọ sí ìwọ̀-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase yóò ní ìpín; èyí yóò jẹ́ ààlà ti agbègbè Naftali láti ìlà-oòrùn sí ìwọ̀-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efraimu yóò ní ìpín kan; èyí yóò jẹ́ ààlà agbègbè Manase láti ìlà-oòrùn lọ sí ìwọ̀-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reubeni yóò ní ìpín kan; èyí yóò jẹ́ ààlà agbègbè Efraimu láti ìlà-oòrùn títí dé ìwọ̀-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juda yóò ní ìpín kan; èyí yóò jẹ́ ààlà agbègbè Reubeni láti ìlà-oòrùn lọ sí ìwọ̀-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní agbègbè Juda, láti ìhà ìlà-oòrùn dé ìhà ìwọ̀-oòrùn ni yóò jẹ́ ìpín tí ìwọ yóò gbé kalẹ̀ gẹ́gẹ́ bí ẹ̀bùn pàtàkì. Èyí tí yóò jẹ́ ẹgbẹ̀rún mẹ́ẹ̀ẹ́dọ́gbọ̀n ìgbọ̀nwọ́ (25,000) ní ìbú, gígùn rẹ̀ láti ìlà-oòrùn lọ sí ìwọ̀-oòrùn yóò jẹ́ bákan náà bí ọ̀kan nínú àwọn ìpín ìyókù; láti ìhà ìlà-oòrùn dé ìhà ìwọ̀-oòrùn, ibi mímọ́ yóò sì wà ní àárín gbùngbùn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìpín pàtàkì tí ìwọ yóò fi fún",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.9",
                "verseOrgIds": [
                  "EZK.48.9"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò jẹ́ ẹgbẹ̀rún mẹ́ẹ̀ẹ́dọ́gbọ̀n (25,000) ní gígùn àti ẹgbẹ̀rún mẹ́wàá (10,000) ìgbọ̀nwọ́ ni ìbú.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí yóò jẹ́ ìpín ibi mímọ́ fún àwọn àlùfáà. Èyí yóò jẹ́ ẹgbẹ̀rún mẹ́ẹ̀ẹ́dọ́gbọ̀n (25,000) ìgbọ̀nwọ́ ni gígùn ní ìhà àríwá, ẹgbẹ̀rún mẹ́wàá (10,000) ìgbọ̀nwọ́ ni ìhà ìlà-oòrùn, ó sì jẹ́ ẹgbẹ̀rún mẹ́ẹ̀ẹ́dọ́gbọ̀n (25,000) ìgbọ̀nwọ́ ní gígùn ní ìhà gúúsù. Ní àárín gbùngbùn rẹ̀ ní ilé fún",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.10",
                "verseOrgIds": [
                  "EZK.48.10"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò wà.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí yóò wà fún àwọn àlùfáà tí a yà sí mímọ́, àwọn ọmọ Sadoku tí wọn jẹ́ olóòtítọ́ nínú sí sìn mí, tiwọn kò sì ṣáko lọ bí ti àwọn Lefi ṣe ṣe nígbà tí àwọn Israẹli ṣáko lọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí yóò jẹ́ ọrẹ pàtàkì fún wọn láti ara ìpín ibi mímọ́ ilẹ̀ náà, ìpín tí ó jẹ́ mímọ́ jùlọ, tí ó jẹ́ ààlà agbègbè àwọn Lefi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní àkọjúsí agbègbè àwọn àlùfáà, àwọn Lefi yóò pín ìpín kan tí ó jẹ́ ẹgbẹ̀rún mẹ́ẹ̀ẹ́dọ́gbọ̀n (25,000) ìgbọ̀nwọ́ ní gígùn àti ẹgbẹ̀rún mẹ́wàá (10,000) ìgbọ̀nwọ́ ní ìbú. Gígùn rẹ̀ ní àpapọ̀ yóò jẹ́ ẹgbẹ̀rún mẹ́ẹ̀ẹ́dọ́gbọ̀n (25,000) ìgbọ̀nwọ́, àti inú rẹ̀ yóò jẹ́ ẹgbẹ̀rún mẹ́wàá (10,000) ìgbọ̀nwọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn kò gbọdọ̀ tà tàbí pààrọ̀ ọ̀kankan nínú rẹ̀. Èyí yìí ni ó dára jùlọ lára ilẹ̀ náà, a kò sì gbọdọ̀ fi fún ẹlòmíràn nítorí pé ó jẹ́ mímọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.14",
                "verseOrgIds": [
                  "EZK.48.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Agbègbè tí o ṣẹ́kù, tí ń ṣe ẹgbẹ̀rún márùn-ún (5,000) ìgbọ̀nwọ́ ni ìbú àti ẹgbẹ̀rún mẹ́ẹ̀ẹ́dọ́gbọ̀n (25,000) ìgbọ̀nwọ́ ní gígùn, yóò jẹ́ ibi àìmọ́ fun ìlú ńlá náà fún ilé gbígbé àti fún agbègbè. Ìlú ńlá náà yóò wà ní àárín rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìwọ̀nyí sì níbi a ṣe wọ́n ọ́n: ní ìhà àríwá ẹgbẹ̀rún mẹ́rin ó lé ẹ̀ẹ́dẹ́gbẹ̀ta (4,500) ìgbọ̀nwọ́, ni ìhà gúúsù ẹgbẹ̀rún mẹ́rin ó lé ẹ̀ẹ́dẹ́gbẹ̀ta (4,500) ìgbọ̀nwọ́, ní ìhà ìlà-oòrùn ẹgbẹ̀rún mẹ́rin ó lé ẹ̀ẹ́dẹ́gbẹ̀ta (4,500) ìgbọ̀nwọ́ àti ní ìhà ìwọ̀-oòrùn ẹgbẹ̀rún mẹ́rin ó lé ẹ̀ẹ́dẹ́gbẹ̀ta (4,500) ìgbọ̀nwọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ ìjẹ fún àwọn ẹran ọ̀sìn fún ìlú ńlá náà yóò jẹ igba àti àádọ́ta (250) ìgbọ̀nwọ́ ní ìhà gúúsù, ìgbà àti ìgbà pẹ̀lú àádọ́ta (250) ìgbọ̀nwọ́ ní ìhà ìwọ̀-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí tí ó kù ní agbègbè náà, tí ó jẹ́ àkọjúsí ìpín ibi mímọ́, gígùn rẹ̀ yóò sì jẹ́ ẹgbẹ̀rún mẹ́wàá (10,000) ìgbọ̀nwọ́ ni ìhà ìlà-oòrùn àti ẹgbẹ̀rún mẹ́wàá (10,000) ìgbọ̀nwọ́ ní ìhà ìwọ̀-oòrùn. Ìpèsè rẹ̀ yóò fi kún oúnjẹ fún àwọn òṣìṣẹ́ ìlú ńlá náà.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn òṣìṣẹ́ láti ìlú ńlá náà, tí ó ń dá oko níbẹ̀ yóò wá láti gbogbo àwọn ẹ̀yà Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ìpín náà yóò rí bákan náà ní ẹ̀gbẹ́ mẹ́rẹ̀ẹ̀rin, èyí yóò jẹ́ ẹgbẹ̀rún mẹ́ẹ̀ẹ́dọ́gbọ̀n (25,000) ìgbọ̀nwọ́ ní ẹ̀gbẹ́ kọ̀ọ̀kan. Gẹ́gẹ́ bí ẹ̀bùn pàtàkì ìwọ yóò fi ìpín ibi mímọ́ sí ẹ̀gbẹ́ kan, papọ̀ mọ́ ohun ìní ìlú ńlá náà.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí tí ó ṣẹ́kù ni ẹ̀gbẹ́ méjèèjì agbègbè tí ó jẹ́ ìpín ibi mímọ́ àti ohun ìní ìlú ńlá náà yóò jẹ́ ti àwọn ọmọ-aládé. Èyí yóò lọ títí dé ìhà ìlà-oòrùn láti ẹgbẹ̀rún mẹ́ẹ̀ẹ́dọ́gbọ̀n (25,000) ìgbọ̀nwọ́ ti ìpín ibi mímọ́ títí dé ààlà ìlà-oòrùn. Agbègbè méjèèjì wọ̀nyí ni gígùn àwọn ìpín ẹlẹ́yàmẹ́yà yóò jẹ́ ti àwọn ọmọ-aládé, àti ìpín ibi mímọ́ pẹ̀lú tẹmpili yóò wa ní àárín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ ìní àwọn Lefi àti ohun ìní ìlú ńlá náà yóò wà ni àárín agbègbè tí ó jẹ́ ti àwọn ọmọ-aládé. Agbègbè tí ó jẹ́ ti àwọn ọmọ-aládé yóò wà ní àárín ààlà tí Juda àti ààlà tí Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ti àwọn ẹ̀yà tí ó kù:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:23"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 48:23"
      },
      "items": [
        {
          "text": "\"Benjamini yóò ní ìpín kan; èyí yóò wà láti ìhà ìlà-oòrùn títí dé ìhà ìwọ̀-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simeoni yóò ní ìpín kan: èyí yóò jẹ́ ààlà agbègbè Benjamini láti ìlà-oòrùn lọ sí ìwọ̀-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isakari yóò ní ìpín kan: èyí yóò jẹ́ ààlà agbègbè Simeoni láti ìlà-oòrùn sí ìwọ̀-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebuluni yóò ní ìpín kan; èyí yóò jẹ́ ààlà agbègbè Isakari láti ìlà-oòrùn sí ìwọ̀-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gadi yóò ní ìpín; èyí yóò jẹ́ ààlà agbègbè Sebuluni láti ìlà-oòrùn sí ìwọ̀-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
              "EZK.48.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 48:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ààlà tí gúúsù Gadi yóò dé gúúsù láti Tamari lọ sí odò Meriba Kadeṣi lẹ́yìn náà títí dé odo ti Ejibiti lọ sí Òkun ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.28",
            "verseOrgIds": [
              "EZK.48.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 48:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ilẹ̀ tí ẹ̀yin yóò fi ìbò pín ní ogún fún àwọn ẹ̀yà Israẹli, wọ̀nyí sì ni ìpín wọn,\" ní",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olódùmarè wí.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ẹnu-ọ̀nà ìlú ńlá náà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 48:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ̀nyí ní yóò jẹ́ ẹnu-ọ̀nà àbájáde ìlú ńlá náà:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:30"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 48:30"
      },
      "items": [
        {
          "text": "\"Bẹ̀rẹ̀ láti ìhà àríwá, ti ó jẹ́ ẹgbẹ̀rún mẹ́rin ó lè ẹ̀ẹ́dẹ́gbẹ̀ta (4,500) ìgbọ̀nwọ́ ni gígùn,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.30",
            "verseOrgIds": [
              "EZK.48.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 48:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹnu-ọ̀nà ìlú ńlá náà ní àwa yóò fi orúkọ àwọn ẹ̀yà Israẹli pè. Àwọn ọ̀nà mẹ́tẹ̀ẹ̀ta ní ìhà àríwá ní yóò jẹ́ ọ̀nà tí Reubeni, ọ̀nà tí Juda ọ̀nà tí Lefi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 48:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìhà ìlà-oòrùn, èyí tí ó jẹ́ ẹgbẹ̀rún mẹ́rin ó lé ẹ̀ẹ́dẹ́gbẹ̀ta (4,500) ìgbọ̀nwọ́ ní gígùn, ni ojú ọ̀nà mẹ́ta yóò wà: ọ̀nà Josẹfu, ọ̀nà tí Benjamini àti ọ̀nà tí Dani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìhà gúúsù, èyí tí wíwọ̀n rẹ̀ jẹ́ ẹgbẹ̀rún mẹ́rin ó lè ẹ̀ẹ́dẹ́gbẹ̀ta (4,500) ìgbọ̀nwọ́ ní ojú ọ̀nà mẹ́ta yóò wà: ojú ọ̀nà Simeoni, ojú ọ̀nà Isakari àti ojú ọ̀nà Sebuluni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìhà ìwọ̀-oòrùn, èyí tí ó jẹ́ ẹgbẹ̀rún mẹ́rin ó lé ẹ̀ẹ́dẹ́gbẹ̀ta (4,500) ìgbọ̀nwọ́ ni gígùn, ní ojú ọ̀nà mẹ́ta yóò wà: ojú ọ̀nà Gadi, ojú ọ̀nà Aṣeri àti ojú ọ̀nà Naftali.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.34",
            "verseOrgIds": [
              "EZK.48.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jíjìnnà rẹ̀ yípo yóò jẹ́ ẹgbàá mẹ́sàn (18,000) ìgbọ̀nwọ́.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:35"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 48:35"
      },
      "items": [
        {
          "text": "\"Orúkọ ìlú náà láti ìgbà náà yóò jẹ́: '",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.35",
            "verseOrgIds": [
              "EZK.48.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.35",
                "verseOrgIds": [
                  "EZK.48.35"
                ]
              }
            }
          ]
        },
        {
          "text": "wà níbẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.35",
            "verseOrgIds": [
              "EZK.48.35"
            ]
          }
        }
      ]
    }
