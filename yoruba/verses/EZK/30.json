              "attrs": {
                "verseId": "EZK.30.20",
                "verseOrgIds": [
                  "EZK.30.20"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ mí wá,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.20",
            "verseOrgIds": [
              "EZK.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọmọ ènìyàn, Èmi ti ṣẹ́ apá Farao ọba Ejibiti. A kò ì tí ì di apá náà papọ̀ láti mu kí ó san, a kò sì ti di i si àárín igi pẹlẹbẹ kí o lè ni agbára tó láti di idà mú.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.21",
            "verseOrgIds": [
              "EZK.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, báyìí ní",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.22",
            "verseOrgIds": [
              "EZK.30.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.30.22",
                "verseOrgIds": [
                  "EZK.30.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí: Èmi lòdì sí Farao ọba Ejibiti. Èmi yóò sẹ́ apá rẹ̀ méjèèjì, èyí tí ó dára àti èyí tí a ti ṣẹ́ pẹ̀lú, yóò sì mú kí idà bọ́ sọnù ní ọwọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.22",
            "verseOrgIds": [
              "EZK.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì fọ́n àwọn ènìyàn Ejibiti ká sí àárín àwọn orílẹ̀-èdè, èmi yóò sì tú wọn ká gbogbo ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.23",
            "verseOrgIds": [
              "EZK.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò mú kí apá ọba Babeli ní agbára, èmi yóò sì fi idà mi sí ọwọ́ rẹ, ṣùgbọ́n èmi yóò ṣẹ́ apá Farao, yóò sì kérora níwájú rẹ̀ bí ọkùnrin tí a sá ní àṣápa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.24",
            "verseOrgIds": [
              "EZK.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò mú kí apá ọba Babeli lé, ṣùgbọ́n apá Farao yóò sì rọ. Nígbà náà wọn yóò mọ̀ pé, Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.25",
            "verseOrgIds": [
              "EZK.30.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.30.25",
                "verseOrgIds": [
                  "EZK.30.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", nígbà tí mo bá mú idà mi sí ọwọ́ ọba Babeli yóò sì fi idà náà kọlu Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.25",
            "verseOrgIds": [
              "EZK.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò fọ́n àwọn ara Ejibiti ká sí àárín orílẹ̀-èdè, èmi yóò sì tú wọn ká sí àárín orílẹ̀-èdè, èmi yóò sì tú wọn ká sí gbogbo ilẹ̀. Nígbà náà wọn yóò mọ̀ pé èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.26",
            "verseOrgIds": [
              "EZK.30.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
