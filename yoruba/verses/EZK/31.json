  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "EZK 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òpépé igi Sedari ni Lebanoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kìn-ín-ní, oṣù kẹta ọdún kọkànlá, ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.1",
            "verseOrgIds": [
              "EZK.31.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.31.1",
                "verseOrgIds": [
                  "EZK.31.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ mí wá:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.1",
            "verseOrgIds": [
              "EZK.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọmọ ènìyàn, sọ fún Farao ọba Ejibiti àti sí ìjọ rẹ̀:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.2",
            "verseOrgIds": [
              "EZK.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:2"
      },
      "items": [
        {
          "text": "\" 'Ta ní a le fiwé ọ ní ọláńlá?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.2",
            "verseOrgIds": [
              "EZK.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi Asiria, tí ó jẹ́ igi kedari ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:3"
      },
      "items": [
        {
          "text": "Lebanoni ní ìgbà kan rí,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:3"
      },
      "items": [
        {
          "text": "pẹ̀lú àwọn ẹ̀ka dáradára tí ó ṣẹ́ ìji bo igbó náà;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:3"
      },
      "items": [
        {
          "text": "tí ó ga sókè,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:3"
      },
      "items": [
        {
          "text": "òkè rẹ̀ lókè ni ewé tí ó nípọn wà.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omi mú un dàgbàsókè:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "orísun omi tí ó jinlẹ̀ mú kí o dàgbàsókè;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "àwọn odo rẹ̀ ń sàn yí ìdí rẹ̀ ká,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "ó sì rán ìṣàn omi rẹ̀ sí gbogbo igi orí pápá.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ó ga sí òkè fíofío",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:5"
      },
      "items": [
        {
          "text": "ju gbogbo igi orí pápá lọ;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:5"
      },
      "items": [
        {
          "text": "ẹ̀ka rẹ̀ pọ̀ sí i",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:5"
      },
      "items": [
        {
          "text": "àwọn ẹ̀ka rẹ̀ sì gùn,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:5"
      },
      "items": [
        {
          "text": "wọn tẹ́ rẹrẹ nítorí ọ̀pọ̀lọpọ̀ omi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹyẹ ojú ọ̀run",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "kọ ilé sí ẹ̀ka rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "gbogbo ẹranko igbó",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "ń bímọ ní abẹ́ ẹ̀ka rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "gbogbo orílẹ̀-èdè ńlá",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "ń gbé abẹ́ ìji rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọláńlá ní ẹwà rẹ̀ jẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.7",
            "verseOrgIds": [
              "EZK.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:7"
      },
      "items": [
        {
          "text": "pẹ̀lú títẹ́ rẹrẹ ẹ̀ka rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.7",
            "verseOrgIds": [
              "EZK.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:7"
      },
      "items": [
        {
          "text": "nítorí gbòǹgbò rẹ̀ lọ sí ìsàlẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.7",
            "verseOrgIds": [
              "EZK.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:7"
      },
      "items": [
        {
          "text": "sí ibi tí ọ̀pọ̀lọpọ̀ omi wà.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.7",
            "verseOrgIds": [
              "EZK.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn igi kedari nínú ọgbà Ọlọ́run",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "kò lè è bò ó mọ́lẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "tàbí kí àwọn igi junifa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "ṣe déédé pẹ̀lú ẹ̀ka rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "tàbí kí a fi igi títẹ́ rẹrẹ wé ẹ̀ka rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "kò sí igi nínú ọgbà Ọlọ́run",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "tí ó dà bí rẹ̀ ní ẹwà rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo mú kí ó ní ẹwà",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:9"
      },
      "items": [
        {
          "text": "pẹ̀lú ẹ̀ka lọ́pọ̀lọ́pọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:9"
      },
      "items": [
        {
          "text": "tó fi jẹ́ ìlara àwọn igi gbogbo ní Edeni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:9"
      },
      "items": [
        {
          "text": "tí í ṣe ọgbà Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nítorí náà, èyí yìí ní",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.10",
            "verseOrgIds": [
              "EZK.31.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.31.10",
                "verseOrgIds": [
                  "EZK.31.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí: Nítorí pé ó ga lọ sókè fíofío, tí ó sì gbé òkè rẹ̀ ga ju ewé tí ó nípọn lọ, àti nítorí pé gíga rẹ mú kí ó gbéraga,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.10",
            "verseOrgIds": [
              "EZK.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mo fi lé alákòóso àwọn orílẹ̀-èdè náà lọ́wọ́, fún un láti fi ṣe ẹ̀tọ́ fún un gẹ́gẹ́ bí ìwà búburú rẹ̀. Mo pa á tì sí ẹ̀gbẹ́ kan,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.11",
            "verseOrgIds": [
              "EZK.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn orílẹ̀-èdè àjèjì aláìláàánú jùlọ ké e lulẹ̀, wọn sì fi kalẹ̀. Àwọn ẹ̀ka rẹ̀ ṣubú sórí òkè àti sí gbogbo àárín àwọn òkè; àwọn ẹ̀ka rẹ̀ tí ó ṣẹ nà sílẹ̀ ní gbogbo àlàfo jíjìn ilẹ̀. Gbogbo àwọn orílẹ̀-èdè ilẹ̀ ayé jáde kúrò ní abẹ́ ìji rẹ̀ wọn sì fi sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.12",
            "verseOrgIds": [
              "EZK.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ẹyẹ ojú ọ̀run ṣe àtìpó ni orí igi tí ó ṣubú lulẹ̀ náà, gbogbo àwọn ẹranko igbó wà ní àárín ẹ̀ka rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.13",
            "verseOrgIds": [
              "EZK.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà kò sí igi mìíràn lẹ́gbẹ̀ẹ́ omi tí ó lè fi ìgbéraga ga sókè fíofío, tí yóò sì gbé sókè rẹ̀ ga ju ewé tí ó nípọn lọ. Kò sí igi mìíràn tí ó ní omi tó bẹ́ẹ̀ tí ó lè ga tó bẹ́ẹ̀; gbogbo wọn ni a kádàrá ikú fún, fún ìsàlẹ̀ ilẹ̀, ní àárín àwọn alààyè ènìyàn, pẹ̀lú àwọn tí o lọ sí ọ̀gbun ní ìsàlẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.14",
            "verseOrgIds": [
              "EZK.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Èyí ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.15",
            "verseOrgIds": [
              "EZK.31.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.31.15",
                "verseOrgIds": [
                  "EZK.31.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí: Ní ọjọ́ ti a mú u wá sí isà òkú mo fi ọ̀fọ̀ ṣíṣe bo orísun omi jíjìn náà, mo dá àwọn ìṣàn omi rẹ̀ dúró, àti ọ̀pọ̀lọpọ̀ omi rẹ̀ ní a dí lọ́nà. Nítorí rẹ̀ mo fi ìwúwo ọkàn wọ Lebanoni ní aṣọ, gbogbo igi igbó gbẹ dànù.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.15",
            "verseOrgIds": [
              "EZK.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo mú kí orílẹ̀-èdè wárìrì sì ìró ìṣubú rẹ̀ nígbà tí mo mú un wá sí ìsàlẹ̀ isà òkú pẹ̀lú àwọn tí ó lọ sí ọ̀gbun ìsàlẹ̀. Nígbà náà gbogbo igi Edeni, àṣàyàn àti èyí tí ó dára jùlọ nínú Lebanoni, gbogbo igi tí ó ní omi dáradára ni a tù nínú ni ayé ìsàlẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.16",
            "verseOrgIds": [
              "EZK.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó ń gbé ní abẹ́ òjìji rẹ̀, àwọn àjèjì rẹ ní àárín àwọn orílẹ̀-èdè náà, ti lọ sí ìsàlẹ̀ isà òkú pẹ̀lú rẹ̀, ní dídárapọ̀ mọ́ àwọn tí a fi idà pa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.17",
            "verseOrgIds": [
              "EZK.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Èwo lára igi Edeni ní a lè fiwé ọ ní dídán àti ọláńlá? Síbẹ̀ ìwọ, gan an wá sílẹ̀ pẹ̀lú àwọn igi Edeni lọ sí ìsàlẹ̀ ilẹ̀; ìwọ yóò sùn ni àárín àwọn aláìkọlà, pẹ̀lú àwọn tí a fi idà pa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.18",
            "verseOrgIds": [
              "EZK.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 31:18"
      },
      "items": [
        {
          "text": "\" 'Èyí yìí ní Farao àti ìjọ rẹ̀, ní",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.18",
            "verseOrgIds": [
              "EZK.31.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.31.18",
                "verseOrgIds": [
                  "EZK.31.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.18",
            "verseOrgIds": [
              "EZK.31.18"
            ]
          }
        }
      ]
    }
