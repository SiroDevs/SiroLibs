                "verseOrgIds": [
                  "EZK.17.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí, Èmi fúnra mi yóò mú ọ̀kan lára ẹ̀ka tí ó ga jùlọ lórí igi kedari gíga, tí èmi yóò sì gbìn ín, èmi yóò sì gé ọ̀mùnú tí ó ṣẹ̀ṣẹ̀ yọ láti òkè, èmi yóò sì gbìn ín sórí òkè tó ga tó sì lókìkí.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.22",
            "verseOrgIds": [
              "EZK.17.22"
            ]
          }
        },
        {
          "name": "verse",
