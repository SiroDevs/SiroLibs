          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo igi inú oko yóò mọ̀ pé, Èmi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.24",
            "verseOrgIds": [
              "EZK.17.24"
            ]
          }
