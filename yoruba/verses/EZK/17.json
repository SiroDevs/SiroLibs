                "verseOrgIds": [
                  "EZK.17.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ó mú igi gíga walẹ̀, tí mo sì mú kúkúrú ga sókè, tí mo mu igi tútù gbẹ, tí mo sì mú igi gbígbẹ rúwé.",
