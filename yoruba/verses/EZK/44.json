  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "44",
        "style": "c",
        "sid": "EZK 44"
      },
      "items": [
        {
          "text": "44",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ọmọ ọba, àwọn Lefi àti àwọn àlùfáà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 44:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà ni ọkùnrin náà mú mi padà lọ sí ibi mímọ́, èyí tí ó kọjú sí ìhà ìlà-oòrùn, ó sì wà ní títì.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.1",
            "verseOrgIds": [
              "EZK.44.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.44.2",
                "verseOrgIds": [
                  "EZK.44.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún mi, \"Ẹnu-ọ̀nà yìí ni kí ó wà ní títì. A kò gbọdọ̀ ṣí i sílẹ̀; kò sí ẹni tí o gbọdọ̀ gba ibẹ̀ wọlé. Ó gbọdọ̀ wà ní títì nítorí pé",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.2",
            "verseOrgIds": [
              "EZK.44.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.44.2",
                "verseOrgIds": [
                  "EZK.44.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli tí gbà ibẹ̀ wọlé.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.2",
            "verseOrgIds": [
              "EZK.44.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọ-aládé fúnra rẹ̀ ní o lè jókòó ní ẹnu-ọ̀nà náà kí o sì jẹun níwájú",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.3",
            "verseOrgIds": [
              "EZK.44.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.44.3",
                "verseOrgIds": [
                  "EZK.44.3"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ó gbọdọ̀ gba ọ̀nà ìloro ẹnu-ọ̀nà wọlé kí ó sì gba ibẹ̀ jáde.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.3",
            "verseOrgIds": [
              "EZK.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà, ọkùnrin náà mú mi gba ẹnu-ọ̀nà àríwá lọ sí iwájú ilé Ọlọ́run. Mo wò ó mo sì rí ògo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.4",
            "verseOrgIds": [
              "EZK.44.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.44.4",
                "verseOrgIds": [
                  "EZK.44.4"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó kún inú ilé",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.4",
            "verseOrgIds": [
              "EZK.44.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.44.4",
                "verseOrgIds": [
                  "EZK.44.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", mo sì dojúkọ ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.4",
            "verseOrgIds": [
              "EZK.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.44.5",
                "verseOrgIds": [
                  "EZK.44.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fún mì pé, \"Ọmọ ènìyàn, wò dáradára, fetísílẹ̀ dáradára kí o sì fiyèsí ohun gbogbo tí mo sọ fún ọ nípa òfin lórí ilé",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.5",
            "verseOrgIds": [
              "EZK.44.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.44.5",
                "verseOrgIds": [
                  "EZK.44.5"
                ]
              }
            }
          ]
        },
        {
          "text": "náà. Fiyèsí ẹnu-ọ̀nà ilé Ọlọ́run náà àti gbogbo àbájáde ibi mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.5",
            "verseOrgIds": [
              "EZK.44.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọ fún ọlọ̀tẹ̀ ilé Israẹli pé, 'Èyí yìí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.6",
            "verseOrgIds": [
              "EZK.44.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.44.6",
                "verseOrgIds": [
                  "EZK.44.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí: Ìwà ìríra rẹ tí tó gẹ́ẹ́, ìwọ ilé Israẹli!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.6",
            "verseOrgIds": [
              "EZK.44.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àfikún pẹ̀lú gbogbo àwọn ìwà ìríra rẹ tí ó kù, ìwọ mú àwọn àjèjì aláìkọlà àyà àti ara wá sí inú ibi mímọ́ mi, ní lílo ilé mi ní ìlòkulò nígbà tí ìwọ fi oúnjẹ fún mi, ọ̀rá àti ẹ̀jẹ̀, ìwọ sì ba májẹ̀mú mi jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.7",
            "verseOrgIds": [
              "EZK.44.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dípò kí ìwọ pa òfin mi mọ́, ìwọ fi àwọn mìíràn sí ibi mímọ́ mi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.8",
            "verseOrgIds": [
              "EZK.44.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí yìí ní",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.9",
            "verseOrgIds": [
              "EZK.44.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.44.9",
                "verseOrgIds": [
                  "EZK.44.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí: Àjèjì aláìkọlà àyà àti ara kò gbọdọ̀ wọ ibi mímọ́ mi, àti pẹ̀lú àwọn àjèjì tí ń gbé ní àárín àwọn ọmọ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.9",
            "verseOrgIds": [
              "EZK.44.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Àwọn Lefi tí wọn rìn jìnnà kúrò lọ́dọ̀ mi nígbà tí àwọn ọmọ Israẹli ṣìnà, ti wọ́n sì ṣáko kúrò lọ́dọ̀ mi láti tọ àwọn ère wọn lẹ́yìn gbọdọ̀ jèrè ẹ̀ṣẹ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.10",
            "verseOrgIds": [
              "EZK.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn le sìn mi ní ibi mímọ́ mi, kí wọn ṣe ìtọ́jú àwọn ẹnu-ọ̀nà ilé Ọlọ́run, kí wọn sì ṣe ìránṣẹ́ nínú rẹ̀; wọn le pa ẹbọ sísun, ki wọn sì rú ẹbọ fún àwọn ènìyàn, kí wọn sì dúró níwájú àwọn ènìyàn, kí wọ́n sì ṣe ìránṣẹ́ fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.11",
            "verseOrgIds": [
              "EZK.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nítorí pé wọn ṣe ìránṣẹ́ fún wọn níwájú àwọn ère wọn, tí wọn sì mu ilé Israẹli ṣubú sínú ẹ̀ṣẹ̀, nítorí náà, Èmi tí búra nípa nína ọwọ́ sókè pé, wọn gbọdọ̀ jèrè ẹ̀ṣẹ̀ wọn, ní",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.12",
            "verseOrgIds": [
              "EZK.44.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.44.12",
                "verseOrgIds": [
                  "EZK.44.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.12",
            "verseOrgIds": [
              "EZK.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn kò gbọdọ̀ súnmọ́ ọ̀dọ̀ mi láti ṣe ìránṣẹ́ fún mi, gẹ́gẹ́ bí àlùfáà tàbí súnmọ́ nǹkan kan nínú àwọn ohun mímọ́ mi tàbí ẹbọ mi mímọ́ jùlọ; wọn gbọdọ̀ gba ìtìjú ìwà ìríra wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.13",
            "verseOrgIds": [
              "EZK.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀ èmi yóò mu wọn sí ìtọ́jú ilé Ọlọ́run àti gbogbo iṣẹ́ tí a gbọdọ̀ ṣe níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.14",
            "verseOrgIds": [
              "EZK.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ṣùgbọ́n àwọn àlùfáà, tí ó jẹ́ Lefi àti àwọn ìran Sadoku tí fi tọkàntọkàn ṣe iṣẹ́ ibi mímọ́ mi nígbà tí àwọn Israẹli ṣáko lọ kúrò lọ́dọ̀ mi, wọn gbọdọ̀ súnmọ́ iwájú láti ṣe ìránṣẹ́ ní iwájú mi, láti rú ẹbọ ọ̀rá àti ẹ̀jẹ̀, ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.15",
            "verseOrgIds": [
              "EZK.44.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.44.15",
                "verseOrgIds": [
                  "EZK.44.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.15",
            "verseOrgIds": [
              "EZK.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn nìkan ni ó gbọdọ̀ wọ ibi mímọ́ mi; àwọn nìkan ní o gbọdọ̀ súnmọ́ tábìlì mi láti ṣe ìránṣẹ́ ni iwájú mi, ki wọn sì ṣe iṣẹ́ ìsìn mi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.16",
            "verseOrgIds": [
              "EZK.44.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nígbà ti wọ́n wọ àwọn ẹnu-ọ̀nà àgbàlá ti inú, wọn yóò wọ ẹ̀wù ọ̀gbọ̀, wọn kò gbọdọ̀ wọ aṣọ onírun nígbà tí wọ́n bá ń ṣiṣẹ́ ìránṣẹ́ ní àwọn ẹnu-ọ̀nà àgbàlá ti inú tàbí ni inú ilé Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.17",
            "verseOrgIds": [
              "EZK.44.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n yóò sì dé fìlà ọ̀gbọ̀ sí orí wọn àti ṣòkòtò ọ̀gbọ̀ sí ìdí wọn. Wọn kò sì gbọdọ̀ wọ ohunkóhun tí yóò mú wọn làágùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.18",
            "verseOrgIds": [
              "EZK.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n bá lọ sì àgbàlá òde níbi tí àwọn ènìyàn wà, wọn gbọdọ̀ bọ́ ẹ̀wù tí wọ́n fi ń ṣiṣẹ́ ìránṣẹ́, ki wọn sì fi wọn sílẹ̀ sí àwọn yàrá mímọ́ náà, kí wọn kí ó sì wọ ẹ̀wù mìíràn, wọn kì yóò sì fi ẹ̀wù wọn sọ àwọn ènìyàn di mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.19",
            "verseOrgIds": [
              "EZK.44.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Wọn kò gbọdọ̀ fá irun, wọn kò sì gbọdọ̀ jẹ́ kí irun wọn gùn, ṣùgbọ́n wọn gbọdọ̀ jẹ́ kí irun orí wọn wà ní gígẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.20",
            "verseOrgIds": [
              "EZK.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àlùfáà kankan kò gbọdọ̀ mu ọtí nígbà tí ó bá wọ àgbàlá tí inú.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.21",
            "verseOrgIds": [
              "EZK.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn ko gbọdọ̀ fẹ́ opó ni ìyàwó, wọn kò sì gbọdọ̀ kọ ìyàwó wọn sílẹ̀, wọ́n lè fẹ́ àwọn ọmọbìnrin ti kò tí i mọ ọkùnrin rí, tí ó sì jẹ́ ìran àwọn ọmọ Israẹli, tàbí kí wọn fẹ́ àwọn opó àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.22",
            "verseOrgIds": [
              "EZK.44.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò sì fi ìyàtọ̀ tí ó wà láàrín mímọ́ àti àìmọ́ kọ́ àwọn ènìyàn mi, wọn yóò sì fihàn wọ́n bi wọn yóò ṣe dá aláìmọ́ mọ̀ yàtọ̀ sí mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.23",
            "verseOrgIds": [
              "EZK.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nínú èyíkéyìí èdè-àìyedè, àwọn àlùfáà ní yóò dúró gẹ́gẹ́ bí onídàájọ́ gẹ́gẹ́ bí òfin mi. Wọ́n ní láti pa àwọn òfin àti àṣẹ mi mọ́ ní gbogbo àjọ̀dún tí a yàn, wọn sì gbọdọ̀ ya ọjọ́ ìsinmi mi ní mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.24",
            "verseOrgIds": [
              "EZK.44.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 44:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Àlùfáà kò gbọdọ̀ sọ ara rẹ̀ di aláìmọ́ nípa sísún mọ́ òkú ènìyàn; ṣùgbọ́n ti òkú ènìyàn yẹn bá jẹ́ baba tàbí ìyá rẹ̀, àbúrò rẹ̀ ọkùnrin tàbí àbúrò rẹ̀ obìnrin ti kò i ti lọ́kọ, nígbà náà o le sọ ara rẹ̀ di aláìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.25",
            "verseOrgIds": [
              "EZK.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìwẹ̀nùmọ́ rẹ̀, ki òun kí ó dúró fún ọjọ́ méje.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.26",
            "verseOrgIds": [
              "EZK.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ ti yóò wọ àgbàlá ti inú ni ibi mímọ́ láti ṣe ìránṣẹ́ ibi mímọ́, ni kí òun kí ó rú ọrẹ ẹbọ ẹ̀ṣẹ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.44.27",
                "verseOrgIds": [
                  "EZK.44.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 44:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Èmi ni yóò jẹ́ ogún kan ṣoṣo tí àwọn àlùfáà yóò ní. Ẹ kì yóò fún wọn ni ìpín kankan ní Israẹli, Èmi ni yóò jẹ́ ìní wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.28",
            "verseOrgIds": [
              "EZK.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò jẹ ọrẹ ẹbọ jíjẹ, ọrẹ ẹbọ ẹ̀ṣẹ̀ àti ọrẹ ẹbọ ìrékọjá; gbogbo ohun tí a bá yà sọ́tọ̀ fún",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.29",
            "verseOrgIds": [
              "EZK.44.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.44.29",
                "verseOrgIds": [
                  "EZK.44.29"
                ]
              }
            }
          ]
        },
        {
          "text": "ni Israẹli ni yóò jẹ́ tiwọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.29",
            "verseOrgIds": [
              "EZK.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí tí ó dára jùlọ nínú gbogbo àkọ́so èso àti ọrẹ yín yóò jẹ́ ti àwọn àlùfáà. Ẹ ó sì fi àkọ́pò ìyẹ̀fun yín fún wọn kí ìbùkún lè wà lórí gbogbo ilé yín.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.30",
            "verseOrgIds": [
              "EZK.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlùfáà kì yóò jẹ́ ohunkóhun bí i ẹyẹ tàbí ẹranko, tí ó ti kú fúnra rẹ̀ tàbí èyí ti ẹranko ńlá fàya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.31",
            "verseOrgIds": [
              "EZK.44.31"
            ]
          }
        }
      ]
    }
  ],
