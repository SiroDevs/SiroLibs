  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "2KI 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoahasi ọba Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kẹtàlélógún ti Joaṣi ọmọ ọba Ahasiah ti Juda, Jehoahasi ọmọ Jehu di ọba Israẹli ní Samaria. Ó sì jẹ ọba fún ọdún mẹ́tàdínlógún.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.1",
            "verseOrgIds": [
              "2KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe búburú níwájú",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
              "2KI.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.2",
                "verseOrgIds": [
                  "2KI.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "nípa títẹ̀lé ẹ̀ṣẹ̀ Jeroboamu ọmọ Nebati, èyí tí ó ti fa Israẹli láti dá, kò sì yípadà kúrò nínú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
              "2KI.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.3",
            "verseOrgIds": [
              "2KI.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.3",
                "verseOrgIds": [
                  "2KI.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ru sí àwọn ọmọ Israẹli, àti fún ìgbà pípẹ́, ó fi wọ́n pamọ́ sí abẹ́ agbára ọba Hasaeli ọba Siria àti Beni-Hadadi ọmọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.3",
            "verseOrgIds": [
              "2KI.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Jehoahasi kígbe ó wá ojúrere",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.4",
                "verseOrgIds": [
                  "2KI.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.4",
                "verseOrgIds": [
                  "2KI.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tẹ́tí sí i. Nítorí ó rí bí ọba Siria ti ń ni Israẹli lára gidigidi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.5",
                "verseOrgIds": [
                  "2KI.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "pèsè olùgbàlà fún Israẹli, wọ́n sì sá kúrò lọ́wọ́ agbára Siria. Bẹ́ẹ̀ ni àwọn ọmọ Israẹli gbé nínú ilé ara wọn gẹ́gẹ́ bí wọ́n ti wà tẹ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.5",
            "verseOrgIds": [
              "2KI.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n wọn kò yípadà kúrò nínú ẹ̀ṣẹ̀ ilé Jeroboamu, èyí tí ó ti fa Israẹli láti dá, wọ́n tẹ̀síwájú nínú rẹ̀, ère òrìṣà Aṣerah sì wà síbẹ̀ ní Samaria pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.6",
            "verseOrgIds": [
              "2KI.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ohùn kan tí wọ́n fi sílẹ̀ ní ti ọmọ-ogun Jehoahasi àyàfi àádọ́ta ọkùnrin ẹlẹ́ṣin, kẹ̀kẹ́ mẹ́wàá, àti ẹgbẹ̀rún mẹ́wàá (10,000) ọmọ-ogun ẹlẹ́ṣẹ̀, nítorí ọba Siria ti pa ìyókù run, ó sì ṣe wọ́n bí eruku nígbà pípa ọkà.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.7",
            "verseOrgIds": [
              "2KI.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ti ìyókù ìṣe Jehoahasi fún ìgbà, tí ó fi jẹ ọba, gbogbo ohun tí ó ṣe àti àṣeyọrí rẹ̀ ṣé a kò kọ wọ́n sínú ìwé ìtàn ayé àwọn ọba Israẹli?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.8",
            "verseOrgIds": [
              "2KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoahasi pẹ̀lú àwọn baba rẹ̀. A sì sin ín sí Samaria. Jehoaṣi ọmọ rẹ̀ sì rọ́pò rẹ̀ gẹ́gẹ́ bí ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.9",
            "verseOrgIds": [
              "2KI.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoaṣi ọba Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kẹtàdínlógójì tí Joaṣi ọba Juda, Jehoaṣi ọmọ Jehoahasi di ọba Israẹli ní Samaria ó sì jẹ ọba fún ọdún mẹ́rìndínlógún.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.10",
            "verseOrgIds": [
              "2KI.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.11",
            "verseOrgIds": [
              "2KI.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.11",
                "verseOrgIds": [
                  "2KI.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", kò sì yípadà kúrò nínú ọ̀kankan nínú ẹ̀ṣẹ̀ Jeroboamu ọmọ Nebati èyí tí ó ti ti Israẹli láti fà. Ó sì tẹ̀síwájú nínú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.11",
            "verseOrgIds": [
              "2KI.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ti ìyókù iṣẹ́ Jehoaṣi fún ìgbà tí ó fi jẹ ọba, gbogbo ohun tí ó ṣe, pẹ̀lú àṣeyọrí rẹ̀ pẹ̀lú ogun rẹ̀ sí Amasiah ọba Juda, ṣé a kò kọ wọ́n sínú ìwé ìtàn ayé àwọn ọba Israẹli?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.12",
            "verseOrgIds": [
              "2KI.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoaṣi sinmi pẹ̀lú àwọn baba a rẹ̀. Jeroboamu sì rọ́pò rẹ̀ lórí ìtẹ́. A sin Jehoaṣi sí Samaria pẹ̀lú àwọn ọba Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.13",
            "verseOrgIds": [
              "2KI.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, Eliṣa ń jìyà lọ́wọ́ àìsàn, lọ́wọ́ èyí tí ó sì kú. Jehoaṣi ọba Israẹli lọ láti lọ wò ó, ó sì sọkún lórí rẹ̀. \"Baba mi! Baba mi!\" Ó sọkún. \"Àwọn kẹ̀kẹ́ àti àwọn ọkùnrin ẹlẹ́ṣin Israẹli!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.14",
            "verseOrgIds": [
              "2KI.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliṣa wí pé, \"Mú ọrun kan àti àwọn ọfà,\" ó sì ṣe bẹ́ẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.15",
            "verseOrgIds": [
              "2KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mú ọrun ní ọwọ́ rẹ.\" Ó wí fún ọba Israẹli. Nígbà tí ó ti mú u, Eliṣa mú ọwọ́ rẹ̀ lé ọwọ́ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.16",
            "verseOrgIds": [
              "2KI.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣí fèrèsé apá ìlà-oòrùn,\" ó wí, pẹ̀lú ó sì ṣí i: \"Ta á!\" Eliṣa wí, ó sì ta á. \"Ọfà ìṣẹ́gun",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.17",
                "verseOrgIds": [
                  "2KI.13.17"
                ]
              }
            }
          ]
        },
        {
          "text": "; ọfà ìṣẹ́gun lórí Siria!\" Eliṣa kéde. \"Ìwọ yóò pa àwọn ará Siria run pátápátá ní Afeki.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ó wí pé, \"Mú àwọn ọfà náà,\" ọba sì mú wọn. Eliṣa wí fún un pé, \"Lu ilẹ̀.\" Ó lù ú lẹ́ẹ̀mẹ́ta, ó sì dáwọ́ dúró.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.18",
            "verseOrgIds": [
              "2KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ènìyàn Ọlọ́run sì bínú sí i, ó sì wí pé, \"Ìwọ kò bá ti lu ilẹ̀ ní ẹ̀ẹ̀márùn ún tàbí ní ẹ̀ẹ̀mẹ́fà, nígbà náà, ìwọ kò bá ti ṣẹ́gun Siria àti pa á run pátápátá ṣùgbọ́n nísinsin yìí, ìwọ yóò ṣẹ́gun rẹ̀ ní ẹ̀ẹ̀mẹ́ta péré.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.19",
            "verseOrgIds": [
              "2KI.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliṣa kú a sì sin ín.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 13:20"
      },
      "items": [
        {
          "text": "Ẹgbẹ́ àwọn ará Moabu máa ń wọ orílẹ̀-èdè ní gbogbo àmọ́dún.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwọn ọmọ Israẹli kan ti ń sin òkú ọkùnrin kan, lójijì wọ́n rí ẹgbẹ́ àwọn oníjadì, bẹ́ẹ̀ ni wọ́n ju òkú ọkùnrin náà sínú ibojì Eliṣa. Nígbà tí ara ọkùnrin náà kan egungun Eliṣa, ó padà wá sí ayé, ó sì dúró ní ẹsẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.21",
            "verseOrgIds": [
              "2KI.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasaeli ọba Siria ni Israẹli lára ní gbogbo àkókò tí Jehoahasi fi jẹ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.22",
            "verseOrgIds": [
              "2KI.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.23",
            "verseOrgIds": [
              "2KI.13.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.23",
                "verseOrgIds": [
                  "2KI.13.23"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣàánú fún wọn ó sì ní ìyọ́nú, ó sì fiyèsí wọn nítorí májẹ̀mú rẹ̀ pẹ̀lú Abrahamu, Isaaki àti Jakọbu. Títí di ọjọ́ òní, kì í ṣe ìfẹ́ inú rẹ̀ láti pa wọ́n run tàbí lé wọn lọ níwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.23",
            "verseOrgIds": [
              "2KI.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasaeli ọba Siria kú, Beni-Hadadi ọmọ rẹ̀ sì rọ́pò rẹ̀ gẹ́gẹ́ bí ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.24",
            "verseOrgIds": [
              "2KI.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, Jehoaṣi ọmọ Jehoahasi gbà padà kúrò lọ́wọ́ Beni-Hadadi ọmọ Hasaeli àwọn ìlú tí ó ti gbà nínú ogun látọ̀dọ̀ baba rẹ̀ Jehoahasi. Ní ẹ̀ẹ̀mẹta, Jehoaṣi ṣẹ́gun rẹ̀, bẹ́ẹ̀ ni ó gba ìlú àwọn ọmọ Israẹli padà.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.25",
            "verseOrgIds": [
              "2KI.13.25"
            ]
          }
        }
      ]
    }
  ],
