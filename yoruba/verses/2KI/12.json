          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoaṣi tún ilé tí a kọ́ fún",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún keje tí Jehu, Jehoaṣi di ọba, ó sì jẹ ọba ní Jerusalẹmu fún ogójì ọdún. Orúkọ ìyá rẹ̀ a máa jẹ́ Sibia: Ó wá láti Beerṣeba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.1",
            "verseOrgIds": [
              "2KI.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoaṣi ṣe ohun tí ó tọ́ ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.2",
            "verseOrgIds": [
              "2KI.12.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.2",
                "verseOrgIds": [
                  "2KI.12.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ní gbogbo ọdún tí Jehoiada àlùfáà fi àṣẹ fún un.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.2",
            "verseOrgIds": [
              "2KI.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ibi gíga, bí ó ti wù kí ó rí, a kò sí wọn ní ìdí, àwọn ènìyàn sì tẹ̀síwájú láti máa rú ẹbọ àti sísun tùràrí níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.3",
            "verseOrgIds": [
              "2KI.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoaṣi sọ fún àwọn àlùfáà pé, \"Gba gbogbo owó tí wọ́n mú wá gẹ́gẹ́ bí ọrẹ mímọ́ sí ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.4",
                "verseOrgIds": [
                  "2KI.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "owó tí a gbà ní ìgbà kíka àwọn ènìyàn ìlú, owó tí a gbà láti ọwọ́ olúkúlùkù bí wọ́n ti ṣe jẹ́ ẹ̀yà àti owó tí ó ti ọkàn olúkúlùkù wá tí a mú wá sí ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.4",
                "verseOrgIds": [
                  "2KI.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí gbogbo àlùfáà gba owó náà lọ́wọ́ ọ̀kan nínú àwọn akápò. Kí a sì lò ó fún tuntun ohunkóhun tí ó bá bàjẹ́ nínú ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.5",
            "verseOrgIds": [
              "2KI.12.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.5",
                "verseOrgIds": [
                  "2KI.12.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.5",
            "verseOrgIds": [
              "2KI.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ní ọdún kẹtàlélógún ọba Jehoaṣi, àwọn àlùfáà kò ì tí ì tún ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.6",
            "verseOrgIds": [
              "2KI.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.6",
                "verseOrgIds": [
                  "2KI.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.6",
            "verseOrgIds": [
              "2KI.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, ọba Jehoaṣi pe Jehoiada àlùfáà àti àwọn àlùfáà yòókù, ó sì bi wọ́n pé, \"Kí ni ó dé tí ẹ̀yin kò fi tún ìbàjẹ́ tí a ṣe sí ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.7",
            "verseOrgIds": [
              "2KI.12.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.7",
                "verseOrgIds": [
                  "2KI.12.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe? Ẹ má ṣe gba owó mọ́ lọ́wọ́ àwọn afowópamọ́, ṣùgbọ́n ẹ gbé e kalẹ̀ fún títún ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.7",
            "verseOrgIds": [
              "2KI.12.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.7",
                "verseOrgIds": [
                  "2KI.12.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.7",
            "verseOrgIds": [
              "2KI.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlùfáà fi ara mọ́ pé wọn kò nígbà owó kankan mọ́ lọ́wọ́ àwọn ènìyàn bẹ́ẹ̀ sì ni, wọn kò sì ní tún ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.8",
            "verseOrgIds": [
              "2KI.12.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.8",
                "verseOrgIds": [
                  "2KI.12.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe mọ́ fúnra wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.8",
            "verseOrgIds": [
              "2KI.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiada àlùfáà mú àpótí kan, ó sì lu ihò sí ìdérí rẹ̀. Ó gbé e sí ẹ̀gbẹ́ pẹpẹ ní apá ọ̀tún bí ẹnìkan ti wọlé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.9",
            "verseOrgIds": [
              "2KI.12.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.9",
                "verseOrgIds": [
                  "2KI.12.10"
                ]
              }
            }
          ]
        },
        {
          "text": ". Àwọn àlùfáà tí ó ṣọ́ ẹnu-ọ̀nà àbáwọlé fi sínú àpótí náà gbogbo owó tí a mú wá sí ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.9",
            "verseOrgIds": [
              "2KI.12.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.9",
                "verseOrgIds": [
                  "2KI.12.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.9",
            "verseOrgIds": [
              "2KI.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbàkígbà tí wọ́n bá ti rí wí pé owó púpọ̀ wà nínú àpótí, akọ̀wé ọba àti olórí àlùfáà yóò wá, wọ́n á ka owó náà tí wọ́n ti mú wá sí ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.10",
            "verseOrgIds": [
              "2KI.12.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.10",
                "verseOrgIds": [
                  "2KI.12.11"
                ]
              }
            }
          ]
        },
        {
          "text": ". Wọn a sì kó o sínú àwọn àpò.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.10",
            "verseOrgIds": [
              "2KI.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n bá ti pinnu iye rẹ̀, wọn a kó owó náà fún àwọn tí a ti yàn láti bojútó iṣẹ́ náà lórí ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.11",
            "verseOrgIds": [
              "2KI.12.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.11",
                "verseOrgIds": [
                  "2KI.12.12"
                ]
              }
            }
          ]
        },
        {
          "text": ". Pẹ̀lú u rẹ̀, wọ́n sọ fún àwọn tí ó ń ṣiṣẹ́ lórí ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.11",
            "verseOrgIds": [
              "2KI.12.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.11",
                "verseOrgIds": [
                  "2KI.12.12"
                ]
              }
            }
          ]
        },
        {
          "text": "; àwọn gbẹ́nàgbẹ́nà àti àwọn olùkọ́lé.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.11",
            "verseOrgIds": [
              "2KI.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ilé ńlá àti àwọn agékúta. Wọ́n ra igi gẹdú àti òkúta tí wọ́n tọ́jú fún tuntun ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.12",
            "verseOrgIds": [
              "2KI.12.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.12",
                "verseOrgIds": [
                  "2KI.12.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe. Wọ́n tún ohun gbogbo tí wọ́n ná fún títún tẹmpili ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.12",
            "verseOrgIds": [
              "2KI.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owó tí a mú wá sí ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.13",
            "verseOrgIds": [
              "2KI.12.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.13",
                "verseOrgIds": [
                  "2KI.12.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kò jẹ́ níná fún ṣíṣe òpó fàdákà, ohun èlò ta fi ń fa ẹnu fìtílà, àwokòtò, ìpè, ohun èlò wúrà tàbí ohun èlò fàdákà kan fún ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.13",
            "verseOrgIds": [
              "2KI.12.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.13",
                "verseOrgIds": [
                  "2KI.12.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.13",
            "verseOrgIds": [
              "2KI.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sì san án fún àwọn ọkùnrin tí ó ń ṣiṣẹ́, tí wọ́n ń tọ́jú ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.14",
            "verseOrgIds": [
              "2KI.12.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.14",
                "verseOrgIds": [
                  "2KI.12.15"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.14",
            "verseOrgIds": [
              "2KI.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn kò sì bá àwọn ọkùnrin náà ṣírò, ní ọwọ́ ẹni tí wọ́n fún ní owó láti san fún àwọn òṣìṣẹ́. Torí wọ́n ṣe é pẹ̀lú òdodo tí ó pé.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.15",
            "verseOrgIds": [
              "2KI.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owó láti ibi ọrẹ ẹ̀bi àti ọrẹ ẹ̀ṣẹ̀ ní a kò mú wá sí ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.16",
            "verseOrgIds": [
              "2KI.12.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.16",
                "verseOrgIds": [
                  "2KI.12.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", ó jẹ́ ti àwọn àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.16",
            "verseOrgIds": [
              "2KI.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní déédé àkókò yìí, Hasaeli ọba Siria gòkè lọ láti dojúkọ Gati àti láti fi agbára mú un. Nígbà náà, ó yípadà láti dojúkọ Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.17",
            "verseOrgIds": [
              "2KI.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jehoaṣi ọba Juda mú gbogbo ohun mímọ́ tí a gbé ka iwájú tí a yà sọ́tọ̀ nípasẹ̀ baba rẹ̀ Jehoṣafati, Jehoramu àti Ahasiah, àwọn ọba Juda, àti àwọn ẹ̀bùn tí òun tìkára rẹ̀ ti yà sọ́tọ̀ àti gbogbo wúrà, tí ó rí nínú ibi ìfowópamọ́ sí ilé tí a kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.18",
            "verseOrgIds": [
              "2KI.12.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.18",
                "verseOrgIds": [
                  "2KI.12.19"
                ]
              }
            }
          ]
        },
        {
          "text": "àti ní ti ààfin ọba, ó sì fi wọ́n ránṣẹ́ sí Hasaeli; ọba Siria, tí ó sì fà padà kúrò ní Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.18",
            "verseOrgIds": [
              "2KI.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú ìyókù ìṣe Joaṣi, àti ohun gbogbo tí ó ṣe, a kò ha kọ wọ́n sínú ìwé ìtàn ayé àwọn ọba Juda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.19",
            "verseOrgIds": [
              "2KI.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn oníṣẹ́ rẹ̀ dìtẹ̀ sí i wọ́n sì lù ú pa ní Beti-Milo ní ọ̀nà sí Silla.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.20",
            "verseOrgIds": [
              "2KI.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn oníṣẹ́ tí ó pa á jẹ́ Josabadi ọmọ Ṣimeati àti Jehosabadi ọmọ Ṣomeri. Ó kú, wọ́n sì sin ín pẹ̀lú baba rẹ̀ ní ìlú ńlá ti Dafidi. Amasiah ọmọ rẹ̀ sì rọ́pò rẹ̀ gẹ́gẹ́ bí ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.21",
            "verseOrgIds": [
              "2KI.12.22"
            ]
          }
        }
      ]
    }
