              "type": "text"
            }
          ]
        },
        {
          "text": "Gbọ́ igbe àwọn olùṣọ́-àgùntàn,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.36",
            "verseOrgIds": [
