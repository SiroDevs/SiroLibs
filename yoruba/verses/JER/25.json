  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "JER 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àádọ́rin ọdún nínú oko ẹrú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀ sì tọ Jeremiah wá nípa àwọn ènìyàn Juda ní ọdún kẹrin Jehoiakimu ọmọ Josiah ọba Juda, èyí tí ó jẹ́ ọdún kìn-ín-ní Nebukadnessari ọba Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.1",
            "verseOrgIds": [
              "JER.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, Jeremiah wòlíì sọ fún gbogbo àwọn ènìyàn Juda àti sí àwọn olùgbé Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.2",
            "verseOrgIds": [
              "JER.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún odidi ọdún mẹ́tàlélógún, bẹ̀rẹ̀ láti ọdún kẹtàlá Josiah, ọmọ Amoni ọba Juda, títí di ọjọ́ yìí, ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.3",
            "verseOrgIds": [
              "JER.25.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.3",
                "verseOrgIds": [
                  "JER.25.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tọ̀ mí wá, mo sì ti sọ ọ́ fún un yín láti ìgbà dé ìgbà, ṣùgbọ́n ẹ̀yin kò fetísílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.3",
            "verseOrgIds": [
              "JER.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó tilẹ̀ jẹ́ pé",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.4",
            "verseOrgIds": [
              "JER.25.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.4",
                "verseOrgIds": [
                  "JER.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ti rán gbogbo àwọn ìránṣẹ́ rẹ̀, àwọn wòlíì sí i yín láti ìgbà dé ìgbà, ẹ̀yin kò fetísílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.4",
            "verseOrgIds": [
              "JER.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì wí pé, \"Ẹ yípadà olúkúlùkù yín kúrò ní inú ibi rẹ̀ àti ní ọ̀nà ibi rẹ̀, ẹ̀yin yóò sì lè dúró ní ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.5",
            "verseOrgIds": [
              "JER.25.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.5",
                "verseOrgIds": [
                  "JER.25.5"
                ]
              }
            }
          ]
        },
        {
          "text": "fún un yín àti àwọn baba yín títí láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.5",
            "verseOrgIds": [
              "JER.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe tọ àwọn ọlọ́run mìíràn lẹ́yìn láti sìn wọ́n tàbí bọ wọ́n; ẹ má ṣe mú inú bí mi pẹ̀lú ohun tí ẹ ti fi ọwọ́ yín ṣe. Nígbà náà ni Èmi kò ní ṣe yín ní ibi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.6",
            "verseOrgIds": [
              "JER.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n ẹ̀yin kò fetí sí mi,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.7",
            "verseOrgIds": [
              "JER.25.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.7",
                "verseOrgIds": [
                  "JER.25.7"
                ]
              }
            }
          ]
        },
        {
          "text": "wí; \"bẹ́ẹ̀ ni ẹ sì ti mú inú bí mi pẹ̀lú ohun tí ẹ fi ọwọ́ yín ṣe, ẹ sì ti mú ibi wá sórí ara yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.7",
            "verseOrgIds": [
              "JER.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.8",
            "verseOrgIds": [
              "JER.25.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.8",
                "verseOrgIds": [
                  "JER.25.8"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun sọ èyí: \"Nítorí wí pé ẹ̀yin kò fetí sí ọ̀rọ̀ mi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.8",
            "verseOrgIds": [
              "JER.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò pe gbogbo àwọn ènìyàn àríwá, àti ìránṣẹ́ mi Nebukadnessari ọba Babeli,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.9",
            "verseOrgIds": [
              "JER.25.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.9",
                "verseOrgIds": [
                  "JER.25.9"
                ]
              }
            }
          ]
        },
        {
          "text": "wí. \"Èmi yóò sì mú wọn dìde lòdì sí ilẹ̀ náà àti àwọn olùgbé rẹ̀ àti sí gbogbo orílẹ̀-èdè àyíká rẹ̀. Èmi yóò pa wọ́n run pátápátá, Èmi yóò sọ wọ́n di nǹkan ẹ̀rù àti yẹ̀yẹ́ àti ìparun ayérayé.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.9",
            "verseOrgIds": [
              "JER.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì mú ìró ayọ̀ àti inú dídùn kúrò lọ́dọ̀ wọn; ohùn ìyàwó àti ọkọ ìyàwó, ìró ọlọ òkúta àti ìmọ́lẹ̀ fìtílà.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.10",
            "verseOrgIds": [
              "JER.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo orílẹ̀-èdè yìí yóò sì di ahoro, orílẹ̀-èdè yìí yóò sì sìn ọba Babeli ní àádọ́rin ọdún.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.11",
            "verseOrgIds": [
              "JER.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n, nígbà tí àádọ́rin ọdún náà bá pé, Èmi yóò fi ìyà jẹ ọba Babeli àti orílẹ̀-èdè rẹ, ilẹ̀ àwọn ará Babeli nítorí ẹ̀ṣẹ̀ wọn,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.12",
            "verseOrgIds": [
              "JER.25.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.12",
                "verseOrgIds": [
                  "JER.25.12"
                ]
              }
            }
          ]
        },
        {
          "text": "wí; \"bẹ́ẹ̀ ni Èmi yóò sọ ọ́ di ahoro títí láé.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.12",
            "verseOrgIds": [
              "JER.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì mú gbogbo ohun tí mo ti sọ wọ̀nyí wá sórí ilẹ̀ náà, gbogbo ohun tí a ti sọ àní gbogbo èyí tí a ti kọ sínú ìwé yìí, èyí tí Jeremiah ti sọtẹ́lẹ̀ sí gbogbo orílẹ̀-èdè.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.13",
            "verseOrgIds": [
              "JER.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn fúnra wọn yóò sì sin orílẹ̀-èdè púpọ̀ àti àwọn ọba ńlá. Èmi yóò sì sán fún oníkálùkù gẹ́gẹ́ bí ìṣe àti iṣẹ́ ọwọ́ wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.14",
            "verseOrgIds": [
              "JER.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ago ìbínú Ọlọ́run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.15",
            "verseOrgIds": [
              "JER.25.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.15",
                "verseOrgIds": [
                  "JER.25.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli wí fún mi: \"Gba ago yìí ní ọwọ́ mí tí ó kún fún ọtí wáìnì ìbínú mi, kí o sì mú gbogbo orílẹ̀-èdè ti mo rán ọ sí mu ún.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.15",
            "verseOrgIds": [
              "JER.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n bá mu ún, wọn yóò ta gbọ̀nọ́ngbọ̀nọ́n: bẹ́ẹ̀ ni kí wọ́n di aṣiwèrè nítorí idà tí yóò ránṣẹ́ sí àárín wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.16",
            "verseOrgIds": [
              "JER.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sì gba ago náà lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.17",
            "verseOrgIds": [
              "JER.25.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.17",
                "verseOrgIds": [
                  "JER.25.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", bẹ́ẹ̀ ni mo sì mú gbogbo orílẹ̀-èdè tí ó rán mi sí mu ún.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.17",
            "verseOrgIds": [
              "JER.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jerusalẹmu àti àwọn ìlú Juda, àwọn ọba wọn pẹ̀lú àwọn aláṣẹ wọn, láti sọ wọ́n di ohun ìparun, ohun ẹ̀rù, ẹ̀sìn àti ègún, gẹ́gẹ́ bí wọ́n ti rí lónìí yìí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.18",
            "verseOrgIds": [
              "JER.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao ọba Ejibiti, àwọn ìránṣẹ́ rẹ̀, àwọn aláṣẹ rẹ̀ àti àwọn ènìyàn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.19",
            "verseOrgIds": [
              "JER.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti gbogbo àwọn ènìyàn àjèjì tí ó wà níbẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.20",
            "verseOrgIds": [
              "JER.25.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JER 25:20"
      },
      "items": [
        {
          "text": "gbogbo àwọn ọba Usi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.20",
            "verseOrgIds": [
              "JER.25.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JER 25:20"
      },
      "items": [
        {
          "text": "gbogbo àwọn ọba Filistini, gbogbo àwọn ti Aṣkeloni, Gasa, Ekroni àti gbogbo àwọn ènìyàn tí ó kù sí Aṣdodu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.20",
            "verseOrgIds": [
              "JER.25.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edomu, Moabu àti Ammoni;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.21",
            "verseOrgIds": [
              "JER.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "gbogbo àwọn ọba Tire àti Sidoni;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.22",
            "verseOrgIds": [
              "JER.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JER 25:22"
      },
      "items": [
        {
          "text": "gbogbo àwọn ọba erékùṣù wọ̀n-ọn-nì tí ń bẹ ní ìkọjá Òkun.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.22",
            "verseOrgIds": [
              "JER.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dedani, Tema, Busi àti gbogbo àwọn tí ń gbé lọ́nà jíjìn réré.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.23",
            "verseOrgIds": [
              "JER.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọba Arabia àti àwọn ọba àwọn àjèjì ènìyàn tí ń gbé inú aginjù.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.24",
            "verseOrgIds": [
              "JER.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọba Simri, Elamu àti Media.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.25",
            "verseOrgIds": [
              "JER.25.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti gbogbo àwọn ọba àríwá ní tòsí àti lọ́nà jíjìn, ẹnìkínní lẹ́yìn ẹnìkejì; gbogbo àwọn ìjọba lórí orílẹ̀ ayé.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.26",
            "verseOrgIds": [
              "JER.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JER 25:26"
      },
      "items": [
        {
          "text": "Àti gbogbo wọn, ọba Ṣeṣaki náà yóò sì mu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.26",
            "verseOrgIds": [
              "JER.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà náà, sọ fún wọn, èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.27",
            "verseOrgIds": [
              "JER.25.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.27",
                "verseOrgIds": [
                  "JER.25.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Alágbára Israẹli wí. Mu, kí o sì mú àmuyó kí o sì bì, bẹ́ẹ̀ ni kí o sì ṣubú láì dìde mọ́ nítorí idà tí n ó rán sí àárín yín.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.27",
            "verseOrgIds": [
              "JER.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí wọ́n ba kọ̀ láti gba ago náà ní ọwọ́ rẹ kí wọ́n sì mu ún, sọ fún wọn pé, 'Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.28",
            "verseOrgIds": [
              "JER.25.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.28",
                "verseOrgIds": [
                  "JER.25.28"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun sọ: Ẹyin gbọdọ̀ mu ún!",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.28",
            "verseOrgIds": [
              "JER.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wò ó, èmi ń mú ibi bọ̀ sí orí orílẹ̀-èdè tí ó ń jẹ́ orúkọ mi; ǹjẹ́ yóò ha a lè lọ láìjìyà? Ẹ̀yin ń pe idà sọ̀kalẹ̀ sórí gbogbo àwọn olùgbé ayé, ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.29",
            "verseOrgIds": [
              "JER.25.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.29",
                "verseOrgIds": [
                  "JER.25.29"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun sọ.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.29",
            "verseOrgIds": [
              "JER.25.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nísinsin yìí, sọ àsọtẹ́lẹ̀ àwọn ọ̀rọ̀ wọ̀nyí nípa wọn:",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:30"
      },
      "items": [
        {
          "text": "\" 'Kí o sì sọ pé,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.30",
                "verseOrgIds": [
                  "JER.25.30"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò bú láti òkè wá,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:30"
      },
      "items": [
        {
          "text": "yóò sì bú kíkankíkan sí ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:30"
      },
      "items": [
        {
          "text": "Yóò parí gbogbo olùgbé ayé, bí àwọn tí ń tẹ ìfúntí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìrọ́kẹ̀kẹ̀ yóò wà títí dé òpin ilẹ̀ ayé,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:31"
      },
      "items": [
        {
          "text": "nítorí pé",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.31",
                "verseOrgIds": [
                  "JER.25.31"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò mú ìdààmú wá sí orí",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:31"
      },
      "items": [
        {
          "text": "àwọn orílẹ̀-èdè náà,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:31"
      },
      "items": [
        {
          "text": "yóò mú ìdájọ́ wá sórí gbogbo ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:31"
      },
      "items": [
        {
          "text": "yóò sì fi àwọn olùṣe búburú fún idà,' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:31"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.31",
                "verseOrgIds": [
                  "JER.25.31"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.32",
                "verseOrgIds": [
                  "JER.25.32"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:32"
      },
      "items": [
        {
          "text": "\"Wò ó! Ibi ń tànkálẹ̀ láti orílẹ̀-èdè kan sí òmíràn;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:32"
      },
      "items": [
        {
          "text": "ìjì ńlá yóò sì ru sókè láti òpin ayé.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, àwọn tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.33",
            "verseOrgIds": [
              "JER.25.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.25.33",
                "verseOrgIds": [
                  "JER.25.33"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pa yóò wà ní ibi gbogbo, láti ìpẹ̀kun kan sí òmíràn. A kì yóò ṣọ̀fọ̀ wọn, a kì yóò kó wọn jọ tàbí sin wọ́n; ṣùgbọ́n wọn yóò dàbí ààtàn lórí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.33",
            "verseOrgIds": [
              "JER.25.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ké, kí ẹ sì pohùnréré ẹkún ẹ̀yin olùṣọ́-àgùntàn,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:34"
      },
      "items": [
        {
          "text": "ẹ yí nínú eruku, ẹ̀yin olùdarí agbo ẹran.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:34"
      },
      "items": [
        {
          "text": "Nítorí pé ọjọ́ àti pa yín ti dé,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:34"
      },
      "items": [
        {
          "text": "ẹ̀yin ó sì ṣubú bí ohun èlò iyebíye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn olùṣọ́-àgùntàn kì yóò rí ibi sálọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.35",
            "verseOrgIds": [
              "JER.25.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:35"
      },
      "items": [
        {
          "text": "kì yóò sì ṣí àsálà fún olórí agbo ẹran.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.35",
            "verseOrgIds": [
              "JER.25.35"
            ]
          }
        }
      ]
    },
