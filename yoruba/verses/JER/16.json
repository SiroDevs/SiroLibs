          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọjọ́ àjálù",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bákan náà ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.1",
            "verseOrgIds": [
              "JER.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.1",
                "verseOrgIds": [
                  "JER.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ mí wá wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.1",
            "verseOrgIds": [
              "JER.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ kò gbọdọ̀ ní ìyàwó, bẹ́ẹ̀ ni ìwọ kò gbọdọ̀ ní ọmọkùnrin tàbí ọmọbìnrin níbí yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.2",
            "verseOrgIds": [
              "JER.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.3",
            "verseOrgIds": [
              "JER.16.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.3",
                "verseOrgIds": [
                  "JER.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "wí nípa ọmọkùnrin tàbí ọmọbìnrin tí wọ́n bá bí nílẹ̀ yìí, àti ìyá tí ó bí wọn àti baba wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.3",
            "verseOrgIds": [
              "JER.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wọn yóò kú ikú ààrùn, wọn kò ní sin wọ́n tàbí ṣọ̀fọ̀ fún wọn. Wọn ó dàbí ìdọ̀tí lórí ilẹ̀; wọn ó ṣègbé pẹ̀lú idà àti ìyàn. Òkú wọn yóò sì di oúnjẹ fún ẹyẹ ojú ọ̀run àti ẹranko ilẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.4",
            "verseOrgIds": [
              "JER.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.5",
                "verseOrgIds": [
                  "JER.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "wí: \"Má ṣe wọ ilé tí oúnjẹ ìsìnkú wà, má ṣe lọ síbẹ̀ láti káàánú tàbí ṣọ̀fọ̀, nítorí mo ti mú àlàáfíà, ìfẹ́ àti àánú mi kúrò lórí àwọn ènìyàn wọ̀nyí,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.5",
                "verseOrgIds": [
                  "JER.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àti ẹni ńlá àti kékeré ni yóò ṣègbé ní ilẹ̀ yìí, wọn kò ní sin wọ́n tàbí ṣọ̀fọ̀ wọn, bẹ́ẹ̀ ni kò sí ẹni tí yóò fá irun orí wọn nítorí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.6",
            "verseOrgIds": [
              "JER.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ẹni tí yóò fi oúnjẹ tu àwọn tí í ṣọ̀fọ̀ nínú, kódà kì í ṣe fún baba tàbí fún ìyá, kì yóò sí ẹni tí yóò fi ohun mímu tù wọ́n nínú.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.7",
            "verseOrgIds": [
              "JER.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ kò gbọdọ̀ lọ sí ilé tí àjọyọ̀ wà, má ṣe jókòó jẹun tàbí mu ohun mímu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.8",
            "verseOrgIds": [
              "JER.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.9",
            "verseOrgIds": [
              "JER.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.9",
                "verseOrgIds": [
                  "JER.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun, Ọlọ́run àwọn ọmọ Israẹli wí, Ní ojú yín ní ọjọ́ yín ni òpin yóò dé bá ìró ayọ̀ àti ìdùnnú, àti sí ohùn ìyàwó àti ọkọ ìyàwó ní ibí yìí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.9",
            "verseOrgIds": [
              "JER.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà tí o bá sọ nǹkan wọ̀nyí fún àwọn ènìyàn yìí, tí wọ́n bá sì bi ọ́ wí pé, 'Èéṣe tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.10",
            "verseOrgIds": [
              "JER.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.10",
                "verseOrgIds": [
                  "JER.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe mú búburú yìí bá wa? Kí ni àṣìṣe tí àwa ṣe? Kín ni ẹ̀ṣẹ̀ tí àwa ṣẹ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.10",
            "verseOrgIds": [
              "JER.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.10",
                "verseOrgIds": [
                  "JER.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa?'",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.10",
            "verseOrgIds": [
              "JER.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ìwọ yóò sọ fún wọn wí pé, 'Nítorí tí àwọn baba yín ti kọ̀ mí sílẹ̀,' ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.11",
            "verseOrgIds": [
              "JER.16.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.11",
                "verseOrgIds": [
                  "JER.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, 'tí wọ́n sì tẹ̀lé àwọn òrìṣà mìíràn tí wọ́n ń bọ, tí wọ́n ń sìn, wọ́n kọ̀ mí sílẹ̀ wọn kò sì tẹ̀lé òfin mi mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.11",
            "verseOrgIds": [
              "JER.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ̀yin ti ṣe búburú ju ti àwọn baba yín lọ. Wò ó bí gbogbo yín ṣe ń rìn, olúkúlùkù yín nínú agídí ọkàn búburú rẹ̀, dípò kí ẹ fi gbọ́ tèmi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.12",
            "verseOrgIds": [
              "JER.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò gbé yin kúrò ní ilẹ̀ yìí lọ sí ilẹ̀ tí baba yín tàbí ẹ̀yin kò mọ̀ rí, níbẹ̀ ni ẹ̀yin yóò ti máa sìn ọlọ́run kéékèèké ní ọ̀sán àti òru nítorí èmi kì yóò fi ojúrere wò yín.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.13",
            "verseOrgIds": [
              "JER.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà, ọjọ́ náà ń bọ̀ wá,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.14",
            "verseOrgIds": [
              "JER.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.14",
                "verseOrgIds": [
                  "JER.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, \"tí àwọn ènìyàn kò ní sọ pé, 'Dájúdájú",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.14",
            "verseOrgIds": [
              "JER.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.14",
                "verseOrgIds": [
                  "JER.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "wà láààyè",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.14",
            "verseOrgIds": [
              "JER.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.14",
                "verseOrgIds": [
                  "JER.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ń bẹ, Ẹni tí ó mú Israẹli jáde kúrò ní Ejibiti.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.14",
            "verseOrgIds": [
              "JER.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n wọn yóò sọ wí pé, 'Bí",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.15",
            "verseOrgIds": [
              "JER.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.15",
                "verseOrgIds": [
                  "JER.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe wà nítòótọ́ tí ó mú àwọn ọmọ Israẹli jáde kúrò ní ilẹ̀ àríwá àti ní gbogbo orílẹ̀-èdè tí ó ti lé wọn.' Bẹ́ẹ̀ ni èmi yóò dá wọn padà sí ilẹ̀ tí mo fún àwọn baba ńlá wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.15",
            "verseOrgIds": [
              "JER.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n báyìí, Èmi yóò ránṣẹ́ sí àwọn apẹja púpọ̀,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.16",
            "verseOrgIds": [
              "JER.16.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.16",
                "verseOrgIds": [
                  "JER.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": "wí. \"Wọn ó sì dẹ wọ́n lẹ́yìn èyí yìí èmi yóò ránṣẹ́ sí àwọn ọdẹ púpọ̀, wọn yóò dẹ wọ́n lórí gbogbo òkè ńlá àti òkè gíga, àti ní gbogbo pálapàla àpáta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.16",
            "verseOrgIds": [
              "JER.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojú mi wà ní gbogbo ọ̀nà wọn, wọn kò pamọ́ fún mi bẹ́ẹ̀ ni ẹ̀ṣẹ̀ wọn kò fi ara sin lójú mi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.17",
            "verseOrgIds": [
              "JER.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò san ẹ̀san ìwà búburú àti ẹ̀ṣẹ̀ wọn fún wọn ní ìlọ́po méjì, nítorí wọ́n ti ba ilẹ̀ mi jẹ́ pẹ̀lú àwọn ère wọn aláìlẹ́mìí, wọ́n sì fi òkú àti ohun ẹ̀gbin àti ìríra wọn kún ilẹ̀ ìní mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.18",
            "verseOrgIds": [
              "JER.16.18"
            ]
          }
        }
      ]
    },
