  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "JER 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní oṣù keje Iṣmaeli, ọmọ Netaniah ọmọ Eliṣama, nínú irú-ọmọ ọba, àti àwọn ìjòyè ọba, àti àwọn ọkùnrin mẹ́wàá pẹ̀lú rẹ̀, wọ́n tọ Gedaliah ọmọ Ahikamu wá ní Mispa; níbẹ̀ ni wọ́n jùmọ̀ jẹun ní Mispa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iṣmaeli ọmọ Netaniah àti àwọn ọkùnrin mẹ́wàá tí wọ́n wà pẹ̀lú rẹ̀, sì dìde wọ́n kọlu Gedaliah ọmọ Ahikamu, ọmọ Ṣafani pẹ̀lú idà. Wọ́n sì pa á, ẹni tí ọba Babeli ti fi jẹ baálẹ̀ lórí ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iṣmaeli sì tún pa gbogbo àwọn Júù tí wọ́n wà pẹ̀lú Gedaliah ní Mispa, àti gbogbo àwọn ọmọ-ogun Babeli tí wọ́n wà níbẹ̀ bákan náà.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kejì tí wọ́n pa Gedaliah kí ó tó di wí pé ẹnikẹ́ni mọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn ọgọ́rin ọkùnrin wá láti Ṣekemu, Ṣilo àti Samaria, wọ́n fa irùngbọ̀n wọn, wọ́n ya aṣọ wọn, wọ́n ṣá ara wọn lọ́gbẹ́, wọ́n mú ẹbọ ọpẹ́ àti tùràrí wá sí ilé",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.41.5",
                "verseOrgIds": [
                  "JER.41.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iṣmaeli ọmọkùnrin Netaniah jáde kúrò láti Mispa láti lọ pàdé wọn. Ó sì ń sọkún bí ó ti ṣe ń lọ, nígbà tí ó pàdé wọn, ó wí pé, \"Ẹ wá sọ́dọ̀ Gedaliah ọmọkùnrin Ahikamu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n dé ìlú náà; Iṣmaeli ọmọkùnrin Netaniah àti àwọn ọkùnrin tí ó wà pẹ̀lú rẹ̀ pa wọ́n, wọ́n sì sọ òkú wọn sínú ihò kan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n mẹ́wàá nínú wọn sọ fún Iṣmaeli pé, \"Má ṣe pa wá! Àwa ní ọkà àti barle, òróró àti oyin ní ìpamọ́ nínú oko.\" Nítorí náà, ó fi wọ́n sílẹ̀: kò sì pa wọ́n pẹ̀lú àwọn yòókù.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, ihò náà tí ó kó gbogbo ara àwọn ọkùnrin tí ó ti pa pẹ̀lú Gedaliah sí ni ọba Asa ń lò gẹ́gẹ́ bí i ààbò nítorí ọba Baaṣa ti Israẹli. Iṣmaeli ọmọ Netaniah sì ti kó òkú kún inú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iṣmaeli sì kó gbogbo àwọn ènìyàn tí ó wà ní Mispa nígbèkùn, ọmọbìnrin ọba àti gbogbo àwọn ènìyàn tókù síbẹ̀ lórí àwọn tí Nebusaradani balógun àwọn ẹ̀ṣọ́ ti fi yan Gedaliah ọmọkùnrin Ahikamu ṣe olórí. Iṣmaeli ọmọkùnrin Netaniah kó wọn ní ìgbèkùn, ó sì jáde rékọjá sí ọ̀dọ̀ àwọn Ammoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Johanani ọmọkùnrin Karea àti gbogbo àwọn olórí ogun tí wọ́n wà pẹ̀lú rẹ̀ gbọ́ nípa gbogbo ìpànìyàn náà tí Iṣmaeli ọmọ Netaniah ti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n kó gbogbo àwọn ọkùnrin wọn, wọ́n sì, lọ bá Iṣmaeli ọmọ Netaniah jà. Wọ́n pàdé rẹ̀ ní odò kan lẹ́bàá Gibeoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí gbogbo àwọn ènìyàn Iṣmaeli tí wọ́n wà pẹ̀lú rẹ̀ rí Johanani ọmọkùnrin Karea àti àwọn olórí ogun rẹ̀ pẹ̀lú rẹ̀, wọ́n sì yọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ènìyàn tí Iṣmaeli ti kó ní ìgbèkùn ní Mispa yípadà, wọ́n sì lọ sọ́dọ̀ Johanani ọmọ Karea.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Iṣmaeli ọmọkùnrin Netaniah àti àwọn mẹ́jọ nínú àwọn ọkùnrin rẹ̀ bọ́ lọ́wọ́ Johanani, wọ́n sì sálọ sí Ammoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sísá lọ sí Ejibiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà Johanani ọmọkùnrin Karea àti gbogbo àwọn ọmọ-ogun tí wọn wà pẹ̀lú rẹ̀ sì kó gbogbo àwọn tí ó kù ní Mispa; àwọn tí ó ti rí gbà lọ́wọ́ Iṣmaeli ọmọkùnrin Netaniah; lẹ́yìn ìgbà tí ó ti pa Gedaliah ọmọ Ahikamu. Àwọn ọmọ-ogun, àwọn obìnrin, àwọn ọmọdé àti àwọn olórí ilé ẹjọ́ tí ó ti kó wa láti Gibeoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì kúrò níbẹ̀, wọ́n dúró ní Geruti Kimhamu ní ẹ̀bá Bẹtilẹhẹmu ní ọ́nà ìrìnàjò wọn sí Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti gba àwọn Babeli sílẹ̀. Wọ́n bẹ̀rù wọn nítorí wí pé, \"Iṣmaeli ọmọ Netaniah ti pa Gedaliah ọmọ Ahikamu èyí tí ọba Babeli ti yàn gẹ́gẹ́ bí i gómìnà lórí ilẹ̀ náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.18",
            "verseOrgIds": [
              "JER.41.18"
            ]
          }
        }
      ]
    }
  ],
