  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "52",
        "style": "c",
        "sid": "JER 52"
      },
      "items": [
        {
          "text": "52",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìṣubú Jerusalẹmu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 52:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sedekiah jẹ́ ọmọ ọdún mọ́kànlélógún nígbà tí ó jẹ ọba. Ọdún mọ́kànlá ló fi jẹ ọba ní Jerusalẹmu. Orúkọ ìyá rẹ̀ ni Hamutali ọmọ Jeremiah; láti Libina ló ti wá.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.1",
            "verseOrgIds": [
              "JER.52.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.2",
            "verseOrgIds": [
              "JER.52.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.2",
                "verseOrgIds": [
                  "JER.52.2"
                ]
              }
            }
          ]
        },
        {
          "text": "gẹ́gẹ́ bí Jehoiakimu ti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.2",
            "verseOrgIds": [
              "JER.52.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.3",
                "verseOrgIds": [
                  "JER.52.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ni gbogbo èyí ṣe ṣẹlẹ̀ sí Jerusalẹmu àti Juda àti ní ìkẹyìn. Ó sì gbà wọ́n gbọ́ ní iwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 52:3"
      },
      "items": [
        {
          "text": "Sedekiah ṣọ̀tẹ̀ sí ọba Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó di ọdún kẹsànán ti Sedekiah tí ń ṣe ìjọba ní ọjọ́ kẹwàá, oṣù kẹwàá Nebukadnessari ọba Babeli sì lọ sí Jerusalẹmu pẹ̀lú gbogbo àwọn ọmọ-ogun rẹ̀, wọ́n pàgọ́ sí ẹ̀yìn odi ìlú náà; wọ́n sì mọ odi yíká rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.4",
            "verseOrgIds": [
              "JER.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìlú náà sì wá lábẹ́ ìhámọ́ títí di ọdún kọkànlá ọba Sedekiah.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.5",
            "verseOrgIds": [
              "JER.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹsànán, oṣù mẹ́rin ìyàn ìlú náà sì ti burú dé ibi pé kò sí oúnjẹ kankan mọ́ fún àwọn ènìyàn láti jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.6",
            "verseOrgIds": [
              "JER.52.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 52:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bákan náà, odi ìlú náà ti ya àwọn ọmọ-ogun sì tí sálọ. Wọn fi ìlú náà sílẹ̀ ní òru nípa ojú ọ̀nà tó wà láàrín odi méjèèjì lẹ́bàá ọgbà ọba. Bí ó tilẹ̀ jẹ́ wí pé, àwọn ará Babeli yìí yí ìlú náà ká. Wọ́n sá gba aginjù lọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.7",
            "verseOrgIds": [
              "JER.52.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn ọmọ-ogun Babeli lépa ọba Sedekiah wọ́n sì le bá ni pẹ̀tẹ́lẹ̀ Jeriko. Gbogbo àwọn ọmọ-ogun sì pínyà, kúrò ní ọ̀dọ̀ rẹ̀ wọ́n sì túká.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.8",
            "verseOrgIds": [
              "JER.52.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì mu ní ìgbèkùn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.9",
            "verseOrgIds": [
              "JER.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 52:9"
      },
      "items": [
        {
          "text": "Wọn mú un lọ sí ọ̀dọ̀ ọba Babeli, ní Ribla ní ilẹ̀ Hamati níbẹ̀ ni ó ti ṣe ìdájọ́ lórí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.9",
            "verseOrgIds": [
              "JER.52.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 52:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní Ribla ni ọba Babeli ti pa ọmọkùnrin Sedekiah lójú rẹ̀; ó sì tún pa gbogbo àwọn aláṣẹ Juda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.10",
            "verseOrgIds": [
              "JER.52.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 52:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà, ọba Babeli yọ Sedekiah ní ojú, o sì fi ẹ̀wọ̀n dè é, ó sì gbe e lọ sí Babeli níbi tí ó ti fi sínú ọgbà ẹ̀wọ̀n títí di ọjọ́ ikú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.11",
            "verseOrgIds": [
              "JER.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 52:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹwàá oṣù karùn-ún, tí ó jẹ́ ọdún kọkàndínlógún Nebukadnessari ọba Babeli, ni Nebusaradani balógun ìṣọ́ wá sí Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.12",
            "verseOrgIds": [
              "JER.52.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 52:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó dáná sun pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.13",
            "verseOrgIds": [
              "JER.52.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.13",
                "verseOrgIds": [
                  "JER.52.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", ààfin ọba àti gbogbo àwọn ilé Jerusalẹmu. Ó sì dáná sun gbogbo àwọn ilé ńlá ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.13",
            "verseOrgIds": [
              "JER.52.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 52:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ogun Babeli, tí ó wà lọ́dọ̀ olórí ẹ̀ṣọ́, wó ògiri tí ó yí Jerusalẹmu ká lulẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.14",
            "verseOrgIds": [
              "JER.52.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 52:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebusaradani balógun ìṣọ́ kó gbogbo àwọn tálákà àti gbogbo àwọn tí ó kù ní ìlú, ní ìgbèkùn lọ sí Babeli, pẹ̀lú àwọn tí ó ya lọ, tí ó sì ya tọ ọba Babeli lọ, àti ìyókù àwọn ènìyàn náà.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.15",
            "verseOrgIds": [
              "JER.52.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 52:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Nebusaradani, balógun ìṣọ́ fi àwọn tálákà tó kú ní ilẹ̀ náà sílẹ̀ láti máa ṣiṣẹ́ nínú ọgbà àjàrà àti ro oko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.16",
            "verseOrgIds": [
              "JER.52.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 52:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Babeli fọ́ ọ̀wọ̀n idẹ wọ̀n-ọn-nì àti àwọn ìjókòó wọ̀n-ọn-nì, àti agbada idẹ títóbi wọ̀n-ọn-nì tí ń bẹ ní ilé",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
              "JER.52.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.17",
                "verseOrgIds": [
                  "JER.52.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", àwọn ará Babeli fọ́ túútúú, wọ́n sì kó gbogbo idẹ náà lọ sí Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
              "JER.52.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 52:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bákan náà, wọ́n tún kó àwọn ìkòkò wọ̀n-ọn-nì, ọkọ́ wọ̀n-ọn-nì àti ọ̀pá fìtílà wọ̀n-ọn-nì, àwọn ọpọ́n wọ̀n-ọn-nì, ṣíbí wọ̀n-ọn-nì àti gbogbo ohun èlò idẹ tí wọ́n ń lò níbi pẹpẹ lọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.18",
            "verseOrgIds": [
              "JER.52.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 52:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balógun ìṣọ́ náà kó àwokòtò wọ̀n-ọn-nì, ohun ìfọnná wọ̀n-ọn-nì, ọpọ́n wọ̀n-ọn-nì, ìkòkò wọ̀n-ọn-nì, ọ̀pá fìtílà wọ̀n-ọn-nì, ṣíbí wọ̀n-ọn-nì àti ago wáìnì wọ̀n-ọn-nì; èyí tí a fi wúrà àti fàdákà ṣe lọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.19",
            "verseOrgIds": [
              "JER.52.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 52:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀wọ́n méjì, agbada ńlá kan àti àwọn màlúù idẹ méjìlá tí ó wà lábẹ́ ìjókòó alágbéká tí Solomoni ọba ṣe fún ilé",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.20",
            "verseOrgIds": [
              "JER.52.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.20",
                "verseOrgIds": [
                  "JER.52.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", idẹ ni gbogbo ohun èlò wọ̀nyí, ó ju èyí tí a lè wọ́n lọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.20",
            "verseOrgIds": [
              "JER.52.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 52:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀kọ̀ọ̀kan nínú àwọn ọ̀wọ́n yìí ni ga ní ìwọ̀n ìgbọ̀nwọ́ méjìdínlógún; okùn ìgbọ̀nwọ́ méjìlá sì yí i ká. Ọ̀kọ̀ọ̀kan nípọn tó ìka mẹ́rin, wọ́n sì ní ihò nínú.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.21",
            "verseOrgIds": [
              "JER.52.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 52:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀nà orí idẹ kan tó ìgbọ̀nwọ́ márùn-ún ní gíga, wọ́n sì fi èso pomegiranate ṣe ọ̀ṣọ́ sí i lára yíká. Ọ̀wọ́n kejì sì wà pẹ̀lú èso pomegiranate tí ó jọra.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.22",
            "verseOrgIds": [
              "JER.52.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 52:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pomegiranate mẹ́rìndínlọ́gọ́rùn-ún ni ó wà ní àwọn ẹ̀gbẹ́ rẹ̀. Àpapọ̀ gbogbo pomegiranate sì jẹ́ ọgọ́rùn-ún kan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.23",
            "verseOrgIds": [
              "JER.52.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 52:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balógun àwọn ẹ̀ṣọ́ mu Seraiah olórí àwọn àlùfáà àti Sefaniah àlùfáà kejì àti àwọn olùṣọ́ ìloro mẹ́ta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.24",
            "verseOrgIds": [
              "JER.52.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 52:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú àwọn tí ó kù ní ilẹ̀ náà, ó mú ìwẹ̀fà kan, tí ó wà ní ìtọ́jú àwọn ológun, àti àwọn olùdámọ̀ràn ọba méje. Bákan náà, ó tún mu akọ̀wé olórí ogun tí ó wà ní ìtọ́jú títo àwọn ènìyàn ilẹ̀ náà, àti ọgọ́ta nínú àwọn ọkùnrin rẹ̀ tí wọ́n rí ní ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.25",
            "verseOrgIds": [
              "JER.52.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 52:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebusaradani, balógun ìṣọ́ kó gbogbo wọn, ó sì mú wọn tọ ọba Babeli wá ní Ribla.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.26",
            "verseOrgIds": [
              "JER.52.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Babeli sì kọlù wọ́n, ó sì pa wọ́n ní Ribla ni ilẹ̀ Hamati.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 52:27"
      },
      "items": [
        {
          "text": "Báyìí ni a mú Juda kúrò ní ilẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 52:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni iye àwọn ènìyàn tí Nebukadnessari kó lọ sí ilẹ̀ àjèjì.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JER 52:28"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JER 52:28"
      },
      "items": [
        {
          "text": "Ní ọdún keje ẹgbẹ̀rún mẹ́ta ó lé mẹ́tàlélógún (3,023) ará Juda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
              "JER.52.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 52:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kejìdínlógún Nebukadnessari",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JER 52:29"
      },
      "items": [
        {
          "text": "o kó ẹgbẹ̀rin ó lé méjìlélọ́gbọ̀n (832) láti Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 52:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kẹtàlélógún àwọn Júù",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JER 52:30"
      },
      "items": [
        {
          "text": "tí Nebusaradani kó lọ sí ilẹ̀ àjèjì jẹ́ ọ̀tàdínlẹ́gbẹ̀rin ó dín márùn-ún (745).",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JER 52:30"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JER 52:30"
      },
      "items": [
        {
          "text": "Gbogbo ènìyàn tí ó kó lápapọ̀ jẹ́ ẹgbẹ̀tàlélógún (4,600).",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìtúsílẹ̀ Jehoiakimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 52:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kẹtàdínlógójì ti Jehoiakini ọba Juda ni Efili-Merodaki di ọba Babeli. Ó gbé orí Jehoiakini ọba Juda sókè, ó sì tú sílẹ̀ nínú túbú ní ọjọ́ kẹẹdọ́gbọ̀n oṣù kejìlá.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ń sọ̀rọ̀ rere fún un, ó sì gbé ìtẹ́ rẹ̀ ga ju ìtẹ́ àwọn ọba tókù lọ tí ó wà pẹ̀lú rẹ̀ ní Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, Jehoiakini pàrọ̀ aṣọ túbú rẹ̀, ó sì ń jẹun ní gbogbo ìgbà ní iwájú rẹ̀ ní gbogbo ọjọ́ ayé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ojoojúmọ́ ni ọba Babeli ń fún Jehoiakini ní ìpín tirẹ̀ bí ó tí ń bẹ láààyè, títí di ọjọ́ kú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
            "verseOrgIds": [
              "JER.52.34"
            ]
          }
        }
      ]
    }
  ],
