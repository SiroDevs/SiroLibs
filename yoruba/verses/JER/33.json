        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìlérí ìmúpadàbọ̀sípò",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jeremiah wà nínú àgbàlá túbú, ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.1",
            "verseOrgIds": [
              "JER.33.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.1",
                "verseOrgIds": [
                  "JER.33.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ ọ́ wá lẹ́ẹ̀kejì:",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.1",
            "verseOrgIds": [
              "JER.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.2",
                "verseOrgIds": [
                  "JER.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ, ẹni tí ó dá ayé,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.2",
                "verseOrgIds": [
                  "JER.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó mọ ayé tí ó sì fi ìdí rẹ̀ múlẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.2",
                "verseOrgIds": [
                  "JER.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ni orúkọ rẹ̀:",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Pè mí, èmi ó sì dá ọ lóhùn, èmi ó sì sọ ohun alágbára ńlá àti ọ̀pọ̀ ohun tí kò ṣe é wádìí tí ìwọ kò mọ̀ fún ọ.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.3",
            "verseOrgIds": [
              "JER.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.4",
            "verseOrgIds": [
              "JER.33.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.4",
                "verseOrgIds": [
                  "JER.33.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run àwọn Israẹli sọ nípa àwọn ilẹ̀ ìlú yìí àti ààfin àwọn ọba Juda tí ó ti wó lulẹ̀ nítorí àwọn ìdọ̀tí àti idà",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.4",
            "verseOrgIds": [
              "JER.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nínú ìjà pẹ̀lú Kaldea: 'Wọn yóò kún fún ọ̀pọ̀ òkú ọmọkùnrin tí èmi yóò pa nínú ìbínú àti nínú ìrunú mi. Èmi ó pa ojú mi mọ́ kúrò ní ìlú yìí nítorí gbogbo búburú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.5",
            "verseOrgIds": [
              "JER.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Wò ó, èmi ó mú ọ̀já àti oògùn ìmúláradá dì í; èmi ó wo àwọn ènìyàn mi sàn. Èmi ó sì jẹ́ kí wọn ó jẹ ìgbádùn lọ́pọ̀lọ́pọ̀ àlàáfíà àti òtítọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.6",
            "verseOrgIds": [
              "JER.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ó mú Juda àti Israẹli kúrò nínú ìgbèkùn, èmi ó sì tún wọn kọ́ gẹ́gẹ́ bí wọ́n ṣe wà tẹ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.7",
            "verseOrgIds": [
              "JER.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ó wẹ̀ wọ́n nù kúrò nínú gbogbo ẹ̀ṣẹ̀ tí wọ́n ti ṣẹ sí mi. Èmi ó sì dárí gbogbo ẹ̀ṣẹ̀ àìṣedéédéé wọn sí mi jì wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.8",
            "verseOrgIds": [
              "JER.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ìlú yìí ó fún mi ní òkìkí, ayọ̀, ìyìn àti ọlá níwájú gbogbo orílẹ̀-èdè ayé; tí wọ́n gbọ́ gbogbo rere tí èmi ṣe fún wọn. Wọn ó sì bẹ̀rù, wọn ó wárìrì fún ọ̀pọ̀lọpọ̀ oore àti àlàáfíà tí èmi pèsè fún wọn.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.9",
            "verseOrgIds": [
              "JER.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.10",
                "verseOrgIds": [
                  "JER.33.10"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, 'Ẹ̀yin yóò wí nípa ibí yìí pé, \"Ó dahoro, láìsí ènìyàn tàbí ẹran.\" Síbẹ̀ ní ìlú Juda àti ní òpópónà Jerusalẹmu tí ó dahoro, láìsí ẹni tó gbé ibẹ̀; ìbá à se ènìyàn tàbí ẹran, tí yóò gbọ́ lẹ́ẹ̀kan sí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariwo ayọ̀ àti inú dídùn, ohùn ìyàwó àti ti ọkọ ìyàwó àti ohùn àwọn tí ó ru ẹbọ ọpẹ́ wọn nílé",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "\" ' \"Yin",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "nítorí",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": "dára,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "ìfẹ́ rẹ̀ dúró títí láéláé.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "Nítorí èmi ó dá ìkólọ ilẹ̀ náà padà sí bí o ṣe wà tẹ́lẹ̀,' ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.12",
            "verseOrgIds": [
              "JER.33.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.12",
                "verseOrgIds": [
                  "JER.33.12"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí, 'Ní ilẹ̀ yìí tí ó ti dahoro láìsí ọkùnrin àti àwọn ẹran nínú gbogbo ìlú, kò ní sí pápá oko fún àwọn olùṣọ́-àgùntàn láti mú àwọn ẹran ọ̀sìn wọn sinmi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.12",
            "verseOrgIds": [
              "JER.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìlú òkè wọ̀n-ọn-nì, nínú ìlú àfonífojì, àti nínú ìlú ìhà gúúsù, àti ní ilẹ̀ ti Benjamini, ní ibi wọ̀n-ọn-nì tí ó yí Jerusalẹmu ká, àti ní ìlú Juda ni agbo àgùntàn yóò tún máa kọjá ní ọwọ́ ẹni tí ń kà wọ́n,' ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.13",
            "verseOrgIds": [
              "JER.33.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.13",
                "verseOrgIds": [
                  "JER.33.13"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.13",
            "verseOrgIds": [
              "JER.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Àwọn ọjọ́ náà ń bọ̀,' ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.14",
            "verseOrgIds": [
              "JER.33.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.14",
                "verseOrgIds": [
                  "JER.33.14"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, 'tí èmi ó mú ìlérí rere tí mo ṣe fún ilé Israẹli àti ilé Juda ṣẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.14",
