            "verseOrgIds": [
              "JER.33.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.23",
                "verseOrgIds": [
                  "JER.33.23"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ Jeremiah wá wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.23",
            "verseOrgIds": [
              "JER.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ǹjẹ́ ìwọ kò kíyèsi pé àwọn ènìyàn wọ̀nyí ń sọ pé: '",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.24",
                "verseOrgIds": [
                  "JER.33.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ti kọ àwọn ọba méjèèjì tí ó yàn sílẹ̀'? Nítorí náà, ni wọ́n ti ṣe kẹ́gàn àwọn ènìyàn mi. Wọn kò sì mọ̀ wọ́n gẹ́gẹ́ bí orílẹ̀-èdè kan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.25",
            "verseOrgIds": [
              "JER.33.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.25",
                "verseOrgIds": [
                  "JER.33.25"
                ]
              }
            }
          ]
        },
        {
          "text": "wí: 'Bí èmi kò bá ti da májẹ̀mú mi pẹ̀lú ọ̀sán àti òru àti pẹ̀lú òfin ọ̀run àti ayé tí kò lè yẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.25",
            "verseOrgIds": [
              "JER.33.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni èmi ó kọ ọmọ lẹ́yìn Jakọbu àti Dafidi ìránṣẹ́ mi tí èmi kò sì ní yan ọ̀kan nínú ọmọkùnrin rẹ̀ láti jẹ́ alákòóso lórí àwọn ọmọ Abrahamu, Isaaki àti Jakọbu; nítorí èmi ó mú ìkólọ wọn padà; èmi ó sì ṣàánú fún wọn.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.26",
            "verseOrgIds": [
              "JER.33.26"
            ]
          }
        }
      ]
    }
