                "verseOrgIds": [
                  "JER.33.16"
                ]
              }
            }
          ]
        },
        {
          "text": "wa olódodo.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.17",
                "verseOrgIds": [
                  "JER.33.17"
                ]
              }
            }
          ]
        },
        {
          "text": "wí: 'Dafidi kò ní kùnà láti rí ọkùnrin tí yóò jókòó lórí ìtẹ́ ní ilé Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni àwọn àlùfáà tí ó jẹ́ ọmọ Lefi kò ní kùnà láti ní ọkùnrin kan tí ó dúró níwájú mi ní gbogbo ìgbà láti rú ẹbọ sísun; ẹbọ jíjẹ àti láti pèsè ìrúbọ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.18",
            "verseOrgIds": [
              "JER.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.19",
                "verseOrgIds": [
                  "JER.33.19"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tọ Jeremiah wá wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.20",
                "verseOrgIds": [
                  "JER.33.20"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ: 'Tí ìwọ bá lè dá májẹ̀mú mi ní òru tó bẹ́ẹ̀ tí ọ̀sán àti òru kò lè sí ní àkókò wọn mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni májẹ̀mú mi pẹ̀lú Dafidi ìránṣẹ́ mi àti májẹ̀mú mi pẹ̀lú Lefi tí ó jẹ́ àlùfáà, àwọn ìránṣẹ́ níwájú mi lè bàjẹ́, tí Dafidi kò sì rí ẹni láti jókòó lórí ìtẹ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.21",
            "verseOrgIds": [
              "JER.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ó mú àwọn ọmọ lẹ́yìn Dafidi ìránṣẹ́ mi àti Lefi tí ó jẹ́ oníwàásù níwájú mi di bí ìràwọ̀ ojú ọ̀run, tí kò ṣe é kà àti bí iyẹ̀pẹ̀ ojú Òkun tí kò ṣe é wọ́n.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.22",
            "verseOrgIds": [
              "JER.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
