  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
        "style": "c",
        "sid": "JER 40"
      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A tú Jeremiah sílẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀ náà sì tọ Jeremiah wá láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.1",
            "verseOrgIds": [
              "JER.40.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.40.1",
                "verseOrgIds": [
                  "JER.40.1"
                ]
              }
            }
          ]
        },
        {
          "text": "lẹ́yìn tí Nebusaradani balógun àwọn ẹ̀ṣọ́ ti tú u sílẹ̀ ní Rama. Ó rí Jeremiah tí a fi ẹ̀wọ̀n dè láàrín gbogbo àwọn tí wọ́n mú ní Jerusalẹmu àti Juda. Wọ́n kó lọ sí ilẹ̀ àjèjì Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.1",
            "verseOrgIds": [
              "JER.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí balógun ẹ̀ṣọ́ rí Jeremiah, ó sọ fún un wí pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.2",
            "verseOrgIds": [
              "JER.40.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.40.2",
                "verseOrgIds": [
                  "JER.40.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ ni ó pàṣẹ ibí yìí fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.2",
            "verseOrgIds": [
              "JER.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí,",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.3",
            "verseOrgIds": [
              "JER.40.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.40.3",
                "verseOrgIds": [
                  "JER.40.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ti mú un jáde; ó ti ṣe gẹ́gẹ́ bí ó ti sọ pé òun yóò ṣe. Gbogbo èyí ṣẹlẹ̀ nítorí wí pé ẹ̀yin ènìyàn ṣẹ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.3",
            "verseOrgIds": [
              "JER.40.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.40.3",
                "verseOrgIds": [
                  "JER.40.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", àti pé ẹ kò gbọ́rọ̀ sí àṣẹ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.3",
            "verseOrgIds": [
              "JER.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n, ní òní yìí mò ń tú ọ sílẹ̀ kúrò nínú ẹ̀wọ̀n tí ó wà ní ọwọ́ rẹ. Bí o bá fẹ́, tẹ̀lé mi ká lọ sí Babeli, èmi yóò sì bojútó ọ; ṣùgbọ́n bí ìwọ kò bá fẹ́, dúró síbí. Wò ó, gbogbo orílẹ̀-èdè wà níwájú rẹ, lọ sí ibikíbi tí ó bá tẹ́ ọ lọ́rùn.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.4",
            "verseOrgIds": [
              "JER.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀wẹ̀, kí ó tó di pé Jeremiah pẹ̀yìndà láti máa lọ, Nebusaradani fi kún un wí pé, \"Padà tọ Gedaliah ọmọ Ahikamu lọ, ọmọ Ṣafani, ẹni tí ọba Babeli ti fi jẹ baálẹ̀ lórí ìlú Juda, kí o sì máa gbé ní àárín àwọn ènìyàn wọ̀nyí tàbí kí o máa lọ ibikíbi tí ó bá tọ́ ní ojú rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.5",
            "verseOrgIds": [
              "JER.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 40:5"
      },
      "items": [
        {
          "text": "Nígbà náà ni balógun náà fún un ní oúnjẹ àti ẹ̀bùn, ó sì jẹ́ kí ó lọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.5",
            "verseOrgIds": [
              "JER.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni Jeremiah lọ sí ọ̀dọ̀ Gedaliah ọmọkùnrin Ahikamu ní Mispa, ó sì dúró tì í láàrín àwọn ènìyàn tí ó ṣẹ́kù ní ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.6",
            "verseOrgIds": [
              "JER.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wọ́n ṣe ikú pa Gedaliah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí gbogbo àwọn olórí ogun àti àwọn ènìyàn tí wọ́n kù lórí orílẹ̀-èdè náà gbọ́ pé ọba Babeli ti yan Gedaliah ọmọkùnrin Ahikamu gẹ́gẹ́ bí baálẹ̀ ní ilẹ̀ náà; àti pé ó ti fi àwọn ọkùnrin, obìnrin àti ọmọdé tí wọ́n jẹ́ tálákà ní ilẹ̀ náà tí wọn kò kó lọ sí ilẹ̀ àjèjì sí ìkáwọ́ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.7",
            "verseOrgIds": [
              "JER.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "wọ́n wá sí ọ̀dọ̀ Gedaliah ní Mispa; Iṣmaeli ọmọkùnrin Netaniah, Johanani àti Jonatani ọmọkùnrin ti Karea, Seraiah ọmọkùnrin Tanhumeti tí í ṣe ọmọkùnrin Efai ará Netofa àti Jesaniah ọmọkùnrin Maakati àti àwọn ènìyàn wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.8",
            "verseOrgIds": [
              "JER.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedaliah ọmọkùnrin Ahikamu, ọmọkùnrin ti Ṣafani ṣe ìbúra láti tún fi dá àwọn ènìyàn lójú pé, \"Ẹ má ṣe bẹ̀rù láti sin àwọn Babeli.\" Ó sọ wí pé, \"Gbé ilẹ̀ náà kí ẹ sì máa sin ọba Babeli, yóò sì dára fún un yín.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.9",
            "verseOrgIds": [
              "JER.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi fúnra mi yóò dúró ní Mispa láti ṣojú yín níwájú Babeli tí wọ́n tọ̀ wá wá. Ṣùgbọ́n ẹ̀yin ni yóò máa kórè ọtí wáìnì, èso igi àti òróró; kí ẹ sì kó wọn sí inú àpò àpamọ́wọ́ yín; kí ẹ̀yin sì máa gbé ní ìlú tí ẹ ti gbà.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.10",
            "verseOrgIds": [
              "JER.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí gbogbo àwọn Juda ní Moabu, Ammoni, Edomu àti gbogbo àwọn orílẹ̀-èdè gbọ́ pé ọba Babeli ti fi ohun tókù sílẹ̀ ní Juda, àti pé ó ti yan Gedaliah ọmọkùnrin Ahikamu ọmọkùnrin Ṣafani gẹ́gẹ́ bí gómìnà lórí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.11",
            "verseOrgIds": [
              "JER.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo wọn padà wá sí ilẹ̀ Juda sọ́dọ̀ Gedaliah ní Mispa láti orílẹ̀-èdè gbogbo tí a ti lé wọn sí. Wọ́n sì kórè ọ̀pọ̀lọpọ̀ ọtí wáìnì àti èso igi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.12",
            "verseOrgIds": [
              "JER.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johanani ọmọkùnrin ti Karea àti gbogbo àwọn olórí ogun tí ó kù ní orílẹ̀-èdè sì tọ Gedaliah wá ní Mispa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.13",
            "verseOrgIds": [
              "JER.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì sọ fún un wí pé, \"Ǹjẹ́ ìwọ ha mọ̀ pé Baalisi ọba àwọn Ammoni ti rán Iṣmaeli ọmọkùnrin Netaniah láti lọ mú ẹ̀mí rẹ?\" Ṣùgbọ́n Gedaliah ọmọkùnrin ti Ahikamu kò gbà wọ́n gbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.14",
            "verseOrgIds": [
              "JER.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Johanani ọmọkùnrin Karea sọ ní ìkọ̀kọ̀ fún Gedaliah ní Mispa pé, \"Jẹ́ kí èmi lọ pa Iṣmaeli ọmọkùnrin Netaniah, ẹnikẹ́ni kò sì ní mọ èyí. Kí ni ìdí rẹ̀ tí yóò ṣe mú ẹ̀mí rẹ, tí o sì ṣe fẹ́ mú àwọn Júù tí ó yí ọ ká túká, kí ìyókù Juda sì parun?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.15",
            "verseOrgIds": [
              "JER.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Gedaliah ọmọ Ahikamu sọ fún Johanani ọmọ Karea pé, \"Má ṣe ṣe nǹkan yìí! Nítorí nǹkan tí ò ń sọ nípa Iṣmaeli kì í ṣe òtítọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.16",
            "verseOrgIds": [
              "JER.40.16"
            ]
          }
        }
      ]
    }
  ],
