  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JER 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ní ilé amọ̀kòkò",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.1",
            "verseOrgIds": [
              "JER.18.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.1",
                "verseOrgIds": [
                  "JER.18.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó tọ Jeremiah wá wí pe:",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.1",
            "verseOrgIds": [
              "JER.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ̀kalẹ̀ lọ sí ilé amọ̀kòkò, níbẹ̀ ni èmi yóò ti bá ọ sọ̀rọ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.2",
            "verseOrgIds": [
              "JER.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni mo lọ sí ilé amọ̀kòkò mo sì rí i tí ó ń ṣiṣẹ́ kan lórí kẹ̀kẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.3",
            "verseOrgIds": [
              "JER.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìkòkò tí ó ń mọ láti ara amọ̀ bàjẹ́ ní ọwọ́ rẹ̀, nítorí náà ni amọ̀kòkò fi ṣe ìkòkò mìíràn, ó mọ ọ́n bí èyí tí ó dára jù ní ojú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.4",
            "verseOrgIds": [
              "JER.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.5",
            "verseOrgIds": [
              "JER.18.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.5",
                "verseOrgIds": [
                  "JER.18.5"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ mí wá pé:",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.5",
            "verseOrgIds": [
              "JER.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹyin ilé Israẹli, èmi kò ha lè ṣe fún un yín gẹ́gẹ́ bí amọ̀kòkò yìí ti ṣe?\" ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.6",
            "verseOrgIds": [
              "JER.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.6",
                "verseOrgIds": [
                  "JER.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "wí. \"Gẹ́gẹ́ bí amọ̀ ní ọwọ́ amọ̀kòkò bẹ́ẹ̀ ni ẹ̀yin rí ní ọwọ́ mi, ẹ̀yin ilé Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.6",
            "verseOrgIds": [
              "JER.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá jẹ́ ìgbà kan, tí èmi kéde kí orílẹ̀-èdè tàbí ìjọba kan di fífà tu láti dojúdé àti láti parun,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.7",
            "verseOrgIds": [
              "JER.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí orílẹ̀-èdè ti mo kìlọ̀ fún bá yípadà kúrò nínú ìwà búburú wọn, nígbà náà ni Èmi yóò yí ọkàn mi padà nínú àjálù tí mo ti rò láti ṣe sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.8",
            "verseOrgIds": [
              "JER.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà mìíràn tí èmi bá tún kéde láti tẹ̀dó tàbí gbin orílẹ̀-èdè kan tàbí ìjọba kan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.9",
            "verseOrgIds": [
              "JER.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá sì ṣe búburú níwájú mi, tí kò sì gba ohùn mi gbọ́, nígbà náà ni èmi yóò yí ọkàn mi padà ní ti rere, èyí tí mo wí pé, èmi ó ṣe fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.10",
            "verseOrgIds": [
              "JER.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ǹjẹ́ nísinsin yìí, sọ fún àwọn ènìyàn Juda àti àwọn olùgbé Jerusalẹmu wí pé, 'Báyìí ní",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.11",
            "verseOrgIds": [
              "JER.18.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.11",
                "verseOrgIds": [
                  "JER.18.11"
                ]
              }
            }
          ]
        },
        {
          "text": "wí: Wò ó! Èmi ń gbèrò ibi sí yin, èmi sì ń ṣe ìpinnu kan lórí yín. Nítorí náà ẹ yípadà kúrò lọ́nà búburú yín kí olúkúlùkù yín sì tún ọ̀nà àti ìṣe rẹ̀ ṣe.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.11",
            "verseOrgIds": [
              "JER.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n wọn yóò sọ wí pé, 'Kò ṣe nǹkan kan, àwa yóò tẹ̀síwájú nínú èrò wa, ẹnìkọ̀ọ̀kan wa, yóò hùwà agídí ọkàn búburú rẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.12",
            "verseOrgIds": [
              "JER.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.13",
                "verseOrgIds": [
                  "JER.18.13"
                ]
              }
            }
          ]
        },
        {
          "text": "wí:",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "\"Ẹ béèrè nínú orílẹ̀-èdè,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "ẹni tí ó bá ti gbọ́ irú nǹkan wọ̀nyí ri?",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "Ohun tí ó burú gidi ni wúńdíá Israẹli ti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ omi ojo dídì Lebanoni",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:14"
      },
      "items": [
        {
          "text": "yóò ha dá láti máa sàn láti ibi àpáta?",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:14"
      },
      "items": [
        {
          "text": "Tàbí odò tí ó jìnnà, tí ó tútù,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:14"
      },
      "items": [
        {
          "text": "tí ó ń sàn, yóò ha gbẹ bí?",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí àwọn ènìyàn mi gbàgbé mi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "wọ́n sun tùràrí fún òrìṣà asán,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "tí ó mú wọn kọsẹ̀ ní ọ̀nà wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "àti ọ̀nà wọn àtijọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "Wọ́n mú wọn rìn ní ọ̀nà àtijọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "àti ní ojú ọ̀nà ti a kò ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ wọn yóò wà lásán yóò sì di",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:16"
      },
      "items": [
        {
          "text": "nǹkan ẹ̀gàn títí láé,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:16"
      },
      "items": [
        {
          "text": "gbogbo àwọn tí ó ń kọjá yóò bẹ̀rù,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
