      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:17"
      },
      "items": [
        {
          "text": "Èmi yóò sì kọ ẹ̀yìn sí wọn, n kì yóò kọjú sí wọn",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
