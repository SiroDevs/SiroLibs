              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí afẹ́fẹ́ láti ìlà-oòrùn,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
