    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:17"
      },
      "items": [
        {
          "text": "Èmi yóò tú wọn ká lójú àwọn ọ̀tá wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
            ]
          }
        }
