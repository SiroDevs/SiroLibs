      "attrs": {
        "style": "q2",
        "vid": "JER 18:17"
      },
      "items": [
        {
          "text": "ní ọjọ́ àjálù wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
            ]
          }
        }
      ]
