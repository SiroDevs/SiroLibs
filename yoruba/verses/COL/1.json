  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "COL 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulu, aposteli Jesu Kristi nípa ìfẹ́ Ọlọ́run àti Timotiu arákùnrin wa,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.1",
            "verseOrgIds": [
              "COL.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sí àwọn ẹni mímọ́ àti àwọn arákùnrin àti arábìnrin nínú Kristi tí wọ́n ń gbé ní ìlú Kolose:",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "COL 1:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "COL 1:2"
      },
      "items": [
        {
          "text": "Oore-ọ̀fẹ́ àti àlàáfíà fún un yín láti ọ̀dọ̀ Ọlọ́run Baba wa.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdúpẹ́ àti àdúrà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbàkígbà tí a bá ń gbàdúrà fún un yín ni a máa ń dúpẹ́ lọ́wọ́ Ọlọ́run Baba Olúwa wa Jesu Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.3",
            "verseOrgIds": [
              "COL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí a ti gbúròó ìgbàgbọ́ yín nínú Jesu Kristi, àti bí ẹ ti ṣe fẹ́ràn gbogbo àwọn ènìyàn mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.4",
            "verseOrgIds": [
              "COL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbàgbọ́ àti ìfẹ́ tí ń sàn nínú ìrètí tí a gbé pamọ́ fún un yín ní ọ̀run èyí tí ẹ̀yin sì ti gbọ́ tẹ́lẹ̀ nínú ọ̀rọ̀ òtítọ́ ìyìnrere náà,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.5",
            "verseOrgIds": [
              "COL.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "èyí tí ó ti dé ọ̀dọ̀ yín. Káàkiri àgbáyé ni ìyìnrere yìí ń so èso tí ó sì ń dàgbà, gẹ́gẹ́ bí ó ti ń ṣe láàrín yín láti ọjọ́ náà tí ẹ ti gbọ́ ọ, tí ẹ sì ní ìmọ̀ oore-ọ̀fẹ́ Ọlọ́run nínú gbogbo òtítọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.6",
            "verseOrgIds": [
              "COL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin ti kọ́ ọ lọ́dọ̀ Epafira, ìránṣẹ́ ẹlẹgbẹ́ wa olùfẹ́, ẹni tí ó jẹ́ olóòtítọ́ ìránṣẹ́ Kristi ní ipò wa.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.7",
            "verseOrgIds": [
              "COL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni ti ó sọ fún wa nípa ìfẹ́ yín nínú ẹ̀mí.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.8",
            "verseOrgIds": [
              "COL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìdí èyí, láti ọjọ́ tí a ti gbọ́ nípa yín, a kò sinmi láti máa gbàdúrà fún yin, tí a sì ń gbàdúrà pé kí Ọlọ́run fi ìmọ̀ ìfẹ́ rẹ̀ kún yín nípasẹ̀ ọgbọ́n àti òye gbogbo tí ń ṣe ti Ẹ̀mí.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.9",
            "verseOrgIds": [
              "COL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa sì ń gbàdúrà yìí kí ẹ lè gbé irú ìgbé ayé tó yẹ fún Olúwa kí ẹ sì máa wu ú ní gbogbo ọ̀nà, kí ẹ sì máa so èso rere gbogbo, kí ẹ sì máa dàgbà nínú ìmọ̀ Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.10",
            "verseOrgIds": [
              "COL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "pé kí a lè fi ipa gbogbo sọ yín di alágbára gẹ́gẹ́ bí agbára rẹ̀ àti ògo rẹ̀, kí ó lè ṣe é ṣe fún un yín láti máa tẹ̀síwájú nínú sùúrù àti ìpamọ́ra pẹ̀lú ayọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.11",
            "verseOrgIds": [
              "COL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí a máa dúpẹ́ nígbà gbogbo lọ́wọ́ Baba, ẹni tí ó kà yín láti jẹ́ alábápín nínú ogún àwọn ẹni mímọ́ nínú ìjọba ìmọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.12",
            "verseOrgIds": [
              "COL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí ó ti já wa gbà kúrò nínú agbára òkùnkùn ó sì mú wa wá sí ìjọba Ọmọ tí ó fẹ́ràn.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.13",
            "verseOrgIds": [
              "COL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú ẹni tí a ní ìràpadà, àti ìdáríjì ẹ̀ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.14",
            "verseOrgIds": [
              "COL.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Títóbi Kristi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristi ni àwòrán Ọlọ́run tí a kò le rí, àkọ́bí gbogbo ẹ̀dá.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.15",
            "verseOrgIds": [
              "COL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí nípa rẹ̀ ní a dá ohun gbogbo: àwọn ohun tí ń bẹ ní ọ̀run àti ní ayé, ohun tí a rí àti èyí tí a kò rí, wọn ìbá ṣe ìtẹ́, tàbí agbára, tàbí àṣẹ, nípasẹ̀ rẹ̀ ni a dá ohun gbogbo àti fún un.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.16",
            "verseOrgIds": [
              "COL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ti wà ṣáájú kí ohunkóhun tó wà, nínú rẹ̀ ni a sì so ohun gbogbo papọ̀ ṣọ̀kan.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.17",
            "verseOrgIds": [
              "COL.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ni orí fún ara, èyí tí í ṣe ìjọ; òun ni ìbẹ̀rẹ̀ àti àkọ́bí nínú àwọn òkú, pé nínú ohun gbogbo kí òun lè ní ipò tí ó ga jùlọ nínú ohunkóhun.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.18",
            "verseOrgIds": [
              "COL.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìfẹ́ Ọlọ́run ni pé kí gbogbo ẹ̀kúnrẹ́rẹ́ òun tìkára rẹ̀ lè máa gbé nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.19",
            "verseOrgIds": [
              "COL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti nípasẹ̀ rẹ̀ láti bá ohun gbogbo làjà àwọn nǹkan tí ń bẹ láyé àti èyí tí ń bẹ ní ọ̀run, nípa mímú àlàáfíà wá nípasẹ̀ ẹ̀jẹ̀ rẹ̀, tí a ta sílẹ̀ lórí igi àgbélébùú.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.20",
            "verseOrgIds": [
              "COL.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin ya ara yín nípá kúrò lọ́dọ̀ Ọlọ́run nígbà kan rí, ẹ jẹ́ ọ̀tá nínú ọkàn yín nítorí ìwà búburú yín.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.21",
            "verseOrgIds": [
              "COL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "COL 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nísinsin yìí, ó ti bá yín làjà nípa ara Kristi nípa ikú láti mú un yín lọ sí iwájú rẹ̀ ní mímọ́, aláìlábàwọ́n àti kúrò nínú ìdálẹ́bi,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.22",
            "verseOrgIds": [
              "COL.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí ẹ̀yin bá dúró nínú ìgbàgbọ́ yín, tí ẹ fi ẹsẹ̀ múlẹ̀, tí ẹ sì dúró ṣinṣin, láláìyẹsẹ̀ kúrò nínú ìrètí ti ìyìnrere ti ẹ̀yin ti gbọ́, èyí tí a ti wàásù rẹ̀ fún gbogbo ẹ̀dá lábẹ́ ọ̀run, àti èyí ti èmi Paulu ṣe ìránṣẹ́ fún.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.23",
            "verseOrgIds": [
              "COL.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iṣẹ́ Paulu ṣíṣe fún àwọn ìjọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "COL 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí èmi ń yọ̀ nínú ìjìyà fún un yín. Inú mi sì dùn, nítorí mo ń ṣe ìrànlọ́wọ́ láti jẹ ìyà tó ṣẹ́kù nínú ìyà Kristi fún ara rẹ̀, èyí tí ì ṣe ìjọ.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.24",
            "verseOrgIds": [
              "COL.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "COL 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú èyí tí a fi ṣe ìránṣẹ́ fún gẹ́gẹ́ bí iṣẹ́ ìríjú Ọlọ́run tí a fi fún mi fún yín láti mú ọ̀rọ̀ Ọlọ́run ṣẹ.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.25",
            "verseOrgIds": [
              "COL.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "COL 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ti pa àṣírí ìjìnlẹ̀ yìí mọ́ fún ayérayé àti láti ìrandíran. Ṣùgbọ́n nísinsin yìí, gẹ́gẹ́ bí ìfẹ́ ọkàn rẹ̀, ó ti fihàn fún àwọn ẹni mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.26",
            "verseOrgIds": [
              "COL.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "COL 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ẹni tí Ọlọ́run yàn láti fihàn láàrín àwọn aláìkọlà nípa ọ̀rọ̀ ògo ohun ìjìnlẹ̀ yìí, èyí tí í ṣe Kristi ìrètí ògo nínú yín.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.27",
            "verseOrgIds": [
              "COL.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "COL 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa ń wàásù rẹ̀, a ń gbani níyànjú a sì ń kọ olúkúlùkù ènìyàn ní ọgbọ́n gbogbo, kí a lè mú olúkúlùkù dé ọ̀dọ̀ Ọlọ́run ní pípé nínú Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.28",
            "verseOrgIds": [
              "COL.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "COL 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sí èyí sì ni èmi ń ṣe làálàá, ti mo sì ń làkàkà pẹ̀lú gbogbo agbára rẹ̀, èyí tó ń ṣiṣẹ́ nínú mi.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.29",
            "verseOrgIds": [
              "COL.1.29"
            ]
          }
        }
      ]
    }
