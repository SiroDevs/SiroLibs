  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "NAM 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A fi Ninefe bú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NAM 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ègbé ni fún ìlú ẹ̀jẹ̀ nì,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:1"
      },
      "items": [
        {
          "text": "gbogbo rẹ̀ kún fún èké,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:1"
      },
      "items": [
        {
          "text": "ó kún fún olè,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:1"
      },
      "items": [
        {
          "text": "ìjẹ kò kúrò!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NAM 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariwo pàṣán àti ariwo",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.2",
            "verseOrgIds": [
              "NAM.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:2"
      },
      "items": [
        {
          "text": "kíkùn kẹ̀kẹ́ ogun",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.2",
            "verseOrgIds": [
              "NAM.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:2"
      },
      "items": [
        {
          "text": "àti jíjó ẹṣin",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.2",
            "verseOrgIds": [
              "NAM.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:2"
      },
      "items": [
        {
          "text": "àti gbígbọn kẹ̀kẹ́ ogun jìgìjìgì!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.2",
            "verseOrgIds": [
              "NAM.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NAM 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ológun orí ẹṣin ń fi ìgbónára",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "ju idà wọn mọ̀nàmọ́ná",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "ọ̀kọ̀ rẹ̀ ti ń dán yanran sí òkè!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "Ọ̀pọ̀lọpọ̀ si ní àwọn ẹni tí a pa,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "àti ọ̀pọ̀lọpọ̀ òkú;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "òkú kò sì ni òpin;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "àwọn ènìyàn sì ń kọsẹ̀ lára àwọn òkú.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NAM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ọ̀pọ̀lọpọ̀ panṣágà",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:4"
      },
      "items": [
        {
          "text": "àgbèrè tí ó rójú rere gbà,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:4"
      },
      "items": [
        {
          "text": "ìyá àjẹ́ tí ó ṣọ́ àwọn Orílẹ̀-èdè di ẹrú",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:4"
      },
      "items": [
        {
          "text": "nípa àgbèrè rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:4"
      },
      "items": [
        {
          "text": "àti àwọn ìdílé nípa ìṣe àjẹ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NAM 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi dojúkọ ọ́,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NAM.3.5",
                "verseOrgIds": [
                  "NAM.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:5"
      },
      "items": [
        {
          "text": "\"Èmi ó si ká aṣọ àwọ̀tẹ́lẹ̀ rẹ ní ojú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:5"
      },
      "items": [
        {
          "text": "Èmi yóò sì fi ìhòhò rẹ̀ han àwọn orílẹ̀-èdè",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:5"
      },
      "items": [
        {
          "text": "àti ìtìjú rẹ̀ han àwọn ilẹ̀ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò da ẹ̀gbin tí ó ni ìríra sí ọ ní ara,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
              "NAM.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:6"
      },
      "items": [
        {
          "text": "èmi yóò sì sọ ọ́ di aláìmọ́,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
              "NAM.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:6"
      },
      "items": [
        {
          "text": "èmi yóò sì sọ ọ́ di ẹlẹ́yà.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
              "NAM.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NAM 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn tí ó ba sì wò ọ́ yóò sì káàánú fún ọ, wọn yóò sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.7",
            "verseOrgIds": [
              "NAM.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:7"
      },
      "items": [
        {
          "text": "'Ninefe ṣòfò, ta ni yóò kẹ́dùn rẹ?'",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.7",
            "verseOrgIds": [
              "NAM.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:7"
      },
      "items": [
        {
          "text": "Níbo ni èmi o ti wá olùtùnú fún ọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.7",
            "verseOrgIds": [
              "NAM.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NAM 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ ìwọ ha sàn ju Tebesi lọ,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "èyí tí ó wà ní ibi odò Naili,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "tí omi sì yí káàkiri?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "Odò náà sì jẹ́ ààbò rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "omi si jẹ́ odi rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NAM 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etiopia àti Ejibiti ni agbára rẹ, kò sí ní òpin;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.9",
            "verseOrgIds": [
              "NAM.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:9"
      },
      "items": [
        {
          "text": "Puti àti Libia ni àwọn olùgbèjà rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.9",
            "verseOrgIds": [
              "NAM.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀síbẹ̀ a kó o ní ìgbèkùn",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:10"
      },
      "items": [
        {
          "text": "o sì lọ sí oko ẹrú.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
