  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "2CH 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahasi ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasi sì jẹ́ ẹni ogún ọdún nígbà tí ó bẹ̀rẹ̀ ìjọba, ó sì jẹ ọba ní Jerusalẹmu fún ọdún mẹ́rìndínlógún. Gẹ́gẹ́ bí i Dafidi baba rẹ̀ kò sì ṣe ohun rere ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.1",
            "verseOrgIds": [
              "2CH.28.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.1",
                "verseOrgIds": [
                  "2CH.28.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.1",
            "verseOrgIds": [
              "2CH.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì rìn ní ọ̀nà àwọn ọba Israẹli ó sì ṣe ère dídá fún ìsìn Baali",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.2",
            "verseOrgIds": [
              "2CH.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì sun ẹbọ ní àfonífojì Hinnomu, ó sì sun àwọn ọmọ rẹ̀ nínú iná, gẹ́gẹ́ bí ohun ìríra àwọn orílẹ̀-èdè tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.3",
            "verseOrgIds": [
              "2CH.28.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.3",
                "verseOrgIds": [
                  "2CH.28.3"
                ]
              }
            }
          ]
        },
        {
          "text": "lé jáde níwájú àwọn ọmọ Israẹli",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.3",
            "verseOrgIds": [
              "2CH.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì rú ẹbọ, ó sì sun tùràrí ní ibi gíga wọ́n nì lórí òkè kékeré àti lábẹ́ gbogbo igi tútù.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.4",
            "verseOrgIds": [
              "2CH.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.5",
            "verseOrgIds": [
              "2CH.28.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.5",
                "verseOrgIds": [
                  "2CH.28.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀ fi lé ọba Siria lọ́wọ́. Àwọn ará Siria sì pa á run, wọ́n sì kó púpọ̀ nínú àwọn ènìyàn rẹ̀ gẹ́gẹ́ bí ẹlẹ́wọ̀n, wọ́n sì kó wọn wá sí Damasku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.5",
            "verseOrgIds": [
              "2CH.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 28:5"
      },
      "items": [
        {
          "text": "Ó sì tún fi lé ọwọ́ ọba Israẹli pẹ̀lú, ẹni tí ó kó wọn ní ìgbèkùn púpọ̀ tí ó sì pa wọ́n ní ìpakúpa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.5",
            "verseOrgIds": [
              "2CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kan Peka, ọmọ Remaliah, pa ọ̀kẹ́ mẹ́fà (120,000) àwọn ọmọ-ogun ní Juda nítorí Juda ti kọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.6",
            "verseOrgIds": [
              "2CH.28.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.6",
                "verseOrgIds": [
                  "2CH.28.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run baba wọn sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.6",
            "verseOrgIds": [
              "2CH.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikri àti Efraimu alágbára sì pa Maaseiah ọmọ ọba, Aṣrikamu ìjòyè tí ó wà ní ìkáwọ́ ilé ọba, àti Elkana igbákejì ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.7",
            "verseOrgIds": [
              "2CH.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli sì kó ní ìgbèkùn lára àwọn arákùnrin wọn ọ̀kẹ́ mẹ́wàá (200,000) àwọn aya wọn, àwọn ọmọkùnrin àti obìnrin wọn sì tún kó ọ̀pọ̀ ìkógun, èyí tí wọn kó padà lọ sí Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.8",
            "verseOrgIds": [
              "2CH.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n wòlíì",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.9",
            "verseOrgIds": [
              "2CH.28.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.9",
                "verseOrgIds": [
                  "2CH.28.9"
                ]
              }
            }
          ]
        },
        {
          "text": "tí orúkọ rẹ̀ ń jẹ́ Odedi wà níbẹ̀, ó sì jáde lọ láti lọ pàdé ogun nígbà tí ó padà sí Samaria. Ó sì wí fún wọn pé, \"Nítorí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.9",
            "verseOrgIds": [
              "2CH.28.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.9",
                "verseOrgIds": [
                  "2CH.28.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run baba yín bínú sí Juda ó sì fi wọ́n lé yín lọ́wọ́. Ṣùgbọ́n ẹ̀yin pa wọ́n ní ìpa oró tí ó de òkè ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.9",
            "verseOrgIds": [
              "2CH.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, ẹ̀yin ń pète láti mú ọkùnrin àti obìnrin Juda àti Jerusalẹmu ṣe gẹ́gẹ́ bí ẹrú yín, ẹ̀yin kò ha jẹ̀bi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.10",
            "verseOrgIds": [
              "2CH.28.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.10",
                "verseOrgIds": [
                  "2CH.28.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, àní ẹ̀yin?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.10",
            "verseOrgIds": [
              "2CH.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí ẹ gbọ́ tèmi! Ẹ rán àwọn ìgbèkùn tí ẹ̀yin ti mú gẹ́gẹ́ bí àwọn ẹlẹ́wọ̀n padà nítorí ìbínú kíkan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.11",
            "verseOrgIds": [
              "2CH.28.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.11",
                "verseOrgIds": [
                  "2CH.28.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ń bẹ lórí yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.11",
            "verseOrgIds": [
              "2CH.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà, díẹ̀ nínú àwọn olórí ní Efraimu, Asariah ọmọ Jehohanani, Berekiah ọmọ Meṣilemoti, Jehiskiah ọmọ Ṣallumu, àti Amasa ọmọ Hadlai, dìde sí àwọn tí o ti ogun náà bọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.12",
            "verseOrgIds": [
              "2CH.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn si wí pé, \"Ìwọ kò gbọdọ̀ mú àwọn ẹlẹ́wọ̀n wá síbí,\" \"tàbí àwa ti jẹ̀bi níwájú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.13",
            "verseOrgIds": [
              "2CH.28.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.13",
                "verseOrgIds": [
                  "2CH.28.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", ṣe ẹ̀yin ń gbèrò láti fi kún ẹ̀ṣẹ̀ àti ẹ̀bi wa ni: nítorí tí ẹ̀bi wa ti tóbi púpọ̀, ìbínú rẹ̀ kíkan sì wà lórí Israẹli.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.13",
            "verseOrgIds": [
              "2CH.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni àwọn ológun tú àwọn ẹlẹ́wọ̀n àti ìkógun sílẹ̀ níwájú àwọn ìjòyè àti gbogbo ìjọ ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.14",
            "verseOrgIds": [
              "2CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin tí a pè pẹ̀lú orúkọ náà sì dìde, wọn sì mú àwọn ìgbèkùn náà, wọ́n sì fi ìkógun náà wọ̀ gbogbo àwọn tí ó wà ní ìhòhò nínú wọn, wọ́n sì wọ̀ wọ́n ní aṣọ, wọ́n sì bọ̀ wọ́n ní bàtà, wọ́n sì fún wọn ní oúnjẹ àti ohun mímu, wọ́n sì fi òróró kùn wọ́n ní ara, wọ́n sì kó gbogbo àwọn tí ó jẹ́ aláìlera nínú wọ́n sórí kẹ́tẹ́kẹ́tẹ́. Bẹ́ẹ̀ ni wọ́n sì kó wọn padà sí ọ̀dọ̀ àwọn arákùnrin wọn ní Jeriko, ìlú ọ̀pẹ, wọ́n sì padà sí Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.15",
            "verseOrgIds": [
              "2CH.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò ìgbà náà, ọba Ahasi ránṣẹ́ sí ọba Asiria fún ìrànlọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.16",
            "verseOrgIds": [
              "2CH.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Edomu sì tún padà wá láti kọlu Juda kí wọn sì kó àwọn ẹlẹ́wọ̀n lọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.17",
            "verseOrgIds": [
              "2CH.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ará Filistini sì ti jagun ní ìlú pẹ̀tẹ́lẹ̀ wọ́n nì àti síhà gúúsù Juda. Wọ́n ṣẹ́gun wọ́n sì gba Beti-Ṣemeṣi, Aijaloni àti Gederoti, àti Soko, Timna, a ri Gimiso, pẹ̀lú ìletò wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.18",
            "verseOrgIds": [
              "2CH.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.19",
                "verseOrgIds": [
                  "2CH.28.19"
                ]
              }
            }
          ]
        },
        {
          "text": "sì rẹ Juda sílẹ̀ nítorí Ahasi ọba Israẹli, nítorí ó sọ Juda di aláìní ìrànlọ́wọ́, ó sì ṣe ìrékọjá gidigidi sí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.19",
            "verseOrgIds": [
              "2CH.28.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.19",
                "verseOrgIds": [
                  "2CH.28.19"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.19",
            "verseOrgIds": [
              "2CH.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiglat-Pileseri ọba Asiria wá sí ọ̀dọ̀ rẹ̀, ṣùgbọ́n ó fún ní ìpọ́njú dípò ìrànlọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.20",
            "verseOrgIds": [
              "2CH.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasi mú díẹ̀ nínú ìní ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.21",
            "verseOrgIds": [
              "2CH.28.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.21",
                "verseOrgIds": [
                  "2CH.28.21"
                ]
              }
            }
          ]
        },
        {
          "text": "àti láti ilé ọba àti láti ọ̀dọ̀ ọba ó sì fi wọ́n fún ọba Asiria: ṣùgbọ́n èyí kò ràn wọ́n lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.21",
            "verseOrgIds": [
              "2CH.28.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò ìpọ́njú rẹ̀ ọba Ahasi sì di aláìṣòótọ́ sí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.22",
            "verseOrgIds": [
              "2CH.28.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.22",
                "verseOrgIds": [
                  "2CH.28.22"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.22",
            "verseOrgIds": [
              "2CH.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì rú ẹbọ sí òrìṣà àwọn Damasku, ẹni tí ó ṣẹ́gun wọn, nítorí ó rò wí pé, \"Nítorí àwọn òrìṣà àwọn ọba Siria ti ràn wọ́n lọ́wọ́ kí wọn kí ó bà lè ràn mí lọ́wọ́.\" Ṣùgbọ́n àwọn ni ìparun rẹ̀ àti ti gbogbo Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.23",
            "verseOrgIds": [
              "2CH.28.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasi sì kó gbogbo ohun èlò láti ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.24",
            "verseOrgIds": [
              "2CH.28.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.24",
                "verseOrgIds": [
                  "2CH.28.24"
                ]
              }
            }
          ]
        },
        {
          "text": "jọ ó sì kó wọn lọ. Ó sì ti ìlẹ̀kùn ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.24",
            "verseOrgIds": [
              "2CH.28.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.24",
                "verseOrgIds": [
                  "2CH.28.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ó sì tẹ́ pẹpẹ fún ara rẹ̀ ní gbogbo igun Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.24",
            "verseOrgIds": [
              "2CH.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní gbogbo ìlú Juda ó sì kọ́ ibi gíga láti sun ẹbọ fún àwọn ọlọ́run mìíràn. Kí ó sì mú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.25",
            "verseOrgIds": [
              "2CH.28.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.28.25",
                "verseOrgIds": [
                  "2CH.28.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run àwọn baba wọn bínú.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.25",
            "verseOrgIds": [
              "2CH.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyókù iṣẹ́ ìjọba rẹ̀ àti gbogbo ọ̀nà rẹ̀, láti ìbẹ̀rẹ̀ títí dé òpin, ni a kọ sínú ìwé àwọn ọba Juda àti ti Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.26",
            "verseOrgIds": [
              "2CH.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasi sì sùn pẹ̀lú àwọn baba rẹ̀ a sì sin ín ní ìlú Jerusalẹmu ṣùgbọ́n wọn kò mú un wá sínú àwọn isà òkú àwọn ọba Israẹli. Hesekiah ọmọ rẹ sì jẹ ọba ní ipò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.27",
            "verseOrgIds": [
              "2CH.28.27"
            ]
          }
        }
      ]
    }
