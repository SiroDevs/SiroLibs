  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "2CH 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kọ̀ fún Juda láti Bá Israẹli Jagun",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Rehoboamu dé Jerusalẹmu, ó kó ilé Juda àti Benjamini jọ, ọ̀kẹ́ mẹ́sàn-án (180,000) ènìyàn tí a yàn, tí wọ́n jẹ́ ológun, láti bá Israẹli jà kí ó lè mú ìjọba náà padà bọ̀ sọ́dọ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.1",
            "verseOrgIds": [
              "2CH.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.2",
            "verseOrgIds": [
              "2CH.11.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.11.2",
                "verseOrgIds": [
                  "2CH.11.2"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ Ṣemaiah ènìyàn Ọlọ́run wá wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.2",
            "verseOrgIds": [
              "2CH.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wí fún Rehoboamu ọmọ Solomoni ọba Juda, sí gbogbo àwọn ọmọ Israẹli ní Juda àti Benjamini,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.3",
            "verseOrgIds": [
              "2CH.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Èyí ní ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.4",
            "verseOrgIds": [
              "2CH.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.11.4",
                "verseOrgIds": [
                  "2CH.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "wí. Ẹ má ṣe gòkè lọ láti lọ jà pẹ̀lú arákùnrin yín, ẹ lọ sílé, gbogbo yín, nítorí ti ìṣe mi nìyí.' \" Bẹ́ẹ̀ ni wọ́n tẹ̀lé ọ̀rọ̀ Ọlọ́run, wọ́n sì padà sẹ́yìn láti yan lọ dojúkọ Jeroboamu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.4",
            "verseOrgIds": [
              "2CH.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamu ń gbe ní Jerusalẹmu ó sì kọ́ àwọn ìlú fún olódi ní Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.5",
            "verseOrgIds": [
              "2CH.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹtilẹhẹmu, Etamu, Tekoa,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.6",
            "verseOrgIds": [
              "2CH.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beti-Suri, Soko, Adullamu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.7",
            "verseOrgIds": [
              "2CH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gati, Meraṣa Sifi,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.8",
            "verseOrgIds": [
              "2CH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoraimu, Lakiṣi, Aseka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.9",
            "verseOrgIds": [
              "2CH.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sora, Aijaloni, àti Hebroni. Wọ̀nyí ni àwọn ìlú ìdáàbòbò ní Juda àti Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.10",
            "verseOrgIds": [
              "2CH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì mú àwọn ìlú olódi lágbára, ó sì fi àwọn balógun sínú wọn àti àkójọ oúnjẹ, àti òróró àti ọtí wáìnì.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.11",
            "verseOrgIds": [
              "2CH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti ní olúkúlùkù ìlú ni ó fi asà àti ọ̀kọ̀ sí, ó sì mú wọn lágbára gidigidi, ó sì ní Juda àti Benjamini lábẹ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.12",
            "verseOrgIds": [
              "2CH.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ọmọ Lefi dúró pẹ̀lú Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlùfáà àti àwọn ará Lefi, láti gbogbo ẹ̀yà wọn jákèjádò Israẹli wà ní ẹ̀bá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.13",
            "verseOrgIds": [
              "2CH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Lefi fi ìgbèríko sílẹ̀, wọ́n sì wá sí Juda àti Jerusalẹmu nítorí Jeroboamu àti àwọn ọmọ rẹ̀, ti kọ̀ wọ́n sílẹ̀ gẹ́gẹ́ bí àwọn àlùfáà",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.14",
            "verseOrgIds": [
              "2CH.11.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.11.14",
                "verseOrgIds": [
                  "2CH.11.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.14",
            "verseOrgIds": [
              "2CH.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì yan àwọn àlùfáà tirẹ̀ fún àwọn ibi gíga wọ̀n-ọn-nì, àti fún àwọn ère òbúkọ, àti fún ẹgbọrọ màlúù tí ó ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.15",
            "verseOrgIds": [
              "2CH.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tó wá láti gbogbo ẹ̀yà Israẹli tí wọ́n fi ọkàn wọn fún wíwá",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.16",
            "verseOrgIds": [
              "2CH.11.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.11.16",
                "verseOrgIds": [
                  "2CH.11.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli, tẹ̀lé àwọn ará Lefi lọ sí Jerusalẹmu láti lọ rú ẹbọ sí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.16",
            "verseOrgIds": [
              "2CH.11.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.11.16",
                "verseOrgIds": [
                  "2CH.11.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run baba a wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.16",
            "verseOrgIds": [
              "2CH.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó fún ìjọba Juda ní agbára, ó sì ti Rehoboamu ọmọ Solomoni lẹ́yìn fún ọdún mẹ́ta nítorí ọdún mẹ́ta ni wọ́n fi rìn ní ọ̀nà ti Dafidi àti Solomoni ní àkókò yí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.17",
            "verseOrgIds": [
              "2CH.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rehoboamu kó obìnrin jọ fún ara rẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamu fẹ́ Mahalati tí ó jẹ́ ọmọbìnrin ti ọmọkùnrin Dafidi Jerimoti bi àti ti Abihaili, ọmọbìnrin ti ọmọkùnrin Jese Eliabu bí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.18",
            "verseOrgIds": [
              "2CH.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó bí àwọn ọmọ fún un: Jeuṣi, Ṣemariah àti Sahamu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.19",
            "verseOrgIds": [
              "2CH.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, ó fẹ́ Maaka ọmọbìnrin Absalomu, tí ó bí Abijah fún Attai, Sisa àti Ṣelomiti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.20",
            "verseOrgIds": [
              "2CH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamu fẹ́ràn Maaka ọmọbìnrin Absalomu ju èyíkéyìí nínú àwọn ìyàwó rẹ̀ àti àwọn àlè rẹ̀ lọ. Ní gbogbo rẹ̀, ó ní ìyàwó méjìdínlógún àti ọgọ́ta àlè ọmọkùnrin méjìdínlọ́gbọ̀n àti ọgọ́ta ọmọbìnrin.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.21",
            "verseOrgIds": [
              "2CH.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamu yan Abijah ọmọ Maaka láti jẹ́ olóyè ọmọ-aládé láàrín àwọn arákùnrin rẹ̀, kí ó ba à lè ṣe é ní ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.22",
            "verseOrgIds": [
              "2CH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó hùwà ọlọ́gbọ́n, nípa fí fọ́n díẹ̀ nínú àwọn ọmọ rẹ̀ jákèjádò ká àwọn agbègbè Juda àti Benjamini àti sí gbogbo àwọn ìlú ńlá olódi. Ó fún wọn ní ọ̀pọ̀ ohun tí wọ́n fẹ́, ó sì fẹ́ ọ̀pọ̀ ìyàwó fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.23",
            "verseOrgIds": [
              "2CH.11.23"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "2CH.12",
    "number": "12",
    "bookId": "2CH"
  },
