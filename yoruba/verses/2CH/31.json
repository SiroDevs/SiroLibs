  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "2CH 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí gbogbo nǹkan wọ̀nyí ti dé òpin, àwọn ọmọ Israẹli tí ó wà níbẹ̀ jáde lọ sí àwọn ìlú Juda, wọ́n fọ́ àwọn òkúta ìyàsọ́tọ̀ sí wẹ́wẹ́, wọ́n gé àwọn ère Aṣerah lulẹ̀. Wọ́n ba àwọn ibi gíga jẹ́ àti àwọn pẹpẹ jákèjádò Juda àti Benjamini àti ní Efraimu àti Manase. Lẹ́yìn ìgbà tí wọ́n ti pa gbogbo wọn run, àwọn ọmọ Israẹli padà sí ìlú wọn àti sí nǹkan ìní wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.1",
            "verseOrgIds": [
              "2CH.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdáwó fún ìjọ́sìn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiah fi lé àwọn àlùfáà àti àwọn ará Lefi lọ́wọ́ sí àwọn ìpín olúkúlùkù wọn gẹ́gẹ́ bí iṣẹ́ wọn gẹ́gẹ́ bí àlùfáà tàbí ará Lefi láti tẹ́ ẹbọ sísun àti ọrẹ ìdàpọ̀, láti ṣe iṣẹ́ ìránṣẹ́ láti fi ọpẹ́ fún àti láti kọ àwọn orin ìyìn ní ẹnu-ọ̀nà ibùgbé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.2",
                "verseOrgIds": [
                  "2CH.31.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba fi sílẹ̀ láti ara ohun ìní rẹ̀ fun ẹbọ sísun àárọ̀ àti ìrọ̀lẹ́ àti fún ẹbọ sísun ní ọjọ́ ìsinmi, òṣùpá tuntun àti ní àjọ̀dún tí a yàn gẹ́gẹ́ bi a ti ṣe kọ ọ́ nínú òfin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.3",
                "verseOrgIds": [
                  "2CH.31.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó pàṣẹ fún àwọn ènìyàn tí ń gbé ní Jerusalẹmu láti fi ìpín tí ó yẹ fún àlùfáà fún un àti àwọn ará Lefi, kí wọn kí ó lè fi ara wọn jì fún òfin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.4",
                "verseOrgIds": [
                  "2CH.31.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní kété tí àṣẹ náà jáde lọ, àwọn ọmọ Israẹli fi tìfẹ́tìfẹ́ fi àkọ́so ti ọkà wọn, ọtí tuntun, òróró àti oyin àti gbogbo ohun tí pápá mú jáde lélẹ̀. Wọ́n kó ọ̀pọ̀ iye, àti ìdámẹ́wàá gbogbo nǹkan wá.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin Israẹli àti Juda ti gbe inú àwọn ìlú Juda pẹ̀lú mú ìdámẹ́wàá agbo ẹran àti ohun èlò àti ohun ọ̀sìn àti ìdámẹ́wàá ti àwọn nǹkan mímọ́ tí a ti yà sọ́tọ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.6",
                "verseOrgIds": [
                  "2CH.31.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wọn, wọ́n sì kó wọn jọ ní òkìtì.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n bẹ̀rẹ̀ ṣíṣe èyí ní oṣù kẹta, wọ́n sì parí ní oṣù keje.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Hesekiah àti àwọn oníṣẹ́ rẹ̀ wá, tí wọ́n sì rí òkìtì náà, wọ́n yin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.8",
                "verseOrgIds": [
                  "2CH.31.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", pẹ̀lú ìbùkún àwọn ènìyàn rẹ̀ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiah béèrè lọ́wọ́ àwọn àlùfáà àti àwọn ará Lefi nípa òkìtì;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.9",
            "verseOrgIds": [
              "2CH.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti Asariah olórí àlùfáà ti ìdílé Sadoku sì dáhùn pé, \"Ní ìwọ̀n ìgbà tí àwọn ènìyàn ti bẹ̀rẹ̀ sí ní mú ìdáwó wọn wá sí ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.10",
                "verseOrgIds": [
                  "2CH.31.10"
                ]
              }
            }
          ]
        },
        {
          "text": "àti ní èyí tí yóò tó jẹ àti ọ̀pọ̀ láti tọ́jú pamọ́ nítorí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.10",
                "verseOrgIds": [
                  "2CH.31.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ti bùkún àwọn ènìyàn rẹ̀, ó sì ṣẹ́kù lọ́pọ̀lọ́pọ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiah pàṣẹ láti tọ́jú àwọn yàrá ìṣúra nínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.11",
                "verseOrgIds": [
                  "2CH.31.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", wọ́n sì ṣe èyí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà wọ́n mú ọrẹ àti ìdámẹ́wàá àti àwọn ẹ̀bùn tí a yà sí mímọ́ wọ ilé náà wá nítòótọ́. Lórí èyí tí Konaniah ọmọ Lefi, ń ṣe olórí, Ṣimei arákùnrin rẹ̀ ni igbákejì rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.12",
            "verseOrgIds": [
              "2CH.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehieli, Asasiah, Nahati, Asaheli, Jerimoti, Josabadi, Elieli, Ismakia, Mahati àti Benaiah jẹ́ àwọn alábojútó lábẹ́ Konaniah àti Ṣimei arákùnrin rẹ̀ nípa ipá ọba Hesekiah àti Asariah olórí ti ó wà ní ìkáwọ́ ilé Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.13",
            "verseOrgIds": [
              "2CH.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kore ọmọ Imina ará Lefi olùtọ́jú ẹnu-ọ̀nà ìlà-oòrùn, wà ní ìkáwọ́ àwọn ọrẹ àtinúwá tí a fi fún Ọlọ́run, o ń pín ìdáwó tí a ṣe fún",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.14",
                "verseOrgIds": [
                  "2CH.31.14"
                ]
              }
            }
          ]
        },
        {
          "text": "pẹ̀lú àwọn ẹ̀bùn tí a yà sọ́tọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edeni, Miniamini, Jeṣua, Ṣemaiah, Amariah àti Ṣekaniah ràn án lọ́wọ́ tọkàntọkàn nínú àwọn ìlú àwọn àlùfáà tí ń dáwó fún àwọn àlùfáà ẹlẹgbẹ́ wọn gẹ́gẹ́ bí ìpín wọn, àgbà àti kékeré.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.15",
            "verseOrgIds": [
              "2CH.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àfikún, wọ́n pín sí àwọn ọkùnrin àgbà ọdún mẹ́ta tàbí ọ̀pọ̀ tí orúkọ wọn wà nínú ìtàn ìdílé láti ọ̀dọ̀ baba ńlá wọn. Gbogbo àwọn ti yóò wọ ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.16",
                "verseOrgIds": [
                  "2CH.31.16"
                ]
              }
            }
          ]
        },
        {
          "text": "láti ṣe oríṣìí iṣẹ́ ti a gbà wọ́n fún gẹ́gẹ́ bí ìgbẹ́kẹ̀lé wọn àti ìpín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì pín àwọn àlùfáà, wọn kọ orúkọ àwọn ìdílé wọn sínú ìtàn ìdílé àti sí àwọn ará Lefi ogún ọdún tàbí jù bẹ́ẹ̀ gẹ́gẹ́ bí ìpinnu àti ìpín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.17",
            "verseOrgIds": [
              "2CH.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n fi gbogbo àwọn ọmọ kéékèèké sí i, àwọn ìyàwó, àti àwọn ọmọkùnrin àti àwọn ọmọbìnrin gbogbo ará ìlú tí a kọ lẹ́sẹẹsẹ sínú ìtàn ìdílé ti baba ńlá wọn fún ìrántí. Nítorí tí wọ́n ṣe òtítọ́ ní yíya ara wọn sí ọ̀tọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.18",
            "verseOrgIds": [
              "2CH.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ti àwọn àlùfáà, àwọn ìran ọmọ Aaroni, tí ń gbé ni àwọn ilẹ̀ oko lẹ́bàá àwọn ìlú wọn tàbí ní àwọn ìlú mìíràn. A yan àwọn ọkùnrin pẹ̀lú orúkọ láti pín ìlú fún gbogbo ọkùnrin láàrín wọn àti sí gbogbo àwọn tí a kọ sínú ìtàn ìdílé láti ọ̀dọ̀ baba ńlá àwọn ará Lefi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni Hesekiah ṣe jákèjádò Juda, ó sì ṣe ohun tí ó dára àti tí ó tọ́ àti ohun òtítọ́ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
              "2CH.31.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.20",
                "verseOrgIds": [
                  "2CH.31.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
              "2CH.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú ohun gbogbo tí ó dáwọ́lé ní ti iṣẹ́ ìsìn nínú ilé Ọlọ́run àti ní ìgbọ́ràn sí òfin àti àwọn àṣẹ. Ó wá Ọlọ́run rẹ̀, ó sì ṣiṣẹ́ tọkàntọkàn. Ó sì ṣe rere.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.21",
            "verseOrgIds": [
              "2CH.31.21"
            ]
          }
        }
      ]
    }
