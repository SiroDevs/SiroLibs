  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "2CH 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Manase ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase jẹ́ ọmọ ọdún méjìlá nígbà tí ó di ọba. Ó sì jẹ ọba ní Jerusalẹmu fún ọdún márùndínlọ́gọ́ta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.1",
            "verseOrgIds": [
              "2CH.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.2",
            "verseOrgIds": [
              "2CH.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.2",
                "verseOrgIds": [
                  "2CH.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nípa títẹ̀lé ọ̀nà iṣẹ́ ìríra ti àwọn orílẹ̀-èdè tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.2",
            "verseOrgIds": [
              "2CH.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.2",
                "verseOrgIds": [
                  "2CH.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ti lé jáde níwájú àwọn ọmọ Israẹli rìn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.2",
            "verseOrgIds": [
              "2CH.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó tún kọ́ àwọn ibi gíga tí baba rẹ̀ Hesekiah ti fọ́ túútúú. Ó sì gbé àwọn pẹpẹ dìde fún àwọn Baali ó sì ṣe àwọn ère Aṣerah. Ó foríbalẹ̀ fún gbogbo àwọn ogun ọ̀run ó sì sìn wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.3",
            "verseOrgIds": [
              "2CH.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó kọ́ àwọn pẹpẹ sínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.4",
            "verseOrgIds": [
              "2CH.33.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.4",
                "verseOrgIds": [
                  "2CH.33.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ní èyí tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.4",
            "verseOrgIds": [
              "2CH.33.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.4",
                "verseOrgIds": [
                  "2CH.33.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ti wí pé, \"Orúkọ mi yóò wà ní Jerusalẹmu títí láé.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.4",
            "verseOrgIds": [
              "2CH.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú ààfin méjèèje ti ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.5",
            "verseOrgIds": [
              "2CH.33.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.5",
                "verseOrgIds": [
                  "2CH.33.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", ó kọ́ àwọn pẹpẹ fún gbogbo àwọn ogun ọ̀run",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.5",
            "verseOrgIds": [
              "2CH.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì mú kí àwọn ọmọ ara rẹ̀ kí ó kọjá láàrín iná ní àfonífojì Beni-Hinnomu, ó ń ṣe àkíyèsí àfọ̀ṣẹ, ó sì ń lo àlúpàyídà, ó sì ń bá àwọn òku àti oṣó lò. Ó ṣe ọ̀pọ̀ ohun búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.6",
            "verseOrgIds": [
              "2CH.33.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.6",
                "verseOrgIds": [
                  "2CH.33.6"
                ]
              }
            }
          ]
        },
        {
          "text": "láti mú un bínú.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.6",
            "verseOrgIds": [
              "2CH.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó mú ère gbígbẹ́ tí ó ti gbẹ́ ó sì gbé e sínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.7",
            "verseOrgIds": [
              "2CH.33.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.7",
                "verseOrgIds": [
                  "2CH.33.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", ní èyí tí Ọlọ́run ti sọ fún Dafidi àti sí ọmọ rẹ̀ Solomoni, \"Nínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.7",
            "verseOrgIds": [
              "2CH.33.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.7",
                "verseOrgIds": [
                  "2CH.33.7"
                ]
              }
            }
          ]
        },
        {
          "text": "yìí àti ní Jerusalẹmu, tí mo ti yàn kúrò nínú gbogbo àwọn ẹ̀yà Israẹli, èmi yóò fi orúkọ mi síbẹ̀ títí láé.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.7",
            "verseOrgIds": [
              "2CH.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi kì yóò ṣí ẹsẹ̀ àwọn ọmọ Israẹli kúrò mọ́ ní ilẹ̀ náà tí èmi ti yàn fún àwọn baba ńlá yín, níwọ̀n bí wọ́n bá ṣe pẹ̀lẹ́ láti ṣe gbogbo ohun tí mo paláṣẹ fún wọn, gẹ́gẹ́ bí gbogbo òfin, àṣẹ àti àwọn ìlànà tí a fún yín láti ọwọ́ Mose wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.8",
            "verseOrgIds": [
              "2CH.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Manase mú kí Juda àti àwọn tí ń gbé Jerusalẹmu yapa, àti láti ṣe búburú ju àwọn orílẹ̀-èdè lọ, àwọn tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.9",
            "verseOrgIds": [
              "2CH.33.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.9",
                "verseOrgIds": [
                  "2CH.33.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ti parun níwájú àwọn ọmọ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.9",
            "verseOrgIds": [
              "2CH.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.10",
                "verseOrgIds": [
                  "2CH.33.10"
                ]
              }
            }
          ]
        },
        {
          "text": "bá Manase sọ̀rọ̀ àti àwọn ènìyàn rẹ̀, ṣùgbọ́n wọn kò kọbi ara sí i.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.10",
            "verseOrgIds": [
              "2CH.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.11",
            "verseOrgIds": [
              "2CH.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.11",
                "verseOrgIds": [
                  "2CH.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": "mú àwọn alákòóso ọmọ-ogun ọba Asiria láti dojúkọ wọ́n, tí ó mú Manase nígbèkùn, ó fi ìwọ̀ mú un ní imú rẹ̀, ó dè é pẹ̀lú ṣẹ́kẹ́ṣẹkẹ̀ idẹ ó sì mú un lọ sí Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.11",
            "verseOrgIds": [
              "2CH.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú ìpọ́njú rẹ̀, ó wá ojúrere",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.12",
            "verseOrgIds": [
              "2CH.33.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.12",
                "verseOrgIds": [
                  "2CH.33.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀. Ó sì rẹ ara rẹ̀ sílẹ̀ gidigidi níwájú Ọlọ́run àwọn baba rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.12",
            "verseOrgIds": [
              "2CH.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó sì gbàdúrà sí i, inú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.13",
            "verseOrgIds": [
              "2CH.33.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.13",
                "verseOrgIds": [
                  "2CH.33.13"
                ]
              }
            }
          ]
        },
        {
          "text": "dùn sí àdúrà rẹ̀, ó sì tẹ́tí sí ẹ̀bẹ̀ rẹ̀; bẹ́ẹ̀ ni ó mú un padà wá sí Jerusalẹmu àti sí ìjọba rẹ̀. Nígbà náà Manase mọ̀ wí pé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.13",
            "verseOrgIds": [
              "2CH.33.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.13",
                "verseOrgIds": [
                  "2CH.33.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ni Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.13",
            "verseOrgIds": [
              "2CH.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ lẹ́yìn èyí, ó mọ odi kan lẹ́yìn ìlú Dafidi, ní ìhà ìwọ̀-oòrùn Gihoni, ní àfonífojì, àní ní àtiwọ ẹnu ibodè ẹja, ó sì yí orí òkè Ofeli ká; ó sì mọ ọ́n ga sókè gidigidi, ó sì fi balógun sínú gbogbo ìlú olódi Juda wọ̀n-ọn-nì.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.14",
            "verseOrgIds": [
              "2CH.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó pa gbogbo àwọn Ọlọ́run àjèjì run. Ó sì hú gbogbo àwọn ère kúrò nínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.15",
            "verseOrgIds": [
              "2CH.33.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.15",
                "verseOrgIds": [
                  "2CH.33.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", pẹ̀lú gbogbo àwọn pẹpẹ tí ó ti kọ́ ní òkè ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.15",
            "verseOrgIds": [
              "2CH.33.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.15",
                "verseOrgIds": [
                  "2CH.33.15"
                ]
              }
            }
          ]
        },
        {
          "text": "àti ní Jerusalẹmu; ó sì kó wọn jáde kúrò nínú ìlú.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.15",
            "verseOrgIds": [
              "2CH.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ó mú àwọn pẹpẹ padà bọ̀ sípò. Ó sì rú ọrẹ ìdàpọ̀ àti ọrẹ-ọpẹ́ lórí rẹ̀. Ó sì sọ fún Juda láti sin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.16",
            "verseOrgIds": [
              "2CH.33.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.16",
                "verseOrgIds": [
                  "2CH.33.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.16",
            "verseOrgIds": [
              "2CH.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn, ko tẹ̀síwájú láti máa rú ẹbọ ní àwọn ibi gíga. Ṣùgbọ́n sí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.17",
            "verseOrgIds": [
              "2CH.33.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.17",
                "verseOrgIds": [
                  "2CH.33.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wọn nìkan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.17",
            "verseOrgIds": [
              "2CH.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn iṣẹ́ yòókù ti ìjọba Manase pẹ̀lú àdúrà rẹ̀ sí Ọlọ́run rẹ̀ àti àwọn ọ̀rọ̀ tí àwọn aríran sọ sí i ní orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.18",
            "verseOrgIds": [
              "2CH.33.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.18",
                "verseOrgIds": [
                  "2CH.33.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli, wà nínú ìwé ìtàn ayé àwọn ọba Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.18",
            "verseOrgIds": [
              "2CH.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àdúrà rẹ̀ àti bí inú Ọlọ́run ṣe dùn sí àdúrà rẹ̀ àti gbogbo àwọn ẹ̀ṣẹ̀ rẹ̀ àti àìṣòótọ́, àti àwọn òpó níbi tí ó kọ́ àwọn ibi gíga sí, ó sì gbé àwọn ère Aṣerah àti àwọn òrìṣà kí ó tó rẹ ara rẹ̀ sílẹ̀, gbogbo rẹ̀ ni a kọ sínú ìwé ìrántí àwọn aríran.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.19",
            "verseOrgIds": [
              "2CH.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase sinmi pẹ̀lú àwọn baba rẹ̀, a sì sin ín sínú ààfin rẹ̀. Amoni ọmọ rẹ̀ sì rọ́pò rẹ̀ gẹ́gẹ́ bí ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.20",
            "verseOrgIds": [
              "2CH.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amoni ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni jẹ́ ẹni ọdún méjìlélógún nígbà tí ó di ọba. Ó sì jẹ ọba ní Jerusalẹmu fún ọdún méjì.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.21",
            "verseOrgIds": [
              "2CH.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.22",
            "verseOrgIds": [
              "2CH.33.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.22",
                "verseOrgIds": [
                  "2CH.33.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", gẹ́gẹ́ bí baba rẹ̀ Manase ti ṣe. Amoni rú ẹbọ sí gbogbo àwọn òrìṣà tí Manase baba rẹ̀ ti ṣe, ó sì sìn wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.22",
            "verseOrgIds": [
              "2CH.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n kì í ṣe bí i baba rẹ̀ Manase. Kò rẹ ara rẹ̀ sílẹ̀ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.23",
            "verseOrgIds": [
              "2CH.33.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.23",
                "verseOrgIds": [
                  "2CH.33.23"
                ]
              }
            }
          ]
        },
        {
          "text": ": ṣùgbọ́n ẹ̀ṣẹ̀ Amoni sì ń pọ̀ sì í.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.23",
            "verseOrgIds": [
              "2CH.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn oníṣẹ́ Amoni dìtẹ̀ sí i. Wọ́n sì pa á ní ààfin rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.24",
            "verseOrgIds": [
              "2CH.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, gbogbo àwọn ènìyàn ilẹ̀ náà pa gbogbo àwọn tí wọ́n ṣọ̀tẹ̀ sí ọba Amoni, wọ́n sì mú Josiah ọmọ rẹ̀ jẹ ọba ní ipò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.25",
            "verseOrgIds": [
              "2CH.33.25"
            ]
          }
        }
      ]
    }
  ],
