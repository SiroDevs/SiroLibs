  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "2CH 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí gbogbo iṣẹ́ tí Solomoni ti ṣe fún tẹmpili",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.1",
                "verseOrgIds": [
                  "2CH.5.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ti parí, ó kó gbogbo àwọn nǹkan tí Dafidi baba rẹ̀ ti yà sọ́tọ̀: wúrà àti fàdákà àti gbogbo ohun èlò ọ̀ṣọ́, ó sì fi wọ́n sínú ìṣúra ilé Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A gbé àpótí ẹ̀rí wọ inú tẹmpili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Solomoni pe àwọn àgbàgbà Israẹli jọ sí Jerusalẹmu, gbogbo àwọn olórí ẹ̀yà kọ̀ọ̀kan àti àwọn olóyè àwọn ìdílé Israẹli, kí wọn kí ó gbé àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.2",
                "verseOrgIds": [
                  "2CH.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "gòkè wá láti Sioni ìlú Dafidi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọkùnrin Israẹli péjọ sí ọ̀dọ̀ ọba ní àkókò àjọ àgọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn àgbàgbà Israẹli sì wá, àwọn ọmọ Lefi gbé àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.4",
                "verseOrgIds": [
                  "2CH.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì gbé àpótí ẹ̀rí náà gòkè àti àgọ́ ìpàdé àti gbogbo ohun èlò mímọ́ tí ó wà nínú àgọ́. Àwọn àlùfáà tí wọ́n jẹ́ ọmọ Lefi ni ó mú wọn gòkè wá.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọba Solomoni àti gbogbo ìjọ ènìyàn Israẹli tí ó péjọ sí ọ̀dọ̀ rẹ̀, wà níwájú àpótí ẹ̀rí náà wọ́n sì fi àgùntàn àti màlúù tí a kò le è kà tán rú ẹbọ, bẹ́ẹ̀ ni a kò le è mọ iye wọn tán nítorí bí wọ́n ti pọ̀ tó.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn àlùfáà gbé àpótí ẹ̀rí ti májẹ̀mú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.7",
                "verseOrgIds": [
                  "2CH.5.7"
                ]
              }
            }
          ]
        },
        {
          "text": "wá sí ipò rẹ̀, sí ibi inú lọ́hùn ún ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.7",
                "verseOrgIds": [
                  "2CH.5.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ibi Mímọ́ Jùlọ, wọ́n gbé e sí abẹ́ ìyẹ́ àwọn kérúbù.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn Kérúbù na ìyẹ́ wọn bo ibi àpótí ẹ̀rí náà àti àwọn ọ̀pá tí ó gbé e ró.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀pá rẹ̀ náà gùn tó bẹ́ẹ̀ tí a fi rí orí àwọn ọ̀pá náà láti ibi àpótí ẹ̀rí náà níwájú Ibi Mímọ́ náà, ṣùgbọ́n a kò rí wọn lóde. Níbẹ̀ ni ó sì wà títí di òní yìí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ohun kan nínú àpótí ẹ̀rí náà bí kò ṣe wàláà méjì tí Mose fi sínú rẹ̀ ní Horebu, ní ìgbà tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.10",
                "verseOrgIds": [
                  "2CH.5.10"
                ]
              }
            }
          ]
        },
        {
          "text": "fi bá àwọn ọmọ Israẹli dá májẹ̀mú lẹ́yìn ìgbà tí wọ́n jáde wá láti ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà ni àwọn àlùfáà jáde wá láti Ibi Mímọ́. Gbogbo àwọn àlùfáà tí ó wà níbẹ̀ ni ó ya ara wọn sí mímọ́ láìbìkítà fún ìpín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.11",
            "verseOrgIds": [
              "2CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọmọ Lefi tí wọ́n jẹ́ akọrin: Asafu, Hemani, Jedutuni àti àwọn ọmọ wọn àti àwọn ẹbí wọn, wọ́n dúró ní igun ìlà-oòrùn pẹpẹ náà wọ́n wọ aṣọ ọ̀gbọ̀ tuntun wọ́n ń lo kimbali, dùùrù àti ohun èlò orin olókùn. Ìwọ̀n ọgọ́fà àwọn àlùfáà tí wọ́n ń fun ìpè ni wọ́n tẹ̀lé wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn afùnpè àti àwọn akọrin pa ohùn wọn pọ̀ sí ọ̀kan ṣoṣo, láti fi ìyìn àti ọpẹ́ fun",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.13",
                "verseOrgIds": [
                  "2CH.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": ". Wọ́n fi ìpè, kimbali àti àwọn ohun èlò orin mìíràn mọ́ ọn, wọ́n gbé ohùn wọn sókè láti fi yin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.13",
                "verseOrgIds": [
                  "2CH.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", wọ́n ń kọrin pé,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CH 5:13"
      },
      "items": [
        {
          "text": "\"Ó dára;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CH 5:13"
      },
      "items": [
        {
          "text": "ìfẹ́ rẹ̀ wà títí láéláé.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 5:13"
      },
      "items": [
        {
          "text": "Nígbà náà ni ìkùùkuu ojú ọ̀run kún inú tẹmpili",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.13",
                "verseOrgIds": [
                  "2CH.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "tó bẹ́ẹ̀ tí àwọn àlùfáà kò le è ṣiṣẹ́ ìsìn wọn nítorí ìkùùkuu náà, nítorí ògo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.14",
            "verseOrgIds": [
              "2CH.5.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.14",
                "verseOrgIds": [
                  "2CH.5.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kún inú tẹmpili Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.14",
            "verseOrgIds": [
              "2CH.5.14"
            ]
          }
        }
      ]
    }
  ],
