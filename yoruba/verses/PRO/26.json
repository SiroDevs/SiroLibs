      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:26"
      },
      "items": [
        {
          "text": "ṣùgbọ́n àṣírí ìwà búburú rẹ̀ yóò tú ní gbangba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.26",
            "verseOrgIds": [
              "PRO.26.26"
            ]
          }
