              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ènìyàn kan bá gbẹ́ kòtò, yóò ṣubú sínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.27",
            "verseOrgIds": [
