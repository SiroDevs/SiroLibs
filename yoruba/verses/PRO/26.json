          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ètè jíjóni, àti àyà búburú,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.23",
            "verseOrgIds": [
              "PRO.26.23"
            ]
