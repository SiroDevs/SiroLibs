          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìkórìíra rẹ le è fi ara sin nípa ẹ̀tàn",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.26",
            "verseOrgIds": [
              "PRO.26.26"
            ]
          }
