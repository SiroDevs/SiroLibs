      "attrs": {
        "style": "q2",
        "vid": "PRO 26:21"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni ènìyàn oníjà fún ìjà dídá sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.21",
            "verseOrgIds": [
              "PRO.26.21"
            ]
