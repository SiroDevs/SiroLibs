      "attrs": {
        "style": "q2",
        "vid": "PRO 26:22"
      },
      "items": [
        {
          "text": "wọ́n a sì wọ ìsàlẹ̀ inú lọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.22",
            "verseOrgIds": [
              "PRO.26.22"
            ]
