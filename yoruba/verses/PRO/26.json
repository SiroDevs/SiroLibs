          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọ̀rọ̀ rẹ̀ tilẹ̀ fanimọ́ra, má ṣe gbà á gbọ́",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.25",
            "verseOrgIds": [
              "PRO.26.25"
            ]
          }
