          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí èédú ti rí sí ẹyin iná, igi fún iná,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.21",
            "verseOrgIds": [
              "PRO.26.21"
            ]
