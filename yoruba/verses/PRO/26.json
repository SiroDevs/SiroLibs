      "attrs": {
        "style": "q2",
        "vid": "PRO 26:25"
      },
      "items": [
        {
          "text": "nítorí ìríra méje ni ó kún inú ọkàn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.25",
            "verseOrgIds": [
              "PRO.26.25"
            ]
