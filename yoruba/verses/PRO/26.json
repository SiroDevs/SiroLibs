          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ènìyàn tí ó kórìíra máa ń fi ètè rẹ̀ bo àṣírí ara rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.24",
            "verseOrgIds": [
              "PRO.26.24"
            ]
