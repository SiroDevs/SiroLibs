          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀ ẹni tí ń sọ̀rọ̀ ẹ̀yìn dàbí àṣàyàn òkèlè",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.22",
