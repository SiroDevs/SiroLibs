      "attrs": {
        "style": "q2",
        "vid": "PRO 26:23"
      },
      "items": [
        {
          "text": "dà bí ìdàrọ́ fàdákà tí a fi bo ìkòkò.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.23",
            "verseOrgIds": [
              "PRO.26.23"
            ]
          }
        }
      ]
    },
    {
