      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:24"
      },
      "items": [
        {
          "text": "ṣùgbọ́n nínú ọkàn rẹ̀ ni ìtànjẹ wà.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.24",
            "verseOrgIds": [
              "PRO.26.24"
            ]
          }
        }
      ]
    },
