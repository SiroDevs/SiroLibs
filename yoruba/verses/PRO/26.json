      "attrs": {
        "style": "q2",
        "vid": "PRO 26:20"
      },
      "items": [
        {
          "text": "láìsí ọ̀rọ̀ ẹ̀yìn, ìjà máa ń parí.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.20",
            "verseOrgIds": [
