      "attrs": {
        "style": "q2",
        "vid": "PRO 26:27"
      },
      "items": [
        {
          "text": "Bí ẹnìkan bá ju òkúta, yóò padà sọ́dọ̀ òun tìkára rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.27",
            "verseOrgIds": [
