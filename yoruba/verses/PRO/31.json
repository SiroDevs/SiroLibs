      "attrs": {
        "style": "q2",
        "vid": "PRO 31:26"
      },
      "items": [
        {
          "text": "ìkọ́ni òtítọ́ sì ń bẹ létè e rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.26",
            "verseOrgIds": [
              "PRO.31.26"
            ]
          }
        }
