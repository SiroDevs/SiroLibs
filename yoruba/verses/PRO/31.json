          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí òjò-dídì rọ̀, kò bẹ̀rù nítorí ìdílé rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.21",
            "verseOrgIds": [
              "PRO.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:21"
      },
      "items": [
        {
          "text": "nítorí gbogbo wọn ni ó wọ aṣọ tí ó nípọn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.21",
            "verseOrgIds": [
              "PRO.31.21"
            ]
          }
        }
      ]
    },
    {
