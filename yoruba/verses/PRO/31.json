      "attrs": {
        "style": "q2",
        "vid": "PRO 31:28"
      },
      "items": [
        {
          "text": "ọkọ rẹ̀ pẹ̀lú ń gbóríyìn fún un.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.28",
            "verseOrgIds": [
              "PRO.31.28"
            ]
          }
        }
      ]
    },
    {
