      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:24"
      },
      "items": [
        {
          "text": "ó sì ń kó ọjà fún àwọn oníṣòwò.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.24",
            "verseOrgIds": [
              "PRO.31.24"
            ]
          }
        }
