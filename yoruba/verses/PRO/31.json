          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bọ̀wọ̀ fún ọkọ rẹ̀ ní ẹnu ibodè ìlú",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.23",
            "verseOrgIds": [
              "PRO.31.23"
            ]
          }
        }
      ]
    },
