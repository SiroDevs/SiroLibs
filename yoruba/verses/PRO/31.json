          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojú dáradára a máa tan ni, ẹwà sì jẹ́ asán",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.30",
            "verseOrgIds": [
              "PRO.31.30"
            ]
          }
        }
