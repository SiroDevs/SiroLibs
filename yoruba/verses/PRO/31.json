      "attrs": {
        "style": "q2",
        "vid": "PRO 31:31"
      },
      "items": [
        {
          "text": "kí o sì jẹ́ kí iṣẹ́ rẹ̀ fún un ní ìyìn ní ẹnu ibodè ìlú.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.31",
            "verseOrgIds": [
