          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ń ṣe àwọn aṣọ dáradára ó sì ń tà wọ́n",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.24",
            "verseOrgIds": [
              "PRO.31.24"
            ]
          }
        }
      ]
