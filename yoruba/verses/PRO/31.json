      "attrs": {
        "style": "q2",
        "vid": "PRO 31:27"
      },
      "items": [
        {
          "text": "kì í sì í jẹ oúnjẹ ìmẹ́lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.27",
            "verseOrgIds": [
              "PRO.31.27"
