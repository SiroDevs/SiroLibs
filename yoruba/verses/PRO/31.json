      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:29"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ìwọ ju gbogbo wọn lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.29",
            "verseOrgIds": [
              "PRO.31.29"
            ]
          }
        }
      ]
    },
