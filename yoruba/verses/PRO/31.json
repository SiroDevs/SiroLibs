          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe aṣọ títẹ́ fún ibùsùn rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.22",
            "verseOrgIds": [
              "PRO.31.22"
            ]
          }
        }
      ]
    },
    {
