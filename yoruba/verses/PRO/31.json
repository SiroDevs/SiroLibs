          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ń bojútó gbogbo ètò ilé rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.27",
            "verseOrgIds": [
              "PRO.31.27"
            ]
