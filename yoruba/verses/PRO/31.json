          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sì fún un ní èrè tí ó tọ́ sí i",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.31",
            "verseOrgIds": [
              "PRO.31.31"
            ]
          }
        }
      ]
