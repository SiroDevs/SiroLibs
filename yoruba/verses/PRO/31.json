      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:23"
      },
      "items": [
        {
          "text": "níbi tí ó ń jókòó láàrín àwọn àgbàgbà ìlú.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.23",
            "verseOrgIds": [
              "PRO.31.23"
            ]
          }
        }
      ]
    },
