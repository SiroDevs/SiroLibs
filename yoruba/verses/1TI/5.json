  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "1TI 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìmọ̀ràn nípa àwọn opó, àwọn alàgbà àti àwọn ẹrú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe bá àgbàlagbà ọkùnrin wí, ṣùgbọ́n kí ó máa gbà á níyànjú bí i baba; àwọn ọ̀dọ́mọkùnrin bí arákùnrin.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.1",
            "verseOrgIds": [
              "1TI.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àgbàlagbà obìnrin bí ìyá; àwọn ọ̀dọ́mọbìnrin bí arábìnrin nínú ìwà mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.2",
            "verseOrgIds": [
              "1TI.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bọ̀wọ̀ fún àwọn opó ti í ṣe opó nítòótọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.3",
            "verseOrgIds": [
              "1TI.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí opó kan bá ni ọmọ tàbí ọmọ ọmọ, jẹ́ kí wọn kọ́kọ́ kọ́ bí a ti ń ṣe ìtọ́jú ilé àwọn tìkára wọn, kí wọn sì san oore àwọn òbí wọn padà; nítorí pé èyí ni ó ṣe ìtẹ́wọ́gbà níwájú Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.4",
            "verseOrgIds": [
              "1TI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ ẹni ti í ṣe opó nítòótọ́, ti ó ṣe òun nìkan, a máa gbẹ́kẹ̀lé Ọlọ́run, a sì máa dúró nínú ẹ̀bẹ̀ àti nínú àdúrà lọ́sàn àti lóru.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.5",
            "verseOrgIds": [
              "1TI.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹni tí ó bá fi ara rẹ fún ayé jíjẹ, ó kú nígbà tí ó wà láààyè.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.6",
            "verseOrgIds": [
              "1TI.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nǹkan wọ̀nyí ni kí wọn máa paláṣẹ, kí wọn lè wà láìlẹ́gàn.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.7",
            "verseOrgIds": [
              "1TI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ẹnikẹ́ni kò bá pèsè fún àwọn tirẹ̀, pàápàá fún àwọn ará ilé rẹ̀, ó ti sẹ́ ìgbàgbọ́, ó burú ju aláìgbàgbọ́ lọ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.8",
            "verseOrgIds": [
              "1TI.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kọ orúkọ ẹni tí kò bá dín ni ọgọ́ta ọdún sílẹ̀ bí opó, lẹ́yìn ti ó ti jẹ́ aya ọkọ kan.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.9",
            "verseOrgIds": [
              "1TI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni ti a jẹ́rìí rẹ̀ fún iṣẹ́ rere; bí ẹni ti ó ti tọ́ ọmọ dàgbà, ti ó ń ṣe ìtọ́jú àlejò, tí ó sì ń wẹ ẹsẹ̀ àwọn ènìyàn mímọ́, tí ó ti ran àwọn olùpọ́njú lọ́wọ́, tí ó sì ń lépa iṣẹ́ rere gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.10",
            "verseOrgIds": [
              "1TI.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ma ṣe kọ orúkọ àwọn opó tí kò dàgbà; nítorí pé nígbà tiwọn bá ti ṣe ìfẹ́kúfẹ̀ẹ́ lòdì sí Kristi, wọn á tún fẹ́ láti gbéyàwó.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.11",
            "verseOrgIds": [
              "1TI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn á di ẹlẹ́bi, nítorí tí wọn ti kọ ìgbàgbọ́ wọn ìṣáájú sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.12",
            "verseOrgIds": [
              "1TI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti pẹ̀lú wọn ń kọ́ láti ṣe ọ̀lẹ, láti máa kiri láti ilédélé, kì í ṣe ọ̀lẹ nìkan, ṣùgbọ́n onísọkúsọ àti olófòófó pẹ̀lú, wọn a máa sọ ohun tí kò yẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.13",
            "verseOrgIds": [
              "1TI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, mo fẹ́ kí àwọn opó tí kò dàgbà máa gbéyàwó, kí wọn máa bímọ, kí wọn máa ṣe alábojútó ilé, kí wọn má ṣe fi ààyè sílẹ̀ rárá fún ọ̀tá náà láti sọ̀rọ̀ ẹ̀gàn.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.14",
            "verseOrgIds": [
              "1TI.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí àwọn mìíràn ti yípadà kúrò sí ẹ̀yìn Satani.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.15",
            "verseOrgIds": [
              "1TI.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọkùnrin tàbí obìnrin kan tí ó gbàgbọ́ bá ní àwọn opó, kí ó máa ràn wọ́n lọ́wọ́, kí a má sì di ẹrù lé ìjọ, kí wọn lè máa ran àwọn ti í ṣe opó nítòótọ́ lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.16",
            "verseOrgIds": [
              "1TI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn alàgbà ti ó ṣe àkóso dáradára ni kí a kà yẹ sí ọlá ìlọ́po méjì, pẹ̀lúpẹ̀lú àwọn ti ó ṣe làálàá ni ọ̀rọ̀ àti ni kíkọ́ni.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.17",
            "verseOrgIds": [
              "1TI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí Ìwé Mímọ́ wí pé, \"Ìwọ kò gbọdọ̀ di màlúù ti ń tẹ ọkà lẹ́nu,\" àti pé, \"Ọ̀yà alágbàṣe tọ́ sí i.\"",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.18",
            "verseOrgIds": [
              "1TI.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe gba ẹ̀sùn sí alàgbà kan, bí kò ṣe láti ẹnu ẹlẹ́rìí méjì mẹ́ta.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.19",
            "verseOrgIds": [
              "1TI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bá àwọn tí ó ṣẹ̀ wí níwájú gbogbo ènìyàn, kí àwọn ìyókù pẹ̀lú bà á lè bẹ̀rù.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.20",
            "verseOrgIds": [
              "1TI.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TI 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo pàṣẹ fún ọ níwájú Ọlọ́run, àti Kristi Jesu, àti àwọn angẹli àyànfẹ́ kí ìwọ máa ṣàkíyèsí nǹkan wọ̀nyí, láìṣe ojúsàájú, láti fi ègbè ṣe ohunkóhun.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.21",
            "verseOrgIds": [
              "1TI.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1TI 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe fi ìkánjú gbe ọwọ́ lé ẹnikẹ́ni, bẹ́ẹ̀ ni kí ó má sì ṣe jẹ́ alábápín nínú ẹ̀ṣẹ̀ àwọn ẹlòmíràn, pa ara rẹ mọ́ ní ìwà mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.22",
            "verseOrgIds": [
              "1TI.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ṣe máa mu omi nìkan, ṣùgbọ́n máa lo wáìnì díẹ̀ nítorí inú rẹ, àti nítorí àìlera ìgbàkúgbà.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.23",
            "verseOrgIds": [
              "1TI.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TI 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀ṣẹ̀ àwọn ẹlòmíràn a máa hàn gbangba, a máa lọ ṣáájú sí ìdájọ́; tí àwọn ẹlòmíràn pẹ̀lú a sì máa tẹ̀lé wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.24",
            "verseOrgIds": [
              "1TI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1TI 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ gẹ́gẹ́ pẹ̀lú ni iṣẹ́ rere wa máa ń hàn gbangba; bí wọn kò tilẹ̀ tí ì hàn, wọn kò lè fi ara sin títí.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.25",
            "verseOrgIds": [
              "1TI.5.25"
            ]
          }
        }
      ]
    }
  ],
