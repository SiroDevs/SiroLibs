      "attrs": {
        "style": "q2",
        "vid": "NUM 24:19"
      },
      "items": [
        {
          "text": "yóò sì pa àwọn tó ṣẹ́kù nínú ìlú náà run.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.19",
            "verseOrgIds": [
              "NUM.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ̀rọ̀-ìjìnlẹ̀ ìkẹyìn Balaamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
