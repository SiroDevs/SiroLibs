          "attrs": {
            "verseId": "NUM.24.22",
            "verseOrgIds": [
              "NUM.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:22"
      },
      "items": [
        {
          "text": "nígbà tí Asiria bá mú yín ní ìgbèkùn.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.22",
            "verseOrgIds": [
              "NUM.24.22"
            ]
          }
        }
      ]
    },
