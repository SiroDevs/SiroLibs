      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:23"
      },
      "items": [
        {
          "text": "\"Háà, ta ni ó lè yè nígbà tí Ọlọ́run bá ṣe èyí?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.23",
            "verseOrgIds": [
              "NUM.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkọ̀ yóò wá láti ibùdókọ̀ Kittimu;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.24",
            "verseOrgIds": [
              "NUM.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:24"
      },
      "items": [
        {
          "text": "wọn yóò ṣẹ́gun Asiria àti Eberi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.24",
            "verseOrgIds": [
              "NUM.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:24"
      },
      "items": [
        {
          "text": "ṣùgbọ́n àwọn náà yóò di píparun.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.24",
            "verseOrgIds": [
              "NUM.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
