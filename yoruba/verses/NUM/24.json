            "sid": "NUM 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Balaamu rí Amaleki ó sì bẹ̀rẹ̀ òwe:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.20",
            "verseOrgIds": [
              "NUM.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:20"
      },
      "items": [
        {
          "text": "\"Amaleki ni àkọ́kọ́ nínú àwọn orílẹ̀-èdè,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.20",
            "verseOrgIds": [
              "NUM.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:20"
      },
      "items": [
        {
          "text": "ṣùgbọ́n yóò dahoro níkẹyìn.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.20",
            "verseOrgIds": [
              "NUM.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
