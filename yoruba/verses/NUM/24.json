          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mo rí i, ṣùgbọ́n kì í ṣe ìsinsin yìí.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.17",
            "verseOrgIds": [
              "NUM.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:17"
      },
      "items": [
        {
          "text": "Mo kíyèsi, ṣùgbọ́n kò súnmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.17",
            "verseOrgIds": [
              "NUM.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:17"
      },
      "items": [
        {
          "text": "Ìràwọ̀ kan yóò jáde láti ọ̀dọ̀ Jakọbu;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.17",
            "verseOrgIds": [
              "NUM.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:17"
      },
      "items": [
        {
          "text": "yóò yọ jáde láti Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.17",
            "verseOrgIds": [
              "NUM.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:17"
      },
      "items": [
        {
          "text": "Yóò tẹ̀ fọ́ orí Moabu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.17",
            "verseOrgIds": [
              "NUM.24.17"
            ]
          }
        }
      ]
    },
    {
