          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ó bẹ̀rẹ̀ òwe rẹ̀:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.23",
            "verseOrgIds": [
              "NUM.24.23"
            ]
          }
        }
      ]
    },
    {
