  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "NUM 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí nígbà tí Balaamu rí i wí pé ó tẹ́",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.1",
            "verseOrgIds": [
              "NUM.24.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.24.1",
                "verseOrgIds": [
                  "NUM.24.1"
                ]
              }
            }
          ]
        },
        {
          "text": "lọ́rùn láti bùkún àwọn Israẹli, kò lo ọ̀nà ìṣoṣó gẹ́gẹ́ bí ti ìgbà ìṣáájú, ṣùgbọ́n ó yí ojú rẹ̀ sí apá aginjù.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.1",
            "verseOrgIds": [
              "NUM.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Balaamu wo ìta ó sì rí Israẹli tí wọ́n pàgọ́ gẹ́gẹ́ bí ẹ̀yà wọn, Ẹ̀mí Ọlọ́run sì bà sórí rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.2",
            "verseOrgIds": [
              "NUM.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó sì sọ àsọtẹ́lẹ̀ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:3"
      },
      "items": [
        {
          "text": "\"Àsọtẹ́lẹ̀ tí Balaamu ọmọ Beori,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:3"
      },
      "items": [
        {
          "text": "àsọtẹ́lẹ̀ ẹni tí ojú rẹ̀ ríran kedere,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "àsọtẹ́lẹ̀ ẹni tí ó gbọ́ ọ̀rọ̀ Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.4",
            "verseOrgIds": [
              "NUM.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:4"
      },
      "items": [
        {
          "text": "ẹni tí ó ríran láti ọ̀dọ̀ Olódùmarè,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.4",
            "verseOrgIds": [
              "NUM.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:4"
      },
      "items": [
        {
          "text": "ẹni tí ó dojúbolẹ̀, tí ojú rẹ̀ là kedere.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.4",
            "verseOrgIds": [
              "NUM.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àgọ́ rẹ ti dára tó, ìwọ Jakọbu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.5",
            "verseOrgIds": [
              "NUM.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:5"
      },
      "items": [
        {
          "text": "àti ibùgbé rẹ, ìwọ Israẹli!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.5",
            "verseOrgIds": [
              "NUM.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gẹ́gẹ́ bí àfonífojì tí ó tàn jáde,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:6"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ọgbà tí ó wà ní ẹ̀bá odò ńlá,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:6"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí igi aloe tí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.24.6",
                "verseOrgIds": [
                  "NUM.24.6"
                ]
              }
            }
          ]
        },
        {
          "text": "gbìn,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:6"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí igi kedari tí ó wà lẹ́bàá odò.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omi yóò sàn láti inú garawa:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:7"
      },
      "items": [
        {
          "text": "èso wọn yóò ní ọ̀pọ̀lọpọ̀ omi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NUM 24:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:7"
      },
      "items": [
        {
          "text": "\"Ọba wọn yóò ga ju Agagi lọ;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:7"
      },
      "items": [
        {
          "text": "ìjọba wọn yóò di gbígbéga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọlọ́run mú wọn jáde láti Ejibiti wá;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "wọ́n ní agbára gẹ́gẹ́ bí i ti àgbáǹréré.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "Wọ́n jẹ orílẹ̀-èdè tí ń ṣe ọ̀tá rẹ̀ run,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "wọ́n sì fọ́ egungun wọn sí túútúú;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "wọ́n ó sì fi ọfà wọn ta wọ́n ní àtapòyọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó tẹríba ó sì dùbúlẹ̀ bí kìnnìún,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:9"
      },
      "items": [
        {
          "text": "bí abo kìnnìún: ta ni ó gbọdọ̀ jí wọn?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NUM 24:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:9"
      },
      "items": [
        {
          "text": "\"Ìbùkún ni fún ẹni tí ó bùkún fún ọ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:9"
      },
      "items": [
        {
          "text": "kí ìfibú jẹ́ ti ẹni tí ó fi ọ́ bú!\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ìbínú Balaki sì dé sí Balaamu. Ó sì fi ọwọ́ lu ọwọ́ ó wí pé, \"Mo pè ọ́ láti bú àwọn ọ̀tá mi ṣùgbọ́n o tún bùkún fún wọn nígbà mẹ́ta yìí.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.10",
            "verseOrgIds": [
              "NUM.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí sálọ sí ibùjókòó rẹ! Èmi ti rò láti sọ ọ́ di ẹni ńlá, ṣùgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.11",
            "verseOrgIds": [
              "NUM.24.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.24.11",
                "verseOrgIds": [
                  "NUM.24.11"
                ]
              }
            }
          ]
        },
        {
          "text": "tí fà ọ́ sẹ́yìn láti gba èrè yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.11",
            "verseOrgIds": [
              "NUM.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu dá Balaki lóhùn, \"Ǹjẹ́ èmi kò sọ fún àwọn ìránṣẹ́ tí o rán sí mi wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.12",
            "verseOrgIds": [
              "NUM.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Kódà bí Balaki bá fún mi ní ààfin rẹ̀ tí ó kún fún fàdákà àti wúrà, èmi kò le ṣe ohunkóhun lọ́wọ́ ara mi, yálà búburú tàbí rere, láti kọjá òfin",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.24.13",
                "verseOrgIds": [
                  "NUM.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": ": ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.24.13",
                "verseOrgIds": [
                  "NUM.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": "bá wí ni èmi ó sọ'?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí mò ń padà lọ sí ọ̀dọ̀ àwọn ènìyàn mi, ṣùgbọ́n jẹ́ kí èmi kí ó kìlọ̀ fún ọ nítorí nǹkan tí àwọn ènìyàn wọ̀nyí yóò ṣe sí àwọn ènìyàn rẹ ní ọjọ́ iwájú.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.14",
            "verseOrgIds": [
              "NUM.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ̀rọ̀-ìjìnlẹ̀ ẹ̀kẹrin Balaamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ó bẹ̀rẹ̀ òwe:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.15",
            "verseOrgIds": [
              "NUM.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:15"
      },
      "items": [
        {
          "text": "\"Òwe Balaamu ọmọ Beori,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.15",
            "verseOrgIds": [
              "NUM.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:15"
      },
      "items": [
        {
          "text": "òwe ẹni tí ojú rẹ̀ ríran kedere,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.15",
            "verseOrgIds": [
              "NUM.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
