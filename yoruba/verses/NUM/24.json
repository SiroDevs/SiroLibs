      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:18"
      },
      "items": [
        {
          "text": "ṣùgbọ́n Israẹli yóò dàgbà nínú agbára.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.18",
            "verseOrgIds": [
              "NUM.24.18"
            ]
          }
        }
      ]
    },
    {
