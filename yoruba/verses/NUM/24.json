          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò borí Edomu;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.18",
            "verseOrgIds": [
              "NUM.24.18"
            ]
          }
