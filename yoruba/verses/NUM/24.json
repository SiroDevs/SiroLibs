          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ní ó rí ará Keni ó sì bẹ̀rẹ̀ òwe:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.21",
            "verseOrgIds": [
              "NUM.24.21"
            ]
          }
        }
      ]
    },
