      "attrs": {
        "style": "q2",
        "vid": "NUM 24:18"
      },
      "items": [
        {
          "text": "yóò ṣẹ́gun Seiri ọ̀tá rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.18",
            "verseOrgIds": [
              "NUM.24.18"
            ]
          }
        }
      ]
