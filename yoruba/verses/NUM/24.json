      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:17"
      },
      "items": [
        {
          "text": "yóò sì fọ́ agbárí gbogbo ọmọ Seti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.17",
            "verseOrgIds": [
              "NUM.24.17"
            ]
          }
        }
      ]
    },
    {
