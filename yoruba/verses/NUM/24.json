          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹni tó gbọ́ ọ̀rọ̀ Ọlọ́run ń wí,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.16",
            "verseOrgIds": [
              "NUM.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:16"
      },
      "items": [
        {
          "text": "tí ó sì mọ ìmọ̀ Ọ̀gá-ògo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.16",
            "verseOrgIds": [
              "NUM.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:16"
      },
      "items": [
        {
          "text": "tí ó ríran láti ọ̀dọ̀ Olódùmarè,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.16",
            "verseOrgIds": [
              "NUM.24.16"
            ]
          }
        }
      ]
    },
    {
