  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "NUM 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miriamu Àti Aaroni tako Mose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miriamu àti Aaroni sọ̀rọ̀-òdì sí Mose nítorí pé ó fẹ́ obìnrin ará Etiopia.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.1",
            "verseOrgIds": [
              "NUM.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì wí pé, \"Nípa Mose nìkan ni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.2",
            "verseOrgIds": [
              "NUM.12.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.2",
                "verseOrgIds": [
                  "NUM.12.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ̀rọ̀ bí, kò ha ti ipa wa sọ̀rọ̀ bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.2",
            "verseOrgIds": [
              "NUM.12.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.2",
                "verseOrgIds": [
                  "NUM.12.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sì gbọ́ èyí.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.2",
            "verseOrgIds": [
              "NUM.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Mose sì jẹ́ ọlọ́kàn tútù ju gbogbo ènìyàn tó wà lórí ilẹ̀ ayé lọ).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.3",
            "verseOrgIds": [
              "NUM.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́ẹ̀kan náà ni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.4",
            "verseOrgIds": [
              "NUM.12.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.4",
                "verseOrgIds": [
                  "NUM.12.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose, Aaroni àti Miriamu pé, \"Ẹ̀yin mẹ́tẹ̀ẹ̀ta, jáde wá sínú àgọ́ ìpàdé.\" Àwọn mẹ́tẹ̀ẹ̀ta sì jáde síta.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.4",
            "verseOrgIds": [
              "NUM.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.5",
            "verseOrgIds": [
              "NUM.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.5",
                "verseOrgIds": [
                  "NUM.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ̀kalẹ̀ nínú ọ̀wọ́n ìkùùkuu, ó sì dúró ní ẹnu-ọ̀nà àgọ́, ó ké sí Aaroni àti Miriamu. Àwọn méjèèjì sì bọ́ síwájú,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.5",
            "verseOrgIds": [
              "NUM.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó wí pé, \"Ẹ gbọ́ ọ̀rọ̀ mi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 12:6"
      },
      "items": [
        {
          "text": "\"Bí wòlíì",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.6",
                "verseOrgIds": [
                  "NUM.12.6"
                ]
              }
            }
          ]
        },
        {
          "text": "bá wà láàrín yín,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:6"
      },
      "items": [
        {
          "text": "Èmi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.6",
                "verseOrgIds": [
                  "NUM.12.6"
                ]
              }
            }
          ]
        },
        {
          "text": "a máa fi ara à mi hàn án ní ojúran,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:6"
      },
      "items": [
        {
          "text": "Èmi a máa bá a sọ̀rọ̀ nínú àlá.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èyí kò rí bẹ́ẹ̀ pẹ̀lú Mose ìránṣẹ́ mi;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.7",
            "verseOrgIds": [
              "NUM.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:7"
      },
      "items": [
        {
          "text": "ó jẹ́ olóòtítọ́ nínú gbogbo ilé mi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.7",
            "verseOrgIds": [
              "NUM.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sì ń bá a sọ̀rọ̀ ní ojúkojú,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "ọ̀rọ̀ yékéyéké tí kì í ṣe òwe,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "ó rí àwòrán",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.8",
                "verseOrgIds": [
                  "NUM.12.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "Kí ló wá dé tí ẹ̀yin kò ṣe bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "láti sọ̀rọ̀-òdì sí Mose ìránṣẹ́ mi?\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.9",
            "verseOrgIds": [
              "NUM.12.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.9",
                "verseOrgIds": [
                  "NUM.12.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ru sókè sí wọn",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.9",
            "verseOrgIds": [
              "NUM.12.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.9",
                "verseOrgIds": [
                  "NUM.12.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fi wọ́n sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.9",
            "verseOrgIds": [
              "NUM.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ìkùùkuu kúrò lórí àgọ́ lójijì ni Miriamu di adẹ́tẹ̀, ó funfun bí i yìnyín. Aaroni sì padà wo Miriamu ó sì rí i pé ó ti di adẹ́tẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.10",
            "verseOrgIds": [
              "NUM.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni sì wí fún Mose pé, \"Jọ̀wọ́ olúwa mi, má ṣe ka ẹ̀ṣẹ̀, èyí tí a fi ìwà òmùgọ̀ dá sí wa lọ́rùn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.11",
            "verseOrgIds": [
              "NUM.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe jẹ́ kí ó dàbí òkú ọmọ tí a bí, tí ìdajì ara rẹ̀ ti rà dànù.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.12",
            "verseOrgIds": [
              "NUM.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torí èyí Mose sì kígbe sí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.13",
            "verseOrgIds": [
              "NUM.12.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.13",
                "verseOrgIds": [
                  "NUM.12.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Ọlọ́run, jọ̀wọ́, mú un láradá!\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.13",
            "verseOrgIds": [
              "NUM.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.14",
                "verseOrgIds": [
                  "NUM.12.14"
                ]
              }
            }
          ]
        },
        {
          "text": "sì dá Mose lóhùn, \"Bí baba rẹ̀ bá tutọ́ sí i lójú, ojú kò wa ní í tì í fún ọjọ́ méje? Dá a dúró sí ẹ̀yìn ibùdó fún ọjọ́ méje, lẹ́yìn èyí ki a tó ó le mú wọlé.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.14",
            "verseOrgIds": [
              "NUM.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miriamu sì dúró sí ẹ̀yìn ibùdó fún ọjọ́ méje, àwọn ènìyàn kò sì tẹ̀síwájú nínú ìrìnàjò wọn títí tí Miriamu fi wọ inú ibùdó padà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.15",
            "verseOrgIds": [
              "NUM.12.15"
            ]
          }
        }
      ]
    },
    {
