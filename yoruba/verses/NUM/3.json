          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì kó owó ìràpadà yìí fún Aaroni àti àwọn ọmọ rẹ̀, bí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.51",
            "verseOrgIds": [
