              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, láti lè ra ọ̀rìnlúgba dín méje (273) àkọ́bí àwọn Israẹli tó ju iye àwọn ọmọ Lefi lọ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.46",
            "verseOrgIds": [
              "NUM.3.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 3:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìwọ yóò gba ṣékélì márùn-ún lórí ẹni kọ̀ọ̀kan gẹ́gẹ́ bí iye owó ibi mímọ́, èyí tí í ṣe ogún gera.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.47",
            "verseOrgIds": [
              "NUM.3.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
