        {
          "text": "Àwọn ọmọ Israẹli sì ṣe ohun gbogbo gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.54",
            "verseOrgIds": [
              "NUM.1.54"
