  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "NUM 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìlú fún àwọn ọmọ Lefi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lórí pẹ̀tẹ́lẹ̀ Moabu ní Jordani tí ó rékọjá láti Jeriko,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.1",
            "verseOrgIds": [
              "NUM.35.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.35.1",
                "verseOrgIds": [
                  "NUM.35.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.1",
            "verseOrgIds": [
              "NUM.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pàṣẹ fún àwọn ọmọ Israẹli láti fún àwọn Lefi ní ilẹ̀ láti gbé lára ogún tí àwọn ọmọ Israẹli yóò jogún. Kí ẹ sì fún wọn ní ilẹ̀ lára pápá oko tútù, káàkiri ìlú.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.2",
            "verseOrgIds": [
              "NUM.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, wọn yóò ní ìlú tí wọn yóò gbé àti ilẹ̀ pápá oko tútù fún ẹran ọ̀sìn, ọ̀wọ́ ẹran pẹ̀lú gbogbo ìní wọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.3",
            "verseOrgIds": [
              "NUM.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ilẹ̀ pápá oko tútù káàkiri ìlú tí ẹ ó fi fún àwọn ọmọ Lefi, wíwọ̀n rẹ̀ yóò jẹ́ ẹgbẹ̀rún ìgbọ̀nwọ́ (1,500 ẹsẹ̀ bàtà) láti ògiri ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.4",
            "verseOrgIds": [
              "NUM.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìlú náà, wọn ẹgbẹ̀rún méjì (2,000) ìgbọ̀nwọ́ lápá ibi ìhà ìlà-oòrùn, ẹgbẹ̀rún méjì (2,000) ẹsẹ̀ bàtà ní ìhà gúúsù, ẹgbẹ̀rún méjì (2,000) ní ìhà ìwọ̀-oòrùn àti ẹgbẹ̀rún méjì (2,000) ní ìhà àríwá, kí ìlú náà sì wà ní àárín. Wọn yóò ní agbègbè yìí gẹ́gẹ́ bí ilẹ̀ pápá oko tútù fún ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.5",
            "verseOrgIds": [
              "NUM.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìlú ààbò",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mẹ́fà lára ìlú tí ẹ fún àwọn ọmọ Lefi yóò jẹ́ ìlú ààbò, tí ẹni tí ó bá pa ènìyàn yóò sá sí. Ní àfikún, ẹ fún wọn ní méjìlélógójì ìlú sí i.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.6",
            "verseOrgIds": [
              "NUM.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní gbogbo rẹ̀, kí ẹ fún àwọn ọmọ Lefi ní méjìdínláàádọ́ta ìlú lápapọ̀ pẹ̀lú ilẹ̀ pápá oko tútù wọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.7",
            "verseOrgIds": [
              "NUM.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìlú tí ẹ fún àwọn ọmọ Lefi láti ara ilẹ̀ tí àwọn ọmọ Israẹli jogún, olúkúlùkù kí ó fi nínú ìlú rẹ̀ fún àwọn ọmọ Lefi gẹ́gẹ́ bí ilẹ̀ ìní rẹ̀ tí ó ní. Gba púpọ̀ lọ́wọ́ ẹ̀yà tí ó ní púpọ̀ àti díẹ̀ lọ́wọ́ ẹ̀yà tí ó ní díẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.8",
            "verseOrgIds": [
              "NUM.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.9",
            "verseOrgIds": [
              "NUM.35.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.35.9",
                "verseOrgIds": [
                  "NUM.35.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.9",
            "verseOrgIds": [
              "NUM.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ̀rọ̀ sí àwọn ọmọ Israẹli, kí o sì sọ fún wọn: 'Nígbà tí ẹ bá rékọjá odò Jordani sí Kenaani,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.10",
            "verseOrgIds": [
              "NUM.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "yan àwọn ìlú kan láti jẹ́ gẹ́gẹ́ bí ìlú ààbò fún yín, kí apani tó pa ènìyàn ní àìmọ̀ máa sálọ síbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.11",
            "verseOrgIds": [
              "NUM.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò jẹ́ ibi ìsásí kúrò lọ́wọ́ olùgbẹ̀san, kí ẹni tí a fi ẹ̀sùn ìpànìyàn kàn má ba à kú kí ó tó dúró níwájú àwọn ìjọ àwọn ènìyàn ní ìdájọ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.12",
            "verseOrgIds": [
              "NUM.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mẹ́fà nínú ìlú tí ẹ ó fi fún wọn yóò jẹ́ ìlú ààbò fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.13",
            "verseOrgIds": [
              "NUM.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yan ìlú mẹ́ta ní ìhà ti Jordani, kí ẹ sì yan ìlú mẹ́ta ní ìhà Kenaani tí yóò máa jẹ́ ìlú ìsásí.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.14",
            "verseOrgIds": [
              "NUM.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìlú mẹ́fà yìí yóò jẹ́ ìlú ìsásí fún àwọn ọmọ Israẹli, fún àjèjì àti ẹnikẹ́ni tí ó bá ń gbé láàrín wọn, kí ẹnikẹ́ni tí ó bá pa ènìyàn ní àìmọ̀ sálọ síbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.15",
            "verseOrgIds": [
              "NUM.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ọkùnrin kan bá fi ohun èlò irin lu ènìyàn tí ó kú, apànìyàn ni, pípa ni a ó pa, apànìyàn náà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.16",
            "verseOrgIds": [
              "NUM.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tàbí tí ènìyàn bá mú òkúta tí ó lè pa ènìyàn lọ́wọ́ tí ó sì fi lu ènìyàn, tí ó sì kú, apànìyàn ni, pípa ni a ó pa apànìyàn náà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.17",
            "verseOrgIds": [
              "NUM.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tàbí tí ènìyàn bá mú ohun èlò igi ní ọwọ́ rẹ̀ tí ó sì lẹ̀ ẹ́ pa ènìyàn, tí ó sì fi lu ènìyàn, tí ó sì kú, apànìyàn ni; pípa ní a ó pa apànìyàn náà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.18",
            "verseOrgIds": [
              "NUM.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olùgbẹ̀san ẹ̀jẹ̀ yóò pa apànìyàn náà; tí ó bá bá a, yóò pa á.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.19",
            "verseOrgIds": [
              "NUM.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí ẹnikẹ́ni tí ó bá ń yan odì pẹ̀lú ìríra tí ẹlòmíràn tàbí ju nǹkan sí i pẹ̀lú èrò, tí ó sì kú.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.20",
            "verseOrgIds": [
              "NUM.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tàbí pẹ̀lú ìjà gbangba lù ú pẹ̀lú ìkùùkuu tí ó sì kú, pípa ni a ó pa ẹni bẹ́ẹ̀; apànìyàn ni. Olùgbẹ̀san ẹ̀jẹ̀ yóò pa apànìyàn náà tí ó bá bá a.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.21",
            "verseOrgIds": [
              "NUM.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ṣùgbọ́n bí ó bá fi nǹkan gún un lójijì láìṣọ̀ta, tàbí tí ó sọ ohunkóhun lù ú láìmọ̀-ọ́n-mọ̀ ṣe",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.22",
            "verseOrgIds": [
              "NUM.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "tàbí, láìri, ju òkúta sí tí ó lè pa á, tí ó sì kú, nígbà tí kì í ṣe ọ̀tá rẹ̀, láti ṣe é léṣe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.23",
            "verseOrgIds": [
              "NUM.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àpéjọ gbọdọ̀ dájọ́ láàrín rẹ̀ àti olùgbẹ̀san ẹ̀jẹ̀ gẹ́gẹ́ bí ìlànà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.24",
            "verseOrgIds": [
              "NUM.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àpéjọ gbọdọ̀ dá ààbò bo ẹni tí a fi ẹ̀sùn ìpànìyàn kàn, kí a sì rán an padà lọ sí ìlú ìsásí tí ó ti wá. Ó gbọdọ̀ dúró níbẹ̀ títí di ìgbà tí olórí àlùfáà bá kú, ẹni tí a fi àmì òróró yàn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.25",
            "verseOrgIds": [
              "NUM.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ṣùgbọ́n ti ẹni tí a fi sùn kan bá jáde kọjá ààlà ìlú ìsásí tí ó sá sí.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.26",
            "verseOrgIds": [
              "NUM.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí olùgbẹ̀san ẹ̀jẹ̀ sì ri ní ìta ìlú náà, olùgbẹ̀san lè pa ẹni tí a fi ẹ̀sùn kàn láìjẹ̀bi ẹ̀sùn ìpànìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.27",
            "verseOrgIds": [
              "NUM.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí a fi ẹ̀sùn kàn gbọdọ̀ dúró nínú ìlú ìsásí títí di ìgbà tí olórí àlùfáà bá kú; lẹ́yìn ikú olórí àlùfáà, ni ó tó lè padà sí ibi tí dúkìá rẹ̀ wà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.28",
            "verseOrgIds": [
              "NUM.35.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Wọ̀nyí ni ó jẹ́ ìlànà ìdájọ́ fún yín ní ìran yín tó ń bọ̀, ní ibikíbi tí ẹ bá ń gbé.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.29",
            "verseOrgIds": [
              "NUM.35.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ẹnikẹ́ni tí ó bá pa ènìyàn gbọdọ̀ kú gẹ́gẹ́ bí apànìyàn lórí ìjẹ́rìí àwọn ènìyàn. Ṣùgbọ́n ẹlẹ́rìí kan ṣoṣo. Kì yóò jẹ́rìí sí ẹnìkan láti pa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.30",
            "verseOrgIds": [
              "NUM.35.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Má ṣe gba ohun ìràpadà fún ẹ̀mí apànìyàn, tí ó jẹ̀bi kí ó kú. Ṣùgbọ́n pípa ni kí a pa á.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.31",
            "verseOrgIds": [
              "NUM.35.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Má ṣe gba ìràsílẹ̀ fún ẹnikẹ́ni tí ó bá lọ sí ìlú ìsásí, pe kí ó padà máa gbé ní ilẹ̀ tirẹ̀ kí ó tó di ìgbà ikú olórí àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.32",
            "verseOrgIds": [
              "NUM.35.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Má ṣe sọ ilẹ̀ tí ẹ wà di àìmọ́. Ìtàjẹ̀ sílẹ̀ sọ ilẹ̀ náà di àìmọ́. Àtúnṣe kì yóò sí fún ilẹ̀ tí a ti ta ẹ̀jẹ̀ lé lórí, àyàfi ẹ̀jẹ̀ ẹni tí ó ta á sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.33",
            "verseOrgIds": [
              "NUM.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe sọ di àìmọ́, ilẹ̀ tí ẹ ń gbé, àti èyí tí mo ń gbé, nítorí Èmi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.34",
            "verseOrgIds": [
              "NUM.35.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.35.34",
                "verseOrgIds": [
                  "NUM.35.34"
                ]
              }
            }
          ]
        },
        {
          "text": "ń gbé láàrín àwọn ọmọ Israẹli.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.34",
            "verseOrgIds": [
              "NUM.35.34"
            ]
          }
        }
      ]
    }
