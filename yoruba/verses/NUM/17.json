          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ̀pá Aaroni rúwé",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.17.1",
                "verseOrgIds": [
                  "NUM.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.1",
            "verseOrgIds": [
              "NUM.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún àwọn ọmọ Israẹli kí o sì gba ọ̀pá méjìlá lọ́wọ́ wọn, ọ̀kọ̀ọ̀kan lọ́wọ́ olórí ìdílé ẹ̀yà ìran wọn, kọ orúkọ ènìyàn kọ̀ọ̀kan sí ara ọ̀pá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.2",
            "verseOrgIds": [
              "NUM.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lórí ọ̀pá Lefi kọ orúkọ Aaroni, nítorí ọ̀pá kọ̀ọ̀kan gbọdọ̀ wà fún olórí ìdílé kọ̀ọ̀kan tí yóò jẹ́ orí fún ẹ̀yà ìran kọ̀ọ̀kan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.3",
            "verseOrgIds": [
              "NUM.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kó wọn sí àgọ́ ìpàdé níwájú ẹ̀rí níbi tí èmi ti ń pàdé yín.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.4",
            "verseOrgIds": [
              "NUM.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀pá tí ó bá yí jẹ́ ti ẹni tí èmi bá yàn yóò rúwé, èmi yóò sì dá kíkùn gbogbo ìgbà àwọn ọmọ Israẹli sí yín dúró.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.5",
            "verseOrgIds": [
              "NUM.17.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Mose bá àwọn ọmọ Israẹli sọ̀rọ̀, àwọn olórí wọn sì fún un ní ọ̀pá méjìlá, ọ̀pá kan fún olórí kọ̀ọ̀kan ẹ̀yà ìran wọn, ọ̀pá Aaroni sì wà lára àwọn ọ̀pá náà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.6",
            "verseOrgIds": [
              "NUM.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì fi ọ̀pá wọ̀nyí lélẹ̀ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.7",
            "verseOrgIds": [
              "NUM.17.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.17.7",
                "verseOrgIds": [
                  "NUM.17.22"
                ]
              }
            }
          ]
        },
        {
          "text": "nínú àgọ́ ẹ̀rí.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.7",
            "verseOrgIds": [
              "NUM.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe ní ọjọ́ kejì Mose wọ inú àgọ́ ẹ̀rí lọ, ó sì rí ọ̀pá Aaroni, tí ó dúró fún ẹ̀yà Lefi, kì í ṣe wí pé ó hù nìkan, ṣùgbọ́n ó rúwé, ó yọ ìtànná, ó sì so èso almondi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.8",
            "verseOrgIds": [
              "NUM.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose kó gbogbo àwọn ọ̀pá jáde láti iwájú",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.9",
            "verseOrgIds": [
              "NUM.17.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.17.9",
                "verseOrgIds": [
                  "NUM.17.24"
                ]
              }
            }
          ]
        },
        {
          "text": "wá fún àwọn ọmọ Israẹli. Wọ́n wò wọ́n, ẹnìkọ̀ọ̀kan sì mú ọ̀pá tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.9",
            "verseOrgIds": [
              "NUM.17.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.17.10",
                "verseOrgIds": [
                  "NUM.17.25"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Mú ọ̀pá Aaroni padà wá síwájú ẹ̀rí, láti fi pamọ́ gẹ́gẹ́ bí àmì fún àwọn ọlọ̀tẹ̀. Èyí ó sì mú òpin bá kíkùn sínú wọn sí mi, kí wọn kí ó má ba à kú.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.10",
            "verseOrgIds": [
              "NUM.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì ṣe gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.17.11",
                "verseOrgIds": [
                  "NUM.17.26"
                ]
              }
            }
          ]
        },
        {
          "text": "ti páláṣẹ fún un.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli sọ fún Mose pé, \"Àwa yóò kú! A ti sọnù, gbogbo wa ti sọnù!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.12",
            "verseOrgIds": [
              "NUM.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó bá súnmọ́ tabanaku",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.13",
            "verseOrgIds": [
              "NUM.17.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.17.13",
                "verseOrgIds": [
                  "NUM.17.28"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò kú. Ṣé gbogbo wa ni yóò kú?\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.13",
            "verseOrgIds": [
              "NUM.17.28"
            ]
          }
        }
      ]
    }
  ],
