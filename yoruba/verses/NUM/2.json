              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ìpín rẹ̀ jẹ́ ẹgbàá mẹ́rìndínlógún ó lé egbèje (53,400).",
          "type": "text",
          "attrs": {
