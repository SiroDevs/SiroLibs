          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n a kò ka àwọn ọmọ Lefi papọ̀ mọ́ àwọn Israẹli gẹ́gẹ́ bí",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "ti pa á láṣẹ fún Mose.",
          "type": "text"
        }
      ]
