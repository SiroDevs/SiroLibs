              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ìpín rẹ̀ jẹ́ ọ̀kẹ́ méjì ó lé ẹ̀ẹ́dẹ́gbẹ̀jọ (41,500).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.28",
