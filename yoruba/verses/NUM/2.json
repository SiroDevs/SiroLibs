              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yà Aṣeri ni yóò pa ibùdó tẹ̀lé wọn. Olórí Aṣeri ni Pagieli ọmọ Okanri.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.27",
