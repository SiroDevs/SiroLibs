              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli ṣe gbogbo ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.34",
            "verseOrgIds": [
              "NUM.2.34"
