          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìkùùkuu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
              "NUM.10.34"
            ]
          }
        },
