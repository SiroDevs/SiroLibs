                "verseId": "NUM.10.33",
                "verseOrgIds": [
                  "NUM.10.33"
                ]
              }
            }
          ]
        },
        {
          "text": "ní ìrìn ọjọ́ mẹ́ta. Àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
