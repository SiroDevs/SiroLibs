                "verseId": "NUM.10.33",
                "verseOrgIds": [
                  "NUM.10.33"
                ]
              }
            }
          ]
        },
        {
          "text": "ń lọ níwájú wọn fún gbogbo ọjọ́ mẹ́ta yìí láti wá ibi ìsinmi fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
