                "verseOrgIds": [
                  "NUM.10.34"
                ]
              }
            }
          ]
        },
        {
          "text": "wà lórí wọn lọ́sàn nígbà tí wọ́n gbéra kúrò ní ibùdó.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
