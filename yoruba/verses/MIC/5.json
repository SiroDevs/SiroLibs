      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:8"
      },
      "items": [
        {
          "text": "bí i ọmọ kìnnìún láàrín agbo àgùntàn,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        }
      ]
