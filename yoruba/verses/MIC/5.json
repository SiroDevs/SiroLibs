  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "MIC 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àsọtẹ́lẹ̀ nípa Olùgbàlà láti Bẹtilẹhẹmu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, kó àwọn ọ̀wọ́ ogun rẹ jọ,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:1"
      },
      "items": [
        {
          "text": "ìwọ ìlú ti o ni ọmọ-ogun,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:1"
      },
      "items": [
        {
          "text": "nítorí ó ti fi gbógun dó tì wá.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:1"
      },
      "items": [
        {
          "text": "Wọn yóò fi ọ̀pá lu àwọn alákòóso Israẹli ní ẹ̀rẹ̀kẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n ìwọ, Bẹtilẹhẹmu Efrata,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "bí ìwọ ti jẹ́ kékeré láàrín àwọn ẹ̀yà Juda,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "nínú rẹ ni ẹni tí yóò jẹ́ olórí ní Israẹli",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "yóò ti jáde tọ̀ mí wá,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "ìjáde lọ rẹ̀ sì jẹ́ láti ìgbà àtijọ́,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "láti ìgbà láéláé.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà Israẹli yóò di kíkọ̀sílẹ̀ pátápátá",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:3"
      },
      "items": [
        {
          "text": "títí di àkókò tí ẹni tí ń rọbí yóò fi bí,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:3"
      },
      "items": [
        {
          "text": "àti àwọn ìyókù arákùnrin rẹ̀ yóò fi padà",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:3"
      },
      "items": [
        {
          "text": "láti darapọ̀ mọ́ àwọn Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun yóò sì dúró,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:4"
      },
      "items": [
        {
          "text": "yóò sì máa ṣe olùṣọ́-àgùntàn àwọn agbo ẹran rẹ̀ ní agbára",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MIC.5.4",
                "verseOrgIds": [
                  "MIC.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:4"
      },
      "items": [
        {
          "text": "ní ọláńlá orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MIC.5.4",
                "verseOrgIds": [
                  "MIC.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:4"
      },
      "items": [
        {
          "text": "Wọn yóò sì wà láìléwu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:4"
      },
      "items": [
        {
          "text": "nítorí nísinsin yìí ni títóbi rẹ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:4"
      },
      "items": [
        {
          "text": "yóò sì dé òpin ayé.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìgbàlà àti ìparun",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun yóò sì jẹ́ àlàáfíà wọn.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:5"
      },
      "items": [
        {
          "text": "Nígbà tí àwọn Asiria bá gbógun sí ilẹ̀ wa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:5"
      },
      "items": [
        {
          "text": "tí wọ́n sì ń yan lórí odi alágbára wa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:5"
      },
      "items": [
        {
          "text": "nígbà náà ni a ó gbé olùṣọ́-àgùntàn méje dìde sí i,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:5"
      },
      "items": [
        {
          "text": "àti olórí ènìyàn mẹ́jọ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò sì fi idà pa ilẹ̀ Asiria run,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:6"
      },
      "items": [
        {
          "text": "àti ilẹ̀ Nimrodu pẹ̀lú idà tí a fà.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:6"
      },
      "items": [
        {
          "text": "Òun yóò sì gbà wá sílẹ̀ lọ́wọ́ àwọn ará Asiria",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:6"
      },
      "items": [
        {
          "text": "nígbà tí wọn bá gbógun ti ilẹ̀ wa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:6"
      },
      "items": [
        {
          "text": "tí wọ́n sì tún yan wọ ẹnu-bodè wa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyókù Jakọbu yóò sì wà",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "láàrín ọ̀pọ̀lọpọ̀ ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "bí ìrì láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MIC.5.7",
                "verseOrgIds": [
                  "MIC.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": "wa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "bí ọ̀wààrà òjò lórí koríko,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "tí kò gbẹ́kẹ̀lé ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "tàbí kò dúró de àwọn ọmọ ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
