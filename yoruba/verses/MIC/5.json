      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:8"
      },
      "items": [
        {
          "text": "bí i kìnnìún láàrín àwọn ẹranko inú igbó,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        }
      ]
