          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MIC 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò lá erùpẹ̀ bí ejò,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:17"
      },
      "items": [
        {
          "text": "wọn yóò sì jáde kúrò nínú ihò wọn bí ekòló.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:17"
      },
      "items": [
        {
          "text": "Wọn yóò bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MIC.7.17",
                "verseOrgIds": [
                  "MIC.7.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:17"
      },
      "items": [
        {
          "text": "wọn yóò sì bẹ̀rù nítorí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MIC 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni Ọlọ́run bí rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.18",
            "verseOrgIds": [
              "MIC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:18"
      },
      "items": [
        {
          "text": "ẹni tí ó dárí ẹ̀ṣẹ̀ jì,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.18",
            "verseOrgIds": [
              "MIC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:18"
      },
      "items": [
        {
          "text": "tí ó sì fojú fo ìrékọjá èyí tókù ìní rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.18",
            "verseOrgIds": [
              "MIC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:18"
      },
      "items": [
        {
          "text": "Kì í dúró nínú ìbínú rẹ̀ láéláé",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.18",
            "verseOrgIds": [
              "MIC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:18"
      },
      "items": [
        {
          "text": "nítorí òun ní inú dídùn sí àánú.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.18",
            "verseOrgIds": [
              "MIC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MIC 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun yóò tún padà yọ́nú sí wa;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.19",
