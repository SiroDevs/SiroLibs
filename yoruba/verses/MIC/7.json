      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:14"
      },
      "items": [
        {
          "text": "bí ọjọ́ ìgbàanì.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
