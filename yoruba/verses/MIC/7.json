          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ náà yóò di ahoro fún àwọn olùgbé inú rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.13",
            "verseOrgIds": [
              "MIC.7.13"
            ]
          }
        }
      ]
    },
