      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:14"
      },
      "items": [
        {
          "text": "èyí tí ó ń dágbé nínú igbó",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        }
      ]
    },
