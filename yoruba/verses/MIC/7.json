      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:12"
      },
      "items": [
        {
          "text": "láti Òkun dé Òkun",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.12",
            "verseOrgIds": [
              "MIC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:12"
      },
      "items": [
        {
          "text": "àti láti òkè ńlá dé òkè ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.12",
            "verseOrgIds": [
              "MIC.7.12"
            ]
          }
        }
      ]
    },
    {
