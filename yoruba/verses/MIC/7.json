      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:16"
      },
      "items": [
        {
          "text": "nínú gbogbo agbára wọn.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.16",
            "verseOrgIds": [
              "MIC.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:16"
      },
      "items": [
        {
          "text": "Wọn yóò fi ọwọ́ lé ẹnu wọn,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.16",
            "verseOrgIds": [
              "MIC.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:16"
      },
      "items": [
        {
          "text": "etí wọn yóò sì di.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.16",
            "verseOrgIds": [
              "MIC.7.16"
            ]
          }
        }
      ]
    },
    {
