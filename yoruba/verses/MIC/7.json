          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fi ọ̀pá rẹ bọ́ àwọn ènìyàn, agbo ẹran ìní rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        }
      ]
    },
