      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:15"
      },
      "items": [
        {
          "text": "ni èmi yóò fi ohun ìyanu hàn án.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.15",
            "verseOrgIds": [
              "MIC.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
