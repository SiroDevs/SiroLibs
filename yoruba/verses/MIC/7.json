      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:13"
      },
      "items": [
        {
          "text": "nítorí èso ìwà wọn.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.13",
            "verseOrgIds": [
              "MIC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àdúrà àti ìyìn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
