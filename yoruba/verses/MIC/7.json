      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:10"
      },
      "items": [
        {
          "text": "nísinsin yìí ni yóò di ìtẹ̀mọ́lẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
