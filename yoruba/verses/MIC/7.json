      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:12"
      },
      "items": [
        {
          "text": "láti Asiria àti ìlú ńlá Ejibiti",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.12",
            "verseOrgIds": [
              "MIC.7.12"
            ]
          }
        }
      ]
    },
    {
