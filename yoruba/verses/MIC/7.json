      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:10"
      },
      "items": [
        {
          "text": "Ojú mi yóò rí ìṣubú rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
