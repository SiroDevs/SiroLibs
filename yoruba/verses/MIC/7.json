          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà àwọn ènìyàn yóò wá sọ́dọ̀ rẹ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.12",
            "verseOrgIds": [
