  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "HOS 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israẹli yípadà kúrò ní ọnà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Fi ìpè sí ẹnu rẹ!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:1"
      },
      "items": [
        {
          "text": "Ẹyẹ idì wà lórí ilé",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.8.1",
                "verseOrgIds": [
                  "HOS.8.1"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:1"
      },
      "items": [
        {
          "text": "nítorí pé àwọn ènìyàn ti dalẹ̀ májẹ̀mú,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:1"
      },
      "items": [
        {
          "text": "wọ́n sì ti ṣọ̀tẹ̀ sí òfin mi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israẹli kígbe pè mí,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.2",
            "verseOrgIds": [
              "HOS.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:2"
      },
      "items": [
        {
          "text": "'Ọlọ́run wa, àwa mọ̀ ọ́n!'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.2",
            "verseOrgIds": [
              "HOS.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Israẹli ti kọ ohun tí ó dára sílẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.3",
            "verseOrgIds": [
              "HOS.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:3"
      },
      "items": [
        {
          "text": "ọ̀tá yóò sì máa lépa rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.3",
            "verseOrgIds": [
              "HOS.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n fi àwọn ọba jẹ ṣùgbọ́n, kì í ṣe nípasẹ̀ mi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "wọ́n yan ọmọ-aládé láì si ìmọ̀ mi níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "Wọ́n fi fàdákà àti wúrà",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "ṣe ère fún ara wọn,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "si ìparun ara wọn.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ju ère ẹgbọrọ màlúù rẹ, ìwọ Samaria!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.5",
            "verseOrgIds": [
              "HOS.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:5"
      },
      "items": [
        {
          "text": "Ìbínú mi ń ru sí wọn:",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.5",
            "verseOrgIds": [
              "HOS.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:5"
      },
      "items": [
        {
          "text": "yóò ti pẹ́ tó kí wọ́n tó dé ipò àìmọ̀kan?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.5",
            "verseOrgIds": [
              "HOS.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israẹli ni wọ́n ti wá!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:6"
      },
      "items": [
        {
          "text": "Ère yìí agbẹ́gilére ló ṣe é,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:6"
      },
      "items": [
        {
          "text": "àní ère ẹgbọrọ màlúù Samaria, ni a ó fọ́ túútúú.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wọ́n gbin afẹ́fẹ́",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "wọ́n sì ká ìjì.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "Igi ọkà kò lórí,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "kò sì ní mú oúnjẹ wá.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "Bí ó bá tilẹ̀ ní ọkà",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "àwọn àjèjì ni yóò jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ti gbé Israẹli mì,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.8",
            "verseOrgIds": [
              "HOS.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:8"
      },
      "items": [
        {
          "text": "báyìí, ó sì ti wà láàrín àwọn orílẹ̀-èdè",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.8",
            "verseOrgIds": [
              "HOS.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:8"
      },
      "items": [
        {
          "text": "bí ohun èlò tí kò wúlò.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.8",
            "verseOrgIds": [
              "HOS.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé wọ́n ti gòkè lọ sí Asiria",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.9",
            "verseOrgIds": [
              "HOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:9"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí kẹ́tẹ́kẹ́tẹ́ igbó tó ń rìn kiri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.9",
            "verseOrgIds": [
              "HOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:9"
      },
      "items": [
        {
          "text": "Efraimu ti ta ara rẹ̀ fún àwọn olólùfẹ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.9",
            "verseOrgIds": [
              "HOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó tilẹ̀ jẹ́ pé wọ́n ti ta ara wọn sí àárín Orílẹ̀-èdè,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:10"
      },
      "items": [
        {
          "text": "Èmi ó ṣà wọ́n jọ nísinsin yìí.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:10"
      },
      "items": [
        {
          "text": "Wọn ó sì bẹ̀rẹ̀ sí í ṣòfò dànù",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:10"
      },
      "items": [
        {
          "text": "lọ́wọ́ ìnilára ọba alágbára.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí Efraimu ti kọ́ pẹpẹ púpọ̀ fún ìrúbọ ẹ̀ṣẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.11",
            "verseOrgIds": [
              "HOS.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:11"
      },
      "items": [
        {
          "text": "gbogbo rẹ̀ ti di pẹpẹ ìdẹ́ṣẹ̀ fún un",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.11",
            "verseOrgIds": [
              "HOS.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 8:12"
          },
          "items": [
            {
