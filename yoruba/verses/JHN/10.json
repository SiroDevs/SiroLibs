  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JHN 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agbo kan àti olùṣọ́-àgùntàn kan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lóòótọ́, lóòótọ́ ni mo wí fún yín, ẹni tí kò bá gba ẹnu-ọ̀nà wọ inú agbo àgùntàn, ṣùgbọ́n tí ó bá gba ibòmíràn gun òkè, òun náà ni olè àti ọlọ́ṣà.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.1",
                "verseOrgIds": [
                  "JHN.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.1",
            "verseOrgIds": [
              "JHN.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n ẹni tí ó bá ti ẹnu-ọ̀nà wọlé, Òun ni olùṣọ́ àwọn àgùntàn.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.2",
                "verseOrgIds": [
                  "JHN.10.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.2",
            "verseOrgIds": [
              "JHN.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Òun ni aṣọ́nà yóò ṣílẹ̀kùn fún; àwọn àgùntàn gbọ́ ohùn rẹ̀, ó sì pe àwọn àgùntàn tirẹ̀ lórúkọ, ó sì ṣe amọ̀nà wọn jáde.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.3",
                "verseOrgIds": [
                  "JHN.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.3",
            "verseOrgIds": [
              "JHN.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà tí ó bá sì ti mú àwọn àgùntàn tirẹ̀ jáde, yóò síwájú wọn, àwọn àgùntàn yóò sì máa tọ̀ ọ́ lẹ́yìn, nítorí tí wọ́n mọ ohùn rẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.4",
                "verseOrgIds": [
                  "JHN.10.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.4",
            "verseOrgIds": [
              "JHN.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wọn kò jẹ́ tọ àlejò lẹ́yìn, ṣùgbọ́n wọn a sá kúrò lọ́dọ̀ rẹ̀, nítorí tí wọn kò mọ ohùn àlejò.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.5",
                "verseOrgIds": [
                  "JHN.10.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.5",
            "verseOrgIds": [
              "JHN.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òwe yìí ni Jesu pa fún wọn, ṣùgbọ́n òye ohun tí nǹkan wọ̀nyí tí ó ń sọ fún wọn kò yé wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.6",
            "verseOrgIds": [
              "JHN.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà Jesu tún wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.7",
            "verseOrgIds": [
              "JHN.10.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lóòótọ́, lóòótọ́ ni mo wí fún yín, Èmi ni ìlẹ̀kùn àwọn àgùntàn.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.7",
                "verseOrgIds": [
                  "JHN.10.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.7",
            "verseOrgIds": [
              "JHN.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Olè àti ọlọ́ṣà ni gbogbo àwọn tí ó ti wà ṣáájú mi, ṣùgbọ́n àwọn àgùntàn kò gbọ́ tiwọn.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.8",
                "verseOrgIds": [
                  "JHN.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.8",
            "verseOrgIds": [
              "JHN.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi ni ìlẹ̀kùn, bí ẹnìkan bá bá ọ̀dọ̀ mi wọlé, òun ni a ó gbàlà, yóò wọlé, yóò sì jáde, yóò sì rí koríko.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.9",
                "verseOrgIds": [
                  "JHN.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.9",
            "verseOrgIds": [
              "JHN.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Olè kì í wá bí kò ṣe láti jalè, láti pa, àti láti parun; èmi wá kí wọn lè ní ìyè, àní kí wọn lè ní i lọ́pọ̀lọ́pọ̀.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.10",
                "verseOrgIds": [
                  "JHN.10.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èmi ni olùṣọ́-àgùntàn rere, olùṣọ́-àgùntàn rere fi ọkàn rẹ̀ lélẹ̀ nítorí àwọn àgùntàn.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.11",
                "verseOrgIds": [
                  "JHN.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.11",
            "verseOrgIds": [
              "JHN.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n alágbàṣe, tí kì í ṣe olùṣọ́-àgùntàn, ẹni tí àwọn àgùntàn kì í ṣe tirẹ̀, ó rí ìkookò ń bọ̀, ó sì fi àgùntàn sílẹ̀, ó sì fọ́n wọn ká kiri.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.12",
                "verseOrgIds": [
                  "JHN.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.12",
            "verseOrgIds": [
              "JHN.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Òun sálọ nítorí tí ó jẹ́ alágbàṣe, kò sì náání àwọn àgùntàn.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.13",
                "verseOrgIds": [
                  "JHN.10.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èmi ni olùṣọ́-àgùntàn rere, mo sì mọ àwọn tèmi, àwọn tèmi sì mọ̀ mí.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.14",
                "verseOrgIds": [
                  "JHN.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.14",
            "verseOrgIds": [
              "JHN.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gẹ́gẹ́ bí Baba ti mọ̀ mí, tí èmi sì mọ Baba, mo sì fi ọkàn mi lélẹ̀ nítorí àwọn àgùntàn.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.15",
                "verseOrgIds": [
                  "JHN.10.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.15",
            "verseOrgIds": [
              "JHN.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi sì ní àwọn àgùntàn mìíràn, tí kì í ṣe agbo yìí: àwọn ni èmi yóò mú wá pẹ̀lú, wọn yóò sì gbọ́ ohùn mi; wọn ó sì jẹ́ agbo kan, olùṣọ́-àgùntàn kan.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.16",
                "verseOrgIds": [
                  "JHN.10.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.16",
            "verseOrgIds": [
              "JHN.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí náà ni Baba mi ṣe fẹ́ràn mi, nítorí tí mo fi ẹ̀mí mi lélẹ̀, kí èmi lè tún gbà á.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.17",
                "verseOrgIds": [
                  "JHN.10.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.17",
            "verseOrgIds": [
              "JHN.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹnìkan kò gbà á lọ́wọ́ mi, ṣùgbọ́n mo fi í lélẹ̀, mo sì lágbára láti tún gbà á. Àṣẹ yìí ni mo ti gbà wá láti ọ̀dọ̀ Baba mi.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.18",
                "verseOrgIds": [
                  "JHN.10.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ìyapa tún wà láàrín àwọn Júù nítorí ọ̀rọ̀ wọ̀nyí.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.19",
            "verseOrgIds": [
              "JHN.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀pọ̀ nínú wọn sì wí pé, \"Ó ní ẹ̀mí èṣù, orí rẹ̀ sì dàrú; èéṣe tí ẹ̀yin fi ń gbọ́rọ̀ rẹ̀?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.20",
            "verseOrgIds": [
              "JHN.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn mìíràn wí pé, \"Ìwọ̀nyí kì í ṣe ọ̀rọ̀ ẹni tí ó ní ẹ̀mí èṣù. Ẹ̀mí èṣù lè la ojú àwọn afọ́jú bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.21",
            "verseOrgIds": [
              "JHN.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àìgbàgbọ́ àwọn Júù",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àkókò náà sì jẹ́ àjọ̀dún ìyàsímímọ́ ní Jerusalẹmu, ni ìgbà òtútù.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.22",
            "verseOrgIds": [
              "JHN.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu sì ń rìn ní tẹmpili, ní ìloro Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.23",
            "verseOrgIds": [
              "JHN.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà àwọn Júù wá dúró yí i ká, wọ́n sì wí fún un pé, \"Ìwọ ó ti mú wa ṣe iyèméjì pẹ́ tó? Bí ìwọ bá ni Kristi náà, wí fún wa gbangba.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.24",
            "verseOrgIds": [
              "JHN.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dá wọn lóhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.25",
            "verseOrgIds": [
              "JHN.10.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èmi ti wí fún yín, ẹ̀yin kò sì gbàgbọ́; iṣẹ́ tí èmi ń ṣe lórúkọ Baba mi, àwọn ni ó ń jẹ́rìí mi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.25",
                "verseOrgIds": [
                  "JHN.10.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.25",
            "verseOrgIds": [
              "JHN.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n ẹ̀yin kò gbàgbọ́, nítorí ẹ̀yin kò sí nínú àwọn àgùntàn mi, gẹ́gẹ́ bí mo tí wí fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.26",
                "verseOrgIds": [
                  "JHN.10.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.26",
            "verseOrgIds": [
              "JHN.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Àwọn àgùntàn mi ń gbọ́ ohùn mi, èmi sì mọ̀ wọ́n, wọn a sì máa tọ̀ mí lẹ́yìn.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.27",
                "verseOrgIds": [
                  "JHN.10.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.27",
            "verseOrgIds": [
              "JHN.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi sì fún wọn ní ìyè àìnípẹ̀kun; wọn kì yóò sì ṣègbé láéláé, kò sí ẹni tí ó lè já wọn gbà kúrò lọ́wọ́ mi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.28",
                "verseOrgIds": [
                  "JHN.10.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.28",
            "verseOrgIds": [
              "JHN.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Baba mi, ẹni tí ó fi wọ́n fún mi pọ̀ ju gbogbo wọn lọ; kò sì ṣí ẹni tí ó lè já wọn gbà kúrò lọ́wọ́ Baba mi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.29",
                "verseOrgIds": [
                  "JHN.10.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.29",
            "verseOrgIds": [
              "JHN.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ̀kan ni èmi àti Baba mi.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.30",
                "verseOrgIds": [
                  "JHN.10.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn Júù sì tún mú òkúta, láti sọ lù ú.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.31",
            "verseOrgIds": [
              "JHN.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dá wọn lóhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.32",
            "verseOrgIds": [
              "JHN.10.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ̀pọ̀lọpọ̀ iṣẹ́ rere ni mo fihàn yín láti ọ̀dọ̀ Baba mi wá, nítorí èwo nínú iṣẹ́ wọ̀nyí ni ẹ̀yin ṣe sọ mí ní òkúta?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.32",
                "verseOrgIds": [
                  "JHN.10.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn Júù sì dá a lóhùn pé, \"Àwa kò sọ ọ́ lókùúta nítorí iṣẹ́ rere, ṣùgbọ́n nítorí ọ̀rọ̀-òdì, àti nítorí ìwọ tí í ṣe ènìyàn ń fi ara rẹ pe Ọlọ́run.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.33",
            "verseOrgIds": [
              "JHN.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dá wọn lóhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.34",
            "verseOrgIds": [
              "JHN.10.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"A kò ha tí kọ ọ́ nínú òfin yín pé, 'Mo ti wí pé, Ọlọ́run ni ẹ̀yin jẹ́'?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.34",
                "verseOrgIds": [
                  "JHN.10.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.34",
            "verseOrgIds": [
              "JHN.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bí ó bá pè wọ́n ní 'ọlọ́run,' àwọn ẹni tí a fi ọ̀rọ̀ Ọlọ́run fún, a kò sì lè ba ìwé mímọ́ jẹ́.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.35",
                "verseOrgIds": [
                  "JHN.10.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.35",
            "verseOrgIds": [
              "JHN.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kín ni ẹyin ha ń wí ní ti ẹni tí Baba yà sọ́tọ̀, tí ó sì rán sí ayé kín lo de ti ẹ fi ẹ̀sùn kàn mi pé mò ń sọ̀rọ̀-òdì nítorí pé mo sọ pé, 'Èmi ni Ọmọ Ọlọ́run.'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.36",
                "verseOrgIds": [
                  "JHN.10.36"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.36",
            "verseOrgIds": [
              "JHN.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bí èmi kò bá ṣe iṣẹ́ Baba mi, ẹ má ṣe gbà mí gbọ́.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.37",
                "verseOrgIds": [
                  "JHN.10.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.37",
            "verseOrgIds": [
              "JHN.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n bí èmi bá ṣe wọ́n, bí ẹ̀yin kò tilẹ̀ gbà mí gbọ́, ẹ gbà iṣẹ́ náà gbọ́, kí ẹ̀yin ba à lè mọ̀, kí ó sì lè yé yín pé, Baba wà nínú mi, èmi sì wà nínú rẹ̀.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.10.38",
                "verseOrgIds": [
                  "JHN.10.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.38",
            "verseOrgIds": [
              "JHN.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì tún ń wá ọ̀nà láti mú un: ó sì bọ́ lọ́wọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.39",
            "verseOrgIds": [
              "JHN.10.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tún kọjá lọ sí apá kejì Jordani sí ibi tí Johanu ti kọ́kọ́ ń bamitiisi; níbẹ̀ ni ó sì jókòó.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.40",
            "verseOrgIds": [
              "JHN.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn púpọ̀ sì wá sọ́dọ̀ rẹ̀, wọ́n sì wí pé, \"Johanu kò ṣe iṣẹ́ àmì kan, Ṣùgbọ́n òtítọ́ ni ohun gbogbo tí Johanu sọ nípa ti ọkùnrin yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.41",
            "verseOrgIds": [
              "JHN.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn púpọ̀ níbẹ̀ sì gbà á gbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.42",
            "verseOrgIds": [
              "JHN.10.42"
            ]
          }
        }
      ]
    }
  ],
