  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "DAN 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daniẹli nínú ihò kìnnìún",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó dára lójú Dariusi láti yan ọgọ́fà àwọn baálẹ̀ sórí ìjọba,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.1",
            "verseOrgIds": [
              "DAN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "pẹ̀lú alákòóso mẹ́ta, Daniẹli sì jẹ́ ọ̀kan nínú wọn, kí àwọn baálẹ̀ lè wá máa jẹ́ ààbọ̀ fún wọn, kí ọba má ba à ní ìpalára.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.2",
            "verseOrgIds": [
              "DAN.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daniẹli ya ara rẹ̀ sọ́tọ̀ láàrín àwọn alákòóso àti àwọn baálẹ̀ nítorí ẹ̀mí tí ó tayọ wà lára rẹ̀ dé bi pé ọba sì ń gbèrò láti fi ṣe olórí i gbogbo ìjọba.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.3",
            "verseOrgIds": [
              "DAN.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èyí, gbogbo àwọn alákòóso àti àwọn baálẹ̀ ń gbèrò láti wá ẹ̀ṣẹ̀ kà sí Daniẹli lọ́rùn nínú ètò ìṣèjọba rẹ̀, ṣùgbọ́n wọn kò rí ẹ̀ṣẹ̀ kankan kà sí i lọ́rùn, wọn kò rí ìwà ìbàjẹ́ kankan tí ó ṣe, nítorí ó jẹ́ olóòtítọ́ kò sì ní ìwà ìjáfara.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.4",
            "verseOrgIds": [
              "DAN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbẹ̀yìn ni àwọn ọkùnrin wọ̀nyí sọ wí pé, \"Àwa kò ní rí ìdí kankan láti kà ẹ̀ṣẹ̀ sí Daniẹli lọ́rùn, àfi èyí tí ó bá ní í ṣe pẹ̀lú òfin Ọlọ́run rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.5",
            "verseOrgIds": [
              "DAN.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn alákòóso àti àwọn baálẹ̀ lọ gẹ́gẹ́ bí ikọ̀ sí ọ̀dọ̀ ọba, wọ́n wí pé, \"Ìwọ Dariusi ọba, kí o pẹ́!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.6",
            "verseOrgIds": [
              "DAN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn alákòóso ọba, ìjòyè, baálẹ̀, olùdámọ̀ràn, àti àwọn olórí gbìmọ̀ pọ̀ wí pé kí ọba kéde òfin kan pé ẹnikẹ́ni tí ó bá gba àdúrà sí Ọlọ́run tàbí ènìyàn kankan fún ọgbọ̀n ọjọ́, yàtọ̀ fún ìwọ ọba, a ó ju ẹni náà sí inú ihò kìnnìún.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.7",
            "verseOrgIds": [
              "DAN.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, ìwọ ọba, gbé òfin yìí jáde, kí o sì kọ ọ́ sínú ìwé kí a má ba à yí i padà ní ìbámu pẹ̀lú òfin àwọn Media àti Persia, èyí tí kò ní le è parẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.8",
            "verseOrgIds": [
              "DAN.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, ni Dariusi ọba fi ọwọ́ sí ìwé àṣẹ náà.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.9",
            "verseOrgIds": [
              "DAN.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lóòótọ́, Daniẹli mọ̀ pé a ti fi ọwọ́ sí ìwé òfin náà, síbẹ̀ ó wọ ilé e rẹ̀ lọ, nínú yàrá òkè, ó ṣí fèrèsé èyí tí ó kọjú sí Jerusalẹmu sílẹ̀. Ó kúnlẹ̀ lórí orúnkún un rẹ̀ ní ẹ̀ẹ̀mẹ́ta lójoojúmọ́, ó gbàdúrà, ó fi ọpẹ́ fún Ọlọ́run gẹ́gẹ́ bí ìṣe rẹ̀ tẹ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.10",
            "verseOrgIds": [
              "DAN.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni, àwọn ọlọ̀tẹ̀ yìí kó ara wọn jọ, wọ́n sì rí Daniẹli tí ó ń gba àdúrà, ó sì ń bẹ̀bẹ̀ fún àánú lọ́dọ̀ Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.11",
            "verseOrgIds": [
              "DAN.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n lọ sí iwájú ọba, wọ́n sì rán ọba létí nípa òfin tí ó ṣe pé, \"Ìwọ kò ha fi ọwọ́ sí òfin wí pé ní ìwọ̀n ọgbọ̀n ọjọ́ ẹnikẹ́ni tí ó bá gba àdúrà sí Ọlọ́run tàbí ènìyàn, láì bá ṣe ìwọ ọba, a ó gbé e jù sínú ihò kìnnìún?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.12",
            "verseOrgIds": [
              "DAN.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DAN 6:12"
      },
      "items": [
        {
          "text": "Ọba sì dáhùn pé, \"Àṣẹ náà dúró síbẹ̀, ní ìbámu pẹ̀lú òfin àwọn ará Media àti Persia, èyí tí a kò le è parẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.12",
            "verseOrgIds": [
              "DAN.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, ni wọ́n sọ fún ọba pé, \"Daniẹli, ọ̀kan lára ìgbèkùn Juda, kò ka ìwọ ọba sí, tàbí àṣẹ ẹ̀ rẹ tí o fi ọwọ́ sí. Òun sì tún ń gba àdúrà ní ẹ̀ẹ̀mẹ́ta lójúmọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.13",
            "verseOrgIds": [
              "DAN.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ọba gbọ́ èyí, inú rẹ̀ bàjẹ́ gidigidi; ó pinnu láti kó Daniẹli yọ, títí oòrùn fi rọ̀, ó sa gbogbo ipá a rẹ̀ láti gba Daniẹli sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.14",
            "verseOrgIds": [
              "DAN.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, ni àwọn ọlọ̀tẹ̀ wọ̀nyí kó ara wọn jọ wá sí ọ̀dọ̀ ọba, wọ́n sì wí fún un pé, \"Ìwọ ọba rántí pé, ní ìbámu pẹ̀lú òfin àwọn Media àti Persia kò sí àṣẹ tàbí ìkéde tí ọba ṣe tí a le è yí i padà.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.15",
            "verseOrgIds": [
              "DAN.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, ni ọba pàṣẹ, wọ́n sì mú Daniẹli, wọ́n sì sọ ọ́ sínú ihò kìnnìún. Ọba sì sọ fún Daniẹli pé, \"Kí Ọlọ́run rẹ tí ìwọ ń sìn nígbà gbogbo kí ó gbà ọ́!\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.16",
            "verseOrgIds": [
              "DAN.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sì gbé òkúta kan wá, wọ́n sì fi dí ẹnu ihò náà, ọba sì dì í pa pẹ̀lú òrùka èdìdì rẹ̀ àti pẹ̀lú òrùka àwọn ọlọ́lá rẹ̀, nítorí kí a má ṣe yí ohunkóhun padà nítorí i Daniẹli.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.17",
            "verseOrgIds": [
              "DAN.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọba padà sí ààfin rẹ̀, ó sì lo gbogbo òru náà láì jẹun, kò sì gbọ́ orin kankan, bẹ́ẹ̀ ni kò sì le è sùn ní òru ọjọ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.18",
            "verseOrgIds": [
              "DAN.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òwúrọ̀ kùtùkùtù, ni ọba dìde ó sì sáré lọ sí ibi ihò kìnnìún náà.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.19",
            "verseOrgIds": [
              "DAN.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó súnmọ́ ibi ihò náà ní ibi tí Daniẹli wà, ó pe Daniẹli pẹ̀lú ìtara pé, \"Daniẹli, ìránṣẹ́ Ọlọ́run alààyè, ṣé Ọlọ́run rẹ tí ìwọ ń sìn tọ̀sán tòru, lè gbà ọ́ lọ́wọ́ kìnnìún bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.20",
            "verseOrgIds": [
              "DAN.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daniẹli sì dáhùn wí pé, \"Ọba kí ẹ pẹ́!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.21",
            "verseOrgIds": [
              "DAN.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run mi rán angẹli i rẹ̀, ó sì dí àwọn kìnnìún lẹ́nu. Wọn kò le è pa mí lára, nítorí a rí mi gẹ́gẹ́ bí aláìlẹ́ṣẹ̀ ní iwájú rẹ̀. Bẹ́ẹ̀ ni èmi kò hu ìwà ìbàjẹ́ kan níwájú rẹ ìwọ ọba.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.22",
            "verseOrgIds": [
              "DAN.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inú ọba dùn gidigidi, ó sì pàṣẹ kí a mú Daniẹli jáde wá láti inú ihò. Nígbà tí a mú Daniẹli jáde nínú ihò, kò sí ojú ọgbẹ́ kan ní ara rẹ̀, nítorí tí ó gbẹ́kẹ̀lé Ọlọ́run rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.23",
            "verseOrgIds": [
              "DAN.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba pàṣẹ pé, kí a mú àwọn alátakò Daniẹli wá, kí a jù wọ́n sí inú ihò kìnnìún, pẹ̀lú ìyàwó àti àwọn ọmọ wọn. Kí wọn tó dé ìsàlẹ̀ ihò, kìnnìún lágbára lórí i wọn, wọ́n sì fọ́ gbogbo egungun wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.24",
            "verseOrgIds": [
              "DAN.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Dariusi ọba kọ̀wé sí gbogbo ènìyàn orílẹ̀-èdè, àti gbogbo jákèjádò ilẹ̀ náà:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
              "DAN.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "DAN 6:25"
      },
      "items": [
        {
          "text": "\"Kí ìre yín máa pọ̀ sí i!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
              "DAN.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mo gbé àṣẹ kan jáde wí pé, ní gbogbo agbègbè ìjọba mi, gbogbo ènìyàn gbọdọ̀ bẹ̀rù, kí wọn kí ó sì bọ̀wọ̀ fún Ọlọ́run Daniẹli.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.26",
            "verseOrgIds": [
              "DAN.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 6:26"
      },
      "items": [
        {
          "text": "\"Nítorí òun ni Ọlọ́run alààyè.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 6:26"
      },
      "items": [
        {
          "text": "Ó sì wà títí ayé;",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 6:26"
      },
      "items": [
        {
          "text": "ìjọba rẹ̀ kò le è parun,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 6:26"
      },
      "items": [
        {
          "text": "ìjọba rẹ̀ kò ní ìpẹ̀kun.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ń yọ ni, ó sì ń gbani là;",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 6:27"
      },
      "items": [
        {
          "text": "ó ń ṣe iṣẹ́ àmì àti ìyanu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 6:27"
      },
      "items": [
        {
          "text": "ní ọ̀run àti ní ayé.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 6:27"
      },
      "items": [
        {
          "text": "Òun ló gba Daniẹli là",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 6:27"
      },
      "items": [
        {
          "text": "kúrò lọ́wọ́ agbára kìnnìún.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daniẹli sì ṣe rere ní àkókò ìjọba Dariusi àti àkókò ìjọba Kirusi ti Persia.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.28",
            "verseOrgIds": [
              "DAN.6.29"
            ]
          }
        }
      ]
    }
  ],
