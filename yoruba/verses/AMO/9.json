            "sid": "AMO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí Èmi yóò pàṣẹ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.9",
            "verseOrgIds": [
              "AMO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:9"
      },
      "items": [
        {
          "text": "Èmi yóò sì mi ilé Israẹli",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.9",
            "verseOrgIds": [
              "AMO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:9"
      },
      "items": [
        {
          "text": "ní àárín àwọn orílẹ̀-èdè",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.9",
            "verseOrgIds": [
              "AMO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:9"
      },
      "items": [
        {
          "text": "bí a ti ń jọ nǹkan nínú ajọ̀",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.9",
            "verseOrgIds": [
              "AMO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:9"
      },
      "items": [
        {
          "text": "tí hóró kín ń kín kì yóò bọ́ sórí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.9",
            "verseOrgIds": [
              "AMO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ẹlẹ́ṣẹ̀ láàrín àwọn ènìyàn mi",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.10",
            "verseOrgIds": [
              "AMO.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:10"
      },
      "items": [
        {
          "text": "ni yóò ti ipa idà kú",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.10",
            "verseOrgIds": [
              "AMO.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:10"
      },
      "items": [
        {
          "text": "gbogbo àwọn ti ń wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.10",
            "verseOrgIds": [
              "AMO.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:10"
      },
      "items": [
        {
          "text": "'Aburú kì yóò lé wa bá, bẹ́ẹ̀ ni kì yóò ká wa mọ́.'",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.10",
            "verseOrgIds": [
              "AMO.9.10"
            ]
          }
        }
      ]
    },
    {
