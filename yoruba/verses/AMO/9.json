      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:8"
      },
      "items": [
        {
          "text": "Èmi yóò pa á run kúrò lórí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
