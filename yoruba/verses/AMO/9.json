      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:12"
      },
      "items": [
        {
          "text": "àti gbogbo àwọn kèfèrí, ti a ń pè nípa orúkọ mi,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.12",
            "verseOrgIds": [
              "AMO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:12"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.12",
            "verseOrgIds": [
              "AMO.9.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.9.12",
                "verseOrgIds": [
                  "AMO.9.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹni tí yóò ṣe nǹkan wọ̀nyí wí.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.12",
            "verseOrgIds": [
              "AMO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọjọ́ náà ń bọ,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.13",
            "verseOrgIds": [
              "AMO.9.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.9.13",
                "verseOrgIds": [
                  "AMO.9.13"
                ]
              }
            }
          ]
        },
        {
          "text": "wí,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.13",
            "verseOrgIds": [
              "AMO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:13"
      },
      "items": [
        {
          "text": "\"tí ẹni tí ń tulẹ̀ yóò lé ẹni tí ń kórè bá.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.13",
            "verseOrgIds": [
              "AMO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:13"
      },
      "items": [
        {
          "text": "Tí ẹni tí ń fún èso àjàrà yóò lé ẹni tí ń gbìn bá.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.13",
            "verseOrgIds": [
              "AMO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:13"
      },
      "items": [
        {
          "text": "Àwọn òkè ńlá yóò sì kán ọtí wáìnì sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.13",
            "verseOrgIds": [
              "AMO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:13"
      },
      "items": [
        {
          "text": "tí yóò sì sàn láti ara àwọn òkè kéékèèké.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.13",
            "verseOrgIds": [
              "AMO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
