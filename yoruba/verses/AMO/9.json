          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí wọn le jogún ìyókù Edomu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.12",
            "verseOrgIds": [
              "AMO.9.12"
            ]
          }
        }
      ]
    },
