          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ọjọ́ náà ní",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.11",
            "verseOrgIds": [
              "AMO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:11"
      },
      "items": [
        {
          "text": "Èmi yóò gbé àgọ́ Dafidi tí ó wó ró,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.11",
            "verseOrgIds": [
              "AMO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:11"
      },
      "items": [
        {
          "text": "Èmi yóò dí odi rẹ̀ tí ó ya,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.11",
            "verseOrgIds": [
              "AMO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:11"
      },
      "items": [
        {
          "text": "Èmi yóò sì gbé ahoro rẹ̀ sókè,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.11",
            "verseOrgIds": [
              "AMO.9.11"
            ]
          }
        }
      ]
    },
    {
