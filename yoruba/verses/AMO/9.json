            "sid": "AMO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò si tún mú ìgbèkùn Israẹli ènìyàn mi padà bọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.14",
            "verseOrgIds": [
              "AMO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "AMO 9:14"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:14"
      },
      "items": [
        {
          "text": "\"Wọn yóò sì kọ́ ahoro ìlú, wọn yóò sì máa gbé inú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.14",
            "verseOrgIds": [
              "AMO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:14"
      },
      "items": [
        {
          "text": "Wọn yóò sì gbin ọgbà àjàrà, wọn yóò sì mu ọtí wáìnì wọn",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.14",
            "verseOrgIds": [
              "AMO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:14"
      },
      "items": [
        {
          "text": "wọn yóò sì ṣe ọgbà pẹ̀lú, wọn yóò sì jẹ èso inú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.14",
            "verseOrgIds": [
              "AMO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò gbin Israẹli sí orí ilẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.15",
            "verseOrgIds": [
              "AMO.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:15"
      },
      "items": [
        {
          "text": "A kì yóò sì fà wọn tu mọ́ láéláé",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.15",
            "verseOrgIds": [
              "AMO.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:15"
      },
      "items": [
        {
          "text": "kúrò ni orí ilẹ̀ ti mo fi fún wọn,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.15",
            "verseOrgIds": [
              "AMO.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "AMO 9:15"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.15",
            "verseOrgIds": [
              "AMO.9.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.9.15",
                "verseOrgIds": [
                  "AMO.9.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ wí.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.15",
            "verseOrgIds": [
              "AMO.9.15"
            ]
          }
        }
