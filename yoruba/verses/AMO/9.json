      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:11"
      },
      "items": [
        {
          "text": "Èmi yóò sì kọ bí ti ọjọ́ ìgbàanì,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.11",
            "verseOrgIds": [
              "AMO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
