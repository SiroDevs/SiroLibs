        "style": "q2",
        "vid": "AMO 9:8"
      },
      "items": [
        {
          "text": "ń bẹ̀ lára ilẹ̀ ọba tó kún fún ẹ̀ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
