  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "EXO 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ère òrìṣà wúrà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ènìyàn rí i pé Mose pẹ́ kí ó tó sọ̀kalẹ̀ láti orí òkè wá, wọn péjọ yí Aaroni ká, wọ́n sì wí pé, \"Wá, dá òrìṣà tí yóò máa ṣáájú wa fún wa. Bí ó ṣe ti Mose tí ó mú wa jáde láti Ejibiti wá, àwa kò mọ́ ohun tí ó ti ṣẹlẹ̀ sí i.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.1",
            "verseOrgIds": [
              "EXO.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni dá wọn lóhùn pé, \"Ẹ bọ́ òrùka wúrà tí ó wà ní etí àwọn ìyàwó yín, tí àwọn ọmọkùnrin yín, àti tí àwọn ọmọbìnrin yín, kí ẹ sì mú wọn wá sí ọ̀dọ̀ mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.2",
            "verseOrgIds": [
              "EXO.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni gbogbo àwọn ènìyàn bọ́ òrùka etí wọn, wọn sì kó wọn wá fún Aaroni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.3",
            "verseOrgIds": [
              "EXO.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì gbà wọ́n ní ọwọ́ wọn, ó sì fi ṣe ohun ọnà fínfín, ó sì dà á ní àwòrán ẹgbọrọ màlúù. Nígbà náà ni wọn wí pé, \"Israẹli, wọ̀nyí ni òrìṣà, ti ó mú un yín jáde wá láti Ejibiti.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.4",
            "verseOrgIds": [
              "EXO.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà ti Aaroni rí èyí, ó kọ́ pẹpẹ kan níwájú ẹgbọrọ màlúù náà, ó sì kéde pé, \"Lọ́la ni àjọyọ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.5",
            "verseOrgIds": [
              "EXO.32.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.32.5",
                "verseOrgIds": [
                  "EXO.32.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.5",
            "verseOrgIds": [
              "EXO.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni àwọn ènìyàn dìde ní kùtùkùtù ọjọ́ kejì, wọ́n sì rú ẹbọ sísun, wọ́n sì mú ẹbọ àlàáfíà wá. Lẹ́yìn náà wọ́n jókòó láti jẹ àti láti mu, wọ́n sì dìde láti ṣeré.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.6",
            "verseOrgIds": [
              "EXO.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.32.7",
                "verseOrgIds": [
                  "EXO.32.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí fún Mose pé, \"Sọ̀kalẹ̀ lọ, nítorí àwọn ènìyàn rẹ, tí ìwọ mú gòkè wá láti Ejibiti, wọ́n ti dẹ́ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.7",
            "verseOrgIds": [
              "EXO.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n ti yí kánkán kúrò nípa ọ̀nà tí mo ti mo pàṣẹ fún wọn, wọ́n sì ti dá ère ẹgbọrọ màlúù fún ara wọn. Wọ́n ti foríbalẹ̀ fún un, wọ́n sì ti rú ẹbọ sí i, wọ́n sì ti sọ pé, 'Israẹli wọ̀nyí ní òrìṣà tí ó mú un yín jáde láti Ejibiti wá.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.8",
            "verseOrgIds": [
              "EXO.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.32.9",
                "verseOrgIds": [
                  "EXO.32.9"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún Mose pé, \"Èmi ti rí àwọn ènìyàn wọ̀nyí, wọ́n sì jẹ́ ọlọ́rùn líle ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.9",
            "verseOrgIds": [
              "EXO.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ nísinsin yìí fi mí sílẹ̀, nítorí kí ìbínú mi lè gbóná sí wọn, kí Èmi sì lè pa wọ́n run. Nígbà náà ni Èmi yóò sọ ọ́ di orílẹ̀-èdè ńlá.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.10",
            "verseOrgIds": [
              "EXO.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Mose kígbe fún ojúrere",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.11",
            "verseOrgIds": [
              "EXO.32.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.32.11",
                "verseOrgIds": [
                  "EXO.32.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀, ó wí pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.11",
            "verseOrgIds": [
              "EXO.32.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.32.11",
                "verseOrgIds": [
                  "EXO.32.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", èéṣe tí ìbínú rẹ yóò ṣe gbóná sí àwọn ènìyàn rẹ, tí ìwọ mú jáde láti Ejibiti wá pẹ̀lú agbára ńlá àti ọwọ́ agbára?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.11",
            "verseOrgIds": [
              "EXO.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èéṣe tí àwọn ará Ejibiti yóò ṣe wí pé, 'Nítorí ibi ni ó ṣe mọ̀ ọ́n mọ̀ mú wọn jáde, láti pa wọ́n ní orí òkè àti láti gbá wọn kúrò lórí ayé'? Yípadà kúrò nínú ìbínú rẹ tí ó múná, yí ọkàn padà, kí o má sì ṣe mú ìparun wá sórí àwọn ènìyàn rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.12",
            "verseOrgIds": [
              "EXO.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rántí àwọn ọmọ ọ̀dọ̀ rẹ Abrahamu, Isaaki àti Israẹli, ẹni tí ìwọ búra fún fúnra rẹ̀, 'Tí o wí fún wọn pé, Èmi yóò mú irú-ọmọ rẹ pọ̀ bí ìràwọ̀ ojú ọ̀run, Èmi yóò sì fún irú-ọmọ rẹ ní gbogbo ilẹ̀ tí mo ti pinnu fún wọn, yóò sì jẹ́ ogún ìní wọn láéláé.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.13",
            "verseOrgIds": [
              "EXO.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.14",
            "verseOrgIds": [
              "EXO.32.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.32.14",
                "verseOrgIds": [
                  "EXO.32.14"
                ]
              }
            }
          ]
        },
        {
          "text": "dáwọ́ ìbínú rẹ̀ dúró, kò sì mú ìparun náà tí ó sọ wá sórí àwọn ènìyàn rẹ̀ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.14",
            "verseOrgIds": [
              "EXO.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì yípadà, ó sì sọ̀kalẹ̀ láti orí òkè náà pẹ̀lú òkúta wàláà ẹ̀rí méjì ní ọwọ́ rẹ̀. Wọ́n kọ ìwé síhà méjèèjì, iwájú àti ẹ̀yin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.15",
            "verseOrgIds": [
              "EXO.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iṣẹ́ Ọlọ́run sì ni wàláà náà; ìkọ̀wé náà jẹ́ ìkọ̀wé Ọlọ́run, a fín in sára àwọn òkúta wàláà náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.16",
            "verseOrgIds": [
              "EXO.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Joṣua gbọ́ ariwo àwọn ènìyàn tí wọ́n ń kígbe, ó sọ fún Mose pé, \"Ariwo ogun wà nínú àgọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.17",
            "verseOrgIds": [
              "EXO.32.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose dáhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 32:18"
      },
      "items": [
        {
          "text": "\"Kì í ṣe ariwo fún ìṣẹ́gun,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 32:18"
      },
      "items": [
        {
          "text": "kì í ṣe ariwo fún aṣẹ́gun;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 32:18"
      },
      "items": [
        {
          "text": "ohùn àwọn tí ń kọrin ni mo gbọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Mose dé àgọ́, ó sì rí ẹgbọrọ màlúù náà àti ijó, ìbínú rẹ gbóná, ó sì sọ wàláà ọwọ́ rẹ̀ sílẹ̀, ó sì fọ́ wọn sí wẹ́wẹ́ ní ìsàlẹ̀ òkè náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.19",
            "verseOrgIds": [
              "EXO.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì gbé ẹgbọrọ màlúù tí wọ́n ṣe, ó sì fi iná jó wọn; ó sì lọ̀ wọ́n kúnná, ó dà á sínú omi, ó sì mú àwọn ọmọ Israẹli mu ún.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.20",
            "verseOrgIds": [
              "EXO.32.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sọ fún Aaroni pé, \"Kí ni àwọn ènìyàn wọ̀nyí ṣe sí ọ, tí ìwọ ṣe mú wọn dá ẹ̀ṣẹ̀ ńlá yìí?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.21",
            "verseOrgIds": [
              "EXO.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni dáhùn wí pé, \"Má ṣe bínú olúwa mi. Ìwọ mọ bí àwọn ènìyàn yìí ṣe burú tó.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.22",
            "verseOrgIds": [
              "EXO.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sọ fún mi pé, 'Ṣe òrìṣà fún wa, tí yóò máa ṣáájú wa. Bí ó ṣe ti Mose ẹni tí ó mú wa jáde láti Ejibiti wá àwa kò mọ ohun tí ó ṣẹlẹ̀ sí i.'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.23",
            "verseOrgIds": [
              "EXO.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni mo sọ fún wọn pé, 'Ẹnikẹ́ni tí ó ní òrùka wúrà, kí ó bọ́ ọ wá.' Nígbà náà ni wọ́n fún mi ní wúrà, mo sì jù ú sínú iná, a sì fi ṣe ẹgbọrọ màlúù yìí!\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.24",
            "verseOrgIds": [
              "EXO.32.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose rí pé àwọn ènìyàn náà kò ṣe ṣàkóso àti pé Aaroni ti sọ wọ́n di aláìlákóṣo láàrín àwọn ọ̀tá tí ó dìde sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.25",
            "verseOrgIds": [
              "EXO.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Mose dúró ní ẹnu-ọ̀nà àgọ́, ó sì wí pé, \"Ẹnikẹ́ni tí ó bá wà fún",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.26",
            "verseOrgIds": [
              "EXO.32.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.32.26",
                "verseOrgIds": [
                  "EXO.32.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí ó wá sí ọ̀dọ̀ mi.\" Gbogbo àwọn ará Lefi sì péjọ yí i ká.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.26",
            "verseOrgIds": [
              "EXO.32.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ó sọ fún wọn pé, \"Èyí ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.27",
            "verseOrgIds": [
              "EXO.32.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.32.27",
                "verseOrgIds": [
                  "EXO.32.27"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli, wí pé, 'Kí olúkúlùkù ọkùnrin kí ó kọ idà rẹ̀ sí ẹ̀gbẹ́ rẹ̀. Ẹ lọ padà, kí ẹ jà láti àgọ́ kan dé òmíràn, olúkúlùkù kí ó pa arákùnrin rẹ̀ ọ̀rẹ́ rẹ̀ àti aládùúgbò rẹ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.27",
            "verseOrgIds": [
              "EXO.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Lefi ṣe gẹ́gẹ́ bí Mose ṣe pàṣẹ, àti ní ọjọ́ náà àwọn tí ó kú tó ẹgbẹ̀rún mẹ́ta (3,000) ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.28",
            "verseOrgIds": [
              "EXO.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose wí pé, \"Ẹ ti ya ara yín sọ́tọ̀ fún",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.29",
            "verseOrgIds": [
              "EXO.32.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.32.29",
                "verseOrgIds": [
                  "EXO.32.29"
                ]
              }
            }
          ]
        },
        {
          "text": "lónìí, nítorí ìwọ ti dìde sí àwọn ọmọ rẹ àti arákùnrin rẹ, ó sì ti bùkún fún ọ lónìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.29",
            "verseOrgIds": [
              "EXO.32.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kejì Mose sọ fún àwọn ènìyàn náà pé, \"Ẹ̀yin ti dá ẹ̀ṣẹ̀ tí ó pọ̀. Ṣùgbọ́n nísinsin yìí èmi yóò gòkè lọ bá",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.30",
            "verseOrgIds": [
              "EXO.32.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.32.30",
                "verseOrgIds": [
                  "EXO.32.30"
                ]
              }
            }
          ]
        },
        {
          "text": "; bóyá èmi lè ṣe ètùtù fún ẹ̀ṣẹ̀ yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.30",
            "verseOrgIds": [
              "EXO.32.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Mose padà tọ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.31",
            "verseOrgIds": [
              "EXO.32.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.32.31",
                "verseOrgIds": [
                  "EXO.32.31"
                ]
              }
            }
          ]
        },
        {
          "text": "lọ, ó sì wí pé, \"Yé, kí ni ẹ̀ṣẹ̀ ńlá tí àwọn ènìyàn ti dá yìí! Wọ́n ti ṣe òrìṣà wúrà fún ara wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.31",
            "verseOrgIds": [
              "EXO.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nísinsin yìí, jọ̀wọ́ dárí ẹ̀ṣẹ̀ wọn jì wọ́n ṣùgbọ́n tí kò bá sì ṣe bẹ́ẹ̀, pa orúkọ mi rẹ́ kúrò nínú ìwé tí ìwọ ti kọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.32",
            "verseOrgIds": [
              "EXO.32.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.32.33",
                "verseOrgIds": [
                  "EXO.32.33"
                ]
              }
            }
          ]
        },
        {
          "text": "dá Mose lóhùn pé, \"Ẹnikẹ́ni tí ó bá dẹ́ṣẹ̀ sí mi, Èmi yóò pa á rẹ́ kúrò nínú ìwé mi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.33",
            "verseOrgIds": [
              "EXO.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ nísinsin yìí lọ, máa darí àwọn ènìyàn yìí lọ sí ibi ti mo sọ, angẹli mi yóò sì máa lọ ṣáájú yín. Ìgbà ń bọ̀ fún mi tì Èmi yóò ṣe ìbẹ̀wò, Èmi yóò fi yà jẹ wọ́n fún ẹ̀ṣẹ̀ wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.34",
            "verseOrgIds": [
              "EXO.32.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.32.35",
                "verseOrgIds": [
                  "EXO.32.35"
                ]
              }
            }
          ]
        },
        {
          "text": "sì yọ àwọn ènìyàn náà lẹ́nu, pẹ̀lú ààrùn nítorí ohun tí wọ́n ṣe ní ti ẹgbọrọ màlúù tí Aaroni ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.35",
            "verseOrgIds": [
              "EXO.32.35"
            ]
          }
        }
      ]
    }
