  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "EXO 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ààrùn lára ẹran ọ̀sìn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.1",
            "verseOrgIds": [
              "EXO.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.1",
                "verseOrgIds": [
                  "EXO.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Lọ sọ fún Farao, 'Èyí ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.1",
            "verseOrgIds": [
              "EXO.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.1",
                "verseOrgIds": [
                  "EXO.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run àwọn Heberu sọ, \"Jẹ́ kí àwọn ènìyàn Mi kí ó lọ, kí wọn bá à lè sìn Mí.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.1",
            "verseOrgIds": [
              "EXO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá kọ̀ láti jẹ́ kí wọn ó lọ, tí ó sì dá wọn dúró.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.2",
            "verseOrgIds": [
              "EXO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọwọ́",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.3",
            "verseOrgIds": [
              "EXO.9.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.3",
                "verseOrgIds": [
                  "EXO.9.3"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò mú ààrùn búburú wá sí ara ẹran ọ̀sìn nínú oko, sí ara ẹṣin, kẹ́tẹ́kẹ́tẹ́, ìbákasẹ, màlúù, àgùntàn àti ewúrẹ́ yín.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.3",
            "verseOrgIds": [
              "EXO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.4",
            "verseOrgIds": [
              "EXO.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.4",
                "verseOrgIds": [
                  "EXO.9.4"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò pààlà sí àárín ẹran ọ̀sìn tí ó jẹ́ ti Israẹli àti ti àwọn ara Ejibiti tí yóò fi jẹ́ pé kò sí ẹran ọ̀sìn ti ó jẹ́ ti ará Israẹli tí yóò kùú.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.4",
            "verseOrgIds": [
              "EXO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.5",
                "verseOrgIds": [
                  "EXO.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sì dá àkókò kan wí pé, \"Ní ọ̀la ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.5",
            "verseOrgIds": [
              "EXO.9.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.5",
                "verseOrgIds": [
                  "EXO.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò ṣe èyí ni ilẹ̀ yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.5",
            "verseOrgIds": [
              "EXO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.6",
                "verseOrgIds": [
                  "EXO.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sí ṣe é ni ọjọ́ kejì. Gbogbo ẹran ọ̀sìn ará Ejibiti kú, ṣùgbọ́n ẹyọ kan kò kú lára ẹran ọ̀sìn àwọn Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.6",
            "verseOrgIds": [
              "EXO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao rán àwọn ènìyàn rẹ̀ láti lọ ṣe ìwádìí, wọ́n sì rí pé ẹyọ kan kò kú lára àwọn ẹran ọ̀sìn ará Israẹli. Síbẹ̀ náà, Farao kò yí ọkàn rẹ̀ padà àti pé kò jẹ́ kí àwọn ènìyàn ó lọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.7",
            "verseOrgIds": [
              "EXO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ààrùn Oówo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.8",
            "verseOrgIds": [
              "EXO.9.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.8",
                "verseOrgIds": [
                  "EXO.9.8"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose àti Aaroni, \"Ẹ bu ẹ̀kúnwọ́ eérú gbígbóná láti inú ààrò, kí Mose kù ú sí inú afẹ́fẹ́ ni iwájú Farao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.8",
            "verseOrgIds": [
              "EXO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò sì di eruku lẹ́búlẹ́bú ni gbogbo ilẹ̀ Ejibiti, yóò sì di oówo ti ń tú pẹ̀lú ìléròrò sí ara àwọn ènìyàn àti ẹran jákèjádò gbogbo ilẹ̀ Ejibiti.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.9",
            "verseOrgIds": [
              "EXO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni wọ́n bú eérú gbígbóná láti inú ààrò, wọ́n dúró ní iwájú Farao. Mose sì ku eérú náà sínú afẹ́fẹ́, ó sì di oówo tí ń tú pẹ̀lú ìléròrò ni ara àwọn ènìyàn àti lára ẹran.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.10",
            "verseOrgIds": [
              "EXO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn onídán kò le è dúró níwájú Mose nítorí oówo ti ó wà lára wọn àti ni ara gbogbo àwọn ara Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.11",
            "verseOrgIds": [
              "EXO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Ọlọ́run sé ọkàn Farao le, kò sì gbọ́ ti Mose àti Aaroni, gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.12",
            "verseOrgIds": [
              "EXO.9.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.12",
                "verseOrgIds": [
                  "EXO.9.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ fún Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.12",
            "verseOrgIds": [
              "EXO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òjò o yìnyín",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.13",
            "verseOrgIds": [
              "EXO.9.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.13",
                "verseOrgIds": [
                  "EXO.9.13"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Dìde ni òwúrọ̀ kùtùkùtù, kí o sì tọ Farao lọ, kí o sì wí fún un pé, 'Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.13",
            "verseOrgIds": [
              "EXO.9.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.13",
                "verseOrgIds": [
                  "EXO.9.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run àwọn Heberu wí, Jẹ́ kí àwọn ènìyàn mi kí ó lọ, kí wọn bá à lè sìn mí,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.13",
            "verseOrgIds": [
              "EXO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí nígbà yìí ni èmi yóò rán àjàkálẹ̀-ààrùn ti ó ní agbára gidigidi sí ọ, sí àwọn ìjòyè rẹ àti sí àwọn ènìyàn rẹ, kí ìwọ kí ó lè mọ̀ pé, kò sí ẹni bí èmi ni gbogbo ayé.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.14",
            "verseOrgIds": [
              "EXO.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ti yẹ kí n ti na ọwọ́ mi jáde láti kọlù ọ́ àti àwọn ènìyàn rẹ pẹ̀lú ààrùn búburú ti kò bá ti run yín kúrò ni orí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.15",
            "verseOrgIds": [
              "EXO.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nítorí èyí ni èmi ṣe mú ọ dúró, kí èmi kí ó le fi agbára mi hàn lára rẹ, àti kí a bá à le máa ròyìn orúkọ mi ká gbogbo ayé.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.16",
            "verseOrgIds": [
              "EXO.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀ ìwọ tún gbógun ti àwọn ènìyàn mi, ìwọ kò sì jẹ́ kí wọn lọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.17",
            "verseOrgIds": [
              "EXO.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, ni ìwòyí ọ̀la, Èmi yóò rán òjò o yìnyín tí irú rẹ̀ kò tí i rọ̀ rí ni Ejibiti láti ìpilẹ̀ṣẹ̀ rẹ̀ títí di àkókò yìí.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.18",
            "verseOrgIds": [
              "EXO.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pàṣẹ nísinsin yìí láti kó ẹran ọ̀sìn yín àti ohun gbogbo ti ẹ ni ní pápá wá sí abẹ́ ààbò, nítorí òjò yìnyín yóò rọ̀ sí orí àwọn ènìyàn àti ẹran ti a kò kó wá sí abẹ́ ààbò tí wọ́n sì wà ni orí pápá, wọn yóò sì kú.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.19",
            "verseOrgIds": [
              "EXO.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ti ó bẹ̀rù ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.20",
            "verseOrgIds": [
              "EXO.9.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.20",
                "verseOrgIds": [
                  "EXO.9.20"
                ]
              }
            }
          ]
        },
        {
          "text": "lára àwọn ìjòyè Farao yára lọ láti kó àwọn ẹrú àti àwọn ẹran ọ̀sìn wọn wá sí abẹ́ ààbò.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.20",
            "verseOrgIds": [
              "EXO.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn ti kò kà ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.21",
            "verseOrgIds": [
              "EXO.9.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.21",
                "verseOrgIds": [
                  "EXO.9.21"
                ]
              }
            }
          ]
        },
        {
          "text": "sí fi àwọn ẹrú wọn àti àwọn ẹran ọ̀sìn wọn sílẹ̀ ni pápá.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.21",
            "verseOrgIds": [
              "EXO.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.22",
                "verseOrgIds": [
                  "EXO.9.22"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Gbé ọwọ́ rẹ sókè sí ọ̀run kí yìnyín bá à lè rọ̀ sí orí gbogbo ilẹ̀ Ejibiti, sí orí ènìyàn àti ẹranko, àti sí orí gbogbo ohun ọ̀gbìn tí ó wà ni inú oko.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.22",
            "verseOrgIds": [
              "EXO.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Mose gbé ọ̀pá rẹ̀ sókè sí ojú ọ̀run,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.23",
            "verseOrgIds": [
              "EXO.9.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.23",
                "verseOrgIds": [
                  "EXO.9.23"
                ]
              }
            }
          ]
        },
        {
          "text": "rán àrá àti yìnyín, mọ̀nàmọ́ná sì bùsi orí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.23",
            "verseOrgIds": [
              "EXO.9.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.23",
                "verseOrgIds": [
                  "EXO.9.23"
                ]
              }
            }
          ]
        },
        {
          "text": "rọ òjò yìnyín sí orí ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.23",
            "verseOrgIds": [
              "EXO.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yìnyín rọ̀, mọ̀nàmọ́ná sì bẹ̀rẹ̀ sí bùsi orí ilẹ̀ èyí ni ó tí ì burú jù ti ó ṣẹlẹ̀ láti ìgbà ti Ejibiti ti di orílẹ̀-èdè.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.24",
            "verseOrgIds": [
              "EXO.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jákèjádò gbogbo ilẹ̀ Ejibiti ni yìnyín ti pa gbogbo ohun tí ó wà ni orí pápá; ènìyàn àti ẹranko, ó wò gbogbo ohun ọ̀gbìn lulẹ̀ ó sì fa gbogbo igi ya pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.25",
            "verseOrgIds": [
              "EXO.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ Goṣeni ni ibi ti àwọn Israẹli wà nìkan ni òjò yìnyín náà kò rọ̀ dé.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.26",
            "verseOrgIds": [
              "EXO.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Farao pe Mose àti Aaroni sì ọ̀dọ́ rẹ̀, ó sì wí fún wọn pé, \"Èmi ti ṣẹ̀ ní àkókò yìí;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.27",
            "verseOrgIds": [
              "EXO.9.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.27",
                "verseOrgIds": [
                  "EXO.9.27"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ́ olódodo ṣùgbọ́n èmi àti àwọn ènìyàn mi ni aláìṣòdodo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.27",
            "verseOrgIds": [
              "EXO.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ti òjò yìnyín àti àrá rọ̀ yìí tó gẹ́ẹ́, gbàdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.28",
            "verseOrgIds": [
              "EXO.9.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.28",
                "verseOrgIds": [
                  "EXO.9.28"
                ]
              }
            }
          ]
        },
        {
          "text": "kí ó dáwọ́ rẹ̀ dúró. Èmi yóò jẹ́ kí ẹ lọ, n kò tún ni dá a yín dúró mọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.28",
            "verseOrgIds": [
              "EXO.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose dá a lóhùn pé, \"Bí mo bá ti jáde kúrò ní àárín ìlú, èmi yóò gbé ọwọ́ mi sókè sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.29",
            "verseOrgIds": [
              "EXO.9.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.29",
                "verseOrgIds": [
                  "EXO.9.29"
                ]
              }
            }
          ]
        },
        {
          "text": ", sísán àrá yóò dáwọ́ dúró, yìnyín kò sì ni rọ̀ mọ́, kí ìwọ kí ó lè mọ̀ pé",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.29",
            "verseOrgIds": [
              "EXO.9.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.29",
                "verseOrgIds": [
                  "EXO.9.29"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ó ni ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.29",
            "verseOrgIds": [
              "EXO.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èmi mọ̀ pé síbẹ̀síbẹ̀ ìwọ àti àwọn ìjòyè rẹ kò bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.30",
            "verseOrgIds": [
              "EXO.9.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.30",
                "verseOrgIds": [
                  "EXO.9.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.30",
            "verseOrgIds": [
              "EXO.9.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "(A sì lu ọ̀gbọ̀ àti ọkà barle bolẹ̀; nítorí barle wà ní ìpẹ́, ọ̀gbọ̀ sì rudi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.31",
            "verseOrgIds": [
              "EXO.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alikama àti ọkà ni a kò lù bolẹ̀, nítorí tí wọ́n kò tí ì dàgbà.)",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
            "verseOrgIds": [
              "EXO.9.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose jáde kúrò ni iwájú Farao, ó kúrò ni àárín ìgboro kọjá lọ sí ẹ̀yìn odi ìlú, ó sì gbé ọwọ́ rẹ̀ sókè sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
              "EXO.9.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.33",
                "verseOrgIds": [
                  "EXO.9.33"
                ]
              }
            }
          ]
        },
        {
          "text": ", sísán àrá àti òjò yìnyín ti ń rọ̀ sì dáwọ́ dúró, òjò kò sì rọ̀ sí orí ilẹ̀ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
              "EXO.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Farao rí i pé òjò àti yìnyín àti àrá ti ń sán ti dáwọ́ dúró, ó tún ṣẹ̀ ní ẹ̀ẹ̀kan sí i. Òun àti àwọn ìránṣẹ́ rẹ̀ ṣì sé àyà wọn le.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.34",
            "verseOrgIds": [
              "EXO.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àyà Farao sì le, bẹ́ẹ̀ ni kò sì jẹ́ kí àwọn ọmọ Israẹli kí ó lọ, bí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
            "verseOrgIds": [
              "EXO.9.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.35",
                "verseOrgIds": [
                  "EXO.9.35"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ láti ẹnu Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
            "verseOrgIds": [
              "EXO.9.35"
            ]
          }
        }
      ]
    }
