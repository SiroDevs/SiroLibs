        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àjọ ìrékọjá",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.1",
                "verseOrgIds": [
                  "EXO.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose àti Aaroni ni ilẹ̀ Ejibiti pé,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.1",
            "verseOrgIds": [
              "EXO.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Oṣù yìí ni yóò jẹ́ oṣù àkọ́kọ́ fún yín, oṣù àkọ́kọ́ nínú ọdún yín.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.2",
            "verseOrgIds": [
              "EXO.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọ fún gbogbo àwọn ènìyàn Israẹli pé ni ọjọ́ kẹwàá oṣù yìí, ọkùnrin kọ̀ọ̀kan yóò mú ọ̀dọ́-àgùntàn kọ̀ọ̀kan fún ìdílé rẹ̀, ọ̀kan fún agbo ilé kọ̀ọ̀kan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.3",
            "verseOrgIds": [
              "EXO.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìdílé kan bá kéré jù fún odidi ọ̀dọ́-àgùntàn kan, kí wọn kí ó ṣe àjọpín ọ̀kan pẹ̀lú aládùúgbò wọn ti ó sun mọ́ wọn kí wọ́n lo iye ènìyàn tiwọn jẹ láti ṣe òdínwọ̀n irú ọ̀dọ́-àgùntàn tiwọn yóò lò ní ìbámu pẹ̀lú ìwọ̀n ti ẹni kọ̀ọ̀kan lè jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.4",
            "verseOrgIds": [
              "EXO.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀dọ́-àgùntàn tí ìwọ yóò mú gbọdọ̀ jẹ́ akọ ọlọ́dún kan tí kò lábùkù, ìwọ lè mú lára àgbò tàbí ewúrẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.5",
            "verseOrgIds": [
              "EXO.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣe ìtọ́jú wọn títí di ọjọ́ kẹrìnlá oṣù yìí nígbà tí gbogbo ìjọ ènìyàn Israẹli yóò pa ẹran náà ní àfẹ̀mọ́júmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.6",
            "verseOrgIds": [
              "EXO.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò mú lára ẹ̀jẹ̀ ẹran náà, wọn yóò fi kan ẹ̀gbẹ́ méjèèjì àti òkè ẹnu-ọ̀nà àbáwọlé níbi tí wọ́n bá ti jẹ ẹran ọ̀dọ́-àgùntàn náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.7",
            "verseOrgIds": [
              "EXO.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òru ọjọ́ kan náà, wọn yóò jẹ ẹran tí a ti fi iná sun, pẹ̀lú ewé ewúro àti àkàrà aláìwú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.8",
            "verseOrgIds": [
              "EXO.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe jẹ ẹran náà ni tútù tàbí ní bíbọ̀ nínú omi, ṣùgbọ́n kí ẹ fi iná sun orí, ẹsẹ̀ àti àwọn nǹkan inú ẹran náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.9",
            "verseOrgIds": [
              "EXO.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe fi èyíkéyìí sílẹ̀ di òwúrọ̀ ọjọ́ kejì, bí ó bá ṣẹ́kù di òwúrọ̀ ọjọ́ kejì, kí ẹ jó o níná.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.10",
            "verseOrgIds": [
              "EXO.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni ẹ̀yìn yóò ṣe jẹ́ tí ẹ̀yin ti àmùrè ní ẹ̀gbẹ́ yín, sáńdà yín ní ẹsẹ̀ yín àti ọ̀pá yín ni ọwọ́ yín. Ẹ yára jẹ ẹ́, oúnjẹ àjọ ìrékọjá",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.11",
            "verseOrgIds": [
              "EXO.12.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.11",
                "verseOrgIds": [
                  "EXO.12.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.11",
            "verseOrgIds": [
              "EXO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní òru ọjọ́ yìí kan náà ni Èmi yóò la gbogbo ilẹ̀ Ejibiti kọjá, èmi yóò sì pa gbogbo àkọ́bí àti ènìyàn, àti ẹranko, èmi yóò mú ìdájọ́ wà sí orí àwọn òrìṣà ilẹ̀ Ejibiti. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.12",
            "verseOrgIds": [
              "EXO.12.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.12",
                "verseOrgIds": [
                  "EXO.12.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.12",
            "verseOrgIds": [
              "EXO.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀jẹ̀ ni yóò jẹ́ àmì fún un yín ní àwọn ilé tí ẹ̀yin wà, nígbà tí èmi bá rí ẹ̀jẹ̀ náà, Èmi yóò ré e yín kọjá. Ààrùn kan kì yóò kàn yín nígbà tí èmi bá kọlu Ejibiti láti pa wọ́n run.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.13",
            "verseOrgIds": [
              "EXO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọjọ́ òní ni yóò sì máa ṣe ọjọ́ ìrántí fún yín, ẹ́yin yóò sì máa láàrín àwọn ìran tí ó ń bọ̀ lẹ́yìn ni ẹ̀yin yóò ti máa ṣe ní àjọ fún",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.14",
            "verseOrgIds": [
              "EXO.12.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.14",
                "verseOrgIds": [
                  "EXO.12.14"
                ]
              }
            }
          ]
        },
        {
          "text": "; ní ìran-ìran yín bí ìlànà tí yóò wà títí ayé.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.14",
            "verseOrgIds": [
              "EXO.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ọjọ́ méje ni ẹ̀yin yóò fi jẹ àkàrà tí kò ní ìwúkàrà. Ní ọjọ́ kìn-ín-ní, ẹ ó gbé ìwúkàrà kúrò ni ilé yín, nítorí ẹnikẹ́ni tí ó bá jẹ ohunkóhun tí ó ni ìwúkàrà nínú láti ọjọ́ kìn-ín-ní di ọjọ́ keje ni kí a yọ kúrò ni Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.15",
            "verseOrgIds": [
              "EXO.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kìn-ín-ní kí àpéjọ mímọ́ kí ó wà; àti ní ọjọ́ keje àpéjọ mímọ́ mìíràn yóò wà fún yín. Ẹ má ṣe ṣe iṣẹ́kíṣẹ́ kan ní àwọn ọjọ́ wọ̀nyí, bí kò ṣe oúnjẹ tí olúkúlùkù yóò jẹ; kìkì èyí ni gbogbo ohun tí ẹ̀yin lè ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.16",
            "verseOrgIds": [
              "EXO.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ ó sì kíyèsí àjọ àìwúkàrà, nítorí ní ọjọ́ náà gan an ni mo mú ogun yín jáde kúrò ni ilẹ̀ Ejibiti. Nítorí náà ni kí ẹ máa kíyèsi ọjọ́ náà ní ìran-ìran yín bí ìlànà tí yóò wà títí ayé.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.17",
            "verseOrgIds": [
              "EXO.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àkàrà ti kò ni ìwúkàrà ni ẹ̀yin yóò jẹ láti ìrọ̀lẹ́ ọjọ́ kẹrìnlá títí di ìrọ̀lẹ́ ọjọ́ kọ̀kànlélógún oṣù àkọ́kọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.18",
            "verseOrgIds": [
              "EXO.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ọjọ́ méje ni ẹ kò gbọdọ̀ ni ìwúkàrà nínú ilé yín, ẹnikẹ́ni tí ó bá jẹ ohun tí ó ni ìwúkàrà nínú ni a ó yọ kúrò ni àárín àwùjọ Israẹli, ìbá à ṣe àlejò tàbí ẹni tí a bí ní ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.19",
            "verseOrgIds": [
              "EXO.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kò gbọdọ̀ jẹ ohunkóhun tí a fi ìwúkàrà ṣe. Ní ibikíbi tí ẹ̀yin bá ń gbé, kí ẹ̀yin kí ó jẹ àkàrà tí kò ní ìwúkàrà.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.20",
            "verseOrgIds": [
              "EXO.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà náà ni Mose pé gbogbo àwọn àgbàgbà Israẹli jọ, ó sì sọ fún wọn pé, \"Ẹ jáde lọ, kí ẹ sì yan ọ̀dọ́-àgùntàn fún àwọn ìdílé yín, kí ẹ sì pa ẹran àjọ ìrékọjá",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.21",
            "verseOrgIds": [
              "EXO.12.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.21",
                "verseOrgIds": [
                  "EXO.12.21"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.21",
            "verseOrgIds": [
              "EXO.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin yóò sì mú ìdí-ewé hísópù, ẹ tì í bọ inú ẹ̀jẹ̀ tí ó wà nínú ọpọ́n kí ẹ sì fi kun òkè à bá wọ ẹnu-ọ̀nà ilé yín àti ẹ̀gbẹ́ méjèèjì ìlẹ̀kùn yín. Ẹnikẹ́ni nínú yín kò gbọdọ̀ jáde sí òde títí di òwúrọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.22",
            "verseOrgIds": [
              "EXO.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà tí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.23",
            "verseOrgIds": [
              "EXO.12.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.23",
                "verseOrgIds": [
                  "EXO.12.23"
                ]
              }
            }
          ]
        },
        {
          "text": "bá ń lọ káàkiri ní ilẹ̀ Ejibiti láti kọlù wọn, yóò rí ẹ̀jẹ̀ ni òkè ẹnu-ọ̀nà àti ni ẹ̀gbẹ́ ẹnu-ọ̀nà ilé yín, yóò sì ré ẹnu-ọ̀nà ilé náà kọjá, kì yóò gba apanirun láààyè láti wọ inú ilé e yín láti kọlù yín.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.23",
            "verseOrgIds": [
              "EXO.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ pa ìlànà yìí mọ́ gẹ́gẹ́ bí ohun tí ẹ ó máa ṣe títí ayérayé láàrín yín àti àwọn ìran yín.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.24",
            "verseOrgIds": [
              "EXO.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ẹ̀yin bá de ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.25",
            "verseOrgIds": [
              "EXO.12.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.25",
                "verseOrgIds": [
                  "EXO.12.25"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò fi fún un yín bí òun ti ṣe ìlérí, ẹ máa kíyèsi àjọ yìí.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.25",
            "verseOrgIds": [
              "EXO.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà tí àwọn ọmọ yín bá béèrè lọ́wọ́ yín, 'Kí ni ohun tí àjọ yìí túmọ̀ sí fún un yín?'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.26",
            "verseOrgIds": [
              "EXO.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ sọ fún wọn ni ìgbà náà, 'Ẹbọ ìrékọjá sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.27",
            "verseOrgIds": [
              "EXO.12.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.27",
                "verseOrgIds": [
                  "EXO.12.27"
                ]
              }
            }
          ]
        },
        {
          "text": "ni, ẹni tí ó rékọjá ilé àwọn ọmọ Israẹli ni ìgbà tí ó kọlu àwọn ara Ejibiti. Tí ó si da wa sí nígbà ti ó pa àwọn ara Ejibiti.' \" Àwọn ènìyàn sì tẹríba láti sìn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.27",
            "verseOrgIds": [
              "EXO.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli ṣe gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.28",
            "verseOrgIds": [
              "EXO.12.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.28",
                "verseOrgIds": [
                  "EXO.12.28"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ fún Mose àti Aaroni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.28",
            "verseOrgIds": [
              "EXO.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọ̀gànjọ́ òru",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.29",
            "verseOrgIds": [
              "EXO.12.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.29",
                "verseOrgIds": [
                  "EXO.12.29"
                ]
              }
            }
          ]
        },
        {
          "text": "kọlu gbogbo àwọn àkọ́bí ilẹ̀ Ejibiti, láti orí àkọ́bí. Farao tí ó wà ní orí ìtẹ́ títí dé orí àkọ́bí ẹlẹ́wọ̀n tí ó wà nínú túbú àti àkọ́bí ẹran ọ̀sìn pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.29",
            "verseOrgIds": [
              "EXO.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao àti àwọn ìjòyè rẹ̀ àti gbogbo àwọn ara Ejibiti dìde ní ọ̀gànjọ́ òru, igbe ẹkún ńlá sì gba gbogbo ilẹ̀ Ejibiti, nítorí kò sí ilé kan tí ó yọ sílẹ̀ tí ènìyàn kan kò ti kú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.30",
            "verseOrgIds": [
              "EXO.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìjáde lọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao sì ránṣẹ́ pe Mose àti Aaroni ní òru, ó sì wí pé, \"Ẹ kúrò lọ́dọ̀ mi ẹ̀yin àti àwọn ènìyàn Israẹli! Ẹ lọ láti sin",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.31",
            "verseOrgIds": [
              "EXO.12.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.31",
                "verseOrgIds": [
                  "EXO.12.31"
                ]
              }
            }
          ]
        },
        {
          "text": "gẹ́gẹ́ bí ẹ ti béèrè.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.31",
            "verseOrgIds": [
              "EXO.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kó agbo àgùntàn yín àti agbo màlúù yín gẹ́gẹ́ bí ẹ̀yin ti sọ, kí ẹ sì máa lọ, kí ẹ sì súre fún mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.32",
            "verseOrgIds": [
              "EXO.12.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ara Ejibiti ń rọ àwọn ènìyàn náà láti yára máa lọ kúrò ní ilẹ̀ wọn. Wọ́n wí pé, \"Bí bẹ́ẹ̀ kọ́ gbogbo wa ni yóò kú!\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.33",
            "verseOrgIds": [
              "EXO.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn náà sì mú ìyẹ̀fun púpọ̀ kí wọn tó fi ìwúkàrà sí i, wọ́n gbe le èjìká wọn nínú ọpọ́n tí wọ́n ti fi aṣọ dì.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.34",
            "verseOrgIds": [
              "EXO.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli ṣe gẹ́gẹ́ bí Mose ti sọ fún wọn. Wọ́n sì béèrè lọ́wọ́ ará Ejibiti fún ohun èlò fàdákà àti wúrà àti fún aṣọ pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.35",
            "verseOrgIds": [
              "EXO.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.36",
                "verseOrgIds": [
                  "EXO.12.36"
                ]
              }
            }
          ]
        },
        {
          "text": "ti mú kí àwọn ènìyàn yìí rí ojúrere àwọn ará Ejibiti wọ́n sì fún wọn ní ohun tí wọ́n béèrè fún, wọ́n sì ko ẹrù àwọn ará Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.36",
            "verseOrgIds": [
              "EXO.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli sì rìn láti Ramesesi lọ sí Sukkoti. Àwọn ọkùnrin tó ń fi ẹsẹ̀ rìn tó ọgbọ̀n ọ̀kẹ́ (600,000) ni iye láìka àwọn obìnrin àti àwọn ọmọdé.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.37",
            "verseOrgIds": [
              "EXO.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀pọ̀ àwọn ènìyàn mìíràn ni ó bá wọ́n lọ àti ọ̀pọ̀lọpọ̀ ẹran ọ̀sìn, agbo àgùntàn àti agbo màlúù.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.38",
            "verseOrgIds": [
              "EXO.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú ìyẹ̀fun tí kò ní ìwúkàrà nínú tí wọ́n gbé jáde láti Ejibiti wá ni wọ́n fi ṣe àkàrà aláìwú. Ìyẹ̀fun náà kò ni ìwúkàrà nínú nítorí a lé wọn jáde láti ilẹ̀ Ejibiti wọn kò si rí ààyè láti tọ́jú oúnjẹ fún ara wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.39",
            "verseOrgIds": [
              "EXO.12.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ọdún ti àwọn ará Israẹli gbé ní ilẹ̀ Ejibiti jẹ́ irinwó ọdún ó lé ọgbọ̀n (430).",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.40",
            "verseOrgIds": [
              "EXO.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ní òpin irinwó ọdún ó le ọgbọ̀n (430), ní ọjọ́ náà gan an, ni ó sì ṣe tí gbogbo ogun",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.41",
            "verseOrgIds": [
              "EXO.12.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.41",
                "verseOrgIds": [
                  "EXO.12.41"
                ]
              }
            }
          ]
        },
        {
          "text": "jáde kúrò ní ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.41",
            "verseOrgIds": [
              "EXO.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.42",
                "verseOrgIds": [
                  "EXO.12.42"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe àìsùn ni òru ọjọ́ náà láti mú wọn jáde kúrò ní ilẹ̀ Ejibiti, ní òru yìí ni gbogbo Israẹli ní láti máa ṣe àìsùn láti fi bu ọlá fún",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.42",
                "verseOrgIds": [
                  "EXO.12.42"
                ]
              }
            }
          ]
        },
        {
          "text": "títí di àwọn ìran tí ń bọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òfin Àjọ ìrékọjá",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.43",
                "verseOrgIds": [
                  "EXO.12.43"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose àti Aaroni pé, \"Ìwọ̀n yìí ni àwọn òfin fún àjọ ìrékọjá:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.43",
            "verseOrgIds": [
              "EXO.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 12:43"
      },
      "items": [
        {
          "text": "\"Àjèjì kò gbọdọ̀ jẹ nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.43",
            "verseOrgIds": [
              "EXO.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EXO 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹrú tí ẹ̀yin bá rà lè jẹ́ nínú rẹ̀ lẹ́yìn tí ẹ̀yin bá ti kọ ọ́ ní ilà,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.44",
            "verseOrgIds": [
              "EXO.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EXO 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n àtìpó àti alágbàṣe kò ni jẹ nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.45",
            "verseOrgIds": [
              "EXO.12.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EXO 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nínú ilé ni ẹ ti gbọdọ̀ jẹ ẹ́; ẹ kò gbọdọ̀ mú èyíkéyìí nínú ẹran náà jáde kúrò nínú ilé. Ẹ má ṣe ṣẹ́ ọ̀kankan nínú egungun rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.46",
            "verseOrgIds": [
              "EXO.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EXO 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àjọ Israẹli ni ó gbọdọ̀ ṣe àjọyọ̀ ọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.47",
            "verseOrgIds": [
              "EXO.12.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EXO 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àjèjì ti ó bá ń gbé ní àárín yín ti ó bá fẹ́ kópa nínú àjọ ìrékọjá",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.48",
            "verseOrgIds": [
              "EXO.12.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.48",
                "verseOrgIds": [
                  "EXO.12.48"
                ]
              }
            }
          ]
        },
        {
          "text": ", ni o gbọdọ̀ kọ gbogbo àwọn ọmọkùnrin ilé rẹ̀ ní ilà; ní ìgbà náà ni ó lè kó ipa gẹ́gẹ́ bí àwọn ọmọ tí a bí ní ilẹ̀ náà. Gbogbo àwọn ọmọkùnrin tí a kò bá kọ ní ilà, wọ́n kò ni jẹ nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.48",
            "verseOrgIds": [
              "EXO.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EXO 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òfin yìí kan náà ni ó mú àwọn ọmọ tí a bí ni ilẹ̀ náà àti àwọn àlejò tí ń gbé ní àárín yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.49",
            "verseOrgIds": [
              "EXO.12.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "EXO 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọmọ Israẹli ṣe gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.50",
            "verseOrgIds": [
              "EXO.12.50"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.50",
                "verseOrgIds": [
                  "EXO.12.50"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ fún Mose àti Aaroni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.50",
            "verseOrgIds": [
              "EXO.12.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "EXO 12:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti pé ní ọjọ́ náà gan an ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.51",
            "verseOrgIds": [
              "EXO.12.51"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.51",
                "verseOrgIds": [
                  "EXO.12.51"
                ]
              }
            }
          ]
        },
        {
          "text": "mú àwọn ọmọ Israẹli jáde kúrò ní ilẹ̀ Ejibiti gẹ́gẹ́ bí ìpín ìpín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.51",
            "verseOrgIds": [
              "EXO.12.51"
            ]
          }
        }
      ]
    }
