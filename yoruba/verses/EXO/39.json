              "attrs": {
                "verseId": "EXO.39.42",
                "verseOrgIds": [
                  "EXO.39.42"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ fún Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.42",
            "verseOrgIds": [
              "EXO.39.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 39:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose bẹ iṣẹ́ náà wò, ó sì rí i wí pé wọ́n ti ṣe é gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.43",
            "verseOrgIds": [
              "EXO.39.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.39.43",
                "verseOrgIds": [
                  "EXO.39.43"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ. Nítorí náà Mose sì bùkún fún wọn.",
