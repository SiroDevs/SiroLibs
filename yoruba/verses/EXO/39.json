          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "aṣọ títa ti àgbàlá pẹ̀lú àwọn òpó rẹ̀ àti àgbàlá, àti aṣọ títa fún ẹnu-ọ̀nà àgbàlá;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.40",
            "verseOrgIds": [
              "EXO.39.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 39:40"
      },
      "items": [
        {
          "text": "ọ̀já àmùrè àti èèkàn àgọ́ fún àgbàlá náà;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.40",
            "verseOrgIds": [
              "EXO.39.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 39:40"
      },
      "items": [
        {
          "text": "gbogbo ohun ọ̀ṣọ́ fún àgọ́, àgọ́ àjọ náà;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.40",
            "verseOrgIds": [
              "EXO.39.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 39:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "aṣọ híhun tí wọ́n ń wọ̀ fún iṣẹ́ ibi mímọ́, aṣọ mímọ́ fún Aaroni àlùfáà àti aṣọ fún àwọn ọmọ rẹ̀ nígbà tí wọ́n bá ń ṣiṣẹ́ àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.41",
            "verseOrgIds": [
              "EXO.39.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
