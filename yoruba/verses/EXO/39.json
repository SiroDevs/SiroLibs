      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 39:39"
      },
      "items": [
        {
          "text": "agbada pẹ̀lú ẹsẹ̀ rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.39",
            "verseOrgIds": [
              "EXO.39.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
