          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 39:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹpẹ idẹ pẹ̀lú idẹ ọlọ, àwọn òpó rẹ̀ àti gbogbo ohun èlò rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.39",
            "verseOrgIds": [
              "EXO.39.39"
            ]
          }
        }
      ]
    },
    {
