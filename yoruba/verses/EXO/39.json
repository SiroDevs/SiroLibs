          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìbòrí awọ àgbò tí a kùn ní pupa, ìbòrí awọ àti ìji aṣọ títa;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.34",
            "verseOrgIds": [
              "EXO.39.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 39:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "àpótí ẹ̀rí pẹ̀lú àwọn òpó rẹ̀ àti ìbòrí àánú;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.35",
            "verseOrgIds": [
              "EXO.39.35"
            ]
          }
        }
      ]
    },
    {
