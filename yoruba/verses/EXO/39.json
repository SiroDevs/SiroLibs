              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli ti ṣe gbogbo iṣẹ́ náà gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.42",
            "verseOrgIds": [
              "EXO.39.42"
            ]
          }
        },
        {
