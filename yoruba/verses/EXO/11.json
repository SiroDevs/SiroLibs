      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikú àwọn àkọ́bí",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.1",
            "verseOrgIds": [
              "EXO.11.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.11.1",
                "verseOrgIds": [
                  "EXO.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé èmi yóò mú ààrùn kan sí i wá sí orí Farao àti ilẹ̀ Ejibiti. Lẹ́yìn náà yóò jẹ́ kí ẹ̀yin kí ó lọ kúrò níhìn-ín yìí, nígbà tí ó bá sì ṣe bẹ́ẹ̀ yóò lé yín jáde pátápátá.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.1",
            "verseOrgIds": [
              "EXO.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọ fún àwọn ènìyàn náà pé kí tọkùnrin tobìnrin wọn béèrè fún ohun èlò fàdákà àti wúrà lọ́wọ́ aládùúgbò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.2",
            "verseOrgIds": [
              "EXO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "(",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.3",
            "verseOrgIds": [
              "EXO.11.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.11.3",
                "verseOrgIds": [
                  "EXO.11.3"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ́ kí wọn rí ojúrere àwọn ará Ejibiti, pàápàá, Mose fúnra rẹ̀ di ènìyàn pàtàkì ní ilẹ̀ Ejibiti ní iwájú àwọn ìjòyè Farao àti ní iwájú àwọn ènìyàn pẹ̀lú).",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.3",
            "verseOrgIds": [
              "EXO.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose wí pé, \"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.4",
            "verseOrgIds": [
              "EXO.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.11.4",
                "verseOrgIds": [
                  "EXO.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ, 'Ní ọ̀gànjọ́ òru èmi yóò la ilẹ̀ Ejibiti kọjá.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.4",
            "verseOrgIds": [
              "EXO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àkọ́bí ọmọkùnrin tí ó wà ní ilẹ̀ Ejibiti ni yóò kùú, bẹ̀rẹ̀ lórí àkọ́bí ọkùnrin Farao tí ó jókòó lórí ìtẹ́ rẹ̀, tí ó fi dé orí àkọ́bí ọmọkùnrin ti ẹrúbìnrin tí ń lọ ọlọ àti gbogbo àkọ́bí ẹran ọ̀sìn pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.5",
            "verseOrgIds": [
              "EXO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igbe ẹkún ńlá yóò sọ jákèjádò gbogbo ilẹ̀ Ejibiti. Irú ohun búburú tí kò ṣẹlẹ̀ rí tí kò sí tún ni ṣẹlẹ̀ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.6",
            "verseOrgIds": [
              "EXO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n láàrín àwọn ará Israẹli ajá lásán kò ní gbó àwọn ènìyàn tàbí àwọn ẹran wọn.' Nígbà náà ni ẹ̀yin yóò mọ̀ pé",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.7",
            "verseOrgIds": [
              "EXO.11.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.11.7",
                "verseOrgIds": [
                  "EXO.11.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fi ìyàtọ̀ sáàrín àwọn ará Ejibiti àti Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.7",
            "verseOrgIds": [
              "EXO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ìjòyè rẹ̀ wọ̀nyí yóò tọ̀ mí wá, wọn yóò wólẹ̀ ni iwájú, mi wọn yóò sì máa wí pé, 'Lọ àti àwọn ènìyàn tí ó tẹ̀lé ọ!' Lẹ́yìn náà èmi yóò jáde.\" Nígbà náà ni Mose fi ìbínú jáde kúrò ní iwájú Farao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.8",
            "verseOrgIds": [
              "EXO.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.11.9",
                "verseOrgIds": [
                  "EXO.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ fún Mose pé, \"Farao yóò kọ̀ láti fetísílẹ̀ sí ọ kí iṣẹ́ ìyanu mí le pọ̀ sí ní Ejibiti.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.9",
            "verseOrgIds": [
              "EXO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose àti Aaroni ṣe àwọn iṣẹ́ ìyanu wọ̀nyí níwájú Farao, ṣùgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.11.10",
                "verseOrgIds": [
                  "EXO.11.10"
                ]
              }
            }
          ]
        },
        {
          "text": "sé ọkàn Farao le, òun kò sí jẹ́ kí àwọn Israẹli jáde kúrò ni orílẹ̀-èdè rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        }
      ]
    }
  ],
