          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì dáhùn pé, gẹ́gẹ́ bí ìwọ ti wí, \"Èmi kí yóò wá sí iwájú rẹ mọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.29",
            "verseOrgIds": [
              "EXO.10.29"
            ]
          }
        }
