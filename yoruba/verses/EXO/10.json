        "style": "s1"
      },
      "items": [
        {
          "text": "Òkùnkùn bo ilẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
