          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí ẹ dáríjì mi lẹ́ẹ̀kan sí i kí ẹ sì gbàdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.17",
            "verseOrgIds": [
