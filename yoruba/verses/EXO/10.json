                "verseOrgIds": [
                  "EXO.10.20"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe àyà Farao le, kò sì jẹ́ kí àwọn ọmọ Israẹli lọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
