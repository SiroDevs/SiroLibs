  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "EXO 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìyọnu Eṣú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.1",
            "verseOrgIds": [
              "EXO.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.1",
                "verseOrgIds": [
                  "EXO.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Lọ sí ọ̀dọ̀ Farao, mo ti ṣé àyà Farao le àti àyà àwọn ìránṣẹ́ rẹ̀, kí èmi kí o ba le ṣe àwọn iṣẹ́ ìyanu mi láàrín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.1",
            "verseOrgIds": [
              "EXO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ̀yin ki ó le sọ fún àwọn ọmọ yín àti àwọn ọmọ ọmọ yín; bí mo ti jẹ àwọn ará Ejibiti ní yà àti bí mo ti ṣe àwọn iṣẹ́ ìyanu láàrín wọn. Kí ìwọ ba á le mọ̀ pé Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.2",
            "verseOrgIds": [
              "EXO.10.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.2",
                "verseOrgIds": [
                  "EXO.10.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.2",
            "verseOrgIds": [
              "EXO.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose àti Aaroni tọ Farao lọ, tiwọn sí wí fún un pé, \"Èyí ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.3",
            "verseOrgIds": [
              "EXO.10.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.3",
                "verseOrgIds": [
                  "EXO.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run àwọn Heberu sọ, 'Yóò ti pẹ́ to ti ìwọ yóò kọ̀ láti tẹrí ara rẹ ba ní iwájú mi? Jẹ́ kí àwọn ènìyàn mi kí ó lọ, kí wọn kí ó sìn mi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.3",
            "verseOrgIds": [
              "EXO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá kọ̀ láti jẹ́ kí wọn lọ, èmi yóò mú eṣú wa sí orílẹ̀-èdè rẹ ní ọ̀la.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.4",
            "verseOrgIds": [
              "EXO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò bo gbogbo ilẹ̀. Wọn yóò ba ohun gbogbo tí ó kù fún ọ lẹ́yìn òjò yìnyín jẹ́, tí ó fi dórí gbogbo igi tí ó ń dàgbà ni ilẹ̀ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.5",
            "verseOrgIds": [
              "EXO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò kún gbogbo ilé rẹ àti ilé àwọn ìjòyè rẹ àti ilé gbogbo àwọn ará Ejibiti. Ohun ti baba rẹ tàbí baba baba rẹ kò tí ì rí láti ìgbà tí wọ́n ti wà ní ilẹ̀ náà títí di àkókò yìí.' \" Nígbà náà ni Mose pẹ̀yìndà kúrò níwájú Farao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.6",
            "verseOrgIds": [
              "EXO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìjòyè Farao sọ fún un, \"Yóò ti pẹ́ to tí ọkùnrin yìí yóò máa jẹ́ ìkẹ́kùn fún wa? Jẹ́ kí àwọn ènìyàn yìí lọ, kí wọn kí ó le sìn",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.7",
            "verseOrgIds": [
              "EXO.10.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.7",
                "verseOrgIds": [
                  "EXO.10.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wọn. Ṣe ìwọ kò ṣe àkíyèsí síbẹ̀ pé, ilẹ̀ Ejibiti ti parun tán?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.7",
            "verseOrgIds": [
              "EXO.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni a mú Aaroni àti Mose padà wá sí iwájú Farao ó sì wí fún wọn pé, \"Ẹ lọ sìn",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.8",
            "verseOrgIds": [
              "EXO.10.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.8",
                "verseOrgIds": [
                  "EXO.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín. Ṣùgbọ́n àwọn ta ni nínú yín ni yóò ha lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.8",
            "verseOrgIds": [
              "EXO.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose dáhùn ó wí pé, \"A ó lọ pẹ̀lú àwọn ọmọdé àti àgbà wa, pẹ̀lú àwọn ọmọ wa ọkùnrin àti ọmọ wa obìnrin pẹ̀lú agbo àgùntàn wa àti agbo màlúù wa nítorí pé a gbọdọ̀ ṣe àjọ fún",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.9",
            "verseOrgIds": [
              "EXO.10.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.9",
                "verseOrgIds": [
                  "EXO.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.9",
            "verseOrgIds": [
              "EXO.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao sì wí pé, \"Mo fi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.10",
            "verseOrgIds": [
              "EXO.10.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.10",
                "verseOrgIds": [
                  "EXO.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "búra pé èmi kí yóò jẹ́ kí ẹ lọ, pẹ̀lú àwọn obìnrin yín àti àwọn ọmọ wẹ́wẹ́, dájúdájú èrò ibi ní ń bẹ nínú yín.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.10",
            "verseOrgIds": [
              "EXO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rárá! Ọkùnrin yín nìkan ni kí ó lọ, láti lọ sin",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.11",
            "verseOrgIds": [
              "EXO.10.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.11",
                "verseOrgIds": [
                  "EXO.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", níwọ̀n ìgbà tí ó jẹ́ pé èyí ni ẹ̀yin ń béèrè fún.\" Wọ́n sì lé Mose àti Aaroni kúrò ní iwájú Farao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.11",
            "verseOrgIds": [
              "EXO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.12",
            "verseOrgIds": [
              "EXO.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.12",
                "verseOrgIds": [
                  "EXO.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose, \"Gbé ọwọ́ rẹ sókè lórí Ejibiti kí ọ̀pọ̀lọpọ̀ eṣú bo gbogbo ilẹ̀, kí ó sì ba gbogbo ohun ọ̀gbìn tí ó wà ni inú oko wọn jẹ́, àní gbogbo ohun tí òjò yìnyín kò bàjẹ́ tan.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.12",
            "verseOrgIds": [
              "EXO.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose na ọ̀pá ọwọ́ rẹ̀ sórí ilẹ̀ Ejibiti,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.13",
            "verseOrgIds": [
              "EXO.10.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.13",
                "verseOrgIds": [
                  "EXO.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": "sì mú kí afẹ́fẹ́ láti ìlà-oòrùn fẹ́ kọjá lórí ilẹ̀ náà ni gbogbo ọ̀sán àti ni gbogbo òru ni ọjọ́ náà. Ní òwúrọ̀ afẹ́fẹ́ náà ti gbá ọ̀pọ̀lọpọ̀ eṣú wá;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.13",
            "verseOrgIds": [
              "EXO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "wọ́n sì bo gbogbo ilẹ̀ Ejibiti, wọ́n wà ní ibi gbogbo ní orí ilẹ̀ ní àìmoye, ṣáájú àkókò yìí kò sí irú ìyọnu eṣú bẹ́ẹ̀ rí, kò sì ní sí irú rẹ mọ́ lẹ́yìn èyí.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.14",
            "verseOrgIds": [
              "EXO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n bo gbogbo ilẹ̀ tí ilẹ̀ fi di dúdú. Wọ́n ba gbogbo ohun tókù ní orí ilẹ̀ lẹ́yìn òjò yìnyín jẹ́; gbogbo ohun ọ̀gbìn tí ó wà ní inú oko àti gbogbo èso tí ó wà lórí igi. Kò sí ewé tí ó kù lórí igi tàbí lórí ohun ọ̀gbìn ní gbogbo ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.15",
            "verseOrgIds": [
              "EXO.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao yára ránṣẹ́ pe Mose àti Aaroni, ó sì sọ fún wọn pé, \"Èmi ti ṣẹ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.16",
            "verseOrgIds": [
              "EXO.10.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.16",
                "verseOrgIds": [
                  "EXO.10.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín àti sí i yín pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.16",
            "verseOrgIds": [
              "EXO.10.16"
            ]
          }
        },
        {
          "name": "verse",
