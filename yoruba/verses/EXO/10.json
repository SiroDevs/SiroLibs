        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.17",
                "verseOrgIds": [
                  "EXO.10.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín kí ó lè mú ìpọ́njú yìí kúrò ní ọ̀dọ̀ mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.17",
