                "verseOrgIds": [
                  "EXO.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "sì yí afẹ́fẹ́ náà padà di afẹ́fẹ́ líle láti apá ìwọ̀-oòrùn wá láti gbá àwọn eṣú náà kúrò ní orí ilẹ̀ Ejibiti lọ sínú Òkun Pupa. Bẹ́ẹ̀ ni ẹyọ eṣú kan kò ṣẹ́kù sí orí ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.19",
            "verseOrgIds": [
