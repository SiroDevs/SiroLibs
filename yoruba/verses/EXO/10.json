          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.27",
                "verseOrgIds": [
                  "EXO.10.27"
                ]
              }
            }
          ]
        },
        {
          "text": "sé ọkàn Farao le, kò sì ṣetán láti jẹ́ kí wọn lọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
              "EXO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao sọ fún Mose pé, \"Kúrò ní iwájú mi! Rí i dájú pé o kò wá sí iwájú mi mọ́! Ọjọ́ tí ìwọ bá rí ojú mi ni ìwọ yóò kùú.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.28",
            "verseOrgIds": [
              "EXO.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
