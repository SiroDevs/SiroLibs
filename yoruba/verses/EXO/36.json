  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "EXO 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "nb"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Besaleli, Oholiabu àti olúkúlùkù ọlọ́gbọ́n ẹni tí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.1",
            "verseOrgIds": [
              "EXO.36.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.36.1",
                "verseOrgIds": [
                  "EXO.36.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tí fún ní ọgbọ́n àti òye láti mọ bí a ti í ṣe gbogbo iṣẹ́ ibi mímọ́ ni kí wọn ṣe iṣẹ́ náà gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.1",
            "verseOrgIds": [
              "EXO.36.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.36.1",
                "verseOrgIds": [
                  "EXO.36.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pa á láṣẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.1",
            "verseOrgIds": [
              "EXO.36.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì pe Besaleli àti Oholiabu àti gbogbo ọlọ́gbọ́n ènìyàn ẹni tí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.2",
            "verseOrgIds": [
              "EXO.36.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.36.2",
                "verseOrgIds": [
                  "EXO.36.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fún ni agbára àti gbogbo ẹni tí ó fẹ́ láti wá sé iṣẹ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.2",
            "verseOrgIds": [
              "EXO.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n gba gbogbo ọrẹ tí àwọn ọmọ Israẹli ti mú wá lọ́wọ́ Mose fún kíkọ́ ibi mímọ́ náà. Àwọn ènìyàn sì ń mú ọrẹ àtinúwá wá ní àràárọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.3",
            "verseOrgIds": [
              "EXO.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni gbogbo àwọn ọlọ́gbọ́n oníṣẹ́-ọnà tí wọn ń ṣe gbogbo iṣẹ́ ibi mímọ́ náà fi iṣẹ́ wọn sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.4",
            "verseOrgIds": [
              "EXO.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì wí pé, \"Àwọn ènìyàn mú púpọ̀ wá fún ṣíṣe iṣẹ́ náà ju bi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.5",
            "verseOrgIds": [
              "EXO.36.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.36.5",
                "verseOrgIds": [
                  "EXO.36.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pa á láṣẹ láti ṣe lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.5",
            "verseOrgIds": [
              "EXO.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì pàṣẹ, wọ́n sì rán iṣẹ́ yìí sí gbogbo ibùdó: \"Kí ọkùnrin tàbí obìnrin má ṣe ṣe ohun kankan bí ọrẹ fún ibi mímọ́ náà mọ́.\" Bẹ́ẹ̀ ni a dá àwọn ènìyàn lẹ́kun láti mú un wá sí i,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.6",
            "verseOrgIds": [
              "EXO.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí ohun tí wọ́n ti ní ti ju ohun tí wọn fẹ́ fi ṣe gbogbo iṣẹ́ náà lọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.7",
            "verseOrgIds": [
              "EXO.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àgọ́ náà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọlọ́gbọ́n ọkùnrin láàrín àwọn òṣìṣẹ́ ni wọ́n ṣe iṣẹ́ náà pẹ̀lú aṣọ títa mẹ́wàá ti ọ̀gbọ̀ olókùn dáradára, tí aṣọ aláró, ti elése àlùkò àti ti òdòdó, pẹ̀lú àwọn kérúbù ṣe iṣẹ́ sí wọn nípa ọgbọ́n iṣẹ́ ọnà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.8",
            "verseOrgIds": [
              "EXO.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo aṣọ títa náà ni kí ó jẹ́ ìwọ̀n kan náà: ìgbọ̀nwọ́ méjìdínlọ́gbọ̀n (28) ní gígùn àti ìgbọ̀nwọ́ mẹ́rin ni fífẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.9",
            "verseOrgIds": [
              "EXO.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aṣọ títa márùn-ún ni kí a so papọ̀ mọ́ ara wọn, àti aṣọ títa márùn-ún ni kí a so papọ̀ mọ́ ara wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.10",
            "verseOrgIds": [
              "EXO.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò ṣì ṣe ajábó aṣọ aláró sí aṣọ títa kan láti ìṣẹ́tí rẹ̀ wá níbi ìsopọ̀, àti bẹ́ẹ̀ gẹ́gẹ́ ni ìwọ yóò ṣe ni etí ìkangun aṣọ títa kejì, ni ibi ìsopọ̀ kejì.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.11",
            "verseOrgIds": [
              "EXO.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àádọ́ta ajábó ní ó pa lára aṣọ títa kan, àti àádọ́ta ajábó ni ó sì lò pa ní etí aṣọ títa tí ó wà ní ìsolù kejì, ajábó náà sì wà ní ọ̀kánkán ara wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.12",
            "verseOrgIds": [
              "EXO.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe àádọ́ta ìkọ́ wúrà, ó sì lò ìkọ́ wọ̀n-ọn-nì láti fi aṣọ títa kan kọ́ èkejì, bẹ́ẹ̀ ó sì di odidi àgọ́ kan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.13",
            "verseOrgIds": [
              "EXO.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ó sì ṣe aṣọ títa irun ewúrẹ́ láti fi ṣe ìbò sórí àgọ́ náà—aṣọ títa mọ́kànlá ni ìwọ ó ṣe é.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.14",
            "verseOrgIds": [
              "EXO.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo aṣọ títa mọ́kọ̀ọ̀kànlá náà jẹ́ ìwọ̀n kan náà, ọgbọ̀n ìgbọ̀nwọ́ ní gígùn àti ìgbọ̀nwọ́ mẹ́rin ní fífẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.15",
            "verseOrgIds": [
              "EXO.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó so aṣọ títa márùn-ún pọ̀ mọ́ ara wọn se ọ̀kan, ó sì tún so mẹ́fà tókù mọ́ ara wọn se ọ̀kan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.16",
            "verseOrgIds": [
              "EXO.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì pa àádọ́ta ajábó sí ìṣẹ́tí ìkangun aṣọ títa ní apá kan, wọ́n sì tún pa ajábó mìíràn sí ìṣẹ́tí ìkangun aṣọ títa ní apá kejì.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.17",
            "verseOrgIds": [
              "EXO.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n ṣe àádọ́ta ìkọ́ idẹ láti so àgọ́ náà pọ̀ kí o lè jẹ́ ọ̀kan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.18",
            "verseOrgIds": [
              "EXO.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe ìbòrí awọ àgbò tí a rì ní pupa fún àgọ́ náà, àti ìbòrí awọ seali sórí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.19",
            "verseOrgIds": [
              "EXO.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe pákó igi kasia tí ó dúró òró fún àgọ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.20",
            "verseOrgIds": [
              "EXO.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀kọ̀ọ̀kan pákó náà jẹ́ ìgbọ̀nwọ́ mẹ́wàá ní gígùn àti ìgbọ̀nwọ́ kan ààbọ̀ ní fífẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.21",
            "verseOrgIds": [
              "EXO.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "pẹ̀lú ìtẹ̀bọ̀ méjì tí ó kọjú sí ara wọn. Wọ́n ṣe gbogbo pákó àgọ́ náà bí èyí.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.22",
            "verseOrgIds": [
              "EXO.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe ogún pákó sí ìhà gúúsù àgọ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.23",
            "verseOrgIds": [
              "EXO.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe ogójì fàdákà ihò ìtẹ̀bọ̀ lọ sí ìsàlẹ̀ wọn ìtẹ̀bọ̀ méjì fún pákó kọ̀ọ̀kan, ọ̀kọ̀ọ̀kan ní ìsàlẹ̀ ìtẹ̀bọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.24",
            "verseOrgIds": [
              "EXO.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ìhà kejì, ìhà àríwá àgọ́ náà, wọ́n ṣe ogún pákó",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.25",
            "verseOrgIds": [
              "EXO.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti ogójì ihò ìtẹ̀bọ̀ fàdákà méjì ní abẹ́ pákó kọ̀ọ̀kan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.26",
            "verseOrgIds": [
              "EXO.36.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe pákó mẹ́fà sì ìkangun, ní ìkangun ìhà ìwọ̀-oòrùn àgọ́ náà,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.27",
            "verseOrgIds": [
              "EXO.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "pákó méjì ni ìwọ ó ṣe fún igun àgọ́ náà ní ìhà ẹ̀yìn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.28",
            "verseOrgIds": [
              "EXO.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní igun méjèèjì yìí, pákó méjì ni ó wà níbẹ̀ láti ìdí dé orí rẹ̀ wọ́n sì kó wọ́n sí òrùka kan; méjèèjì rí bákan náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.29",
            "verseOrgIds": [
              "EXO.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n ó sì jẹ́ pákó mẹ́jọ, àti ihò ìtẹ̀bọ̀ fàdákà mẹ́rìnlélógún, méjì wà ní ìsàlẹ̀ ọ̀kọ̀ọ̀kan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.30",
            "verseOrgIds": [
              "EXO.36.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe ọ̀pá igi kasia márùn-ún fún pákó ìhà kan àgọ́ náà,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.31",
            "verseOrgIds": [
              "EXO.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "márùn-ún fún àwọn tí ó wà ní ìhà kejì, márùn-ún fún pákó tí ó wà ní ìhà ìwọ̀-oòrùn ní ìkangun àgọ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.32",
            "verseOrgIds": [
              "EXO.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì ṣe ọ̀pá àárín tí yóò fi jáde láti ìkangun dé ìkangun ní àárín àwọn pákó náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.33",
            "verseOrgIds": [
              "EXO.36.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì bo àwọn pákó pẹ̀lú wúrà, wọ́n sì ṣe àwọn òrùka wúrà láti gbá ọ̀pá náà mú. Wọ́n sì tún bo ọ̀pá náà pẹ̀lú wúrà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.34",
            "verseOrgIds": [
              "EXO.36.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 36:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe aṣọ títa aláró, àti elése àlùkò, àti òdòdó, àti ọ̀gbọ̀ olókùn wẹ́wẹ́ tí í ṣe ọlọ́nà, tí òun ti àwọn kérúbù ni kí á ṣe é.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.35",
            "verseOrgIds": [
              "EXO.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì ṣe òpó igi ṣittimu mẹ́rin fún un wọ́n sì bò wọ́n pẹ̀lú wúrà. Wọ́n sì ṣe àwọn ìkọ́ wúrà fún wọn, wọ́n sì dá ihò ìtẹ̀bọ̀ fàdákà mẹ́rin mẹ́rin fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.36",
            "verseOrgIds": [
              "EXO.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ẹnu-ọ̀nà àgọ́ náà wọ́n ṣe aṣọ títa ti aṣọ aláró, ti elése àlùkò, ti òdòdó àti ti ọ̀gbọ̀ olókùn dáradára tí a fi iṣẹ́ abẹ́rẹ́ ṣe;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.37",
            "verseOrgIds": [
              "EXO.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe òpó márùn-ún pẹ̀lú ìkọ́ wọn. Ó bo orí àwọn òpó náà àti ìgbànú wọn pẹ̀lú wúrà, ó sì fi idẹ ṣe ihò ìtẹ̀bọ̀ wọn márààrún.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.38",
            "verseOrgIds": [
              "EXO.36.38"
            ]
          }
        }
      ]
    }
