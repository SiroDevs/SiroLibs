  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "EXO 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdáàbòbò ohun ìní",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ọkùnrin kan bá jí akọ màlúù tàbí àgùntàn, tí ó sì pa á tàbí tà á. Ó gbọdọ̀ san akọ màlúù márùn-ún padà fún ọ̀kan tí ó jí, àti àgùntàn mẹ́rin mìíràn fún ọ̀kan tí ó jí.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.1",
            "verseOrgIds": [
              "EXO.21.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí a bá mú olè níbi ti ó ti ń fọ́lé, ti a sì lù ú pa, ẹni tí ó lù ú pa náà kò ní ẹ̀bi ìtàjẹ̀ sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.2",
            "verseOrgIds": [
              "EXO.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ti ó bá ṣẹlẹ̀ ni ojú ọ̀sán, a ó kà á si ìpànìyàn. Ọkùnrin ti ó lù ú pa náà yóò ni ẹ̀bi ìtàjẹ̀ sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 22:3"
      },
      "items": [
        {
          "text": "\"Olè gbọdọ̀ san ohun tí ó jí padà. Ṣùgbọ́n tí kò bá ni ohun ti ó lè fi san án padà, a ó tà á, a ó sì fi sanwó ohun tí ó jí gbé padà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí a bá rí ẹran tí ó jí gbé náà ni ọwọ́ rẹ̀ ní ààyè: ìbá ṣe akọ màlúù, akọ kẹ́tẹ́kẹ́tẹ́ tàbí àgùntàn, yóò san án padà ní ìlọ́po méjì.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.4",
            "verseOrgIds": [
              "EXO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ọkùnrin kan bá ń bọ́ ẹran ọ̀sìn rẹ̀ lórí pápá tàbí nínú ọgbà àjàrà, tí ó sì jẹ́ kí ó lọ jẹ nínú oko ẹlòmíràn, a ó mú kí ó san ohun ti ẹran rẹ̀ jẹ padà pẹ̀lú èyí tí ó dára jù nínú oko tàbí nínú ọgbà rẹ̀ (ẹlòmíràn padà fún un).",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.5",
            "verseOrgIds": [
              "EXO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí iná bá ṣẹ́ tí ó kán lu igbó tí ó sì jó àká ọkà tàbí gbogbo oko náà, ẹni tí iná ṣẹ́ lọ́wọ́ rẹ̀ yóò san ohun tí iná ti ó ṣẹ́ jó padà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.6",
            "verseOrgIds": [
              "EXO.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ọkùnrin kan bá fún aládùúgbò rẹ̀ ní fàdákà tàbí ohun èlò fún ìtọ́jú, ti wọ́n sì jí gbé lọ́dọ̀ aládùúgbò rẹ̀, tí a bá mú irú olè bẹ́ẹ̀, yóò san án padà ní ìlọ́po méjì.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.7",
            "verseOrgIds": [
              "EXO.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ti a kò bá rí olè náà mú, baálé ilé náà yóò fi ara hàn níwájú ìdájọ́ láti jẹ́ kí a mọ̀ bí òun fúnra rẹ̀ ni ó gbé ohun ti ó sọnù náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.8",
            "verseOrgIds": [
              "EXO.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹnìkan bá ni akọ màlúù, kẹ́tẹ́kẹ́tẹ́, àgùntàn, aṣọ tàbí ohun ìní mìíràn tí ó sọnù ní ọ̀nà ti kò bá òfin mu, tí a sì rí ẹni ti ó sọ pé òun ni ó ní ín, àwọn méjèèjì yóò mú ẹjọ́ wọn wá sí iwájú adájọ́. Ẹnikẹ́ni tí adájọ́ bá dá lẹ́bi yóò san án ni ìlọ́po méjì padà fún ẹnìkejì rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.9",
            "verseOrgIds": [
              "EXO.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ẹnikẹ́ni bá fún aládùúgbò rẹ̀ ní kẹ́tẹ́kẹ́tẹ́, akọ màlúù, àgùntàn tàbí ẹranko mìíràn láti bá òun tọ́jú rẹ̀, tí ó sì kú, tàbí tí ó fi ara pa, tàbí tí a jí gbé, níbi tí kò ti sí ẹni tí o ṣe àkíyèsí.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.10",
            "verseOrgIds": [
              "EXO.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò búra sí ọ̀rọ̀ náà láàrín ara wọn ni iwájú",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.11",
            "verseOrgIds": [
              "EXO.22.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.22.11",
                "verseOrgIds": [
                  "EXO.22.10"
                ]
              }
            }
          ]
        },
        {
          "text": "láti fihàn pé òun kò ní ọwọ́ nínú sísọnù ohun ọ̀sìn náà, olóhun gbọdọ̀ gba bẹ́ẹ̀, a kò sì ní san ohunkóhun fún un.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.11",
            "verseOrgIds": [
              "EXO.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ti wọ́n bá jí ẹranko náà gbé ni ọ̀dọ̀ aládùúgbò rẹ̀, yóò san ẹ̀san padà fún olúwa rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.12",
            "verseOrgIds": [
              "EXO.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹranko búburú bá fà á ya, ó ní láti mú àyakù ẹran náà wá gẹ́gẹ́ bí ẹ̀rí, kò sì ní san ẹran náà padà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.13",
            "verseOrgIds": [
              "EXO.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ẹnìkan bá sì yá ẹranko lọ́dọ̀ aládùúgbò rẹ̀, tí ẹranko náà sì fi ara pa, tàbí kí ó kú nígbà tí ẹni tí ó ni í kò sí nítòsí. O gbọdọ̀ san án padà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.14",
            "verseOrgIds": [
              "EXO.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ti ó bá jẹ́ wí pé olóhun bá wà pẹ̀lú ẹranko náà, ẹni tí ó ya lò kò ní san ẹ̀san padà. Bí a bá yá ẹranko náà lò, owó tí ó fi yá a lò ni yóò fi tan àdánù ẹranko tí ó kú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.15",
            "verseOrgIds": [
              "EXO.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìlànà ojúṣe ẹni láwùjọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ọkùnrin kan bá fi àrékérekè mú wúńdíá kan, ẹni tí kò pinnu láti fẹ́, tí ó sì bá a lòpọ̀, yóò san owó orí rẹ̀, yóò sì fi ṣe aya rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí baba ọmọbìnrin náà bá kọ̀ jálẹ̀ láti fi fún un ní aya, ó ni láti san owó tó tó owó orí rẹ̀ fún fífẹ́ ẹ ní wúńdíá.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Má ṣe jẹ́ kí àjẹ́ kí ó wà láààyè.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.18",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹnikẹ́ni ti ó bá bá ẹranko lòpọ̀ ní a ó pa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.19",
            "verseOrgIds": [
              "EXO.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹnikẹ́ni ti ó bá rú ẹbọ sí òrìṣà yàtọ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.20",
            "verseOrgIds": [
              "EXO.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.22.20",
                "verseOrgIds": [
                  "EXO.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "nìkan, ni a ó yà sọ́tọ̀ fún ìparun.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.20",
            "verseOrgIds": [
              "EXO.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ má ṣe fi ìyà jẹ àlejò tàbí ni wọ́n lára, nítorí ìwọ pẹ̀lú ti jẹ́ àjèjì ni ilẹ̀ Ejibiti rí.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
            "verseOrgIds": [
              "EXO.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Má ṣe yan opó tàbí ọmọ òrukàn jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.22",
            "verseOrgIds": [
              "EXO.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá ṣe bẹ́ẹ̀, bí wọn bá ké pè mi. Èmi yóò sì gbọ́ ohùn igbe wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.23",
            "verseOrgIds": [
              "EXO.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbínú mi yóò ru sókè. Èmi yóò sì fi idà pa ọ. Ìyàwó rẹ yóò di opó, àwọn ọmọ rẹ yóò sì di aláìní baba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.24",
            "verseOrgIds": [
              "EXO.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ìwọ bá yá ọ̀kan nínú àwọn ènìyàn mi tí ìyà ń jẹ láàrín yín lówó, má ṣe dàbí ayánilówó, kí o má sì gba èlé.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.25",
            "verseOrgIds": [
              "EXO.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá gba aṣọ aládùúgbò rẹ ni ẹ̀jẹ́, ìwọ gbọdọ̀ fún un padà kí oòrùn tó ó wọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
              "EXO.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí aṣọ yìí nìkan ní ó ní ti ó lè fi bo àṣírí ara. Kí ni ohun mìíràn ti yóò fi sùn? Nígbà ti ó bá gbé ohun rẹ̀ sókè sí mi, èmi yóò gbọ́ nítorí aláàánú ni èmi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.27",
            "verseOrgIds": [
              "EXO.22.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ kò gbọdọ̀ sọ̀rọ̀-òdì sí Ọlọ́run tàbí gégùn lé orí ìjòyè àwọn ènìyàn rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.28",
            "verseOrgIds": [
              "EXO.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ kò gbọdọ̀ lọ́ra láti mú ọrẹ wá fún mi láti inú ìre oko rẹ àti láti inú wáìnì rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 22:29"
      },
      "items": [
        {
          "text": "\"Àkọ́bí ọmọ rẹ ọkùnrin ni ìwọ yóò fi fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣe bẹ́ẹ̀ gẹ́gẹ́ pẹ̀lú agbo màlúù rẹ àti agbo àgùntàn rẹ. Jẹ́ kí wọn wà lọ́dọ̀ ìyá wọn fún ọjọ́ méje, kí ìwọ kí ó sì fi wọ́n fún mi ní ọjọ́ kẹjọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ̀yin yóò jẹ́ ènìyàn mímọ́ mi. Nítorí náà má ṣe jẹ ẹran ti ẹranko búburú fàya: ẹ fi fún ajá jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.31",
            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        }
      ]
    }
  ],
