  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1CO 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí èmí tọ̀ yín wá, ẹ̀yin ará, kì í ṣe nípa ọ̀rọ̀ gíga àti ọgbọ́n gíga ni mo fi bá yín sọ̀rọ̀, nígbà tí èmi ń sọ̀rọ̀ ohun ìjìnlẹ̀ Ọlọ́run fún un yín.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.1",
            "verseOrgIds": [
              "1CO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ti pinnu láti má mọ ohunkóhun nígbà ti mo wà láàrín yín bí kò ṣe Jesu Kristi, ẹni tí a kàn mọ́ àgbélébùú.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.2",
            "verseOrgIds": [
              "1CO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi sì tọ̀ yín wá ni àìlera, àti ní ẹ̀rù, àti ní ọ̀pọ̀lọpọ̀ ìwárìrì.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.3",
            "verseOrgIds": [
              "1CO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwàásù mi àti ẹ̀kọ́ mi, kì í ṣe nípa ọgbọ́n ènìyàn àti ọ̀rọ̀ tí a fi ń yí ènìyàn lọ́kàn padà, bí kò ṣe nípa ìfihàn agbára Ẹ̀mí.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.4",
            "verseOrgIds": [
              "1CO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ìgbàgbọ́ yín kí ó má ṣe dúró lórí ọgbọ́n ènìyàn, ṣùgbọ́n kí ó dúró lórí agbára Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.5",
            "verseOrgIds": [
              "1CO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọgbọ́n láti ọ̀dọ̀ ẹ̀mí wá",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwa ń sọ̀rọ̀ ọgbọ́n láàrín àwọn tí a pè, ṣùgbọ́n kì í ṣe ọgbọ́n ti ayé yìí tàbí ti àwọn olórí ayé yìí, èyí tí yóò di asán.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.6",
            "verseOrgIds": [
              "1CO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ kọ́, àwa ń sọ̀rọ̀ ọgbọ́n ti Ọlọ́run tó fi ara sin, ọgbọ́n tí ó ti fi ara pamọ́, èyí tí Ọlọ́run ti lànà sílẹ̀ ṣáájú ìpilẹ̀ṣẹ̀ ayé fún ògo wa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.7",
            "verseOrgIds": [
              "1CO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ti ẹnikẹ́ni nínú àwọn aláṣẹ ayé yìí kò mọ̀. Ìbá ṣe pé wọ́n mọ̀ ọ́n, wọn kì bá tún kan Olúwa ògo mọ́ àgbélébùú.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.8",
            "verseOrgIds": [
              "1CO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí a ti kọ ọ́ pé:",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 2:9"
      },
      "items": [
        {
          "text": "\"Ojú kò tí ì rí,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 2:9"
      },
      "items": [
        {
          "text": "etí kò tí í gbọ́,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 2:9"
      },
      "items": [
        {
          "text": "kò sì ọkàn ènìyàn tí ó tí í mọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 2:9"
      },
      "items": [
        {
          "text": "ohun tí Ọlọ́run tí pèsè sílẹ̀ fún àwọn tí o fẹ́ ẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Ọlọ́run ti fi í hàn fún wa nípasẹ̀ Ẹ̀mí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.10",
            "verseOrgIds": [
              "1CO.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CO 2:10"
      },
      "items": [
        {
          "text": "Ẹ̀mí á máa wádìí ohun gbogbo, kódà àwọn àṣírí Ọlọ́run tó jinlẹ̀ jùlọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.10",
            "verseOrgIds": [
              "1CO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni nínú ènìyàn tí ó mọ èrò ọkàn ènìyàn kan, bí kò ṣe ẹ̀mí ènìyàn tí ó wà nínú rẹ̀? Bákan náà, kò sí ẹni ti ó mọ àwọn èrò Ọlọ́run, bí kò ṣe Ẹ̀mí Ọlọ́run fúnra rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.11",
            "verseOrgIds": [
              "1CO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa kò gbà ẹ̀mí ti ayé yìí, bí kò ṣe Ẹ̀mí ẹni tí ó ti ọ̀dọ̀ Ọlọ́run wa, kí a lè ní òye ohun tí Ọlọ́run fi fún wa lọ́fẹ̀ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.12",
            "verseOrgIds": [
              "1CO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni àwa ń wí, kì í ṣe èyí tí a ń kọ nípa ọ̀rọ̀ ọgbọ́n ènìyàn, ṣùgbọ́n èyí tí Ẹ̀mí Mímọ́ fi ń kọ ènìyàn, èyí tí a ń fi ohun Ẹ̀mí wé ohun Ẹ̀mí.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.13",
            "verseOrgIds": [
              "1CO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ènìyàn nípa ti ara kò gba ohun ti Ẹ̀mí Ọlọ́run wọ̀n-ọn-nì, nítorí pé wèrè ni wọ́n jásí fún un, òun kò sì le mọ̀ wọ́n, nítorí nípa tí Ẹ̀mí ní a fi ń wádìí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.14",
            "verseOrgIds": [
              "1CO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹni tí ó wà nípa ti ẹ̀mí ń wádìí ohun gbogbo, ṣùgbọ́n kò sí ẹnikẹ́ni tí í wádìí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.15",
            "verseOrgIds": [
              "1CO.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí ta ni ó mọ ọkàn Olúwa,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.16",
            "verseOrgIds": [
              "1CO.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 2:16"
      },
      "items": [
        {
          "text": "ti yóò fi máa kọ́ Ọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.16",
            "verseOrgIds": [
              "1CO.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1CO 2:16"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n àwa ní inú Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.16",
            "verseOrgIds": [
              "1CO.2.16"
            ]
          }
        }
      ]
    }
  ],
