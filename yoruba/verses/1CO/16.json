  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "1CO 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìkójọpọ̀ fún àwọn ènìyàn Ọlọ́run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ ní ti ìdáwó fún àwọn ènìyàn mímọ́, bí mo tí wí fún àwọn ìjọ Galatia, bẹ́ẹ̀ gẹ́gẹ́ ní kí ẹ ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.1",
            "verseOrgIds": [
              "1CO.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kìn-ín-ní ọ̀sẹ̀, kí olúkúlùkù yín fi sínú ìṣúra lọ́dọ̀ ara rẹ̀ ni apá kan, gẹ́gẹ́ bí Ọlọ́run ti ṣe rere fún ún, ki ó má ṣe si ìkójọ nígbà tí mo bá dé.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.2",
            "verseOrgIds": [
              "1CO.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti nígbà ti mo bá dé, àwọn ẹni tí ẹ bá yàn, àwọn ni èmi ó rán láti mú ẹ̀bùn yín gòkè lọ si Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.3",
            "verseOrgIds": [
              "1CO.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá sì yẹ kí èmí lọ pẹ̀lú, wọn ó sì bá mi lọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.4",
            "verseOrgIds": [
              "1CO.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìbéèrè ti ara ẹni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èmi yóò tọ̀ yin wá, nígbà tí èmí bá ti kọjá láàrín Makedonia: nítorí èmi yóò kọjá láàrín Makedonia.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.5",
            "verseOrgIds": [
              "1CO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bóyá èmi ó sì dúró pẹ̀lú yín, tàbí kí n tilẹ̀ lo àkókò òtútù, ki ẹ̀yin lé sìn mí ni ọ̀nà àjò mí, níbikíbi tí mo bá ń lọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.6",
            "verseOrgIds": [
              "1CO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èmi kò fẹ́ kan ri yín kí èmi sì ṣe bẹ́ẹ̀ kọjá lọ; nítorí èmi ń retí àti dúró lọ́dọ̀ yín díẹ̀, bí Olúwa bá fẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.7",
            "verseOrgIds": [
              "1CO.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èmi yóò dúró ni Efesu títí dí Pentikosti.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.8",
            "verseOrgIds": [
              "1CO.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ìlẹ̀kùn ńlá láti ṣe iṣẹ́ gidi ṣí sílẹ̀ fún mí, ọ̀pọ̀lọpọ̀ sì ni àwọn ọ̀tá tí ń bẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.9",
            "verseOrgIds": [
              "1CO.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ bí Timotiu bá dé, ẹ jẹ́ kí ó wà lọ́dọ̀ yín láìbẹ̀rù, nítorí òun ń ṣé iṣẹ́ Olúwa, bí èmi pẹ̀lú ti ń ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.10",
            "verseOrgIds": [
              "1CO.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà kí ẹnikẹ́ni má ṣe kẹ́gàn rẹ̀. Ṣùgbọ́n ẹ sín ín jáde lọ́nà àjò ni àlàáfíà, kí òun lè tọ̀ mí wá; nítorí tí èmí ń fi ojú sí ọ̀nà fún wíwá rẹ̀ pẹ̀lú àwọn arákùnrin.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.11",
            "verseOrgIds": [
              "1CO.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ní ti Apollo arákùnrin wa, mo bẹ̀ ẹ́ púpọ̀ láti tọ̀ yín wá pẹ̀lú àwọn arákùnrin, ṣùgbọ́n kì í ṣe ìfẹ́ rẹ̀ rárá láti wà nísinsin yìí, ṣùgbọ́n òun yóò wá nígbà tí ààyè bá ṣí sílẹ̀ fún un.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.12",
            "verseOrgIds": [
              "1CO.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ máa ṣọ́ra, ẹ dúró ṣinṣin nínú ìgbàgbọ́, ẹ ṣe bi ọkùnrin tí ó ní ìgboyà, ẹ jẹ́ alágbára.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.13",
            "verseOrgIds": [
              "1CO.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ máa ṣe ohun gbogbo nínú ìfẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.14",
            "verseOrgIds": [
              "1CO.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ mo bẹ̀ yín ará, ẹ ṣá mọ ilé Stefana pé, àwọn ni ẹni àkọ́kọ́ tó gba Jesu ní Akaia, àti pé, wọn sì tí fi ará wọn fún iṣẹ́ ìránṣẹ́ àwọn ènìyàn mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.15",
            "verseOrgIds": [
              "1CO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ̀yin tẹríba fún irú àwọn báwọ̀nyí, àti fún olúkúlùkù olùbáṣiṣẹ́ pọ̀ pẹ̀lú wa tí ó sì ń ṣe làálàá.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.16",
            "verseOrgIds": [
              "1CO.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo láyọ̀ fún wíwá Stefana àti Fortunatu àti Akaiku, nítorí èyí tí ó kù nípá tí yín wọ́n ti fi kún un.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.17",
            "verseOrgIds": [
              "1CO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí wọ́n tu ẹ̀mí mí lára àti tiyín: nítorí náà, ẹ máa gba irú àwọn ti ó rí bẹ́ẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.18",
            "verseOrgIds": [
              "1CO.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìkíni ìkẹyìn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìjọ ni Asia kí í yín.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.19",
            "verseOrgIds": [
              "1CO.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CO 16:19"
      },
      "items": [
        {
          "text": "Akuila àti Priskilla kí í yín púpọ̀ nínú Olúwa, pẹ̀lú ìjọ tí ó wà ni ilé wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.19",
            "verseOrgIds": [
              "1CO.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn arákùnrin kí í yín.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.20",
            "verseOrgIds": [
              "1CO.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CO 16:20"
      },
      "items": [
        {
          "text": "Ẹ fi ìfẹnukonu mímọ́ kí ara yín.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.20",
            "verseOrgIds": [
              "1CO.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìkíni ti èmi Paulu, láti ọwọ́ èmi tìkára mi wá.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.21",
            "verseOrgIds": [
              "1CO.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹnikẹ́ni kò bá ní ìfẹ́ Jesu Kristi Olúwa, jẹ́ kí ó dì ẹni ìfibú. Máa bọ Olúwa wa!",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.22",
            "verseOrgIds": [
              "1CO.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oore-ọ̀fẹ́ Jesu Kristi Olúwa kí ó wà pẹ̀lú yín!",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.23",
            "verseOrgIds": [
              "1CO.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìfẹ́ mi wá pẹ̀lú gbogbo yín nínú Kristi Jesu. Àmín.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.24",
            "verseOrgIds": [
              "1CO.16.24"
            ]
          }
        }
      ]
    }
  ],
