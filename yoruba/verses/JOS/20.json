    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ìlú ààbò",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.1",
            "verseOrgIds": [
              "JOS.20.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.20.1",
                "verseOrgIds": [
                  "JOS.20.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Joṣua pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.1",
            "verseOrgIds": [
              "JOS.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún àwọn ọmọ Israẹli pé kí wọn yan àwọn ìlú ààbò, gẹ́gẹ́ bí mo ti pàṣẹ fún ọ láti ẹnu Mose,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
              "JOS.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí ẹni tí ó bá ṣèèṣì pa ènìyàn tàbí tí ó bá pa ènìyàn láìmọ̀-ọ́n-mọ̀ lè sálọ sí ibẹ̀, fún ààbò lọ́wọ́ olùgbẹ̀san ẹ̀jẹ̀ ẹni tí ó pa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.3",
            "verseOrgIds": [
              "JOS.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó bá sálọ sí ọ̀kan nínú àwọn ìlú wọ̀nyí, yóò sì dúró ní ẹnu-ọ̀nà àtiwọ ibodè ìlú, kí ó sì ṣe àlàyé ara rẹ̀ ní iwájú àwọn àgbàgbà ìlú náà. Nígbà náà ni wọn yóò gbà á sí ìlú wọn, wọn yóò sì fun ní ibùgbé láàrín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.4",
            "verseOrgIds": [
              "JOS.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí olùgbẹ̀san ẹ̀jẹ̀ bá ń lépa rẹ̀, wọn kò gbọdọ̀ fi àwọn ọ̀daràn náà lé wọn lọ́wọ́, nítorí tí ó pa aládùúgbò rẹ̀ láìmọ̀, tí kò sì kórìíra rẹ̀ tẹ́lẹ̀ rí.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.5",
            "verseOrgIds": [
              "JOS.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ó sì máa gbé inú ìlú náà, títí yóò fi jẹ́jọ́ níwájú ìjọ ènìyàn àti títí ikú olórí àlùfáà tí ó ń ṣiṣẹ́ ìsìn nígbà náà. Nígbà náà ó lè padà sí ilé rẹ̀ ní ìlú tí ó ti sá wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni wọ́n yan Kedeṣi ní Galili ní ìlú òkè Naftali, Ṣekemu ní ìlú òkè Efraimu, àti Kiriati-Arba (tí í ṣe, Hebroni) ní ìlú òkè Juda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìhà ìlà-oòrùn Jordani ti Jeriko, wọ́n ya Beseri ní aginjù ní pẹ̀tẹ́lẹ̀ ní ẹ̀yà Reubeni, Ramoti ní Gileadi ní ẹ̀yà Gadi, àti Golani ní Baṣani ní ẹ̀yà Manase.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.8",
            "verseOrgIds": [
              "JOS.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni nínú àwọn ọmọ Israẹli tàbí àlejò tí ń gbé ní àárín wọn tí ó ṣèèṣì pa ẹnìkan lè sálọ sí àwọn ìlú tí a yà sọ́tọ̀ wọ̀nyí, kí olùgbẹ̀san ẹ̀jẹ̀ má sì ṣe pa á kí ó to di àkókò tí yóò jẹ́jọ́ níwájú ìjọ ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.9",
            "verseOrgIds": [
              "JOS.20.9"
            ]
          }
        }
      ]
    }
  ],
