            "sid": "JOS 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì sọ fún Joṣua, \"Nítòótọ́ ni",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.24",
            "verseOrgIds": [
              "JOS.2.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.2.24",
                "verseOrgIds": [
                  "JOS.2.24"
                ]
              }
            }
          ]
        },
        {
          "text": "tí fi gbogbo ilẹ̀ náà lé wa lọ́wọ́; gbogbo olùgbé ilẹ̀ náà ni ìbẹ̀rùbojo ti mú nítorí i wa.\"",
          "type": "text",
          "attrs": {
