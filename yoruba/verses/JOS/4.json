  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JOS 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí gbogbo orílẹ̀-èdè náà kọjá nínú odò Jordani tan,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.1",
            "verseOrgIds": [
              "JOS.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.1",
                "verseOrgIds": [
                  "JOS.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Joṣua pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.1",
            "verseOrgIds": [
              "JOS.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yan ọkùnrin méjìlá nínú àwọn ènìyàn, ẹnìkan nínú ẹ̀yà kọ̀ọ̀kan,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.2",
            "verseOrgIds": [
              "JOS.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí o sì pàṣẹ fún wọn pé, 'Ẹ gbé òkúta méjìlá láti àárín odò Jordani ní ibi tí àwọn àlùfáà dúró sí, kí ẹ sì rù wọn kọjá, kí ẹ sì gbé wọn sí ibi tí ẹ̀yin yóò sùn ní alẹ́ yìí.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.3",
            "verseOrgIds": [
              "JOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Joṣua pe àwọn ọkùnrin méjìlá tí ó ti yàn nínú àwọn ọmọ Israẹli, ẹnìkan nínú ẹ̀yà kọ̀ọ̀kan,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.4",
            "verseOrgIds": [
              "JOS.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó sì wí fún wọn pé, \"Ẹ kọjá lọ ní iwájú àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.5",
            "verseOrgIds": [
              "JOS.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.5",
                "verseOrgIds": [
                  "JOS.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín sí àárín odò Jordani. Kí olúkúlùkù yín gbé òkúta kọ̀ọ̀kan lé èjìká a rẹ̀, gẹ́gẹ́ bí iye ẹ̀yà àwọn ọmọ Israẹli,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.5",
            "verseOrgIds": [
              "JOS.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí ó sì jẹ́ àmì láàrín yín. Ní ọjọ́ iwájú, nígbà tí àwọn ọmọ yín bá béèrè lọ́wọ́ yín pé, 'Kí ni òkúta wọ̀nyí dúró fún?'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.6",
            "verseOrgIds": [
              "JOS.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ẹ̀yin yóò dá wọn lóhùn pé, nítorí a gé omi odò Jordani kúrò ní iwájú àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.7",
            "verseOrgIds": [
              "JOS.4.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.7",
                "verseOrgIds": [
                  "JOS.4.7"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nígbà tí a rékọjá a Jordani, a gé omi Jordani kúrò. Àwọn òkúta wọ̀nyí yóò sì jẹ́ ìrántí fún àwọn ọmọ Israẹli láéláé.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.7",
            "verseOrgIds": [
              "JOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni àwọn ọmọ Israẹli sì ṣe bí Joṣua ti pàṣẹ fún wọn. Wọ́n gbé òkúta méjìlá láti àárín odò Jordani gẹ́gẹ́ bí iye ẹ̀yà àwọn ọmọ Israẹli, bí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.8",
            "verseOrgIds": [
              "JOS.4.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.8",
                "verseOrgIds": [
                  "JOS.4.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ fún Joṣua; wọ́n sì rù wọ́n kọjá lọ sí ibùdó, ní ibi tí wọ́n ti gbé wọn kalẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.8",
            "verseOrgIds": [
              "JOS.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joṣua sì to òkúta méjìlá náà sí àárín odò Jordani fún ìrántí ní ọ̀kánkán ibi tí àwọn àlùfáà tí ó ru àpótí ẹ̀rí dúró sí. Wọ́n sì wà níbẹ̀ di òní yìí.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.9",
            "verseOrgIds": [
              "JOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlùfáà tí ó ru àpótí náà dúró ní àárín Jordani títí gbogbo nǹkan tí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.10",
            "verseOrgIds": [
              "JOS.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.10",
                "verseOrgIds": [
                  "JOS.4.10"
                ]
              }
            }
          ]
        },
        {
          "text": "pàṣẹ fún Joṣua fi di ṣíṣe nípasẹ̀ àwọn ènìyàn, gẹ́gẹ́ bí Mose ti pàṣẹ fún Joṣua. Àwọn ènìyàn náà sì yára kọjá,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.10",
            "verseOrgIds": [
              "JOS.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí gbogbo wọn sì ti rékọjá tán, ni àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.11",
            "verseOrgIds": [
              "JOS.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.11",
                "verseOrgIds": [
                  "JOS.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "àti àwọn àlùfáà wá sí òdìkejì. Bí àwọn ènìyàn sì ti ń wò wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.11",
            "verseOrgIds": [
              "JOS.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin Reubeni, Gadi àti ìdajì ẹ̀yà Manase náà sì rékọjá ní ìhámọ́ra ogun níwájú àwọn ọmọ Israẹli, gẹ́gẹ́ bí Mose ti pàṣẹ fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.12",
            "verseOrgIds": [
              "JOS.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn bí ọ̀kẹ́ méjì (40,000) tó ti múra fún ogun rékọjá lọ ní iwájú",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.13",
            "verseOrgIds": [
              "JOS.4.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.13",
                "verseOrgIds": [
                  "JOS.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": "sí pẹ̀tẹ́lẹ̀ Jeriko láti jagun.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.13",
            "verseOrgIds": [
              "JOS.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà ni",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.14",
            "verseOrgIds": [
              "JOS.4.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.14",
                "verseOrgIds": [
                  "JOS.4.14"
                ]
              }
            }
          ]
        },
        {
          "text": "gbé Joṣua ga ní ojú gbogbo àwọn ọmọ Israẹli, wọ́n sì bẹ̀rù u rẹ̀ ní gbogbo ọjọ́ ayé e wọn, gẹ́gẹ́ bí wọ́n ti bẹ̀rù Mose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.14",
            "verseOrgIds": [
              "JOS.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.15",
                "verseOrgIds": [
                  "JOS.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fún Joṣua pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.15",
            "verseOrgIds": [
              "JOS.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pàṣẹ fún àwọn àlùfáà tí o ń ru àpótí ẹ̀rí, kí wọn kí ó jáde kúrò nínú odò Jordani.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.16",
            "verseOrgIds": [
              "JOS.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Joṣua pàṣẹ fún àwọn àlùfáà pé, \"Ẹ jáde kúrò nínú odò Jordani.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.17",
            "verseOrgIds": [
              "JOS.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlùfáà náà jáde láti inú odò pẹ̀lú àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.18",
                "verseOrgIds": [
                  "JOS.4.18"
                ]
              }
            }
          ]
        },
        {
          "text": "ni orí wọn. Bí wọ́n ti fi ẹsẹ̀ ẹ wọn tẹ orí ilẹ̀ gbígbẹ ni omi Jordani náà padà sí ààyè e rẹ̀, o sì kún wọ bèbè bí i ti àtẹ̀yìnwá.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹwàá oṣù kìn-ín-ní àwọn ènìyàn náà lọ láti Jordani, wọ́n sì dúró ní Gilgali ní ìlà-oòrùn Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.19",
            "verseOrgIds": [
              "JOS.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joṣua sì to àwọn òkúta méjìlá tí wọ́n mú jáde ní Jordani jọ ní Gilgali.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.20",
            "verseOrgIds": [
              "JOS.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì sọ fún àwọn ará Israẹli, \"Ní ọjọ́ iwájú nígbà tí àwọn ọmọ yín bá béèrè ní ọwọ́ baba wọn pé, 'Kín ni òkúta wọ̀nyí dúró fún?'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.21",
            "verseOrgIds": [
              "JOS.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ẹ ó jẹ́ kí àwọn ọmọ yín mọ̀ pé, 'Israẹli rékọjá odò Jordani ní orí ilẹ̀ gbígbẹ.'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.22",
            "verseOrgIds": [
              "JOS.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.23",
            "verseOrgIds": [
              "JOS.4.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.23",
                "verseOrgIds": [
                  "JOS.4.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín mú Jordani gbẹ ní iwájú u yín títí ẹ̀yin fi kọjá.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.23",
            "verseOrgIds": [
              "JOS.4.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.23",
                "verseOrgIds": [
                  "JOS.4.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ti ṣe sí Jordani gẹ́gẹ́ bí ó ti ṣe sí Òkun Pupa, nígbà tí ó mú un gbẹ ní iwájú wa títí àwa fi kọjá.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.23",
            "verseOrgIds": [
              "JOS.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe èyí kí gbogbo ayé lè mọ̀ pé ọwọ́",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.24",
            "verseOrgIds": [
              "JOS.4.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.24",
                "verseOrgIds": [
                  "JOS.4.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ní agbára, àti kí ẹ̀yin kí ó lè máa bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.24",
            "verseOrgIds": [
              "JOS.4.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.24",
                "verseOrgIds": [
                  "JOS.4.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ní ìgbà gbogbo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.24",
            "verseOrgIds": [
              "JOS.4.24"
            ]
          }
        }
      ]
