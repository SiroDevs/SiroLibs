        {
          "text": "Ẹ̀yà Benjamini ní agbo ilé, agbo ilé ni àwọn ìlú wọ̀nyí:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 18:21"
      },
      "items": [
