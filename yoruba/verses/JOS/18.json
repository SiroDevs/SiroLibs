          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kefari, Ammoni, Ofini àti Geba; àwọn ìlú méjìlá àti ìletò wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.24",
            "verseOrgIds": [
              "JOS.18.24"
            ]
          }
        }
