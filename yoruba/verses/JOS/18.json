          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beti-Araba, Semaraimu, Beteli,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.22",
            "verseOrgIds": [
              "JOS.18.22"
