  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "JOS 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìkọlà fún ìran tuntun Israẹli? Ìkọlà ní Gilgali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí gbogbo àwọn ọba Amori ti ìlà-oòrùn Jordani àti gbogbo àwọn ọba Kenaani tí ń bẹ létí òkun gbọ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.1",
            "verseOrgIds": [
              "JOS.5.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.1",
                "verseOrgIds": [
                  "JOS.5.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ti mú Jordani gbẹ ní iwájú àwọn ọmọ Israẹli títí ti a fi kọjá, ọkàn wọn pami, bẹ́ẹ̀ ni wọn kò ní ìgboyà mọ́ láti dojúkọ àwọn ọmọ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.1",
            "verseOrgIds": [
              "JOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.2",
            "verseOrgIds": [
              "JOS.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.2",
                "verseOrgIds": [
                  "JOS.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún Joṣua pé, \"Fi akọ òkúta ṣe abẹ kí o sì kọ àwọn ọmọ Israẹli ní ilà ní ìgbà ẹ̀ẹ̀kejì.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.2",
            "verseOrgIds": [
              "JOS.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Joṣua sì ṣe abẹ akọ òkúta, ó sì kọ àwọn ọmọ Israẹli ní ilà, ní Gibiati-Haralotu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.3",
            "verseOrgIds": [
              "JOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wàyí o, ìdí tí Joṣua fi kọ wọ́n nílà nìyìí. Gbogbo àwọn ọkùnrin tí ó ti Ejibiti jáde wá, gbogbo àwọn ọkùnrin ogun kú ní aginjù ní ọ̀nà lẹ́yìn ìgbà tí wọ́n jáde kúrò ní ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.4",
            "verseOrgIds": [
              "JOS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó tilẹ̀ jẹ́ pé, gbogbo àwọn ọkùnrin tó jáde láti Ejibiti ni a ti kọ ní ilà, síbẹ̀ gbogbo ènìyàn tí a bí nínú aginjù lẹ́yìn tí wọ́n jáde ní Ejibiti ni wọn kò kọ ní ilà.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.5",
            "verseOrgIds": [
              "JOS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Israẹli rìn ní aginjù fún ogójì ọdún títí gbogbo àwọn ọkùnrin tí ó tó ogun n jà nígbà tí wọ́n kúrò ni Ejibiti fi kú, nítorí wọn kò gbọ́rọ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.6",
                "verseOrgIds": [
                  "JOS.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nítorí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.6",
                "verseOrgIds": [
                  "JOS.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ti búra fún wọn pé wọn kò ní rí ilẹ̀ tí òun ṣe ìlérí fún àwọn baba wọn láti fi fun wa, ilẹ̀ tí ń sàn fún wàrà àti fún oyin.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni ó gbé àwọn ọmọ wọn dìde dípò wọn, àwọn wọ̀nyí sì ni Joṣua kọ ní ilà. Wọ́n wà ní aláìkọlà nítorí a kò tí ì kọ wọ́n ní ilà ní ojú ọ̀nà.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.7",
            "verseOrgIds": [
              "JOS.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìgbà tí gbogbo orílẹ̀-èdè náà kọ ilà tan, wọ́n dúró ní ibi tí wọ́n wà ní ibùdó títí ilà wọn fi jinná.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.8",
            "verseOrgIds": [
              "JOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ní",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.9",
                "verseOrgIds": [
                  "JOS.5.9"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún Joṣua pé, \"Ní òní ni mo yí ẹ̀gàn Ejibiti kúrò ní orí yín.\" Nítorí náà ni a ṣe ń pe orúkọ ibẹ̀ ní Gilgali títí ó fi di òní yìí.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àjọ ìrékọjá ní Gilgali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìrọ̀lẹ́ ọjọ́ kẹrìnlá oṣù náà, nígbà tí wọ́n pàgọ́ ní Gilgali ní pẹ̀tẹ́lẹ̀ Jeriko, àwọn ọmọ Israẹli sì ṣe ọdún àjọ ìrékọjá.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.10",
            "verseOrgIds": [
              "JOS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kejì àjọ ìrékọjá, ní ọjọ́ náà gan an ni, wọ́n jẹ nínú àwọn ìre oko ilẹ̀ náà: àkàrà aláìwú, àti ọkà yíyan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.11",
            "verseOrgIds": [
              "JOS.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manna náà sì tan ní ọjọ́ kejì tí wọ́n jẹ oúnjẹ tí ilẹ̀ náà mú jáde, kò sì sí manna kankan mọ́ fún àwọn ará Israẹli, ṣùgbọ́n ní ọdún náà wọ́n jẹ ìre oko ilẹ̀ Kenaani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.12",
            "verseOrgIds": [
              "JOS.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Odi Jeriko wó lulẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Joṣua súnmọ́ Jeriko, ó wo òkè ó sì rí ọkùnrin kan tí ó dúró ní iwájú rẹ̀ pẹ̀lú idà ní ọwọ́ rẹ̀. Joṣua sì tọ̀ ọ́ lọ, ó sì bi í pé, \"Ǹjẹ́ ìwọ wà fún wa tàbí fún ọ̀tá a wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.13",
            "verseOrgIds": [
              "JOS.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kì í ṣe fún èyíkéyìí ó fèsì, ṣùgbọ́n gẹ́gẹ́ bí olórí ogun",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.14",
            "verseOrgIds": [
              "JOS.5.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.14",
                "verseOrgIds": [
                  "JOS.5.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ni mo wá nísinsin yìí.\" Nígbà náà ni Joṣua sì wólẹ̀ ní iwájú u rẹ̀ ní ìbẹ̀rù, ó sì bi í léèrè, \"Kí ni Olúwa ní í sọ fún ìránṣẹ́ rẹ̀?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.14",
            "verseOrgIds": [
              "JOS.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olórí ogun",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.15",
            "verseOrgIds": [
              "JOS.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.15",
                "verseOrgIds": [
                  "JOS.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": "sì dá a lóhùn pé, \"Bọ́ sálúbàtà rẹ kúrò ní ẹsẹ̀ rẹ, nítorí pé ibi tí ìwọ dúró sí yìí, ilẹ̀ mímọ́ ni.\" Joṣua sì ṣe bẹ́ẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.15",
            "verseOrgIds": [
              "JOS.5.15"
            ]
          }
        }
      ]
    }
  ],
