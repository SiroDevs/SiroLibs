  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "1SA 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dafidi gbà Keila lọ́wọ́ àwọn Filistini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì wí fún Dafidi pé, \"Sá wò ó, àwọn ará Filistini ń bá ará Keila jagun, wọ́n sì ja àwọn ilẹ̀ ìpakà lólè.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.1",
            "verseOrgIds": [
              "1SA.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì béèrè lọ́dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.2",
            "verseOrgIds": [
              "1SA.23.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.2",
                "verseOrgIds": [
                  "1SA.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": "pé, \"Ṣé kí èmi ó lọ kọlu àwọn ará Filistini wọ̀nyí bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.2",
            "verseOrgIds": [
              "1SA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 23:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.2",
                "verseOrgIds": [
                  "1SA.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí fún Dafidi pé, \"Lọ kí o sì kọlu àwọn ará Filistini kí o sì gba Keila sílẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.2",
            "verseOrgIds": [
              "1SA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọkùnrin tí ó wà lọ́dọ̀ Dafidi sì wí fún un pé, \"Wò ó, àwa ń bẹ̀rù níhìn-ín yìí ní Juda; ǹjẹ́ yóò ti rí nígbà ti àwa bá dé Keila láti fi ojú ko ogun àwọn ara Filistini?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.3",
            "verseOrgIds": [
              "1SA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì tún béèrè lọ́dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.4",
            "verseOrgIds": [
              "1SA.23.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.4",
                "verseOrgIds": [
                  "1SA.23.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.4",
            "verseOrgIds": [
              "1SA.23.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.4",
                "verseOrgIds": [
                  "1SA.23.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sì dá a lóhùn, ó sì wí pé, \"Dìde, kí o sọ̀kalẹ̀ lọ sí Keila, nítorí pé èmi ó fi àwọn ará Filistini náà lé ọ lọ́wọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.4",
            "verseOrgIds": [
              "1SA.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi àti àwọn ọmọkùnrin rẹ̀ sì lọ sí Keila, wọ́n sì bá àwọn ará Filistini jà, wọ́n sì kó ohun ọ̀sìn wọn, wọ́n sì fi ìparun ńlá pa wọ́n. Dafidi sì gba àwọn ará Keila sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.5",
            "verseOrgIds": [
              "1SA.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe, nígbà tí Abiatari ọmọ Ahimeleki fi sá tọ Dafidi lọ ní Keila, ó sọ̀kalẹ̀ òun pẹ̀lú efodu kan lọ́wọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.6",
            "verseOrgIds": [
              "1SA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sì sọ fún Saulu pé Dafidi wá sí Keila. Saulu sì wí pé, \"Ọlọ́run ti fi í lé mi lọ́wọ́; nítorí tí ó ti sé ara rẹ̀ mọ́ ní ti wíwá tí ó wá sí ìlú tí ó ní ìlẹ̀kùn àti kẹrẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.7",
            "verseOrgIds": [
              "1SA.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì pe gbogbo àwọn ènìyàn náà jọ sí ogun, láti sọ̀kalẹ̀ lọ sí Keila, láti ká Dafidi mọ́ àti àwọn ọmọkùnrin rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.8",
            "verseOrgIds": [
              "1SA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì mọ̀ pé Saulu ti gbèrò búburú sí òun; ó sì wí fún Abiatari àlùfáà náà pé, \"Mú efodu náà wá níhìn-ín yìí!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.9",
            "verseOrgIds": [
              "1SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì wí pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.10",
            "verseOrgIds": [
              "1SA.23.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.10",
                "verseOrgIds": [
                  "1SA.23.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli, lóòótọ́ ni ìránṣẹ́ rẹ ti gbọ́ pé Saulu ń wá ọ̀nà láti wá sí Keila, láti wá fọ́ ìlú náà nítorí mi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.10",
            "verseOrgIds": [
              "1SA.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àgbà ìlú Keila yóò fi mí lé e lọ́wọ́ bí? Saulu yóò ha sọ̀kalẹ̀, gẹ́gẹ́ bí ìránṣẹ́ rẹ ti gbọ́ bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.11",
            "verseOrgIds": [
              "1SA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 23:11"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.11",
                "verseOrgIds": [
                  "1SA.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli, èmi bẹ̀ ọ́, wí fún ìránṣẹ́ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.11",
            "verseOrgIds": [
              "1SA.23.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.11",
                "verseOrgIds": [
                  "1SA.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí pé, \"Yóò sọ̀kalẹ̀ wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.11",
            "verseOrgIds": [
              "1SA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì wí pé, \"Àwọn àgbà ìlú Keila yóò fi èmi àti àwọn ọmọkùnrin mi lé Saulu lọ́wọ́ bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.12",
            "verseOrgIds": [
              "1SA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 23:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.12",
                "verseOrgIds": [
                  "1SA.23.12"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí pé, \"Wọn ó fi ọ́ lé wọn lọ́wọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.12",
            "verseOrgIds": [
              "1SA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi àti àwọn ọmọkùnrin rẹ̀ tí wọ́n tó ẹgbẹ̀ta (600) ènìyàn sì dìde, wọ́n lọ kúrò ní Keila, wọ́n sì lọ sí ibikíbi tí wọ́n lè rìn lọ. A sì wí fún Saulu pé, \"Dafidi ti sá kúrò ní Keila; kò sì lọ sí Keila mọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.13",
            "verseOrgIds": [
              "1SA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì ń gbé ní aginjù, níbi tí ó ti sá pamọ́ sí, ó sì ń gbé níbi òkè ńlá kan ní aginjù Sifi. Saulu sì ń wá a lójoojúmọ́, ṣùgbọ́n Ọlọ́run kò fi lé e lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.14",
            "verseOrgIds": [
              "1SA.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ará Sifi dalẹ̀ Dafidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Dafidi wà ní Horeṣi ní aginjù Sifi, Dafidi sì rí i pé, Saulu ti jáde láti wá ẹ̀mí òun kiri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.15",
            "verseOrgIds": [
              "1SA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani ọmọ Saulu sì dìde, ó sì tọ Dafidi lọ nínú igbó Horeṣi, ó sì gbà á ní ìyànjú nípa ti Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.16",
            "verseOrgIds": [
              "1SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun sì wí fún un pé, \"Má ṣe bẹ̀rù, nítorí tí ọwọ́ Saulu baba mi kì yóò tẹ̀ ọ́. Ìwọ ni yóò jẹ ọba lórí Israẹli, èmi ni yóò sì ṣe ibìkejì rẹ. Saulu baba mi mọ̀ bẹ́ẹ̀ pẹ̀lú.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.17",
            "verseOrgIds": [
              "1SA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn méjèèjì sì ṣe àdéhùn níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.18",
            "verseOrgIds": [
              "1SA.23.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.18",
                "verseOrgIds": [
                  "1SA.23.18"
                ]
              }
            }
          ]
        },
        {
          "text": "; Dafidi sì jókòó nínú igbó Horeṣi. Jonatani sì lọ sí ilé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.18",
            "verseOrgIds": [
              "1SA.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Sifi sì gòkè tọ Saulu wá sí Gibeah, wọ́n sì wí pé, \"Ṣé Dafidi ti fi ara rẹ̀ pamọ́ sọ́dọ̀ wa ní ibi gíga ìsápamọ́sí ní Horeṣi, ní òkè Hakila, tí ó wà níhà gúúsù ti Jeṣimoni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.19",
            "verseOrgIds": [
              "1SA.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ nísinsin yìí, ọba, sọ̀kalẹ̀ wá gẹ́gẹ́ bi gbogbo ìfẹ́ tí ó wà ní ọkàn rẹ láti sọ̀kalẹ̀: ipa tí àwa ní láti fi lé ọba lọ́wọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.20",
            "verseOrgIds": [
              "1SA.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì wí pé, \"Alábùkún fún ni ẹ̀yin nípa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.21",
            "verseOrgIds": [
              "1SA.23.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.21",
                "verseOrgIds": [
                  "1SA.23.21"
                ]
              }
            }
          ]
        },
        {
          "text": "; nítorí pé ẹ̀yin ti káàánú fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.21",
            "verseOrgIds": [
              "1SA.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lọ, èmi bẹ̀ yín, ẹ tún múra, kí ẹ sì mọ̀ ki ẹ si rí ibi tí ẹsẹ̀ rẹ̀ gbé wà, àti ẹni tí ó rí níbẹ̀: nítorí tí a ti sọ fún mi pé, ọgbọ́n ni ó ń lò jọjọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.22",
            "verseOrgIds": [
              "1SA.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ sì wò, kí ẹ sì mọ ibi ìsápamọ́ tí ó máa ń sá pamọ́ sí, kí ẹ sì tún padà tọ̀ mí wá, kí èmi lè mọ̀ dájú; èmi ó sì bá yín lọ: yóò sì ṣe bí ó bá wà ní ilẹ̀ Israẹli, èmi ó sì wá a ní àwárí nínú gbogbo ẹgbẹ̀rún Juda!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.23",
            "verseOrgIds": [
              "1SA.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì dìde, wọ́n sì ṣáájú Saulu lọ sí Sifi, ṣùgbọ́n Dafidi àti àwọn ọmọkùnrin rẹ̀ wà ní aginjù Maoni, ní pẹ̀tẹ́lẹ̀ níhà gúúsù ti Jeṣimoni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.24",
            "verseOrgIds": [
              "1SA.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu àti àwọn ọmọkùnrin rẹ̀ sì lọ ń wá a. Wọ́n sì sọ fún Dafidi: ó sì sọ̀kalẹ̀ wá sí ibi òkúta kan, ó sì jókòó ní aginjù ti Maoni. Saulu sì gbọ́, ó sì lépa Dafidi ní aginjù Maoni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.25",
            "verseOrgIds": [
              "1SA.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì ń rin apá kan òkè kan, Dafidi àti àwọn ọmọkùnrin rẹ̀ ní apá kejì òkè náà. Dafidi sì yára láti sá kúrò níwájú Saulu; nítorí pé Saulu àti àwọn ọmọkùnrin rẹ̀ ti rọ̀gbà yí Dafidi àti àwọn ọmọkùnrin rẹ̀ ká láti mú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.26",
            "verseOrgIds": [
              "1SA.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n oníṣẹ́ kan sì tọ Saulu wá ó sì wí pé, \"Ìwọ yára kí o sì wá, nítorí tí àwọn Filistini ti gbé ogun ti ilẹ̀ wa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.27",
            "verseOrgIds": [
              "1SA.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì padà kúrò ní lílépa Dafidi, ó sì lọ pàdé àwọn Filistini nítorí náà ni wọ́n sì ṣe ń pe ibẹ̀ náà ní Selahamalekoti (èyí tí ó túmọ̀ sí \"Òkúta Ìpinyà\").",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.28",
            "verseOrgIds": [
              "1SA.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì gòkè láti ibẹ̀ lọ, ó sì jókòó níbi tí ó sá pamọ́ sí ní En-Gedi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.29",
            "verseOrgIds": [
              "1SA.24.1"
            ]
          }
        }
      ]
    }
  ],
