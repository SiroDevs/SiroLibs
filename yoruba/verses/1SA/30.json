  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "1SA 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dafidi pa gbogbo àwọn Amaleki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe nígbà ti Dafidi àti àwọn ọmọkùnrin rẹ̀ sì bọ̀ sí Siklagi ní ọjọ́ kẹta, àwọn ará Amaleki sì ti kọlu ìhà gúúsù, àti Siklagi, wọ́n sì ti kùn ún ní iná.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.1",
            "verseOrgIds": [
              "1SA.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì kó àwọn obìnrin tí ń bẹ nínú rẹ̀ ní ìgbèkùn, wọn kò sì pa ẹnìkan, ọmọdé tàbí àgbà, ṣùgbọ́n wọ́n kó wọn lọ, wọ́n sì bá ọ̀nà tiwọn lọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.2",
            "verseOrgIds": [
              "1SA.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi àti àwọn ọmọkùnrin sì wọ ìlú Siklagi, sì wò ó, a ti kùn ún ni iná; àti obìnrin wọn, àti ọmọkùnrin wọn àti ọmọbìnrin wọn ni a kó ni ìgbèkùn lọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.3",
            "verseOrgIds": [
              "1SA.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi àti àwọn ènìyàn tí ó wà lọ́dọ̀ rẹ̀ sì gbé ohùn wọn sókè, wọ́n sì sọkún títí agbára kò fi sí fún wọn mọ́ láti sọkún.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.4",
            "verseOrgIds": [
              "1SA.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sì kó àwọn aya Dafidi méjèèjì nígbèkùn lọ, Ahinoamu ará Jesreeli àti Abigaili aya Nabali ará Karmeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.5",
            "verseOrgIds": [
              "1SA.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì banújẹ́ gidigidi, nítorí pé àwọn ènìyàn náà sì ń sọ̀rọ̀ láti sọ ọ́ lókùúta, nítorí ti inú gbogbo àwọn ènìyàn náà sì bàjẹ́, olúkúlùkù ọkùnrin nítorí ọmọ rẹ̀ ọkùnrin, àti nítorí ọmọ rẹ̀ obìnrin ṣùgbọ́n Dafidi mú ara rẹ̀ lọ́kàn le nínú",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.6",
            "verseOrgIds": [
              "1SA.30.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.30.6",
                "verseOrgIds": [
                  "1SA.30.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.6",
            "verseOrgIds": [
              "1SA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì wí fún Abiatari àlùfáà, ọmọ Ahimeleki pé, èmí bẹ̀ ọ́, mú efodu fún mi wá níhìn-ín yìí. Abiatari sì mú efodu náà wá fún Dafidi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.7",
            "verseOrgIds": [
              "1SA.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì béèrè lọ́dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.8",
            "verseOrgIds": [
              "1SA.30.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.30.8",
                "verseOrgIds": [
                  "1SA.30.8"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé, \"Kí èmi ó lépa ogun yìí bi? Èmi lè bá wọn?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.8",
            "verseOrgIds": [
              "1SA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 30:8"
      },
      "items": [
        {
          "text": "Ó sì dá a lóhùn pé, \"Lépa, nítorí pé ni bíbá ìwọ yóò bá wọn, ni gbígbà ìwọ yóò sì rí wọn gbà.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.8",
            "verseOrgIds": [
              "1SA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Dafidi àti ẹgbẹ̀ta (600) ọmọkùnrin tí ń bẹ lọ́dọ̀ rẹ̀ sì wá sí ibi àfonífojì Besori, apá kan sì dúró.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.9",
            "verseOrgIds": [
              "1SA.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Dafidi àti irinwó (400) ọmọkùnrin lépa wọn: igba ènìyàn tí àárẹ̀ mú, tiwọn kò lè kọjá odò Besori sì dúró lẹ́yìn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.10",
            "verseOrgIds": [
              "1SA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì rí ará Ejibiti kan ní oko, wọ́n sì mú un tọ Dafidi wá, wọ́n sì fún un ní oúnjẹ, ó sì jẹ; wọ́n sì fún un ní omi mu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.11",
            "verseOrgIds": [
              "1SA.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì fún un ní àkàrà, èso ọ̀pọ̀tọ́ àti síírí àjàrà gbígbẹ́ méjì: nígbà tí ó sì jẹ ẹ́ tán, ẹ̀mí rẹ̀ sì sọjí: nítorí pé kò jẹ oúnjẹ, bẹ́ẹ̀ ni kò sì mu omi ní ọjọ́ mẹ́ta ní ọ̀sán, àti ní òru.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.12",
            "verseOrgIds": [
              "1SA.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì bi í léèrè pé, \"Ọmọ ta ni ìwọ? Àti níbo ni ìwọ ti wá?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.13",
            "verseOrgIds": [
              "1SA.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 30:13"
      },
      "items": [
        {
          "text": "Òun sì wí pé, \"Ọmọ ará Ejibiti ni èmi, ọmọ ọ̀dọ̀ ọkùnrin kan ará Amaleki. Olúwa mi fi mí sílẹ̀, nítorí pé láti ọjọ́ mẹ́ta ni èmi ti ṣe àìsàn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.13",
            "verseOrgIds": [
              "1SA.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa sì gbé ogun lọ sí ìhà gúúsù tí ará Kereti, àti sí ìhà ti Juda, àti sí ìhà gúúsù ti Kalebu; àwa sì kun Siklagi ní iná.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.14",
            "verseOrgIds": [
              "1SA.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì bi í léèrè pé, \"Ìwọ lè mú mí sọ̀kalẹ̀ tọ ẹgbẹ́ ogun yìí lọ bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 30:15"
      },
      "items": [
        {
          "text": "Òun sì wí pé, \"Fi Ọlọ́run búra fún mi pé, ìwọ kì yóò pa mí, bẹ́ẹ̀ ni ìwọ kì yóò sì fi mi lé olúwa mi lọ́wọ́; èmi yóò sì mú ọ sọ̀kalẹ̀ tọ ẹgbẹ́ ogun náà lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì mú un sọ̀kalẹ̀, sì wò ó, wọ́n sì tàn ká ilẹ̀, wọ́n ń jẹ, wọ́n ń mu, wọ́n sì ń jó, nítorí ìkógun púpọ̀ tí wọ́n kó láti ilẹ̀ àwọn Filistini wá, àti láti ilẹ̀ Juda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.16",
            "verseOrgIds": [
              "1SA.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì pa wọ́n láti àfẹ̀mọ́júmọ́ títí ó fi di àṣálẹ́ ọjọ́ kejì: kò sí ẹnìkan tí ó là nínú wọn, bí kọ̀ ṣe irinwó (400) ọmọkùnrin tí wọ́n gun ìbákasẹ tí wọ́n sì sá.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.17",
            "verseOrgIds": [
              "1SA.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì gbà gbogbo nǹkan tí àwọn ará Amaleki ti kó: Dafidi sì gba àwọn obìnrin rẹ̀ méjèèjì.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.18",
            "verseOrgIds": [
              "1SA.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sì ṣí nǹkan tí ó kù fún wọn, kékeré tàbí ńlá, ọmọkùnrin tàbí ọmọbìnrin, tàbí ìkógun, tàbí gbogbo nǹkan tí wọ́n ti kó: Dafidi sì gba gbogbo wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.19",
            "verseOrgIds": [
              "1SA.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì kó gbogbo àgùntàn, àti màlúù tí àwọn ènìyàn rẹ̀ dà ṣáájú àwọn ẹran ọ̀sìn mìíràn tí wọ́n gbà, wọ́n sì wí pé, \"Èyí yìí ni ìkógun ti Dafidi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.20",
            "verseOrgIds": [
              "1SA.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dafidi sí pín ìkógun náà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì wá sọ́dọ̀ igba ọkùnrin tí àárẹ̀ ti mú jú, tiwọn kò lè tọ́ Dafidi lẹ́yìn mọ́, ti òun ti fi sílẹ̀, ni àfonífojì Besori: wọ́n sì lọ pàdé Dafidi, àti láti pàdé àwọn ènìyàn tí ó lọ pẹ̀lú rẹ̀: Dafidi sì pàdé àwọn ènìyàn náà, ó sì kí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.21",
            "verseOrgIds": [
              "1SA.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ènìyàn búburú àti àwọn ọmọ Beliali nínú àwọn tí o bá Dafidi lọ sì dáhùn, wọ́n sì wí pé, \"Bí wọn kò ti bá wa lọ, àwa ki yóò fi nǹkan kan fún wọn nínú ìkógun ti àwa rí gbà bí kò ṣe obìnrin olúkúlùkù wọn, àti ọmọ wọn; ki wọn sì mú wọn, ki wọn sì máa lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.22",
            "verseOrgIds": [
              "1SA.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì wí pé, \"Ẹ má ṣe bẹ́ẹ̀, ẹ̀yin ara mi:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.23",
            "verseOrgIds": [
              "1SA.30.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.30.23",
                "verseOrgIds": [
                  "1SA.30.23"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ó fi nǹkan yìí fún wa, òun ni ó sì pa wá mọ́, òun ni ó sì fi ẹgbẹ́ ogun ti ó dìde sí wa lé wa lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.23",
            "verseOrgIds": [
              "1SA.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni yóò gbọ́ tiyín nínú ọ̀ràn yìí? Ṣùgbọ́n bi ìpín ẹni tí ó sọ̀kalẹ̀ lọ si ìjà ti rí, bẹ́ẹ̀ ni ìpín ẹni ti ó dúró ti ẹrù; wọn ó sì pín in bákan náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.24",
            "verseOrgIds": [
              "1SA.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ọjọ́ náà lọ, ó sì pàṣẹ, ó sì sọ ọ di òfin fún Israẹli títí di òní yìí.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.25",
            "verseOrgIds": [
              "1SA.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì padà sí Siklagi, ó sì rán nínú ìkógun náà si àwọn àgbàgbà Juda, àti sí àwọn ọ̀rẹ́ rẹ̀, ó sì wí pé, \"Wò ó, èyí ni ẹ̀bùn fún un yín, láti inú ìkógun àwọn ọ̀tá",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.30.26",
                "verseOrgIds": [
                  "1SA.30.26"
                ]
              }
            }
          ]
        },
        {
          "text": "wa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì rán an sí àwọn tí ó wà ni Beteli àti sí àwọn tí ó wà ní gúúsù tí Ramoti, àti sí àwọn tí ó wà ní Jattiri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.27",
            "verseOrgIds": [
              "1SA.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti sí àwọn tí ó wà ní Aroeri, àti sí àwọn tí ó wà ní Sifimoti, àti sí àwọn tí ó wà ni Eṣitemoa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.28",
            "verseOrgIds": [
              "1SA.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti si àwọn tí ó wà ni Rakeli, àti sí àwọn tí ó wà ní ìlú àwọn Jerahmeeli, àti sí àwọn tí ó wà ni ìlú àwọn ará Keni,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.29",
            "verseOrgIds": [
              "1SA.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti sí àwọn tí ó wà ni Horma, àti sí àwọn ti ó wà ní Bori-Aṣani, àti sí àwọn tí ó wà ni Ataki.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.30",
            "verseOrgIds": [
              "1SA.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti àwọn tí ó wà ni Hebroni, àti sí gbogbo àwọn ìlú ti Dafidi tìkára rẹ̀ àti tí àwọn ọmọkùnrin rẹ̀ máa ń rìn ká.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.31",
            "verseOrgIds": [
              "1SA.30.31"
            ]
          }
        }
      ]
    }
