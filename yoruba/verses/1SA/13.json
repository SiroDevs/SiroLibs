  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "1SA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samuẹli fi Saulu bú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì jẹ́ ọmọ ọgbọ̀n ọdún nígbà tí ó jẹ ọba, ó sì jẹ ọba lórí Israẹli ní ọdún méjìlélógójì.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.1",
            "verseOrgIds": [
              "1SA.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu yan ẹgbẹ̀rún mẹ́ta (3,000) ọkùnrin ní Israẹli, ẹgbẹ̀rún méjì (2,000) sì wà lọ́dọ̀ rẹ̀ ní Mikmasi àti ní ìlú òkè Beteli ẹgbẹ̀rún kan (1,000) sì wà lọ́dọ̀ Jonatani ní Gibeah ti Benjamini. Àwọn ọkùnrin tókù ni ó rán padà sí ilé e wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.2",
            "verseOrgIds": [
              "1SA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani sì kọlu ẹgbẹ́ ogun àwọn Filistini ní Gibeah, Filistini sì gbọ́ èyí. Nígbà náà ni Saulu fọn ìpè yí gbogbo ilẹ̀ náà ká, ó sì wí pé, \"Jẹ́ kí àwọn Heberu gbọ́!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.3",
            "verseOrgIds": [
              "1SA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni gbogbo Israẹli sì gbọ́ ìròyìn pé, \"Saulu ti kọlu ẹgbẹ́ ogun àwọn Filistini, Israẹli sì di òórùn búburú fún àwọn Filistini.\" Àwọn ènìyàn náà sì péjọ láti darapọ̀ mọ́ Saulu ní Gilgali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.4",
            "verseOrgIds": [
              "1SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn Filistini kó ara wọn jọ pọ̀ láti bá Israẹli jà, pẹ̀lú ẹgbẹ̀rún mẹ́ta (3,000) kẹ̀kẹ́, ẹgbẹ̀rún mẹ́fà (6,000) ọkùnrin ẹlẹ́ṣin, àwọn ológun sì pọ̀ bí yanrìn etí Òkun. Wọ́n sì gòkè lọ, wọ́n dó ní Mikmasi ní ìhà ilẹ̀ oòrùn Beti-Afeni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.5",
            "verseOrgIds": [
              "1SA.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ọkùnrin Israẹli sì rí i pé àwọn wà nínú ìpọ́njú àti pé àwọn ológun wọn wà nínú ìhámọ́, wọ́n fi ara pamọ́ nínú ihò àti nínú igbó láàrín àpáta, nínú ọ̀fìn, àti nínú kànga gbígbẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.6",
            "verseOrgIds": [
              "1SA.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn Heberu mìíràn tilẹ̀ kọjá a Jordani sí ilẹ̀ Gadi àti Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 13:7"
      },
      "items": [
        {
          "text": "Saulu wà ní Gilgali síbẹ̀, gbogbo àwọn ọ̀wọ́ ogun tí ó wà pẹ̀lú rẹ̀ sì ń wárìrì fún ìbẹ̀rù.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì dúró di ọjọ́ méje, àkókò tí Samuẹli dá; ṣùgbọ́n Samuẹli kò wá sí Gilgali, àwọn ènìyàn Saulu sì bẹ̀rẹ̀ sí ní túká.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.8",
            "verseOrgIds": [
              "1SA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì wí pé, \"Ẹ mú ẹbọ sísun àti ẹbọ ìrẹ́pọ̀ wá fún mi.\" Saulu sì rú ẹbọ sísun náà.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.9",
            "verseOrgIds": [
              "1SA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó sì ti ń parí rírú ẹbọ sísun náà, Samuẹli sì dé, Saulu sì jáde láti lọ kí i.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.10",
            "verseOrgIds": [
              "1SA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli sì wí pé, \"Kí ni ìwọ ṣe yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.11",
            "verseOrgIds": [
              "1SA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 13:11"
      },
      "items": [
        {
          "text": "Saulu sì dáhùn pé, \"Nígbà tí mo rí pé àwọn ènìyàn náà ń túká, àti tí ìwọ kò sì wá ní àkókò ọjọ́ tí ìwọ dá, tí àwọn Filistini sì kó ara wọ́n jọ ní Mikmasi,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.11",
            "verseOrgIds": [
              "1SA.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mo rò pé, 'Àwọn Filistini yóò sọ̀kalẹ̀ tọ̀ mí wá ní Gilgali nísinsin yìí, bẹ́ẹ̀ ni èmi kò ì tí ì wá ojúrere",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.12",
            "verseOrgIds": [
              "1SA.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.13.12",
                "verseOrgIds": [
                  "1SA.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".' Báyìí ni mo mú ara mi ní ipá láti rú ẹbọ sísun náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.12",
            "verseOrgIds": [
              "1SA.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli sì wí fún un pé, \"Ìwọ hu ìwà aṣiwèrè, ìwọ kò sì pa òfin tí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.13",
            "verseOrgIds": [
              "1SA.13.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.13.13",
                "verseOrgIds": [
                  "1SA.13.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ fi fún ọ mọ́; bí o kò bá ṣe bẹ́ẹ̀, òun ìbá fi ìdí ìjọba rẹ kalẹ̀ lórí Israẹli láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.13",
            "verseOrgIds": [
              "1SA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nísinsin yìí ìjọba rẹ kì yóò dúró pẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.14",
            "verseOrgIds": [
              "1SA.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.13.14",
                "verseOrgIds": [
                  "1SA.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ti wá ọkùnrin tí ó wù ú ní ọkàn rẹ̀ fún ara rẹ̀, ó sì ti yàn án láti ṣe olórí fún àwọn ènìyàn rẹ̀, nítorí pé ìwọ kò pa òfin",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.14",
            "verseOrgIds": [
              "1SA.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.13.14",
                "verseOrgIds": [
                  "1SA.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "mọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.14",
            "verseOrgIds": [
              "1SA.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Samuẹli kúrò ní Gilgali, ó sì gòkè lọ sí Gibeah ti Benjamini, Saulu sì ka àwọn ènìyàn tí ó wà lọ́dọ̀ rẹ̀, wọ́n sì jẹ́ ẹgbẹ̀ta (600).",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.15",
            "verseOrgIds": [
              "1SA.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israẹli láìní ohun ìjà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu àti ọmọ rẹ̀ Jonatani àti àwọn ènìyàn tí ó wà pẹ̀lú wọn dúró ní Gibeah ti Benjamini, nígbà tí àwọn Filistini dó ní Mikmasi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.16",
            "verseOrgIds": [
              "1SA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹgbẹ́ àwọn onísùmọ̀mí mẹ́ta jáde lọ ní àgọ́ àwọn Filistini ní ọnà ọ̀tọ̀ọ̀tọ̀. Ẹgbẹ́ kan gba ọ̀nà ti Ofira ní agbègbè ìlú Ṣuali,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.17",
            "verseOrgIds": [
              "1SA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "òmíràn gba ọ̀nà Beti-Horoni, ẹ̀kẹta sí ìhà ibodè tí ó kọjú sí àfonífojì Seboimu tí ó kọjú sí ijù.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.18",
            "verseOrgIds": [
              "1SA.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kò sì rí alágbẹ̀dẹ kan ní gbogbo ilẹ̀ Israẹli, nítorí tí àwọn Filistini wí pé, \"Bí kò ṣe bẹ́ẹ̀ àwọn Heberu yóò rọ idà tàbí ọ̀kọ̀!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.19",
            "verseOrgIds": [
              "1SA.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni gbogbo Israẹli tọ àwọn Filistini lọ láti pọ́n dòjé wọn, ọ̀kọ̀, àáké àti ọ̀ṣọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.20",
            "verseOrgIds": [
              "1SA.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye tí wọ́n fi pọ́n dòjé àti ọ̀kọ̀ jẹ́ ọwọ́ méjì nínú ìdámẹ́ta ṣékélì, àti ìdámẹ́ta ṣékélì fún pípọ́n òòyà-irin tí ilẹ̀, àáké àti irin ọ̀pá olùṣọ́ màlúù.",
          "type": "text",
