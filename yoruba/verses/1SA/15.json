  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "1SA 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "kọ Saulu ní ọba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli wí fún Saulu pé, \"Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.1",
            "verseOrgIds": [
              "1SA.15.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.1",
                "verseOrgIds": [
                  "1SA.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "rán láti fi àmì òróró yàn ọ́ ní ọba lórí àwọn ènìyàn rẹ̀ Israẹli; fetísílẹ̀ láti gbọ́ iṣẹ́ tí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.1",
            "verseOrgIds": [
              "1SA.15.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.1",
                "verseOrgIds": [
                  "1SA.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "rán mi sí ọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.1",
            "verseOrgIds": [
              "1SA.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.2",
            "verseOrgIds": [
              "1SA.15.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.2",
                "verseOrgIds": [
                  "1SA.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí, 'Èmi yóò jẹ àwọn Amaleki ní yà fún ohun tí wọ́n ti ṣe sí Israẹli nígbà tí wọn dè wọn lọ́nà nígbà tí wọn ń bọ̀ láti Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.2",
            "verseOrgIds": [
              "1SA.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lọ nísinsin yìí, kí o sì kọlu Amaleki, kí o sì pa gbogbo ohun tí ó bá jẹ́ tiwọn ní à parun. Má ṣe dá wọn sí, pa ọkùnrin àti obìnrin wọn, ọmọ kékeré àti ọmọ ọmú, màlúù àti àgùntàn, ìbákasẹ àti kẹ́tẹ́kẹ́tẹ́ wọn.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.3",
            "verseOrgIds": [
              "1SA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Saulu kó àwọn ènìyàn jọ, ó sì ka iye wọn ní Talaemu, wọ́n sì jẹ́ ogún ọ̀kẹ́ (200,000) àwọn ológun ẹlẹ́ṣẹ̀, pẹ̀lú ẹgbẹ̀rún mẹ́wàá (10,000) àwọn ọkùnrin Juda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.4",
            "verseOrgIds": [
              "1SA.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì lọ sí ìlú Amaleki ó sì gọ dè wọ́n ní àfonífojì kan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.5",
            "verseOrgIds": [
              "1SA.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ó wí fún àwọn ará Keni pé, \"Ẹ lọ, kúrò ní Amaleki kí èmi má ba à run yín pẹ̀lú wọn; nítorí ẹ̀yin fi àánú hàn fún gbogbo àwọn ọmọ Israẹli nígbà tí wọ́n gòkè ti Ejibiti wá.\" Bẹ́ẹ̀ ni àwọn Kenaiti lọ kúrò láàrín àwọn Amaleki.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.6",
            "verseOrgIds": [
              "1SA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Saulu kọlu àwọn Amaleki láti Hafila dé Ṣuri, tí ó fi dé ìlà-oòrùn Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.7",
            "verseOrgIds": [
              "1SA.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì mú Agagi ọba Amaleki láààyè, ó sì fi idà rẹ̀ kọlù gbogbo àwọn ènìyàn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.8",
            "verseOrgIds": [
              "1SA.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Saulu àti àwọn ọmọ-ogun rẹ̀ dá Agagi sí àti èyí tí ó dára jùlọ nínú àgùntàn àti màlúù àti ọ̀dọ́-àgùntàn àbọ́pa àti gbogbo nǹkan tó dára. Wọ́n kò sì fẹ́ pa àwọn wọ̀nyí run pátápátá ṣùgbọ́n gbogbo nǹkan tí kò dára tí kò sì níláárí ni wọ́n parun pátápátá.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.9",
            "verseOrgIds": [
              "1SA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.10",
            "verseOrgIds": [
              "1SA.15.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.10",
                "verseOrgIds": [
                  "1SA.15.10"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ Samuẹli wá pé,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.10",
            "verseOrgIds": [
              "1SA.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi káàánú gidigidi pé mo fi Saulu jẹ ọba, nítorí pé ó ti yípadà kúrò lẹ́yìn mi, kò sì pa ọ̀rọ̀ mi mọ́.\" Inú Samuẹli sì bàjẹ́ gidigidi, ó sì ké pe",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.11",
            "verseOrgIds": [
              "1SA.15.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.11",
                "verseOrgIds": [
                  "1SA.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ní gbogbo òru náà.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.11",
            "verseOrgIds": [
              "1SA.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òwúrọ̀ kùtùkùtù Samuẹli sì dìde láti lọ pàdé Saulu, ṣùgbọ́n wọ́n sọ fún un pé, \"Saulu ti wá sí Karmeli. Ó ti kọ́ ibìkan fún ara rẹ̀ níbẹ̀, ó sì ti yípadà, ó sì ti sọ̀kalẹ̀ lọ sí Gilgali.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.12",
            "verseOrgIds": [
              "1SA.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Samuẹli sì dé ọ̀dọ̀ rẹ̀, Saulu sì wí fún un pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.13",
            "verseOrgIds": [
              "1SA.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.13",
                "verseOrgIds": [
                  "1SA.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "bùkún fún ọ, mo ti ṣe ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.13",
            "verseOrgIds": [
              "1SA.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.13",
                "verseOrgIds": [
                  "1SA.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "pàṣẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.13",
            "verseOrgIds": [
              "1SA.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Samuẹli wí pé, \"Èwo wá ni igbe àgùntàn tí mo ń gbọ́ ní etí mi? Kí ni igbe màlúù ti mo ń gbọ́ yìí?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.14",
            "verseOrgIds": [
              "1SA.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì dáhùn pé, \"Àwọn ọmọ-ogun ní o mú wọn láti Amaleki wá, wọ́n dá àwọn àgùntàn, àti màlúù tí ó dára jùlọ sí láti fi rú ẹbọ sí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.15",
            "verseOrgIds": [
              "1SA.15.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.15",
                "verseOrgIds": [
                  "1SA.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ, ṣùgbọ́n a pa àwọn tókù run pátápátá.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.15",
            "verseOrgIds": [
              "1SA.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli sí wí fún Saulu pé, \"Dákẹ́ ná, jẹ́ kí èmi kí ó sọ ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.16",
            "verseOrgIds": [
              "1SA.15.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.16",
                "verseOrgIds": [
                  "1SA.15.16"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún mi ní alẹ́ àná fún ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.16",
            "verseOrgIds": [
              "1SA.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 15:16"
      },
      "items": [
        {
          "text": "Saulu sì wí pé, \"Sọ fún mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.16",
            "verseOrgIds": [
              "1SA.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli sì wí pé, \"Bí ó tilẹ̀ jẹ́ pé ìwọ fi ìgbà kan kéré lójú ara rẹ, ǹjẹ́ ìwọ kò ha di olórí ẹ̀yà Israẹli?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.17",
            "verseOrgIds": [
              "1SA.15.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.17",
                "verseOrgIds": [
                  "1SA.15.17"
                ]
              }
            }
          ]
        },
        {
          "text": "fi àmì òróró yàn ọ́ ní ọba lórí Israẹli.",
          "type": "text",
