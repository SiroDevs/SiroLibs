                "verseOrgIds": [
                  "1SA.15.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.30",
            "verseOrgIds": [
              "1SA.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Samuẹli sì yípadà pẹ̀lú Saulu, Saulu sì sin",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.31",
            "verseOrgIds": [
              "1SA.15.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.31",
                "verseOrgIds": [
                  "1SA.15.31"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.31",
            "verseOrgIds": [
              "1SA.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Samuẹli wí pé, \"Mú Agagi ọba àwọn ará Amaleki wá fún mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.32",
            "verseOrgIds": [
              "1SA.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 15:32"
      },
      "items": [
        {
          "text": "Agagi sì tọ̀ ọ́ wá ní ìgboyà pẹ̀lú èrò pé, \"Nítòótọ́ ìkorò ikú ti kọjá.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.32",
            "verseOrgIds": [
              "1SA.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Samuẹli wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 15:33"
      },
      "items": [
        {
          "text": "\"Bí idà rẹ ti sọ àwọn obìnrin di aláìní ọmọ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 15:33"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni ìyá rẹ yóò sì di aláìní ọmọ láàrín obìnrin.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1SA 15:33"
      },
      "items": [
        {
          "text": "Samuẹli sì pa Agagi níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
