              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Samuẹli wí fún un pé, \"Èmi kò ní bá ọ padà. Ìwọ ti kọ ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.26",
                "verseOrgIds": [
                  "1SA.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": "sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.26",
                "verseOrgIds": [
                  "1SA.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ti kọ̀ ọ́ ní ọba lórí Israẹli!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí Samuẹli sì ti fẹ́ yípadà láti lọ, Saulu sì di ẹ̀wù ìlekè rẹ̀ mú, ó sì fàya;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.27",
            "verseOrgIds": [
              "1SA.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli sì wí fún un pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.28",
            "verseOrgIds": [
              "1SA.15.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.28",
                "verseOrgIds": [
                  "1SA.15.28"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fa ìjọba Israẹli ya kúrò lọ́wọ́ ọ̀ rẹ lónìí, ó sì ti fi fún aládùúgbò rẹ kan tí ó sàn jù ọ́ lọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.28",
            "verseOrgIds": [
              "1SA.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó ń ṣe ògo Israẹli, kì í purọ́, bẹ́ẹ̀ ni kì í yí ọkàn rẹ̀ padà; nítorí kì í ṣe ènìyàn tí yóò yí ọkàn rẹ̀ padà.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.29",
            "verseOrgIds": [
              "1SA.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì wí pé, \"Èmi ti ṣẹ̀, ṣùgbọ́n jọ̀wọ́ bu ọlá fún mi níwájú àwọn àgbàgbà ènìyàn mi, àti níwájú u Israẹli, yípadà pẹ̀lú mi, kí èmi kí ó lè tẹríba fún",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.30",
            "verseOrgIds": [
              "1SA.15.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
