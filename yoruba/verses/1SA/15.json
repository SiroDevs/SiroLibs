                "verseOrgIds": [
                  "1SA.15.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", èmi sì ti lọ ní ọ̀nà tí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.20",
            "verseOrgIds": [
