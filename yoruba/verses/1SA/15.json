                "verseOrgIds": [
                  "1SA.15.25"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.25",
            "verseOrgIds": [
              "1SA.15.25"
            ]
          }
        }
      ]
    },
    {
