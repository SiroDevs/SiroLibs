  "verseCount": 58,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "1SA 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dafidi àti Goliati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filistini kó àwọn ọmọ-ogun rẹ̀ jọ fún ogun ní Soko ti Juda. Wọ́n pàgọ́ sí Efesi-Damimu, láàrín Soko àti Aseka,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.1",
            "verseOrgIds": [
              "1SA.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu àti àwọn ọmọ Israẹli wọ́n kò ara wọ́n jọ pọ̀, wọ́n sì pàgọ́ ní àfonífojì Ela, wọ́n sì gbé ogun wọn sókè ní ọ̀nà láti pàdé àwọn Filistini.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.2",
            "verseOrgIds": [
              "1SA.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn Filistini sì wà ní orí òkè kan àwọn ọmọ Israẹli sì wà ní orí òkè mìíràn, àfonífojì sì wà láàrín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.3",
            "verseOrgIds": [
              "1SA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀gágun tí a ń pè ní Goliati, tí ó jẹ́ ará Gati, ó wá láti ibùdó Filistini. Ó ga ní ìgbọ̀nwọ́ mẹ́fà àti ìnà ìka kan ní ìbú.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.4",
            "verseOrgIds": [
              "1SA.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ní àṣíborí idẹ ní orí rẹ̀, ó sì wọ ẹ̀wù tí a fi idẹ pẹlẹbẹ ṣe, ìwọ̀n ẹ̀wù náà sì jẹ́ ẹgbẹ̀rún márùn-ún (5,000) ṣékélì idẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.5",
            "verseOrgIds": [
              "1SA.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun sì wọ ìhámọ́ra idẹ sí ẹsẹ̀ rẹ̀ àti àpáta idẹ kan láàrín ẹ̀yìn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.6",
            "verseOrgIds": [
              "1SA.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀pá ọ̀kọ̀ rẹ̀ rí bí apásá ìhunṣọ, orí ọ̀kọ̀ rẹ̀ sì wọn ẹgbẹ̀ta (600) kilogiramu méje irin, ẹni tí ó ru asà ogun rẹ̀ lọ ṣáájú u rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.7",
            "verseOrgIds": [
              "1SA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goliati dìde, ó sì kígbe sí ogun Israẹli pé, \"Èéṣe tí ẹ̀yin fi jáde wá, tí ẹ ṣe tò fún ogun? Ṣé èmi kì í ṣe Filistini ni, àbí ẹ̀yin kì í ṣe ìránṣẹ́ Saulu? Yan ọkùnrin kan kí o sì jẹ́ kí ó sọ̀kalẹ̀ wá sí ọ̀dọ̀ mi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.8",
            "verseOrgIds": [
              "1SA.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí òhun bá sì le jà tí ó sì pa mí, àwa yóò di ẹrú u yín, ṣùgbọ́n tí èmi bá lè ṣẹ́gun rẹ̀ tí mo sì pa á, ẹ̀yin yóò di ẹrú u wa, ẹ̀yin yóò sì máa sìn wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.9",
            "verseOrgIds": [
              "1SA.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Filistini náà wí pé, \"Èmi fi ìjà lọ ogun Israẹli ní òní! Ẹ mú ọkùnrin kan wá kí ẹ sì jẹ́ kí a bá ara wa jà.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.10",
            "verseOrgIds": [
              "1SA.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Saulu àti gbogbo àwọn ọmọ Israẹli gbọ́ ọ̀rọ̀ Filistini, ìdààmú bá wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.11",
            "verseOrgIds": [
              "1SA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí Dafidi jẹ́ ọmọ ará Efrata kan tí orúkọ rẹ̀ ń jẹ́ Jese, tí ó wá láti Bẹtilẹhẹmu ní Juda, Jese ní ọmọ mẹ́jọ, ní àsìkò Saulu ó ti darúgbó ẹni ọdún púpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.12",
            "verseOrgIds": [
              "1SA.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Jese mẹ́tẹ̀ẹ̀ta tí ó ti dàgbà bá Saulu lọ sí ojú ogun, èyí àkọ́bí ni Eliabu, èyí èkejì ni Abinadabu, èyí ẹ̀kẹta sì ní Ṣamma.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.13",
            "verseOrgIds": [
              "1SA.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi ni ó kéré jù nínú wọn. Àwọn àgbà mẹ́tẹ̀ẹ̀ta sì tẹ̀lé Saulu,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.14",
            "verseOrgIds": [
              "1SA.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n Dafidi padà lẹ́yìn Saulu, láti máa tọ́jú àgùntàn baba rẹ̀ ní Bẹtilẹhẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.15",
            "verseOrgIds": [
              "1SA.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ogójì ọjọ́, Filistini wá síwájú ní àràárọ̀ àti ní ìrọ̀lẹ́ wọ́n sì fi ara wọn hàn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.16",
            "verseOrgIds": [
              "1SA.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí Jese wí fún ọmọ rẹ̀ Dafidi pé, \"Mú ìwọ̀n efa àti àgbàdo yíyan àti ìṣù àkàrà mẹ́wàá lọ fún àwọn ẹ̀gbọ́n rẹ kí o sì súré lọ sí ibùdó o wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.17",
            "verseOrgIds": [
              "1SA.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí o sì mú wàrà mẹ́wàá yìí lọ́wọ́ fún adarí ogun tiwọn. Wo bí àwọn ẹ̀gbọ́n rẹ ṣe wà kí o sì padà wá fún mi ní àmì ìdánilójú láti ọ̀dọ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.18",
            "verseOrgIds": [
              "1SA.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n wà pẹ̀lú Saulu àti gbogbo àwọn ọkùnrin Israẹli ní àfonífojì Ela, wọ́n bá àwọn Filistini jà.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.19",
            "verseOrgIds": [
              "1SA.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àárọ̀ kùtùkùtù Dafidi fi agbo ẹran rẹ̀ sílẹ̀ pẹ̀lú àwọn olùtọ́jú, ó di ẹrù, ó sì mú ọ̀nà rẹ̀ pọ̀n gẹ́gẹ́ bí Jese ti sọ fún un. Ó dé ibùdó bí àwọn ọmọ-ogun ti ń lọ láti dúró ní ipò wọn ní ojú ogun, wọ́n hó ìhó ogun.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.20",
            "verseOrgIds": [
              "1SA.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israẹli àti Filistini lọ sí ojú ìjà wọ́n da ojú ìjà kọ ara wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.21",
            "verseOrgIds": [
              "1SA.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì kó ẹrù rẹ̀ ti àwọn olùtọ́jú ohun èlò, ó sì sálọ sí ojú ogun ó sì kí àwọn ẹ̀gbọ́n rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.22",
            "verseOrgIds": [
              "1SA.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ṣe ń bá wọn sọ̀rọ̀, Goliati akíkanjú Filistini tí ó wá láti Gati bọ́ sí iwájú ní ojú ogun, ó sì kígbe fún ìpèníjà, Dafidi sì gbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.23",
            "verseOrgIds": [
              "1SA.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn Israẹli rí ọkùnrin náà, gbogbo wọn sì sá fún un ní ìbẹ̀rù bojo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.24",
            "verseOrgIds": [
              "1SA.17.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn ọkùnrin Israẹli wí pé, \"Ǹjẹ́ ẹ̀yin kò rí i bí ọkùnrin yìí ṣe ń jáde wá? Ó jáde wá láti pe Israẹli níjà. Ọba yóò fún ọkùnrin tí ó bá pa á ní ọrọ̀ púpọ̀. Yóò tún fi ọmọ rẹ̀ obìnrin fún un ní ìyàwó, yóò sì sọ ilé e baba rẹ̀ di òmìnira kúrò nínú sísan owó orí ní Israẹli.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.25",
            "verseOrgIds": [
              "1SA.17.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi béèrè lọ́wọ́ ọkùnrin tí ó dúró ní ẹ̀gbẹ́ ẹ rẹ̀ pé, \"Kí ni a yóò ṣe fún ọkùnrin náà tí ó bá pa Filistini yìí, tí ó sì mú ẹ̀gàn kúrò lára Israẹli? Ta ni aláìkọlà Filistini tí ó jẹ́ wí pé yóò máa gan ogun Ọlọ́run alààyè?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.26",
            "verseOrgIds": [
              "1SA.17.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n tún sọ fún un ohun tí wọ́n ti ń sọ, wọ́n sì wí pé, \"Èyí ni ohun tí wọn yóò ṣe fún ọkùnrin tí ó bá pa á.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.27",
            "verseOrgIds": [
              "1SA.17.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Eliabu ẹ̀gbọ́n Dafidi gbọ́ nígbà tí ó ń bá ọkùnrin yìí sọ̀rọ̀, ó bínú sí i, ó sì wí pé, \"Kí ni ó dé tí ìwọ fi sọ̀kalẹ̀ wá síbí? Àti pé ta ni ìwọ fi àwọn àgùntàn kékeré tókù ṣọ́ ní aginjù? Èmi mọ ìgbéraga rẹ, àti búburú ọkàn rẹ: ìwọ sọ̀kalẹ̀ wá nìkan láti wòran ogun.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.28",
            "verseOrgIds": [
              "1SA.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi wí pé, \"Kí ni mo ṣe nísinsin yìí? Ǹjẹ́ mo lè sọ̀rọ̀ bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.29",
            "verseOrgIds": [
              "1SA.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì yípadà sí ẹlòmíràn, ó sì ń sọ̀rọ̀ kan náà, ọkùnrin náà sì dáhùn bí ti ẹni ìṣáájú.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.30",
            "verseOrgIds": [
              "1SA.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn gbọ́ ohun tí Dafidi sọ wọ́n sọ fún Saulu, Saulu sì ránṣẹ́ sí i.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.31",
            "verseOrgIds": [
              "1SA.17.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sọ fún Saulu pé, \"Kí ẹnikẹ́ni má ṣe ba ọkàn jẹ́ nítorí Filistini yìí, ìránṣẹ́ rẹ yóò lọ láti bá a jà.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.32",
            "verseOrgIds": [
              "1SA.17.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì wí fún Dafidi pé, \"Ìwọ kò tó láti jáde lọ pàdé ogun Filistini yìí àti láti bá a jà; ọmọdé ni ìwọ, òun sì ti ń jagun láti ìgbà èwe rẹ̀ wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.33",
            "verseOrgIds": [
              "1SA.17.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Dafidi sọ fún Saulu pé, \"Ọmọ ọ̀dọ̀ rẹ ti ń tọ́jú agbo àgùntàn baba rẹ̀. Nígbà tí kìnnìún tàbí àmọ̀tẹ́kùn bá wá láti wá gbé àgùntàn láti inú igbó.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.34",
            "verseOrgIds": [
              "1SA.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sá tẹ̀lé e, mo lù ú, mo sì gba àgùntàn náà kúrò lẹ́nu rẹ̀. Nígbà tí ó kọjú sí mi, mo fi irun rẹ̀ gbá a mú, mo sì lù ú mo sì pa á.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.35",
            "verseOrgIds": [
              "1SA.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìránṣẹ́ rẹ ti pa kìnnìún àti àmọ̀tẹ́kùn, aláìkọlà Filistini yìí yóò jẹ́ ọ̀kan lára wọn, nítorí ó ti pe ogun Ọlọ́run alààyè ní ìjà.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.36",
            "verseOrgIds": [
              "1SA.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1SA 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.17.37",
                "verseOrgIds": [
                  "1SA.17.37"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó gbà mí kúrò lọ́wọ́ ìhàlẹ̀ kìnnìún àti ti ìhàlẹ̀ àmọ̀tẹ́kùn yóò gbà mí kúrò lọ́wọ́ Filistini yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.37",
            "verseOrgIds": [
              "1SA.17.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:37"
      },
      "items": [
        {
          "text": "Saulu wí fún Dafidi pé, \"Lọ kí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.37",
            "verseOrgIds": [
              "1SA.17.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.17.37",
                "verseOrgIds": [
                  "1SA.17.37"
                ]
              }
            }
          ]
        },
        {
          "text": "wà pẹ̀lú rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.37",
            "verseOrgIds": [
              "1SA.17.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 17:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu fi aṣọ àwọ̀tẹ́lẹ̀ rẹ̀ wọ Dafidi, ó wọ̀ ọ́ ní aṣọ ìhámọ́ra ogun, ó sì fi ìbòrí idẹ kan bò ó ní orí.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.38",
            "verseOrgIds": [
              "1SA.17.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 17:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi si di idà rẹ̀ mọ́ àwọ̀tẹ́lẹ̀ rẹ̀ ó sì bẹ̀rẹ̀ sí ní rìn káàkiri nítorí wí pé kò mọ́ ọ lára.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.39",
            "verseOrgIds": [
              "1SA.17.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:39"
      },
      "items": [
        {
          "text": "Ó sọ fún Saulu pé, \"Èmi kò le wọ èyí lọ, kò mọ́ mi lára.\" Ó sì bọ́ wọn kúrò.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.39",
            "verseOrgIds": [
              "1SA.17.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 17:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, ó sì mú ọ̀pá rẹ̀ lọ́wọ́, ó ṣá òkúta dídán márùn-ún létí odò, ó kó wọn sí àpò olùṣọ́-àgùntàn tí ó wà lọ́wọ́ rẹ̀ pẹ̀lú kànnàkànnà, ó sì súnmọ́ Filistini náà.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.40",
            "verseOrgIds": [
              "1SA.17.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 17:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lákòókò yìí, Filistini pẹ̀lú ẹni tí ń gbé ìhámọ́ra ààbò wà níwájú rẹ̀, ó ń bọ̀ wá sọ́dọ̀ Dafidi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.41",
            "verseOrgIds": [
              "1SA.17.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 17:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Filistini náà sì wo Dafidi láti òkè délẹ̀, ó sì rí i wí pé ọmọ kékeré kùnrin ni, ó pọ́n ó sì lẹ́wà lójú, ó sì kẹ́gàn an rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.42",
            "verseOrgIds": [
              "1SA.17.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 17:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí fún Dafidi pé, \"Ṣé ajá ni mí ni? Tí o fi tọ̀ mí wá pẹ̀lú ọ̀pá?\" Filistini sì fi Dafidi bú pẹ̀lú Ọlọ́run rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.43",
            "verseOrgIds": [
              "1SA.17.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 17:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filistini náà sì wí Dafidi pé, \"Wá níbí, èmi yóò fi ẹran-ara rẹ fún àwọn ẹyẹ ojú ọ̀run jẹ àti fún àwọn ẹranko tí ó wà nínú igbó!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.44",
            "verseOrgIds": [
              "1SA.17.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1SA 17:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì wí fún Filistini pé, \"Ìwọ dojú ìjà kọ mí pẹ̀lú idà, ọ̀kọ̀ àti ọfà, ṣùgbọ́n èmi wá sí ọ̀dọ̀ rẹ pẹ̀lú orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.45",
            "verseOrgIds": [
              "1SA.17.45"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.17.45",
                "verseOrgIds": [
                  "1SA.17.45"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun, Ọlọ́run àwọn ọmọ-ogun Israẹli tí ìwọ tí gàn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.45",
            "verseOrgIds": [
              "1SA.17.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 17:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lónìí yìí ni",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.46",
            "verseOrgIds": [
              "1SA.17.46"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.17.46",
                "verseOrgIds": [
                  "1SA.17.46"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò fi ọ́ lé mi lọ́wọ́, èmi yóò sì pa ọ́, èmi yóò sì gé orí rẹ. Lónìí èmi yóò fi òkú ogun Filistini fún ẹyẹ ojú ọ̀run àti fún ẹranko igbó, gbogbo ayé yóò sì mọ̀ pé Ọlọ́run wà ní Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.46",
            "verseOrgIds": [
              "1SA.17.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1SA 17:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn tí ó péjọ níbí ni yóò mọ̀ pé kì í ṣe nípa ọ̀kọ̀ tàbí idà ni",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.47",
            "verseOrgIds": [
              "1SA.17.47"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.17.47",
                "verseOrgIds": [
                  "1SA.17.47"
                ]
              }
            }
          ]
        },
        {
          "text": "fi ń gbàlà; ogun náà ti",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.47",
            "verseOrgIds": [
              "1SA.17.47"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.17.47",
                "verseOrgIds": [
                  "1SA.17.47"
                ]
              }
            }
          ]
        },
        {
          "text": "ni, yóò sì fi gbogbo yín lé ọwọ́ wa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.47",
            "verseOrgIds": [
              "1SA.17.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 17:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí Filistini ṣe súnmọ́ iwájú láti pàdé e rẹ̀. Dafidi yára sáré sí òun náà láti pàdé e rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.48",
            "verseOrgIds": [
              "1SA.17.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1SA 17:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi ti ọwọ́ sí àpò rẹ̀, ó sì mú òkúta jáde wá ó sì fì í, ó sì jù ú sí ọ̀kọ́kán iwájú orí Filistini. Òkúta náà sì wọ̀ ọ́ níwájú orí, ó sì ṣubú ó sì dojúbolẹ̀ ní orí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.49",
            "verseOrgIds": [
              "1SA.17.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1SA 17:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi yọ ayọ̀ ìṣẹ́gun lórí Filistini pẹ̀lú kànnàkànnà àti òkúta, láìsí idà ní ọwọ́ rẹ̀, ó lu Filistini, ó sì pa á.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.50",
            "verseOrgIds": [
              "1SA.17.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1SA 17:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì sáré ó sì dúró lórí rẹ̀. Ó sì mú idà Filistini, ó sì fà á yọ nínú àkọ̀ ọ rẹ̀. Lẹ́yìn ìgbà tí ó ti pa á tan, ó sì gé orí rẹ̀ pẹ̀lú idà.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.51",
            "verseOrgIds": [
              "1SA.17.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:51"
      },
      "items": [
        {
          "text": "Nígbà tí àwọn ará Filistini rí i wí pé akọni wọn ti kú, wọ́n yípadà wọ́n sì sálọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.51",
            "verseOrgIds": [
              "1SA.17.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1SA 17:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, àwọn ọkùnrin Israẹli àti ti Juda súnmọ́ iwájú pẹ̀lú ariwo, wọ́n sì lépa àwọn ará Filistini dé ẹnu ibodè Gati àti títí dé ẹnu ibodè Ekroni. Àwọn tí ó kú wà káàkiri ẹ̀gbẹ́ ọ̀nà Ṣaaraimu àti títí dé ọ̀nà Gati àti Ekroni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.52",
            "verseOrgIds": [
              "1SA.17.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1SA 17:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ọmọ Israẹli sì padà láti máa lé àwọn ará Filistini, wọ́n sì ba ibùdó wọn jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.53",
            "verseOrgIds": [
              "1SA.17.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1SA 17:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi gé orí Filistini ó sì gbé e wá sí Jerusalẹmu, ó sì kó àwọn ohun ìjà Filistini sínú àgọ́ tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.54",
            "verseOrgIds": [
              "1SA.17.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1SA 17:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí Saulu sì ti wo Dafidi bí ó ṣe ń jáde lọ pàdé Filistini, ó wí fún Abneri, olórí àwọn ológun rẹ̀ pé, \"Abneri, ọmọ ta ni ọmọdékùnrin yìí?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.55",
            "verseOrgIds": [
              "1SA.17.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:55"
      },
      "items": [
        {
          "text": "Abneri dáhùn pe, \"Bí ọkàn rẹ̀ ti ń bẹ ní ààyè, ọba èmi kò mọ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.55",
            "verseOrgIds": [
              "1SA.17.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "1SA 17:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì wí pé, \"Wádìí ọmọ ẹni tí ọmọdékùnrin náà ń ṣe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.56",
            "verseOrgIds": [
              "1SA.17.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "1SA 17:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kété tí ó dé láti ibi tí ó ti lọ pa Filistini, Abneri sì mú u wá síwájú Saulu, orí Filistini sì wà ní ọwọ́ Dafidi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.57",
            "verseOrgIds": [
              "1SA.17.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "1SA 17:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu béèrè pé, \"Ọmọdékùnrin, ọmọ ta ni ọ́?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.58",
            "verseOrgIds": [
              "1SA.17.58"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:58"
      },
      "items": [
        {
          "text": "Dafidi dáhùn pé, \"Èmi ni ọmọ ìránṣẹ́ rẹ Jese ti Bẹtilẹhẹmu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.58",
            "verseOrgIds": [
              "1SA.17.58"
            ]
          }
        }
      ]
    }
  ],
