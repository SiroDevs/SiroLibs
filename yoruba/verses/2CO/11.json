  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "2CO 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulu àti àwọn aposteli ẹlẹ́kọ̀ọ́ èké",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo rò wí pé ẹ ó faradà díẹ̀ nínú ìwà òmùgọ̀ mi ṣùgbọ́n bẹ́ẹ̀ ni, mo fẹ́ kí ẹ gbà mí láàyè.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.1",
            "verseOrgIds": [
              "2CO.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé èmi ń jowú lórí i yín bí ẹni ìwà-bí-Ọlọ́run, nítorí tí mo ti fì yín fún ọkọ kan, kí èmi bà á lè mú yín wá bí wúńdíá tí ó mọ́ sọ́dọ̀ Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.2",
            "verseOrgIds": [
              "2CO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ̀rù ń bà mí, kí ó má bà á jẹ́ pé, bí ejò ti tan Efa jẹ́ nípasẹ̀ àrékérekè rẹ̀, a lè mú ọkàn yín ṣáko lọ kúrò nínú òtítọ́ yín àti ìfarajì fún Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.3",
            "verseOrgIds": [
              "2CO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí bí ẹnìkan bá wá tí ó sì wàásù Jesu mìíràn, yàtọ̀ sí èyí tí a ti wàásù rí tàbí bí ẹ̀yin bá gba ẹ̀mí mìíràn, yàtọ̀ sí èyí tí ẹ ti gbà tàbí ìyìnrere mìíràn yàtọ̀ sí èyí tí ẹ ti gbà, tí ẹ sì ti yára tẹ́wọ́ gbà á.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.4",
            "verseOrgIds": [
              "2CO.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí mo rò pé èmi kò rẹ̀yìn nínú ohunkóhun sí àwọn àgbà Aposteli.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.5",
            "verseOrgIds": [
              "2CO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí mo tilẹ̀ jẹ́ òpè nínú ọ̀rọ̀ sísọ, kì í ṣe nínú ìmọ̀; ní ọ̀nàkọnà ni àwa ti fi èyí hàn dájúdájú fún yín nínú ohun gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.6",
            "verseOrgIds": [
              "2CO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tàbí ẹ̀ṣẹ̀ ni mo dá bí èmi ti ń rẹ ara mí sílẹ̀ kí a lè gbé yín ga, nítorí tí mo wàásù ìyìnrere Ọlọ́run fún un yín lọ́fẹ̀ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.7",
            "verseOrgIds": [
              "2CO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmí ń ja ìjọ mìíràn ni olè nípa gbígba ìpèsè owó ki èmi bà á lè sìn yín.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.8",
            "verseOrgIds": [
              "2CO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí mo sì wà pẹ̀lú yín, tí mo sì ṣe aláìní, èmi kò dẹ́rù pa ẹnikẹ́ni, nítorí ohun tí mo ṣe aláìní ni àwọn ará tí ó ti Makedonia wá ti mú wá. Bẹ́ẹ̀ ni nínú ohun gbogbo mo pa ara mi mọ́ láti má ṣe jẹ́ ẹrù fún yín, èmi yóò sì pa ara mi mọ́ bẹ́ẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.9",
            "verseOrgIds": [
              "2CO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó jẹ́ òtítọ́, Kristi tí ń bẹ nínú mi pé kò sí ẹni tí ó lè dá mi lẹ́kun ìṣògo yìí ni gbogbo ẹkùn Akaia.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.10",
            "verseOrgIds": [
              "2CO.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí kín ni? Nítorí èmi kò fẹ́ràn yín ni bí? Ọlọ́run mọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.11",
            "verseOrgIds": [
              "2CO.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò tẹ̀síwájú láti máa ṣe ohun ti èmi ń ṣe láti le mú ìjákulẹ̀ bá àwọn tí wọn ń wá ọ̀nà láti bá wa dọ́gba nínú èyí ti àwa ń ṣògo lé lórí.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.12",
            "verseOrgIds": [
              "2CO.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí irú àwọn ènìyàn bẹ́ẹ̀ ni àwọn èké Aposteli àwọn ẹni ti ń ṣiṣẹ́ ẹ̀tàn, tí ń pa wọ́n dà di aposteli Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.13",
            "verseOrgIds": [
              "2CO.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kì í sì í ṣe ohun ìyanu; nítorí Satani, tìkára rẹ̀ ń pa ara rẹ̀ dàbí angẹli ìmọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.14",
            "verseOrgIds": [
              "2CO.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà kì í ṣe ohun ńlá bí àwọn ìránṣẹ́ rẹ̀ pẹ̀lú bá pa ara wọn dàbí àwọn ìránṣẹ́ òdodo; ìgbẹ̀yìn àwọn ẹni tí yóò rí gẹ́gẹ́ bí iṣẹ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.15",
            "verseOrgIds": [
              "2CO.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulu ṣògo nínú ìjìyà rẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sì tún wí pé, kí ẹnikẹ́ni má ṣe rò pé òmùgọ̀ ni mí; ṣùgbọ́n bí bẹ́ẹ̀ bá ni, ẹ gbà mí bí òmùgọ̀ kí èmi lè gbé ara mi ga díẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.16",
            "verseOrgIds": [
              "2CO.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohun tí èmi ń sọ, èmi kò sọ ọ́ nípa ti Olúwa, ṣùgbọ́n bí òmùgọ̀ nínú ìgbẹ́kẹ̀lé ìṣògo yìí.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.17",
            "verseOrgIds": [
              "2CO.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀pọ̀lọpọ̀, ni ó ń ṣògo nípa ti ara, èmi ó ṣògo pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.18",
            "verseOrgIds": [
              "2CO.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ẹ̀yin fi inú dídùn gba àwọn òmùgọ̀ nígbà tí ẹ̀yin tìkára yín jẹ́ ọlọ́gbọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.19",
            "verseOrgIds": [
              "2CO.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ẹ̀yin faradà á bí ẹnìkan bá sọ yín dí òǹdè, bí ẹnìkan bá jẹ́ yín run, bí ẹnìkan bá gbà lọ́wọ́ yín, bí ẹnìkan bá gbé ara rẹ̀ ga, bí ẹnìkan bá gbá yín lójú.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.20",
            "verseOrgIds": [
              "2CO.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ń wí lọ́nà ẹ̀gàn, bí ẹni pé àwa jẹ́ aláìlera!",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.21",
            "verseOrgIds": [
              "2CO.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CO 11:21"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n nínú ohunkóhun tí ẹnìkan ti ní ìgboyà, èmi ń sọ̀rọ̀ bí òmùgọ̀, èmi ní ìgboyà pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.21",
            "verseOrgIds": [
              "2CO.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heberu ni wọ́n bí? Bẹ́ẹ̀ ni èmi. Israẹli ni wọ́n bí? Bẹ́ẹ̀ ni èmi. Irú-ọmọ Abrahamu ní òun bí? Bẹ́ẹ̀ ni èmi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.22",
            "verseOrgIds": [
              "2CO.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìránṣẹ́ Kristi ni wọ́n bí? Èmi ń sọ bí òmùgọ̀, mo ta wọ́n yọ; ní ti làálàá lọ́pọ̀lọ́pọ̀, ní ti pàṣán, mo rékọjá, ní ti túbú nígbàkígbà, ní ti fífẹ́rẹ kú nígbà púpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.23",
            "verseOrgIds": [
              "2CO.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CO 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà márùn-ún ni mo gba pàṣán ogójì dín ẹyọ kan lọ́wọ́ àwọn Júù.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.24",
            "verseOrgIds": [
              "2CO.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà mẹ́ta ni a fi ọ̀gọ̀ lù mí, ẹ̀ẹ̀kan ṣoṣo ni a sọ mí ní òkúta, ẹ̀ẹ̀mẹta ni ọkọ̀ ojú omi mi rì, ọ̀sán kan àti òru kan ni mo wà nínú ibú.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.25",
            "verseOrgIds": [
              "2CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìrìnàjò nígbàkígbà, nínú ewu omi, nínú ewu àwọn ọlọ́ṣà, nínú ewu àwọn ará ìlú mi, nínú ewu àwọn aláìkọlà, nínú ewu ni ìlú, nínú ewu ní aginjù, nínú ewu lójú Òkun, nínú ewu láàrín àwọn èké arákùnrin.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú làálàá àti ìrora, nínú ìṣọ́ òru nígbàkígbà, nínú ebi àti òǹgbẹ, nínú àwẹ̀ nígbàkígbà, nínú òtútù àti ìhòhò.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.27",
            "verseOrgIds": [
              "2CO.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú nǹkan wọ̀nyí tí ó jẹ́ tí òde, ọ̀pọ̀ ni èyí tí ń wọn n dúró tì mí lójoojúmọ́, àní àníyàn fún gbogbo ìjọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.28",
            "verseOrgIds": [
              "2CO.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó ṣe àìlera, tí èmi kò ṣe àìlera? Tàbí a mú kọsẹ̀, tí ara mi kò gbiná?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
            "verseOrgIds": [
              "2CO.11.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CO 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí èmi yóò bá ṣògo, èmi ó kúkú máa ṣògo nípa àwọn nǹkan tí ó jẹ́ ti àìlera mi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.30",
            "verseOrgIds": [
              "2CO.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CO 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run àti Baba Olúwa wá Jesu Kristi, ẹni tí ó jẹ́ olùbùkún jùlọ láéláé mọ̀ pé èmi kò ṣèké.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.31",
            "verseOrgIds": [
              "2CO.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CO 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní Damasku, baálẹ̀ tí ó wà lábẹ́ ọba Areta fi ẹgbẹ́ ogun ká ìlú àwọn ará Damasku mọ́, ó ń fẹ́ láti mú mi bí arúfin.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
            "verseOrgIds": [
              "2CO.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CO 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ojú fèrèsé nínú agbọ̀n ni a sì ti sọ̀ mí kalẹ̀ lẹ́yìn odi, tí mo sì bọ́ lọ́wọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.33",
            "verseOrgIds": [
              "2CO.11.33"
            ]
          }
        }
      ]
    }
