  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "1CH 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saulu gba ẹ̀mí ara rẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, àwọn ará Filistini dojú ìjà kọ Israẹli, àwọn ará Israẹli sì sálọ kúrò níwájú wọn, a sì pa ọ̀pọ̀ wọn sí orí òkè Gilboa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.1",
            "verseOrgIds": [
              "1CH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Filistini sí lépa Saulu gidigidi àti àwọn ọmọ rẹ̀. Wọ́n sì pa àwọn ọmọ rẹ̀. Jonatani, Abinadabu àti Malikiṣua.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.2",
            "verseOrgIds": [
              "1CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogun náà sí gbóná janjan fún Saulu, nígbà tí àwọn tafàtafà sì lé e bá, wọ́n sì ṣá a lọ́gbẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.3",
            "verseOrgIds": [
              "1CH.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì sọ fún ẹni tí ó gbé ìhámọ́ra rẹ̀ pé, \"Fa idà rẹ yọ, kí o sì fi gún mi, kí àwọn aláìkọlà wọ̀nyí má wá láti bú mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.4",
            "verseOrgIds": [
              "1CH.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 10:4"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n ẹni tí ó ń gbé ìhámọ́ra rẹ̀ ń bẹ̀rù, kò sì le ṣe é, bẹ́ẹ̀ ni Saulu mú idà tirẹ̀ ó sì ṣubú lé e.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.4",
            "verseOrgIds": [
              "1CH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí agbé-ìhámọ́ra rí pé Saulu ti kú, òhun pẹ̀lú ṣubú lórí idà tirẹ̀, ó sì kú.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.5",
            "verseOrgIds": [
              "1CH.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Saulu àti ọmọ rẹ̀ mẹ́tẹ̀ẹ̀ta kú, gbogbo ilé rẹ̀ sì kú ṣọ̀kan, lọ́jọ́ kan náà.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.6",
            "verseOrgIds": [
              "1CH.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí gbogbo àwọn ọmọ Israẹli tí ó wà ní pẹ̀tẹ́lẹ̀ rí wí pé àwọn ọmọ-ogun ti sálọ àti pé Saulu àti àwọn ọmọ rẹ̀ ti kú wọ́n kọ àwọn ìlú wọn sílẹ̀, wọ́n sì sálọ. Àwọn ará Filistini wá, wọ́n sì jókòó nínú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.7",
            "verseOrgIds": [
              "1CH.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kejì, nígbà tí àwọn ará Filistini wá láti kó òkú, wọ́n rí Saulu àti àwọn ọmọ rẹ̀ tí wọ́n ṣubú sórí òkè Gilboa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.8",
            "verseOrgIds": [
              "1CH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n bọ́ ní aṣọ, wọ́n sì gbé orí rẹ̀ àti ìhámọ́ra rẹ̀, wọ́n sì rán ìránṣẹ́ lọ káàkiri ilẹ̀ àwọn ará Filistini láti kéde ìròyìn náà láàrín àwọn òrìṣà wọn àti àwọn ènìyàn wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.9",
            "verseOrgIds": [
              "1CH.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n gbé ìhámọ́ra rẹ̀ sí inú ilé tí wọ́n kọ́ fún òrìṣà wọn, wọ́n sì fi orí rẹ̀ kọ́ sí inú ilé Dagoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.10",
            "verseOrgIds": [
              "1CH.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí gbogbo àwọn olùgbé Jabesi—Gileadi gbọ́ gbogbo ohun tí àwọn ará Filistini ṣe fún Saulu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.11",
            "verseOrgIds": [
              "1CH.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "gbogbo àwọn akọni ọkùnrin wọn lọ láti mú àwọn ará Saulu àti àwọn ọmọ rẹ̀, wọ́n sì kó wọn wá sí Jabesi. Nígbà náà, wọ́n sin egungun wọn sábẹ́ igi óákù ní Jabesi, wọ́n sì gbààwẹ̀ fún ọjọ́ méje.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.12",
            "verseOrgIds": [
              "1CH.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu kú nítorí kò ṣe òtítọ́ sí",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.10.13",
                "verseOrgIds": [
                  "1CH.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", kò pa ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.10.13",
                "verseOrgIds": [
                  "1CH.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": "mọ́ pẹ̀lú, ó tọ abókùúsọ̀rọ̀ lọ fún ìtọ́sọ́nà.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sì béèrè lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.10.14",
                "verseOrgIds": [
                  "1CH.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", bẹ́ẹ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.10.14",
                "verseOrgIds": [
                  "1CH.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "pa á, Ó sì yí ìjọba náà padà sọ́dọ̀ Dafidi ọmọ Jese.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        }
      ]
    }
  ],
