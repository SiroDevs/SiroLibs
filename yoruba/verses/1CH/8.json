          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aseli ní ọmọ mẹ́fà pẹ̀lú wọ̀nyí ni orúkọ wọn:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:38"
      },
      "items": [
        {
          "text": "Asrikamu, Bokeru, Iṣmaeli, Ṣeariah, Obadiah àti Hanani. Gbogbo wọ̀nyí ni ọmọ Aseli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ arákùnrin rẹ̀ Eseki:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:39"
      },
      "items": [
        {
          "text": "Ulamu àkọ́bí rẹ̀, Jeuṣi ọmọkùnrin ẹ̀ẹ̀kejì àti Elifeleti ẹ̀ẹ̀kẹ́ta.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Ulamu jẹ́ ògboyà jagunjagun tí ó lè gbá orin mú. Wọ́n ní ọ̀pọ̀ ọmọkùnrin àti ọmọ ọmọkùnrin áàdọ́jọ ní gbogbo rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.40",
            "verseOrgIds": [
              "1CH.8.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 8:40"
      },
      "items": [
        {
          "text": "Gbogbo wọ̀nyí ni àwọn ìdílé ìran ọmọ Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.40",
            "verseOrgIds": [
              "1CH.8.40"
            ]
          }
        }
      ]
