          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasi jẹ́ baba a Jeheada, Jeheada jẹ́ baba a Alemeti, Asmafeti àti Simri, Simri sì jẹ́ baba Mosa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.36",
            "verseOrgIds": [
              "1CH.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosa jẹ́ baba Binea; Rafa sì jẹ́ ọmọ rẹ̀, Eleasa ọmọ rẹ̀ àti Aseli ọmọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.37",
            "verseOrgIds": [
              "1CH.8.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
