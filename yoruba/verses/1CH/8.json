          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neri jẹ́ baba Kiṣi, Kiṣi baba Saulu àti Saulu baba Jonatani, Malikiṣua, Abinadabu àti Eṣi-Baali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
