            "sid": "1CH 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "àkọ́bí rẹ̀ a sì máa jẹ́ Abdoni wọ̀nyí sì ń tẹ̀lé Suri, Kiṣi, Baali, Neri, Nadabu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.30",
            "verseOrgIds": [
              "1CH.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
