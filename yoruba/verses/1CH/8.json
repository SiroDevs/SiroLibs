      "attrs": {
        "style": "li2",
        "vid": "1CH 8:35"
      },
      "items": [
        {
          "text": "Pitoni, Meleki, Tarea, àti Ahasi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.35",
            "verseOrgIds": [
              "1CH.8.35"
            ]
          }
        }
