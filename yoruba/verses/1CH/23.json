            "verseOrgIds": [
              "1CH.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:23"
      },
      "items": [
        {
          "text": "Mahili, Ederi àti Jerimoti mẹ́ta ni gbogbo wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.23",
            "verseOrgIds": [
              "1CH.23.23"
            ]
          }
        }
      ]
