    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn wọ̀nyí sì ni ọmọ Lefi bí ìdílé wọn. Olórí ìdílé gẹ́gẹ́ bí wọ́n ti fi orúkọ sílẹ̀ lábẹ́ orúkọ wọn, ó sì kà wọn ní ẹyọ kọ̀ọ̀kan, wí pé, àwọn òṣìṣẹ́ tí ó jẹ́ ogún ọdún tàbí jù bẹ́ẹ̀ lọ tí ń ṣiṣẹ́ ìsìn nínú ilé",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé Dafidi ti sọ pé, \"Níwọ̀n ìgbà tí",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli, ti fi ìsinmi fún àwọn ènìyàn tí ó kù tí sì ń gbé Jerusalẹmu títí láéláé,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn ọmọ Lefi kò sì tún ru àgọ́ tàbí ọ̀kankan lára àwọn ohun èlò tí wọ́n ń lò níbi ìsìn rẹ̀.\"",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí ọ̀rọ̀ ìkẹyìn Dafidi sí, àwọn ọmọ Lefi, wọ́n sì kà wọ́n, bẹ̀rẹ̀ láti orí àwọn ọmọ ogún ọdún tàbí jù bẹ́ẹ̀ lọ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iṣẹ́ àwọn ọmọ Lefi ni láti ran àwọn ọmọ Aaroni lọ́wọ́ nínú iṣẹ́ wọn fún ti ilé",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.28",
                "verseOrgIds": [
                  "1CH.23.28"
                ]
              }
            }
          ]
        },
        {
          "text": ": láti wà lábẹ́ ìkáwọ́ agbára ìlú, àti ẹ̀gbẹ́ ilé, àti ìwẹ̀nùmọ́ ti gbogbo ohun ìyàsọ́tọ̀ àti ṣíṣe ohun tí í ṣe iṣẹ́ ìsìn nínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.28",
                "verseOrgIds": [
                  "1CH.23.28"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì wà ní ìkáwọ́ àkàrà tí wọ́n mú jáde láti orí tábìlì, àti ìyẹ̀fun fún ẹbọ, àti àkàrà aláìwú, àti fún púpọ̀ àti èyí tí a pòpọ̀, àti gbogbo onírúurú ìwọ̀n àti wíwọ̀n àti òsùwọ̀n.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.29",
            "verseOrgIds": [
              "1CH.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì gbọdọ̀ dúró ní gbogbo òwúrọ̀ láti dúpẹ́ àti láti yin",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.30",
            "verseOrgIds": [
              "1CH.23.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.30",
                "verseOrgIds": [
                  "1CH.23.30"
                ]
              }
            }
          ]
        },
        {
          "text": ". Wọ́n sì gbọdọ̀ ṣe irú kan náà ní àṣálẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.30",
            "verseOrgIds": [
              "1CH.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti láti rú ẹbọ sísun fún",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.31",
            "verseOrgIds": [
              "1CH.23.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.31",
                "verseOrgIds": [
                  "1CH.23.31"
                ]
              }
            }
          ]
        },
        {
          "text": "ní ọjọ́ ìsinmi àti ní àsìkò oṣù tuntun àti ní àjọ̀dún tí a yàn. Wọ́n gbọdọ̀ sìn níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.31",
            "verseOrgIds": [
              "1CH.23.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.31",
                "verseOrgIds": [
                  "1CH.23.31"
                ]
              }
            }
          ]
        },
        {
          "text": "lójoojúmọ́ ní iye tó yẹ àti ní ọ̀nà tí a ti pàṣẹ fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.31",
            "verseOrgIds": [
              "1CH.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni nígbà náà, àwọn ọmọ Lefi gbé ìgbékalẹ̀ jáde fún ìpàdé àgọ́, fún Ibi Mímọ́ àti, lábẹ́ àwọn arákùnrin àwọn ọmọ Aaroni fún ìsìn ilé",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
            "verseOrgIds": [
              "1CH.23.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.32",
                "verseOrgIds": [
                  "1CH.23.32"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
            "verseOrgIds": [
              "1CH.23.32"
            ]
          }
        }
      ]
    }
