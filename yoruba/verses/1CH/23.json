    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleasari sì kú pẹ̀lú àìní àwọn ọmọkùnrin: Ó ní ọmọbìnrin nìkan. Àwọn ọmọ ẹ̀gbọ́n, àwọn ọmọ Kiṣi, sì fẹ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.22",
            "verseOrgIds": [
              "1CH.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
