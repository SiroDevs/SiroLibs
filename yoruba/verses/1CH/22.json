                "verseOrgIds": [
                  "1CH.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "àti ohun èlò mímọ́ tí ó jẹ́ ti Ọlọ́run, sínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.19",
            "verseOrgIds": [
              "1CH.22.19"
            ]
