  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "1CH 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Dafidi wí pé, \"Ilé",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.1",
            "verseOrgIds": [
              "1CH.22.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.22.1",
                "verseOrgIds": [
                  "1CH.22.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run ni ó gbọdọ̀ wà níbí, àti pẹ̀lú pẹpẹ ẹbọ sísun fún Israẹli.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.1",
            "verseOrgIds": [
              "1CH.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìmúrasílẹ̀ fún ilé tí a kọ́ fún ìsìn Ọlọ́run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Dafidi pàṣẹ láti kó àwọn àjèjì tí ń gbé ní Israẹli jọ, àti wí pé lára wọn ni ó ti yan àwọn agbẹ́-òkúta láti gbé òkúta dáradára láti fi kọ́lé Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.2",
            "verseOrgIds": [
              "1CH.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì pèsè ọ̀pọ̀lọpọ̀ iye irin láti fi ṣe ìṣó fún àwọn ìlẹ̀kùn ẹnu-ọ̀nà àti fún idẹ; àti fún òpó idẹ ni àìní ìwọ̀n.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.3",
            "verseOrgIds": [
              "1CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tún pèsè ọ̀pọ̀lọpọ̀ igi Kedari tí ó jẹ́ àìníye, nítorí pé àwọn ará Sidoni àti àwọn ará Tire mú ọ̀pọ̀lọpọ̀ igi kedari wá fún Dafidi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.4",
            "verseOrgIds": [
              "1CH.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi wí pé, \"Ọmọ mi Solomoni ọ̀dọ́mọdé ni ó sì jẹ́ aláìní ìrírí, ilé tí a ó kọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.5",
            "verseOrgIds": [
              "1CH.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.22.5",
                "verseOrgIds": [
                  "1CH.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "gbọdọ̀ jẹ́ títóbi jọjọ, kí ó sì ní òkìkí àti ògo jákèjádò gbogbo àwọn orílẹ̀-èdè. Nítorí náà ni èmi yóò ṣe pèsè sílẹ̀ fún un\". Bẹ́ẹ̀ ni Dafidi sì ṣe ìpèsè sílẹ̀ lọ́pọ̀lọ́pọ̀ kí ó tó di wí pé ó kú.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.5",
            "verseOrgIds": [
              "1CH.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ó pe Solomoni ọmọ rẹ̀ ó sì sọ fun pé kí ó kọ́ ilé fún un",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.6",
            "verseOrgIds": [
              "1CH.22.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.22.6",
                "verseOrgIds": [
                  "1CH.22.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.6",
            "verseOrgIds": [
              "1CH.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì wí fún Solomoni pé, \"Ọmọ mi, mo sì ní-in ní ọkàn mi láti kọ́ ilé fún orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.7",
            "verseOrgIds": [
              "1CH.22.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.22.7",
                "verseOrgIds": [
                  "1CH.22.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run mi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.7",
            "verseOrgIds": [
              "1CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.8",
            "verseOrgIds": [
              "1CH.22.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.22.8",
                "verseOrgIds": [
                  "1CH.22.8"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ mí wá wí pé, 'Ìwọ ti ta ẹ̀jẹ̀ sílẹ̀ ní ọ̀pọ̀lọpọ̀, o sì ti ja ọ̀pọ̀ ogun ńlá ńlá, kì í ṣe ìwọ ni yóò kọ́ ilé fún orúkọ mi, nítorí ìwọ ti ta ẹ̀jẹ̀ sílẹ̀ púpọ̀ lórí ilẹ̀ ní ojú mi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.8",
            "verseOrgIds": [
              "1CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìwọ yóò ní ọmọ tí yóò sì jẹ́ ọkùnrin onírẹ̀lẹ̀ àti onísinmi, Èmi yóò sì fún un ní ìsinmi láti ọ̀dọ̀ gbogbo àwọn ọ̀tá rẹ̀ lórí gbogbo ilẹ̀ yíká. Orúkọ rẹ̀ yóò sì máa jẹ́ Solomoni, Èmi yóò sì fi àlàáfíà àti ìdákẹ́ jẹ́ẹ́ fún Israẹli lásìkò ìjọba rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.9",
            "verseOrgIds": [
              "1CH.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ni ẹni náà tí yóò kọ́ ilé fún orúkọ mi. Yóò sì jẹ́ ọmọ mi, èmi yóò sì jẹ́ baba rẹ̀ èmi yóò sì fi ìdí ìtẹ́ ìjọba rẹ̀ múlẹ̀ lórí Israẹli láéláé.'",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.10",
            "verseOrgIds": [
              "1CH.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nísinsin yìí, ọmọ mi, kí",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.11",
            "verseOrgIds": [
              "1CH.22.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.22.11",
                "verseOrgIds": [
                  "1CH.22.11"
                ]
              }
            }
          ]
        },
        {
          "text": "wà pẹ̀lú rẹ, kí ìwọ kí ó sì ní àṣeyọrí kí o sì kọ́ ilé",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.11",
            "verseOrgIds": [
              "1CH.22.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.22.11",
                "verseOrgIds": [
                  "1CH.22.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ, àti gẹ́gẹ́ bí ó ti sọ nípa rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.11",
            "verseOrgIds": [
              "1CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.12",
            "verseOrgIds": [
              "1CH.22.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.22.12",
                "verseOrgIds": [
                  "1CH.22.12"
                ]
              }
            }
          ]
        },
        {
          "text": "kí ó fún ọ ni ọgbọ́n àti òye nígbà tí ó bá fi ọ́ ṣe aláṣẹ lórí Israẹli, bẹ́ẹ̀ ni kí ìwọ kí ó lè pa òfin",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.12",
            "verseOrgIds": [
              "1CH.22.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.22.12",
                "verseOrgIds": [
                  "1CH.22.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.12",
            "verseOrgIds": [
              "1CH.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ìwọ yóò sì ní àṣeyọrí tí ìwọ bá ṣe àkíyèsí láti mú àṣẹ àti ìdájọ́ àti òfin ti",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.13",
            "verseOrgIds": [
              "1CH.22.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.22.13",
                "verseOrgIds": [
                  "1CH.22.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fi fún Mose fun Israẹli ṣe. Bẹ́ẹ̀ ni ki ìwọ jẹ́ alágbára àti onígboyà. Má ṣè bẹ̀rù tàbí kí àyà má sì ṣe fò ọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.13",
            "verseOrgIds": [
              "1CH.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi ti gba ìpọ́njú ńlá láti ṣe fún ilé",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.14",
            "verseOrgIds": [
              "1CH.22.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.22.14",
                "verseOrgIds": [
                  "1CH.22.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ọ̀kẹ́ márùn-ún tálẹ́ǹtì wúrà, àti ẹgbẹ̀rún ẹgbẹ̀rún tálẹ́ǹtì fàdákà, ìwọ̀n idẹ àti irin tí ó tóbi àìní ìwọ̀n, àti ìtì igi àti òkúta. Ìwọ sì tún le fi kún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.14",
            "verseOrgIds": [
              "1CH.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ sì ní ọ̀pọ̀lọpọ̀ àwọn oníṣẹ́ ènìyàn: àwọn gbẹ́nàgbẹ́nà, àti àwọn oníṣọ̀nà òkúta àti àwọn agbẹ́-òkúta, àti gẹ́gẹ́ bí onírúurú ọlọ́gbọ́n ènìyàn ní gbogbo onírúurú iṣẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.15",
            "verseOrgIds": [
              "1CH.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú wúrà, fàdákà àti idẹ àti irin oníṣọ̀nà tí kò ní ìwọ̀n. Nísinsin yìí bẹ̀rẹ̀ iṣẹ́, kí",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.16",
            "verseOrgIds": [
              "1CH.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.22.16",
                "verseOrgIds": [
                  "1CH.22.16"
                ]
              }
            }
          ]
