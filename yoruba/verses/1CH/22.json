            "sid": "1CH 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, ẹ ṣí ọkàn yin páyà àti àyà yín sí àti wá",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.19",
            "verseOrgIds": [
              "1CH.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.22.19",
                "verseOrgIds": [
                  "1CH.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín. Bẹ́ẹ̀ sì ni kọ́ ibi mímọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.19",
            "verseOrgIds": [
              "1CH.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.22.19",
                "verseOrgIds": [
                  "1CH.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run. Bẹ́ẹ̀ ni kí ìwọ kí ó le gbé àpótí ẹ̀rí ti májẹ̀mú",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.19",
            "verseOrgIds": [
              "1CH.22.19"
            ]
          }
