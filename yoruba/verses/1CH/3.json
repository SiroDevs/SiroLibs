      "attrs": {
        "style": "li2",
        "vid": "1CH 3:19"
      },
      "items": [
        {
          "text": "Meṣullamu àti Hananiah. Ṣelomiti ni arábìnrin wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.19",
            "verseOrgIds": [
