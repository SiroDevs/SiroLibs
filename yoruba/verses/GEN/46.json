      "attrs": {
        "style": "li2",
        "vid": "GEN 46:19"
      },
      "items": [
        {
          "text": "Josẹfu àti Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.19",
            "verseOrgIds": [
              "GEN.46.19"
            ]
          }
