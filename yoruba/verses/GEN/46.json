          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní Ejibiti, Asenati ọmọbìnrin Potifẹra, alábojútó àti àlùfáà Oni, bí Manase àti Efraimu fún Josẹfu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
