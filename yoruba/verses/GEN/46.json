      },
      "items": [
        {
          "text": "Bela, Bekeri, Aṣbeli, Gera, Naamani, Ehi, Roṣi, Mupimu, Huppimu àti Ardi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.21",
            "verseOrgIds": [
              "GEN.46.21"
            ]
          }
        }
