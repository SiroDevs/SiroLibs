  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "GEN 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Májẹ̀mú Ilà abẹ́ kíkọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà tí Abramu di ẹni ọ̀kàndínlọ́gọ́rùn-ún ọdún,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.17.1",
                "verseOrgIds": [
                  "GEN.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "farahàn án, ó sì wí pé, \"Èmi ni Ọlọ́run alágbára,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "text": "máa rìn níwájú mi, kí o sì jẹ́ aláìlábùkù.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì fi ìdí májẹ̀mú mi múlẹ̀ pẹ̀lú rẹ. Èmi yóò sì sọ ọ́ di púpọ̀ gidigidi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.2",
            "verseOrgIds": [
              "GEN.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu sì dojúbolẹ̀, Ọlọ́run sì wí fún un pé.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.3",
            "verseOrgIds": [
              "GEN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ti èmi, májẹ̀mú mi pẹ̀lú rẹ nìyí. Ìwọ yóò di baba orílẹ̀-èdè púpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.4",
            "verseOrgIds": [
              "GEN.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kì yóò pe orúkọ rẹ̀ ní Abramu mọ́, bí kò ṣe Abrahamu, nítorí, mo ti sọ ọ́ di baba orílẹ̀-èdè púpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò mú ọ bí si lọ́pọ̀lọ́pọ̀, ọ̀pọ̀ orílẹ̀-èdè ni èmi yóò sì mú ti ara rẹ jáde wá, àwọn ọba pẹ̀lú yóò sì ti inú rẹ jáde.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.6",
            "verseOrgIds": [
              "GEN.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì gbé májẹ̀mú mi kalẹ̀ láàrín tèmi tìrẹ, ní májẹ̀mú ayérayé àti láàrín irú-ọmọ rẹ ní ìran-ìran wọn, láti máa ṣe Ọlọ́run rẹ àti ti irú-ọmọ rẹ lẹ́yìn rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.7",
            "verseOrgIds": [
              "GEN.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ilẹ̀ Kenaani níbi tí ìwọ ti ṣe àjèjì ni èmi yóò fi fún ọ àti fún irú-ọmọ rẹ lẹ́yìn rẹ láéláé. Èmi yóò sì jẹ́ Ọlọ́run wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.8",
            "verseOrgIds": [
              "GEN.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Ọlọ́run wí fún Abrahamu pé, \"Ìwọ máa pa májẹ̀mú mi mọ́, ìwọ àti irú-ọmọ rẹ lẹ́yìn rẹ àti àwọn ìran tí ó ń bọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.9",
            "verseOrgIds": [
              "GEN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni májẹ̀mú mi pẹ̀lú rẹ àti ìran rẹ lẹ́yìn rẹ, májẹ̀mú tí ẹ̀yin yóò máa pamọ́. Gbogbo ọkùnrin yín ni a gbọdọ̀ kọ ní ilà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.10",
            "verseOrgIds": [
              "GEN.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin yóò kọ ara yín ní ilà, èyí ni yóò jẹ́ àmì májẹ̀mú láàrín tèmi tiyín.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.11",
            "verseOrgIds": [
              "GEN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní gbogbo ìran tí ń bọ̀ lẹ́yìn, gbogbo ọkùnrin ni a gbọdọ̀ kọ ni ilà ní ọjọ́ kẹjọ tí a bí wọn, àti àwọn tí a bí ní ilé rẹ, tàbí tí a fi owó rà lọ́wọ́ àwọn àjèjì, àwọn tí kì í ṣe ọmọ rẹ̀. Èyí yóò sì jẹ́ májẹ̀mú láéláé tí yóò wà láàrín Èmi àti irú-ọmọ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.12",
            "verseOrgIds": [
              "GEN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbá à ṣe ẹni tí a bí nínú ilé rẹ, tàbí ẹni tí o fi owó rà, a gbọdọ̀ kọ wọ́n ní ilà; májẹ̀mú mí lára yín yóò jẹ́ májẹ̀mú ayérayé.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.13",
            "verseOrgIds": [
              "GEN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ọmọkùnrin tí kò bá kọ ilà, tí a kò kọ ní ilà abẹ́, ni a ó gé kúrò láàrín àwọn ènìyàn rẹ̀, nítorí pé ó da májẹ̀mú mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
              "GEN.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run wí fún Abrahamu pé, \"Ní ti Sarai, aya rẹ̀, ìwọ kì yóò pè é ní Sarai mọ́, bí kò ṣe Sara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.15",
            "verseOrgIds": [
              "GEN.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò bùkún fún un, èmi yóò sì fun ọ ní ọmọkùnrin kan nípasẹ̀ rẹ̀. Èmi yóò bùkún un, yóò sì di ìyá àwọn orílẹ̀-èdè, àwọn ọba àwọn orílẹ̀-èdè yóò sì ti ara rẹ̀ jáde wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.16",
            "verseOrgIds": [
              "GEN.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu sì dojúbolẹ̀, ó rẹ́rìn-ín, ó sì wí fún ara rẹ̀ pé, \"A ó ha bí ọmọ fún ẹni ọgọ́rùn-ún ọdún? Sara tí í ṣe ẹni àádọ́rùn-ún ọdún yóò ha bímọ bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.17",
            "verseOrgIds": [
              "GEN.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu sì wí fún Ọlọ́run pé, \"Sá à jẹ́ kí Iṣmaeli kí ó wà láààyè lábẹ́ ìbùkún rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.18",
            "verseOrgIds": [
              "GEN.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Ọlọ́run wí pé, \"Mo gbọ́, ṣùgbọ́n Sara aya rẹ̀ yóò bí ọmọkùnrin kan fún ọ, ìwọ yóò sì pe orúkọ rẹ̀ ní Isaaki, èmi yóò fi ìdí májẹ̀mú mi múlẹ̀ pẹ̀lú rẹ̀ ní májẹ̀mú ayérayé àti àwọn irú-ọmọ rẹ̀ lẹ́yìn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.19",
            "verseOrgIds": [
              "GEN.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ní ti Iṣmaeli, mo gbọ́ ohun tí ìwọ wí, èmi yóò bùkún fún un nítòótọ́, èmi ó sì mú un bí sí i, yóò sì pọ̀ sí i, òun yóò sì jẹ́ baba fún àwọn ọmọ ọba méjìlá, bẹ́ẹ̀ ni èmi yóò sì sọ ọ́ di orílẹ̀-èdè ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.20",
            "verseOrgIds": [
              "GEN.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èmi yóò fi ìdí májẹ̀mú mi múlẹ̀ pẹ̀lú Isaaki, ẹni tí Sara yóò bí fún ọ ni ìwòyí àmọ́dún.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.21",
            "verseOrgIds": [
              "GEN.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó ti bá Abrahamu sọ̀rọ̀ tán, Ọlọ́run sì gòkè lọ kúrò lọ́dọ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.22",
            "verseOrgIds": [
              "GEN.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà gan an ni Abrahamu mú Iṣmaeli ọmọ rẹ̀ àti àwọn ẹrú tí a bí ní ilé rẹ̀ àti àwọn tí ó fi owó rà, ó sì kọ wọ́n ní ilà. Bẹ́ẹ̀ ni ó sì kọ gbogbo ọkùnrin tí ń bẹ ní ilé rẹ̀ ní ilà gẹ́gẹ́ bí àṣẹ Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.23",
            "verseOrgIds": [
              "GEN.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu jẹ́ ẹni ọ̀kàndínlọ́gọ́rùn-ún ọdún nígbà tí a kọ ọ́ ní ilà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.24",
            "verseOrgIds": [
              "GEN.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iṣmaeli ọmọ rẹ̀ jẹ́ ẹni ọdún mẹ́tàlá.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.25",
            "verseOrgIds": [
              "GEN.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
