  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "GEN 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakọbu dé Padani-Aramu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì tẹ̀síwájú nínú ìrìnàjò rẹ̀, ó sì dé ilẹ̀ àwọn ará ìlà-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.1",
            "verseOrgIds": [
              "GEN.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì rí kànga kan ní pápá, agbo àgùntàn mẹ́ta sì dúró láti mu omi ní ibi kànga náà, nítorí pé láti inú kànga náà ni wọ́n ti ń fi omi fún agbo àgùntàn. Òkúta tí a gbé dí ẹnu kànga náà sì tóbi gidigidi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.2",
            "verseOrgIds": [
              "GEN.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí gbogbo agbo ẹran bá péjọpọ̀ sí ibẹ̀ tán ni àwọn darandaran yóò tó yí òkúta náà kúrò, tí wọn yóò sì fún àwọn ẹran náà ní omi, tí wọ́n bá sì ti ṣe bẹ́ẹ̀ tán, wọn yóò tún yí òkúta náà padà sí ẹnu kànga náà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.3",
            "verseOrgIds": [
              "GEN.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu béèrè lọ́wọ́ àwọn darandaran náà pé, \"Ẹ̀yin arákùnrin mi níbo ni ẹ̀yin ti wá?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.4",
            "verseOrgIds": [
              "GEN.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 29:4"
      },
      "items": [
        {
          "text": "Àwọn náà sì dáhùn pé, \"Láti Harani ni.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.4",
            "verseOrgIds": [
              "GEN.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì bi wọ́n pé, \"Ǹjẹ́ ẹ mọ Labani ọmọ ọmọ Nahori?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.5",
            "verseOrgIds": [
              "GEN.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 29:5"
      },
      "items": [
        {
          "text": "Wọ́n sì dáhùn pé, \"Bẹ́ẹ̀ ni, àwa mọ̀ ọ́n.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.5",
            "verseOrgIds": [
              "GEN.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu béèrè pé, \"Ṣe àlàáfíà ni ó wà?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.6",
            "verseOrgIds": [
              "GEN.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 29:6"
      },
      "items": [
        {
          "text": "Wọ́n sì dáhùn pé, \"Bẹ́ẹ̀ ni, àlàáfíà ni. Wò ó, Rakeli ọmọ rẹ̀ ni ó ń bọ̀ yìí pẹ̀lú agbo àgùntàn.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.6",
            "verseOrgIds": [
              "GEN.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí pé, \"Kíyèsi, ilẹ̀ ò tí ì ṣú, kò tì í tó àkókò fún àwọn ohun ọ̀sìn láti wọ̀. Ẹ fún àwọn ẹran wọ̀nyí ní omi, kí ẹ ba à le tètè dà wọ́n padà láti jẹun.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.7",
            "verseOrgIds": [
              "GEN.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n dá a lóhùn pé, \"Àwa kì í yí òkúta kúrò ní ẹnu kànga láti pọn omi fún àwọn ẹran títí gbogbo àwọn darandaran àti àwọn ẹran yóò fi péjọ tán.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.8",
            "verseOrgIds": [
              "GEN.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí wọ́n sì ti ń sọ̀rọ̀ lọ́wọ́ ni Rakeli dé pẹ̀lú agbo àgùntàn baba rẹ̀, nítorí darandaran ni òun náà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.9",
            "verseOrgIds": [
              "GEN.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jakọbu rí Rakeli ọmọbìnrin Labani tí í ṣe ẹ̀gbọ́n ìyá rẹ̀, pẹ̀lú àgùntàn Labani, Jakọbu súnmọ́ kànga náà, ó sì yí òkúta kúrò lẹ́nu rẹ̀, ó sì fún àwọn ẹran arákùnrin ìyá rẹ̀ Labani ní omi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.10",
            "verseOrgIds": [
              "GEN.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì fẹnu ko Rakeli ní ẹnu. Ó sì bẹ̀rẹ̀ sí í sọkún.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.11",
            "verseOrgIds": [
              "GEN.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì wí fún Rakeli pé ìbátan baba rẹ̀ ni òun, àti pé, òun jẹ́ ọmọ Rebeka. Rakeli sì sáré lọ sọ fún baba rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.12",
            "verseOrgIds": [
              "GEN.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní kété tí Labani gbúròó Jakọbu ọmọ arábìnrin rẹ̀, ó jáde lọ pàdé Jakọbu, ó dì mọ́ ọn, ó fi ẹnu kò ó ní ẹnu, ó sì mú un lọ sí ilé. Nígbà náà ni Jakọbu ròyìn ohun gbogbo fún un.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.13",
            "verseOrgIds": [
              "GEN.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani sì wí pé, \"Ẹran-ara àti ẹ̀jẹ̀ ara mi ni ìwọ jẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.14",
            "verseOrgIds": [
              "GEN.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "GEN 29:14"
      },
      "items": [
        {
          "text": "Jakọbu fẹ́ àwọn ọmọ Labani Lea àti Rakeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 29:14"
      },
      "items": [
        {
          "text": "Lẹ́yìn tí Jakọbu sì wà pẹ̀lú rẹ̀ fún odidi oṣù kan,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.14",
            "verseOrgIds": [
              "GEN.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani wí fún Jakọbu pé, \"Bí a tilẹ̀ jẹ́ ìbátan, kò yẹ kí o máa ṣiṣẹ́ fún mi lásán láìgba ohun kankan. Sọ ohun tì ìwọ fẹ́ gbà fún iṣẹ́ tí ìwọ ń ṣe fún mi!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.15",
            "verseOrgIds": [
              "GEN.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wàyí o, Labani ní ọmọbìnrin méjì, orúkọ èyí ẹ̀gbọ́n ń jẹ́ Lea, orúkọ àbúrò sì ń jẹ́ Rakeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.16",
            "verseOrgIds": [
              "GEN.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea kò ní ẹwà púpọ̀, ṣùgbọ́n Rakeli ní ẹwà gidigidi. Ojú rẹ̀ sì fanimọ́ra.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.17",
            "verseOrgIds": [
              "GEN.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì fẹ́ràn Rakeli, ó sì wí fún baba rẹ̀ pé, \"Èmi yóò ṣiṣẹ́ sìn ọ fún ọdún méje, bí ìwọ yóò bá fún mi ní Rakeli ọmọ rẹ ní aya.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.18",
            "verseOrgIds": [
              "GEN.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani sì dáhùn wí pé, \"Ó kúkú sàn kí ń fi fún ọ, ju kí ń fi fún ẹlòmíràn lọ, nítorí náà wà ní ọ̀dọ̀ mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.19",
            "verseOrgIds": [
              "GEN.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì ṣiṣẹ́ sin Labani fún ọdún méje láti fẹ́ Rakeli. Àwọn ọdún wọ̀nyí sì dàbí ọjọ́ díẹ̀ lára rẹ̀, nítorí ó fẹ́ràn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.20",
            "verseOrgIds": [
              "GEN.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì wí fún Labani pé, \"Mo ti parí àsìkò tí a jọ ṣe àdéhùn rẹ̀, nítorí náà fún mi ní aya mi, kí òun lè ṣe aya fún mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.21",
            "verseOrgIds": [
              "GEN.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani sì pe gbogbo ènìyàn ibẹ̀ jọ, ó sì ṣe àsè ìyàwó fún wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.22",
            "verseOrgIds": [
              "GEN.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà tí ó di òru, Labani mú Lea tọ Jakọbu lọ. Jakọbu sì bá a lòpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.23",
            "verseOrgIds": [
              "GEN.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani sì fi Silipa ọmọ ọ̀dọ̀ rẹ̀ obìnrin fún Lea gẹ́gẹ́ bí ìránṣẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.24",
            "verseOrgIds": [
              "GEN.29.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sì kíyèsi, nígbà ti ilẹ̀ mọ́, Jakọbu rí i pé Lea ni! Ó sì wí fún Labani pé, \"Èwo ni ìwọ ṣe sí mi yìí? Ṣe bí nítorí Rakeli ni mo ṣe ṣiṣẹ́ sìn ọ, èéṣe tí ìwọ tàn mi?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.25",
            "verseOrgIds": [
              "GEN.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani sì dáhùn pé, \"Kò bá àṣà wa mu láti fi àbúrò fún ọkọ ṣáájú ẹ̀gbọ́n rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.26",
            "verseOrgIds": [
              "GEN.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mú sùúrù parí ọ̀sẹ̀ ìgbéyàwó yìí náà, nígbà náà ni èmi yóò fi àbúrò rẹ̀ fún ọ pẹ̀lú, bí ìwọ ó bá ṣiṣẹ́ sìn mi fún ọdún méje mìíràn.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.27",
            "verseOrgIds": [
              "GEN.29.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì gbà láti sin Labani fún ọdún méje mìíràn. Labani sì fi Rakeli ọmọ rẹ̀ fún un bí aya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.28",
            "verseOrgIds": [
              "GEN.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani sì fi Biliha ọmọ ọ̀dọ̀ rẹ̀ obìnrin fún Rakeli bí ìránṣẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.29",
            "verseOrgIds": [
              "GEN.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì bá Rakeli náà lòpọ̀. Ó sì fẹ́ràn Rakeli ju Lea lọ, ó sì ṣiṣẹ́ sin Labani fún ọdún méje mìíràn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.30",
            "verseOrgIds": [
              "GEN.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ọmọ Jakọbu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
              "GEN.29.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.29.31",
                "verseOrgIds": [
                  "GEN.29.31"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ri pé, Jakọbu kò fẹ́ràn Lea, ó ṣí i ni inú ṣùgbọ́n Rakeli yàgàn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
              "GEN.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea sì lóyún, ó sì bí ọmọkùnrin kan, ó sì pe orúkọ rẹ̀ ní Reubeni, nítorí ó wí pé, \"Nítorí",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
              "GEN.29.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.29.32",
                "verseOrgIds": [
                  "GEN.29.32"
                ]
              }
            }
          ]
        },
        {
          "text": "ti mọ ìpọ́njú mi, dájúdájú, ọkọ mi yóò fẹ́ràn mi báyìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
              "GEN.29.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tún lóyún, ó bí ọmọkùnrin kan. Ó sì pe orúkọ rẹ̀ ní Simeoni, wí pé, \"Nítorí tí",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.29.33",
                "verseOrgIds": [
                  "GEN.29.33"
                ]
              }
            }
          ]
        },
        {
          "text": "ti gbọ́ pé a kò fẹ́ràn mi, ó sì fi èyí fún mi pẹ̀lú.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tún lóyún, ó bí ọmọkùnrin kan, ó sì wí pé, \"Nígbà yìí ni ọkọ mi yóò fi ara mọ́ mi, nítorí tí mo ti bí ọmọkùnrin mẹ́ta fún un,\" nítorí náà ni ó ṣe pe orúkọ rẹ̀ ní Lefi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tún lóyún, ó sì tún jẹ́ pé ọmọkùnrin ni ó bí, ó sì wí pé, \"Nígbà yìí ni èmi yóò yin",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.35",
            "verseOrgIds": [
              "GEN.29.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.29.35",
                "verseOrgIds": [
                  "GEN.29.35"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" Ó sì pe orúkọ rẹ̀ ní Juda. Ó sì dáwọ́ ọmọ bíbí dúró.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.35",
            "verseOrgIds": [
              "GEN.29.35"
            ]
          }
        }
      ]
    }
  ],
