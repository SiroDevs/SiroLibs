      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 10:26"
      },
      "items": [
        {
          "text": "Almodadi, Ṣelefi, Hasarmafeti, Jera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.26",
            "verseOrgIds": [
              "GEN.10.26"
