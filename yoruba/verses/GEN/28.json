  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "GEN 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà Isaaki pe Jakọbu, ó sì súre fún un, ó sì pàṣẹ fún un pé, \"Ìwọ kò gbọdọ̀ fẹ́ aya láàrín àwọn ọmọbìnrin Kenaani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.1",
            "verseOrgIds": [
              "GEN.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dípò bẹ́ẹ̀ lọ sí Padani-Aramu, sí ilé Betueli, baba ìyá rẹ, kí ìwọ kí ó sì fẹ́ aya fún ara rẹ nínú àwọn ọmọbìnrin Labani arákùnrin ìyá rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.2",
            "verseOrgIds": [
              "GEN.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí Ọlọ́run Olódùmarè El-Ṣaddai kí ó bùkún fún ọ, kí ó sì mú ọ bí sí i, kí ó sì mú ọ pọ̀ sí i ní iye títí tí ìwọ yóò di àgbájọ àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.3",
            "verseOrgIds": [
              "GEN.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí Ọlọ́run kí ó fún ìwọ àti irú-ọmọ rẹ ní ìre tí ó sú fún Abrahamu, kí ìwọ kí ó le gba ilẹ̀ níbi tí a ti ń ṣe àtìpó yìí, ilẹ̀ tí Ọlọ́run ti fi fún Abrahamu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.4",
            "verseOrgIds": [
              "GEN.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Isaaki sì rán Jakọbu lọ. Ó sì lọ sí Padani-Aramu, lọ́dọ̀ Labani ọmọ Betueli, ará Aramu, tí í ṣe arákùnrin Rebeka ìyá Jakọbu àti Esau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.5",
            "verseOrgIds": [
              "GEN.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Esau gbọ́ pé, Isaaki ti súre fún Jakọbu, ó sì ti rán Jakọbu lọ sí Padani-Aramu láti fẹ́ aya níbẹ̀ àti pé nígbà tí ó súre fún un, ó kìlọ̀ fun un pé, kò gbọdọ̀ fẹ́ nínú àwọn ọmọbìnrin Kenaani",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.6",
            "verseOrgIds": [
              "GEN.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti pé, Jakọbu ti gbọ́rọ̀ sí ìyá àti baba rẹ̀ lẹ́nu, ó sì ti lọ sí Padani-Aramu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.7",
            "verseOrgIds": [
              "GEN.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Esau mọ bí Isaaki baba rẹ ti kórìíra àwọn ọmọbìnrin Kenaani tó.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.8",
            "verseOrgIds": [
              "GEN.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà Esau tọ Iṣmaeli lọ, ó sì fẹ́ Mahalati, arábìnrin Nebaioti, ọmọbìnrin Iṣmaeli tí í ṣe ọmọ Abrahamu. Ó fẹ́ ẹ, kún àwọn ìyàwó tí ó ti ní tẹ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.9",
            "verseOrgIds": [
              "GEN.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àlá Jakọbu ní Beteli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu kúrò ní Beerṣeba, ó sì kọrí sí ìlú Harani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.10",
            "verseOrgIds": [
              "GEN.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó dé ibìkan, ó dúró ní òru náà nítorí tí ilẹ̀ ti ń ṣú, ó sì gbé òkúta kan ó fi ṣe ìrọ̀rí, ó sì sùn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.11",
            "verseOrgIds": [
              "GEN.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì lá àlá pé, a gbé àkàsọ̀ kan dúró ti ó fi ìdí lélẹ̀, orí rẹ̀ sì kan ọ̀run, àwọn angẹli Ọlọ́run sì ń gòkè, wọ́n sì ń sọ̀kalẹ̀ lórí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.12",
            "verseOrgIds": [
              "GEN.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.28.13",
                "verseOrgIds": [
                  "GEN.28.13"
                ]
              }
            }
          ]
        },
        {
          "text": "sì dúró lókè rẹ̀, ó sì wí pé, \"Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.13",
            "verseOrgIds": [
              "GEN.28.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.28.13",
                "verseOrgIds": [
                  "GEN.28.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run baba rẹ Abrahamu àti Ọlọ́run Isaaki, ìwọ àti ìran rẹ ni èmi yóò fi ilẹ̀ tí ìwọ dùbúlẹ̀ sórí rẹ̀ yìí fún.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.13",
            "verseOrgIds": [
              "GEN.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìran rẹ yóò pọ̀ bí erùpẹ̀ ilẹ̀, ìwọ yóò sì tànkálẹ̀ dé ìlà-oòrùn àti ìwọ̀-oòrùn, àti dé gúúsù àti àríwá. A ó sì bùkún gbogbo orílẹ̀-èdè ayé nípasẹ̀ ìwọ àti àwọn ọmọ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.14",
            "verseOrgIds": [
              "GEN.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi wà pẹ̀lú rẹ, èmi yóò sì pa ọ mọ́ ní ibikíbi tí ìwọ bá lọ, èmi yóò sì mú ọ padà wá sí ilẹ̀ yìí ní àlàáfíà. Èmi kì yóò fi ọ sílẹ̀ ní ìgbà kan, títí tí èmi yóò fi mú gbogbo ìlérí mi ṣẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.15",
            "verseOrgIds": [
              "GEN.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jakọbu jí lójú oorun rẹ̀, ó rò nínú ara rẹ̀ pé, \"Dájúdájú",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.16",
            "verseOrgIds": [
              "GEN.28.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.28.16",
                "verseOrgIds": [
                  "GEN.28.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ń bẹ ní ìhín yìí, èmi kò sì mọ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.16",
            "verseOrgIds": [
              "GEN.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀rù sì bà á, ó sì wí pé, \"Ìhín yìí ní ẹ̀rù gidigidi; ibí kì í ṣe ibòmíràn bí kò ṣe ilé Ọlọ́run, àní ẹnu ibodè ọ̀run nìyìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.17",
            "verseOrgIds": [
              "GEN.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì dìde ní kùtùkùtù òwúrọ̀, ó sì gbé òkúta tí ó fi ṣe ìrọ̀rí lélẹ̀ bí ọ̀wọ́n, ó sì da òróró si lórí.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.18",
            "verseOrgIds": [
              "GEN.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì pe orúkọ ibẹ̀ ní Beteli,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.19",
            "verseOrgIds": [
              "GEN.28.19"
            ]
          }
        },
        {
          "text": "bí ó tilẹ̀ jẹ́ pé ìlú náà ń jẹ́ Lusi tẹ́lẹ̀ rí.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.19",
            "verseOrgIds": [
              "GEN.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì jẹ́ ẹ̀jẹ́ níbẹ̀ pé, \"Bí Ọlọ́run yóò bá wà pẹ̀lú mi, tí yóò sì pa mí mọ́ ní ìrìnàjò mi tí mo ń lọ, tí yóò sì fún mi ní oúnjẹ láti jẹ àti aṣọ láti wọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.20",
            "verseOrgIds": [
              "GEN.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí mo sì padà sílé baba mi ní àlàáfíà, nígbà náà",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.21",
            "verseOrgIds": [
              "GEN.28.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.28.21",
                "verseOrgIds": [
                  "GEN.28.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ni yóò jẹ́ Ọlọ́run mi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.21",
            "verseOrgIds": [
              "GEN.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òkúta yìí tí mo gbé kalẹ̀ bí ọ̀wọ́n yóò jẹ́ ilé Ọlọ́run, nínú gbogbo ohun tí ìwọ ó fi fún mi, èmi yóò sì fi ìdámẹ́wàá rẹ̀ fún ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.22",
            "verseOrgIds": [
              "GEN.28.22"
            ]
          }
        }
      ]
    }
  ],
