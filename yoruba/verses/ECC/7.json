        },
        {
          "text": "Oniwaasu wí pé, \"Wò ó, eléyìí ni ohun tí mo ti ṣàwárí:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.27",
            "verseOrgIds": [
              "ECC.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:27"
      },
      "items": [
        {
          "text": "\"Mímú ohun kan pọ̀ mọ́ òmíràn láti ṣàwárí ìdí ohun gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.27",
            "verseOrgIds": [
              "ECC.7.27"
            ]
