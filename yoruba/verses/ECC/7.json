    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:28"
      },
      "items": [
        {
          "text": "ṣùgbọ́n n kò rí obìnrin,",
          "type": "text",
