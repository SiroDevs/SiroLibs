        "style": "q1",
        "vid": "ECC 7:28"
      },
      "items": [
        {
          "text": "ṣùgbọ́n tí n kò rí i",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.28",
            "verseOrgIds": [
              "ECC.7.28"
            ]
          }
        }
      ]
    },
