      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:28"
      },
      "items": [
        {
          "text": "mo rí ọkùnrin tí ó dúró dáradára kan láàrín ẹgbẹ̀rún (1,000),",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.28",
            "verseOrgIds": [
              "ECC.7.28"
            ]
          }
        }
