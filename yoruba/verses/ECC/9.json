              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọgbọ́n dára ju ohun èlò ogun lọ,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.18",
            "verseOrgIds": [
