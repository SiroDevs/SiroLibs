      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 9:17"
      },
      "items": [
        {
          "text": "ju igbe òmùgọ̀ alákòóso lọ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.17",
            "verseOrgIds": [
              "ECC.9.17"
