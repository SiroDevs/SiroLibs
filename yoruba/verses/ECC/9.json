            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀ pẹ̀lẹ́ ọlọ́gbọ́n ènìyàn a máa wà ní ìmúṣẹ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.17",
            "verseOrgIds": [
              "ECC.9.17"
            ]
          }
        }
      ]
    },
    {
