  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "65",
        "style": "c",
        "sid": "PSA 65"
      },
      "items": [
        {
          "text": "65",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 65",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Saamu ti Dafidi. Orin.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 65:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyìn ń dúró dè ọ́, Ọlọ́run, ní Sioni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.1",
            "verseOrgIds": [
              "PSA.65.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:1"
      },
      "items": [
        {
          "text": "sí ọ ni a ó mú ẹ̀jẹ́ wa ṣẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.1",
            "verseOrgIds": [
              "PSA.65.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 65:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ tí ó ń gbọ́ àdúrà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.2",
            "verseOrgIds": [
              "PSA.65.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:2"
      },
      "items": [
        {
          "text": "gbogbo ènìyàn yóò sì wá sọ́dọ̀ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.2",
            "verseOrgIds": [
              "PSA.65.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 65:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀ràn àìṣedéédéé borí mi bí ó ṣe ti ìrékọjá wa ni!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.3",
            "verseOrgIds": [
              "PSA.65.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:3"
      },
      "items": [
        {
          "text": "Ìwọ ni yóò wẹ̀ wọ́n nù kúrò.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.3",
            "verseOrgIds": [
              "PSA.65.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 65:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbùkún ni fún àwọn tí o yàn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:4"
      },
      "items": [
        {
          "text": "tí o mú wa láti máa gbé àgọ́ rẹ!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:4"
      },
      "items": [
        {
          "text": "A tẹ́ wá lọ́rùn pẹ̀lú ohun rere inú ilé rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:4"
      },
      "items": [
        {
          "text": "ti tẹmpili mímọ́ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 65:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ dá wa lóhùn pẹ̀lú ohun ìyanu ti òdodo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "Ọlọ́run olùgbàlà wa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "ẹni tí ṣe ìgbẹ́kẹ̀lé gbogbo òpin ayé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "àti àwọn tí ó jìnnà nínú òkun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 65:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìwọ tí ó dá òkè nípa agbára rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.6",
            "verseOrgIds": [
              "PSA.65.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:6"
      },
      "items": [
        {
          "text": "tí odi ara rẹ ní àmùrè agbára,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.6",
            "verseOrgIds": [
              "PSA.65.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 65:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹni tí ó mú rírú omi òkun dákẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.7",
            "verseOrgIds": [
              "PSA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:7"
      },
      "items": [
        {
          "text": "ríru ariwo omi wọn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.7",
            "verseOrgIds": [
              "PSA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:7"
      },
      "items": [
        {
          "text": "àti ìdágìrì àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.7",
            "verseOrgIds": [
              "PSA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 65:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó ń gbé òkèrè bẹ̀rù,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:8"
      },
      "items": [
        {
          "text": "nítorí àmì rẹ wọ̀n-ọn-nì;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:8"
      },
      "items": [
        {
          "text": "ìwọ mú ìjáde òwúrọ̀ àti ti àṣálẹ́ yọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:8"
      },
      "items": [
        {
          "text": "ìwọ pè fún orin ayọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 65:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ bẹ ayé wò, o sì bomirin;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "ìwọ mú un ọ̀rọ̀ púpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "Odò Ọlọ́run kún fún omi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "láti pèsè ọkà fún àwọn ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "nítorí ibẹ̀ ni ìwọ ti yàn án.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 65:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ fi bomirin sí aporo rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:10"
      },
      "items": [
        {
          "text": "ìwọ tẹ́ ògúlùtu rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:10"
      },
      "items": [
        {
          "text": "ìwọ fi òjò mú ilẹ̀ rẹ̀ rọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:10"
      },
      "items": [
        {
          "text": "o sì bùkún ọ̀gbìn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 65:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ fi oore rẹ dé ọdún ní adé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.11",
            "verseOrgIds": [
              "PSA.65.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:11"
      },
      "items": [
        {
          "text": "ọ̀rá ń kán ní ipa ọ̀nà rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.11",
            "verseOrgIds": [
              "PSA.65.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 65:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pápá tútù ní aginjù ń kan",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.12",
            "verseOrgIds": [
              "PSA.65.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:12"
      },
      "items": [
        {
          "text": "àwọn òkè kéékèèké fi ayọ̀ di ara wọn ní àmùrè.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.12",
            "verseOrgIds": [
              "PSA.65.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 65:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agbo ẹran ni a fi wọ pápá tútù náà ní aṣọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.13",
            "verseOrgIds": [
              "PSA.65.14"
            ]
          }
        }
      ]
    },
