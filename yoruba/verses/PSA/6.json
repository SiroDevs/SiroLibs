        {
          "text": "Saamu 6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Fún ohun èlò orin olókùn. Gẹ́gẹ́ bí ti ṣeminiti. Saamu ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.6.1",
                "verseOrgIds": [
                  "PSA.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", má ṣe bá mi wí nínú ìbínú rẹ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.1",
            "verseOrgIds": [
              "PSA.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:1"
      },
      "items": [
        {
          "text": "kí ìwọ má ṣe nà mí nínú gbígbóná ìrunú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.1",
            "verseOrgIds": [
              "PSA.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣàánú fún mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.2",
            "verseOrgIds": [
              "PSA.6.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.6.2",
                "verseOrgIds": [
                  "PSA.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", nítorí èmi ń kú lọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.2",
            "verseOrgIds": [
              "PSA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.6.2",
                "verseOrgIds": [
                  "PSA.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", wò mí sán, nítorí egungun mi wà nínú ìnira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.2",
            "verseOrgIds": [
              "PSA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkàn mi wà nínú ìrora.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.3",
            "verseOrgIds": [
              "PSA.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:3"
      },
      "items": [
        {
          "text": "Yóò ti pẹ́ tó,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.3",
            "verseOrgIds": [
              "PSA.6.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.6.3",
                "verseOrgIds": [
                  "PSA.6.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", yóò ti pẹ́ tó?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.3",
            "verseOrgIds": [
              "PSA.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yípadà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.4",
            "verseOrgIds": [
              "PSA.6.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.6.4",
                "verseOrgIds": [
                  "PSA.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí o sì gbà mí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.4",
            "verseOrgIds": [
              "PSA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:4"
      },
      "items": [
        {
          "text": "gbà mí là nípa ìfẹ́ rẹ tí kì í ṣákì í.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.4",
            "verseOrgIds": [
              "PSA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni kò ni rántí rẹ nígbà tí ó bá kú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.5",
            "verseOrgIds": [
              "PSA.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:5"
      },
      "items": [
        {
          "text": "Ta ni yóò yìn ọ́ láti inú isà òkú?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.5",
            "verseOrgIds": [
              "PSA.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agara ìkérora mi dá mi tán.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.6",
            "verseOrgIds": [
              "PSA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 6:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 6:6"
      },
      "items": [
        {
          "text": "Gbogbo òru ni mo wẹ ibùsùn mi pẹ̀lú ẹkún,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.6",
            "verseOrgIds": [
              "PSA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:6"
      },
      "items": [
        {
          "text": "mo sì fi omi rin ibùsùn mi pẹ̀lú omijé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.6",
            "verseOrgIds": [
              "PSA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojú mi di aláìlera pẹ̀lú ìbànújẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.7",
            "verseOrgIds": [
              "PSA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:7"
      },
      "items": [
        {
          "text": "wọ́n kùnà nítorí gbogbo ọ̀tá mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.7",
            "verseOrgIds": [
              "PSA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kúrò lọ́dọ̀ mi, gbogbo ẹ̀yin tí ń ṣe iṣẹ́ ibi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.8",
            "verseOrgIds": [
              "PSA.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:8"
      },
      "items": [
        {
          "text": "nítorí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.8",
            "verseOrgIds": [
              "PSA.6.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.6.8",
                "verseOrgIds": [
                  "PSA.6.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ti gbọ́ igbe mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.8",
            "verseOrgIds": [
              "PSA.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.6.9",
                "verseOrgIds": [
                  "PSA.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ti gbọ́ ẹkún mi fún àánú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.9",
            "verseOrgIds": [
              "PSA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.6.9",
                "verseOrgIds": [
                  "PSA.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ti gba àdúrà mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.9",
            "verseOrgIds": [
              "PSA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọ̀tá mi lójú yóò tì, wọn yóò sì dààmú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.10",
            "verseOrgIds": [
              "PSA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:10"
      },
      "items": [
        {
          "text": "wọn yóò sì yípadà nínú ìtìjú àìròtẹ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.10",
            "verseOrgIds": [
              "PSA.6.11"
            ]
          }
        }
      ]
    }
