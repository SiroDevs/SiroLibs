                "verseOrgIds": [
                  "PSA.126.1"
                ]
              }
            }
          ]
        },
        {
          "text": "mú ìkólọ Sioni padà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.1",
            "verseOrgIds": [
              "PSA.126.1"
            ]
          }
