      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Gẹ́gẹ́ bí ti gittiti. Saamu ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.8.1",
                "verseOrgIds": [
                  "PSA.8.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", Olúwa wa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:1"
      },
      "items": [
        {
          "text": "orúkọ rẹ̀ ti ní ìyìn tó ní gbogbo ayé!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 8:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 8:1"
      },
      "items": [
        {
          "text": "Ìwọ ti gbé ògo rẹ ga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:1"
      },
      "items": [
        {
          "text": "ju àwọn ọ̀run lọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ẹnu ọmọ ọwọ́ àti ọmọ ọmú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:2"
      },
      "items": [
        {
          "text": "ni o ti yan ìyìn nítorí àwọn ọ̀tá rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:2"
      },
      "items": [
        {
          "text": "láti pa àwọn ọ̀tá àti àwọn olùgbẹ̀san lẹ́nu mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí mo ro ọ̀run rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:3"
      },
      "items": [
        {
          "text": "iṣẹ́ ìka rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 8:3"
      },
      "items": [
        {
          "text": "òṣùpá àti ìràwọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:3"
      },
      "items": [
        {
          "text": "tí ìwọ tí gbé kalẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí ni ènìyàn tí ìwọ ń rò nípa rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.4",
            "verseOrgIds": [
              "PSA.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:4"
      },
      "items": [
        {
          "text": "àní ọmọ ènìyàn tí ìwọ ń ṣe ìtọ́jú rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.4",
            "verseOrgIds": [
              "PSA.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ṣe é ní onírẹ̀lẹ̀ díẹ̀ ju Ọlọ́run lọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.5",
            "verseOrgIds": [
              "PSA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:5"
      },
      "items": [
        {
          "text": "ìwọ sì dé e ní adé ògo àti ọlá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.5",
            "verseOrgIds": [
              "PSA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ mú un jẹ ọba lórí gbogbo iṣẹ́ ọwọ́ rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.6",
            "verseOrgIds": [
              "PSA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:6"
      },
      "items": [
        {
          "text": "ìwọ sì fi ohun gbogbo sí abẹ́ ẹsẹ̀ rẹ̀:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.6",
            "verseOrgIds": [
              "PSA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn agbo àgùntàn àti àwọn màlúù,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.7",
            "verseOrgIds": [
              "PSA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:7"
      },
      "items": [
        {
          "text": "àti ẹranko igbó,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.7",
            "verseOrgIds": [
              "PSA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹyẹ ojú ọrun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.8",
            "verseOrgIds": [
              "PSA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:8"
      },
      "items": [
        {
          "text": "àti ẹja inú Òkun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.8",
            "verseOrgIds": [
              "PSA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:8"
      },
      "items": [
        {
          "text": "àti ohun tí ń wẹ nínú ipa Òkun.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.8",
            "verseOrgIds": [
              "PSA.8.9"
            ]
          }
        }
      ]
    },
    {
