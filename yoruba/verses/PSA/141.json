          "text": "141",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 141",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Saamu ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 141:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.141.1",
                "verseOrgIds": [
                  "PSA.141.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", èmi ké pè ọ́; yára wá sí ọ̀dọ̀ mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.1",
            "verseOrgIds": [
              "PSA.141.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:1"
      },
      "items": [
        {
          "text": "Gbọ́ ohùn mi, nígbà tí mo bá ń ké pè ọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.1",
            "verseOrgIds": [
              "PSA.141.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 141:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí àdúrà mi ó wá sí iwájú rẹ bí ẹbọ tùràrí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.2",
            "verseOrgIds": [
              "PSA.141.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:2"
      },
      "items": [
        {
          "text": "àti ìgbé ọwọ́ mi si òkè rí bí ẹbọ àṣálẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.2",
            "verseOrgIds": [
              "PSA.141.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 141:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fi ẹ̀ṣọ́ ṣọ́ ẹnu mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.3",
            "verseOrgIds": [
              "PSA.141.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.141.3",
                "verseOrgIds": [
                  "PSA.141.3"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.3",
            "verseOrgIds": [
              "PSA.141.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:3"
      },
      "items": [
        {
          "text": "kí o sì máa pa ìlẹ̀kùn ètè mi mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.3",
            "verseOrgIds": [
              "PSA.141.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 141:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe jẹ́ kí ọkàn mi fà sí ohun tí ń ṣe ibi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:4"
      },
      "items": [
        {
          "text": "láti máa bá àwọn tí ń ṣiṣẹ́ ẹ̀ṣẹ̀ búburú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:4"
      },
      "items": [
        {
          "text": "má sì ṣe jẹ́ kí èmi jẹ àdídùn wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 141:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí olódodo lù mí, ìṣeun ni ó jẹ́:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "jẹ́ kí ó bá mi wí, ó jẹ́ òróró ní orí mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "Tí kì yóò fọ́ mi ní orí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 141:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "Síbẹ̀ àdúrà mi wá láìsí ìṣe àwọn olùṣe búburú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 141:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ó ju àwọn alákòóso sílẹ̀ láti bẹ̀bẹ̀ òkúta,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.6",
            "verseOrgIds": [
              "PSA.141.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:6"
      },
      "items": [
        {
          "text": "àwọn ẹni búburú yóò kọ pé àwọn ọ̀rọ̀ mi dùn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.6",
            "verseOrgIds": [
              "PSA.141.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 141:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò wí pé, \"Bí ẹni tí ó la aporo sórí ilẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.7",
            "verseOrgIds": [
              "PSA.141.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:7"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni egungun wa tànkálẹ̀ ní ẹnu isà òkú.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.7",
            "verseOrgIds": [
              "PSA.141.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 141:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ojú mi ń bẹ lára rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.8",
            "verseOrgIds": [
              "PSA.141.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.141.8",
                "verseOrgIds": [
                  "PSA.141.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.8",
            "verseOrgIds": [
              "PSA.141.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:8"
      },
      "items": [
        {
          "text": "nínú rẹ̀ ni èmi ti rí ààbò, má ṣe fà mi fún ikú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.8",
            "verseOrgIds": [
              "PSA.141.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 141:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mí mọ́ kúrò nínú okùn tí wọn ti dẹ sílẹ̀ fún mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.9",
            "verseOrgIds": [
              "PSA.141.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:9"
      },
      "items": [
        {
          "text": "kúrò nínú ìkẹ́kùn àwọn oníṣẹ́ ẹ̀ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.9",
            "verseOrgIds": [
              "PSA.141.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 141:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí àwọn ẹni búburú ṣubú sínú àwọ̀n ara wọn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.10",
            "verseOrgIds": [
              "PSA.141.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:10"
      },
      "items": [
        {
          "text": "nígbà tí èmi bá kọjá lọ láìléwu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.10",
            "verseOrgIds": [
              "PSA.141.10"
            ]
          }
        }
      ]
    }
  ],
