    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Àdúrà ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 86:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.1",
            "verseOrgIds": [
              "PSA.86.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.1",
                "verseOrgIds": [
                  "PSA.86.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí o sì dá mi lóhùn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.1",
            "verseOrgIds": [
              "PSA.86.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:1"
      },
      "items": [
        {
          "text": "nítorí mo jẹ́ tálákà àti aláìní.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.1",
            "verseOrgIds": [
              "PSA.86.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 86:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dáàbò bò ayé mi, nítorí a ti yà mí sọ́tọ̀ fún ọ:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:2"
      },
      "items": [
        {
          "text": "ìwọ ni Ọlọ́run mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 86:2"
      },
      "items": [
        {
          "text": "gbà ìránṣẹ́ rẹ là",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:2"
      },
      "items": [
        {
          "text": "tí ó gbẹ́kẹ̀lé ọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 86:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣàánú fún mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.3",
            "verseOrgIds": [
              "PSA.86.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.3",
                "verseOrgIds": [
                  "PSA.86.3"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.3",
            "verseOrgIds": [
              "PSA.86.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:3"
      },
      "items": [
        {
          "text": "nítorí èmi ń pè ọ́ ní gbogbo ọjọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.3",
            "verseOrgIds": [
              "PSA.86.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 86:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mú ayọ̀ wà fún ìránṣẹ́ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.4",
            "verseOrgIds": [
              "PSA.86.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:4"
      },
      "items": [
        {
          "text": "nítorí ìwọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.4",
            "verseOrgIds": [
              "PSA.86.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.4",
                "verseOrgIds": [
                  "PSA.86.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.4",
            "verseOrgIds": [
              "PSA.86.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:4"
      },
      "items": [
        {
          "text": "ni mo gbé ọkàn mí sókè sí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.4",
            "verseOrgIds": [
              "PSA.86.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 86:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ń dáríjì, ìwọ sì dára,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.5",
            "verseOrgIds": [
              "PSA.86.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.5",
                "verseOrgIds": [
                  "PSA.86.5"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.5",
            "verseOrgIds": [
              "PSA.86.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:5"
      },
      "items": [
        {
          "text": "ìwọ sì ṣàánú fún gbogbo àwọn tí ń ké pè ọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.5",
            "verseOrgIds": [
              "PSA.86.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 86:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbọ́ àdúrà mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.6",
            "verseOrgIds": [
              "PSA.86.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.6",
                "verseOrgIds": [
                  "PSA.86.6"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.6",
            "verseOrgIds": [
              "PSA.86.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:6"
      },
      "items": [
        {
          "text": "tẹ́tí sí ẹkún mi fún àánú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.6",
            "verseOrgIds": [
              "PSA.86.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 86:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ ìpọ́njú mi èmi yóò pè ọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.7",
            "verseOrgIds": [
              "PSA.86.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:7"
      },
      "items": [
        {
          "text": "nítorí ìwọ yóò dá mi lóhùn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.7",
            "verseOrgIds": [
              "PSA.86.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 86:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú àwọn òrìṣà kò sí ẹni tí ó dàbí i rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.8",
            "verseOrgIds": [
              "PSA.86.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.8",
                "verseOrgIds": [
                  "PSA.86.8"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.8",
            "verseOrgIds": [
              "PSA.86.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:8"
      },
      "items": [
        {
          "text": "kò sí àwọn iṣẹ́ tí a lè fiwé tìrẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.8",
            "verseOrgIds": [
              "PSA.86.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 86:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn orílẹ̀-èdè tí ìwọ dá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.9",
            "verseOrgIds": [
              "PSA.86.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:9"
      },
      "items": [
        {
          "text": "yóò wá láti wá jọ́sìn níwájú rẹ, Olúwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.9",
            "verseOrgIds": [
              "PSA.86.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:9"
      },
      "items": [
        {
          "text": "wọn ó mú ògo wà fún orúkọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.9",
            "verseOrgIds": [
              "PSA.86.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 86:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ìwọ tóbi, ìwọ sì ń ṣe ohun ìyanu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.10",
            "verseOrgIds": [
              "PSA.86.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:10"
      },
      "items": [
        {
          "text": "ìwọ nìkan ni Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.10",
            "verseOrgIds": [
              "PSA.86.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 86:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kọ́ mi ní ọ̀nà rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.11",
                "verseOrgIds": [
                  "PSA.86.11"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:11"
      },
      "items": [
        {
          "text": "èmi ó sì máa rìn nínú òtítọ́ rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 86:11"
      },
      "items": [
        {
          "text": "fún mi ní ọkàn tí kì í yapa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:11"
      },
      "items": [
        {
          "text": "kí èmi kí ó ba lè bẹ̀rù orúkọ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 86:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ó yìn ọ́, Olúwa Ọlọ́run mi, pẹ̀lú gbogbo ọkàn mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.12",
