  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "64",
        "style": "c",
        "sid": "PSA 64"
      },
      "items": [
        {
          "text": "64",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 64",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Saamu ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 64:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbóhùn mi, Ọlọ́run, bí mo ti ń sọ àròyé mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.1",
            "verseOrgIds": [
              "PSA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:1"
      },
      "items": [
        {
          "text": "pa ọkàn mi mọ́ kúrò lọ́wọ́ ẹ̀rù àwọn ọ̀tá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.1",
            "verseOrgIds": [
              "PSA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 64:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mí mọ́ kúrò lọ́wọ́ ìmọ̀ ìkọ̀kọ̀ àwọn ènìyàn búburú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.2",
            "verseOrgIds": [
              "PSA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:2"
      },
      "items": [
        {
          "text": "kúrò nínú ọ̀pọ̀ igbe lọ́wọ́ ìrúkèrúdò oníṣẹ́ ẹ̀ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.2",
            "verseOrgIds": [
              "PSA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 64:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n pọ́n ahọ́n wọn bí idà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.3",
            "verseOrgIds": [
              "PSA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:3"
      },
      "items": [
        {
          "text": "wọ́n sì fa ọrun wọn le láti tafà wọn, àní ọ̀rọ̀ kíkorò.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.3",
            "verseOrgIds": [
              "PSA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 64:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n tafà ní ìkọ̀kọ̀ sí àwọn aláìlẹ́ṣẹ̀:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.4",
            "verseOrgIds": [
              "PSA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:4"
      },
      "items": [
        {
          "text": "wọ́n tafà si lójijì, wọn kò sì bẹ̀rù.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.4",
            "verseOrgIds": [
              "PSA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 64:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n, gba ara wọn níyànjú nínú èrò búburú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:5"
      },
      "items": [
        {
          "text": "wọ́n sọ̀rọ̀ lórí dídẹkùn sílẹ̀ ní ìkọ̀kọ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:5"
      },
      "items": [
        {
          "text": "wọ́n wí pé, \"Ta ni yóò rí wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 64:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n gbìmọ̀ àìṣòdodo, wọ́n wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:6"
      },
      "items": [
        {
          "text": "\"A wa ti parí èrò tí a gbà tán!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:6"
      },
      "items": [
        {
          "text": "Lóòótọ́ àyà àti ọkàn ènìyàn kún fún àrékérekè.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 64:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Ọlọ́run yóò ta wọ́n ní ọfà;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.7",
            "verseOrgIds": [
              "PSA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:7"
      },
      "items": [
        {
          "text": "wọn ó sì gbọgbẹ́ lójijì.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.7",
            "verseOrgIds": [
              "PSA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 64:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahọ́n wọn yóò sì dojú ìjà kọ wọ́n, yóò sì run wọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.8",
            "verseOrgIds": [
              "PSA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:8"
      },
      "items": [
        {
          "text": "gbogbo ẹni tí ó bá rí wọn yóò sì mi orí fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.8",
            "verseOrgIds": [
              "PSA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 64:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ènìyàn yóò máa bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:9"
      },
      "items": [
        {
          "text": "wọn ó kéde iṣẹ́ Ọlọ́run",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:9"
      },
      "items": [
        {
          "text": "wọn ó dúró lé ohun tí ó ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 64:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí olódodo kí ó yọ̀ nínú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.64.10",
                "verseOrgIds": [
                  "PSA.64.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:10"
      },
      "items": [
        {
          "text": "yóò sì rí ààbò nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:10"
      },
      "items": [
        {
          "text": "Gbogbo ẹni ìdúró ṣinṣin ní ọkàn yóò máa yìn ín.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    }
  ],
