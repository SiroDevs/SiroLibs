          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bojú wo májẹ̀mú rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.20",
            "verseOrgIds": [
              "PSA.74.20"
