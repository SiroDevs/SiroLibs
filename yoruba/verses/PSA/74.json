              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tìrẹ ni ọ̀sán, tìrẹ ni òru pẹ̀lú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.16",
            "verseOrgIds": [
              "PSA.74.16"
            ]
