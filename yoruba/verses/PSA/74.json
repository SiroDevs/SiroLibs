              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rántí bí àwọn ọ̀tá ń kẹ́gàn rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.18",
            "verseOrgIds": [
