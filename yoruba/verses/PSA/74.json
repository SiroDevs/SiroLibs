      "attrs": {
        "style": "q2",
        "vid": "PSA 74:22"
      },
      "items": [
        {
          "text": "rántí bí àwọn aṣiwèrè ti ń kẹ́gàn rẹ ní gbogbo ọjọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.22",
            "verseOrgIds": [
