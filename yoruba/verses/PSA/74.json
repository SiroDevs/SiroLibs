              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dìde, Ọlọ́run, gba ẹjọ́ ara rẹ rò;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.22",
            "verseOrgIds": [
              "PSA.74.22"
            ]
          }
        }
