      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:19"
      },
      "items": [
        {
          "text": "má ṣe gbàgbé ẹ̀mí àwọn ènìyàn rẹ tí a ń pọ́n lójú títí láé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.19",
            "verseOrgIds": [
              "PSA.74.19"
