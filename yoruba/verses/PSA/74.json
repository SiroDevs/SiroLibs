      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:20"
      },
      "items": [
        {
          "text": "nítorí ibi òkùnkùn ayé kún fún ibùgbé ìkà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.20",
            "verseOrgIds": [
              "PSA.74.20"
            ]
          }
        }
      ]
