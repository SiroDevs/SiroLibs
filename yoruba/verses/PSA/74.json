      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:16"
      },
      "items": [
        {
          "text": "ìwọ yà oòrùn àti òṣùpá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.16",
            "verseOrgIds": [
              "PSA.74.16"
            ]
          }
        }
