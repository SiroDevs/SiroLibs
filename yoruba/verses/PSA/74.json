      "attrs": {
        "style": "q2",
        "vid": "PSA 74:18"
      },
      "items": [
        {
          "text": "bí àwọn aṣiwèrè ènìyàn ti ń ba orúkọ rẹ jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.18",
            "verseOrgIds": [
