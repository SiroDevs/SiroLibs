        "vid": "PSA 74:23"
      },
      "items": [
        {
          "text": "bíbú àwọn ọ̀tá rẹ, tí ó ń pọ̀ sí i nígbà gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.23",
