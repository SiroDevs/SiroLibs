      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:21"
      },
      "items": [
        {
          "text": "jẹ́ kí àwọn aláìní àti tálákà yin orúkọ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.21",
            "verseOrgIds": [
              "PSA.74.21"
            ]
