      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:17"
      },
      "items": [
        {
          "text": "Ìwọ dá ìgbà ẹ̀ẹ̀rùn àti ìgbà òtútù.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.17",
            "verseOrgIds": [
              "PSA.74.17"
