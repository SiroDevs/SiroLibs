          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe jẹ́ kí àwọn aninilára padà sẹ́yìn nínú ìtìjú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.21",
            "verseOrgIds": [
              "PSA.74.21"
            ]
