          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ pààlà etí ayé;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.17",
            "verseOrgIds": [
              "PSA.74.17"
            ]
          }
        }
