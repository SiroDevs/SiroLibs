        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 43",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 43:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dá mi láre, Ọlọ́run mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:1"
      },
      "items": [
        {
          "text": "kí o sì gba ọ̀rọ̀ mi rò lọ́dọ̀ àwọn aláìláàánú orílẹ̀-èdè:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:1"
      },
      "items": [
        {
          "text": "yọ mí kúrò lọ́wọ́ ẹlẹ́tàn àti àwọn ènìyàn búburú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ni Ọlọ́run ibi agbára mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:2"
      },
      "items": [
        {
          "text": "Èéṣe tí ìwọ fi kọ̀ mi sílẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:2"
      },
      "items": [
        {
          "text": "Èéṣe tí èmi yóò máa rìn nínú ìbìnújẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:2"
      },
      "items": [
        {
          "text": "nítorí ìnilára lọ́dọ̀ àwọn ọ̀tá?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rán ìmọ́lẹ̀ àti òtítọ́ rẹ jáde,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:3"
      },
      "items": [
        {
          "text": "jẹ́ kí wọn ó máa dáàbò bò mí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:3"
      },
      "items": [
        {
          "text": "jẹ́ kí wọn mú mi wá sí òkè mímọ́ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:3"
      },
      "items": [
        {
          "text": "sí ibi tí ìwọ ń gbé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni èmi ó lọ sí ibi pẹpẹ Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:4"
      },
      "items": [
        {
          "text": "sí Ọlọ́run ayọ̀ mi àti ìdùnnú mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:4"
      },
      "items": [
        {
          "text": "èmi yóò yìn ọ́ pẹ̀lú dùùrù,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:4"
      },
      "items": [
        {
          "text": "ìwọ Ọlọ́run, Ọlọ́run mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èéṣe tí o fi ń rẹ̀wẹ̀sì, ìwọ ọkàn mí?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "Èéṣe tí ó fi ń ru sókè nínú mi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "Fi ìrètí rẹ sínú Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "nítorí èmi yóò máa yìn ín, Òun ni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "Olùgbàlà mi àti Ọlọ́run mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    }
  ],
