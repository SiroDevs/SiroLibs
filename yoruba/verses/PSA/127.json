          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí kò ṣe pé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.127.1",
                "verseOrgIds": [
                  "PSA.127.1"
                ]
              }
            }
          ]
        },
        {
          "text": "bá kọ́ ilé náà",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:1"
      },
      "items": [
        {
          "text": "àwọn tí ń kọ́ ọ ń ṣiṣẹ́ lásán ni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:1"
      },
      "items": [
        {
          "text": "bí kò ṣe pé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.127.1",
                "verseOrgIds": [
                  "PSA.127.1"
                ]
              }
            }
          ]
        },
        {
          "text": "bá pa ìlú mọ́, olùṣọ́ jí lásán.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 127:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asán ni fún ẹ̀yin ti ẹ dìde ní kùtùkùtù",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:2"
      },
      "items": [
        {
          "text": "láti pẹ́ dùbúlẹ̀, láti jẹ oúnjẹ làálàá;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:2"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni ó ń fi ìre fún olùfẹ́ rẹ̀ lójú ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 127:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi i, àwọn ọmọ ni ìní",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.3",
            "verseOrgIds": [
              "PSA.127.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.127.3",
                "verseOrgIds": [
                  "PSA.127.3"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.3",
            "verseOrgIds": [
              "PSA.127.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:3"
      },
      "items": [
        {
          "text": "ọmọ inú sì ni èrè rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.3",
            "verseOrgIds": [
              "PSA.127.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 127:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọfà ti rí ní ọwọ́ alágbára,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.4",
            "verseOrgIds": [
              "PSA.127.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:4"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni àwọn ọmọ èwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.4",
            "verseOrgIds": [
              "PSA.127.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 127:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbùkún ni fún ọkùnrin náà tí apó rẹ̀ kún fún wọn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.5",
            "verseOrgIds": [
              "PSA.127.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:5"
      },
      "items": [
        {
          "text": "ojú kì yóò tì wọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.5",
            "verseOrgIds": [
              "PSA.127.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:5"
      },
      "items": [
        {
          "text": "ṣùgbọ́n wọn yóò ṣẹ́gun àwọn ọ̀tá ní ẹnu-ọ̀nà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.5",
            "verseOrgIds": [
              "PSA.127.5"
            ]
          }
        }
      ]
    }
