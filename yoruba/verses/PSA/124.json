              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìbá má ṣe pé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.1",
            "verseOrgIds": [
              "PSA.124.1"
            ]
          }
        },
