      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 124:7"
      },
      "items": [
        {
          "text": "okùn já àwa sì yọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.7",
            "verseOrgIds": [
              "PSA.124.7"
            ]
          }
