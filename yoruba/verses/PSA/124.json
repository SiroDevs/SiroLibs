              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìbá má ṣe pé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.2",
            "verseOrgIds": [
              "PSA.124.2"
            ]
          }
