                "verseId": "PSA.124.2",
                "verseOrgIds": [
                  "PSA.124.2"
                ]
              }
            }
          ]
        },
        {
          "text": "tó wà ní tiwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.2",
            "verseOrgIds": [
              "PSA.124.2"
            ]
