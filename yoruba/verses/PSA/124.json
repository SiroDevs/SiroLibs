          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.124.1",
                "verseOrgIds": [
                  "PSA.124.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó ti wà fún wa,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.1",
            "verseOrgIds": [
              "PSA.124.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 124:1"
      },
      "items": [
        {
          "text": "kí ni Israẹli kí ó máa wí nísinsin yìí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.1",
            "verseOrgIds": [
              "PSA.124.1"
            ]
          }
        }
