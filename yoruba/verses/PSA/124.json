      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 124:2"
      },
      "items": [
        {
          "text": "nígbà tí àwọn ènìyàn gbógun sí wa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.2",
            "verseOrgIds": [
              "PSA.124.2"
            ]
          }
        }
      ]
    },
