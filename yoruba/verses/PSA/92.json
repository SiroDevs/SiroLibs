      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:9"
      },
      "items": [
        {
          "text": "nítòótọ́ àwọn ọ̀tá rẹ yóò ṣègbé;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.9",
            "verseOrgIds": [
              "PSA.92.10"
            ]
          }
        }
