        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.92.8",
                "verseOrgIds": [
                  "PSA.92.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ni a ó gbéga títí láé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.8",
            "verseOrgIds": [
              "PSA.92.9"
            ]
          }
