            "sid": "PSA 92:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojú mi ti rí ìṣubú àwọn ọ̀tá mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.11",
            "verseOrgIds": [
              "PSA.92.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:11"
      },
      "items": [
        {
          "text": "ìparun sí àwọn ènìyàn búburú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.11",
            "verseOrgIds": [
              "PSA.92.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:11"
      },
      "items": [
        {
          "text": "tí ó dìde sí mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.11",
            "verseOrgIds": [
              "PSA.92.12"
            ]
          }
        }
      ]
    },
    {
