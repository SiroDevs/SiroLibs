      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:10"
      },
      "items": [
        {
          "text": "òróró dídára ni a dà sí mi ní orí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.10",
            "verseOrgIds": [
              "PSA.92.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
