    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Saamu. Orin. Fún Ọjọ́ Ìsinmi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 92:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohun rere ni láti máa fi ọpẹ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.1",
            "verseOrgIds": [
              "PSA.92.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.92.1",
                "verseOrgIds": [
                  "PSA.92.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:1"
      },
      "items": [
        {
          "text": "àti láti máa kọrin sí orúkọ rẹ̀, Ọ̀gá-ògo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.1",
            "verseOrgIds": [
              "PSA.92.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 92:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "láti kéde ìfẹ́ rẹ̀ ní òwúrọ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.2",
            "verseOrgIds": [
              "PSA.92.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:2"
      },
      "items": [
        {
          "text": "àti òtítọ́ rẹ̀ ní alẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.2",
            "verseOrgIds": [
              "PSA.92.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 92:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "lára ohùn èlò orin olókùn mẹ́wàá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.3",
            "verseOrgIds": [
              "PSA.92.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:3"
      },
      "items": [
        {
          "text": "àti lára ohun èlò orin haapu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.3",
            "verseOrgIds": [
              "PSA.92.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 92:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìwọ ni ó mú inú mi dùn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.4",
            "verseOrgIds": [
              "PSA.92.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:4"
      },
      "items": [
        {
          "text": "nípa iṣẹ́ rẹ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.4",
            "verseOrgIds": [
              "PSA.92.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.92.4",
                "verseOrgIds": [
                  "PSA.92.5"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.4",
            "verseOrgIds": [
              "PSA.92.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 92:4"
      },
      "items": [
        {
          "text": "èmi kọrin ayọ̀ sí iṣẹ́ ọwọ́ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.4",
            "verseOrgIds": [
              "PSA.92.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 92:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báwo ni iṣẹ́ rẹ tí tóbi tó,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.5",
            "verseOrgIds": [
              "PSA.92.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.92.5",
                "verseOrgIds": [
                  "PSA.92.6"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.5",
            "verseOrgIds": [
              "PSA.92.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:5"
      },
      "items": [
        {
          "text": "Èrò inú rẹ ìjìnlẹ̀ ni!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.5",
            "verseOrgIds": [
              "PSA.92.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 92:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òpè ènìyàn kò mọ̀ ọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.6",
            "verseOrgIds": [
              "PSA.92.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:6"
      },
      "items": [
        {
          "text": "aṣiwèrè kò sì mọ̀ ọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.6",
            "verseOrgIds": [
              "PSA.92.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 92:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà tí àwọn ènìyàn búburú bá rú jáde bí i koríko",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.7",
            "verseOrgIds": [
              "PSA.92.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:7"
      },
      "items": [
        {
          "text": "àti gbogbo àwọn olùṣe búburú gbèrú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.7",
            "verseOrgIds": [
              "PSA.92.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:7"
      },
      "items": [
        {
          "text": "wọn yóò run láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.7",
            "verseOrgIds": [
              "PSA.92.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
