        {
          "text": "Saamu 11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbẹ́kẹ̀lé mi wà nínú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.11.1",
                "verseOrgIds": [
                  "PSA.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:1"
      },
      "items": [
        {
          "text": "Báwo ní ẹ̀yin ó ṣe sọ fún ọkàn mi pé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:1"
      },
      "items": [
        {
          "text": "\"Fò gẹ́gẹ́ bi ẹyẹ lọ si orí òkè rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wò ó nítorí náà, ènìyàn búburú fa ọfà rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.2",
            "verseOrgIds": [
              "PSA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:2"
      },
      "items": [
        {
          "text": "wọn ti fi ọfà wọn sí ojú okùn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.2",
            "verseOrgIds": [
              "PSA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 11:2"
      },
      "items": [
        {
          "text": "láti tafà níbi òjìji",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.2",
            "verseOrgIds": [
              "PSA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:2"
      },
      "items": [
        {
          "text": "sí àyà ẹni ìdúró ṣinṣin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.2",
            "verseOrgIds": [
              "PSA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ìpìlẹ̀ bá bàjẹ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.3",
            "verseOrgIds": [
              "PSA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:3"
      },
      "items": [
        {
          "text": "kí ni olódodo yóò ṣe?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.3",
            "verseOrgIds": [
              "PSA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.11.4",
                "verseOrgIds": [
                  "PSA.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ń bẹ nínú tẹmpili mímọ́ rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.4",
            "verseOrgIds": [
              "PSA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.11.4",
                "verseOrgIds": [
                  "PSA.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ń bẹ lórí ìtẹ́ rẹ̀ ní ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.4",
            "verseOrgIds": [
              "PSA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 11:4"
      },
      "items": [
        {
          "text": "Ó ń wo àwọn ọmọ ènìyàn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.4",
            "verseOrgIds": [
              "PSA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:4"
      },
      "items": [
        {
          "text": "ojú rẹ̀ ń yẹ̀ wọ́n wò.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.4",
            "verseOrgIds": [
              "PSA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.11.5",
                "verseOrgIds": [
                  "PSA.11.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ń yẹ olódodo wò,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.5",
            "verseOrgIds": [
              "PSA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:5"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ènìyàn búburú àti àwọn tí o fẹ́ ìwà ipá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.5",
            "verseOrgIds": [
              "PSA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:5"
      },
      "items": [
        {
          "text": "ni ọkàn rẹ̀ kórìíra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.5",
            "verseOrgIds": [
              "PSA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sí orí àwọn ènìyàn búburú ni yóò rọ̀jò",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.6",
            "verseOrgIds": [
              "PSA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:6"
      },
      "items": [
        {
          "text": "ẹ̀yín iná àti imí-ọjọ́ tí ń jó;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.6",
            "verseOrgIds": [
              "PSA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:6"
      },
      "items": [
        {
          "text": "àti ìjì gbígbóná ní yóò jẹ ìpín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.6",
            "verseOrgIds": [
              "PSA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí, olódodo ní",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.7",
            "verseOrgIds": [
              "PSA.11.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.11.7",
                "verseOrgIds": [
                  "PSA.11.7"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.7",
            "verseOrgIds": [
              "PSA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:7"
      },
      "items": [
        {
          "text": "o fẹ́ràn òdodo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.7",
            "verseOrgIds": [
              "PSA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:7"
      },
      "items": [
        {
          "text": "ẹni ìdúró ṣinṣin yóò sì rí i.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.7",
            "verseOrgIds": [
              "PSA.11.7"
            ]
          }
        }
      ]
    }
