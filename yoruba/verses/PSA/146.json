            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.2",
                "verseOrgIds": [
                  "PSA.146.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ní gbogbo ayé mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.2",
            "verseOrgIds": [
              "PSA.146.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:2"
      },
      "items": [
        {
          "text": "èmi yóò kọrin ìyìn sí Ọlọ́run, níwọ̀n ìgbà tí mo bá wà láààyè.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.2",
            "verseOrgIds": [
              "PSA.146.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 146:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe ní ìgbẹ́kẹ̀lé nínú àwọn ọmọ-aládé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.3",
            "verseOrgIds": [
              "PSA.146.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:3"
      },
      "items": [
        {
          "text": "àní, ọmọ ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.3",
            "verseOrgIds": [
              "PSA.146.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:3"
      },
      "items": [
        {
          "text": "lọ́wọ́ ẹni tí kò sí ìrànlọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.3",
            "verseOrgIds": [
              "PSA.146.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
