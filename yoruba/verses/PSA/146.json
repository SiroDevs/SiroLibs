      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:5"
      },
      "items": [
        {
          "text": "tí ìrètí rẹ̀ wà nínú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.5",
            "verseOrgIds": [
              "PSA.146.5"
            ]
