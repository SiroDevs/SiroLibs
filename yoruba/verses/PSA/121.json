          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.121.8",
                "verseOrgIds": [
                  "PSA.121.8"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò pa àlọ àti ààbọ̀ rẹ mọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.8",
            "verseOrgIds": [
              "PSA.121.8"
            ]
          }
        }
      ]
    },
    {
