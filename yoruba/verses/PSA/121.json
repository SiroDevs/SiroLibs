        {
          "text": "Saamu 121",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Orin fún ìgòkè.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 121:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò gbé ojú mi sórí òkè wọ̀n-ọn-nì—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.1",
            "verseOrgIds": [
              "PSA.121.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:1"
      },
      "items": [
        {
          "text": "níbo ni ìrànlọ́wọ́ mi yóò ti wá?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.1",
            "verseOrgIds": [
              "PSA.121.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 121:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìrànlọ́wọ́ mi tí ọwọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.121.2",
                "verseOrgIds": [
                  "PSA.121.2"
                ]
              }
            }
          ]
        },
        {
          "text": "wá,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:2"
      },
      "items": [
        {
          "text": "ẹni tí ó dá ọ̀run òun ayé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 121:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun kì yóò jẹ́ kí ẹsẹ̀ rẹ kí ó yẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.3",
            "verseOrgIds": [
              "PSA.121.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:3"
      },
      "items": [
        {
          "text": "ẹni tí ó pa ọ́ mọ́ kì í tòògbé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.3",
            "verseOrgIds": [
              "PSA.121.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 121:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi, ẹni tí ń pa Israẹli mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.4",
            "verseOrgIds": [
              "PSA.121.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:4"
      },
      "items": [
        {
          "text": "kì í tòògbé bẹ́ẹ̀ ni kì í sùn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.4",
            "verseOrgIds": [
              "PSA.121.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 121:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.121.5",
                "verseOrgIds": [
                  "PSA.121.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ni olùpamọ́ rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.5",
            "verseOrgIds": [
              "PSA.121.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.121.5",
                "verseOrgIds": [
                  "PSA.121.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ní òjìji rẹ ní ọwọ́ ọ̀tún rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.5",
            "verseOrgIds": [
              "PSA.121.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 121:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oòrùn kì yóò pa ọ́ ní ìgbà ọ̀sán",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.6",
            "verseOrgIds": [
              "PSA.121.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:6"
      },
      "items": [
        {
          "text": "tàbí òṣùpá ní ìgbà òru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.6",
            "verseOrgIds": [
              "PSA.121.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 121:7"
