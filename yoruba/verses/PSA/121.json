      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:8"
      },
      "items": [
        {
          "text": "láti ìgbà yìí lọ àti títí láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.8",
            "verseOrgIds": [
              "PSA.121.8"
            ]
          }
        }
      ]
