                "verseId": "PSA.121.7",
                "verseOrgIds": [
                  "PSA.121.7"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò pa ọ́ mọ́ kúrò nínú ibi gbogbo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.7",
            "verseOrgIds": [
              "PSA.121.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:7"
      },
      "items": [
        {
          "text": "yóò pa ọkàn rẹ mọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.7",
            "verseOrgIds": [
              "PSA.121.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 121:8"
