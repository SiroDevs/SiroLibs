  "verseCount": 6,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "53",
        "style": "c",
        "sid": "PSA 53"
      },
      "items": [
        {
          "text": "53",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 53",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Gẹ́gẹ́ bí mahalati. Maskili ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 53:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aṣiwèrè wí ní ọkàn rẹ̀ pé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "\"Ọlọ́run kò sí.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "Wọ́n bàjẹ́, gbogbo ọ̀nà wọn sì burú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "kò sì ṣí ẹnìkan tí ń ṣe rere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 53:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run bojú wo ilẹ̀ láti ọ̀run",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "sórí àwọn ọmọ ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "láti wò bóyá ẹnìkan wà, tí ó ní òye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "tí ó sì ń wá Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 53:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ènìyàn tí ó ti yí padà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:3"
      },
      "items": [
        {
          "text": "wọ́n ti parapọ̀ di ìbàjẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:3"
      },
      "items": [
        {
          "text": "kò sí ẹnìkan tí ó ń ṣe rere, kò sí ẹnìkan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 53:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣé àwọn oníṣẹ́ búburú kò ní ìmọ̀?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 53:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:4"
      },
      "items": [
        {
          "text": "Àwọn ẹni tí ń jẹ ènìyàn mi, bí ẹni jẹun",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:4"
      },
      "items": [
        {
          "text": "tí wọn kò sì pe Ọlọ́run?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 53:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbẹ̀ ni ìwọ gbé wà ní ìbẹ̀rù ńlá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "níbi tí ẹ̀rù kò gbé sí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "nítorí Ọlọ́run tí fọ́n egungun àwọn tí ó dó tì ọ́ ká;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "ìwọ tí dójútì wọ́n, nítorí Ọlọ́run ti kẹ́gàn wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 53:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbàlà Israẹli ìbá jáde wá láti Sioni!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:6"
      },
      "items": [
        {
          "text": "Nígbà tí Ọlọ́run bá mú ohun ìní àwọn ènìyàn rẹ̀ padà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:6"
      },
      "items": [
        {
          "text": "jẹ́ kí Jakọbu yọ̀ kí inú Israẹli sì máa dùn!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    }
  ],
