          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jẹ́ kí odo kí ó ṣápẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.8",
            "verseOrgIds": [
              "PSA.98.8"
            ]
          }
        }
