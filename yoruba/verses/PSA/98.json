      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:3"
      },
      "items": [
        {
          "text": "iṣẹ́ ìgbàlà Ọlọ́run wa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
