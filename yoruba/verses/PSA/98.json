                "verseOrgIds": [
                  "PSA.98.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ ìgbàlà rẹ̀ di mí mọ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.2",
            "verseOrgIds": [
              "PSA.98.2"
            ]
          }
        }
