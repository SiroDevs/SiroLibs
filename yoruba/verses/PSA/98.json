      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 98:7"
      },
      "items": [
        {
          "text": "Gbogbo ayé àti gbogbo àwọn tí ń gbé inú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.7",
            "verseOrgIds": [
              "PSA.98.7"
            ]
          }
