                "verseOrgIds": [
                  "PSA.98.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", pẹ̀lú dùùrù àti ìró ohùn orin mímọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.5",
            "verseOrgIds": [
              "PSA.98.5"
