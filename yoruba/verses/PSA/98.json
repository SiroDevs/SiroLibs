      "attrs": {
        "style": "q2",
        "vid": "PSA 98:1"
      },
      "items": [
        {
          "text": "nítorí tí ó ṣe ohun ìyanu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
