      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:8"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bẹ́ẹ̀ ni olúkúlùkù ẹni tí ó gbẹ́kẹ̀ rẹ̀ lé wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.8",
            "verseOrgIds": [
              "PSA.115.8"
            ]
          }
        }
      ]
