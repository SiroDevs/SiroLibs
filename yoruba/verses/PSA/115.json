    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:7"
      },
      "items": [
        {
          "text": "wọ́n ní ẹsẹ̀, ṣùgbọ́n wọn kò rìn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.7",
            "verseOrgIds": [
              "PSA.115.7"
            ]
          }
        }
      ]
