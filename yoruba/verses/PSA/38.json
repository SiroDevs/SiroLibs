          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe kọ̀ mí sílẹ̀, ìwọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.21",
            "verseOrgIds": [
              "PSA.38.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.38.21",
                "verseOrgIds": [
                  "PSA.38.22"
                ]
              }
            }
          ]
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.21",
            "verseOrgIds": [
              "PSA.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:21"
      },
      "items": [
        {
          "text": "Ọlọ́run mi, má ṣe jìnnà sí mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.21",
            "verseOrgIds": [
              "PSA.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yára láti ràn mí lọ́wọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.22",
            "verseOrgIds": [
              "PSA.38.23"
            ]
          }
        }
      ]
    },
    {
