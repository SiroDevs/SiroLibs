  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "PSA 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Saamu Dafidi. Ẹ̀bẹ̀.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.38.1",
                "verseOrgIds": [
                  "PSA.38.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", má ṣe bá mi wí nínú ìbínú rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.1",
            "verseOrgIds": [
              "PSA.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:1"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni kí o má ṣe fi ìyà jẹ mí nínú ìrunú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.1",
            "verseOrgIds": [
              "PSA.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí ọfà rẹ kàn mọ́ mi ṣinṣin,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.2",
            "verseOrgIds": [
              "PSA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:2"
      },
      "items": [
        {
          "text": "ọwọ́ rẹ sì kì mí mọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.2",
            "verseOrgIds": [
              "PSA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ibi yíyè ní ara à mi, nítorí ìbínú rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.3",
            "verseOrgIds": [
              "PSA.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:3"
      },
      "items": [
        {
          "text": "kò sí àlàáfíà nínú egungun mi nítorí i ẹ̀ṣẹ̀ mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.3",
            "verseOrgIds": [
              "PSA.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí àìṣedéédéé mi ti borí mi mọ́lẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.4",
            "verseOrgIds": [
              "PSA.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:4"
      },
      "items": [
        {
          "text": "wọ́n tó ìwọ̀n bi àjàgà tí ó wúwo jù fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.4",
            "verseOrgIds": [
              "PSA.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọgbẹ́ mi ń rùn ó sì díbàjẹ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.5",
            "verseOrgIds": [
              "PSA.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:5"
      },
      "items": [
        {
          "text": "nítorí òmùgọ̀ mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.5",
            "verseOrgIds": [
              "PSA.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ń jòwèrè, orí mi tẹ̀ ba gidigidi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.6",
            "verseOrgIds": [
              "PSA.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:6"
      },
      "items": [
        {
          "text": "èmi ń ṣọ̀fọ̀ rìn kiri ní gbogbo ọjọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.6",
            "verseOrgIds": [
              "PSA.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ẹ̀gbẹ́ mi kún fún ìgbóná tí ń jóni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.7",
            "verseOrgIds": [
              "PSA.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:7"
      },
      "items": [
        {
          "text": "kò sì ṣí ibi yíyè ní ara mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.7",
            "verseOrgIds": [
              "PSA.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ara mi hù, a sì wó mi jẹ́gẹjẹ̀gẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.8",
            "verseOrgIds": [
              "PSA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:8"
      },
      "items": [
        {
          "text": "mo kérora nítorí ìrúkèrúdò àyà mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.8",
            "verseOrgIds": [
              "PSA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.38.9",
                "verseOrgIds": [
                  "PSA.38.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", gbogbo ìfẹ́ mi ń bẹ níwájú rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.9",
            "verseOrgIds": [
              "PSA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:9"
      },
      "items": [
        {
          "text": "ìmí ẹ̀dùn mi kò sá pamọ́ fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.9",
            "verseOrgIds": [
              "PSA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àyà mi ń mí hẹlẹ, agbára mi yẹ̀ mí sílẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.10",
            "verseOrgIds": [
              "PSA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:10"
      },
      "items": [
        {
          "text": "bí ó ṣe ti ìmọ́lẹ̀ ojú mi ni, ó ti lọ kúrò lára mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.10",
            "verseOrgIds": [
              "PSA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀rẹ́ mi àti àwọn ẹlẹgbẹ́ mi dúró lókèèrè réré kúrò níbi ìpọ́njú mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.11",
            "verseOrgIds": [
              "PSA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:11"
      },
      "items": [
        {
          "text": "àwọn alábágbé mi, dúró lókèèrè.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.11",
            "verseOrgIds": [
              "PSA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí n wá ẹ̀mí mi dẹ okùn sílẹ̀ fún mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.12",
            "verseOrgIds": [
              "PSA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:12"
      },
      "items": [
        {
          "text": "àti àwọn tí ó fẹ́ pa mí lára ń sọ̀rọ̀ nípa ìparun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.12",
            "verseOrgIds": [
              "PSA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:12"
      },
      "items": [
        {
          "text": "wọ́n sì ń gbèrò ẹ̀tàn ní gbogbo ọjọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.12",
            "verseOrgIds": [
              "PSA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n mo dàbí adití odi, èmi kò gbọ́ ọ̀rọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.13",
            "verseOrgIds": [
              "PSA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:13"
      },
      "items": [
        {
          "text": "àti bí odi, tí kò le sọ̀rọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.13",
            "verseOrgIds": [
              "PSA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́, mo rí bí ọkùnrin tí kò gbọ́rọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.14",
            "verseOrgIds": [
              "PSA.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:14"
      },
      "items": [
        {
          "text": "àti bí ẹnu ẹni tí kò sí ìjiyàn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.14",
            "verseOrgIds": [
              "PSA.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n sí ọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.15",
            "verseOrgIds": [
              "PSA.38.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.38.15",
                "verseOrgIds": [
                  "PSA.38.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", ìwọ ni mo dúró dè;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.15",
            "verseOrgIds": [
              "PSA.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:15"
      },
      "items": [
        {
          "text": "ìwọ ni, Olúwa Ọlọ́run mi, ẹni tí yóò dáhùn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.15",
            "verseOrgIds": [
              "PSA.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí mo gbàdúrà, \"Gbóhùn mi, kí wọn má ba à yọ̀ mí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.16",
            "verseOrgIds": [
              "PSA.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:16"
      },
      "items": [
        {
          "text": "nígbà tí ẹsẹ̀ mi bá yọ̀ wọn yóò máa gbé ara wọn ga sí mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.16",
            "verseOrgIds": [
              "PSA.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí mo ti ṣetán láti ṣubú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.17",
            "verseOrgIds": [
              "PSA.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:17"
      },
      "items": [
        {
          "text": "ìrora mi sì wà pẹ̀lú mi nígbà gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.17",
            "verseOrgIds": [
              "PSA.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo jẹ́wọ́ ìrékọjá mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.18",
            "verseOrgIds": [
              "PSA.38.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:18"
      },
      "items": [
        {
          "text": "àánú sì ṣe mí fún ẹ̀ṣẹ̀ mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.18",
            "verseOrgIds": [
              "PSA.38.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó jẹ́ ọ̀tá mi láìnídìí pàtàkì, wọ́n lágbára púpọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.19",
            "verseOrgIds": [
              "PSA.38.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:19"
      },
      "items": [
        {
          "text": "ọ̀pọ̀lọpọ̀ ni àwọn tí ó kórìíra mi lọ́nà òdì.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.19",
            "verseOrgIds": [
              "PSA.38.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí wọn ń fi ibi san rere fún mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.20",
            "verseOrgIds": [
              "PSA.38.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:20"
      },
      "items": [
        {
          "text": "àwọn ni ọ̀tá mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.20",
            "verseOrgIds": [
              "PSA.38.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:20"
      },
      "items": [
        {
          "text": "nítorí pé mò ń tọ ìre lẹ́yìn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.20",
            "verseOrgIds": [
              "PSA.38.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
