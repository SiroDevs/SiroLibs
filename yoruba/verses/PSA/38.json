          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.38.22",
                "verseOrgIds": [
                  "PSA.38.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", Olùgbàlà mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.22",
            "verseOrgIds": [
              "PSA.38.23"
            ]
          }
