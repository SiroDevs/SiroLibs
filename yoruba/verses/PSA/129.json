      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:6"
      },
      "items": [
        {
          "text": "tí ó gbẹ dànù kí ó tó dàgbàsókè,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.6",
            "verseOrgIds": [
              "PSA.129.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
