      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:7"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni ẹni tí ń di ìtí, kó kún apá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.7",
            "verseOrgIds": [
              "PSA.129.7"
            ]
          }
        }
