          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "èyí tí olóko pípa kó kún ọwọ́ rẹ̀:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.7",
            "verseOrgIds": [
              "PSA.129.7"
