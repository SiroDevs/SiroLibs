            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìgbà púpọ̀ ni wọ́n ti pọ́n mi lójú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.1",
            "verseOrgIds": [
              "PSA.129.1"
            ]
          }
        }
