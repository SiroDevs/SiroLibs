      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:5"
      },
      "items": [
        {
          "text": "kí wọn kí ó sì yí ẹ̀yìn padà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.5",
            "verseOrgIds": [
              "PSA.129.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
