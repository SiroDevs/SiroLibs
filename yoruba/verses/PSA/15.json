      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:4"
      },
      "items": [
        {
          "text": "àní tí kò sì yípadà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí ó ń yá ni lówó láìsí èlé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.5",
            "verseOrgIds": [
              "PSA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:5"
      },
      "items": [
        {
          "text": "tí kò sì gba àbẹ̀tẹ́lẹ̀ lòdì sí aláìlẹ́ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.5",
            "verseOrgIds": [
              "PSA.15.5"
