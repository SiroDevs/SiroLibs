                "verseId": "PSA.15.1",
                "verseOrgIds": [
                  "PSA.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", ta ni yóò máa ṣe àtìpó nínú àgọ́ rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.1",
            "verseOrgIds": [
