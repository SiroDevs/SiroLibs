            "number": "3",
            "style": "v",
            "sid": "PSA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí kò fi ahọ́n rẹ̀ sọ̀rọ̀ ẹni lẹ́yìn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.3",
            "verseOrgIds": [
              "PSA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:3"
      },
      "items": [
        {
          "text": "tí kò ṣe ibi sí aládùúgbò rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.3",
            "verseOrgIds": [
              "PSA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:3"
      },
      "items": [
        {
          "text": "tí kò sì sọ̀rọ̀ ẹ̀gàn sí ẹnìkejì rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.3",
            "verseOrgIds": [
              "PSA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ní ojú ẹni tí ènìyànkénìyàn di gígàn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:4"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ó bọ̀wọ̀ fún àwọn tí ó bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.15.4",
                "verseOrgIds": [
                  "PSA.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 15:4"
      },
      "items": [
        {
          "text": "ẹni tí ó búra sí ibi ara rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
