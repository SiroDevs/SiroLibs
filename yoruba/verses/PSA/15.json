      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:1"
      },
      "items": [
        {
          "text": "Ta ni yóò máa gbé ní òkè mímọ́ rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.1",
            "verseOrgIds": [
              "PSA.15.1"
            ]
          }
        }
