      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:2"
      },
      "items": [
        {
          "text": "tí ó sì ń sọ òtítọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.2",
            "verseOrgIds": [
              "PSA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:2"
      },
      "items": [
        {
          "text": "láti inú ọkàn rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.2",
            "verseOrgIds": [
              "PSA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
