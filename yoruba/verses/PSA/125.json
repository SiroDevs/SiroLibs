        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Orin fún ìgòkè.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 125:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó gbẹ́kẹ̀lé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.125.1",
                "verseOrgIds": [
                  "PSA.125.1"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò dàbí òkè Sioni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:1"
      },
      "items": [
        {
          "text": "tí a kò lè ṣí ní ìdí, bí kò ṣe pé ó dúró láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 125:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí òkè ńlá ti yí Jerusalẹmu ká,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:2"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.125.2",
                "verseOrgIds": [
                  "PSA.125.2"
                ]
              }
            }
          ]
        },
        {
          "text": "yí ènìyàn ká",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:2"
      },
      "items": [
        {
          "text": "láti ìsinsin yìí lọ àti títí láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 125:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí ọ̀pá àwọn ènìyàn búburú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.3",
            "verseOrgIds": [
              "PSA.125.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:3"
      },
      "items": [
        {
          "text": "kì yóò bà lé ìpín àwọn olódodo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.3",
            "verseOrgIds": [
              "PSA.125.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 125:3"
      },
      "items": [
        {
          "text": "kí àwọn olódodo kí ó máa ba à",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.3",
            "verseOrgIds": [
              "PSA.125.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:3"
      },
      "items": [
        {
          "text": "fi ọwọ́ wọn lé ẹ̀ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.3",
            "verseOrgIds": [
              "PSA.125.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 125:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.125.4",
                "verseOrgIds": [
                  "PSA.125.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe rere fún àwọn ẹni rere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.4",
            "verseOrgIds": [
              "PSA.125.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:4"
      },
      "items": [
        {
          "text": "àti fún àwọn tí àyà wọn dúró ṣinṣin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.4",
            "verseOrgIds": [
              "PSA.125.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 125:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ṣe ti irú àwọn tí wọn yà sí ipa ọ̀nà wíwọ́ wọn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.125.5",
                "verseOrgIds": [
                  "PSA.125.5"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò jẹ́ kí wọn lọ pẹ̀lú àwọn oníṣẹ́ ẹ̀ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 125:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 125:5"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n àlàáfíà yóò wà lórí Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        }
      ]
    }
