  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "79",
        "style": "c",
        "sid": "PSA 79"
      },
      "items": [
        {
          "text": "79",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 79",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Saamu ti Asafu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 79:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run, àwọn orílẹ̀-èdè ti wá ilẹ̀ ìní rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:1"
      },
      "items": [
        {
          "text": "wọ́n ti ba tẹmpili mímọ́ rẹ jẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:1"
      },
      "items": [
        {
          "text": "wọn di Jerusalẹmu kù sí òkìtì àlàpà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 79:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn ti fi ara òkú àwọn ìránṣẹ́ rẹ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:2"
      },
      "items": [
        {
          "text": "fún àwọn ẹyẹ ojú ọ̀run ní oúnjẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:2"
      },
      "items": [
        {
          "text": "ẹran-ara àwọn ènìyàn mímọ́ rẹ̀ fún ẹranko ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 79:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n tu ẹ̀jẹ̀ jáde gẹ́gẹ́ bí omi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:3"
      },
      "items": [
        {
          "text": "yí Jerusalẹmu ká,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:3"
      },
      "items": [
        {
          "text": "kò sì ṣí àwọn tí yóò sìn wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 79:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa di ohun ẹ̀gàn sí àwọn tí ó yí wa ká,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.4",
            "verseOrgIds": [
              "PSA.79.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:4"
      },
      "items": [
        {
          "text": "àbùkù àti ìfiṣe ẹlẹ́yà sí àwọn tí ó yí wa ká.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.4",
            "verseOrgIds": [
              "PSA.79.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 79:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà wo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.5",
            "verseOrgIds": [
              "PSA.79.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.79.5",
                "verseOrgIds": [
                  "PSA.79.5"
                ]
              }
            }
          ]
        },
        {
          "text": "? Ní ìwọ ó máa bínú títí láé?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.5",
            "verseOrgIds": [
              "PSA.79.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:5"
      },
      "items": [
        {
          "text": "Yóò ti pẹ́ tó ti owú rẹ yóò ha jò bí iná?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.5",
            "verseOrgIds": [
              "PSA.79.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 79:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú ìbínú rẹ jáde sí orílẹ̀-èdè",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:6"
      },
      "items": [
        {
          "text": "tí kò ní ìmọ̀ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:6"
      },
      "items": [
        {
          "text": "lórí àwọn ìjọba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:6"
      },
      "items": [
        {
          "text": "tí kò pe orúkọ rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 79:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí wọ́n ti run Jakọbu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.7",
            "verseOrgIds": [
              "PSA.79.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:7"
      },
      "items": [
        {
          "text": "wọ́n sì sọ ibùgbé rẹ di ahoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.7",
            "verseOrgIds": [
              "PSA.79.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 79:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe ka ẹ̀ṣẹ̀ àwọn baba wa sí wa lọ́rùn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:8"
      },
      "items": [
        {
          "text": "jẹ́ kí àánú rẹ wá kánkán láti bá wa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:8"
      },
      "items": [
        {
          "text": "nítorí tí a rẹ̀ wá sílẹ̀ gidigidi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 79:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ràn wá lọ́wọ́, Ọlọ́run Olùgbàlà wa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:9"
      },
      "items": [
        {
          "text": "fún ògo orúkọ rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:9"
      },
      "items": [
        {
          "text": "gbà wá kí o sì dárí ẹ̀ṣẹ̀ wa jì",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:9"
      },
      "items": [
        {
          "text": "nítorí orúkọ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 79:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn orílẹ̀-èdè yóò máa wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "\"Níbo ni Ọlọ́run wọn wà?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 79:10"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "Ní ojú wa, kí a mọ̀ láàrín àwọn orílẹ̀-èdè",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "kí ó sì gbẹ̀san àwọn ẹ̀jẹ̀ ìránṣẹ́ rẹ tí a tú jáde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 79:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí ìmí ẹ̀dùn oǹdè náà wá síwájú rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.11",
            "verseOrgIds": [
              "PSA.79.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:11"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí títóbi agbára rẹ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.11",
            "verseOrgIds": [
              "PSA.79.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:11"
      },
      "items": [
        {
          "text": "ìwọ ṣe ìtọ́jú àwọn ti a dá lẹ́bi ikú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.11",
            "verseOrgIds": [
              "PSA.79.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 79:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "San án padà sí àyà àwọn aládùúgbò wa nígbà méje",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.12",
            "verseOrgIds": [
              "PSA.79.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:12"
      },
      "items": [
        {
          "text": "nípa ẹ̀gàn tí wọn ti gàn ọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.12",
            "verseOrgIds": [
              "PSA.79.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
