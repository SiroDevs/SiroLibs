      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:26"
      },
      "items": [
        {
          "text": "wọn yóò sì di àpatì.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
