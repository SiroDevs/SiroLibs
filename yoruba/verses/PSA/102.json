      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:24"
      },
      "items": [
        {
          "text": "\"Ọlọ́run mi, má ṣe mú mi kúrò ní agbede-méjì ọjọ́ mi; ọdún rẹ̀ ń lọ láti ìran dé ìran.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.24",
            "verseOrgIds": [
              "PSA.102.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
