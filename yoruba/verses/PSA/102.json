  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "102",
        "style": "c",
        "sid": "PSA 102"
      },
      "items": [
        {
          "text": "102",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 102",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Àdúrà olùpọ́njú tí àárẹ̀ mú, tí ó sí ọkàn rẹ̀ payá níwájú",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 102:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbọ́ àdúrà mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.1",
            "verseOrgIds": [
              "PSA.102.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.102.1",
                "verseOrgIds": [
                  "PSA.102.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.1",
            "verseOrgIds": [
              "PSA.102.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:1"
      },
      "items": [
        {
          "text": "jẹ́ kí igbe ẹ̀bẹ̀ mi kí ó wá sí ọ̀dọ̀ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.1",
            "verseOrgIds": [
              "PSA.102.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 102:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe pa ojú rẹ mọ́ kúrò lọ́dọ̀ mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:2"
      },
      "items": [
        {
          "text": "ní ọjọ́ tí èmi wà nínú ìpọ́njú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 102:2"
      },
      "items": [
        {
          "text": "Dẹ etí rẹ sí mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:2"
      },
      "items": [
        {
          "text": "nígbà tí mo bá pè, dá mi lóhùn kíákíá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 102:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí ọjọ́ mi run bí èéfín;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.3",
            "verseOrgIds": [
              "PSA.102.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:3"
      },
      "items": [
        {
          "text": "egungun mi sì jóná bí ààrò.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.3",
            "verseOrgIds": [
              "PSA.102.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 102:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àyà mi lù, ó sì rọ bí i koríko;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.4",
            "verseOrgIds": [
              "PSA.102.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:4"
      },
      "items": [
        {
          "text": "mo gbàgbé láti jẹ oúnjẹ mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.4",
            "verseOrgIds": [
              "PSA.102.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 102:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ohùn ìkérora mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.5",
            "verseOrgIds": [
              "PSA.102.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:5"
      },
      "items": [
        {
          "text": "egungun mi lẹ̀ mọ́ ẹran-ara mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.5",
            "verseOrgIds": [
              "PSA.102.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 102:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi dàbí ẹyẹ igún ní ijù:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.6",
            "verseOrgIds": [
              "PSA.102.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:6"
      },
      "items": [
        {
          "text": "èmi dàbí òwìwí ibi ahoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.6",
            "verseOrgIds": [
              "PSA.102.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 102:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi dìde; èmi dàbí ẹyẹ lórí ilé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.7",
            "verseOrgIds": [
              "PSA.102.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 102:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ gbogbo, àwọn ọ̀tá ológoṣẹ́ mi ń gàn mí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.8",
            "verseOrgIds": [
              "PSA.102.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:8"
      },
      "items": [
        {
          "text": "àwọn tí ń ṣe ìkanra sí mi ń fi orúkọ mi bú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.8",
            "verseOrgIds": [
              "PSA.102.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 102:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi jẹ eérú gẹ́gẹ́ bí oúnjẹ mi, èmi sì da ohun mímu mi pọ̀ pẹ̀lú omijé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.9",
            "verseOrgIds": [
              "PSA.102.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 102:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìbínú ríru rẹ, nítorí ìwọ ti gbé mi sókè, ìwọ sì gbé mi ṣánlẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.10",
            "verseOrgIds": [
              "PSA.102.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 102:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọjọ́ mi dàbí òjìji àṣálẹ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.11",
            "verseOrgIds": [
              "PSA.102.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:11"
      },
      "items": [
        {
          "text": "èmi sì rọ bí koríko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.11",
            "verseOrgIds": [
              "PSA.102.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 102:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìwọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.102.12",
                "verseOrgIds": [
                  "PSA.102.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", ni yóò dúró láéláé;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:12"
      },
      "items": [
        {
          "text": "ìrántí rẹ láti ìran dé ìran.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 102:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ó dìde ìwọ ó sì ṣàánú fún Sioni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:13"
      },
      "items": [
        {
          "text": "nítorí ìgbà àti ṣe ojúrere sí i;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:13"
      },
      "items": [
        {
          "text": "àkókò náà ti dé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 102:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí àwọn òkúta jẹ́ inú dídùn sí àwọn ìránṣẹ́ rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.14",
            "verseOrgIds": [
              "PSA.102.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:14"
      },
      "items": [
        {
          "text": "wọ́n sì káàánú erùpẹ̀ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.14",
            "verseOrgIds": [
              "PSA.102.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 102:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn kèfèrí yóò bẹ̀rù orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.15",
            "verseOrgIds": [
              "PSA.102.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.102.15",
                "verseOrgIds": [
                  "PSA.102.16"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.15",
            "verseOrgIds": [
              "PSA.102.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:15"
      },
      "items": [
        {
          "text": "gbogbo ọba ayé yóò máa bẹ̀rù ògo rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.15",
            "verseOrgIds": [
              "PSA.102.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 102:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torí tí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.16",
            "verseOrgIds": [
