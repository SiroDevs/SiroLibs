          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìwọ wà digbí síbẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.27",
            "verseOrgIds": [
              "PSA.102.28"
            ]
          }
        }
      ]
    },
