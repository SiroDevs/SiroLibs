          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi sì wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.24",
            "verseOrgIds": [
              "PSA.102.25"
            ]
          }
        }
      ]
    },
    {
