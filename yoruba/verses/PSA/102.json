          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 102:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò ṣègbé, wọn yóò parun, ṣùgbọ́n ìwọ yóò wà;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:26"
      },
      "items": [
        {
          "text": "gbogbo wọn ni yóò gbó bí aṣọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
          }
        }
      ]
    },
