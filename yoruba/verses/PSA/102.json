      "attrs": {
        "style": "q2",
        "vid": "PSA 102:23"
      },
      "items": [
        {
          "text": "ó gé ọjọ́ mi kúrú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.23",
            "verseOrgIds": [
              "PSA.102.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
