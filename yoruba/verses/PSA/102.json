      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 102:26"
      },
      "items": [
        {
          "text": "Bí ẹ̀wù ni ìwọ yóò pààrọ̀ wọn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
          }
        }
      ]
    },
