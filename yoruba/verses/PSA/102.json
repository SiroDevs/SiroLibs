      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:27"
      },
      "items": [
        {
          "text": "ọdún rẹ kò sì ní òpin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.27",
            "verseOrgIds": [
              "PSA.102.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 102:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ ìránṣẹ́ rẹ̀ yóò dúró ní iwájú rẹ pẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.28",
            "verseOrgIds": [
              "PSA.102.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:28"
      },
      "items": [
        {
          "text": "a ó sì fi ẹsẹ̀ irú-ọmọ wọn sọlẹ̀ ní iwájú rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.28",
            "verseOrgIds": [
              "PSA.102.29"
            ]
          }
        }
