              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìwọ kò ní inú dídùn sí ẹbọ, tí èmi kò bá mú wá;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.16",
            "verseOrgIds": [
              "PSA.51.18"
            ]
