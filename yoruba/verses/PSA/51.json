  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "51",
        "style": "c",
        "sid": "PSA 51"
      },
      "items": [
        {
          "text": "51",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 51",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Saamu ti Dafidi. Nígbà ti wòlíì Natani tọ wá, lẹ́yìn tí Dafidi dá ẹ̀ṣẹ̀ àgbèrè rẹ̀ pẹ̀lú Batṣeba.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 51:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣàánú fún mi, Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:1"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ìdúró ṣinṣin ìfẹ́ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 51:1"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ọ̀pọ̀ àánú rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:1"
      },
      "items": [
        {
          "text": "kí o sì pa gbogbo ẹ̀ṣẹ̀ mi rẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 51:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wẹ gbogbo àìṣedéédéé mi nù kúrò",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.2",
            "verseOrgIds": [
              "PSA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:2"
      },
      "items": [
        {
          "text": "kí o sì wẹ̀ mi mọ́ kúrò nínú ẹ̀ṣẹ̀ mi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.2",
            "verseOrgIds": [
              "PSA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 51:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí mo mọ̀ gbogbo ẹ̀ṣẹ̀ mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.3",
            "verseOrgIds": [
              "PSA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:3"
      },
      "items": [
        {
          "text": "nígbà gbogbo ni ẹ̀ṣẹ̀ mi wà níwájú mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.3",
            "verseOrgIds": [
              "PSA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 51:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sí ọ, ìwọ nìkan ṣoṣo, ni mo dẹ́ṣẹ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:4"
      },
      "items": [
        {
          "text": "ni mo sì ṣe búburú níwájú rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 51:4"
      },
      "items": [
        {
          "text": "kí a lè dá ọ láre nígbà tí ìwọ bá ń sọ̀rọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:4"
      },
      "items": [
        {
          "text": "kí o sì le wà láìlẹ́bi, nígbà tí ìwọ bá ń ṣe ìdájọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 51:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́, nínú ẹ̀ṣẹ̀ ni a ti bí mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.5",
            "verseOrgIds": [
              "PSA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:5"
      },
      "items": [
        {
          "text": "nínú ẹ̀ṣẹ̀ ni ìyá mí sì lóyún mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.5",
            "verseOrgIds": [
              "PSA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 51:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́ ìwọ fẹ́ òtítọ́ ní inú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.6",
            "verseOrgIds": [
              "PSA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:6"
      },
      "items": [
        {
          "text": "ìwọ kọ́ mi ní ọgbọ́n ní ìhà ìkọ̀kọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.6",
            "verseOrgIds": [
              "PSA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 51:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wẹ̀ mí pẹ̀lú ewé hísópù, èmi yóò sì mọ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.7",
            "verseOrgIds": [
              "PSA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:7"
      },
      "items": [
        {
          "text": "fọ̀ mí, èmi yóò sì funfun ju yìnyín lọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.7",
            "verseOrgIds": [
              "PSA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 51:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí n gbọ́ ayọ̀ àti inú dídùn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.8",
            "verseOrgIds": [
              "PSA.51.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:8"
      },
      "items": [
        {
          "text": "jẹ́ kí gbogbo egungun tí ìwọ ti run kí ó máa yọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.8",
            "verseOrgIds": [
              "PSA.51.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 51:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ojú rẹ̀ mọ́ kúrò nínú ẹ̀ṣẹ̀ mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.9",
            "verseOrgIds": [
              "PSA.51.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:9"
      },
      "items": [
        {
          "text": "kí o sì pa gbogbo àwọn àìṣedéédéé mi rẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.9",
            "verseOrgIds": [
              "PSA.51.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 51:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dá ọkàn mímọ́ sí inú mi, Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.10",
            "verseOrgIds": [
              "PSA.51.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:10"
      },
      "items": [
        {
          "text": "kí o sì tún ẹ̀mí dídúró ṣinṣin ṣe sínú mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.10",
            "verseOrgIds": [
              "PSA.51.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 51:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe jù mi nù kúrò níwájú rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.11",
            "verseOrgIds": [
              "PSA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:11"
      },
      "items": [
        {
          "text": "kí o má ṣe gba Ẹ̀mí Mímọ́ rẹ lọ́wọ́ mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.11",
            "verseOrgIds": [
              "PSA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 51:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mú ayọ̀ ìgbàlà rẹ tọ̀ mí wá,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.12",
            "verseOrgIds": [
              "PSA.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:12"
      },
      "items": [
        {
          "text": "kí o sì fún mi ní ẹ̀mí ìfẹ́, tí yóò mú mi dúró.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.12",
            "verseOrgIds": [
              "PSA.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 51:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni èmi yóò máa kọ́ àwọn olùrékọjá ní ọ̀nà rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.13",
            "verseOrgIds": [
              "PSA.51.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:13"
      },
      "items": [
        {
          "text": "àwọn ẹlẹ́ṣẹ̀ yóò sì yí padà sí ọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.13",
            "verseOrgIds": [
              "PSA.51.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 51:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbà mí kúrò lọ́wọ́ ẹ̀bi ẹ̀jẹ̀, Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:14"
      },
      "items": [
        {
          "text": "ìwọ Ọlọ́run ìgbàlà mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 51:14"
      },
      "items": [
        {
          "text": "ahọ́n mi yóò sì máa kọrin òdodo rẹ kíkan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 51:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
