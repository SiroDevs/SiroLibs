        "vid": "PSA 51:15"
      },
      "items": [
        {
          "text": "àti ẹnu mi yóò sì máa kéde ìyìn rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.15",
            "verseOrgIds": [
              "PSA.51.17"
            ]
