      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:16"
      },
      "items": [
        {
          "text": "Ìwọ kò ní inú dídùn sí ọrẹ ẹbọ sísun.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.16",
            "verseOrgIds": [
