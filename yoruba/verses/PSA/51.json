              "attrs": {
                "verseId": "PSA.51.15",
                "verseOrgIds": [
                  "PSA.51.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", ṣí mi ní ètè mi gbogbo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.15",
            "verseOrgIds": [
              "PSA.51.17"
