  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JDG 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìbọ̀rìṣà Mika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọkùnrin kan tí orúkọ rẹ̀ ń jẹ́ Mika láti agbègbè òkè Efraimu",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.1",
            "verseOrgIds": [
              "JDG.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "sọ fún ìyá rẹ̀ pé, \"Ẹ̀ẹ́dẹ́gbẹ̀fà ṣékélì fàdákà èyí tí wọ́n jí mọ́ ọ lọ́wọ́, àti nípa èyí tí mo gbọ́ tí ìwọ ń ṣẹ́ èpè. Kíyèsi fàdákà náà wà ní ọ̀dọ̀ mi, èmi ni mo kó o.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 17:2"
      },
      "items": [
        {
          "text": "Nígbà náà ni ìyá rẹ̀ dáhùn pé, \"Kí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.17.2",
                "verseOrgIds": [
                  "JDG.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "bùkún ọ ọmọ mi!\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó da ẹ̀ẹ́dẹ́gbẹ̀fà ṣékélì fàdákà náà padà fún ìyá rẹ̀, ìyá rẹ̀ dáhùn pé, \"Èmi ti fi òtítọ́ inú ya sílífà náà sọ́tọ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.3",
            "verseOrgIds": [
              "JDG.17.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.17.3",
                "verseOrgIds": [
                  "JDG.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "fún ọmọ mi láti fi dá ère dídá àti ère gbígbẹ́. Èmi yóò dá a padà fún ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.3",
            "verseOrgIds": [
              "JDG.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà òun dá sílífà náà padà fún ìyá rẹ̀, ìyá rẹ̀ sì mú igba ṣékélì fàdákà, ó sì fún alágbẹ̀dẹ fàdákà ẹni tí ó fi wọ́n rọ ère fínfín àti ère dídà. Wọ́n sì kó wọn sí ilé Mika.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.4",
            "verseOrgIds": [
              "JDG.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin náà, Mika sì ní ojúbọ kan. Òun sì ra ẹ̀wù efodu kan, ó sì ṣe àwọn ère kan, ó sì fi ọ̀kan nínú àwọn ọmọ rẹ̀ ọkùnrin ṣe àlùfáà rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.5",
            "verseOrgIds": [
              "JDG.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ wọ̀n-ọn-nì àwọn ọmọ Israẹli kò ní ọba; olúkúlùkù ṣe bí ó ti rò pé ó tọ́ ní ojú ara rẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.6",
            "verseOrgIds": [
              "JDG.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀dọ́mọkùnrin kan sì ti Bẹtilẹhẹmu ti Juda wá, tí í ṣe ìdílé Juda, ẹni tí í ṣe ẹ̀yà Lefi, òun sì ṣe àtìpó níbẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.7",
            "verseOrgIds": [
              "JDG.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọkùnrin náà sì ti ìlú Bẹtilẹhẹmu ti Juda lọ, láti ṣe àtìpó ní ibikíbi tí ó bá rí. Ní ojú ọ̀nà àjò rẹ̀, ó dé ilẹ̀ Mika nínú àwọn ilẹ̀ òkè Efraimu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.8",
            "verseOrgIds": [
              "JDG.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mika bi í pé, \"Níbo ni ó ti ń bọ̀?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.9",
            "verseOrgIds": [
              "JDG.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 17:9"
      },
      "items": [
        {
          "text": "Ó dáhùn pé, \"Ọmọ Lefi ni mí láti Bẹtilẹhẹmu Juda, mo sì ń wá ibi tí èmi yóò máa gbé.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.9",
            "verseOrgIds": [
              "JDG.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mika sì sọ fún un wí pé, \"Dúró lọ́dọ̀ mi kí ìwọ sì jẹ́ baba mi àti àlùfáà fún mi, èmi ó sì máa fún ọ ní ṣékélì mẹ́wàá fàdákà ní ọdọọdún, pẹ̀lú aṣọ àti oúnjẹ rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.10",
            "verseOrgIds": [
              "JDG.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọ Lefi náà sì gbà láti máa bá a gbé, ọ̀dọ́mọkùnrin náà sì dàbí ọ̀kan nínú àwọn ọmọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.11",
            "verseOrgIds": [
              "JDG.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mika ya ará Lefi náà sí mímọ́, ọ̀dọ́mọkùnrin náà sì di àlùfáà rẹ̀, ó sì ń gbé ilé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.12",
            "verseOrgIds": [
              "JDG.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mika sì wí pé, \"Báyìí, èmi mọ̀ pé",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.13",
            "verseOrgIds": [
              "JDG.17.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.17.13",
                "verseOrgIds": [
                  "JDG.17.13"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò ṣe mi ní oore nítorí pé mo ní ọmọ Lefi ní àlùfáà mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.13",
            "verseOrgIds": [
              "JDG.17.13"
            ]
          }
        }
      ]
    }
  ],
