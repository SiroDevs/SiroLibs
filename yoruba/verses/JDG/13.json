              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obìnrin náà sì bí ọmọkùnrin kan, ó sì sọ orúkọ rẹ̀ ní Samsoni. Ọmọ náà dàgbà",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.24",
            "verseOrgIds": [
              "JDG.13.24"
            ]
          }
        },
