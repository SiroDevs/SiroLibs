                "verseOrgIds": [
                  "JDG.13.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.21",
            "verseOrgIds": [
              "JDG.13.21"
            ]
          }
        }
      ]
    },
    {
