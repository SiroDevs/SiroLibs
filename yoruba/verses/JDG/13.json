          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìbí Samsoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli sì túnṣe ohun tí ó burú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.1",
            "verseOrgIds": [
              "JDG.13.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.1",
                "verseOrgIds": [
                  "JDG.13.1"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.1",
            "verseOrgIds": [
              "JDG.13.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.1",
                "verseOrgIds": [
                  "JDG.13.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fi wọ́n lé àwọn ará Filistini lọ́wọ́ fún ogójì ọdún.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.1",
            "verseOrgIds": [
              "JDG.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin ará Sora kan wà, orúkọ rẹ̀ a máa jẹ́ Manoa láti ẹ̀yà Dani. Aya rẹ̀ yàgàn kò sì bímọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.2",
            "verseOrgIds": [
              "JDG.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angẹli",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.3",
            "verseOrgIds": [
              "JDG.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.3",
                "verseOrgIds": [
                  "JDG.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "fi ara han obìnrin náà, ó sì wí fún un pé, \"Bí ó tilẹ̀ jẹ́ pé ìwọ yàgàn, ìwọ kò sì tí ì bímọ, ìwọ yóò lóyún, ìwọ yóò sì bí ọmọkùnrin kan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.3",
            "verseOrgIds": [
              "JDG.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí rí i dájúdájú pé ìwọ kò mu wáìnì tàbí ọtí líle kankan àti pé ìwọ kò jẹ ohun aláìmọ́ kankan,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.4",
            "verseOrgIds": [
              "JDG.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí ìwọ yóò lóyún, ìwọ yóò sì bí ọmọkùnrin kan. Má ṣe fi abẹ kan orí rẹ̀, nítorí pé Nasiri, ẹni ìyàsọ́tọ̀ fún Ọlọ́run ni ọmọ náà yóò jẹ́ láti ọjọ́ ìbí rẹ̀. Òun ni yóò bẹ̀rẹ̀ ìdáǹdè àwọn ọmọ Israẹli kúrò ní ọwọ́ àwọn ará Filistini.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.5",
            "verseOrgIds": [
              "JDG.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni obìnrin náà tọ ọkọ rẹ̀ lọ, o sì sọ fún un wí pé, \"Ènìyàn Ọlọ́run kan tọ̀ mí wá. Ó jọ angẹli Ọlọ́run, ó ba ènìyàn lẹ́rù gidigidi. Èmi kò béèrè ibi tí ó ti wá, òun náà kò sì sọ orúkọ rẹ̀ fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.6",
            "verseOrgIds": [
              "JDG.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ó sọ fún mi wí pé, 'Ìwọ yóò lóyún, ìwọ yóò sì bí ọmọkùnrin kan, fún ìdí èyí, má ṣe mu wáìnì tàbí àwọn ọtí líle mìíràn bẹ́ẹ̀ ni kí ìwọ má ṣe jẹ ohunkóhun tí í ṣe aláìmọ́, nítorí pé Nasiri Ọlọ́run ni ọmọ náà yóò jẹ́ láti ọjọ́ ìbí rẹ̀ títí di ọjọ́ ikú rẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.7",
            "verseOrgIds": [
              "JDG.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Manoa gbàdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.8",
            "verseOrgIds": [
              "JDG.13.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.8",
                "verseOrgIds": [
                  "JDG.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé, \"Háà",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.8",
            "verseOrgIds": [
              "JDG.13.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.8",
                "verseOrgIds": [
                  "JDG.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", èmi bẹ̀ ọ́, jẹ́ kí ènìyàn Ọlọ́run tí ìwọ rán sí wa padà tọ̀ wá wá láti kọ́ wa bí àwa yóò ti ṣe tọ́ ọmọ tí àwa yóò bí náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.8",
            "verseOrgIds": [
              "JDG.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run fetí sí ohùn Manoa, angẹli Ọlọ́run náà tún padà tọ obìnrin náà wá nígbà tí ó wà ní oko ṣùgbọ́n ọkọ rẹ̀ Manoa kò sí ní ọ̀dọ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.9",
            "verseOrgIds": [
              "JDG.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ni obìnrin náà ṣe yára lọ sọ fún ọkọ rẹ̀ pé, \"Ọkùnrin tí ó fi ara hàn mí ní ọjọ́sí ti tún padà wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.10",
            "verseOrgIds": [
              "JDG.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa yára dìde, ó sì tẹ̀lé aya rẹ̀, nígbà tí ó dé ọ̀dọ̀ ọkùnrin náà ó ní, \"Ǹjẹ́ ìwọ ni o bá obìnrin yìí sọ̀rọ̀?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.11",
            "verseOrgIds": [
              "JDG.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 13:11"
      },
      "items": [
        {
          "text": "Ọkùnrin náà dáhùn pé, \"Èmi ni.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.11",
            "verseOrgIds": [
              "JDG.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa bi ọkùnrin náà pé, \"Nígbà tí ọ̀rọ̀ rẹ bá ṣẹ kí ni yóò jẹ́ ìlànà fún ìgbé ayé àti iṣẹ́ ọmọ náà?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.12",
            "verseOrgIds": [
              "JDG.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angẹli",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.13",
            "verseOrgIds": [
              "JDG.13.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.13",
                "verseOrgIds": [
                  "JDG.13.13"
                ]
              }
            }
          ]
        },
        {
          "text": "náà dáhùn wí pé, \"Aya rẹ gbọdọ̀ ṣe gbogbo ohun tí mo ti sọ fún un",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.13",
            "verseOrgIds": [
              "JDG.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kò gbọdọ̀ jẹ ohunkóhun tí ó bá ti inú èso àjàrà jáde wá, bẹ́ẹ̀ ni kò gbọdọ̀ mu wáìnì tàbí àwọn ọtí líle mìíràn tàbí jẹ ohunkóhun tí ó bá jẹ́ aláìmọ́. Ó ní láti ṣe ohun gbogbo tí mo ti pàṣẹ fún un.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.14",
            "verseOrgIds": [
              "JDG.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa sọ fún angẹli",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.15",
            "verseOrgIds": [
              "JDG.13.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.15",
                "verseOrgIds": [
                  "JDG.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": "náà pé, \"Jọ̀wọ́ dára dúró títí àwa yóò fi pèsè ọ̀dọ́ ewúrẹ́ kan fún ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.15",
            "verseOrgIds": [
              "JDG.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angẹli",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.16",
            "verseOrgIds": [
              "JDG.13.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.16",
                "verseOrgIds": [
                  "JDG.13.16"
                ]
              }
            }
          ]
        },
        {
          "text": "náà dá Manoa lóhùn pé, \"Bí ẹ̀yin tilẹ̀ dá mi dúró, èmi kì yóò jẹ ọ̀kankan nínú oúnjẹ tí ẹ̀yin yóò pèsè. Ṣùgbọ́n tí ẹ̀yin bá fẹ́ ẹ pèsè ọrẹ ẹbọ sísun, kí ẹ sì fi rú ẹbọ sí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.16",
            "verseOrgIds": [
              "JDG.13.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.16",
                "verseOrgIds": [
                  "JDG.13.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" (Manoa kò mọ̀ pé angẹli",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.16",
            "verseOrgIds": [
              "JDG.13.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.16",
                "verseOrgIds": [
                  "JDG.13.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ní i ṣe.)",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.16",
            "verseOrgIds": [
              "JDG.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa sì béèrè lọ́wọ́ angẹli",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.17",
                "verseOrgIds": [
                  "JDG.13.17"
                ]
              }
            }
          ]
        },
        {
          "text": "náà pé, \"Kí ni orúkọ rẹ, kí àwa bá à lè fi ọlá fún ọ nígbà tí ọ̀rọ̀ rẹ bá ṣẹ?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
