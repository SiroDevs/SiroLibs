              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa sọ fún aya rẹ̀ pé, \"Dájúdájú àwa yóò kú nítorí àwa ti fi ojú rí Ọlọ́run.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.22",
            "verseOrgIds": [
              "JDG.13.22"
            ]
          }
        }
