                "verseOrgIds": [
                  "JDG.13.24"
                ]
              }
            }
          ]
        },
        {
          "text": "sì bùkún un.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.24",
            "verseOrgIds": [
              "JDG.13.24"
            ]
          }
        },
