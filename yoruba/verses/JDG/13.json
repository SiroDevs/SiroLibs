              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìyàwó rẹ̀ dáhùn pé, \"Bí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.23",
            "verseOrgIds": [
              "JDG.13.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.23",
                "verseOrgIds": [
                  "JDG.13.23"
                ]
              }
            }
          ]
        },
        {
          "text": "bá ní èrò àti pa wá kò bá tí gba ẹbọ sísun àti ọrẹ ọkà wa, tàbí fi gbogbo nǹkan wọ̀nyí hàn wá tó sọ nǹkan ìyanu yìí fún wa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.23",
            "verseOrgIds": [
              "JDG.13.23"
            ]
          }
        }
