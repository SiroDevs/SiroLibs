  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1PE 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìgbé ayé fún Ọlọ́run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ bí Kristi ti jìyà fún wa nípa ti ará, irú kan náà ni kí ẹ̀yin fi hámọ́ra; nítorí ẹni tí ó bá ti jìyà nípa ti ara, ó ti bọ́ lọ́wọ́ ẹ̀ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.1",
            "verseOrgIds": [
              "1PE.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ̀yin má ṣe fi ìgbà ayé yín ìyókù wà nínú ara mọ́ sí ìfẹ́kúfẹ̀ẹ́ ènìyàn bí kò ṣe sí ìfẹ́ Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.2",
            "verseOrgIds": [
              "1PE.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìgbà tí ó ti kọjá ti tó fún ṣíṣe ìfẹ́ àwọn aláìkọlà, rínrìn nínú ìwà wọ̀bìà, ìfẹ́kúfẹ̀ẹ́, ọtí àmupara, ìréde òru, kíkó ẹ̀gbẹ́ ọ̀mùtí, àti ìbọ̀rìṣà tí í ṣe ohun ìríra.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.3",
            "verseOrgIds": [
              "1PE.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí tí ó yà wọ́n lẹ́nu pé ẹ̀yin kò ba wọn súré sínú irú àṣejù ìwà wọ̀bìà wọ́n, tí wọ́n sì ń sọ̀rọ̀ yín ní búburú.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.4",
            "verseOrgIds": [
              "1PE.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ẹni tí yóò jíyìn fún ẹni tí ó ti múra láti ṣe ìdájọ́ alààyè àti òkú.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.5",
            "verseOrgIds": [
              "1PE.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èyí ní a sá ṣe wàásù ìyìnrere fún àwọn òkú, kí a lè ṣe ìdájọ́ wọn gẹ́gẹ́ bí ènìyàn nípa ti ara, ṣùgbọ́n kí wọ́n lè wà láààyè si Ọlọ́run nípa tí Ẹ̀mí.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.6",
            "verseOrgIds": [
              "1PE.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n òpin ohun gbogbo kù sí dẹ̀dẹ̀; nítorí náà kí ẹ̀yin wà ní àìrékọjá, kí ẹ sì máa ṣọ́ra nínú àdúrà.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.7",
            "verseOrgIds": [
              "1PE.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ju gbogbo rẹ̀ lọ, ẹ ní ìfẹ́ tí ó gbóná láàrín ara yín, nítorí ìfẹ́ ni ń bo ọ̀pọ̀lọpọ̀ ẹ̀ṣẹ̀ mọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.8",
            "verseOrgIds": [
              "1PE.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ máa ṣe ara yín ni àlejò láìsí ìkùnsínú.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.9",
            "verseOrgIds": [
              "1PE.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí olúkúlùkù ti rí ẹ̀bùn gbà, bẹ́ẹ̀ ni kí ẹ máa ṣe ìpín fún ni rẹ̀ láàrín ara yín, bí ìríjú rere tí onírúurú oore-ọ̀fẹ́ Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.10",
            "verseOrgIds": [
              "1PE.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹnikẹ́ni ba ń sọ̀rọ̀, kí o máa sọ bí ọ̀rọ̀ Ọlọ́run, bí ẹnikẹ́ni bá ń ṣe iṣẹ́ ìránṣẹ́, kí ó ṣe é bí agbára tí Ọlọ́run fi fún un, kí a lè máa yin Ọlọ́run lógo ní ohun gbogbo nípa Jesu Kristi, ẹni tí ògo àti ìjọba wà fún láé àti láéláé. Àmín.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.11",
            "verseOrgIds": [
              "1PE.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jíjìyà fun jíjẹ́ onígbàgbọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olùfẹ́, ẹ má ṣe ka ìdánwò gbígbóná ti ń bẹ láàrín yín láti dán yín wò bi ẹni pé ohun àjèjì ni ó dé bá yín.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.12",
            "verseOrgIds": [
              "1PE.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n níwọ̀n bí ẹ̀yin tí jẹ́ alábápín ìyà Kristi, ẹ máa yọ̀, kí ẹ̀yin lè yọ ayọ̀ púpọ̀ nígbà tí a bá fi ògo rẹ̀ hàn.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.13",
            "verseOrgIds": [
              "1PE.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí a bá gàn yín nítorí orúkọ Kristi, ẹni ìbùkún ni yín: nítorí Ẹ̀mí Ògo àti ti Ọlọ́run bà lé yín.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.14",
            "verseOrgIds": [
              "1PE.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ má jẹ́ kí ẹnikẹ́ni nínú yín jìyà bí apànìyàn, tàbí bí olè, tàbí bí olùṣe búburú, tàbí bí ẹni tí ń tojú bọ̀ ọ̀ràn ẹlòmíràn.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.15",
            "verseOrgIds": [
              "1PE.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ó bá jìyà bí Kristiani kí ojú má ṣe tì í, ṣùgbọ́n kí ó kúkú yin Ọlọ́run lógo nítorí ti o orúkọ yìí.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.16",
            "verseOrgIds": [
              "1PE.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ti ìgbà náà dé, tí ìdájọ́ yóò bẹ̀rẹ̀ láti ilé Ọlọ́run wá, bí ó bá sì tètè tí ọ̀dọ̀ wa bẹ̀rẹ̀, ìgbẹ̀yìn àwọn tí kò gba ìyìnrere Ọlọ́run yó ha ti rí?",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.17",
            "verseOrgIds": [
              "1PE.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ó bá ṣe pé agbára káká ni a fi gba olódodo là,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.18",
            "verseOrgIds": [
              "1PE.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 4:18"
      },
      "items": [
        {
          "text": "níbo ni aláìwà-bí-Ọlọ́run àti ẹlẹ́ṣẹ̀ yóò yọjú sí?\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.18",
            "verseOrgIds": [
              "1PE.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, ẹ jẹ́ kí àwọn tí ń jìyà gẹ́gẹ́ bí ìfẹ́ Ọlọ́run ni ṣíṣe rere, fi ọkàn wọn lè Ẹlẹ́dàá olóòtítọ́ lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.19",
            "verseOrgIds": [
              "1PE.4.19"
            ]
          }
        }
      ]
    }
  ],
