      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZR 1:11"
      },
      "items": [
        {
          "text": "Ṣeṣbassari kó gbogbo àwọn nǹkan wọ̀nyí wá pẹ̀lú àwọn ìgbèkùn tí ó gòkè wá láti Babeli sí Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
