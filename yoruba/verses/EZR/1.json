          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kirusi ran àwọn tí a kó nígbèkùn lọ́wọ́ láti padà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kìn-ín-ní Kirusi, ọba Persia, kí a lè mú ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.1",
                "verseOrgIds": [
                  "EZR.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tí Jeremiah sọ ṣẹ,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.1",
                "verseOrgIds": [
                  "EZR.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ru ọkàn Kirusi ọba Persia sókè láti ṣe ìkéde jákèjádò gbogbo agbègbè ìjọba rẹ̀, kí ó sì ṣe àkọsílẹ̀ rẹ̀ pé,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ohun tí Kirusi ọba Persia wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "EZR 1:2"
      },
      "items": [
        {
          "text": "\" '",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.2",
                "verseOrgIds": [
                  "EZR.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run ọ̀run, ti fún mi ní gbogbo ìjọba ayé. Ó sì ti yàn mí láti kọ́ tẹmpili",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.2",
                "verseOrgIds": [
                  "EZR.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "fún un ní Jerusalẹmu tí ó wà ní Juda.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni nínú àwọn ènìyàn rẹ̀ láàrín yín—kí Ọlọ́run rẹ̀ wà pẹ̀lú rẹ̀, kí ó sì gòkè lọ sí Jerusalẹmu tí ó wà ní Juda, láti kọ́ tẹmpili",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.3",
            "verseOrgIds": [
              "EZR.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.3",
                "verseOrgIds": [
                  "EZR.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli, Ọlọ́run tí ó wà ní Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.3",
            "verseOrgIds": [
              "EZR.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí àwọn ènìyàn ní ibikíbi tí ẹni náà bá ń gbé kí ó fi fàdákà àti wúrà pẹ̀lú ohun tí ó dára àti ẹran ọ̀sìn, pẹ̀lú ọrẹ àtinúwá ràn án lọ́wọ́ fún tẹmpili Ọlọ́run ní Jerusalẹmu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.4",
            "verseOrgIds": [
              "EZR.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà àwọn olórí ìdílé Juda àti Benjamini àti àwọn àlùfáà àti àwọn ará Lefi—olúkúlùkù ẹni tí Ọlọ́run ti fọwọ́ tọ́ ọkàn rẹ̀—múra láti gòkè lọ láti kọ ilé",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.5",
                "verseOrgIds": [
                  "EZR.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ní Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn aládùúgbò wọn ràn wọ́n lọ́wọ́ pẹ̀lú ohun èlò ti fàdákà àti wúrà, pẹ̀lú onírúurú ohun ìní àti ẹran ọ̀sìn àti pẹ̀lú àwọn ẹ̀bùn iyebíye, ní àfikún si gbogbo àwọn ọrẹ àtinúwá.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àfikún, ọba Kirusi mú àwọn ohun èlò tí ó jẹ́ ti ilé",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.7",
                "verseOrgIds": [
                  "EZR.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "jáde wá, tí Nebukadnessari ti kó lọ láti Jerusalẹmu tí ó sì ti kó sí ilé òrìṣà rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirusi ọba Persia pàṣẹ fún Mitredati olùṣọ́ ilé ìṣúra láti kó wọn jáde, ó sì kà wọ́n fún Ṣeṣbassari ìjòyè Juda.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni iye wọn.",
          "type": "text"
        }
      ]
    },
