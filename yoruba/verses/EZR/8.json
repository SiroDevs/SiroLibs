          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nínú àwọn ọmọ Ṣefatia:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.8",
            "verseOrgIds": [
              "EZR.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:8"
      },
      "items": [
        {
          "text": "Sebadiah ọmọ Mikaeli, àti ọgọ́rin ọkùnrin pẹ̀lú rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.8",
            "verseOrgIds": [
              "EZR.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nínú àwọn ọmọ Joabu:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.9",
            "verseOrgIds": [
              "EZR.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:9"
      },
      "items": [
        {
          "text": "Obadiah ọmọ Jehieli àti ogún ó lé nígba ó dín méjì (218) ọkùnrin pẹ̀lú rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.9",
            "verseOrgIds": [
              "EZR.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nínú àwọn ọmọ Bani:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.10",
            "verseOrgIds": [
              "EZR.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:10"
      },
      "items": [
        {
          "text": "Ṣelomiti ọmọ Josafiah, àti ọgọ́jọ ọkùnrin pẹ̀lú rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.10",
            "verseOrgIds": [
              "EZR.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nínú àwọn ọmọ Bebai:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.11",
            "verseOrgIds": [
              "EZR.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:11"
      },
      "items": [
        {
          "text": "Sekariah ọmọ Bebai àti ọkùnrin méjìdínlọ́gbọ̀n pẹ̀lú rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.11",
            "verseOrgIds": [
              "EZR.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nínú àwọn ọmọ Asgadi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.12",
            "verseOrgIds": [
              "EZR.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:12"
      },
      "items": [
        {
          "text": "Johanani ọmọ Hakatani, àti àádọ́fà ọkùnrin pẹ̀lú rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.12",
            "verseOrgIds": [
              "EZR.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nínú àwọn ọmọ Adonikami:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.13",
            "verseOrgIds": [
              "EZR.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:13"
      },
      "items": [
        {
          "text": "àwọn ti ó gbẹ̀yìn, tì orúkọ wọn ń jẹ́ Elifaleti, Jeieli àti Ṣemaiah, àti ọgọ́ta ọkùnrin pẹ̀lú wọn;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.13",
            "verseOrgIds": [
              "EZR.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nínú àwọn ọmọ Bigfai:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:14"
      },
      "items": [
        {
          "text": "Uttai àti Sakkuri, àti àádọ́rin ọkùnrin pẹ̀lú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìpadà sí Jerusalẹmu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi kó wọn jọ pọ̀ si etí odò ti ń sàn lọ sí Ahafa, a pàgọ́ síbẹ̀ fún odidi ọjọ́ mẹ́ta, nígbà ti mo wo àárín àwọn ènìyàn àti àárín àwọn àlùfáà, ń kò rí ọmọ Lefi kankan níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.15",
            "verseOrgIds": [
              "EZR.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni mo pe Elieseri, Arieli, Ṣemaiah, Elnatani, Jaribi, Elnatani, Natani, Sekariah, àti Meṣullamu, tí wọ́n jẹ́ olórí, àti Joiaribu àti Elnatani tí wọ́n jẹ́ onímọ̀ ìjìnlẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.16",
            "verseOrgIds": [
              "EZR.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mo sì rán wọn tí àwọn ti àṣẹ sí ọ̀dọ̀ Iddo, tí ó jẹ́ olórí ní ibi ti a ń pè ni Kasifia, mo sì sọ fún wọn ohun tí wọn yóò wí fun Iddo àti àwọn Lefi arákùnrin rẹ̀, tí wọ́n jẹ́ òṣìṣẹ́ tẹmpili ní Kasifia pé, kí wọn mú àwọn ìránṣẹ́ wá sí ọ̀dọ̀ wa fún ilé Ọlọ́run wa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.17",
            "verseOrgIds": [
              "EZR.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ọwọ́ àánú Ọlọ́run wa wà lára wa, wọ́n sì mú Ṣerebiah wá fún wa, ẹni tí ó kún ojú òsùwọ̀n láti ìran Mahili, ọmọ Lefi, ọmọ Israẹli, àti àwọn ọmọ Ṣerebiah àti àwọn arákùnrin rẹ̀, wọ́n jẹ́ ọkùnrin méjìdínlógún.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.18",
            "verseOrgIds": [
              "EZR.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti Haṣabiah, pẹ̀lú Jeṣaiah láti ìran Merari, pẹ̀lú àwọn arákùnrin rẹ àti àwọn ọmọ wọ́n jẹ́ ogún ọkùnrin.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.19",
            "verseOrgIds": [
              "EZR.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì tún mú ogún lé nígba (220) àwọn òṣìṣẹ́ tẹmpili wá—àwọn ènìyàn tí Dafidi àti àwọn ìjòyè rẹ̀ gbé kalẹ̀ láti ran àwọn ọmọ Lefi lọ́wọ́. Gbogbo wọn ni a ṣe àkọsílẹ̀ orúkọ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.20",
            "verseOrgIds": [
              "EZR.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbẹ̀, ní ẹ̀bá odò Ahafa, mo kéde àwẹ̀, kí a ba à le rẹ ara wa sílẹ̀ níwájú Ọlọ́run, kí a sì béèrè lọ́wọ́ rẹ̀ fún ìrìnàjò àìléwu fún wa àti àwọn ọmọ wa àti fún gbogbo ohun ìní wa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.21",
            "verseOrgIds": [
              "EZR.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo tijú láti béèrè lọ́wọ́ ọba fún àwọn jagunjagun orí ilẹ̀, àti ti orí ẹṣin láti dáàbò bò wá kúrò lọ́wọ́ àwọn ọ̀tá ní ọ̀nà wa, nítorí àti sọ fún ọba pé, \"Ọwọ́ àánú Ọlọ́run wà ní ara gbogbo ẹni tí ó gbé ojú sókè sí i, ṣùgbọ́n ìbínú ńlá rẹ wà lórí ẹni tó kọ̀ ọ́ sílẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.22",
            "verseOrgIds": [
              "EZR.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni a sì gbààwẹ̀, a sì bẹ̀bẹ̀ fún èyí lọ́dọ̀ Ọlọ́run wa, òun sì gbọ́ àdúrà wa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni mo ya àwọn àlùfáà tó jẹ́ aṣáájú méjìlá sọ́tọ̀, pẹ̀lú Ṣerebiah, Haṣabiah àti mẹ́wàá lára àwọn arákùnrin wọn,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.24",
            "verseOrgIds": [
              "EZR.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "mo sì fi òsùwọ̀n wọn ọrẹ fàdákà àti wúrà àti àwọn ohun èlò tí ọba, àti ti àwọn ìgbìmọ̀, àti ti àwọn ìjòyè, àti ti gbogbo ọmọ Israẹli tí ó wà níbẹ̀, tí wọ́n gbe sílẹ̀ fún ilé Ọlọ́run wa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.25",
            "verseOrgIds": [
              "EZR.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo fi òsùwọ̀n wọn ẹgbẹ̀ta lé láàádọ́ta (650) tálẹ́ǹtì fàdákà, àti ohun èlò fàdákà tí ó wọn ọgọ́rùn-ún tálẹ́ǹtì, ọgọ́rùn-ún tálẹ́ǹtì wúrà,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ogún ago wúrà tí iye rẹ̀ tó ẹgbẹ̀rún (1,000) dariki, àti ohun èlò idẹ dáradára méjì ti ó ni iye lórí bí i wúrà.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo wí fún wọn pé, \"Ẹ̀yin àti àwọn ohun èlò wọ̀nyí ni a ti yà sí mímọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.28",
            "verseOrgIds": [
              "EZR.8.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZR.8.28",
                "verseOrgIds": [
                  "EZR.8.28"
                ]
              }
            }
          ]
        },
        {
          "text": ". Fàdákà àti wúrà sì jẹ́ ọrẹ àtinúwá sí",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.28",
            "verseOrgIds": [
              "EZR.8.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZR.8.28",
                "verseOrgIds": [
                  "EZR.8.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run àwọn baba yín.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.28",
            "verseOrgIds": [
              "EZR.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZR 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ máa tọ́jú wọn dáradára títí ẹ̀yin yóò fi fi òsùwọ̀n wọ̀n wọ́n jáde kúrò ni ilé",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.29",
            "verseOrgIds": [
              "EZR.8.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZR.8.29",
                "verseOrgIds": [
                  "EZR.8.29"
                ]
              }
            }
          ]
        },
        {
          "text": "ni Jerusalẹmu ní iwájú àwọn aṣáájú, àwọn àlùfáà àti àwọn ọmọ Lefi, àti ní iwájú olórí ìdílé gbogbo ni Israẹli.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.29",
            "verseOrgIds": [
              "EZR.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn àlùfáà àti àwọn Lefi gba fàdákà àti wúrà àti àwọn ohun èlò mímọ́ tí a ti wọ̀n jáde fún kíkó lọ sí ilé Ọlọ́run wa ní Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.30",
            "verseOrgIds": [
              "EZR.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZR 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kejìlá oṣù kìn-ín-ní ni a gbéra kúrò ní ẹ̀bá odò Ahafa láti lọ sí Jerusalẹmu. Ọwọ́ Ọlọ́run wa wà lára wa, ó sì dáàbò bò wá kúrò lọ́wọ́ àwọn ọ̀tá àti àwọn adigunjalè ní ọ̀nà wa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.31",
            "verseOrgIds": [
              "EZR.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZR 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni a gúnlẹ̀ sí Jerusalẹmu, níbi tí a ti sinmi fún ọjọ́ mẹ́ta.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.32",
            "verseOrgIds": [
              "EZR.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZR 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹrin, a wọn ohun èlò fàdákà àti wúrà àti àwọn ohun èlò mímọ lé àlùfáà Meremoti ọmọ Uriah lọ́wọ́, láti inú ilé Ọlọ́run wa, Eleasari ọmọ Finehasi wà pẹ̀lú rẹ̀, bẹ́ẹ̀ ni àwọn ọmọ Lefi; Josabadi ọmọ Jeṣua àti Noadiah ọmọ Binnui wà níbẹ̀ pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZR 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo nǹkan ni a kà, tí a sì wọ̀n, gbogbo iye ìwọ̀n ni a sì ṣe àkọsílẹ̀ rẹ̀ sínú ìwé ní ìgbà náà.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.34",
            "verseOrgIds": [
              "EZR.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZR 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn ìgbèkùn tí ó ti padà láti ilẹ̀ àjèjì rú ẹbọ sísun sí Ọlọ́run Israẹli: akọ màlúù méjìlá fún gbogbo Israẹli, àgbò mẹ́rìndínlọ́gọ́rùn-ún, ọ̀dọ́-àgùntàn mẹ́tàdínlọ́gọ́rin, àti òbúkọ méjìlá fún ẹbọ ẹ̀ṣẹ̀. Gbogbo èyí jẹ́ ẹbọ sísun sí",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.35",
            "verseOrgIds": [
              "EZR.8.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZR.8.35",
                "verseOrgIds": [
                  "EZR.8.35"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.35",
            "verseOrgIds": [
              "EZR.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZR 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì jíṣẹ́ àṣẹ ọba fún àwọn ìjòyè àti àwọn baálẹ̀ agbègbè Eufurate, wọ́n sì ṣe ìrànlọ́wọ́ fún àwọn ènìyàn àti ilé Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.36",
            "verseOrgIds": [
              "EZR.8.36"
            ]
          }
        }
      ]
    }
  ],
