    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olórí àwọn ìdílé tí ó padà pẹ̀lú Esra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ̀nyí ni àwọn olórí ìdílé àti àwọn tí ó fi orúkọ sílẹ̀ pẹ̀lú àwọn tì wọn gòkè pẹ̀lú mi láti Babeli ní àkókò ìjọba Artasasta ọba:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nínú àwọn ọmọ Finehasi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.2",
            "verseOrgIds": [
              "EZR.8.2"
            ]
          }
        }
      ]
    },
    {
