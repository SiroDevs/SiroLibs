      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZR 8:2"
      },
      "items": [
        {
          "text": "nínú àwọn ọmọ Dafidi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.2",
            "verseOrgIds": [
              "EZR.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:2"
      },
      "items": [
        {
