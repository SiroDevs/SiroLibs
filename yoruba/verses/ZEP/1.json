          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ dákẹ́ jẹ́ẹ́ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEP.1.7",
                "verseOrgIds": [
                  "ZEP.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:7"
      },
      "items": [
        {
          "text": "nítorí tí ọjọ́",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEP.1.7",
                "verseOrgIds": [
                  "ZEP.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "kù sí dẹ̀dẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 1:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEP.1.7",
                "verseOrgIds": [
                  "ZEP.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pèsè ẹbọ kan sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:7"
      },
      "items": [
        {
          "text": "ó sì ti ya àwọn alápèjẹ rẹ̀ sí mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ọjọ́ ẹbọ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEP.1.8",
                "verseOrgIds": [
                  "ZEP.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:8"
      },
      "items": [
        {
          "text": "Èmi yóò bẹ àwọn olórí wò,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:8"
      },
      "items": [
        {
          "text": "àti àwọn ọmọ ọba ọkùnrin,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:8"
      },
      "items": [
        {
          "text": "pẹ̀lú gbogbo àwọn tí ó wọ àjèjì aṣọ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
