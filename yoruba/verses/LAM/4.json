  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "LAM 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LAM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báwo ni wúrà ṣe sọ ògo dídán rẹ̀ nù,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "wúrà dídára di àìdán!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "Òkúta ibi mímọ́ wá túká",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "sí oríta gbogbo òpópó.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LAM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báwo ni àwọn ọ̀dọ́mọkùnrin Sioni tí ó ṣe iyebíye,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:2"
      },
      "items": [
        {
          "text": "tí wọ́n fi wúrà dídára ṣe",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:2"
      },
      "items": [
        {
          "text": "wá dàbí ìkòkò amọ̀ lásán",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:2"
      },
      "items": [
        {
          "text": "iṣẹ́ ọwọ́ amọ̀kòkò!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LAM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ajáko pèsè ọmú wọn",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:3"
      },
      "items": [
        {
          "text": "fún ìtọ́jú àwọn ọmọ wọn,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:3"
      },
      "items": [
        {
          "text": "ṣùgbọ́n àwọn ènìyàn mi wá láì lọ́kàn",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:3"
      },
      "items": [
        {
          "text": "bí ògòǹgò ní aginjù.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LAM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí òǹgbẹ, ahọ́n àwọn ọmọ ọwọ́",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:4"
      },
      "items": [
        {
          "text": "lẹ̀ mọ́ òkè ẹnu wọn;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:4"
      },
      "items": [
        {
          "text": "àwọn ọmọdé bẹ̀bẹ̀ fún oúnjẹ,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:4"
      },
      "items": [
        {
          "text": "ṣùgbọ́n kò sí ẹni tí ó fi fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LAM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó ń jẹ ohun dáradára",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:5"
      },
      "items": [
        {
          "text": "di òtòṣì ní òpópó.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:5"
      },
      "items": [
        {
          "text": "Àwọn tí a fi aṣọ dáradára wọ̀",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:5"
      },
      "items": [
        {
          "text": "ni wọ́n sùn ní orí òkìtì eérú.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LAM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìjìyà àwọn ènìyàn mi",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:6"
      },
      "items": [
        {
          "text": "tóbi ju ti Sodomu lọ,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:6"
      },
      "items": [
        {
          "text": "tí a sí ní ipò ní òjijì",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:6"
      },
      "items": [
        {
          "text": "láìsí ọwọ́ láti ràn án lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LAM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọ ọba ọkùnrin wọn mọ́ ju òjò-dídì,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:7"
      },
      "items": [
        {
          "text": "wọ́n sì funfun ju wàrà lọ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:7"
      },
      "items": [
        {
          "text": "wọ́n ni ìtọ́jú bí iyùn pupa,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:7"
      },
      "items": [
        {
          "text": "ìrísí wọn dàbí safire.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LAM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nísinsin yìí wọ́n dúdú ju èédú;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:8"
      },
      "items": [
        {
          "text": "wọn kò sì dá wọn mọ̀ ní òpópó.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:8"
      },
      "items": [
        {
          "text": "Ara wọn hun mọ́ egungun;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:8"
      },
      "items": [
        {
          "text": "ó sì gbẹ bí igi gbígbẹ.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LAM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó kù nípasẹ̀ idà sàn",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:9"
      },
      "items": [
        {
          "text": "ju àwọn tí ìyàn pa;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:9"
      },
      "items": [
        {
          "text": "tí ó wọ àkísà ebi, tí ó ń ṣòfò",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:9"
      },
      "items": [
        {
          "text": "fún àìní oúnjẹ láti inú pápá.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LAM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú ọwọ́ àwọn obìnrin aláàánú",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.10",
            "verseOrgIds": [
              "LAM.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:10"
      },
      "items": [
        {
          "text": "ni wọ́n ṣe ọmọ wọn jẹ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.10",
