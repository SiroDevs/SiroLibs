              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "láti dà òsùwọ̀n fún afẹ́fẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.25",
            "verseOrgIds": [
              "JOB.28.25"
            ]
          }
