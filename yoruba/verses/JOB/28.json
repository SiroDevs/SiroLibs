      "attrs": {
        "style": "q2",
        "vid": "JOB 28:26"
      },
      "items": [
        {
          "text": "tí ó sì la ọ̀nà fún mọ̀nàmọ́ná àrá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.26",
            "verseOrgIds": [
              "JOB.28.26"
            ]
