            "number": "18",
            "style": "v",
            "sid": "JOB 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kò lè dárúkọ iyùn tàbí òkúta jasperi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.18",
            "verseOrgIds": [
              "JOB.28.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:18"
      },
      "items": [
        {
          "text": "iye ọgbọ́n sì ju iyùn lọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.18",
            "verseOrgIds": [
              "JOB.28.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òkúta topasi ti Kuṣi kò tó ẹgbẹ́ rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.19",
            "verseOrgIds": [
              "JOB.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:19"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni a kò le fi wúrà dáradára díwọ̀n iye rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.19",
            "verseOrgIds": [
              "JOB.28.19"
            ]
          }
        }
      ]
    },
