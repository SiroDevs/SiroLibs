          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà ni ó rí i, ó sì sọ ọ́ jáde;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.27",
            "verseOrgIds": [
              "JOB.28.27"
