      "attrs": {
        "style": "q2",
        "vid": "JOB 28:25"
      },
      "items": [
        {
          "text": "ó sì fi òsùwọ̀n wọ́n omi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.25",
            "verseOrgIds": [
              "JOB.28.25"
            ]
          }
        }
      ]
