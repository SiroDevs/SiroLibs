      "attrs": {
        "style": "q2",
        "vid": "JOB 28:28"
      },
      "items": [
        {
          "text": "àti láti jáde kúrò nínú ìwà búburú èyí ni òye.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.28",
            "verseOrgIds": [
