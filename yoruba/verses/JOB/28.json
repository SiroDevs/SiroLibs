      "attrs": {
        "style": "q2",
        "vid": "JOB 28:27"
      },
      "items": [
        {
          "text": "ó pèsè rẹ̀ sílẹ̀, ó sì ṣe ìwádìí rẹ̀ rí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.27",
            "verseOrgIds": [
              "JOB.28.27"
            ]
          }
        }
