      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:20"
      },
      "items": [
        {
          "text": "Tàbí níbo ni òye ń gbé?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.20",
            "verseOrgIds": [
              "JOB.28.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
