      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:22"
      },
      "items": [
        {
          "text": "àwa ti fi etí wa gbúròó rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.22",
            "verseOrgIds": [
              "JOB.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
