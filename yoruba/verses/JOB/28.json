      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:23"
      },
      "items": [
        {
          "text": "òun ni ó sì mọ ibi tí ó ń gbé.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.23",
            "verseOrgIds": [
              "JOB.28.23"
            ]
          }
        }
      ]
    },
    {
