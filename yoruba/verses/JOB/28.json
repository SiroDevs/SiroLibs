      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:28"
      },
      "items": [
        {
          "text": "\"Kíyèsi i, ẹ̀rù Olúwa èyí ni ọgbọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.28",
            "verseOrgIds": [
              "JOB.28.28"
            ]
          }
        }
      ]
