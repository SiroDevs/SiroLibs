      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:24"
      },
      "items": [
        {
          "text": "ó sì rí gbogbo ìsàlẹ̀ ọ̀run,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.24",
            "verseOrgIds": [
              "JOB.28.24"
            ]
          }
