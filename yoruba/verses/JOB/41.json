  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "JOB 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọlọ́run ń tẹ̀síwájú láti pe Jobu níjà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ǹjẹ́ ìwọ le è fi ìwọ̀ fa Lefitani jáde?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.1",
            "verseOrgIds": [
              "JOB.40.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:1"
      },
      "items": [
        {
          "text": "Tàbí ìwọ lè fi okùn so ahọ́n rẹ̀ mọ́lẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.1",
            "verseOrgIds": [
              "JOB.40.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ lè fi okùn bọ̀ ọ́ ní í mú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.2",
            "verseOrgIds": [
              "JOB.40.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:2"
      },
      "items": [
        {
          "text": "tàbí fi ìwọ̀ ẹ̀gún gun ní ẹ̀rẹ̀kẹ́?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.2",
            "verseOrgIds": [
              "JOB.40.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ha jẹ́ bẹ ẹ̀bẹ̀ fún àánú lọ́dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.3",
            "verseOrgIds": [
              "JOB.40.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:3"
      },
      "items": [
        {
          "text": "rẹ ní ọ̀pọ̀lọpọ̀ bí òun ha bá ọ sọ̀rọ̀ pẹ̀lẹ́?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.3",
            "verseOrgIds": [
              "JOB.40.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ha bá ọ dá májẹ̀mú bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.4",
            "verseOrgIds": [
              "JOB.40.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:4"
      },
      "items": [
        {
          "text": "Ìwọ ó ha máa mú ṣe ẹrú láéláé bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.4",
            "verseOrgIds": [
              "JOB.40.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ha lè ba sáré bí ẹni pé ẹyẹ ni,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.5",
            "verseOrgIds": [
              "JOB.40.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:5"
      },
      "items": [
        {
          "text": "tàbí ìwọ ó dè é fún àwọn ọmọbìnrin ìránṣẹ́ rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.5",
            "verseOrgIds": [
              "JOB.40.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹgbẹ́ àwọn apẹja yóò ha máa tà á bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.6",
            "verseOrgIds": [
              "JOB.40.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:6"
      },
      "items": [
        {
          "text": "Wọn ó ha pín láàrín àwọn oníṣòwò?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.6",
            "verseOrgIds": [
              "JOB.40.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ha lè fi ọ̀kọ̀-irin gun awọ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.7",
            "verseOrgIds": [
              "JOB.40.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:7"
      },
      "items": [
        {
          "text": "tàbí orí rẹ̀ pẹ̀lú ọ̀kọ̀ ìpẹja.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.7",
            "verseOrgIds": [
              "JOB.40.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fi ọwọ́ rẹ lé e lára,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.8",
            "verseOrgIds": [
              "JOB.40.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:8"
      },
      "items": [
        {
          "text": "ìwọ ó rántí ìjà náà, ìwọ kì yóò sì ṣe bẹ́ẹ̀ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.8",
            "verseOrgIds": [
              "JOB.40.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi, ìgbìyànjú láti mú un ní asán;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.9",
            "verseOrgIds": [
              "JOB.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:9"
      },
      "items": [
        {
          "text": "ní kìkì ìrí rẹ̀ ara kì yóò ha rọ̀ ọ́ wẹ̀sì?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.9",
            "verseOrgIds": [
              "JOB.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ẹni aláyà lílé tí ó lè ru sókè.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.10",
            "verseOrgIds": [
              "JOB.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:10"
      },
      "items": [
        {
          "text": "Ǹjẹ́ ta ni ó lè dúró níwájú mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.10",
            "verseOrgIds": [
              "JOB.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó kọ́kọ́ ṣe fún mi, tí èmi ìbá fi san án fún un?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.11",
            "verseOrgIds": [
              "JOB.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:11"
      },
      "items": [
        {
          "text": "Ohunkóhun ti ń bẹ lábẹ́ ọ̀run gbogbo, tèmi ni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.11",
            "verseOrgIds": [
              "JOB.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi kì yóò fi ẹ̀yà ara Lefitani,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.12",
            "verseOrgIds": [
              "JOB.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:12"
      },
      "items": [
        {
          "text": "tàbí ipá rẹ, tàbí ìhámọ́ra rẹ tí ó ní ẹwà pamọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.12",
            "verseOrgIds": [
              "JOB.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni yóò lè rídìí aṣọ àpáta rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.13",
            "verseOrgIds": [
              "JOB.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:13"
      },
      "items": [
        {
          "text": "Tàbí ta ni ó lè súnmọ́ ọ̀nà méjì eyín rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.13",
            "verseOrgIds": [
              "JOB.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó lè ṣí ìlẹ̀kùn iwájú rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.14",
            "verseOrgIds": [
              "JOB.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:14"
      },
      "items": [
        {
          "text": "Àyíká ẹ̀yin rẹ ni ìbẹ̀rù ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.14",
            "verseOrgIds": [
              "JOB.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìpẹ́ lílé ní ìgbéraga rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.15",
            "verseOrgIds": [
              "JOB.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:15"
      },
      "items": [
        {
          "text": "ó pàdé pọ̀ tímọ́tímọ́ bí àmì èdìdì.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.15",
            "verseOrgIds": [
              "JOB.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èkínní fi ara mọ́ èkejì tó bẹ́ẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.16",
            "verseOrgIds": [
              "JOB.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:16"
      },
      "items": [
        {
          "text": "tí afẹ́fẹ́ kò lè wọ àárín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.16",
            "verseOrgIds": [
              "JOB.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èkínní fi ara mọ́ èkejì rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.17",
            "verseOrgIds": [
              "JOB.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:17"
      },
      "items": [
        {
          "text": "wọ́n lè wọ́n pọ̀ tí a kò lè mọ̀ wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.17",
            "verseOrgIds": [
              "JOB.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa sí sin rẹ̀ ìmọ́lẹ̀ á mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.18",
            "verseOrgIds": [
              "JOB.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:18"
      },
      "items": [
        {
          "text": "ojú rẹ̀ a sì dàbí ìpéǹpéjú òwúrọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.18",
            "verseOrgIds": [
              "JOB.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ẹnu rẹ ni ọ̀wọ́-iná ti jáde wá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.19",
            "verseOrgIds": [
              "JOB.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:19"
      },
      "items": [
        {
          "text": "ìpẹ́pẹ́ iná a sì ta jáde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.19",
            "verseOrgIds": [
              "JOB.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 41:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ihò imú rẹ ni èéfín ti jáde wá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.20",
            "verseOrgIds": [
              "JOB.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:20"
      },
      "items": [
        {
          "text": "bí ẹni pé láti inú ìkòkò tí a fẹ́ iná ìfèéfèé lábẹ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.20",
            "verseOrgIds": [
              "JOB.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èémí rẹ̀ tiná bọ ẹ̀yin iná,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.21",
            "verseOrgIds": [
              "JOB.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:21"
      },
      "items": [
        {
          "text": "ọ̀wọ́-iná sì ti ẹnu rẹ̀ jáde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.21",
            "verseOrgIds": [
              "JOB.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 41:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọrùn rẹ̀ ní agbára kù sí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.22",
            "verseOrgIds": [
              "JOB.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:22"
      },
      "items": [
        {
          "text": "àti ìbànújẹ́ àyà sì padà di ayọ̀ níwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.22",
            "verseOrgIds": [
              "JOB.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 41:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabajaba ẹran rẹ̀ dìjọ pọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.23",
            "verseOrgIds": [
              "JOB.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:23"
      },
      "items": [
        {
          "text": "wọ́n múra gírí fún ara wọn, a kò lè sí wọn ní ipò.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.23",
            "verseOrgIds": [
              "JOB.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àyà rẹ̀ dúró gbagidi bí òkúta,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.24",
            "verseOrgIds": [
              "JOB.41.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:24"
      },
      "items": [
        {
          "text": "àní, ó le bi ìyá ọlọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.24",
            "verseOrgIds": [
              "JOB.41.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó bá gbé ara rẹ̀ sókè, àwọn alágbára bẹ̀rù;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.25",
            "verseOrgIds": [
              "JOB.41.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:25"
      },
      "items": [
        {
          "text": "nítorí ìbẹ̀rù ńlá, wọ́n dààmú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.25",
            "verseOrgIds": [
              "JOB.41.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀kọ̀ tàbí idà, tàbí ọfà,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.26",
            "verseOrgIds": [
              "JOB.41.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:26"
      },
      "items": [
        {
          "text": "ẹni tí ó ṣá a kò lè rán an.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.26",
            "verseOrgIds": [
              "JOB.41.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 41:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ká irin sí ibi koríko gbígbẹ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.27",
            "verseOrgIds": [
              "JOB.41.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:27"
      },
      "items": [
        {
          "text": "àti idẹ si bi igi híhù.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.27",
            "verseOrgIds": [
              "JOB.41.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 41:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọfà kò lè mú un sá;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.28",
            "verseOrgIds": [
              "JOB.41.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:28"
      },
      "items": [
        {
          "text": "òkúta kànnakánná lọ́dọ̀ rẹ̀ dàbí àgékù koríko.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.28",
            "verseOrgIds": [
              "JOB.41.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 41:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ka ẹṣin sí bí àgékù ìdì koríko;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.29",
            "verseOrgIds": [
              "JOB.41.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:29"
      },
      "items": [
        {
          "text": "ó rẹ́rìn-ín sí mímì ọ̀kọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.29",
            "verseOrgIds": [
              "JOB.41.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 41:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òkúta mímú ń bẹ nísàlẹ̀ abẹ́ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.30",
            "verseOrgIds": [
              "JOB.41.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:30"
      },
      "items": [
        {
          "text": "ó sì tẹ́ ohun mímú ṣóńṣó sórí ẹrẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.30",
            "verseOrgIds": [
              "JOB.41.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 41:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó mú ibú omi hó bí ìkòkò;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.31",
            "verseOrgIds": [
              "JOB.41.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:31"
      },
      "items": [
        {
          "text": "ó sọ̀ agbami òkun dàbí kólòbó ìkunra.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.31",
            "verseOrgIds": [
              "JOB.41.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 41:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó mú ipa ọ̀nà tan lẹ́yìn rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.32",
            "verseOrgIds": [
              "JOB.41.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:32"
      },
      "items": [
        {
          "text": "ènìyàn a máa ka ibú sí ewú arúgbó.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.32",
            "verseOrgIds": [
              "JOB.41.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 41:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lórí ilẹ̀ ayé kò sí ẹni tí ó dàbí rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.33",
            "verseOrgIds": [
              "JOB.41.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:33"
      },
      "items": [
        {
          "text": "tí a dá láìní ìbẹ̀rù.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.33",
            "verseOrgIds": [
              "JOB.41.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 41:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó bojú wo ohun gíga gbogbo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.34",
            "verseOrgIds": [
              "JOB.41.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:34"
      },
      "items": [
        {
          "text": "ó sì nìkan jásí ọba lórí gbogbo àwọn ọmọ ìgbéraga.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.34",
            "verseOrgIds": [
              "JOB.41.26"
            ]
          }
        }
      ]
    }
