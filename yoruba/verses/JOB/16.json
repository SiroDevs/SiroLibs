          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ nísinsin yìí kíyèsi i, ẹlẹ́rìí mi ń bẹ ní ọ̀run,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.19",
            "verseOrgIds": [
              "JOB.16.19"
            ]
          }
        }
      ]
    },
