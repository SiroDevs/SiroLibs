      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:21"
      },
      "items": [
        {
          "text": "bí ènìyàn kan ti í ṣe alágbàwí fún ẹnìkejì rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.21",
            "verseOrgIds": [
              "JOB.16.21"
            ]
