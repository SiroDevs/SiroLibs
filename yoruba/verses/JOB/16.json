          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Háà! Ilẹ̀ ayé, ìwọ má ṣe bò ẹ̀jẹ̀ mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.18",
            "verseOrgIds": [
              "JOB.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:18"
      },
      "items": [
        {
          "text": "kí ẹkún mi má ṣe wà ní ipò kan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.18",
            "verseOrgIds": [
              "JOB.16.18"
            ]
          }
        }
      ]
    },
    {
