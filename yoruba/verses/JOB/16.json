      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:17"
      },
      "items": [
        {
          "text": "àdúrà mi sì mọ́ pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.17",
            "verseOrgIds": [
              "JOB.16.17"
            ]
          }
        }
      ]
