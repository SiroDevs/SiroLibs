      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:19"
      },
      "items": [
        {
          "text": "ẹ̀rí mi sì ń bẹ lókè ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.19",
            "verseOrgIds": [
              "JOB.16.19"
            ]
          }
        }
      ]
    },
