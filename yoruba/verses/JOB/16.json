      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:16"
      },
      "items": [
        {
          "text": "òjìji ikú sì ṣẹ́ sí ìpéǹpéjú mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.16",
            "verseOrgIds": [
              "JOB.16.16"
            ]
          }
        }
      ]
    },
    {
