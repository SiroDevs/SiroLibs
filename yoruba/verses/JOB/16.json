          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí nígbà tí iye ọdún díẹ̀ rékọjá tán,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.22",
            "verseOrgIds": [
              "JOB.16.22"
            ]
