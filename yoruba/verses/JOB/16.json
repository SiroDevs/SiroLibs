              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìbá ṣe pé ẹnìkan le è máa ṣe alágbàwí fún ẹnìkejì lọ́dọ̀ Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.21",
            "verseOrgIds": [
              "JOB.16.21"
            ]
          }
        }
      ]
    },
