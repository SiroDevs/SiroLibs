          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀rẹ́ mi ń fi mí ṣẹ̀sín,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.20",
            "verseOrgIds": [
              "JOB.16.20"
            ]
          }
        }
