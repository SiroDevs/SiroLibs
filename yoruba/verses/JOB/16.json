          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kì í ṣe nítorí àìṣòótọ́ kan ní ọwọ́ mi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.17",
            "verseOrgIds": [
              "JOB.16.17"
            ]
          }
        }
      ]
    },
