      "attrs": {
        "style": "q2",
        "vid": "JOB 16:20"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ojú mi ń da omijé sọ́dọ̀ Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.20",
            "verseOrgIds": [
              "JOB.16.20"
            ]
          }
        }
