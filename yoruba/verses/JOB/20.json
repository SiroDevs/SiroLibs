          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ìpín ènìyàn búburú láti ọ̀dọ̀ Ọlọ́run wá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.29",
            "verseOrgIds": [
              "JOB.20.29"
            ]
          }
        }
      ]
    },
