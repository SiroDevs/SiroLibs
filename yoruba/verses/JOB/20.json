      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:24"
      },
      "items": [
        {
          "text": "ọrun akọ irin ní yóò ta a po yọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.24",
            "verseOrgIds": [
              "JOB.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
