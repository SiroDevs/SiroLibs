          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "òkùnkùn biribiri ní a ti pamọ́ fún ìṣúra rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.26",
            "verseOrgIds": [
              "JOB.20.26"
            ]
          }
        }
      ]
    },
    {
