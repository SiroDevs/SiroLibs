      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:29"
      },
      "items": [
        {
          "text": "àti ogún tí a yàn sílẹ̀ fún un láti ọ̀dọ̀ Ọlọ́run.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.29",
            "verseOrgIds": [
              "JOB.20.29"
            ]
