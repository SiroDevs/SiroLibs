          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi o tilẹ̀ sá kúrò lọ́wọ́ ohun ìjà ìrìn;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.24",
            "verseOrgIds": [
              "JOB.20.24"
            ]
          }
        }
      ]
    },
