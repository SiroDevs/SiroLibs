            "number": "23",
            "style": "v",
            "sid": "JOB 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò sì ṣe, nígbà tí ó bá fẹ́ jẹun,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.23",
            "verseOrgIds": [
              "JOB.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:23"
      },
      "items": [
        {
          "text": "Ọlọ́run yóò fà ríru ìbínú rẹ̀ sí í lórí, nígbà tó bá ń jẹun lọ́wọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.23",
            "verseOrgIds": [
              "JOB.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:23"
      },
      "items": [
        {
          "text": "yóò sì rọ òjò ìbínú rẹ̀ lé e lórí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.23",
            "verseOrgIds": [
              "JOB.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
