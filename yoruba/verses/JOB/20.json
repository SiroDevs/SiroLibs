      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 20:26"
      },
      "items": [
        {
          "text": "Iná ti a kò fẹ́ ní yóò jó o run",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.26",
            "verseOrgIds": [
              "JOB.20.26"
            ]
          }
        }
      ]
    },
