          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú ànító rẹ̀, ìdààmú yóò dé bá a;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.22",
            "verseOrgIds": [
              "JOB.20.22"
            ]
          }
        }
      ]
    },
