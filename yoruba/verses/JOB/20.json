  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "JOB 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdáhùn Sofari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbà náà ní Sofari, ará Naama dáhùn, ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.1",
            "verseOrgIds": [
              "JOB.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà ní ìrò inú mi dá mi lóhùn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.2",
            "verseOrgIds": [
              "JOB.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:2"
      },
      "items": [
        {
          "text": "àti nítorí èyí náà ní mo sì yára si gidigidi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.2",
            "verseOrgIds": [
              "JOB.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo ti gbọ́ ẹ̀san ẹ̀gàn mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.3",
            "verseOrgIds": [
              "JOB.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:3"
      },
      "items": [
        {
          "text": "ẹ̀mí òye mi sì dá mi lóhùn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.3",
            "verseOrgIds": [
              "JOB.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ kò mọ̀ èyí rí ní ìgbà àtijọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.4",
            "verseOrgIds": [
              "JOB.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:4"
      },
      "items": [
        {
          "text": "láti ìgbà tí a sọ ènìyàn lọ́jọ̀ sílé ayé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.4",
            "verseOrgIds": [
              "JOB.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "pé, orin ayọ̀ ènìyàn búburú, ìgbà kúkúrú ni,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.5",
            "verseOrgIds": [
              "JOB.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:5"
      },
      "items": [
        {
          "text": "àti pé, ní ìṣẹ́jú kan ní ayọ̀ àgàbàgebè?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.5",
            "verseOrgIds": [
              "JOB.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọláńlá rẹ̀ tilẹ̀ gòkè dé ọ̀run,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.6",
            "verseOrgIds": [
              "JOB.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:6"
      },
      "items": [
        {
          "text": "ti orí rẹ̀ sì kan àwọsánmọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.6",
            "verseOrgIds": [
              "JOB.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n yóò ṣègbé láéláé bí ìgbẹ́ ara rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.7",
            "verseOrgIds": [
              "JOB.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:7"
      },
      "items": [
        {
          "text": "àwọn tí ó ti rí i rí yóò wí pé, 'Òun ha dà?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.7",
            "verseOrgIds": [
              "JOB.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò fò lọ bí àlá, a kì yóò sì rí i,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.8",
            "verseOrgIds": [
              "JOB.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:8"
      },
      "items": [
        {
          "text": "àní a ó lé e lọ bi ìran òru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.8",
            "verseOrgIds": [
              "JOB.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojú tí ó ti rí i rí kì yóò sì rí i mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.9",
            "verseOrgIds": [
              "JOB.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:9"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni ibùjókòó rẹ̀ kì yóò sì ri i mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.9",
            "verseOrgIds": [
              "JOB.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ rẹ̀ yóò máa wá àti rí ojúrere lọ́dọ̀ tálákà,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.10",
            "verseOrgIds": [
              "JOB.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:10"
      },
      "items": [
        {
          "text": "ọwọ́ rẹ̀ yóò sì kó ọrọ̀ wọn padà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.10",
            "verseOrgIds": [
              "JOB.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egungun rẹ̀ kún fún agbára ìgbà èwe rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.11",
            "verseOrgIds": [
              "JOB.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:11"
      },
      "items": [
        {
          "text": "tí yóò bá a dùbúlẹ̀ nínú erùpẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.11",
            "verseOrgIds": [
              "JOB.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ìwà búburú tilẹ̀ dún ní ẹnu rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.12",
            "verseOrgIds": [
              "JOB.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:12"
      },
      "items": [
        {
          "text": "bí ó tilẹ̀ pa á mọ́ nísàlẹ̀ ahọ́n rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.12",
            "verseOrgIds": [
              "JOB.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí ó tilẹ̀ dá a sì, tí kò si kọ̀ ọ́ sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.13",
            "verseOrgIds": [
              "JOB.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:13"
      },
      "items": [
        {
          "text": "tí ó pa á mọ́ síbẹ̀ ní ẹnu rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.13",
            "verseOrgIds": [
              "JOB.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n oúnjẹ rẹ̀ nínú ikùn rẹ̀ ti yípadà,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.14",
            "verseOrgIds": [
              "JOB.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:14"
      },
      "items": [
        {
          "text": "ó jásí òróró paramọ́lẹ̀ nínú rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.14",
            "verseOrgIds": [
              "JOB.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ti gbé ọrọ̀ mì, yóò sì tún bí i jáde;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.15",
            "verseOrgIds": [
              "JOB.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:15"
      },
      "items": [
        {
          "text": "Ọlọ́run yóò pọ̀ ọ́ yọ jáde láti inú rẹ̀ wá.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.15",
            "verseOrgIds": [
              "JOB.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ti fà oró paramọ́lẹ̀ mú;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.16",
            "verseOrgIds": [
              "JOB.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:16"
      },
      "items": [
        {
          "text": "ahọ́n ejò olóró ní yóò pa á.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.16",
            "verseOrgIds": [
              "JOB.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kì yóò rí odò wọ̀n-ọn-nì,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.17",
            "verseOrgIds": [
              "JOB.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:17"
      },
      "items": [
        {
          "text": "ìṣàn omi, odò tí ń ṣàn fún oyin àti ti òrí-àmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.17",
            "verseOrgIds": [
              "JOB.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohun tí ó ṣiṣẹ́ fún ni yóò mú un padà, kí yóò sì gbé e mì;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.18",
