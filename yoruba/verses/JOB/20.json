      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:25"
      },
      "items": [
        {
          "text": "idà dídán ní ń jáde láti inú òróòro wá.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.25",
            "verseOrgIds": [
              "JOB.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 20:25"
      },
      "items": [
        {
          "text": "Ẹ̀rù ńlá ń bẹ ní ara rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.25",
            "verseOrgIds": [
              "JOB.20.25"
            ]
          }
        }
      ]
    },
