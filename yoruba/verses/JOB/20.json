            "number": "19",
            "style": "v",
            "sid": "JOB 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí ó fi owó rẹ̀ ni tálákà lára, ó sì ti pẹ̀yìndà si wọ́n;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.19",
            "verseOrgIds": [
              "JOB.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:19"
      },
      "items": [
        {
          "text": "nítorí ti ó fi agbára gbé ilé tí òun kò kọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.19",
            "verseOrgIds": [
              "JOB.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
