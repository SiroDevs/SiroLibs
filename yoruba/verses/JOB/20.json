      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:26"
      },
      "items": [
        {
          "text": "yóò sì jẹ èyí tí ó kù nínú àgọ́ rẹ̀ run.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.26",
            "verseOrgIds": [
              "JOB.20.26"
            ]
          }
        }
      ]
    },
