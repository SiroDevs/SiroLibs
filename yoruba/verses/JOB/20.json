        "vid": "JOB 20:18"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ọrọ̀ tí ó ní, kì yóò sì ìgbádùn nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.18",
            "verseOrgIds": [
              "JOB.20.18"
            ]
          }
        }
