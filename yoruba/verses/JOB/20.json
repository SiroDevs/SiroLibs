      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:22"
      },
      "items": [
        {
          "text": "àwọn ènìyàn búburú yóò dáwọ́jọ lé e lórí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.22",
            "verseOrgIds": [
              "JOB.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
