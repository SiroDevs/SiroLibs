      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí òun kò mọ̀ ìwà pẹ̀lẹ́ nínú ara rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.20",
            "verseOrgIds": [
              "JOB.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:20"
      },
      "items": [
        {
          "text": "kì yóò sì gbà nínú èyí tí ọkàn rẹ̀ fẹ́ sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.20",
            "verseOrgIds": [
              "JOB.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
