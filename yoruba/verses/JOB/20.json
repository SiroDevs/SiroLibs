      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:27"
      },
      "items": [
        {
          "text": "ayé yóò sì dìde dúró sí i.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.27",
            "verseOrgIds": [
              "JOB.20.27"
            ]
          }
        }
      ]
    },
