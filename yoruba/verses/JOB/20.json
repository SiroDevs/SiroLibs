      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:21"
      },
      "items": [
        {
          "text": "nítorí náà ọ̀rọ̀ rẹ̀ kì yóò dúró pẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.21",
            "verseOrgIds": [
              "JOB.20.21"
            ]
          }
        }
      ]
    },
    {
