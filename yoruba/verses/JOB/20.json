      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:28"
      },
      "items": [
        {
          "text": "àti ohun ìní rẹ̀ yóò sàn dànù lọ ni ọjọ́ ìbínú Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.28",
            "verseOrgIds": [
              "JOB.20.28"
            ]
          }
