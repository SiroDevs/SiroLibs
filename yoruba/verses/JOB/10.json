  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JOB 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àròyé Jobu Tẹ̀síwájú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Agara ìwà ayé mi dá mi tán;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:1"
      },
      "items": [
        {
          "text": "èmi yóò tú àròyé mi sókè lọ́dọ̀ mi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:1"
      },
      "items": [
        {
          "text": "èmi yóò máa sọ̀rọ̀ nínú kíkorò ìbìnújẹ́ ọkàn mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò wí fún Ọlọ́run pé, má ṣe dá mi lẹ́bi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.2",
            "verseOrgIds": [
              "JOB.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:2"
      },
      "items": [
        {
          "text": "fihàn mí nítorí ìdí ohun tí ìwọ fi ń bá mi jà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.2",
            "verseOrgIds": [
              "JOB.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ha tọ́ tí ìwọ ìbá fi máa ni mí lára,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:3"
      },
      "items": [
        {
          "text": "tí ìwọ ìbá fi máa gan iṣẹ́ ọwọ́ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:3"
      },
      "items": [
        {
          "text": "tí ìwọ yóò fi máa tàn ìmọ́lẹ̀ sí ìmọ̀ ènìyàn búburú?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojú rẹ kì ha ṣe ojú ènìyàn bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.4",
            "verseOrgIds": [
              "JOB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:4"
      },
      "items": [
        {
          "text": "Tàbí ìwọ a máa ríran bí ènìyàn ti í ríran?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.4",
            "verseOrgIds": [
              "JOB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọjọ́ rẹ ha dàbí ọjọ́ ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.5",
            "verseOrgIds": [
              "JOB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:5"
      },
      "items": [
        {
          "text": "ọdún rẹ ha dàbí ọjọ́ ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.5",
            "verseOrgIds": [
              "JOB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí ìwọ fi ń béèrè àìṣedéédéé mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.6",
            "verseOrgIds": [
              "JOB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:6"
      },
      "items": [
        {
          "text": "tí ìwọ sì fi wá ẹ̀ṣẹ̀ mi rí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.6",
            "verseOrgIds": [
              "JOB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ mọ̀ pé èmi kì í ṣe oníwà búburú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.7",
            "verseOrgIds": [
              "JOB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:7"
      },
      "items": [
        {
          "text": "kò sì sí ẹni tí ó le gbà mí kúrò ní ọwọ́ rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.7",
            "verseOrgIds": [
              "JOB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọwọ́ rẹ ni ó mọ mi, tí ó sì da mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.8",
            "verseOrgIds": [
              "JOB.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:8"
      },
      "items": [
        {
          "text": "Síbẹ̀ ìwọ tún yípadà láti jẹ mí run.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.8",
            "verseOrgIds": [
              "JOB.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi bẹ̀ ọ́ rántí pé ìwọ ti mọ mí bí amọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.9",
            "verseOrgIds": [
              "JOB.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:9"
      },
      "items": [
        {
          "text": "Ìwọ yóò ha sì tún mú mi padà lọ sínú erùpẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.9",
            "verseOrgIds": [
              "JOB.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò ha ti tú mí dà jáde bí i wàrà,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.10",
            "verseOrgIds": [
              "JOB.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:10"
      },
      "items": [
        {
          "text": "ìwọ kò sì mú mí dìpọ̀ bí i wàràǹkàṣì?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.10",
            "verseOrgIds": [
              "JOB.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ sá ti fi àwọ̀ ẹran-ara wọ̀ mí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.11",
            "verseOrgIds": [
              "JOB.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:11"
      },
      "items": [
        {
          "text": "ìwọ sì fi egungun àti iṣan ṣọgbà yí mi ká.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.11",
            "verseOrgIds": [
              "JOB.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti fún mi ní ẹ̀mí àti ojúrere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.12",
            "verseOrgIds": [
              "JOB.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:12"
      },
      "items": [
        {
          "text": "ìbẹ̀wò rẹ sì pa ọkàn mi mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.12",
            "verseOrgIds": [
              "JOB.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nǹkan wọ̀nyí ni ìwọ sì ti fi pamọ́ nínú rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.13",
            "verseOrgIds": [
              "JOB.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:13"
      },
      "items": [
        {
          "text": "èmi mọ̀ pé, èyí ń bẹ ní ọkàn rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.13",
            "verseOrgIds": [
              "JOB.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí mo bá ṣẹ̀, nígbà náà ni ìwọ yóò máa ṣọ́ mi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.14",
            "verseOrgIds": [
              "JOB.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:14"
      },
      "items": [
        {
          "text": "ìwọ kì yóò sì dárí àìṣedéédéé mi jì.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.14",
            "verseOrgIds": [
              "JOB.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí mo bá ṣe ẹni búburú, ègbé ni fún mi!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "Bí mo bá sì ṣe ẹni rere, bẹ́ẹ̀ ni èmi kò sì le gbe orí mi sókè,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "èmi dààmú",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "mo si wo ìpọ́njú mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí mo bá gbé orí mi ga, ìwọ ń dẹ mí kiri bi i kìnnìún",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.16",
            "verseOrgIds": [
              "JOB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:16"
      },
      "items": [
        {
          "text": "àti pẹ̀lú, ìwọ a sì fi ara rẹ hàn fún mi ní ìyànjú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.16",
            "verseOrgIds": [
              "JOB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ sì tún mu àwọn ẹlẹ́rìí rẹ dìde sí mi di ọ̀tún",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.17",
            "verseOrgIds": [
              "JOB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:17"
      },
      "items": [
        {
          "text": "ìwọ sì sọ ìrunú rẹ di púpọ̀ sí mi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.17",
            "verseOrgIds": [
              "JOB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:17"
      },
      "items": [
        {
          "text": "àwọn ogun rẹ si dìde sinmi bi igbe omi Òkun.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.17",
            "verseOrgIds": [
              "JOB.10.17"
            ]
          }
        }
      ]
    },
