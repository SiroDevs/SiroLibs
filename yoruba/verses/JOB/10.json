            "style": "v",
            "sid": "JOB 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí kí ni ìwọ ṣe mú mi jáde láti inú wá?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.18",
            "verseOrgIds": [
              "JOB.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:18"
      },
      "items": [
        {
          "text": "Háà! Èmi ìbá kúkú ti kú, ojúkójú kì bá tí rí mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.18",
            "verseOrgIds": [
              "JOB.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí kò bá le jẹ́ pé èmi wà láààyè,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.19",
            "verseOrgIds": [
              "JOB.10.19"
            ]
          }
        }
      ]
    },
