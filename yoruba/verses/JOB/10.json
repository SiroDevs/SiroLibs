      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:21"
      },
      "items": [
        {
          "text": "àní si ilẹ̀ òkùnkùn àti òjìji ikú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.21",
            "verseOrgIds": [
              "JOB.10.21"
            ]
          }
