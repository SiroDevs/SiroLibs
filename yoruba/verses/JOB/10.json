      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:19"
      },
      "items": [
        {
          "text": "à bá ti gbé mi láti inú lọ isà òkú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.19",
            "verseOrgIds": [
              "JOB.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọjọ́ mi kò ha kúrú bí? Rárá!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.20",
            "verseOrgIds": [
              "JOB.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:20"
      },
      "items": [
        {
          "text": "Dáwọ́ dúró, kí ó sì yí padà kúrò lọ́dọ̀ mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.20",
            "verseOrgIds": [
              "JOB.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:20"
      },
      "items": [
        {
          "text": "Nítorí kí èmi lè ni ayọ̀ ní ìṣẹ́jú kan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.20",
            "verseOrgIds": [
              "JOB.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
