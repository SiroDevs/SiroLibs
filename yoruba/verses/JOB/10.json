        "vid": "JOB 10:22"
      },
      "items": [
        {
          "text": "àti ti òjìji ikú àti rúdurùdu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.22",
            "verseOrgIds": [
              "JOB.10.22"
            ]
          }
        }
