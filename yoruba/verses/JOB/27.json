          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn yóò sì ṣápẹ́ sí i lórí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.23",
            "verseOrgIds": [
              "JOB.27.23"
            ]
          }
        }
      ]
    },
