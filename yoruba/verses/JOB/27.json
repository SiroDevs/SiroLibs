      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:23"
      },
      "items": [
        {
          "text": "wọn yóò sì ṣe síọ̀ sí i kúrò ní ipò rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.23",
            "verseOrgIds": [
              "JOB.27.23"
