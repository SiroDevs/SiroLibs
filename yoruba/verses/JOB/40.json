      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:18"
      },
      "items": [
        {
          "text": "Egungun rẹ̀ dàbí ọ̀pá irin.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.18",
            "verseOrgIds": [
              "JOB.40.18"
            ]
          }
        }
      ]
    },
