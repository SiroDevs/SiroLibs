              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó dùbúlẹ̀ lábẹ́ igi lótusì,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.21",
            "verseOrgIds": [
              "JOB.40.21"
