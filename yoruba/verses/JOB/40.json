              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi i, odò ńlá sàn jọjọ, òun kò sálọ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.23",
            "verseOrgIds": [
