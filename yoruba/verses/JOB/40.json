      "attrs": {
        "style": "q2",
        "vid": "JOB 40:21"
      },
      "items": [
        {
          "text": "lábẹ́ eèsún àti ẹrẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.21",
            "verseOrgIds": [
              "JOB.40.21"
            ]
