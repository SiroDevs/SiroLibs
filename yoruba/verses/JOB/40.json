  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
        "style": "c",
        "sid": "JOB 40"
      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jobu rẹ ara rẹ̀ sílẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOB.40.1",
                "verseOrgIds": [
                  "JOB.40.1"
                ]
              }
            }
          ]
        },
        {
          "text": "dá Jobu lóhùn sí pẹ̀lú, ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.1",
            "verseOrgIds": [
              "JOB.40.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹni tí ń bá Olódùmarè wíjọ́ yóò ha kọ ní ẹ̀kọ́?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.2",
            "verseOrgIds": [
              "JOB.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:2"
      },
      "items": [
        {
          "text": "Ẹni tí ń bá Ọlọ́run wí jẹ́ kí ó dáhùn!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.2",
            "verseOrgIds": [
              "JOB.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Jobu dá",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.3",
            "verseOrgIds": [
              "JOB.40.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOB.40.3",
                "verseOrgIds": [
                  "JOB.40.3"
                ]
              }
            }
          ]
        },
        {
          "text": "lóhùn wá ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.3",
            "verseOrgIds": [
              "JOB.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kíyèsi i, ẹ̀gbin ni èmi—ohun kí ni èmi ó dà?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.4",
            "verseOrgIds": [
              "JOB.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:4"
      },
      "items": [
        {
          "text": "Èmi ó fi ọwọ́ mi le ẹnu mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.4",
            "verseOrgIds": [
              "JOB.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀ẹ̀kan ní mo sọ̀rọ̀, ṣùgbọ́n èmi kì yóò tún sọ mọ́;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.5",
            "verseOrgIds": [
              "JOB.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:5"
      },
      "items": [
        {
          "text": "lẹ́ẹ̀kejì ni, èmi kò sì le ṣe é mọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.5",
            "verseOrgIds": [
              "JOB.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ní",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.6",
            "verseOrgIds": [
              "JOB.40.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOB.40.6",
                "verseOrgIds": [
                  "JOB.40.6"
                ]
              }
            }
          ]
        },
        {
          "text": "dá Jobu lóhùn láti inú ìjì àyíká wá, ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.6",
            "verseOrgIds": [
              "JOB.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Di àmùrè gírí ní ẹgbẹ́ rẹ bí ọkùnrin,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.7",
            "verseOrgIds": [
              "JOB.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:7"
      },
      "items": [
        {
          "text": "èmi ó bi ọ léèrè,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.7",
            "verseOrgIds": [
              "JOB.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:7"
      },
      "items": [
        {
          "text": "kí ìwọ kí ó sì dá mi lóhùn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.7",
            "verseOrgIds": [
              "JOB.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ ha fẹ́ mú ìdájọ́ mi di asán?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.8",
            "verseOrgIds": [
              "JOB.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:8"
      },
      "items": [
        {
          "text": "Ìwọ ó sì dá mi lẹ́bi, kí ìwọ lè ṣe olódodo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.8",
            "verseOrgIds": [
              "JOB.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ni apá bí Ọlọ́run",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.9",
            "verseOrgIds": [
              "JOB.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:9"
      },
      "items": [
        {
          "text": "tàbí ìwọ lè fi ohùn sán àrá bí òun?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.9",
            "verseOrgIds": [
              "JOB.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fi ọláńlá àti ọlá ìtayọ rẹ̀ ṣe ara rẹ ní ọ̀ṣọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.10",
            "verseOrgIds": [
              "JOB.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:10"
      },
      "items": [
        {
          "text": "tí ó sì fi ògo àti títóbi ọ̀ṣọ́ bo ara ní aṣọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.10",
            "verseOrgIds": [
              "JOB.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mú ìrunú ìbínú rẹ jáde;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.11",
            "verseOrgIds": [
              "JOB.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:11"
      },
      "items": [
        {
          "text": "kíyèsí gbogbo ìwà ìgbéraga rẹ kí o sì rẹ̀ ẹ́ sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.11",
            "verseOrgIds": [
              "JOB.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wo gbogbo ìwà ìgbéraga, ènìyàn kí o sì rẹ ẹ sílẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.12",
            "verseOrgIds": [
              "JOB.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:12"
      },
      "items": [
        {
          "text": "kí o sì tẹ ènìyàn búburú mọ́lẹ̀ ní ipò wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.12",
            "verseOrgIds": [
              "JOB.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sin gbogbo wọn papọ̀ nínú erùpẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.13",
            "verseOrgIds": [
              "JOB.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:13"
      },
      "items": [
        {
          "text": "kí o sì di ojú ìkọ̀kọ̀ wọn ní isà òkú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.13",
            "verseOrgIds": [
              "JOB.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ní èmi ó yìn ọ́ pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.14",
            "verseOrgIds": [
              "JOB.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:14"
      },
      "items": [
        {
          "text": "ọwọ́ ọ̀tún ara rẹ lè gbà ọ́ là.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.14",
            "verseOrgIds": [
              "JOB.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ǹjẹ́ nísinsin yìí kíyèsi Behemoti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.15",
            "verseOrgIds": [
              "JOB.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:15"
      },
      "items": [
        {
          "text": "tí mo dá pẹ̀lú rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.15",
            "verseOrgIds": [
              "JOB.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:15"
      },
      "items": [
        {
          "text": "òun a máa jẹ koríko bí ọ̀dá màlúù.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.15",
            "verseOrgIds": [
              "JOB.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wò o nísinsin yìí, agbára rẹ wà ní ẹ̀gbẹ́ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.16",
            "verseOrgIds": [
              "JOB.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:16"
      },
      "items": [
        {
          "text": "àti ipa rẹ nínú ìṣàn ìkún rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.16",
            "verseOrgIds": [
              "JOB.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun a máa jù ìrù rẹ̀ bí i igi kedari,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.17",
            "verseOrgIds": [
              "JOB.40.17"
            ]
          }
        }
      ]
    },
