      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:19"
      },
      "items": [
        {
          "text": "síbẹ̀ Ẹlẹ́dàá rẹ̀ fi idà rẹ̀ lé e lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.19",
            "verseOrgIds": [
              "JOB.40.19"
            ]
          }
        }
      ]
    },
