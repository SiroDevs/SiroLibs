        "vid": "JOB 40:23"
      },
      "items": [
        {
          "text": "ó wà láìléwu bí ó bá ṣe pé odò Jordani ti ṣàn lọ sí ẹnu rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.23",
