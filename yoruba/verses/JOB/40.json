      "attrs": {
        "style": "q2",
        "vid": "JOB 40:22"
      },
      "items": [
        {
          "text": "igi arọrọ odò yí i káàkiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.22",
            "verseOrgIds": [
              "JOB.40.22"
            ]
          }
