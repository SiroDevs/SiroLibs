          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igi lótusì síji wọn bò o;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.22",
            "verseOrgIds": [
              "JOB.40.22"
