      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:20"
      },
      "items": [
        {
          "text": "níbi tí gbogbo ẹranko igbó máa ṣiré ní ẹ̀gbẹ́ ibẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.20",
            "verseOrgIds": [
