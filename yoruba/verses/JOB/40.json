          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́ òkè ńlá ńlá ní i mu ohun jíjẹ fún un wá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.20",
            "verseOrgIds": [
              "JOB.40.20"
            ]
          }
        }
