      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"A sì nà án lórí ibùsùn ìrora rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.19",
            "verseOrgIds": [
              "JOB.33.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:19"
      },
      "items": [
        {
          "text": "pẹ̀lúpẹ̀lú a fi ìjà egungun rẹ̀ ti ó dúró pẹ́ nà án,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.19",
            "verseOrgIds": [
              "JOB.33.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "bẹ́ẹ̀ ni ẹ̀mí rẹ kọ oúnjẹ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.20",
            "verseOrgIds": [
              "JOB.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:20"
      },
      "items": [
        {
          "text": "ọkàn rẹ̀ sì kọ oúnjẹ dídùn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.20",
            "verseOrgIds": [
              "JOB.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹran-ara rẹ̀ run, títí a kò sì fi lè rí i mọ́",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.21",
            "verseOrgIds": [
              "JOB.33.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:21"
      },
      "items": [
        {
          "text": "egungun rẹ̀ tí a kò tí rí sì ta jáde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.21",
            "verseOrgIds": [
              "JOB.33.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àní, ọkàn rẹ̀ sì súnmọ́ isà òkú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.22",
            "verseOrgIds": [
              "JOB.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:22"
      },
      "items": [
        {
          "text": "ẹ̀mí rẹ̀ sì súnmọ́ ọ̀dọ̀ àwọn ìránṣẹ́ ikú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.22",
            "verseOrgIds": [
              "JOB.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí angẹli kan ba wà lọ́dọ̀ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.23",
            "verseOrgIds": [
              "JOB.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:23"
      },
      "items": [
        {
          "text": "ẹni tí ń ṣe alágbàwí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.23",
            "verseOrgIds": [
              "JOB.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:23"
      },
      "items": [
        {
          "text": "ọ̀kan nínú ẹgbẹ̀rún (1,000) láti fi ọ̀nà pípé hàn ni,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.23",
            "verseOrgIds": [
              "JOB.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà ni ó ṣe oore-ọ̀fẹ́ fún un ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:24"
      },
      "items": [
        {
          "text": "gbà á kúrò nínú lílọ sínú isà òkú;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:24"
      },
      "items": [
        {
          "text": "èmi ti rà á padà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ara rẹ̀ yóò sì di ọ̀tun bí i ti ọmọ kékeré,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.25",
            "verseOrgIds": [
              "JOB.33.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:25"
      },
      "items": [
        {
          "text": "yóò sì tún padà sí ọjọ́ ìgbà èwe rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.25",
            "verseOrgIds": [
              "JOB.33.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó gbàdúrà sọ́dọ̀ Ọlọ́run, òun sì ṣe ojúrere rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.26",
            "verseOrgIds": [
              "JOB.33.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:26"
      },
      "items": [
        {
          "text": "o sì rí ojú rẹ̀ pẹ̀lú ayọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.26",
            "verseOrgIds": [
              "JOB.33.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:26"
      },
      "items": [
        {
          "text": "òhun o san òdodo rẹ̀ padà fún ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.26",
            "verseOrgIds": [
              "JOB.33.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 33:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó wá sọ́dọ̀ ènìyàn ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:27"
      },
      "items": [
        {
          "text": "'Èmi ṣẹ̀, kò sì ṣí èyí tí o tọ́, mo sì ti yí èyí tí ó tọ́ po,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:27"
      },
      "items": [
        {
          "text": "a kò sì san ẹ̀san rẹ̀ fún mi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 33:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run ti gba ọkàn mi kúrò nínú lílọ sínú ihò,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.28",
            "verseOrgIds": [
              "JOB.33.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:28"
      },
      "items": [
        {
          "text": "ẹ̀mí mi yóò wà láti jẹ adùn ìmọ́lẹ̀ ayé.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.28",
            "verseOrgIds": [
              "JOB.33.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 33:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wò ó! Nǹkan wọ̀nyí ni Ọlọ́run",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.29",
            "verseOrgIds": [
              "JOB.33.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:29"
      },
      "items": [
        {
          "text": "máa ń ṣe fún ènìyàn nígbà méjì àti nígbà mẹ́ta,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.29",
            "verseOrgIds": [
              "JOB.33.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 33:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "láti mú ọkàn rẹ padà kúrò nínú isà òkú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.30",
            "verseOrgIds": [
              "JOB.33.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:30"
      },
      "items": [
        {
          "text": "láti fi ìmọ́lẹ̀ alààyè han sí i.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.30",
            "verseOrgIds": [
              "JOB.33.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 33:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jobu, kíyèsi i gidigidi, kí o sì fetí sí mi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.31",
            "verseOrgIds": [
              "JOB.33.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:31"
      },
      "items": [
        {
          "text": "pa ẹnu rẹ mọ́, èmi ó sì máa sọ ọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.31",
            "verseOrgIds": [
              "JOB.33.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 33:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá sì ní ohun wí, dá mi lóhùn;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.32",
            "verseOrgIds": [
              "JOB.33.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:32"
      },
      "items": [
        {
          "text": "máa sọ, nítorí pé èmi fẹ́ dá ọ láre.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.32",
            "verseOrgIds": [
              "JOB.33.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 33:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí bẹ́ẹ̀ kọ́, gbọ́ tèmi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.33",
            "verseOrgIds": [
              "JOB.33.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:33"
      },
      "items": [
        {
          "text": "pa ẹnu rẹ mọ́, èmi ó sì kọ́ ọ ní ọgbọ́n.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.33",
            "verseOrgIds": [
              "JOB.33.33"
            ]
          }
        }
      ]
    }
  ],
