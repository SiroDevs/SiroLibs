  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "JOB 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdáhùn Jobu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jobu sì dáhùn wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.1",
            "verseOrgIds": [
              "JOB.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Báwo ni ìwọ ń ṣe ìrànlọ́wọ́ ẹni tí kò ní ipá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.2",
            "verseOrgIds": [
              "JOB.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:2"
      },
      "items": [
        {
          "text": "báwo ní ìwọ ń ṣe gbe apá ẹni tí kò ní agbára?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.2",
            "verseOrgIds": [
              "JOB.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báwo ni ìwọ ń ṣe ìgbìmọ̀ fun ẹni tí kò ní ọgbọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.3",
            "verseOrgIds": [
              "JOB.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:3"
      },
      "items": [
        {
          "text": "tàbí báwo òye rẹ to pọ to bẹ́ẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.3",
            "verseOrgIds": [
              "JOB.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó ràn ọ́ lọ́wọ́ láti sọ àwọn ọ̀rọ̀ wọ̀nyí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.4",
            "verseOrgIds": [
              "JOB.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:4"
      },
      "items": [
        {
          "text": "àti ẹ̀mí ta ni ó gba ẹnu rẹ sọ̀rọ̀?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.4",
            "verseOrgIds": [
              "JOB.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àwọn aláìlágbára ti isà òkú wárìrì,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.5",
            "verseOrgIds": [
              "JOB.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:5"
      },
      "items": [
        {
          "text": "lábẹ́ omi pẹ̀lú àwọn tí ń gbé inú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.5",
            "verseOrgIds": [
              "JOB.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìhòhò ni ipò òkú níwájú Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.6",
            "verseOrgIds": [
              "JOB.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:6"
      },
      "items": [
        {
          "text": "ibi ìparun kò sí ní ibojì.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.6",
            "verseOrgIds": [
              "JOB.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ní o nà ìhà àríwá ọ̀run ní ibi òfúrufú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.7",
            "verseOrgIds": [
              "JOB.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:7"
      },
      "items": [
        {
          "text": "ó sì so ayé rọ̀ ní ojú asán.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.7",
            "verseOrgIds": [
              "JOB.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó di omi pọ̀ nínú ìkùùkuu àwọsánmọ̀ rẹ̀ tí ó nípọn;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.8",
            "verseOrgIds": [
              "JOB.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:8"
      },
      "items": [
        {
          "text": "àwọsánmọ̀ kò sì ya nísàlẹ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.8",
            "verseOrgIds": [
              "JOB.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì fa ojú ìtẹ́ rẹ̀ sẹ́yìn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.9",
            "verseOrgIds": [
              "JOB.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:9"
      },
      "items": [
        {
          "text": "ó sì tẹ àwọsánmọ̀ rẹ̀ sí i lórí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.9",
            "verseOrgIds": [
              "JOB.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó fi ìdè yí omi òkun ká,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.10",
            "verseOrgIds": [
              "JOB.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:10"
      },
      "items": [
        {
          "text": "títí dé ààlà ìmọ́lẹ̀ àti òkùnkùn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.10",
            "verseOrgIds": [
              "JOB.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀wọ́n òpó ọ̀run wárìrì,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.11",
            "verseOrgIds": [
              "JOB.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:11"
      },
      "items": [
        {
          "text": "ẹnu sì yà wọ́n sì ìbáwí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.11",
            "verseOrgIds": [
              "JOB.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó fi ipá rẹ̀ dààmú omi Òkun;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.12",
            "verseOrgIds": [
              "JOB.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:12"
      },
      "items": [
        {
          "text": "nípa òye rẹ̀, ó gé agbéraga sí wẹ́wẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.12",
            "verseOrgIds": [
              "JOB.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa ẹ̀mí rẹ̀ ni ó ti ṣe ọ̀run ní ọ̀ṣọ́;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.13",
            "verseOrgIds": [
              "JOB.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:13"
      },
      "items": [
        {
          "text": "ọwọ́ rẹ̀ ni ó fi dá ejò wíwọ́ nì.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.13",
            "verseOrgIds": [
              "JOB.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi i, èyí ní òpin ọ̀nà rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:14"
      },
      "items": [
        {
          "text": "ohùn èyí tí a gbọ́ ti kéré tó!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:14"
      },
      "items": [
        {
          "text": "Ta ni ẹni náà tí òye àrá agbára rẹ̀ lè yé?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "JOB.27",
