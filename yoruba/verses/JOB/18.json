  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JOB 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdáhùn Bilidadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbà náà ni Bilidadi, ará Ṣuhi, dáhùn, ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.1",
            "verseOrgIds": [
              "JOB.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà wo ni ẹ̀yin yóò tó fi ìdí ọ̀rọ̀ tì;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.2",
            "verseOrgIds": [
              "JOB.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:2"
      },
      "items": [
        {
          "text": "ẹ rò ó, nígbẹ̀yìn rẹ̀ ni àwa ó tó máa sọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.2",
            "verseOrgIds": [
              "JOB.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí kí ni a ṣe ń kà wá sí bí ẹranko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.3",
            "verseOrgIds": [
              "JOB.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:3"
      },
      "items": [
        {
          "text": "tí a sì ń kà wá si bí ẹni ẹ̀gàn ní ojú yín?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.3",
            "verseOrgIds": [
              "JOB.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ fa ara rẹ ya pẹ́rẹpẹ̀rẹ nínú ìbínú rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:4"
      },
      "items": [
        {
          "text": "kí a ha kọ ayé sílẹ̀ nítorí rẹ̀ bi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:4"
      },
      "items": [
        {
          "text": "Tàbí kí a sí àpáta kúrò ní ipò rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítòótọ́ ìmọ́lẹ̀ ènìyàn búburú ni a ó pa kúrò,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.5",
            "verseOrgIds": [
              "JOB.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:5"
      },
      "items": [
        {
          "text": "ọ̀wọ́-iná rẹ̀ kì yóò sì tan ìmọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.5",
            "verseOrgIds": [
              "JOB.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìmọ́lẹ̀ yóò di òkùnkùn nínú àgọ́ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.6",
            "verseOrgIds": [
              "JOB.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:6"
      },
      "items": [
        {
          "text": "fìtílà ẹ̀gbẹ́ rẹ̀ ni a ó sì pa pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.6",
            "verseOrgIds": [
              "JOB.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìrìn ẹsẹ̀ agbára rẹ̀ yóò di fífọ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.7",
            "verseOrgIds": [
              "JOB.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:7"
      },
      "items": [
        {
          "text": "ète òun tìkára rẹ̀ ni yóò bí i ṣubú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.7",
            "verseOrgIds": [
              "JOB.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa ẹ̀ṣẹ̀ òun tìkára rẹ̀ ó ti bọ́ sínú àwọ̀n,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.8",
            "verseOrgIds": [
              "JOB.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:8"
      },
      "items": [
        {
          "text": "ó sì rìn lórí okùn dídẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.8",
            "verseOrgIds": [
              "JOB.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tàkúté ni yóò mú un ní gìgísẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.9",
            "verseOrgIds": [
              "JOB.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:9"
      },
      "items": [
        {
          "text": "àwọn àwọ̀n tí a dẹ yóò sì ṣẹ́gun rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.9",
            "verseOrgIds": [
              "JOB.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A dẹkùn sílẹ̀ fún un lórí ilẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.10",
            "verseOrgIds": [
              "JOB.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:10"
      },
      "items": [
        {
          "text": "a sì wà ọ̀fìn fún un lójú ọ̀nà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.10",
            "verseOrgIds": [
              "JOB.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀rù ńlá yóò bà á ní ìhà gbogbo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.11",
            "verseOrgIds": [
              "JOB.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:11"
      },
      "items": [
        {
          "text": "yóò sì lé e dé ẹsẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.11",
            "verseOrgIds": [
              "JOB.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àìlera rẹ̀ yóò di púpọ̀ fún ebi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.12",
            "verseOrgIds": [
              "JOB.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:12"
      },
      "items": [
        {
          "text": "ìparun yóò dìde dúró sí i nígbà tí ó bá ṣubú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.12",
            "verseOrgIds": [
              "JOB.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò jẹ ẹ̀yà ara rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.13",
            "verseOrgIds": [
              "JOB.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:13"
      },
      "items": [
        {
          "text": "ikú àkọ́bí ni yóò jẹ agbára rẹ̀ run.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.13",
            "verseOrgIds": [
              "JOB.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ó fà á tu kúrò nínú àgọ́ tí ó gbẹ́kẹ̀lé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.14",
            "verseOrgIds": [
              "JOB.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:14"
      },
      "items": [
        {
          "text": "a ó sì mú un tọ ọba ẹ̀rù ńlá nì lọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.14",
            "verseOrgIds": [
              "JOB.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò sì máa jókòó nínú àgọ́ rẹ̀ èyí tí í ṣe tirẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.15",
            "verseOrgIds": [
              "JOB.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:15"
      },
      "items": [
        {
          "text": "sulfuru ti o jóná ni a ó fún káàkiri ibùgbé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.15",
            "verseOrgIds": [
              "JOB.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbòǹgbò rẹ̀ yóò gbẹ níṣàlẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.16",
            "verseOrgIds": [
              "JOB.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:16"
      },
      "items": [
        {
          "text": "a ó sì ké ẹ̀ka rẹ̀ kúrò lókè.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.16",
            "verseOrgIds": [
              "JOB.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìrántí rẹ̀ yóò parun kúrò ni ayé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.17",
            "verseOrgIds": [
              "JOB.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:17"
      },
      "items": [
        {
          "text": "kì yóò sí orúkọ rẹ̀ ní ìgboro ìlú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.17",
            "verseOrgIds": [
              "JOB.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
