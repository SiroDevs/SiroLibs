  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "JOB 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwíjàre Jobu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mo ti bá ojú mi dá májẹ̀mú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.1",
            "verseOrgIds": [
              "JOB.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:1"
      },
      "items": [
        {
          "text": "èmi yó ha ṣe tẹjúmọ́ wúńdíá?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.1",
            "verseOrgIds": [
              "JOB.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé kí ni ìpín Ọlọ́run láti ọ̀run wá?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.2",
            "verseOrgIds": [
              "JOB.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:2"
      },
      "items": [
        {
          "text": "Tàbí kí ni ogún Olódùmarè láti òkè ọ̀run wá.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.2",
            "verseOrgIds": [
              "JOB.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò ṣe pé àwọn ènìyàn búburú ni ìparun wà fún,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.3",
            "verseOrgIds": [
              "JOB.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:3"
      },
      "items": [
        {
          "text": "àti àjàkálẹ̀-ààrùn fún àwọn oníṣẹ́ ẹ̀ṣẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.3",
            "verseOrgIds": [
              "JOB.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun kò ha ri ipa ọ̀nà mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.4",
            "verseOrgIds": [
              "JOB.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:4"
      },
      "items": [
        {
          "text": "òun kò ha sì ka gbogbo ìṣísẹ̀ mi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.4",
            "verseOrgIds": [
              "JOB.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ó bá ṣe pé èmi bá fi àìṣòótọ́ rìn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.5",
            "verseOrgIds": [
              "JOB.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:5"
      },
      "items": [
        {
          "text": "tàbí tí ẹsẹ̀ mi sì yára sí ẹ̀tàn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.5",
            "verseOrgIds": [
              "JOB.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "(jẹ́ kí Ọlọ́run wọ́n mí nínú ìwọ̀n òdodo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.6",
            "verseOrgIds": [
              "JOB.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:6"
      },
      "items": [
        {
          "text": "kí Ọlọ́run le mọ ìdúró ṣinṣin mi.)",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.6",
            "verseOrgIds": [
              "JOB.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹsẹ̀ mí bá yà kúrò lójú ọ̀nà,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:7"
      },
      "items": [
        {
          "text": "tí àyà mí sì tẹ̀lé ipa ojú mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:7"
      },
      "items": [
        {
          "text": "tàbí bí àbàwọ́n kan bá sì lẹ̀ mọ́ mi ní ọwọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ǹjẹ́ kí èmi kí ó gbìn kí ẹlòmíràn kí ó sì mújẹ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.8",
            "verseOrgIds": [
              "JOB.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:8"
      },
      "items": [
        {
          "text": "àní kí a fa irú-ọmọ mi tu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.8",
            "verseOrgIds": [
              "JOB.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí àyà mi bá di fífà sí ipasẹ̀ obìnrin kan,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.9",
            "verseOrgIds": [
              "JOB.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:9"
      },
      "items": [
        {
          "text": "tàbí bí mo bá lọ í ba de ènìyàn ní ẹnu-ọ̀nà ilé aládùúgbò mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.9",
            "verseOrgIds": [
              "JOB.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí àyà mi kí ó lọ ọlọ fún ẹlòmíràn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.10",
            "verseOrgIds": [
              "JOB.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:10"
      },
      "items": [
        {
          "text": "kí àwọn ẹlòmíràn kí ó tẹ̀ ara wọn ní ara rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.10",
            "verseOrgIds": [
              "JOB.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé yóò jẹ́ ohun ìtìjú àní,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.11",
            "verseOrgIds": [
              "JOB.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:11"
      },
      "items": [
        {
          "text": "ẹ̀ṣẹ̀ tí a ó ṣe onídàájọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.11",
            "verseOrgIds": [
              "JOB.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé iná ní èyí tí ó jó dé ibi ìparun,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.12",
            "verseOrgIds": [
              "JOB.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:12"
      },
      "items": [
        {
          "text": "tí ìbá sì fa gbòǹgbò ohun ìbísí mi gbogbo tu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.12",
            "verseOrgIds": [
              "JOB.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tí mo bá sì ṣe àìka ọ̀ràn ìránṣẹ́kùnrin mi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.13",
            "verseOrgIds": [
              "JOB.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:13"
      },
      "items": [
        {
          "text": "tàbí ìránṣẹ́bìnrin mi sí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.13",
            "verseOrgIds": [
              "JOB.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:13"
      },
      "items": [
        {
          "text": "nígbà tí wọ́n bá ń bá mi jà;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.13",
            "verseOrgIds": [
              "JOB.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí ni èmi ó ha ṣe nígbà tí Ọlọ́run bá dìde?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.14",
            "verseOrgIds": [
              "JOB.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:14"
      },
      "items": [
        {
          "text": "Nígbà tí ó bá sì ṣe ìbẹ̀wò, ohùn kí ni èmi ó dá?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.14",
            "verseOrgIds": [
              "JOB.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó dá mi ní inú kọ́ ni ó dá a?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.15",
            "verseOrgIds": [
              "JOB.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:15"
      },
      "items": [
        {
          "text": "Ẹnìkan náà kí ó mọ wá ní inú ìyá wa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.15",
            "verseOrgIds": [
              "JOB.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí mo bá fa ọwọ́ sẹ́yìn fún ìfẹ́ inú tálákà,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.16",
            "verseOrgIds": [
              "JOB.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:16"
      },
      "items": [
        {
          "text": "tàbí bí mo bá sì mú kí ojú opó rẹ̀wẹ̀sì,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.16",
            "verseOrgIds": [
              "JOB.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "tàbí tí mo bá nìkan bu òkèlè mi jẹ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.17",
            "verseOrgIds": [
              "JOB.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:17"
      },
      "items": [
        {
          "text": "tí aláìní baba kò jẹ nínú rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.17",
            "verseOrgIds": [
              "JOB.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí pé láti ìgbà èwe mi wá ni a ti tọ́ ọ dàgbà pẹ̀lú mi bí ẹni pé baba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.18",
            "verseOrgIds": [
              "JOB.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:18"
      },
      "items": [
        {
          "text": "èmi sì ń ṣe ìtọ́jú opó láti inú ìyá mi wá:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.18",
            "verseOrgIds": [
              "JOB.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí èmi bá rí olùpọ́njú láìní aṣọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.19",
            "verseOrgIds": [
              "JOB.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:19"
      },
      "items": [
        {
          "text": "tàbí tálákà kan láìní ìbora;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.19",
            "verseOrgIds": [
              "JOB.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí ọkàn rẹ̀ kò bá súre fún mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.20",
            "verseOrgIds": [
              "JOB.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:20"
      },
      "items": [
        {
          "text": "tàbí bí ara rẹ̀ kò sì gbóná nípasẹ̀ irun àgùntàn mi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.20",
            "verseOrgIds": [
              "JOB.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí mo bá sì gbé ọwọ́ mi sókè sí aláìní baba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.21",
            "verseOrgIds": [
              "JOB.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:21"
      },
      "items": [
        {
          "text": "nítorí pé mo rí ìrànlọ́wọ́ mi ní ẹnu ibodè,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.21",
            "verseOrgIds": [
              "JOB.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ǹjẹ́, ní apá mi kí o wọ́n kúrò ní ihò èjìká rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.22",
            "verseOrgIds": [
              "JOB.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:22"
      },
      "items": [
        {
          "text": "kí apá mi kí ó sì ṣẹ́ láti egungun rẹ̀ wá.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.22",
            "verseOrgIds": [
              "JOB.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ìparun láti ọ̀dọ̀ Ọlọ́run wá ni ẹ̀rù ńlá fún mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.23",
            "verseOrgIds": [
              "JOB.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:23"
      },
      "items": [
        {
          "text": "àti nítorí ọláńlá rẹ̀ èmi kò le è dúró.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.23",
            "verseOrgIds": [
              "JOB.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ó bá ṣe pé mo fi wúrà ṣe ìgbẹ́kẹ̀lé mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.24",
            "verseOrgIds": [
              "JOB.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:24"
      },
      "items": [
        {
          "text": "tàbí tí mo bá wí fún fàdákà dídára pé, 'Ìwọ ni ààbò mi,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.24",
            "verseOrgIds": [
              "JOB.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí mo bá yọ̀ nítorí ọrọ̀ mí pọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.25",
            "verseOrgIds": [
              "JOB.31.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:25"
      },
      "items": [
        {
          "text": "àti nítorí ọwọ́ mi dara lọ́pọ̀lọ́pọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.25",
            "verseOrgIds": [
              "JOB.31.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí mo bá bojú wo oòrùn nígbà tí ń ràn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.26",
            "verseOrgIds": [
              "JOB.31.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:26"
      },
      "items": [
        {
          "text": "tàbí òṣùpá tí ń ràn nínú ìtànmọ́lẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.26",
            "verseOrgIds": [
              "JOB.31.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí a bá tàn ọkàn mi jẹ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.27",
            "verseOrgIds": [
              "JOB.31.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:27"
      },
      "items": [
        {
          "text": "láti fi ẹnu mi kò ọwọ́ mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.27",
            "verseOrgIds": [
              "JOB.31.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "èyí pẹ̀lú ni ẹ̀ṣẹ̀ ti àwọn onídàájọ́ ní láti bẹ̀wò,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.28",
            "verseOrgIds": [
              "JOB.31.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:28"
      },
      "items": [
        {
          "text": "nítorí pé èmí yóò jẹ́ aláìṣòótọ́ sí Ọlọ́run tí ó wà lókè.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.28",
            "verseOrgIds": [
              "JOB.31.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ó bá ṣe pé mo yọ̀ sì ìparun ẹni tí ó kórìíra mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.29",
            "verseOrgIds": [
              "JOB.31.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:29"
      },
      "items": [
        {
          "text": "Tàbí bí mo bá sì gbéraga sókè, nígbà tí ibi bá a.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.29",
            "verseOrgIds": [
              "JOB.31.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ èmi kò sì jẹ ki ẹnu mi ki ó ṣẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.30",
            "verseOrgIds": [
              "JOB.31.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:30"
      },
      "items": [
        {
          "text": "nípa fífẹ́ ègún sí ọkàn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.30",
            "verseOrgIds": [
              "JOB.31.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwọn ènìyàn inú àgọ́ mi kò bá lè wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.31",
            "verseOrgIds": [
              "JOB.31.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:31"
      },
      "items": [
        {
          "text": "'Ta ni kò ì tí ì jẹ ẹran rẹ̀ ní àjẹyó?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.31",
            "verseOrgIds": [
              "JOB.31.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àlejò kò wọ̀ ni ìgboro rí;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.32",
            "verseOrgIds": [
              "JOB.31.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:32"
      },
      "items": [
        {
          "text": "èmí ṣí ìlẹ̀kùn mi sílẹ̀ fún èrò.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.32",
            "verseOrgIds": [
              "JOB.31.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí mo bá bò ẹ̀ṣẹ̀ mi mọ́lẹ̀ bí Adamu ni pápá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.33",
            "verseOrgIds": [
              "JOB.31.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:33"
      },
      "items": [
        {
          "text": "ẹ̀bi mi pamọ́ ni àyà mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.33",
            "verseOrgIds": [
              "JOB.31.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀pọ̀lọpọ̀ ènìyàn ni mo ha bẹ̀rù bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.34",
            "verseOrgIds": [
              "JOB.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:34"
      },
      "items": [
        {
          "text": "Tàbí ẹ̀gàn àwọn ìdílé ní ń bà mí ní ẹ̀rù?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.34",
            "verseOrgIds": [
              "JOB.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:34"
      },
      "items": [
        {
          "text": "Tí mo fi pa ẹnu mọ́, tí èmí kò sì fi sọ̀rọ̀ jáde?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.34",
            "verseOrgIds": [
              "JOB.31.34"
            ]
