              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ìbá sì sọ iye ìṣísẹ̀ mi fún un,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.37",
            "verseOrgIds": [
