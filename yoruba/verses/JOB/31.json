      },
      "items": [
        {
          "text": "bí ọmọ-aládé ni èmi ìbá súnmọ́ ọ̀dọ̀ rẹ̀.)",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.37",
            "verseOrgIds": [
