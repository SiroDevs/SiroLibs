          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí mo bá jẹ èso oko mi láìsan owó",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.39",
            "verseOrgIds": [
              "JOB.31.39"
