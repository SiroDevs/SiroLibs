      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:36"
      },
      "items": [
        {
          "text": "èmi ìbá sì dé bí adé mọ́ orí mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.36",
            "verseOrgIds": [
              "JOB.31.36"
            ]
          }
        }
      ]
