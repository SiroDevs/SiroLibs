    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:35"
      },
      "items": [
        {
          "text": "Kíyèsi i, àmì mi, kí Olódùmarè kí ó dá mi lóhùn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.35",
            "verseOrgIds": [
              "JOB.31.35"
            ]
          }
        }
      ]
    },
