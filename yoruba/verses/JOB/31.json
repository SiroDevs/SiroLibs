        "vid": "JOB 31:38"
      },
      "items": [
        {
          "text": "tí a sì fi omijé kún gbogbo poro rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.38",
            "verseOrgIds": [
              "JOB.31.38"
