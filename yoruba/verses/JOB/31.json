      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:35"
      },
      "items": [
        {
          "text": "kí èmí kí ó sì rí ìwé náà tí olùfisùn mi ti kọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.35",
            "verseOrgIds": [
              "JOB.31.35"
            ]
          }
