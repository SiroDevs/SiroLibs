          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́ èmí ìbá gbé le èjìká mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.36",
            "verseOrgIds": [
              "JOB.31.36"
            ]
          }
        }
      ]
    },
