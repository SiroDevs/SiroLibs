  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "1KI 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìmúrasílẹ̀ láti kọ́ ilé fún",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Hiramu ọba Tire sì gbọ́ pé, a ti fi òróró yan Solomoni ní ọba ní ipò Dafidi baba rẹ̀, ó sì rán àwọn ikọ̀ rẹ̀ sí Solomoni, nítorí ó ti fẹ́ràn Dafidi ní ọjọ́ rẹ̀ gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.1",
            "verseOrgIds": [
              "1KI.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni sì ránṣẹ́ yìí padà sí Hiramu pé,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.2",
            "verseOrgIds": [
              "1KI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ mọ̀ pé Dafidi baba mi kò le kọ́ ilé fún orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.3",
                "verseOrgIds": [
                  "1KI.5.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀, nítorí ogun tí ó wà yí i káàkiri, títí",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.3",
                "verseOrgIds": [
                  "1KI.5.17"
                ]
              }
            }
          ]
        },
        {
          "text": "fi fi gbogbo àwọn ọ̀tá rẹ̀ sábẹ́ àtẹ́lẹsẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nísinsin yìí",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.4",
            "verseOrgIds": [
              "1KI.5.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.4",
                "verseOrgIds": [
                  "1KI.5.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run mi ti fún mi ní ìsinmi ní ibi gbogbo, bẹ́ẹ̀ ni kò sì sí ọ̀tá tàbí ìjàǹbá kan tí ó ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.4",
            "verseOrgIds": [
              "1KI.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà mo gbèrò láti kọ́ ilé fún orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.5",
                "verseOrgIds": [
                  "1KI.5.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run mi, bí",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.5",
                "verseOrgIds": [
                  "1KI.5.19"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ fún Dafidi baba mi, nígbà tí ó wí pé, 'Ọmọ rẹ tí èmi yóò gbé ka orí ìtẹ́ rẹ ní ipò rẹ ni yóò kọ́ ilé náà fún orúkọ mi.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà ni kí o pàṣẹ pé kí wọn kí ó gé igi kedari Lebanoni fún mi wá. Àwọn ènìyàn mi yóò ṣiṣẹ́ pẹ̀lú tìrẹ, Èmi yóò sì san owó ọ̀yà tí ìwọ bá ránṣẹ́ fún àwọn ènìyàn rẹ. Ìwọ mọ̀ pé, a kò ní ẹnìkan nínú wa tí ó mọ bí a ti ń gé igi bí àwọn ará Sidoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.6",
            "verseOrgIds": [
              "1KI.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Hiramu sì gbọ́ iṣẹ́ Solomoni, inú rẹ̀ sì dùn gidigidi, ó sì wí pé, \"Ògo ni fún",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.7",
                "verseOrgIds": [
                  "1KI.5.21"
                ]
              }
            }
          ]
        },
        {
          "text": "lónìí, nítorí tí ó ti fún Dafidi ní ọlọ́gbọ́n ọmọ láti ṣàkóso àwọn ìlú ńlá yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu sì ránṣẹ́ sí Solomoni pé,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 5:8"
      },
      "items": [
        {
          "text": "\"Èmi ti gbọ́ iṣẹ́ tí ìwọ rán sí mi, èmi yóò sì ṣe gbogbo èyí tí o fẹ́ ní pípèsè igi kedari àti ní ti igi firi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn mi yóò mú igi náà sọ̀kalẹ̀ láti Lebanoni wá sí Òkun, èmi ó sì fi wọ́n ránṣẹ́ sí ọ ní fífò lójú omi Òkun Ńlá títí dé ibi tí ìwọ ó na ìka sí fún mi. Níbẹ̀ ni èmi yóò ti yà wọ́n sọ́tọ̀, ìwọ yóò sì kó wọn lọ. Ìwọ yóò sì gba ìfẹ́ mi nípa pípèsè oúnjẹ fún ilé mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.9",
            "verseOrgIds": [
              "1KI.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni Hiramu sì pèsè igi kedari àti igi firi tí Solomoni ń fẹ́ fún un,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.10",
            "verseOrgIds": [
              "1KI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni sì fún Hiramu ní ogún ẹgbẹ̀rún (20,000) òsùwọ̀n ọkà oúnjẹ fún ilé rẹ̀, àti ogún òsùwọ̀n òróró dáradára. Solomoni sì ń tẹ̀síwájú láti ṣe èyí fún Hiramu lọ́dọọdún.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.12",
                "verseOrgIds": [
                  "1KI.5.26"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fún Solomoni ní ọgbọ́n, gẹ́gẹ́ bí ó ti ṣèlérí fún un. Ìrẹ́pọ̀ àlàáfíà sì wà láàrín Hiramu àti Solomoni, àwọn méjèèjì sì ṣe àdéhùn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ọba sì ṣa asìnrú ènìyàn jọ ní gbogbo Israẹli; àwọn tí ń sìnrú náà jẹ́ ẹgbàá mẹ́ẹ̀ẹ́dógún (30,000) ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.13",
            "verseOrgIds": [
              "1KI.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì rán wọn lọ sí Lebanoni, ẹgbẹ̀rún mẹ́wàá (10,000) lóṣooṣù, bẹ́ẹ̀ ni wọ́n lo oṣù kan ní Lebanoni, wọn a sì gbé ilé ní oṣù méjì. Adoniramu ni ó ṣe olórí àwọn asìnrú náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.14",
            "verseOrgIds": [
              "1KI.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni sì ní ẹgbẹ̀rún ní ọ̀nà àádọ́rin (70,000) ènìyàn tí ń ru ẹrù àti ọ̀kẹ́ mẹ́rin (80,000) gbẹ́nàgbẹ́nà lórí òkè,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.15",
            "verseOrgIds": [
              "1KI.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti àwọn ìjòyè nínú àwọn tí a fi ṣe olórí iṣẹ́ Solomoni jẹ́ ẹgbẹ̀rìndínlógún ó lé ọgọ́rùn-ún (3,300) ènìyàn, tí ó ń ṣe aláṣẹ àwọn ènìyàn tí ń ṣiṣẹ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.16",
            "verseOrgIds": [
              "1KI.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì pàṣẹ, wọ́n sì mú òkúta wá, òkúta iyebíye, àti òkúta gbígbẹ́ láti fi ìpìlẹ̀ ilé náà lé ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.17",
            "verseOrgIds": [
              "1KI.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn oníṣọ̀nà Solomoni àti Hiramu àti àwọn òṣìṣẹ́ láti Gebali sì gbẹ́ wọn, wọ́n sì pèsè igi àti òkúta láti fi kọ́ ilé náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.18",
            "verseOrgIds": [
              "1KI.5.32"
            ]
          }
        }
      ]
    }
  ],
