  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1KI 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adonijah fi ara rẹ̀ jẹ Ọba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Dafidi ọba di arúgbó, ọjọ́ rẹ̀ sì pọ̀, ara rẹ̀ kò le è móoru bí ó tilẹ̀ jẹ́ pé wọ́n da ọ̀pọ̀lọpọ̀ aṣọ bò ó.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.1",
            "verseOrgIds": [
              "1KI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn ìránṣẹ́ rẹ̀ wí fún un pé, \"Ẹ jẹ́ kí a wá ọ̀dọ́mọbìnrin wúńdíá kan kí ó dúró ti ọba, kì ó sì máa tọ́jú rẹ̀. Kí ó dùbúlẹ̀ ní àyà rẹ̀ kí ara ọba olúwa wa lè móoru.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.2",
            "verseOrgIds": [
              "1KI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni wọ́n lọ jákèjádò ilẹ̀ Israẹli láti wá ọ̀dọ́mọbìnrin arẹwà, wọ́n sì rí Abiṣagi, ará Ṣunemu, wọ́n sì mú un wá sí ọ̀dọ̀ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.3",
            "verseOrgIds": [
              "1KI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọbìnrin náà rẹwà gidigidi; ó sì ń ṣe ìtọ́jú ọba, ó sì ń ṣe ìránṣẹ́ fún un, ṣùgbọ́n ọba kò sì bá a lòpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.4",
            "verseOrgIds": [
              "1KI.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adonijah ẹni tí ìyá rẹ̀ ń ṣe Haggiti sì gbé ara rẹ̀ ga, ó sì wí pé, \"Èmi yóò jẹ ọba.\" Ó sì ṣètò kẹ̀kẹ́ ogun àti àwọn ẹlẹ́ṣin, pẹ̀lú àádọ́ta ọkùnrin láti máa sáré níwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.5",
            "verseOrgIds": [
              "1KI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Baba rẹ̀ kò bà á nínú jẹ́ rí nípa bíbéèrè lọ́wọ́ rẹ̀ pé, \"Èéṣe tí ìwọ fi hùwà báyìí?\" Ó sì jẹ́ arẹwà ọkùnrin, òun ni a bí lé Absalomu.)",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.6",
            "verseOrgIds": [
              "1KI.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adonijah sì gbèrò pẹ̀lú Joabu, ọmọ Seruiah àti Abiatari àlùfáà, wọ́n sì ṣe ìrànlọ́wọ́ fún un.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.7",
            "verseOrgIds": [
              "1KI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Sadoku àlùfáà, Benaiah ọmọ Jehoiada, Natani wòlíì, Ṣimei àti ọ̀rẹ́ rẹ̀ Rei àti olórí ogun Dafidi ni kò darapọ̀ mọ́ Adonijah.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.8",
            "verseOrgIds": [
              "1KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Adonijah fi àgùntàn àti màlúù àti ẹran ọ̀sìn tí ó sanra rú ẹbọ níbi Òkúta Soheleti tí ń bẹ lẹ́gbẹ̀ẹ́ En-Rogeli. Ó sì pe gbogbo àwọn arákùnrin rẹ̀, àwọn ọmọ ọba, àti gbogbo àwọn ọkùnrin Juda tí wọ́n jẹ́ ìránṣẹ́ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.9",
            "verseOrgIds": [
              "1KI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n kò pe Natani wòlíì tàbí Benaiah tàbí àwọn olórí tàbí Solomoni arákùnrin rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.10",
            "verseOrgIds": [
              "1KI.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Natani béèrè lọ́wọ́ Batṣeba, ìyá Solomoni pé, \"Ǹjẹ́ ìwọ kò gbọ́ pé Adonijah, ọmọ Haggiti ti jẹ ọba láìjẹ́ pé Dafidi olúwa wa mọ̀ sí i?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.11",
            "verseOrgIds": [
              "1KI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ nísinsin yìí, jẹ́ kí èmi gbà ọ́ ní ìmọ̀ràn bí ìwọ ṣe lè gba ẹ̀mí rẹ là àti ẹ̀mí ọmọ rẹ Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.12",
            "verseOrgIds": [
              "1KI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lọ sọ́dọ̀ Dafidi ọba, kí o sì wí fún un pé, 'Olúwa mi ọba, ǹjẹ́ ìwọ kò búra fún ìránṣẹ́ rẹ pé, \"Dájúdájú Solomoni ọmọ rẹ ni yóò jọba lẹ́yìn mi, yóò sì jókòó lórí ìtẹ́ mi?\" Èéṣe nígbà náà tí Adonijah fi jẹ ọba?'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.13",
            "verseOrgIds": [
              "1KI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níwọ́n ìgbà tí ìwọ sì wà níbẹ̀, tí o sì ń bá ọba sọ̀rọ̀ èmi yóò wá, láti wádìí ohun tí o ti sọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.14",
            "verseOrgIds": [
              "1KI.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Batṣeba lọ rí ọba ní inú yàrá rẹ̀, ọba sì gbó gidigidi níbi tí Abiṣagi ará Ṣunemu ti ń ṣe ìránṣẹ́ fún ọba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.15",
            "verseOrgIds": [
              "1KI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batṣeba sì tẹríba, ó sì kúnlẹ̀ níwájú ọba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.16",
            "verseOrgIds": [
              "1KI.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 1:16"
      },
      "items": [
        {
          "text": "Ọba sì béèrè pé, \"Kí ni ìwọ ń fẹ́?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.16",
            "verseOrgIds": [
              "1KI.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí fún ọba pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.17",
            "verseOrgIds": [
              "1KI.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.1.17",
                "verseOrgIds": [
                  "1KI.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "mi; ìwọ fúnra rẹ̀ fi",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.17",
            "verseOrgIds": [
              "1KI.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.1.17",
                "verseOrgIds": [
                  "1KI.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ búra fún ìránṣẹ́ rẹ pé, 'Solomoni ọmọ rẹ yóò jẹ ọba lẹ́yìn mi, yóò sì jókòó lórí ìtẹ́ mi.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.17",
            "verseOrgIds": [
              "1KI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nísinsin yìí, Adonijah ti di ọba, ìwọ, ọba olúwa mi kò sì mọ̀ nípa rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.18",
            "verseOrgIds": [
              "1KI.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun sì ti fi ọ̀pọ̀lọpọ̀ màlúù, àti ẹran tí ó ní ọ̀rá, àti àgùntàn rú ẹbọ, ó sì pe gbogbo àwọn ọmọ ọba, àti Abiatari àlùfáà àti Joabu balógun, ṣùgbọ́n kò sì pe Solomoni ìránṣẹ́ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.19",
            "verseOrgIds": [
              "1KI.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olúwa mi ọba, ojú gbogbo Israẹli ń bẹ lára rẹ, láti mọ ẹni tí yóò jókòó lórí ìtẹ́ olúwa mi ọba lẹ́yìn rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.20",
            "verseOrgIds": [
              "1KI.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí kò ṣe bẹ́ẹ̀ nígbà tí olúwa mi ọba bá sùn pẹ̀lú àwọn baba rẹ̀, wọn yóò sì ka èmi àti Solomoni sí ẹlẹ́ṣẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.21",
            "verseOrgIds": [
              "1KI.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó sì ti ń bá ọba sọ̀rọ̀ lọ́wọ́, Natani wòlíì sì wọlé.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.22",
            "verseOrgIds": [
              "1KI.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì sọ fún ọba pé, \"Natani wòlíì wà níbí.\" Ó sì lọ síwájú ọba, ó wólẹ̀, ó sì dojúbolẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.23",
            "verseOrgIds": [
              "1KI.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natani sì wí pé, \"Ǹjẹ́ ìwọ, olúwa mi ọba, ti sọ pé Adonijah ni yóò jẹ ọba lẹ́yìn rẹ àti pé òun ni yóò jókòó lórí ìtẹ́ rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.24",
            "verseOrgIds": [
              "1KI.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ti sọ̀kalẹ̀ lọ ní òní, ó sì ti rú ẹbọ ọ̀pọ̀lọpọ̀ màlúù, àti ẹran ọlọ́ràá àti àgùntàn. Ó sì ti pe gbogbo àwọn ọmọ ọba, balógun àti Abiatari àlùfáà. Nísìnsinyìí, wọ́n ń jẹ, wọ́n ń mu pẹ̀lú rẹ̀, wọ́n sì wí pé, 'Kí Adonijah ọba kí ó pẹ́!'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.25",
            "verseOrgIds": [
              "1KI.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èmi ìránṣẹ́ rẹ, àti Sadoku àlùfáà, àti Benaiah ọmọ Jehoiada, àti Solomoni ìránṣẹ́ rẹ ni kò pè.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.26",
            "verseOrgIds": [
              "1KI.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣé nǹkan yìí ni olúwa mi ọba ti ṣe láìjẹ́ kí àwọn ìránṣẹ́ rẹ mọ ẹni tí yóò jókòó lórí ìtẹ́ olúwa mi ọba lẹ́yìn rẹ?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.27",
            "verseOrgIds": [
              "1KI.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dafidi fi Solomoni jẹ ọba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Dafidi ọba wí pé, \"Pe Batṣeba wọlé wá.\" Ó sì wá síwájú ọba, ó sì dúró níwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.28",
            "verseOrgIds": [
              "1KI.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì búra pé, \"Dájúdájú bí",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.29",
            "verseOrgIds": [
              "1KI.1.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.1.29",
                "verseOrgIds": [
                  "1KI.1.29"
                ]
              }
            }
          ]
        },
        {
          "text": "ti wà ẹni tí ó ti gbà mí kúrò nínú gbogbo wàhálà",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.29",
            "verseOrgIds": [
              "1KI.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lónìí dandan ni èmi yóò gbé ohun tí mo ti fi",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.30",
            "verseOrgIds": [
              "1KI.1.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.1.30",
                "verseOrgIds": [
                  "1KI.1.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli búra fún yọ pé, Solomoni ọmọ rẹ ni yóò jẹ ọba lẹ́yìn mi, àti pé yóò jókòó lórí ìtẹ́ mi ní ipò mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.30",
            "verseOrgIds": [
              "1KI.1.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Batṣeba tẹríba, ó sì kúnlẹ̀ níwájú ọba pé, \"Kí olúwa mi Dafidi ọba kí ó pẹ́!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.31",
            "verseOrgIds": [
              "1KI.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi ọba sì wí pé, \"Ẹ pe Sadoku àlùfáà wọlé fún mi àti Natani wòlíì àti Benaiah ọmọ Jehoiada.\" Nígbà tí wọ́n wá síwájú ọba,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.32",
            "verseOrgIds": [
              "1KI.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọba sì wí fún wọn pé, \"Ẹ mú àwọn ìránṣẹ́ olúwa yín pẹ̀lú yín kí ẹ sì mú kí Solomoni ọmọ mi kí ó gun ìbáaka mi, kí ẹ sì mú un sọ̀kalẹ̀ wá sí Gihoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.33",
            "verseOrgIds": [
              "1KI.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbẹ̀ ni Sadoku àlùfáà àti Natani wòlíì yóò ti fi òróró yàn án ní ọba lórí Israẹli. Ẹ fọn fèrè, kí ẹ sì ké pé, 'Kí Solomoni ọba kí ó pẹ́!'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.34",
            "verseOrgIds": [
              "1KI.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni kí ẹ sì gòkè pẹ̀lú rẹ̀, kí ó sì wá, kí ó sì jókòó sórí ìtẹ́ mi, kí ó sì jẹ ọba ní ipò mi. Èmi ti yàn án ní ọba lórí gbogbo Israẹli àti Juda.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.35",
            "verseOrgIds": [
              "1KI.1.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaiah ọmọ Jehoiada sì dá ọba lóhùn pé, \"Àmín! Kí",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.36",
            "verseOrgIds": [
              "1KI.1.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.1.36",
                "verseOrgIds": [
                  "1KI.1.36"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run olúwa mi ọba, kéde rẹ̀ bẹ́ẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.36",
            "verseOrgIds": [
              "1KI.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.37",
            "verseOrgIds": [
              "1KI.1.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.1.37",
                "verseOrgIds": [
                  "1KI.1.37"
                ]
              }
            }
          ]
        },
        {
          "text": "ti wà pẹ̀lú olúwa mi ọba, bẹ́ẹ̀ ni kí ó wà pẹ̀lú Solomoni kí ó lè mú kí ìjọba rẹ̀ pẹ́ ju ìtẹ́ olúwa mi Dafidi ọba lọ!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.37",
            "verseOrgIds": [
              "1KI.1.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Sadoku àlùfáà, Natani wòlíì, Benaiah ọmọ Jehoiada, àwọn ará Kereti àti Peleti sì sọ̀kalẹ̀ wá wọ́n sì gbé Solomoni gun ìbáaka Dafidi ọba wá sí Gihoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.38",
            "verseOrgIds": [
              "1KI.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sadoku àlùfáà sì mú ìwo òróró láti inú àgọ́, ó sì dà á sí Solomoni lórí. Nígbà náà ni wọ́n sì fọn fèrè, gbogbo àwọn ènìyàn sì ké pé, \"Kí Solomoni ọba kí ó pẹ́!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.39",
            "verseOrgIds": [
              "1KI.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ènìyàn sì gòkè tọ̀ ọ́ lẹ́yìn wọ́n ń fọn ìpè, wọ́n sì ń yọ ayọ̀ ńlá, tó bẹ́ẹ̀ tí ilẹ̀ mì fún ìró wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.40",
            "verseOrgIds": [
              "1KI.1.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adonijah àti gbogbo àwọn àlejò tí ó wà lọ́dọ̀ rẹ̀ gbọ́ ọ́ bí wọ́n ti ń jẹun tán, wọ́n ń gbọ́ ìpè, Joabu sì wí pé, \"Kí ní ìtumọ̀ gbogbo ariwo nínú ìlú yìí?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.41",
            "verseOrgIds": [
              "1KI.1.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó sì ti ń sọ̀rọ̀ lọ́wọ́, Jonatani ọmọ Abiatari àlùfáà sì dé, Adonijah sì wí pé, \"Wọlé wá, ọkùnrin yíyẹ ìwọ gbọdọ̀ mú ìròyìn rere wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.42",
            "verseOrgIds": [
              "1KI.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani sì dáhùn, ó sì wí fún Adonijah pé, \"Lóòótọ́ ni olúwa wa Dafidi ọba, fi Solomoni jẹ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.43",
            "verseOrgIds": [
              "1KI.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì ti rán Sadoku àlùfáà, Natani wòlíì, Benaiah ọmọ Jehoiada àti àwọn ará Kereti àti Peleti pẹ̀lú rẹ̀, wọ́n sì ti gbé e gun ìbáaka ọba,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.44",
            "verseOrgIds": [
              "1KI.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sadoku àlùfáà àti Natani wòlíì ti fi òróró yàn án ní ọba ní Gihoni. Láti ibẹ̀ ni wọ́n ti gòkè wá pẹ̀lú ayọ̀, ìlú sì ń hó pẹ̀lú rẹ̀. Èyí ni ariwo tí ẹ̀yin ń gbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.45",
            "verseOrgIds": [
              "1KI.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni sì ti jókòó lórí ìtẹ́ ìjọba rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.46",
            "verseOrgIds": [
              "1KI.1.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìránṣẹ́ ọba sì ti tún wá láti bá olúwa wa Dafidi ọba yọ̀, wí pé, 'Kí Ọlọ́run rẹ̀ mú orúkọ Solomoni lókìkí ju tirẹ̀ lọ àti kí ìtẹ́ rẹ̀ kí ó pọ̀ ju tirẹ̀ lọ!' Ọba sì tẹ ara rẹ̀ ba lórí ibùsùn rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.47",
            "verseOrgIds": [
              "1KI.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọba sì wí pé, 'Ògo ni fún",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.48",
            "verseOrgIds": [
              "1KI.1.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.1.48",
                "verseOrgIds": [
                  "1KI.1.48"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli, ẹni tí ó ti jẹ́ kí ojú mi rí ẹnìkan tí ó jókòó lórí ìtẹ́ mi lónìí.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.48",
            "verseOrgIds": [
              "1KI.1.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni gbogbo àwọn àlejò tí ó wà lọ́dọ̀ Adonijah dìde ní ìdágìrì, wọ́n sì túká.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.49",
            "verseOrgIds": [
              "1KI.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Adonijah sì bẹ̀rù Solomoni, ó lọ, ó sì di ìwo pẹpẹ mú.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.50",
            "verseOrgIds": [
              "1KI.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1KI 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni a sì sọ fún Solomoni pé, \"Adonijah bẹ̀rù Solomoni ọba, ó sì di ìwo pẹpẹ mú, Ó wí pé, 'Jẹ́ kí ọba Solomoni búra fún mi lónìí pé, òun kì yóò fi idà pa ìránṣẹ́ rẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.51",
            "verseOrgIds": [
              "1KI.1.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1KI 1:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni sì dáhùn pé, \"Bí ó bá fi ara rẹ̀ hàn láti jẹ́ ẹni ọ̀wọ̀, irun orí rẹ̀ kan kì yóò sì bọ́ sílẹ̀; ṣùgbọ́n bí a bá rí búburú kan ní ọwọ́ rẹ̀ òun yóò kú.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.52",
            "verseOrgIds": [
              "1KI.1.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1KI 1:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Solomoni ọba rán àwọn ènìyàn, wọ́n sì mú un sọ̀kalẹ̀ láti ibi pẹpẹ wá. Adonijah sì wá, ó sì foríbalẹ̀ fún Solomoni ọba, Solomoni sì wí pé, \"Lọ ilé rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.53",
            "verseOrgIds": [
              "1KI.1.53"
            ]
          }
        }
      ]
    }
