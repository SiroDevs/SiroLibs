  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "DEU 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibi ìsìn kan ṣoṣo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ̀nyí ni àwọn ìlànà àti òfin tí ẹ gbọdọ̀ ṣọ́ra láti máa tẹ̀lé, ní ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.1",
            "verseOrgIds": [
              "DEU.12.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.1",
                "verseOrgIds": [
                  "DEU.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run àwọn baba yín, fi fún un yín láti gbà: ní gbogbo ìgbà tí ẹ bá fi wà lórí ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.1",
            "verseOrgIds": [
              "DEU.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ibi gíga àwọn òkè ńlá, àti òkè kéékèèké àti lábẹ́ gbogbo igi tí ń gbilẹ̀ níbi tí àwọn orílẹ̀-èdè tí ẹ ó lé jáde, tí ń sin òrìṣà wọn ní kí ẹ mú kúrò pátápátá.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.2",
            "verseOrgIds": [
              "DEU.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ wó àwọn pẹpẹ wọn, ẹ bi òpó ìsìn wọn ṣubú, kí ẹ sì sun òpó Aṣerah wọn ní iná. Ẹ gé gbogbo ère òrìṣà wọn lulẹ̀, kí ẹ sì pa orúkọ wọn rẹ́ ní gbogbo ààyè wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.3",
            "verseOrgIds": [
              "DEU.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kò gbọdọ̀ sin",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.4",
            "verseOrgIds": [
              "DEU.12.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.4",
                "verseOrgIds": [
                  "DEU.12.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín bí i tiwọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.4",
            "verseOrgIds": [
              "DEU.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ wá ibi tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.5",
            "verseOrgIds": [
              "DEU.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.5",
                "verseOrgIds": [
                  "DEU.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín yóò yàn láàrín àwọn ẹ̀yà yín, láti fi orúkọ rẹ̀ síbẹ̀ bí i ibùgbé rẹ̀. Ibẹ̀ ni kí ẹ lọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.5",
            "verseOrgIds": [
              "DEU.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbẹ̀ ni kí ẹ mú ẹbọ sísun àti ẹbọ yín wá, ìdámẹ́wàá yín àti ọrẹ àkànṣe, àwọn ẹ̀jẹ́ yín, ọrẹ àtinúwá yín, àti àwọn àkọ́bí gbogbo màlúù yín àti ewúrẹ́ ẹ yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.6",
            "verseOrgIds": [
              "DEU.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.7",
                "verseOrgIds": [
                  "DEU.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín níbẹ̀, kí ẹ̀yin àti ìdílé yín jẹun kí ẹ sì yó, nínú gbogbo ìdáwọ́lé e yín, torí pé",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.7",
                "verseOrgIds": [
                  "DEU.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ti bùkún un yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ̀yin kí ó má ṣe ṣe gẹ́gẹ́ bí a tí ṣe níhìn-ín lónìí yìí, tí olúkúlùkù ń ṣe ohun tí ó tọ́ ní ojú ara rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.8",
            "verseOrgIds": [
              "DEU.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níwọ́n ìgbà tí ẹ ti dé ibi ìsinmi, àti ibi ogún tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.9",
            "verseOrgIds": [
              "DEU.12.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.9",
                "verseOrgIds": [
                  "DEU.12.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín fún un yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.9",
            "verseOrgIds": [
              "DEU.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ ó la Jordani kọjá, ẹ ó sì máa gbé ní ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.10",
            "verseOrgIds": [
              "DEU.12.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.10",
                "verseOrgIds": [
                  "DEU.12.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín fún un yín bí ìní, yóò sì fún un yín ní ìsinmi, kúrò láàrín àwọn ọ̀tá a yín, tí ó yí i yín ká, kí ẹ ba à lè máa gbé láìléwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.10",
            "verseOrgIds": [
              "DEU.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbi tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.11",
                "verseOrgIds": [
                  "DEU.12.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín yóò yàn bí ibùgbé fún orúkọ rẹ̀. Níbẹ̀ ni kí ẹ mú gbogbo ohun tí mo pàṣẹ fún un yín wá: àwọn ọrẹ ẹ yín àti àwọn ẹbọ sísun, ìdámẹ́wàá yín àti ọrẹ àkànṣe, àti gbogbo ohun ìní yín tí ẹ ti yàn, èyí tí ẹ ti jẹ́ ẹ̀jẹ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.11",
                "verseOrgIds": [
                  "DEU.12.11"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ máa yọ̀ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.12",
            "verseOrgIds": [
              "DEU.12.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.12",
                "verseOrgIds": [
                  "DEU.12.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín níbẹ̀, ẹ̀yin, àwọn ọmọkùnrin yín, àwọn ọmọbìnrin yín, ìránṣẹ́bìnrin àti ìránṣẹ́kùnrin yín, àti àwọn Lefi láti ìlú u yín, tí wọn kò ní ìpín tàbí ogún tiwọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.12",
            "verseOrgIds": [
              "DEU.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ ṣọ́ra kí ẹ má ṣe rú ẹbọ sísun yín ní ibikíbi tí ẹ̀yin fẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.13",
            "verseOrgIds": [
              "DEU.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.14",
            "verseOrgIds": [
              "DEU.12.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.14",
                "verseOrgIds": [
                  "DEU.12.14"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò yàn láàrín àwọn ẹ̀yà a yín nìkan ni kí ẹ ti máa rú ẹbọ sísun yín, kí ẹ sì máa kíyèsi ohun gbogbo tí mo pàṣẹ fún un yín níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.14",
            "verseOrgIds": [
              "DEU.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀síbẹ̀, ẹ lọ pa àwọn ẹran yín ní èyíkéyìí nínú àwọn ìlú u yín, kí ẹ sì jẹ ẹran náà tó bí ẹ ti fẹ́, bí ẹ ti ń ṣe sí àgbọ̀nrín àti èsúró, gẹ́gẹ́ bí ìbùkún",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.15",
            "verseOrgIds": [
              "DEU.12.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.15",
                "verseOrgIds": [
                  "DEU.12.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín tí ó fi fún un yín, àti ẹni mímọ́ àti aláìmọ́ ni ó lè jẹ nínú àwọn ẹran náà.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.15",
            "verseOrgIds": [
              "DEU.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ kò gbọdọ̀ jẹ ẹ̀jẹ̀ wọn, ẹ dà á sílẹ̀ bí omi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.16",
            "verseOrgIds": [
              "DEU.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kò gbọdọ̀ jẹ ìdámẹ́wàá oúnjẹ yín, wáìnì tuntun, òróró, àkọ́bí àwọn màlúù yín, tàbí ti ewúrẹ́ ẹ yín, ohunkóhun tí ó jẹ́ ẹ̀jẹ́, ọrẹ àtinúwá, tàbí ẹ̀bùn pàtàkì ní ìlú ẹ̀yin tìkára yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.17",
            "verseOrgIds": [
              "DEU.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí kò ṣe kí ẹ jẹ ẹ́ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.18",
                "verseOrgIds": [
                  "DEU.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, níbi tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.18",
                "verseOrgIds": [
                  "DEU.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, yóò yàn: ìwọ, àwọn ọmọkùnrin rẹ, àwọn ọmọbìnrin rẹ, àwọn ìránṣẹ́kùnrin àti ìránṣẹ́bìnrin rẹ àti àwọn ọmọ Lefi láti ìlú u yín, kí ẹ sì máa yọ̀ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.18",
                "verseOrgIds": [
                  "DEU.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, nínú gbogbo ìdáwọ́lé e yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ ṣọ́ra kí ẹ má ṣe gbàgbé àwọn Lefi, ní gbogbo ìgbà tí ẹ bá ń gbé ní ilẹ̀ ẹ yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.19",
            "verseOrgIds": [
              "DEU.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.20",
            "verseOrgIds": [
              "DEU.12.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.20",
                "verseOrgIds": [
                  "DEU.12.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín bá ti fẹ́ agbègbè e yín bí ó ti ṣe ìlérí, fún un yín, tí ẹ sì wí pé, àwa yóò jẹ ẹran, nítorí tí ọkàn wa fẹ́ jẹran. Ẹ jẹ ẹran náà bí ẹ tí fẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.20",
            "verseOrgIds": [
              "DEU.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ibi tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.21",
                "verseOrgIds": [
                  "DEU.12.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín bá yàn fún orúkọ rẹ̀ bá jìnnà sí i yín, kí ẹ pa màlúù tàbí ewúrẹ́ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.21",
                "verseOrgIds": [
                  "DEU.12.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín tí fún un yín, bí mo ti pàṣẹ fún un yín ní ìlú u yín, ẹ lè jẹ ẹ́ bí ẹ ti fẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jẹ wọ́n bí ẹ ó ti jẹ èsúró tàbí àgbọ̀nrín, ẹni tí a kà sí mímọ́ àti aláìmọ́ ni ó lè jẹ ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.22",
            "verseOrgIds": [
              "DEU.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ rí i dájú pé ẹ kò jẹ ẹ̀jẹ̀ wọn, nítorí pé ẹ̀jẹ̀ ni ẹ̀mí, ẹ kò sì gbọdọ̀ jẹ ẹ̀mí pọ̀ mọ́ ẹran.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.23",
            "verseOrgIds": [
              "DEU.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kò gbọdọ̀ jẹ ẹ̀jẹ̀, ẹ dà á sílẹ̀ bí omi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.24",
            "verseOrgIds": [
              "DEU.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe jẹ ẹ́, kí ó bá à lè dára fún ẹ̀yin àti àwọn ọmọ yín, tí ń bọ̀ lẹ́yìn in yín. Nígbà yí ní ẹ tó ń ṣe ohun tí ó tọ̀nà lójú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.25",
            "verseOrgIds": [
              "DEU.12.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.25",
                "verseOrgIds": [
                  "DEU.12.25"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.25",
            "verseOrgIds": [
              "DEU.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ mú àwọn ohun tí ẹ yà sọ́tọ̀ àti àwọn ẹ̀jẹ́ yín, kí ẹ sì lọ sí ibi tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.26",
            "verseOrgIds": [
              "DEU.12.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.26",
                "verseOrgIds": [
                  "DEU.12.26"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò yàn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.26",
            "verseOrgIds": [
              "DEU.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ fi ẹbọ sísun yín kalẹ̀ lórí i pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.27",
                "verseOrgIds": [
                  "DEU.12.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, àti ẹran àti ẹ̀jẹ̀ rẹ̀. Ẹ̀jẹ̀ ọrẹ yín ni ki ẹ dà sí pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.27",
                "verseOrgIds": [
                  "DEU.12.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, ṣùgbọ́n ẹ lè jẹ ẹran.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kíyèsára láti máa gbọ́rọ̀ sí gbogbo ìlànà tí mò ń fún un yín, kí o bá à dára fún ẹ̀yin àti àwọn ọmọ yín nígbà gbogbo, nítorí pé nígbà náà ní ẹ tó ń ṣe ohun tí ó dára tí ó sì tọ̀nà níwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.28",
                "verseOrgIds": [
                  "DEU.12.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.29",
                "verseOrgIds": [
                  "DEU.12.29"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín yóò gé àwọn orílẹ̀-èdè tí ẹ fẹ́ lé kúrò tí ẹ sì fẹ́ gba ilẹ̀ wọn kúrò níwájú u yín. Ṣùgbọ́n nígbà tí ẹ bá ti lé wọn jáde tí ẹ sì ń gbé ilẹ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.29",
            "verseOrgIds": [
              "DEU.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìgbà tí a bá ti pa wọ́n run níwájú u yín, ẹ ṣọ́ra kí ẹ má ba à bọ́ sínú àdánwò nípa bíbéèrè nípa àwọn òrìṣà wọn wí pé, \"Báwo ni àwọn orílẹ̀-èdè yìí ṣe ń sin àwọn òrìṣà wọn? Àwa náà yóò ṣe bẹ́ẹ̀\".",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.30",
            "verseOrgIds": [
              "DEU.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kò gbọdọ̀ sin",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.31",
                "verseOrgIds": [
                  "DEU.12.31"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín bí àwọn, torí pé, nípa sínsin ọlọ́run wọn, wọ́n ń ṣe ọ̀pọ̀lọpọ̀ ohun ìríra tí Ọlọ́run kórìíra. Wọ́n ń dáná sun àwọn ọmọkùnrin àti àwọn ọmọbìnrin wọn láti fi rú ẹbọ sí ère òrìṣà wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ rí i pé ẹ̀ ń ṣe gbogbo ohun tí mo ti pàṣẹ fún un yín. Ẹ má ṣe fi kún un, ẹ má sì ṣe yọ kúrò níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.32",
            "verseOrgIds": [
              "DEU.13.1"
            ]
          }
        }
      ]
    }
  ],
