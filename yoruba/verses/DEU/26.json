  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "DEU 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àkọ́so àti ìdámẹ́wàá",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ìwọ bá wọ ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.1",
            "verseOrgIds": [
              "DEU.26.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.1",
                "verseOrgIds": [
                  "DEU.26.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ ń fi fún ọ gẹ́gẹ́ bí ohun ìní tí ìwọ sì ti jogún, tí ìwọ sì ti ń gbé níbẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.1",
            "verseOrgIds": [
              "DEU.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mú díẹ̀ nínú ohun tí o pèsè láti inú erùpẹ̀ ilẹ̀ náà tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.2",
                "verseOrgIds": [
                  "DEU.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ ń fi fún ọ, kó wọn sínú agbọ̀n. Nígbà náà kí o lọ sí ibi tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.2",
                "verseOrgIds": [
                  "DEU.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ yóò yàn gẹ́gẹ́ bí ibi tí orúkọ rẹ̀ yóò máa gbé.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí o sì sọ fun àlùfáà tí ó wà ní ibi iṣẹ́ ní àsìkò náà, pé, \"Mo sọ ọ́ di mí mọ̀ fún",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.3",
                "verseOrgIds": [
                  "DEU.26.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ pé mo ti wá sí ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.3",
                "verseOrgIds": [
                  "DEU.26.3"
                ]
              }
            }
          ]
        },
        {
          "text": "búra fún àwọn baba wa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àlùfáà yóò gbé agbọ̀n náà kúrò ní ọwọ́ rẹ, yóò sì gbé e kalẹ̀ níwájú pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.4",
                "verseOrgIds": [
                  "DEU.26.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ìwọ yóò sọ ní iwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.5",
            "verseOrgIds": [
              "DEU.26.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.5",
                "verseOrgIds": [
                  "DEU.26.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ pé, \"Baba mi jẹ́ alárìnkiri ará Aramu, ó sì sọ̀kalẹ̀ wá sí Ejibiti pẹ̀lú ènìyàn díẹ̀, ó sì ń gbé níbẹ̀, ó sì wá di orílẹ̀-èdè olókìkí, alágbára, tí ó kún fún ọ̀pọ̀ ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.5",
            "verseOrgIds": [
              "DEU.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn ará Ejibiti ṣe àìdára sí wa, wọ́n jẹ wá ní yà, wọ́n fún wa ní iṣẹ́ líle ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.6",
            "verseOrgIds": [
              "DEU.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni a kégbe pe",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.7",
                "verseOrgIds": [
                  "DEU.26.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run àwọn baba wa,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.7",
                "verseOrgIds": [
                  "DEU.26.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sì gbọ́ ohùn wa, ó sì rí ìrora, làálàá àti ìnira wa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.8",
            "verseOrgIds": [
              "DEU.26.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.8",
                "verseOrgIds": [
                  "DEU.26.8"
                ]
              }
            }
          ]
        },
        {
          "text": "mú wa jáde wá láti Ejibiti pẹ̀lú ọwọ́ agbára àti apá nínà, pẹ̀lú ẹ̀rù ńlá àti iṣẹ́ àmì àti iṣẹ́ ìyanu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.8",
            "verseOrgIds": [
              "DEU.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó mú wa wá síbí, ó sì fún wa ní ilẹ̀ yìí, ilẹ̀ tí ó ń sàn fún wàrà àti oyin;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.9",
            "verseOrgIds": [
              "DEU.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti pé ní báyìí, mo mú àkọ́so ilẹ̀ tí ìwọ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.10",
                "verseOrgIds": [
                  "DEU.26.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fún mi wá.\" Ìwọ yóò gbé agbọ̀n náà síwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.10",
                "verseOrgIds": [
                  "DEU.26.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ, kí o sì wólẹ̀ níwájú u rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ àti àwọn ọmọ Lefi àti àjèjì láàrín yín yóò máa yọ̀ nínú gbogbo oore tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
            "verseOrgIds": [
              "DEU.26.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.11",
                "verseOrgIds": [
                  "DEU.26.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fi fún ọ àti fún àwọn ará ilé rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
            "verseOrgIds": [
              "DEU.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ìwọ bá ṣetán láti ya ìdámẹ́wàá gbogbo ohun tí o ti mú jáde ní ọdún kẹta sọ́tọ̀ sí apá kan. Ọdún ìdámẹ́wàá, ìwọ yóò fi fún ọmọ Lefi, àjèjì, aláìní baba àti opó, kí wọn kí ó lè jẹ ní àwọn ìlú rẹ, kí wọn sì yó.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.12",
            "verseOrgIds": [
              "DEU.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ní kí o wí fún",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.13",
            "verseOrgIds": [
              "DEU.26.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.13",
                "verseOrgIds": [
                  "DEU.26.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ pé, \"Èmi ti mú ohun mímọ́ kúrò nínú ilé mi, èmi sì ti fi fún àwọn Lefi, àwọn àjèjì, àwọn aláìní baba àti àwọn opó, gẹ́gẹ́ bí ohun gbogbo tí ìwọ ti pàṣẹ. Èmi kò yípadà kúrò nínú àṣẹ rẹ bẹ́ẹ̀ ni èmi kò gbàgbé ọ̀kankan nínú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.13",
            "verseOrgIds": [
              "DEU.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi kò jẹ lára ohun mímọ́ ní ìgbà tí mo ń ṣọ̀fọ̀, bẹ́ẹ̀ ni èmi kò mu nínú wọn ní ìgbà tí mo wà ní àìmọ́, bẹ́ẹ̀ ni èmi kò fi nínú wọn fún òkú. Èmi ti ṣe ìgbọ́ràn sí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.14",
            "verseOrgIds": [
              "DEU.26.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.14",
                "verseOrgIds": [
                  "DEU.26.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run mi, èmi sì ti ṣe gbogbo ohun tí ó pàṣẹ fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.14",
            "verseOrgIds": [
              "DEU.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wo ilẹ̀ láti ọ̀run wá, ibùgbé mímọ́ rẹ, kí o sì bùkún fún àwọn ènìyàn Israẹli, àti fún ilẹ̀ náà tí ìwọ ti fi fún wa, bí ìwọ ti búra fún àwọn baba ńlá wa, ilẹ̀ tí ó ń sàn fún wàrà àti fún oyin.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.15",
            "verseOrgIds": [
              "DEU.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
