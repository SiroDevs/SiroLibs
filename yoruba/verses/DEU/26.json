                "verseId": "DEU.26.16",
                "verseOrgIds": [
                  "DEU.26.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ pàṣẹ fún ọ ní òní láti máa tẹ̀lé àwọn ìlànà àti òfin, kí o sì máa ṣe wọ́n pẹ̀lú gbogbo ọkàn rẹ àti gbogbo àyà rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.16",
            "verseOrgIds": [
              "DEU.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ jẹ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.17",
            "verseOrgIds": [
              "DEU.26.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.17",
                "verseOrgIds": [
                  "DEU.26.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ní òní pé",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.17",
            "verseOrgIds": [
              "DEU.26.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.17",
                "verseOrgIds": [
                  "DEU.26.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ni Ọlọ́run rẹ, àti pé ìwọ yóò máa rìn ní ọ̀nà rẹ̀ gbogbo, àti pé ìwọ yóò máa pa ìlànà rẹ̀, àṣẹ rẹ̀ àti òfin rẹ̀ mọ́, àti pé ìwọ yóò máa ṣe ìgbọ́ràn sí i.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.17",
            "verseOrgIds": [
              "DEU.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òní ni",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.18",
            "verseOrgIds": [
              "DEU.26.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.18",
                "verseOrgIds": [
                  "DEU.26.18"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ́wọ́ rẹ pé ìwọ ni ènìyàn òun, ilé ìṣúra rẹ̀ gẹ́gẹ́ bí òun ti ṣe ìlérí, àti pé ìwọ yóò máa pa gbogbo àṣẹ rẹ̀ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.18",
            "verseOrgIds": [
              "DEU.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun sì jẹ́wọ́ pé, òun yóò gbé ọ sókè ju gbogbo orílẹ̀-èdè tí òun ti dá lọ, ní ìyìn, ní òkìkí àti ní ọlá; kí ìwọ kí ó le jẹ́ ènìyàn mímọ́ sí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.19",
            "verseOrgIds": [
              "DEU.26.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.19",
                "verseOrgIds": [
                  "DEU.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ gẹ́gẹ́ bí òun ti ṣe ìlérí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.19",
            "verseOrgIds": [
              "DEU.26.19"
            ]
          }
        }
