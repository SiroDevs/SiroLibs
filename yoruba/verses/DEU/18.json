                  "DEU.18.17"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí fún mi pé, \"Ohun tí wọ́n sọ dára.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.17",
            "verseOrgIds": [
              "DEU.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò gbé wòlíì kan dìde fún wọn láàrín àwọn arákùnrin wọn bí ìwọ, Èmi yóò fi ọ̀rọ̀ mi sí i ní ẹnu, yóò sì sọ fún wọn gbogbo ohun tí mo ti paláṣẹ fún un.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.18",
            "verseOrgIds": [
              "DEU.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí kò bá sì tẹ́tí sí ọ̀rọ̀ mi tí wòlíì náà yóò sọ ní orúkọ mi, èmi fúnra à mi yóò sì béèrè lọ́wọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.19",
            "verseOrgIds": [
              "DEU.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí wòlíì kan bá kùgbù sọ ọ̀rọ̀ kan tí èmi kò paláṣẹ fún un láti sọ ní orúkọ mi tàbí wòlíì tí ó sọ̀rọ̀ ní orúkọ ọlọ́run mìíràn, irú wòlíì bẹ́ẹ̀ ní láti kú.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.20",
            "verseOrgIds": [
              "DEU.18.20"
            ]
          }
        }
      ]
    },
