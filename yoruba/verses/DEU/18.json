              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ohun tí wòlíì bá sọ ní orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.22",
            "verseOrgIds": [
              "DEU.18.22"
            ]
