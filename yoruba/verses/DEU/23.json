  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "DEU 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yíyọ orúkọ ènìyàn kúrò nínú orúkọ àwọn ènìyàn",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹnikẹ́ni tí a fọ́ ní kóró ẹpọ̀n nípa rírùn tàbí gígé má ṣe wọ inú ìjọ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.1",
            "verseOrgIds": [
              "DEU.23.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.1",
                "verseOrgIds": [
                  "DEU.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": "wá.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.1",
            "verseOrgIds": [
              "DEU.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ọmọ àlè má ṣe wọ ìpéjọ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.2",
            "verseOrgIds": [
              "DEU.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.2",
                "verseOrgIds": [
                  "DEU.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", pàápàá títí dé ìran kẹwàá.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.2",
            "verseOrgIds": [
              "DEU.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ọmọ Ammoni tàbí ọmọ Moabu, kì yóò wọ ìjọ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.3",
            "verseOrgIds": [
              "DEU.23.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.3",
                "verseOrgIds": [
                  "DEU.23.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", àní títí dé ìran kẹwàá, ènìyàn wọn kan kì yóò wọ inú ìjọ ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.3",
            "verseOrgIds": [
              "DEU.23.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.3",
                "verseOrgIds": [
                  "DEU.23.4"
                ]
              }
            }
          ]
        },
        {
          "text": "láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.3",
            "verseOrgIds": [
              "DEU.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí wọn kò fi àkàrà àti omi pàdé e yín lójú ọ̀nà nígbà tí ò ń bọ̀ láti Ejibiti àti nítorí wọ́n gba ẹ̀yà iṣẹ́ láti fi ọ́ gégùn ún Balaamu ọmọ Beori ará a Petori ti Aramu-Naharaimu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.4",
            "verseOrgIds": [
              "DEU.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀síbẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.5",
            "verseOrgIds": [
              "DEU.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.5",
                "verseOrgIds": [
                  "DEU.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ kò ní fetí sí Balaamu ṣùgbọ́n ó yí ègún sí ìbùkún fún ọ, nítorí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.5",
            "verseOrgIds": [
              "DEU.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.5",
                "verseOrgIds": [
                  "DEU.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ fẹ́ràn rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.5",
            "verseOrgIds": [
              "DEU.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ wá àlàáfíà, tàbí ire wọn níwọ̀n ìgbà tí o sì wà láààyè.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.6",
            "verseOrgIds": [
              "DEU.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ kórìíra ará Edomu kan nítorí arákùnrin rẹ ni. Ìwọ kò gbọdọ̀ kórìíra ará Ejibiti, nítorí o gbé gẹ́gẹ́ bí àjèjì ní ilẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.7",
            "verseOrgIds": [
              "DEU.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìran kẹta àwọn ọmọ tí a bí fún wọn lè wọ ìpéjọ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.8",
            "verseOrgIds": [
              "DEU.23.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.8",
                "verseOrgIds": [
                  "DEU.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.8",
            "verseOrgIds": [
              "DEU.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìwà àìmọ́ nínú àgọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí o bá dó ti àwọn ọ̀tá rẹ, pa gbogbo ohun àìmọ́ kúrò.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.9",
            "verseOrgIds": [
              "DEU.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọ̀kan nínú àwọn ọkùnrin rẹ bá jẹ́ aláìmọ́ nítorí ìtújáde tí ó ní, o ní láti jáde kúrò nínú àgọ́, kí o má ṣe wọ inú àgọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.10",
            "verseOrgIds": [
              "DEU.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà tí ó bá di ìrọ̀lẹ́ o ní láti wẹ ara rẹ, àti ní àṣálẹ́ kí o padà sínú àgọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.11",
            "verseOrgIds": [
              "DEU.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sàmì sí ibìkan lóde àgọ́, níbi tí o lè máa lọ láti dẹ ara rẹ lára.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.12",
            "verseOrgIds": [
              "DEU.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ìwọ kí ó sì mú ìwalẹ̀ kan pẹ̀lú ohun ìjà rẹ; yóò sì ṣe, nígbà tí ìwọ yóò bá gbọnṣẹ̀ lẹ́yìn ibùdó, kí ìwọ kí ó mú ìwalẹ̀, kí ìwọ kí ó sì yípadà, kí o sì bo ohun tí ó jáde láara rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.13",
            "verseOrgIds": [
              "DEU.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.14",
            "verseOrgIds": [
              "DEU.23.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.14",
                "verseOrgIds": [
                  "DEU.23.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ ń rìn láàrín àgọ́ láti dáàbò bò ọ́ àti láti fi àwọn ọ̀tá à rẹ lé ọ lọ́wọ́. Àgọ́ rẹ ní láti jẹ́ mímọ́, nítorí kí ó má ba à rí ohun àìtọ́ láàrín yín kí ó sì yípadà kúrò lọ́dọ̀ yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.14",
            "verseOrgIds": [
              "DEU.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onírúurú òfin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹrú kan bá ti gba ààbò lọ́dọ̀ rẹ, má ṣe fi lé ọ̀gá rẹ̀ lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.15",
            "verseOrgIds": [
              "DEU.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí ó máa gbé láàrín rẹ níbikíbi tí ó bá fẹ́ àti èyíkéyìí ìlú tí ó bá mú. Má ṣe ni í lára.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.16",
            "verseOrgIds": [
              "DEU.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ọkùnrin tàbí obìnrin Israẹli má ṣe padà di alágbèrè ojúbọ òrìṣà.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.17",
            "verseOrgIds": [
              "DEU.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ mú owó iṣẹ́ panṣágà obìnrin tàbí ọkùnrin wá sí ilé",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.18",
                "verseOrgIds": [
                  "DEU.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ láti fi san ẹ̀jẹ́ kankan; nítorí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.18",
                "verseOrgIds": [
                  "DEU.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ kórìíra àwọn méjèèjì.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ ka èlé sí arákùnrin rẹ lọ́rùn, bóyá lórí owó tàbí oúnjẹ tàbí ohunkóhun mìíràn tí ó lè mú èlé wá.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.19",
            "verseOrgIds": [
              "DEU.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ lè ka èlé sí àlejò lọ́rùn, ṣùgbọ́n kì í ṣe arákùnrin ọmọ Israẹli, nítorí kí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.20",
                "verseOrgIds": [
                  "DEU.23.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ lè bùkún ọ nínú ohun gbogbo tí o bá dáwọ́lé ní ilẹ̀ tí ò ń wọ̀ lọ láti ní.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí o bá jẹ́ ẹ̀jẹ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.21",
                "verseOrgIds": [
                  "DEU.23.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ, má ṣe lọ́ra láti san án, nítorí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.21",
                "verseOrgIds": [
                  "DEU.23.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ yóò béèrè rẹ̀ lọ́wọ́ rẹ, o sì máa jẹ̀bi ẹ̀ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí o bá fàsẹ́yìn láti jẹ́ ẹ̀jẹ́, o kò ní jẹ̀bi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rí i dájú pé o ṣe ohunkóhun tí o bá ti ètè rẹ jáde, nítorí pé ìwọ fi tinútinú rẹ jẹ́ ẹ̀jẹ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.23",
                "verseOrgIds": [
                  "DEU.23.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ pẹ̀lú ẹnu ara rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá wọ inú ọgbà àjàrà aládùúgbò rẹ, o lè jẹ gbogbo èso àjàrà tí o bá fẹ́, ṣùgbọ́n má ṣe fi nǹkan kan sínú agbọ̀n rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.24",
            "verseOrgIds": [
              "DEU.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá wọ inú oko ọkà aládùúgbò rẹ, o lè fi ọwọ́ rẹ ya síírí rẹ̀, ṣùgbọ́n o kò gbọdọ̀ ki dòjé bọ ọkà tí ó dúró.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.25",
            "verseOrgIds": [
              "DEU.23.26"
            ]
          }
        }
      ]
    }
