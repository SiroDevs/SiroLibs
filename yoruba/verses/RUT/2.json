              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi sì wí fún un pé, \"Kí",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.20",
            "verseOrgIds": [
              "RUT.2.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "RUT.2.20",
                "verseOrgIds": [
                  "RUT.2.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí ó bùkún fún ọkùnrin náà. Ọlọ́run kò dáwọ́ oore àti àánú ṣíṣe sí àwọn alààyè àti òkú dúró.\" Naomi sì sọ síwájú sí i wí pé, \"Ìbátan tí ó súnmọ́ wa pẹ́kípẹ́kí ni ọkùnrin náà ń ṣe, ó sì jẹ́ ọ̀kan nínú àwọn tí ó ní ẹ̀tọ́ láti ra ohun ìní ìdílé padà.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.20",
            "verseOrgIds": [
              "RUT.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
