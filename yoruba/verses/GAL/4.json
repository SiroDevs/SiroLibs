              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ ará, ọmọ ìlérí ni àwa gẹ́gẹ́ bí Isaaki.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.28",
            "verseOrgIds": [
              "GAL.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GAL 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí èyí tí a bí nípa ti ara ti ṣe inúnibíni nígbà náà sí èyí tí a bí nípa ti Ẹ̀mí, bẹ́ẹ̀ sì ni nísinsin yìí.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.29",
            "verseOrgIds": [
              "GAL.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GAL 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìwé mímọ́ ha ti wí, \"Lé ẹrúbìnrin yìí àti ọmọ rẹ̀ jáde, nítorí ọmọ ẹrúbìnrin kì yóò bá ọmọ òmìnira obìnrin jogún pọ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.30",
            "verseOrgIds": [
              "GAL.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GAL 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, ará, àwa kì í ṣe ọmọ ẹrúbìnrin bí kò ṣe ti òmìnira obìnrin.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.31",
