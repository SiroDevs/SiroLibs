  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "MRK 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu bọ́ ẹgbàajì (4,000) ènìyàn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kan, bí ọ̀pọ̀ ènìyàn ti péjọ, kò sí oúnjẹ fún wọn mọ́ láti jẹ. Jesu pe àwọn ọmọ-ẹ̀yìn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.1",
            "verseOrgIds": [
              "MRK.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.2",
            "verseOrgIds": [
              "MRK.8.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Àánú ọ̀pọ̀ ènìyàn wọ̀nyí ṣe mí nítorí pé ó tó ọjọ́ mẹ́ta tí wọ́n ti wà níhìn-ín, kò sì sí ohun kan tí ó kù sílẹ̀ fún wọn láti jẹ.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.2",
                "verseOrgIds": [
                  "MRK.8.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.2",
            "verseOrgIds": [
              "MRK.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bí mo bá sọ fún wọn láti máa lọ sí ilé wọn bẹ́ẹ̀ pẹ̀lú ebi, wọn yóò dákú lójú ọ̀nà, nítorí pé àwọn mìíràn nínú wọn ti ọ̀nà jíjìn wá.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.3",
                "verseOrgIds": [
                  "MRK.8.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ-ẹ̀yìn rẹ̀ béèrè pé, \"Níbo ni a ó ti rí àkàrà tí ó tó láti fi bọ́ wọn nínú aṣálẹ̀ yìí?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.4",
            "verseOrgIds": [
              "MRK.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu béèrè lọ́wọ́ wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.5",
            "verseOrgIds": [
              "MRK.8.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ìṣù àkàrà mélòó lẹ ní lọ́wọ́?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.5",
                "verseOrgIds": [
                  "MRK.8.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 8:5"
      },
      "items": [
        {
          "text": "Wọ́n fèsì pé, \"Ìṣù àkàrà méje.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.5",
            "verseOrgIds": [
              "MRK.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, ó pàṣẹ fún àwọn ènìyàn náà láti jókòó lórí ilẹ̀. Ó sì mú odindi àkàrà méje náà, ó dúpẹ́ lọ́wọ́ Ọlọ́run, ó sì bù wọ́n sí wẹ́wẹ́, ó pín wọn fún àwọn ọmọ-ẹ̀yìn rẹ̀ láti gbé ka iwájú àwọn ènìyàn, wọ́n sì ṣe bẹ́ẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.6",
            "verseOrgIds": [
              "MRK.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n rí àwọn ẹja wẹ́wẹ́ díẹ̀ pẹ̀lú. Jesu tún dúpẹ́ lọ́wọ́ Ọlọ́run fún ìpèsè náà, ó sì pàṣẹ fún àwọn ọmọ-ẹ̀yìn rẹ̀ láti pín wọn fún àwọn ènìyàn náà.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.7",
            "verseOrgIds": [
              "MRK.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ọ̀pọ̀ ènìyàn náà ló jẹ àjẹyó àti àjẹtẹ́rùn. Lẹ́yìn èyí wọ́n kó àjẹkù ti ó kù jọ, agbọ̀n méje sì kún.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.8",
            "verseOrgIds": [
              "MRK.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó jẹ ẹ́ tó ìwọ̀n ẹgbàajì (4,000) ènìyàn, ó sì rán wọn lọ.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.9",
            "verseOrgIds": [
              "MRK.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́sẹ̀kẹsẹ̀, lẹ́yìn èyí, Jesu wọ inú ọkọ̀ ojú omi pẹ̀lú àwọn ọmọ-ẹ̀yìn rẹ̀, wọ́n sì gúnlẹ̀ sí agbègbè Dalmanuta.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.10",
            "verseOrgIds": [
              "MRK.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn Farisi tọ Jesu wá, wọ́n sì bẹ̀rẹ̀ sí béèrè ìbéèrè lọ́wọ́ rẹ̀. Láti dán an wò, wọ́n béèrè fún àmì láti ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.11",
            "verseOrgIds": [
              "MRK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu mí kanlẹ̀, nígbà tí ó gbọ́ ìbéèrè wọn. Ó sì dáhùn wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.12",
            "verseOrgIds": [
              "MRK.8.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èéṣe tí ìran yìí fi ń wá àmì? Lóòótọ́ ni mo sọ fún un yín kò si àmì tí a ó fi fún ìran yín.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.12",
                "verseOrgIds": [
                  "MRK.8.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.12",
            "verseOrgIds": [
              "MRK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ó padà sínú ọkọ̀ ojú omi ó fi àwọn ènìyàn sílẹ̀, ó sì rékọjá sí apá kejì Òkun náà.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.13",
            "verseOrgIds": [
              "MRK.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìwúkàrà àwọn Farisi àti Herodu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn ọmọ-ẹ̀yìn ti gbàgbé láti mú àkàrà tí yóò tó wọn ọ́n jẹ lọ́wọ́. Ẹyọ ìṣù àkàrà kan ṣoṣo ni ó wà nínú ọkọ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.14",
            "verseOrgIds": [
              "MRK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí wọ́n sì ti ń rékọjá, Jesu kìlọ̀ fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.15",
            "verseOrgIds": [
              "MRK.8.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ máa ṣọ́ra nítorí ìwúkàrà àwọn Farisi àti ìwúkàrà Herodu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.15",
                "verseOrgIds": [
                  "MRK.8.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n bẹ̀rẹ̀ sí ronú èyí láàrín ara wọn wí pé, \"Torí pé a kò mú àkàrà lọ́wọ́ ni?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.16",
            "verseOrgIds": [
              "MRK.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu mọ ohun tí wọ́n sọ láàrín ara wọn, ó sì dá wọn lóhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.17",
            "verseOrgIds": [
              "MRK.8.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èéṣe ti ẹ̀yin fi ń ṣe àròyé pé ẹ̀yin kò mú àkàrà lọ́wọ́? Ẹ̀yin kò kíyèsi i títí di ìsinsin yìí, ẹ kò sì ti mòye, àbí ọkàn yín le ni.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.17",
                "verseOrgIds": [
                  "MRK.8.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.17",
            "verseOrgIds": [
              "MRK.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ̀yin ní ojú, ẹ kò fi ríran? Ẹ̀yin ni etí ẹ kò sí gbọ́ran? Ẹ̀yin kò sì rántí?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.18",
                "verseOrgIds": [
                  "MRK.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.18",
            "verseOrgIds": [
              "MRK.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà ti mo bu ìṣù àkàrà márùn-ún fún ẹgbẹ̀rún márùn-ún (5,000) ènìyàn, agbọ̀n mélòó ni ó kún fún àjẹkù tí ẹ ṣàjọ?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.19",
                "verseOrgIds": [
                  "MRK.8.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 8:19"
      },
      "items": [
        {
          "text": "Wọ́n wí pé, \"Méjìlá.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.19",
            "verseOrgIds": [
              "MRK.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bákan náà, nígbà tí mo bọ́ ẹgbàajì (4,000) pẹ̀lú ìṣù àkàrà méje, agbọ̀n mélòó ló kù sílẹ̀ lẹ́yìn àjẹyó àti àjẹtẹ́rùn wọn?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.20",
                "verseOrgIds": [
                  "MRK.8.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 8:20"
      },
      "items": [
        {
          "text": "Wọ́n dáhùn pé, \"Ó ku ẹ̀kún agbọ̀n méje.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.20",
            "verseOrgIds": [
              "MRK.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.21",
            "verseOrgIds": [
              "MRK.8.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èéha ti ṣe tí kò fi yé yin?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.21",
                "verseOrgIds": [
                  "MRK.8.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìwòsàn ọkùnrin afọ́jú ní Betisaida",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n dé Betisaida, àwọn ènìyàn kan mú afọ́jú kan wá sọ́dọ̀ rẹ̀. Wọ́n bẹ̀ ẹ́ kí ó fi ọwọ́ kàn án, kí ó sì wò ó sàn.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.22",
            "verseOrgIds": [
              "MRK.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu fa ọkùnrin náà lọ́wọ́, ó sì mú un jáde lọ sí ẹ̀yìn ìlú. Ó tu itọ́ sí i lójú. Ó sì gbé ọwọ́ rẹ̀ lé ojú náà. Ó sì bi í léèrè pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.23",
            "verseOrgIds": [
              "MRK.8.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ǹjẹ́ ìwọ lè rí ohunkóhun nísinsin yìí?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.23",
                "verseOrgIds": [
                  "MRK.8.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin náà wo àyíká rẹ̀, ó sì dáhùn pé, \"Bẹ́ẹ̀ ni Olúwa, mo rí àwọn ènìyàn, ṣùgbọ́n n kò rí wọn kedere, wọ́n n rìn kiri bí àgékù igi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.24",
            "verseOrgIds": [
              "MRK.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, Jesu tún gbé ọwọ́ rẹ̀ méjèèjì lé àwọn ojú ọkùnrin náà, bí ọkùnrin náà sì ti ranjú mọ́ ọn, a dá ìran rẹ̀ padà, ó sì rí gbogbo nǹkan kedere.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.25",
            "verseOrgIds": [
              "MRK.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu sì rán an sí àwọn ẹbí rẹ̀. Ó kìlọ̀ fún un pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.26",
            "verseOrgIds": [
              "MRK.8.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Má ṣe lọ sí ìlú, kí o má sì sọ fún ẹnikẹ́ni ní ìlú.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.26",
                "verseOrgIds": [
                  "MRK.8.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Peteru jẹ́wọ́ ẹni tí Kristi jẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, Jesu àti àwọn ọmọ-ẹ̀yìn rẹ̀ kúrò ní Galili. Wọ́n sì jáde lọ sí àwọn abúlé ní agbègbè Kesarea-Filipi. Bí wọ́n ti ń lọ lọ́nà, ó béèrè lọ́wọ́ wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.27",
            "verseOrgIds": [
              "MRK.8.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ta ni àwọn ènìyàn ń fi mí pè?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.27",
                "verseOrgIds": [
                  "MRK.8.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ-ẹ̀yìn náà dáhùn pé, \"Àwọn kan rò pé ìwọ ni Johanu Onítẹ̀bọmi, àwọn mìíràn sọ pé, ìwọ ni Elijah tàbí àwọn wòlíì mìíràn ni ó tún padà wá sáyé.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.28",
            "verseOrgIds": [
              "MRK.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì bi wọ́n pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.29",
            "verseOrgIds": [
              "MRK.8.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ta ni ẹ̀yin ń fi mí pè?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.29",
                "verseOrgIds": [
                  "MRK.8.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 8:29"
      },
      "items": [
        {
          "text": "Peteru dáhùn pé, \"Ìwọ ni Kristi náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.29",
            "verseOrgIds": [
              "MRK.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jesu kìlọ̀ fún wọn, kí wọn má sọ èyí fún ẹnikẹ́ni.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.30",
            "verseOrgIds": [
              "MRK.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu sọ àsọtẹ́lẹ̀ nípa ikú ara rẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì bẹ̀rẹ̀ sí kọ́ wọn, pé, Ọmọ Ènìyàn kò le ṣàìmá jìyà ohun púpọ̀, a ó sì kọ̀ ọ́ sílẹ̀ láti ọwọ́ àwọn àgbàgbà, àwọn olórí àlùfáà àti àwọn olùkọ́ òfin, a ó sì pa á, lẹ́yìn ọjọ́ mẹ́ta yóò sì jíǹde.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.31",
            "verseOrgIds": [
              "MRK.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu bá wọn sọ̀rọ̀ yìí, láìfi ohunkóhun pamọ́ fún wọn, ṣùgbọ́n Peteru pe Jesu sẹ́yìn, ó sì bẹ̀rẹ̀ si bá a wí.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.32",
            "verseOrgIds": [
              "MRK.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu yípadà, ó wo àwọn ọmọ-ẹ̀yìn rẹ̀. Ó sì wí fún Peteru pẹ̀lú ìtara pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.33",
            "verseOrgIds": [
              "MRK.8.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kúrò lẹ́yìn mi Satani, nítorí ìwọ kò ro ohun tí Ọlọ́run bí kò ṣe ohun tí ènìyàn.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.33",
                "verseOrgIds": [
                  "MRK.8.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ̀nà sí àgbélébùú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Jesu pe àwọn ọmọ-ẹ̀yìn rẹ̀ àti ọ̀pọ̀ ènìyàn láti bá wọn sọ̀rọ̀, ó wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bí ẹnikẹ́ni bá fẹ́ tọ̀ mí lẹ́yìn, kí ó sẹ́ ara rẹ̀, kí ó si gbé àgbélébùú rẹ̀, kí ó si máa tọ̀ mi lẹ́yìn.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.34",
                "verseOrgIds": [
                  "MRK.8.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí ẹni tó bá gbìyànjú láti gba ẹ̀mí ara rẹ̀ là, yóò sọ ọ́ nù. Iye àwọn tí ó sọ ẹ̀mí wọn nù nìkan nítorí í tèmi àti nítorí ìyìnrere, òun náà ni yóò gbà á là.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.35",
                "verseOrgIds": [
                  "MRK.8.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.35",
            "verseOrgIds": [
              "MRK.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí èrè kí ni ó jẹ́ fún ẹni tí ó jèrè gbogbo ayé, tí ó sọ ẹ̀mí rẹ̀ nù?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.36",
                "verseOrgIds": [
                  "MRK.8.36"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.36",
            "verseOrgIds": [
              "MRK.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tàbí kí ni ènìyàn yóò fi ṣe pàṣípàrọ̀ ẹ̀mí rẹ̀?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.37",
                "verseOrgIds": [
                  "MRK.8.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.37",
            "verseOrgIds": [
              "MRK.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí náà, bí ẹnikẹ́ni bá tijú àti gbà mí tàbí ọ̀rọ̀ mi nínú ìran panṣágà àti ẹlẹ́ṣẹ̀ yìí, tí ó kún fún àìgbàgbọ́ àti ẹ̀ṣẹ̀ báyìí, Ọmọ Ènìyàn yóò tijú rẹ̀ nígbà tí ó bá padà dé nínú ògo Baba rẹ̀, pẹ̀lú àwọn angẹli mímọ́.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.38",
                "verseOrgIds": [
                  "MRK.8.38"
                ]
              }
            }
          ]
        }
      ]
    }
