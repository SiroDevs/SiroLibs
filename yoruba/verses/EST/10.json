            "number": "1",
            "style": "v",
            "sid": "EST 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Ahaswerusi sì fi owó ọba lélẹ̀ jákèjádò ilẹ̀ ọba, dé erékùṣù òkun.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ìṣe agbára àti títóbi rẹ̀, papọ̀ pẹ̀lú ìròyìn títóbi Mordekai ní èyí tí ọba ti gbé e ga, kò ha wà nínú àkọsílẹ̀ ìwé ọdọọdún ọba ti Media àti ti Persia?",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mordekai ará Júù ni ó jẹ́ igbákejì ọba Ahaswerusi, ó tóbi láàrín àwọn Júù, ó sì jẹ́ ẹni iyì lọ́dọ̀ àwọn Júù ẹlẹgbẹ́ ẹ rẹ̀, nítorí tí ó ń ṣiṣẹ́ fún ìre àwọn ènìyàn an rẹ̀, ó sì ń sọ̀rọ̀ fún àlàáfíà gbogbo àwọn Júù.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
