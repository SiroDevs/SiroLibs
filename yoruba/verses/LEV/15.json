  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "LEV 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìsunjáde láti inú ara ti ń sọ ni di aláìmọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.15.1",
                "verseOrgIds": [
                  "LEV.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose àti Aaroni pé,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.1",
            "verseOrgIds": [
              "LEV.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ bá àwọn ọmọ Israẹli sọ̀rọ̀, kí ẹ wí fún wọn pé, 'Bí ìsunjáde bá ń jáde lára ọkùnrin kan lójú ara, ìsunjáde náà jẹ́ àìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.2",
            "verseOrgIds": [
              "LEV.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yálà ó ń jáde léraléra tàbí ó dúró, èyí yóò sọ ọ́ di aláìmọ́. Báyìí ni ìsunjáde rẹ̀ ṣe le è sọ ọ́ di aláìmọ́:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.3",
            "verseOrgIds": [
              "LEV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Gbogbo ibùsùn tí irú ẹni tí ó ní ìsunjáde náà bá sùn di àìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.4",
            "verseOrgIds": [
              "LEV.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹnikẹ́ni bá fi ara kan ibùsùn rẹ̀, ó gbọdọ̀ fọ aṣọ rẹ̀ kí ó sì wẹ̀. Yóò sì wà ní ipò àìmọ́ títí ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.5",
            "verseOrgIds": [
              "LEV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó bá jókòó lórí ohunkóhun tí ọkùnrin tí ó ní ìsunjáde bá jókòó le gbọdọ̀ fọ aṣọ rẹ̀, kí ó sì wẹ̀, kí ó sì wà láìmọ́ títí di ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.6",
            "verseOrgIds": [
              "LEV.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ẹnikẹ́ni tí ó bá fọwọ́ kan ọkùnrin náà tí ó ní ìsunjáde gbọdọ̀ fọ aṣọ rẹ̀, kí ó sì wẹ̀, yóò sì di aláìmọ́ títí di ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.7",
            "verseOrgIds": [
              "LEV.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹni tí ó ní ìsunjáde bá tu itọ́ sí ẹni tí ó mọ́ lára, ẹni tí ó mọ́ náà gbọdọ̀ fọ aṣọ rẹ̀ kí ó sì wẹ̀, yóò sì wà ní ipò àìmọ́ títí di ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.8",
            "verseOrgIds": [
              "LEV.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Gàárì ẹranko tí ẹni náà bá gùn yóò di àìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.9",
            "verseOrgIds": [
              "LEV.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó bá fọwọ́ kan ohunkóhun tí ó wà lábẹ́ ọkùnrin náà di aláìmọ́ títí di ìrọ̀lẹ́. Ẹnikẹ́ni tí ó bá mú irú nǹkan bẹ́ẹ̀ gbọdọ̀ fọ aṣọ rẹ̀, kí ó wẹ ara rẹ̀. Yóò sì jẹ́ aláìmọ́ títí di ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.10",
            "verseOrgIds": [
              "LEV.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ẹnikẹ́ni tí ọkùnrin tí ó ní ìsunjáde ní ara rẹ̀ bá fi ara kàn láìfi omi fọ ọwọ́ rẹ̀, gbọdọ̀ fọ aṣọ rẹ̀ kí ó sì wẹ̀. Yóò sì wà ní ipò àìmọ́ títí ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.11",
            "verseOrgIds": [
              "LEV.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ìkòkò amọ̀ tí ọkùnrin náà bá fọwọ́ kàn ni kí ẹ fọ́, gbogbo ohun èlò igi tí ó fọwọ́ kàn ni kí ẹ fi omi sàn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.12",
            "verseOrgIds": [
              "LEV.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ẹnikẹ́ni tí a bá wẹ̀nù kúrò nínú ìsunjáde rẹ̀ gbọdọ̀ ka ọjọ́ méje fún àwọn ọjọ́ ìwẹ̀nùmọ́: kí ó fọ aṣọ rẹ̀, kí ó sì fi omi wẹ ara rẹ̀, yóò sì di mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.13",
            "verseOrgIds": [
              "LEV.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹjọ kí ó mú àdàbà méjì tàbí ọmọ ẹyẹlé méjì, kí ó sì wá sí ẹnu-ọ̀nà àgọ́ ìpàdé níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.14",
            "verseOrgIds": [
              "LEV.15.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.15.14",
                "verseOrgIds": [
                  "LEV.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí ó sì kó wọn fún àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.14",
            "verseOrgIds": [
              "LEV.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí àlùfáà fi wọ́n rú ẹbọ: ọ̀kan fún ọrẹ ẹ̀ṣẹ̀ àti èkejì fún ọrẹ ẹbọ sísun níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.15",
            "verseOrgIds": [
              "LEV.15.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.15.15",
                "verseOrgIds": [
                  "LEV.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ní ipò ọkùnrin náà nítorí ìsunjáde rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.15",
            "verseOrgIds": [
              "LEV.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí nǹkan ọkùnrin kan bá tú jáde, kí ó wẹ gbogbo ara rẹ̀, kí ó wà ní ipò àìmọ́ títí ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.16",
            "verseOrgIds": [
              "LEV.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yálà àwọ̀ tàbí aṣọ tí nǹkan ọkùnrin bá dà sí lórí ni kí ẹ fọ̀, yóò sì wà ní ipò àìmọ́ di ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.17",
            "verseOrgIds": [
              "LEV.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọkùnrin kan bá bá obìnrin lòpọ̀ tí nǹkan ọkùnrin sì tú jáde lára rẹ̀. Àwọn méjèèjì gbọdọ̀ fi omi wẹ̀, kí wọ́n sì wà ní ipò àìmọ́ títí di ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.18",
            "verseOrgIds": [
              "LEV.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí obìnrin bá ń ṣe nǹkan oṣù rẹ̀, obìnrin yìí wà ní àìmọ́ títí di ọjọ́ méje. Ẹnikẹ́ni tí ó bá fọwọ́ kàn án yóò wà ní ipò àìmọ́ títí ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.19",
            "verseOrgIds": [
              "LEV.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Gbogbo ohun tí ó bá sùn lé ní àkókò nǹkan oṣù rẹ̀ di àìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.20",
            "verseOrgIds": [
              "LEV.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó bá fọwọ́ kan ibùsùn rẹ̀ gbọdọ̀ fọ aṣọ rẹ̀ kí ó sì wẹ̀, yóò sì wà ní ipò àìmọ́ títí di ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.21",
            "verseOrgIds": [
              "LEV.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó bá fọwọ́ kan ohunkóhun tí ó bá jókòó lé gbọdọ̀ fọ aṣọ rẹ̀, kí ó sì wẹ̀, yóò sì wà ní ipò àìmọ́ títí di ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.22",
            "verseOrgIds": [
              "LEV.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbá à ṣe ibùsùn tàbí ohunkóhun tí ó jókòó lé. Ẹnikẹ́ni tí ó bá fọwọ́ kàn án yóò jẹ́ aláìmọ́ títí di ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.23",
            "verseOrgIds": [
              "LEV.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ọkùnrin kan bá bá a lòpọ̀, tí nǹkan oṣù rẹ̀ sì kàn án lára, yóò jẹ́ aláìmọ́ fún ọjọ́ méje, gbogbo ibùsùn tí ọkùnrin náà bá sùn yóò jẹ́ aláìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.24",
            "verseOrgIds": [
              "LEV.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí obìnrin bá ní ìsun ẹ̀jẹ̀ fún ọjọ́ púpọ̀ yálà sí àkókò nǹkan oṣù rẹ̀ tàbí tí nǹkan oṣù rẹ̀ bá kọjá ìgbà tí ó yẹ. Gbogbo ìgbà tí ó bá fi ń ní ìsun ẹ̀jẹ̀ náà ni yóò fi wà ní àìmọ́ gẹ́gẹ́ bí àkókò nǹkan oṣù rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.25",
            "verseOrgIds": [
              "LEV.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibùsùn tí ó wù kí ó sùn sí ní gbogbo ìgbà tí ẹ̀jẹ̀ náà ń wá yóò jẹ́ àìmọ́ bí ibùsùn rẹ̀ ṣe jẹ́ ní àkókò nǹkan oṣù rẹ̀. Gbogbo ohun tí ó bá jókòó lé yóò wà ní àìmọ́, gẹ́gẹ́ bí àkókò nǹkan oṣù rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.26",
            "verseOrgIds": [
              "LEV.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó bá fọwọ́ kàn wọ́n yóò wà ní àìmọ́. Ó gbọdọ̀ fọ aṣọ rẹ̀, kí ó sì wẹ̀ kí ó sì wà ní àìmọ́ títí di ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.27",
            "verseOrgIds": [
              "LEV.15.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nígbà tí ó bá di mímọ́ kúrò nínú ìsun rẹ̀, kí ó ka ọjọ́ méje lẹ́yìn náà, a ó kà á sí mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.28",
            "verseOrgIds": [
              "LEV.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹjọ kí ó mú àdàbà méjì àti ọmọ ẹyẹlé wá síwájú àlùfáà ní ẹnu-ọ̀nà àgọ́ ìpàdé.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.29",
            "verseOrgIds": [
              "LEV.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí àlùfáà fi ọ̀kan rú ẹbọ ẹ̀ṣẹ̀ àti èkejì fún ẹbọ sísun. Báyìí ni yóò ṣe ètùtù fún un, níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.30",
            "verseOrgIds": [
              "LEV.15.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.15.30",
                "verseOrgIds": [
                  "LEV.15.30"
                ]
              }
            }
          ]
        },
        {
          "text": "fún àìmọ́ ìsun ẹ̀jẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.30",
            "verseOrgIds": [
              "LEV.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ẹ ya ará Israẹli sọ́tọ̀ kúrò nínú ohun tí ó ń sọ wọ́n di aláìmọ́, kí wọ́n má bá a kú nínú àìmọ́ wọn nípa bíba ibùgbé mímọ́ mi jẹ́, èyí tí ó wà láàrín wọn.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.31",
            "verseOrgIds": [
              "LEV.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ̀nyí ni àwọn òfin fún ọkùnrin tí ó ni ìsunjáde fún ẹnikẹ́ni tí a sọ di àìmọ́ nípa ìsunjáde nǹkan ọkùnrin rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.32",
            "verseOrgIds": [
              "LEV.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún obìnrin ní nǹkan oṣù rẹ̀, fún ọkùnrin tàbí obìnrin tí ó ní ìsunjáde, àti fún ọkùnrin tí ó ní ìbálòpọ̀ pẹ̀lú obìnrin tí ó jẹ́ aláìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.33",
            "verseOrgIds": [
              "LEV.15.33"
            ]
          }
        }
      ]
    }
  ],
