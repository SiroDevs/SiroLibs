        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.1",
                "verseOrgIds": [
                  "LEV.22.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.1",
            "verseOrgIds": [
              "LEV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún Aaroni àti àwọn ọmọ rẹ̀ kí wọ́n fi ọ̀wọ̀ fún ọrẹ mímọ́ tí àwọn ọmọ Israẹli yà sọ́tọ̀ fún mi, kí wọ́n má ba à ba orúkọ mímọ́ mi jẹ́. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.2",
            "verseOrgIds": [
              "LEV.22.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.2",
                "verseOrgIds": [
                  "LEV.22.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.2",
            "verseOrgIds": [
              "LEV.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún wọn pé, 'Fún àwọn ìran tí ń bọ̀. Bí ẹnikẹ́ni nínú àwọn ọmọ yín tí kò mọ́ bá wá sí ibi ọrẹ mímọ́ tí àwọn ara Israẹli ti yà sọ́tọ̀ fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.3",
            "verseOrgIds": [
              "LEV.22.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.3",
                "verseOrgIds": [
                  "LEV.22.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí ẹ yọ ẹni náà kúrò nínú iṣẹ́ àlùfáà ní iwájú mi. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.3",
            "verseOrgIds": [
              "LEV.22.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.3",
                "verseOrgIds": [
                  "LEV.22.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.3",
            "verseOrgIds": [
              "LEV.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ọ̀kan nínú àwọn ọmọ Aaroni bá ní ààrùn ara tí ń ran ni, tàbí ìtújáde nínú ara. Ó lè má jẹ ọrẹ mímọ́ náà títí di ìgbà tí a ó fi wẹ̀ ẹ́ mọ́. Òun tún lè di aláìmọ́ bí ó bá fọwọ́ kan ohunkóhun tí òkú nǹkan bá sọ di àìmọ́ tàbí bí ó bá farakan ẹnikẹ́ni tí ó ní ìtújáde.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.4",
            "verseOrgIds": [
              "LEV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tàbí bí ó bá fọwọ́ kan èyíkéyìí nínú ohun tí ń rákò, tí ó sọ ọ́ di aláìmọ́, tàbí ẹnikẹ́ni tí ó sọ ọ́ di àìmọ́, ohunkóhun yówù kí àìmọ́ náà jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.5",
            "verseOrgIds": [
              "LEV.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni náà tí ó fọwọ́ kan irú nǹkan bẹ́ẹ̀ yóò di aláìmọ́ títí ìrọ̀lẹ́. Kò gbọdọ̀ jẹ èyíkéyìí nínú ọrẹ mímọ́ àyàfi bí ó bá wẹ ara rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.6",
            "verseOrgIds": [
              "LEV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí oòrùn bá wọ̀, ẹni náà di mímọ́, lẹ́yìn náà ni ó tó le jẹ ọrẹ mímọ́, torí pé wọ́n jẹ́ oúnjẹ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.7",
            "verseOrgIds": [
              "LEV.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò gbọdọ̀ jẹ ohunkóhun tí ó bá ti kú sílẹ̀, tàbí tí ẹranko fàya, kí ó sì tipa bẹ́ẹ̀ di aláìmọ́. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.8",
            "verseOrgIds": [
              "LEV.22.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.8",
                "verseOrgIds": [
                  "LEV.22.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.8",
            "verseOrgIds": [
              "LEV.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kí àwọn àlùfáà pa ìlànà mi mọ́, kí wọn má ba à jẹ̀bi, kí wọn sì kú nítorí pé wọ́n ṣe ọrẹ wọ̀nyí pẹ̀lú fífojútẹ́ńbẹ́lú wọn. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.9",
                "verseOrgIds": [
                  "LEV.22.9"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó sọ wọ́n di mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kò sí ẹnikẹ́ni lẹ́yìn ìdílé àlùfáà tí ó le jẹ ọrẹ mímọ́ náà, bẹ́ẹ̀ ni, àlejò àlùfáà tàbí alágbàṣe rẹ̀ kò le jẹ ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.10",
            "verseOrgIds": [
              "LEV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí àlùfáà bá ra ẹrú, pẹ̀lú owó, tàbí tí a bí ẹrú kan nínú ìdílé rẹ̀, ẹrú náà lè jẹ oúnjẹ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.11",
            "verseOrgIds": [
              "LEV.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọmọbìnrin àlùfáà bá fẹ́ ẹni tí kì í ṣe àlùfáà, kò gbọdọ̀ jẹ nínú èyíkéyìí nínú ohun ọrẹ mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.12",
            "verseOrgIds": [
              "LEV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ọmọbìnrin àlùfáà bá jẹ́ opó tàbí tí a ti kọ ọ́ sílẹ̀, ṣùgbọ́n tí kò lọ́mọ tí ó sì padà sínú ilé baba rẹ̀ láti máa gbé bẹ̀, gẹ́gẹ́ bí ìgbà èwe rẹ̀, ó le jẹ oúnjẹ baba rẹ̀. Bí ó ti wù kí ó rí, àlejò tí kò lẹ́tọ̀ọ́ kò gbọdọ̀ jẹ èyíkéyìí nínú oúnjẹ náà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.13",
            "verseOrgIds": [
              "LEV.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹnikẹ́ni bá ṣèèṣì jẹ ọrẹ mímọ́ kan, ó gbọdọ̀ ṣe àtúnṣe lórí ẹbọ náà fún àlùfáà, kí ó sì fi ìdámárùn-ún ohun tí ọrẹ náà jẹ́ kún un.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.14",
            "verseOrgIds": [
              "LEV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlùfáà kò gbọdọ̀ sọ ọrẹ mímọ́ tí àwọn ọmọ Israẹli mú wá síwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.15",
            "verseOrgIds": [
              "LEV.22.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.15",
                "verseOrgIds": [
                  "LEV.22.15"
                ]
              }
            }
          ]
        },
        {
          "text": "di àìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.15",
            "verseOrgIds": [
              "LEV.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa fífi ààyè fún wọn láti jẹ ọrẹ mímọ́ náà, kí wọ́n sì tipa bẹ́ẹ̀ mú ẹ̀bi tí wọn yóò san nǹkan fún wá sórí wọn. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
              "LEV.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.16",
                "verseOrgIds": [
                  "LEV.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", tí ó sọ wọ́n di mímọ́.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
              "LEV.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ọrẹ ẹbọ tí kò jẹ́ ìtẹ́wọ́gbà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.17",
                "verseOrgIds": [
                  "LEV.22.17"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.17",
            "verseOrgIds": [
              "LEV.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún Aaroni, àwọn ọmọ rẹ̀ àti fún gbogbo Israẹli kí o sì wí fún wọn pé, 'Bí ẹnikẹ́ni nínú yín yálà ọmọ Israẹli ni tàbí àlejò tí ń gbé ní Israẹli bá mú ẹ̀bùn wá fún ọrẹ ẹbọ sísun sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.18",
            "verseOrgIds": [
              "LEV.22.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.18",
                "verseOrgIds": [
                  "LEV.22.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", yálà láti san ẹ̀jẹ́ tàbí ọrẹ àtinúwá.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.18",
            "verseOrgIds": [
              "LEV.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gbọdọ̀ mú akọ láìní àbùkù láti ara màlúù, àgùntàn tàbí ewúrẹ́, kí ó ba à lè jẹ́ ìtẹ́wọ́gbà fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.19",
            "verseOrgIds": [
              "LEV.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe mú ohunkóhun tí ó ní àbùkù wá, torí pé kò ní jẹ́ ìtẹ́wọ́gbà fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.20",
            "verseOrgIds": [
              "LEV.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹnikẹ́ni bá mú ọrẹ àlàáfíà wá láti inú agbo màlúù tàbí ti àgùntàn, fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.21",
            "verseOrgIds": [
              "LEV.22.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.21",
                "verseOrgIds": [
                  "LEV.22.21"
                ]
              }
            }
          ]
        },
        {
          "text": "láti san ẹ̀jẹ́ pàtàkì tàbí fún ọrẹ àtinúwá. Ó gbọdọ̀ jẹ́ ìtẹ́wọ́gbà láìní àbùkù.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.21",
            "verseOrgIds": [
              "LEV.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe fi ẹranko tí ó fọ́jú, tí ó fi ara pa, tí ó yarọ, tí ó ní kókó, tí ó ní èkúkú, èépá àti egbò kíkẹ̀ rú ẹbọ sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.22",
            "verseOrgIds": [
              "LEV.22.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.22",
                "verseOrgIds": [
                  "LEV.22.22"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ẹ kò gbọdọ̀ gbé èyíkéyìí nínú wọn sórí pẹpẹ gẹ́gẹ́ bi ọrẹ tí a fi iná ṣe sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.22",
            "verseOrgIds": [
              "LEV.22.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.22",
                "verseOrgIds": [
                  "LEV.22.22"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.22",
            "verseOrgIds": [
              "LEV.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ le mú màlúù tàbí àgùntàn tí ó ní àbùkù tàbí tí ó yọ iké wá fún ọrẹ àtinúwá, ṣùgbọ́n kò jẹ́ ìtẹ́wọ́gbà fún ọrẹ ẹ̀jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.23",
            "verseOrgIds": [
              "LEV.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe fi ẹranko tí kóró ẹpọ̀n rẹ̀ fọ́ tàbí tí a tẹ̀, tàbí tí a yà tàbí tí a là rú ẹbọ sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.24",
            "verseOrgIds": [
              "LEV.22.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.24",
                "verseOrgIds": [
                  "LEV.22.24"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ẹ kò gbọdọ̀ ṣe èyí ní ilẹ̀ yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.24",
            "verseOrgIds": [
              "LEV.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kò gbọdọ̀ gba irú ẹranko bẹ́ẹ̀ lọ́wọ́ àlejò kankan láti fi rú ẹbọ gẹ́gẹ́ bí oúnjẹ sí Ọlọ́run yín. A kò nígbà wọ́n fún yín nítorí pé wọ́n ní àbùkù, wọ́n sì díbàjẹ́.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.25",
            "verseOrgIds": [
              "LEV.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.26",
                "verseOrgIds": [
                  "LEV.22.26"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.26",
            "verseOrgIds": [
              "LEV.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà tí màlúù bá bímọ, tí àgùntàn bímọ, tí ewúrẹ́ sì bímọ, ọmọ náà gbọdọ̀ wà pẹ̀lú ìyá rẹ̀ fún ọjọ́ méje. Láti ọjọ́ kẹjọ ni ó ti di ìtẹ́wọ́gbà fún ọrẹ àfinásun sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.27",
            "verseOrgIds": [
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.27",
                "verseOrgIds": [
                  "LEV.22.27"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.27",
            "verseOrgIds": [
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe pa màlúù àti ọmọ rẹ̀ tàbí àgùntàn àti ọmọ rẹ̀ ní ọjọ́ kan náà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.28",
            "verseOrgIds": [
              "LEV.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà tí ẹ bá rú ẹbọ ọpẹ́ sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.29",
                "verseOrgIds": [
                  "LEV.22.29"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹ rú u ní ọ̀nà tí yóò fi jẹ́ ìtẹ́wọ́gbà fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gbọdọ̀ jẹ ẹ́ ní ọjọ́ náà gan an, ẹ má ṣe ṣẹ́ ọ̀kankan kù di àárọ̀. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.30",
                "verseOrgIds": [
                  "LEV.22.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ pa òfin mi mọ́, kí ẹ sì máa ṣe wọ́n. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
              "LEV.22.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.31",
                "verseOrgIds": [
                  "LEV.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
              "LEV.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe ba orúkọ mímọ́ mi jẹ́. Àwọn ọmọ Israẹli gbọdọ̀ mọ̀ mí ní mímọ́. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.32",
                "verseOrgIds": [
                  "LEV.22.32"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó sọ yín di mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí ó sì mú yín jáde láti Ejibiti wá láti jẹ́ Ọlọ́run yín. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.33",
            "verseOrgIds": [
              "LEV.22.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.33",
                "verseOrgIds": [
                  "LEV.22.33"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.33",
            "verseOrgIds": [
              "LEV.22.33"
            ]
          }
        }
      ]
