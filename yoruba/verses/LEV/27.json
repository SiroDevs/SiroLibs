      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìràpadà ohun tí ó jẹ́ ti",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.1",
                "verseOrgIds": [
                  "LEV.27.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.1",
            "verseOrgIds": [
              "LEV.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún àwọn ọmọ Israẹli pé, 'Bí ẹnìkan bá jẹ́ ẹ̀jẹ́ pàtàkì láti ya ènìyàn kan sọ́tọ̀ fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.2",
            "verseOrgIds": [
              "LEV.27.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.2",
                "verseOrgIds": [
                  "LEV.27.2"
                ]
              }
            }
          ]
        },
        {
          "text": "nípa sísan iye tí ó tó,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.2",
            "verseOrgIds": [
              "LEV.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí iye owó ọkùnrin láti ọmọ ogún ọdún sí ọgọ́ta ọdún jẹ́ àádọ́ta òsùwọ̀n ṣékélì fàdákà, gẹ́gẹ́ bí òsùwọ̀n ṣékélì ti ibi mímọ́",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.3",
            "verseOrgIds": [
              "LEV.27.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.3",
                "verseOrgIds": [
                  "LEV.27.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.3",
            "verseOrgIds": [
              "LEV.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹni náà bá jẹ obìnrin, kí iye owó rẹ̀ jẹ́ ọgbọ̀n òsùwọ̀n ṣékélì.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.4",
            "verseOrgIds": [
              "LEV.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹni náà bá jẹ́ ọmọ ọdún márùn-ún sí ogún ọdún, kí iye owó rẹ̀ jẹ́ ogún ṣékélì fún ọkùnrin àti òsùwọ̀n ṣékélì mẹ́wàá fún obìnrin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.5",
            "verseOrgIds": [
              "LEV.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹni náà bá jẹ́ ọmọ oṣù kan sí ọdún márùn-ún, kí iye owó rẹ̀ jẹ́ òsùwọ̀n ṣékélì fàdákà márùn-ún fún ọkùnrin àti òsùwọ̀n ṣékélì fàdákà mẹ́ta fún obìnrin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.6",
            "verseOrgIds": [
              "LEV.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹni náà bá jẹ́ ọmọ ọgọ́ta ọdún àti jù bẹ́ẹ̀ lọ, kí iye owó rẹ̀ jẹ́ òsùwọ̀n ṣékélì mẹ́ẹ̀ẹ́dógún fún ọkùnrin àti òsùwọ̀n ṣékélì mẹ́wàá fún obìnrin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.7",
            "verseOrgIds": [
              "LEV.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹnìkan tí ó jẹ́ ẹ̀jẹ́ bá tálákà púpọ̀ dé bi pé kò lè san iye owó náà, kí a mú ẹni náà wá síwájú àlùfáà, àlùfáà yóò sì dá iye owó tí ó lè san lé e gẹ́gẹ́ bí agbára ẹni náà tí ó jẹ́ ẹ̀jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.8",
            "verseOrgIds": [
              "LEV.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹ̀jẹ́ tí ó jẹ́ bá jẹ́ ẹranko èyí tí ó jẹ́ ìtẹ́wọ́gbà gẹ́gẹ́ bí ọrẹ fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.9",
            "verseOrgIds": [
              "LEV.27.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.9",
                "verseOrgIds": [
                  "LEV.27.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", irú ẹran bẹ́ẹ̀ tí a bá fi fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.9",
            "verseOrgIds": [
              "LEV.27.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.9",
                "verseOrgIds": [
                  "LEV.27.9"
                ]
              }
            }
          ]
        },
        {
          "text": "di mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.9",
            "verseOrgIds": [
              "LEV.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó jẹ́ ẹ̀jẹ́ náà kò gbọdọ̀ pàrọ̀ ẹran mìíràn, yálà kí ó pàrọ̀ èyí tí ó dára sí èyí tí kò dára tàbí èyí tí kò dára sí èyí tí ó dára. Bí ó bá ṣe bẹ́ẹ̀ ti",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.10",
            "verseOrgIds": [
              "LEV.27.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.10",
                "verseOrgIds": [
                  "LEV.27.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ẹranko méjèèjì.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.10",
            "verseOrgIds": [
              "LEV.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ó bá jẹ́ ẹ̀jẹ́ ní ti ẹranko àìmọ́ tí a fi tọrẹ: èyí tí kò jẹ́ ìtẹ́wọ́gbà bí i ọrẹ fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.11",
            "verseOrgIds": [
              "LEV.27.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.11",
                "verseOrgIds": [
                  "LEV.27.11"
                ]
              }
            }
          ]
        },
        {
          "text": ". Kí ọkùnrin náà mú ọrẹ náà lọ fún àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.11",
            "verseOrgIds": [
              "LEV.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí àlùfáà díye lé e, gẹ́gẹ́ bí ó ti dára tàbí bí ó ti bàjẹ́ sí. Iye owó náà ni kí ó jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.12",
            "verseOrgIds": [
              "LEV.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹni náà bá fẹ́ rà á padà, ó gbọdọ̀ san iye owó rẹ̀ àti ìdá ogún iye owó náà láfikún.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.13",
            "verseOrgIds": [
              "LEV.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹnikẹ́ni bá ya ilẹ̀ rẹ̀ sí mímọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.14",
            "verseOrgIds": [
              "LEV.27.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.14",
                "verseOrgIds": [
                  "LEV.27.14"
                ]
              }
            }
          ]
        },
        {
          "text": ": kí àlùfáà kó sọ iye tí yóò san gẹ́gẹ́ bí ilẹ̀ náà ti dára tàbí bàjẹ́ sí, iye owó náà ni kí ó jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.14",
            "verseOrgIds": [
              "LEV.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹni tí ó yá ilé náà sí mímọ́ bá fẹ́ rà á padà. Jẹ́ kí ó fi ìdámárùn-ún owó ìdíyelé rẹ̀ kún ún, yóò si jẹ́ tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.15",
            "verseOrgIds": [
              "LEV.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹnìkan bá sì ya ara ilẹ̀ ìdílé rẹ̀ sí mímọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.16",
            "verseOrgIds": [
              "LEV.27.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.16",
                "verseOrgIds": [
                  "LEV.27.16"
                ]
              }
            }
          ]
        },
        {
          "text": ". Iye tí ó bá jẹ́ ni kí wọ́n ṣètò gẹ́gẹ́ bí iye èso tí a ó fi gbìn ín. Àádọ́ta ṣékélì fàdákà fún òsùwọ̀n homeri irúgbìn barle.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.16",
            "verseOrgIds": [
              "LEV.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ba ṣe pé ní ọdún ìdásílẹ̀ ni ó ya ilẹ̀ náà sí mímọ́. Iye owó tí wọn sọtẹ́lẹ̀ náà ni kí o san.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.17",
            "verseOrgIds": [
              "LEV.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá ya ilẹ̀ náà sí mímọ́ lẹ́yìn ọdún ìdásílẹ̀ kí àlùfáà sọ iye owó tí yóò san fún ọdún tókù kí ọdún ìdásílẹ̀ mìíràn tó pé iye owó tí ó gbọdọ̀ jẹ yóò dínkù.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.18",
            "verseOrgIds": [
              "LEV.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹni tí ó ya ilẹ̀ sí mímọ́ bá fẹ́ rà á padà, kí ó san iye owó náà pẹ̀lú àfikún ìdámárùn-ún. Ilẹ̀ náà yóò sì di tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.19",
            "verseOrgIds": [
              "LEV.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí kò bá ra ilẹ̀ náà padà tàbí bí ó bá tà á fún ẹlòmíràn kò le è ri rà padà mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.20",
            "verseOrgIds": [
              "LEV.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí a bá fi ilẹ̀ náà sílẹ̀ ní ọdún ìdásílẹ̀ yóò di mímọ́ gẹ́gẹ́ bí ilẹ̀ tí a fi fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.21",
            "verseOrgIds": [
              "LEV.27.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.21",
                "verseOrgIds": [
                  "LEV.27.21"
                ]
              }
            }
          ]
        },
        {
          "text": ". Yóò sì di ohun ìní àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.21",
            "verseOrgIds": [
              "LEV.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹnikẹ́ni bá ya ilẹ̀ tí ó ti rà tí kì í ṣe ilẹ̀ ìdílé rẹ̀ sí mímọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.22",
            "verseOrgIds": [
              "LEV.27.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.22",
                "verseOrgIds": [
                  "LEV.27.22"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.22",
            "verseOrgIds": [
              "LEV.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí àlùfáà sọ iye tí ó tọ títí di ọdún ìdásílẹ̀. Kí ọkùnrin náà sì san iye owó náà ní ọjọ́ náà gẹ́gẹ́ bí ohun mímọ́ sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
              "LEV.27.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.23",
                "verseOrgIds": [
                  "LEV.27.23"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
              "LEV.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún ìdásílẹ̀ ilẹ̀ náà yóò padà di ti ẹni tí ó ni í, lọ́wọ́ ẹni tí a ti rà á.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.24",
            "verseOrgIds": [
              "LEV.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo iye owó wọ̀nyí gbọdọ̀ wà ní ìbámu pẹ̀lú ṣékélì ibi mímọ́, ogún gera.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kò sí ẹni tí ó gbọdọ̀ ya gbogbo àkọ́bí ẹran sọ́tọ̀. Èyí jẹ́ ti",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.26",
                "verseOrgIds": [
                  "LEV.27.26"
                ]
              }
            }
          ]
        },
        {
          "text": "nípasẹ̀ òfin àkọ́bí: yálà akọ màlúù ni tàbí àgùntàn, ti",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.26",
                "verseOrgIds": [
                  "LEV.27.26"
                ]
              }
            }
          ]
        },
        {
          "text": "ni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá jẹ́ ọ̀kan nínú àwọn ẹran tí kò mọ́, nígbà náà ni kí ó rà á padà gẹ́gẹ́ bí ìdíyelé rẹ̀, kí ó sì fi ìdámárùn-ún lé e, tàbí bí a kò bá rà á padà kí ẹ tà á gẹ́gẹ́ bí ìdíyelé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ohun tí a bá yà sí mímọ́ pátápátá láti ọwọ́ ẹnikẹ́ni sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.28",
                "verseOrgIds": [
                  "LEV.27.28"
                ]
              }
            }
          ]
        },
        {
          "text": "tàbí ẹranko tàbí ilẹ̀ tí ó jogún, òun kò gbọdọ̀ tà á kí ó rà á padà. Gbogbo ohun ìyàsọ́tọ̀ bẹ́ẹ̀ di mímọ́ jùlọ fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.28",
                "verseOrgIds": [
                  "LEV.27.28"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ẹni tí ẹ bá ti yà sọ́tọ̀ fún pípa, ẹnikẹ́ni kò gbọdọ̀ rà á padà, pípa ni kí ẹ pa á.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Gbogbo ìdámẹ́wàá ilẹ̀ náà yálà tí èso ilẹ̀ ni, tàbí tí èso igi, ti",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.30",
                "verseOrgIds": [
                  "LEV.27.30"
                ]
              }
            }
          ]
        },
        {
          "text": "ni. Mímọ́ ni fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.30",
                "verseOrgIds": [
                  "LEV.27.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹnikẹ́ni bá fẹ́ ra ìdámẹ́wàá nǹkan rẹ̀ padà, o gbọdọ̀ fi márùn-ún kún un.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.31",
            "verseOrgIds": [
              "LEV.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ìdámẹ́wàá àgbò àti ẹran ọ̀sìn, àní ìdámẹ́wàá ẹran tó bá kọjá lábẹ́ ọ̀pá darandaran kí ó jẹ́ mímọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.32",
            "verseOrgIds": [
              "LEV.27.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.32",
                "verseOrgIds": [
                  "LEV.27.32"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.32",
            "verseOrgIds": [
              "LEV.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ènìyàn kò gbọdọ̀ wádìí bóyá ó dára tàbí kò dára, kò sì gbọdọ̀ pààrọ̀ rẹ̀. Bí ó bá pààrọ̀ rẹ̀: àti èyí tí ó pààrọ̀ àti èyí tí ó fi pààrọ̀ ni kí ó jẹ́ mímọ́. Wọn kò gbọdọ̀ rà á padà.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.33",
            "verseOrgIds": [
              "LEV.27.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àṣẹ wọ̀nyí ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.34",
            "verseOrgIds": [
              "LEV.27.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.34",
                "verseOrgIds": [
                  "LEV.27.34"
                ]
              }
            }
          ]
        },
        {
          "text": "pa fún Mose fún àwọn ọmọ Israẹli ní orí òkè Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.34",
            "verseOrgIds": [
              "LEV.27.34"
            ]
          }
        }
      ]
