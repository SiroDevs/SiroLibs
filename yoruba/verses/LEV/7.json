          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.38",
                "verseOrgIds": [
                  "LEV.7.38"
                ]
              }
            }
          ]
        },
        {
          "text": "pa á láṣẹ fún àwọn ọmọ Israẹli pé kí wọ́n máa mú ọrẹ wọn wá fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
