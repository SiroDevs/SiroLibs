          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ìpín tí a yà sọ́tọ̀ fún Aaroni àti àwọn ọmọ rẹ̀ nínú ẹbọ tí a finá sun sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.35",
                "verseOrgIds": [
                  "LEV.7.35"
                ]
              }
            }
          ]
        },
        {
          "text": "lọ́jọ́ tí wọ́n mú wọn wá láti sin",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.35",
                "verseOrgIds": [
                  "LEV.7.35"
                ]
              }
            }
          ]
        },
        {
          "text": "gẹ́gẹ́ bí àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lọ́jọ́ tí a fi òróró yàn wọ́n, ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.36",
                "verseOrgIds": [
                  "LEV.7.36"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pa á láṣẹ pé kí àwọn ọmọ Israẹli máa fún wọn ní àwọn nǹkan wọ̀nyí gẹ́gẹ́ bí ìpín wọn ìgbà gbogbo fún àwọn ìran tó ń bọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
