  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "LEV 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹnìkan bá dẹ́ṣẹ̀ nítorí pé kò sọ̀rọ̀ nígbà tí a bi í ní gbangba pé kó jẹ́rìí nípa nǹkan tó rí tàbí nǹkan tó mọ̀ nípa ìṣẹ̀lẹ̀ kan, a ó di ẹ̀bi rẹ̀ rù ú.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.1",
            "verseOrgIds": [
              "LEV.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Tàbí bí ẹnìkan bá fọwọ́ kan ohun tí a kà sí àìmọ́ yálà òkú ẹranko aláìmọ́ tàbí òkú ẹran ọ̀sìn aláìmọ́ tàbí òkú ẹ̀dá yówù tó ń rìn lórí ilẹ̀ bí ó tilẹ̀ jẹ́ pé ẹni náà kò mọ̀, ó ti di aláìmọ́, ó sì ti jẹ̀bi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tàbí bí ó bá fọwọ́ kan ohun àìmọ́ ti ènìyàn, ohunkóhun tó lè mú ènìyàn di aláìmọ́, bí ó tilẹ̀ jẹ́ pé ẹni náà kò mọ̀, nígbà tí ó bá mọ̀ nípa rẹ̀ yóò jẹ̀bi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tàbí bí ẹni kan bá búra láti ṣe ohun kan láì ronú lé e lórí, yálà ohun tó dára tàbí ohun búburú, nínú ọ̀rọ̀ yówù tó ti búra láì kíyèsi ara, bí ó tilẹ̀ jẹ́ pé, kò mọ̀ nípa rẹ̀ tẹ́lẹ̀, bí ó ti wù kó rí, nígbà tó bá mọ̀ yóò jẹ̀bi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹnikẹ́ni bá jẹ̀bi ọ̀kan nínú àwọn nǹkan wọ̀nyí, ó gbọdọ̀ jẹ́wọ́ irú ọ̀nà tó ti dẹ́ṣẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti pé gẹ́gẹ́ bí ìtánràn fún ẹ̀ṣẹ̀ tí ó ṣẹ̀, ó gbọdọ̀ mú wa fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.6",
                "verseOrgIds": [
                  "LEV.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", abo àgùntàn tàbí abo ewúrẹ́ láti inú agbo ẹran wá gẹ́gẹ́ bí ẹbọ ẹ̀ṣẹ̀, àlùfáà yóò sì ṣe ètùtù fún ẹ̀ṣẹ̀ tí ó ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí kò bá lágbára àti mú ọ̀dọ́-àgùntàn wá, kí ó mú àdàbà méjì tàbí ọmọ ẹyẹlé méjì fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.7",
                "verseOrgIds": [
                  "LEV.5.7"
                ]
              }
            }
          ]
        },
        {
          "text": "gẹ́gẹ́ bí ìtánràn fún ẹ̀ṣẹ̀ rẹ̀—ọ̀kan fún ẹbọ ẹ̀ṣẹ̀, èkejì fún ẹbọ sísun.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ó kó wọn wá fún àlùfáà tí yóò kọ́kọ́ rú ẹbọ ẹ̀ṣẹ̀ kí ó yín in lọ́rùn, ṣùgbọ́n kí ó má já orí rẹ̀ tan,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.8",
            "verseOrgIds": [
              "LEV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí ó sì wọ́n díẹ̀ lára ẹ̀jẹ̀ ẹbọ ẹ̀ṣẹ̀ náà sí ẹ̀gbẹ́ pẹpẹ, ìyókù ẹ̀jẹ̀ náà ni kí ó ro sí ìsàlẹ̀ pẹpẹ. Ẹbọ ẹ̀ṣẹ̀ ni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.9",
            "verseOrgIds": [
              "LEV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn èyí àlùfáà yóò wá rú ẹbọ sísun gẹ́gẹ́ bí ìlànà, yóò sì ṣe ètùtù fún un nítorí ẹ̀ṣẹ̀ tí ó ṣẹ̀, a ó sì dáríjì í.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ó bá sì jẹ́ pé kò ní agbára àti mú àdàbà méjì tàbí ọmọ ẹyẹlé méjì wá, kí ó mú ìdámẹ́wàá òsùwọ̀n ìyẹ̀fun kíkúnná dáradára wá fún ẹbọ ẹ̀ṣẹ̀ rẹ, kò gbọdọ̀ fi òróró tàbí tùràrí sí i nítorí pé ẹbọ ẹ̀ṣẹ̀ ni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ó gbé e wá sí ọ̀dọ̀ àlùfáà, àlùfáà yóò sì bu ẹ̀kúnwọ́ ìyẹ̀fun gẹ́gẹ́ bí ẹbọ ìrántí, kí ó sì sun ún lórí pẹpẹ, gẹ́gẹ́ bí ẹbọ tí a fi iná sun sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.12",
                "verseOrgIds": [
                  "LEV.5.12"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ẹbọ ẹ̀ṣẹ̀ ni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni àlùfáà yóò ṣe ètùtù fún ẹni náà fún èyíkéyìí nínú àwọn ẹ̀ṣẹ̀ tí ó dá, a ó sì dáríjì í: ìyókù sì jẹ́ ti àlùfáà, bí ẹbọ ohun jíjẹ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹbọ ẹ̀bi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.14",
                "verseOrgIds": [
                  "LEV.5.14"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.14",
            "verseOrgIds": [
              "LEV.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà tí ẹnìkan bá dẹ́ṣẹ̀ ìrékọjá tí ó sì ṣe láìmọ̀ ní ti àwọn ohun mímọ́",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.15",
                "verseOrgIds": [
                  "LEV.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí ó mú àgbò láti inú agbo ẹran wá fún",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.15",
                "verseOrgIds": [
                  "LEV.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": "gẹ́gẹ́ bí ìtánràn, àgbò tí kò lábùkù tí ó sì níye lórí gẹ́gẹ́ bí iye owó ibi mímọ́. Ẹbọ ẹ̀bi ni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ó ṣe àtúnṣe nítorí ẹ̀ṣẹ̀ tí ó ti ṣẹ̀ nínú ti àwọn ohun mímọ́, kí ó sì fi ìdámárùn-ún kún iye rẹ̀, kí ó sì kó gbogbo rẹ̀ fún àlùfáà. Àlùfáà yóò sì fi àgbò ẹbọ ẹ̀ṣẹ̀ náà ṣe ètùtù fún, a ó sì dáríjì í.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ẹnìkan bá dẹ́ṣẹ̀ tí ó sì ṣe ohun tí kó yẹ ko ṣe sí ọ̀kan nínú òfin",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.17",
                "verseOrgIds": [
                  "LEV.5.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", bí kò tilẹ̀ mọ̀, ó jẹ̀bi, yóò sì ru ẹ̀bi ẹ̀ṣẹ̀ rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí ó mú àgbò kan láti inú agbo ẹran wá sọ́dọ̀ àlùfáà, fún ẹbọ ẹ̀ṣẹ̀ àgbò tí kò lábùkù tí ó sì níye lórí bí iye owó ibi mímọ́. Báyìí ni àlùfáà yóò ṣe ètùtù fún ẹni náà, fún àṣìṣe tí ó ṣe láìmọ̀, a ó sì dáríjì í.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.18",
            "verseOrgIds": [
              "LEV.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹbọ ẹ̀bi ni, ó ti jẹ̀bi ẹ̀ṣẹ̀ tí ó ṣẹ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.19",
                "verseOrgIds": [
                  "LEV.5.19"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        }
      ]
