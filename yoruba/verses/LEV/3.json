              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ó bá ṣe pé ewúrẹ́ ni ó mú, kí ó mú un wá síwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.12",
            "verseOrgIds": [
              "LEV.3.12"
            ]
          }
        },
        {
          "name": "char",
