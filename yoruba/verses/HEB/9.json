  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "HEB 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìsìn nínú àgọ́ ayé yìí",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni májẹ̀mú àkọ́kọ́ ní ìlànà fún ìsìn àti ibi mímọ́ ti ayé yìí.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.1",
            "verseOrgIds": [
              "HEB.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gbé àgọ́ kan dìde. Nínú yàrá rẹ̀ àkọ́kọ́ ni a ti rí ọ̀pá fìtílà, tábìlì, àti àkàrà ìfihàn. Èyí tí a ń pè ní ibi mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti lẹ́yìn aṣọ ìkélé kejì, òun ni àgọ́ tí à ń pè ní Ibi Mímọ́ Jùlọ;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí ó ní àwo tùràrí wúrà, àti àpótí ẹ̀rí tí a fi wúrà bò yíká, nínú èyí tí ìkòkò wúrà tí ó ní manna gbé wà, àti ọ̀pá Aaroni tí o rúdí, àti àwọn wàláà májẹ̀mú;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti lórí àpótí ni àwọn kérúbù ògo ti i síji bo ìtẹ́ àánú; èyí tí a kò lè sọ̀rọ̀ rẹ̀ nísinsin yìí lọ́kọ̀ọ̀kan.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ nígbà tí a ti ṣe ètò nǹkan wọ̀nyí báyìí, àwọn àlùfáà a máa lọ nígbàkígbà sínú àgọ́ èkínní, wọn a máa ṣe iṣẹ́ ìsìn.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n sínú èkejì ni olórí àlùfáà nìkan máa ń lọ lẹ́ẹ̀kan ṣoṣo lọ́dún, fún ara rẹ̀, àti fún ìṣìnà àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.7",
            "verseOrgIds": [
              "HEB.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀mí Mímọ́ ń tọ́ka èyí pé a kò ì tí ì ṣí ọ̀nà Ibi Mímọ́ Jùlọ sílẹ̀ níwọ̀n ìgbà tí àgọ́ èkínní bá sì dúró,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.8",
            "verseOrgIds": [
              "HEB.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "èyí tí i ṣe àpẹẹrẹ fún ìgbà ìsinsin yìí. Gẹ́gẹ́ bí ètò yìí, a ń mú ẹ̀bùn àti ẹbọ wá, tí kò lè mú ẹ̀rí ọkàn olùsìn di pípé.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.9",
            "verseOrgIds": [
              "HEB.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí sì wà nínú ohun jíjẹ àti ohun mímu àti onírúurú ìwẹ̀, tí í ṣe ìlànà ti ara nìkan tí a fi lélẹ̀ títí fi di ìgbà àtúnṣe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
              "HEB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ̀jẹ̀ ti Kristi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà tí Kristi dé bí olórí àlùfáà àwọn ohun rere tí ń bọ̀, nípasẹ̀ àgọ́ tí o tóbi ti ó sì pé ju ti ìṣáájú, èyí tí a kò fi ọwọ́ dá, èyí yìí ni, tí kì í ṣe ti ẹ̀dá yìí.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.11",
            "verseOrgIds": [
              "HEB.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni kì í ṣe nípasẹ̀ ẹ̀jẹ̀ ewúrẹ́ àti ọmọ màlúù, ṣùgbọ́n nípa ẹ̀jẹ̀ òun tìkára rẹ̀, o wọ Ibi Mímọ́ Jùlọ lẹ́ẹ̀kan ṣoṣo, lẹ́yìn tí ó ti rí ìdáǹdè àìnípẹ̀kun gbà fún wa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.12",
            "verseOrgIds": [
              "HEB.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí bí ẹ̀jẹ̀ ewúrẹ́ àti ti akọ màlúù àti eérú ẹgbọrọ abo màlúù tí a fi wọ́n àwọn tí a ti sọ di aláìmọ́ ba ń sọ ni di mímọ́ fún ìwẹ̀nùmọ́ ara:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.13",
            "verseOrgIds": [
              "HEB.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mélòó mélòó ni ẹ̀jẹ̀ Kristi, ẹni, nípa Ẹ̀mí ayérayé, tí ó fi ara rẹ̀ rú ẹbọ sí Ọlọ́run láìní àbàwọ́n, yóò wẹ èérí ọkàn yín nù kúrò nínú òkú iṣẹ́ láti sin Ọlọ́run alààyè?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti nítorí èyí ni ó ṣe jẹ́ alárinà májẹ̀mú tuntun pé bí ikú ti ń bẹ fún ìdáǹdè àwọn ìrékọjá ti o tí wà lábẹ́ májẹ̀mú ìṣáájú, kí àwọn tí a ti pè lè rí ìlérí ogún àìnípẹ̀kun gbà.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí níbi tí ìwé ogún bá gbé wà, ikú ẹni tí o ṣe é kò lè ṣe àìsí pẹ̀lú;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.16",
            "verseOrgIds": [
              "HEB.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí ìwé ogún ní agbára lẹ́yìn ìgbà tí ènìyàn bá kú, nítorí kò ní agbára rárá nígbà tí ẹni tí o ṣè e bá ń bẹ láààyè.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.17",
            "verseOrgIds": [
              "HEB.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ni a kò ṣe ya májẹ̀mú ìṣáájú pàápàá sí mímọ́ láìsí ẹ̀jẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.18",
            "verseOrgIds": [
              "HEB.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí nígbà tí Mose ti sọ gbogbo àṣẹ nípa ti òfin fún gbogbo àwọn ènìyàn, ó mú ẹ̀jẹ̀ ọmọ màlúù àti ti ewúrẹ́, pẹ̀lú omi, àti òwú òdòdó, àti ewé hísópù ó sì fi wọ́n àti ìwé pàápàá àti gbogbo ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wí pé, \"Èyí ní ẹ̀jẹ̀ májẹ̀mú tí Ọlọ́run pàṣẹ fún yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.20",
            "verseOrgIds": [
              "HEB.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ gẹ́gẹ́ ni ó sì fi ẹ̀jẹ̀ wọ́n àgọ́, àti gbogbo ohun èlò ìsìn.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.21",
            "verseOrgIds": [
              "HEB.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì fẹ́rẹ̀ jẹ́ ohun gbogbo ni a fi ẹ̀jẹ̀ wẹ̀nù gẹ́gẹ́ bí òfin; àti pé láìsí ìtàjẹ̀ sílẹ̀ kò sí ìdáríjì.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.22",
            "verseOrgIds": [
              "HEB.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà a kò lè ṣàì fi ìwọ̀nyí wé àwọn àpẹẹrẹ ohun tí ń bẹ lọ́run mọ́; ṣùgbọ́n ó yẹ kí a fi ẹbọ tí ó sàn ju ìwọ̀nyí lọ wẹ àwọn ohun ọ̀run pàápàá mọ́; ṣùgbọ́n ó yẹ kí a fi ẹbọ tí ó sàn ju ìwọ̀nyí lọ wẹ àwọn ohun ọ̀run pàápàá mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.23",
            "verseOrgIds": [
              "HEB.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí Kristi kò wọ ibi mímọ́ tí a fi ọwọ́ ṣe lọ tí i ṣe àpẹẹrẹ ti òtítọ́; ṣùgbọ́n ó lọ sí ọ̀run pàápàá, nísinsin yìí láti farahàn ní iwájú Ọlọ́run fún wa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.24",
            "verseOrgIds": [
              "HEB.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kì í sí i ṣe pé kí ó lè máa fi ara rẹ̀ rú ẹbọ nígbàkígbà, bí olórí àlùfáà tí máa ń wọ inú Ibi Mímọ́ Jùlọ lọ lọ́dọọdún ti òun pẹ̀lú ẹ̀jẹ̀ ti kì í ṣe tirẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.25",
            "verseOrgIds": [
              "HEB.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
