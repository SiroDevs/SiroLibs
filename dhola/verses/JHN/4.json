{
  "id": "JHN.4",
  "number": "4",
  "bookId": "JHN",
  "reference": "Yohana 4",
  "verseCount": 54,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JHN 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu kodi Dhasamaria moro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo Yesu oniaŋ nike Jofarisayo jotieko winjo ni go onyo ywayo ji bonge aka miyo ji batisimo loyo Yohana, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.1",
            "verseOrgIds": [
              "JHN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "(iy'adieri, Yesu k'obatisa nyatoro, to jofonjirok pere am'oyido jotimo ameno.) ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.2",
            "verseOrgIds": [
              "JHN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go oeye Yuda to gik yu Galili; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.3",
            "verseOrgIds": [
              "JHN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka go onwaŋo ripo luwo gi Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.4",
            "verseOrgIds": [
              "JHN.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.4",
            "verseOrgIds": [
              "JHN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go obino i tindi ma Samaria m'ilwoŋo ni Sika, m'oyido cegin gi ndelo ma Yakobo cango omiyo Yozefu, wode. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.5",
            "verseOrgIds": [
              "JHN.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waŋ pi pa Yakobo oyido nikenyo, aka Yesu munyo ool gi woth, obedo piny dho waŋ pi no oyido obedo odieceŋ kapa sawa aucel.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.6",
            "verseOrgIds": [
              "JHN.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.6",
            "verseOrgIds": [
              "JHN.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhasamaria moro obino kulo, to Yesu waco rigo ni, “Miyan ye pi amadhi.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.7",
            "verseOrgIds": [
              "JHN.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Jofonjirok pere onwaŋo fodi jokidho i tindi nyewo cemo.) ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.8",
            "verseOrgIds": [
              "JHN.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.4.1+EZR.4.2+EZR.4.3+EZR.4.4+EZR.4.5"
              },
              "items": [
                {
                  "text": "Ezira 4:1-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.4.1+NEH.4.2"
              },
              "items": [
                {
                  "text": "Nehe 4:1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dhasamaria no odwoko ni, “Kole in i Jayuda aka an a Jasamaria; inyalo nedi kwayan pi amadha?” (Ato Joyuda oyido jokitiyere gi Josamaria kosa jokiori atewe pa Josamaria kendo jokimadhi pi g'agwatin ma Josamaria jomadh'iye pi.) ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.9",
            "verseOrgIds": [
              "JHN.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu odwoko ni, “Bedi iŋey mic pa Were kodi ŋata kwayin pi amadha, d'ikwayo go aka d'omiyin pi ma kwo.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.10",
            "verseOrgIds": [
              "JHN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhako no owaco ni, “Jadwoŋ kole ingoye kodi gitwomo pi aka waŋ pi luth. Inonwaŋ kune pi ma kwo m'iwaco no? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.11",
            "verseOrgIds": [
              "JHN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iparo ni idwoŋ loyo kwari wan Yakobo m'omiyo wan waŋ pi me; aka go kodi wote, kodi mwendi pere jomadho pi me?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.12",
            "verseOrgIds": [
              "JHN.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana Yesu ni, “Moro je ma madho pi me bino winjo riyo kendo; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.13",
            "verseOrgIds": [
              "JHN.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "to ŋat'omadhi pi m'abino miyo go odoko kilawinjo riyo kendo. Aka pi m'anomiy go bino lokere i go waŋ pi ma mol to miyo go kwo makirum.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.14",
            "verseOrgIds": [
              "JHN.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana dheno ni, “Jadwoŋ, miyan pi no aka ŋey akiri doko awinji riyo kosa adwoki ka kendo kulo.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.15",
            "verseOrgIds": [
              "JHN.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu owaco rigo ni, “Kidhi ilwoŋ cworin idwoki gine ka” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.16",
            "verseOrgIds": [
              "JHN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dheno odwoko ni, “Angoye gi cworan.” Ana Yesu ni, “Itire waco ni ingoye gi cworin, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.17",
            "verseOrgIds": [
              "JHN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "rupiri itieko nywomirok gi cwo abic, aka ŋata pama ibedo gine no bende k'obedo cworin. Iwaco gir'adieri.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.18",
            "verseOrgIds": [
              "JHN.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhako no owaco ni, “Jadwoŋ, onyo aniaŋ ni kere i jatuci wac Were. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.19",
            "verseOrgIds": [
              "JHN.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole kwarere mawan yado jolamo Were wi got me, to win wi Joyuda wiwaco ni Yerusalem a kama waripo lam'iye Were.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.20",
            "verseOrgIds": [
              "JHN.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu odwoko go ni, “Dhako me, yey gim'awaco rin; hongo bino tundo ma ji jok'olam Baba wi got me kosa kada i Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.21",
            "verseOrgIds": [
              "JHN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Win Josamaria wilamo gima wikuya; to wan Joyuda waŋeyo gima walamo, kwoŋbedo both wok bongi Joyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.22",
            "verseOrgIds": [
              "JHN.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "To hongo bino, aka ee otieko kiri tundo, ma joma lamo Baba i yo m'otire, jobino lamo go i Cuny kodi iy'adieri, rupiri Baba yenyo joma lamo go ameno. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.23",
            "verseOrgIds": [
              "JHN.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were obedo Cuny aka joma lama go joripo lamo go i cuny kodi iy'adieri.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.24",
            "verseOrgIds": [
              "JHN.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhako no owaco rigo ni, “Aŋeyo ni Mesiya (m'ilwoŋo ni Kristo), labino, aka k'obino lawaco riwan kisi gimoro.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.25",
            "verseOrgIds": [
              "JHN.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu odwoko go ni, “An won ago, an m'aluwo kodin me.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.26",
            "verseOrgIds": [
              "JHN.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "I hongo no won to jofonjirok pa Yesu jodwoko, to jodhier swa munyo jonwaŋo go luwo kodi dhako. To ongoye kwoŋ jo ŋat'openjo go kada ni, “Imito aŋo?” Odoko ni, “Raŋo m'iluwo gi dheno?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.27",
            "verseOrgIds": [
              "JHN.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.27",
            "verseOrgIds": [
              "JHN.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo dhako no oweyo dak pi pere, ogik i tindi, to waco ri ji ma kenyo ni, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.28",
            "verseOrgIds": [
              "JHN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Biye neni win dhano m'owaco ran gimoro je m'atieko timo, kosa go a Kristo?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.29",
            "verseOrgIds": [
              "JHN.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo ji joay i tindi to jokidho bongi Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.30",
            "verseOrgIds": [
              "JHN.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.30",
            "verseOrgIds": [
              "JHN.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "I hongo no jofonjirok oyido jokwayo Yesu nike, “Jafonji, cemi ye!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.31",
            "verseOrgIds": [
              "JHN.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "To odwoko jo ni, “Anitie gi cemo acama ma wikuya.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.32",
            "verseOrgIds": [
              "JHN.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo jofonjirok pere wegi jocako penjirok kendi gin ni, “Yagi, kosa moro nende okelo rigo cemo?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.33",
            "verseOrgIds": [
              "JHN.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu owaco rijo ni, “Cemo paran obedo timo gima ŋat'ooran yenyo gi cowo tic pere.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.34",
            "verseOrgIds": [
              "JHN.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.34",
            "verseOrgIds": [
              "JHN.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wingoye gi ageca ma wimaro luwo ni, ‘Odoŋ dwe aŋwen to keco tundo?’ Awaco riwin, kaŋasa win ndelin maber: Gim'ocwoy pama otieko cek aka otundo akeca. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.35",
            "verseOrgIds": [
              "JHN.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋata keco limo kemba, aka ameno go coko gim'onyak ri kwo makirum, ŋey jacwoyo kodi jakeco je jowosangala kanyacel. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.36",
            "verseOrgIds": [
              "JHN.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole ageca me ripo ni, ‘Ŋat'acel cwoyo aka ŋatiman keco.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.37",
            "verseOrgIds": [
              "JHN.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adhiro win keco gima wikicwoyo; joman ama jonekere gi tic mere, aka onyo widonjo limo bero ma wok i kwok pajo.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.38",
            "verseOrgIds": [
              "JHN.4.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.38",
            "verseOrgIds": [
              "JHN.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josamaria mathoth ma tindi no joyeyo Yesu rupiri dhako no owaco rijo ni, “Go owaco ran gimoro je m'atieko timo.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.39",
            "verseOrgIds": [
              "JHN.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo Josamaria jobino bonge to jokwayo go nike wobedi gi jo, to Yesu bedo kenyo ndelo ario.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.40",
            "verseOrgIds": [
              "JHN.4.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.40",
            "verseOrgIds": [
              "JHN.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji mathoth man joyeyo go ro fonji pere, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.41",
            "verseOrgIds": [
              "JHN.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka jowaco ri dhako no ni, “Pama onyo wayeyo go, ki kwoŋbedo gim'iwaco, to rupiri wawegi watieko winjo go, aka onyo waŋeyo adieri ni go a Jaboth pa piny.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.42",
            "verseOrgIds": [
              "JHN.4.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu botho wod pa jadwoŋ moro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.42",
            "verseOrgIds": [
              "JHN.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo ndelo ario no orumo, Yesu oeye kenyo to kidho Galili, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.43",
            "verseOrgIds": [
              "JHN.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.57"
              },
              "items": [
                {
                  "text": "Mat 13:57",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.4"
              },
              "items": [
                {
                  "text": "Mar 6:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.24"
              },
              "items": [
                {
                  "text": "Luk 4:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kada nende go won onwaŋo otieko waco ni, “Jatuci wac Were kimiy go dwoŋ i piny pere won.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.44",
            "verseOrgIds": [
              "JHN.4.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 4:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "To munyo go otundo Galili, ji jojolo go, rupiri jo wegi ndir ca jokidho Yerusalem i ndelo madwoŋ ma kalima ma Kadho to joneno gimoro je ma go otimo i kalima no.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.45",
            "verseOrgIds": [
              "JHN.4.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 4:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.45",
            "verseOrgIds": [
              "JHN.4.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 4:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo Yesu ogik i Kana ma Galili, kama go ndir ca olok'iye pi vini. Kenyo onwaŋo nitie jadwoŋ moro ma wode oyido two yu Kapernaum. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.46",
            "verseOrgIds": [
              "JHN.4.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 4:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo jalo owinjo ni Yesu obino Galili wok Yuda, okidho bonge to kwayo go nike wokidhi Kapernaum wobothi rigo wode m'onwaŋo cegin tho. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.47",
            "verseOrgIds": [
              "JHN.4.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 4:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu owaco rigo ni, “Ato ka wikineno ranyuth madongo wik'oyey!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.48",
            "verseOrgIds": [
              "JHN.4.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 4:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jadwoŋ ma Jaroma no odwoko ni, “Jadwoŋ, bowe wakadhi kafodi nyathi paran k'otho.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.49",
            "verseOrgIds": [
              "JHN.4.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 4:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu owaco rigo ni, “Kadhi, wodin bino kwo!” Jalo oyeyo gima Yesu owaco rigo to kadho. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.50",
            "verseOrgIds": [
              "JHN.4.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 4:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo fodi ni royo kadho, jotic pere joromo gine to jowaco rigo ni wode kwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.51",
            "verseOrgIds": [
              "JHN.4.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 4:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go openjo jo ni two oweyo go keraŋo, to jowaco ni, “Nyoro odieceŋ kapa sawa abirio ama two no owey'iye go.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.52",
            "verseOrgIds": [
              "JHN.4.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 4:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo bamere opoyo ni i hongo no won ama Yesu owac'iye rigo ni, “Wodin bino kwo.” Riameno go kodi peco pere gipi joyeyo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.53",
            "verseOrgIds": [
              "JHN.4.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 4:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.53",
            "verseOrgIds": [
              "JHN.4.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JHN 4:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me obedo gir'aura mar'ario ma Yesu otimo munyo otieko wok Yuda okidho Galili.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.54",
            "verseOrgIds": [
              "JHN.4.54"
            ]
          }
        }
      ]
    }
