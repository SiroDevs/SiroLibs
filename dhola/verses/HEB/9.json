            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.23+EXO.25.24+EXO.25.25+EXO.25.26+EXO.25.27+EXO.25.28+EXO.25.29+EXO.25.30"
              },
              "items": [
                {
                  "text": "Wok 25:23-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oger wema ma Were bed'iye ama: I kisika marapena oyido nitie raŋaw tala, meza, kodi mugat m'icwayo ri Were. Kenyo oyido ilwoŋo ni Kabedo Maleŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.31+EXO.26.32+EXO.26.33"
              },
              "items": [
                {
                  "text": "Wok 26:31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yuŋey nanga mar'ario oyido nitie kisika m'ilwoŋo ni Kabedo Maleŋ Maloyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
          }
        },
