                "loc": "DEU.10.3+DEU.10.4+DEU.10.5"
              },
              "items": [
                {
                  "text": "Cik 10:3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kenyo oyido nitie migam ma zahabu m'iwaŋ'iye buban, kodi sanduku ma cikirok, m'oum thenge je gi zahabu. I sanduku no oyido nitie atawo ma zahabu gi manu i iye kodi luth pa Aron ma boke oloth kwoŋe, kodi telin ario m'ondiki kwoŋe wac ma cikirok. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.18+EXO.25.19+EXO.25.20+EXO.25.21+EXO.25.22"
              },
              "items": [
                {
                  "text": "Wok 25:18-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wi sanduku oyido nitie Kerubim ario ma nyutho dwoŋ pa Were, ma joyaro bwombi jo kam'icwak'iye reco kenyo. To me kaya hongo ma tit'iye gimoro je.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        }
      ]
    },
