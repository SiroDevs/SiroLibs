              },
              "items": [
                {
                  "text": "Wok 28:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka ongoye ŋata won yero dwoŋ ma bedo jadwoŋ pa jocway ri Were i wi migam; bedo ri lwoŋo pa Were won, paka cango olwoŋi Aron.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        }
      ]
    },
