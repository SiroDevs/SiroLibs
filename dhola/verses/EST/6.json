{
  "id": "EST.6",
  "number": "6",
  "bookId": "EST",
  "reference": "Esita 6",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
