          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kere Ahazia oriwere kodi Yoram kere ma Isiraili kwoŋ Hazael kere ma Siria. Jolweny pajo joromo i Ramoth Giliad, aka Yoram olimo litho i lweny. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
            "verseOrgIds": [
              "2KI.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoram odok i tindi madwoŋ Yezirel both adholin pere, aka Ahazia okidho kenyo wendo rigo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
        }
      ]
