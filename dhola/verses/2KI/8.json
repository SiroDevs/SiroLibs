            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.1",
            "verseOrgIds": [
              "2KI.8.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.8+2KI.4.9+2KI.4.10+2KI.4.11+2KI.4.12+2KI.4.13+2KI.4.14+2KI.4.15+2KI.4.16+2KI.4.17+2KI.4.18+2KI.4.19+2KI.4.20+2KI.4.21+2KI.4.22+2KI.4.23+2KI.4.24+2KI.4.25+2KI.4.26+2KI.4.27+2KI.4.28+2KI.4.29+2KI.4.30+2KI.4.31+2KI.4.32+2KI.4.33+2KI.4.34+2KI.4.35+2KI.4.36+2KI.4.37"
              },
              "items": [
                {
                  "text": "2 Kerin 4:8-37",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo Elisa oyido owaco ri dhako Jasunem m'ocerino wode nike jowotuki kaman rupiri Rwoth oyido kidho dhiro kec i piny, aka oyido bino cowo oro abirio. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.1",
            "verseOrgIds": [
              "2KI.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno dheno otimo gima Elisa owaco rigo to kadho bedo i piny Filistia ma oro abirio no.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.2",
            "verseOrgIds": [
              "2KI.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.2",
            "verseOrgIds": [
              "2KI.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka munyo oro abirio ma kec orumo, dheno ogik i Isiraili to kidho bongi kere kwayo wodwoki rigo ot pere kodi lowo pere. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.3",
            "verseOrgIds": [
              "2KI.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo kere oyido luwo gi Gehazi ŋeca pa Elisa gi atoŋa ma mito ŋeyo kwoŋ gir'aura pa Elisa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.4",
            "verseOrgIds": [
              "2KI.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kome munyo Gehazi waco ri kere nike Elisa ocerino ŋat'otho, dheno ogoyo koko pere ri kere. Gehazi owaco ri kere ni, “Jadwoŋ me dhako, aka me wode ma Elisa ocerino.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.5",
            "verseOrgIds": [
              "2KI.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka munyo kere openjo dheno, oridho wac pa Gehazi. Ameno kere olwoŋo jadhum pere aka owaco rigo dwoko ri dheno gigipiny pere je, kodi magowa ma cemo kodi ndelin pere ma oro abirio ma go oyido ongoye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.6",
            "verseOrgIds": [
              "2KI.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elisa gi kere Benhadad ma Siria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.6",
            "verseOrgIds": [
              "2KI.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa okidho Damasiko i hongo ma kere Benhadad oyido two iye. Munyo owaci ri kere nike Elisa oyido nitie kenyo, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.7",
            "verseOrgIds": [
              "2KI.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "owaco ri Hazael, acel kwoŋ jodhum pere ni, “Ter mic ri jatuci wac Were, aka ikway go wopenji Rwoth k'inen anyalo both kosa be.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.8",
            "verseOrgIds": [
              "2KI.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno Hazael otweyo nger mic je ma Damasiko i ŋamia piero aŋwen, to kidho bongi Elisa. Munyo Hazael oromo gi Elisa, owaco rigo ni, “Ŋeca perin kere Benhadad ma Siria ooran penjin ka go bino both kwoŋ two pere kosa be.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.9",
            "verseOrgIds": [
              "2KI.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.9",
            "verseOrgIds": [
              "2KI.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa odwoko ni, “Rwoth otieko waco ran nike go bino tho; to kadhi bonge aka iwaci rigo nike go bino both.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.10",
            "verseOrgIds": [
              "2KI.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo Elisa ocomo waŋe kwoŋ Hazael cuka wickwot omako. Aka Elisa oywaki. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.11",
            "verseOrgIds": [
              "2KI.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazael openjo go ni, “Jadwoŋ, raŋo iywaki?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.12",
            "verseOrgIds": [
              "2KI.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa odwoko ni, “Kwoŋbedo aŋeyo raco m'ibino timo ri Joisiraili. Ibino waŋo cel pajo, ibino yaŋo cwo pajo ma nyaka joay, ibino thumo nyithindho pajo mathindho thindho, t'ibaro iy mon pajo ma joyac.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.12",
            "verseOrgIds": [
              "2KI.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.12",
            "verseOrgIds": [
              "2KI.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.15"
              },
              "items": [
                {
                  "text": "1 Kerin 19:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazael odwoko ni, “Anyalo nedi bedo gi meni nger no? An masisiri me!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa odwoko ni, “Rwoth otieko nyuthan nike ibino bedo kere ma Siria.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazael ogik bongi Benhadad m'openjo go ni, “Elisa owaco aŋo?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.14",
            "verseOrgIds": [
              "2KI.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazael odwoko ni, “Elisa owaco ran nike ibino bedo maber.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.14",
            "verseOrgIds": [
              "2KI.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ndelo m'oyawere Hazael okwanyo bilangit, obilo gi pi aka ogeŋo gine ŋeti Benhadad cuka otho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.15",
            "verseOrgIds": [
              "2KI.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka Hazael olunjo Benhadad paka kere ma Siria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.15",
            "verseOrgIds": [
              "2KI.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kere Yehoram ma Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.15",
            "verseOrgIds": [
              "2KI.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "I oro mar'abic ma dhum pa Yoram kere Isiraili, Yehoram wod pa Yehosafat obedo kere ma Yuda ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.16",
            "verseOrgIds": [
              "2KI.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "munyo jaoro piero adek g'ario, aka odhumo i Yerusalem ma oro aboro. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.17",
            "verseOrgIds": [
              "2KI.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cege oyido obedo nyar Ahab, aka paka peco pa Ahab go bende oluwo yo mareco pa kerin ma Isiraili. Otimo reco ruwaŋ Rwoth, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.18",
            "verseOrgIds": [
              "2KI.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.36"
              },
              "items": [
                {
                  "text": "1 Kerin 11:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "to kucel Rwoth oyido kinyal reyo woko Yuda, ro cikirok pere ri ŋeca pere Daudi nike nyikway go jobino dhumo noknok.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.19",
            "verseOrgIds": [
              "2KI.8.19"
            ]
