                {
                  "text": "Cak 27:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "I hongo ma dhum pa Yehoram, Edom ogwenyere kwoŋ Yuda to ketho kere pajo wegi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.20",
            "verseOrgIds": [
              "2KI.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno Yehoram oay gi cawilin pere je kidho i Zayir kama Joedom jothoko jo. Wor Yehoram kodi jomituka cawilin pere jonyalo tur to jokwale, aka jolweny pere jokedhere kadho pecin pajo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.21",
            "verseOrgIds": [
              "2KI.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wok i hongo no tundo gunyo ni, Edom ongoye i dhum pa Yuda. I hongo acel no, tindi madwoŋ Libina bende ogwenyere kwoŋ Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.22",
            "verseOrgIds": [
              "2KI.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.22",
            "verseOrgIds": [
              "2KI.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gigipiny man je ma Yehoram otimo ondiki i kitawo ma kigana ma mako kwoŋ kerin ma Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.23",
            "verseOrgIds": [
              "2KI.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoram otho, aka oyiki go i limbo pa kerin i tindi pa Daudi madwoŋ, aka wode Ahazia olunjo go paka kere.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.24",
            "verseOrgIds": [
              "2KI.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kere Ahazia ma Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.24",
            "verseOrgIds": [
              "2KI.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "I oro mar'apar g'abic ma dhum pa Yoram wod pa Ahab paka kere ma Isiraili, Ahazia wod pa Yehoram obedo kere ma Yuda ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.25",
            "verseOrgIds": [
              "2KI.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "munyo jaoro piero ario g'ario aka odhumo i Yerusalem ma oro acel. Yokimere oyido obedo Athalia nyar kere Ahab, aka nyakwar kere Omiri ma Isiraili. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.26",
            "verseOrgIds": [
              "2KI.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paka Ahazia oyido timo wat gi Ahab i nywomirok, otimo reco ruwaŋ Rwoth paka peco pa Ahab.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        }
      ]
    },
