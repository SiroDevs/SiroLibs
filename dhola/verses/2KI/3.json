            }
          ]
        },
        {
          "text": "To munyo jotundo i kambi pa Joisiraili, Joisiraili joay aka jomonjo Jomowab, cuka joringo kwoŋ jo. Joisiraili jomedere riemo Jomowab ka joneko jo ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.24",
            "verseOrgIds": [
              "2KI.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
