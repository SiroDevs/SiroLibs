      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gigipiny man je ma kere Ahaz otimo ondiki i kitawo ma kigana ma mako kwoŋ kerin ma Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.19",
            "verseOrgIds": [
              "2KI.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.28"
              },
              "items": [
                {
                  "text": "Isa 14:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ahaz otho aka oyiki go i limbo pa kerin i tindi pa Daudi madwoŋ, aka wode Hezekia olunjo go paka kere.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.20",
            "verseOrgIds": [
              "2KI.16.20"
            ]
          }
        }
      ]
