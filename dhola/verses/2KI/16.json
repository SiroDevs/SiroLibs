                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kere Ahaz okwanyo adec ma magal ma ywel m'oor i Ot pa Rwoth aka okwanyo galayere m'oyido nitie i wi jo; go bende okwanyo pipa ma ywel m'oyido nitie yuŋey thwondhe apar g'ario ma ywel to jengo jo i misingi ma tele. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.17",
            "verseOrgIds": [
              "2KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka ma kisangala kere ma Asiria, Ahaz bende okwanyo woko wema m'oyido ioro ma lamo i ndelo ma Sabato, to cego woko kama kere oyido donjo gine Ot pa Rwoth.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
