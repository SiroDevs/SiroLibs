          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gigipiny man je ma kere Yerobowam mar'ario otimo, tim pere ma miseni, kodi nger m'odwok'iye Damasiko kodi Hamath ri Isiraili ondiki i kitawo ma kigana ma mako kwoŋ kerin ma Isiraili. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.28",
            "verseOrgIds": [
              "2KI.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
