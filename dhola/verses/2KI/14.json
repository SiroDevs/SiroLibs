          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole Rwoth oneno nike litho pa Joisiraili oyido kec; oyido ongoye ŋat'okony jo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.26",
            "verseOrgIds": [
              "2KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "To oyido k'obedo atoŋa pa Rwoth nike worey woko Joisiraili kicutho aka cil gi cil, ameno obotho jo luwo kwoŋ kere Yerobowam mar'ario.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        }
