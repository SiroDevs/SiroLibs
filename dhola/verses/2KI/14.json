                  "text": "Yona 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Omako adec je m'oyido obedo apa Isiraili wok i ger ma Hamath tundo i Nam ma Araba, cungo kwoŋ wac ma Rwoth oluwo luwo bongi ŋeca pere jatuci wac Were Yona wod pa Amitay ma wok i Gath Hefer.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
              "2KI.14.25"
            ]
          }
        }
      ]
