          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobowam otho aka oyiki go i kaliel pa kerin, aka wode Zekaria olunjo go paka kere.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.29",
