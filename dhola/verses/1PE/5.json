                "loc": "ACT.15.22+ACT.15.23+ACT.15.24+ACT.15.25+ACT.15.26+ACT.15.27+ACT.15.28+ACT.15.29+ACT.15.30+ACT.15.31+ACT.15.32+ACT.15.33+ACT.15.34+ACT.15.35+ACT.15.36+ACT.15.37+ACT.15.38+ACT.15.39+ACT.15.40"
              },
