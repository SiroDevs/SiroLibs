              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andiko riwin balwa macek me gi kony pa Silvano, m'atero paka omera m'ogenere. Amito medo win meni gi ridho riwin nike me obedo nema pa Were adieri. Cungi win matek iye.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
