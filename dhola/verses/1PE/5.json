              },
              "items": [
                {
                  "text": "18:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Am'omiyo, bwonere win, i cingi Were ma dimeni, ŋey nyaka go bino tiŋo win malo i hongo m'oripo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.6",
            "verseOrgIds": [
              "1PE.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kethi win rembo mewin je kwoŋ go, rupiri go dewo kwoŋ win.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.7",
            "verseOrgIds": [
              "1PE.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
