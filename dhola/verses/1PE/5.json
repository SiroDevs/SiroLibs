              "items": [
                {
                  "text": "Agec 3:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno bende, wijoma fodi soye wiripo winjo jotel mewin gi mwolo. Aka wijoje ruki win mwolo ma tiyo ri jowoti win pa nanga; kole ndiko waco ni, “Were lwenyo gi jopakirok, to miyo joma wegi jobwonere nema.”",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.5",
            "verseOrgIds": [
              "1PE.5.5"
            ]
          }
        }
      ]
    },
    {
