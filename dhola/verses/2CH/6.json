              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo Solomon okwayo ni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        }
