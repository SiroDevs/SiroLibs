            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.33+EXO.26.34"
              },
              "items": [
                {
                  "text": "Wok 26:33-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otimo Kabedo Maleŋ Loyo, kisika ma iye oyido mita abuŋwen i boro, m'oyido rom gi laco ma Ot pa Were. Solomon oumo gi tan piero ario ma zahabu macil. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oor zahabu gram 570 ma timo musumal, aka kor ot ma kisikin ma malo bende oum gi zahabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
