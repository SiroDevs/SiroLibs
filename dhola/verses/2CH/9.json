        },
        {
          "text": "Solomon obedo gi cel kayinin 4,000 gi cawilin, gi kayinin 12,000 m'oketho i tindin madongo ma cawilin kodi i Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.25",
