                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Go odhumo kerin je wok i malawa Yufrete tundo i lowo pa Jofilistia, kodi kew gi Misir. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
