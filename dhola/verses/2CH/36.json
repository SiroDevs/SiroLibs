            "sid": "2CH 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "I oro marapena ma dhum pa Kere Siras ma Pasia, wac ma Rwoth oyido otieko waco gi dhok Yeremia otundo i kare. Rwoth oguro cuny Kere Siras ma Pasia dhiro mikwenda i ker pere gipi aka owaco i ndiko ni, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.22",
            "verseOrgIds": [
              "2CH.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
