                }
              ]
            },
            {
              "text": "2 Kerin 23:26—24:7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neko oketho Eliakim omin Yehoahaz paka kere ma Yuda gi Yerusalem, aka owiro nyinge ni Yehoyakim. To Neko tero Yehoahaz i Misir.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
