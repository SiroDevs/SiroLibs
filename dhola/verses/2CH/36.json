                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.34.1+JER.34.2+JER.34.3+JER.34.4+JER.34.5"
              },
              "items": [
                {
                  "text": "34:1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Riameno Rwoth miyo kere ma Babilon monjo jo, to neko soye pajo g'aserin i Ot pa Were ma k'omako wor gi dhano moro je, nyathi kosa jadwoŋ, ma two kosa maber. Were omiyo joje i cingi kere ma Babilon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.17",
            "verseOrgIds": [
              "2CH.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kere ma Babilon onyaga Ot pa Were, lim mere kodi lim pa kere kodi jodhum pere, aka otero je i Babilon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.8"
              },
              "items": [
                {
                  "text": "1 Kerin 9:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kere ma Babilon owaŋo woko Ot pa Were, tindi madwoŋ, gi peco pa kere kodi lim mere, aka oturo piny kor ot ma tindi madwoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go otero jom'odoŋ i Babilon tic rigo kodi wote cuka ker ma Pasia otula. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.20",
            "verseOrgIds": [
              "2CH.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
