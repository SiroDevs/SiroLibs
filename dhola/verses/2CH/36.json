        {
          "text": "Kere Nebukadineza ma Babilon omonjo Yuda, to tweyo Yehoyakim gi lijegere to tero go i Babilon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza bende okadho g'atewe ma Ot pa Rwoth i Babilon to ketho peco pere i Babilon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gigipiny man je ma kere Yehoyakim otimo, kiri gi tim pere mienirok, kodi raco m'otimo je, ondiki i Kitawo pa Kerin ma Isiraili. Wode Yehoyakin olunjo go paka kere.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
