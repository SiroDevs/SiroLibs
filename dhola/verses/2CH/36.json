                "loc": "JER.25.11"
              },
              "items": [
                {
                  "text": "Yer 25:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.10"
              },
              "items": [
                {
                  "text": "29:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka wac ma Rwoth oyido otieko waco gi dhok Yeremia otundo i kare ni, “Lowo ladoŋ nono ma oro piero ario, ma culo waŋ Sabato m'oyido kikur.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kere Siras wodho cik ri Joyuda dok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
