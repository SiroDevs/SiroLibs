              "2PE.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2PE 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
