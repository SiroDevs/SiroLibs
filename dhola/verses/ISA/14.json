              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Rwoth otiek miyo Joisiraili ywomirok kwoŋ litho gi candirok, gi tic matek m'oyido iromo jo timo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.3",
            "verseOrgIds": [
              "ISA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
