              "type": "text"
            }
          ]
        },
        {
          "text": "Me mikwenda ma teko ma mako kwoŋ Misir.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
