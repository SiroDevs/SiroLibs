          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makada nende go oyar cinge paka jobuk pi joyaro cingi gin buko pi; Rwoth lamwolo noro pere kanyacel gi rieko ma cinge. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.11",
            "verseOrgIds": [
              "ISA.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
