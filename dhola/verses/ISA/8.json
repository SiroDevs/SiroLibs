          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tweyi ranyuth, imwon fonji no i dier jofonjirok paran. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.16",
            "verseOrgIds": [
              "ISA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.13"
              },
              "items": [
                {
                  "text": "Ebu 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alakuro Rwoth, go ma pano waŋe kwoŋ ot pa Yakobo, aka alaketho geno paran i go.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.17",
            "verseOrgIds": [
              "ISA.8.17"
            ]
          }
        }
      ]
