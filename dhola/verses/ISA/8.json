            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neni, an gi nyithindho paran ma Rwoth omiyan, wabedo ranyuth gi gir'aura i Isiraili wok bongi Rwoth pa lwak jolweny, ma bedo wi Got Zayon.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.18",
            "verseOrgIds": [
              "ISA.8.18"
            ]
          }
        }
