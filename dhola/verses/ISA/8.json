        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.20",
            "verseOrgIds": [
              "ISA.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji jolawotho i piny i litho madwoŋ gi kec, aka kec lamiyo jo nge to jokwoŋo kere pajo gi werin pajo. Jolaŋiyo malo i polo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.21",
            "verseOrgIds": [
              "ISA.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "to joŋiyo piny, to jolaneno nyaka litho gi mudho, mudho ma nge, aka ilabolo jo i mudho mapek.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.22",
            "verseOrgIds": [
              "ISA.8.22"
            ]
          }
        }
      ]
