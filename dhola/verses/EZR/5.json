                "loc": "ZEC.1.1"
              },
              "items": [
                {
                  "text": "Zek 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " I hongo no jotuci wac Were ario, Hagay gi Zekaria wod Ido, jocako luwo i nyingi Were pa Isiraili ri Joyuda m'oyido jobedo i Yuda gi Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.1",
            "verseOrgIds": [
              "EZR.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.12"
              },
              "items": [
                {
                  "text": "Hag 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.4.6+ZEC.4.7+ZEC.4.8+ZEC.4.9"
              },
              "items": [
                {
                  "text": "Zek 4:6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Munyo Zerubabel wod Siltiel gi Yesuwa wod Yehozadak jowinjo mikwenda pajo, jocako geto kendo Ot pa Were i Yerusalem, aka jotuci wac Were ario no jokonyo jo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "I hongo acel no Tatenay gavana mar'adec ma yupodho ceŋ ma Yufrete, Sethar Bozenay, gi jodhum wadi jo jobino i Yerusalem aka jopenjo ni, “Ŋa m'owodho or riwin geto ot me kendo gi dwoko gigipiny mere?” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.3",
            "verseOrgIds": [
              "EZR.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo bende jopenjo nyingi ji je m'oyido jomiyo kony ma geto Ot pa Were. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.4",
            "verseOrgIds": [
              "EZR.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "To, waŋ Were oyido nitie kwoŋ Joyuda, aka jodhum ma Pasia jok'onyalo juko jo geto cuka jodhiro mikwenda ri Dario to jonwaŋo radwok. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.5",
            "verseOrgIds": [
              "EZR.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me mikwenda ma jodhiro ri kere Dario: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.6",
            "verseOrgIds": [
              "EZR.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ri Kere Dario, weyi idhumi i siem. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.7",
            "verseOrgIds": [
              "EZR.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mondo Jadwoŋ, ŋey ni wakidho iy'adec ma Yuda aka wanwaŋo ni igeto kendo Ot pa Were madwoŋ gi telin mapando gi mbawin i kore. Tic me itimo gi kinen aka kadho maber. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.8",
            "verseOrgIds": [
              "EZR.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo waluwo gi jodongo no aka wapenjo jo ni, ‘Ŋa m'owodho or riwin geto kendo ot me gi dwoko gigipiny mere?’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.9",
            "verseOrgIds": [
              "EZR.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wapenjo jo bende nyingi jo, ŋey wanyal miyin ŋeyo, ŋey wandiki nyingi ji ma jotelo geto me. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.10",
            "verseOrgIds": [
              "EZR.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jodwoko wan ni, ‘Wabedo ŋecin pa Were ma polo gi piny, aka wageto kendo ot m'oyido ogeti oro kweth yucen, gi kere madwoŋ ma Isiraili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.11",
            "verseOrgIds": [
              "EZR.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.8+2KI.25.9+2KI.25.10+2KI.25.11+2KI.25.12"
              },
              "items": [
                {
                  "text": "2 Kerin 25:8-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20"
              },
              "items": [
                {
                  "text": "2 Kigana 36:17-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.12+JER.52.13+JER.52.14+JER.52.15"
              },
              "items": [
                {
                  "text": "Yer 52:12-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "To kwoŋbedo kwarere mawan jomiyo Were ma i Polo nge, ojwango jo i cingi Kere Nebukadineza ma Babilon, kere ma ker pa Jokaldin, ma joreyo woko ot me to jokadho gi ji i Babilon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.12",
            "verseOrgIds": [
              "EZR.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.1.2+EZR.1.3+EZR.1.4+EZR.1.5+EZR.1.6+EZR.1.7+EZR.1.8+EZR.1.9+EZR.1.10+EZR.1.11"
              },
              "items": [
                {
                  "text": "Ezira 1:2-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "To Kere Siras ma Babilon, i oro marapena ma dhum pere, owodho or ni Ot pa Were iripo geto kendo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.13",
            "verseOrgIds": [
              "EZR.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiri, gigipiny ma zahabu gi feza, ma Kere Nebukadineza oyido okwanyo wok i Ot pa Were i Yerusalem, Kere Siras owodho woko wok i ot pa were ma Babilon, aka omiyo jacwo m'ilwoŋo ni Sesibazar, ma go oketho paka gavana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.14",
            "verseOrgIds": [
              "EZR.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siras owaco rigo ni woter jo wokethi i Ot pa Were i Yerusalem, aka wogeti kendo Ot pa Were i gunda mere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.15",
            "verseOrgIds": [
              "EZR.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno Sesibazar obino to cako misingi mere, geto omedere wok i hongo no tundo gunyo ni, to Ot pa Were fodi k'orumo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.16",
            "verseOrgIds": [
              "EZR.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka nyo, mondo jadwoŋ, k'inen sangala in, wodhi or worangi i ndiko k'inen adieri kosa be Siras owodho or wogeti kendo Ot pa Were me i Yerusalem, aka iwaci riwan mito perin kwoŋ wac me.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.17",
            "verseOrgIds": [
              "EZR.5.17"
            ]
          }
        }
      ]
    }
