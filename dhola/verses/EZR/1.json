                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I oro marapena ma dhum pa Siras kere ma Pasia, Rwoth omiyo wac pere m'owaco luwo kwoŋ Yeremia tundo i kare. Rwoth oguro cuny kere Siras ŋey owodho or m'ondiki t'isoma malo i ker pere gibe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        }
