          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Zatu: Eliowenay, Eliasib, Matania, Yeremoth, Zabad gi Aziza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.27",
            "verseOrgIds": [
