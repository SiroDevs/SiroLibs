            "sid": "EZR 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.22",
            "verseOrgIds": [
              "EZR.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoŋ Jolevi obedo: Yozabad, Simey, Kelaya (ma bende ilwoŋo ni Kelita) Pethahia, Yuda gi Elieza.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.23",
            "verseOrgIds": [
              "EZR.10.23"
            ]
          }
        }
      ]
    },
