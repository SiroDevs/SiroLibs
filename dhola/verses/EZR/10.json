          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Elam: Matania, Zekaria, Yehiel, Abidi, Yeremoth gi Elia ",
          "type": "text",
          "attrs": {
