          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Bani: Mesulam, Maluk, Adaya, Yasub, Seal gi Yeremoth. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.29",
            "verseOrgIds": [
