          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Pahath Mowab: Adina, Kelal, Benaya, Maseya, Matania, Bezalel, Binuy gi Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.30",
