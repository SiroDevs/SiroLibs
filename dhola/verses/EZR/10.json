          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikway Bebay: Yehohanan, Hanania, Zabay gi Athilay. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.28",
            "verseOrgIds": [
