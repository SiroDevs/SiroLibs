          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole go otieko miyo win silwany, ki nyaka ma yeyo Kristo kende, to ma candirok rigo bende. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.29",
