          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiri wibedi malwor ri jokwor mewin, to ndelo je bedi win miseni, rupiri meno bino nyutho jo ni jorwenyo, to win wiboth, aka meno je gima Were ama timo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.28",
            "verseOrgIds": [
              "PHP.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
