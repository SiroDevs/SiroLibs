              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo ka anobedi gi win kendo, wibino bedo gi kisangala madwoŋ, i kwo mewin i Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.26",
            "verseOrgIds": [
              "PHP.1.26"
            ]
          }
        }
      ]
