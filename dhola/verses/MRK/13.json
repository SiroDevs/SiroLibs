          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Fonjere win kwoŋ makuyu. Ka jange olokere mayom, aka boke mere lothi, wiŋeyo ni ndir ma ceŋ cegin tundo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.28",
            "verseOrgIds": [
              "MRK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno bende ka wineno gigipiny me timere, wiŋeyi ni go ocore cegin, aka ni dho waŋkac. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.29",
            "verseOrgIds": [
              "MRK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adieri awaco riwin, luse ji ma pama jok'orum mafodi gigipiny me k'otimere. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.30",
            "verseOrgIds": [
              "MRK.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Polo gi piny bino rumo to wac paran kilarumo kada mathi.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.31",
            "verseOrgIds": [
              "MRK.13.31"
            ]
          }
        }
      ]
    },
