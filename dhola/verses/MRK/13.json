        "style": "s1"
      },
      "items": [
        {
          "text": "Fonji kwoŋ makuyu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
