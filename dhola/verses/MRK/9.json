                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu obedo piny, olwoŋo j'apar g'ario no to waco rijo ni, “Ŋata mito bedo marapena, ripo bedo macowe kwoŋ ji je, kendo jatic ri wadi je.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.35",
            "verseOrgIds": [
              "MRK.9.35"
            ]
          }
        },
        {
          "name": "verse",
