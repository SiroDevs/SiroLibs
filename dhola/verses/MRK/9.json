          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu owaco rijo ni, “Wikiri wicer go; ongoye ŋata timo gir'aura i nyingan manyalo luwo kwoŋan marac. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.39",
            "verseOrgIds": [
              "MRK.9.39"
            ]
          }
        },
        {
