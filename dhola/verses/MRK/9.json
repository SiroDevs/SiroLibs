          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu gi jofonjirok pere jobino Kapernaum, aka munyo jo ni ot, openjo jo ni, “Onwaŋo wipiemo aŋo i royo?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.33",
            "verseOrgIds": [
              "MRK.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
