              },
              "items": [
                {
                  "text": "Mat 5:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka ka cingin acel rwakin i gimarac, ŋondi woko; kole ber rin donjo i kwo makirum gi cingin acel loyo kidho gi cingin ario je i mac makitho, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.43",
            "verseOrgIds": [
              "MRK.9.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 9:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "[kama kudin ma iye kitho, aka mac mere kitho]. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.44",
            "verseOrgIds": [
              "MRK.9.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 9:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka ka tiendin acel rwakin i gimarac, ŋondi woko; kole ber rin donjo i kwo makirum, m'iŋol loyo bolin i mac makitho gi tiendin ario je, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.45",
            "verseOrgIds": [
              "MRK.9.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
