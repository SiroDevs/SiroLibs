            "number": "36",
            "style": "v",
            "sid": "MRK 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo go okwanyo nyathi moro, to waco rigo cungo i dier jo, to ketho cinge umo gine go, to waco rijo ni, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.36",
            "verseOrgIds": [
              "MRK.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
