                  "text": "Mat 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka ka waŋin acel rwakin i gimarac, goli woko; kole ber rin donjo i Ker pa Were gi waŋin acel, loyo bedo gi waŋin ario je t'ibolin i mac makitho, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.47",
            "verseOrgIds": [
              "MRK.9.47"
            ]
