          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo Yohana owaco ri Yesu ni, “Jafonji, wanwaŋo ŋatimoro riemo woko jwogi i nyingin; to paka go k'obedo acel kwoŋ wan, waciero go timo ameno.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.38",
            "verseOrgIds": [
              "MRK.9.38"
            ]
          }
        },
        {
          "name": "verse",
