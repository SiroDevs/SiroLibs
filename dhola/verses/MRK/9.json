              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.29",
            "verseOrgIds": [
              "MRK.9.29"
            ]
          }
        },
        {
