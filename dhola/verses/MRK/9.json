              "items": [
                {
                  "text": "Yoh 13:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Dhano je ma jolo nyaka nyathi me i nyingan, meno jolan; aka ŋata jolan meno kijolan kendan, to jolo kiri ŋat'ooran bende.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.37",
            "verseOrgIds": [
              "MRK.9.37"
            ]
          }
        }
