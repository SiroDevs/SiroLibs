              },
              "items": [
                {
                  "text": "Mat 12:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.23"
              },
              "items": [
                {
                  "text": "Luk 11:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ŋata kimon gi wan, meno tiyere gi wan. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.40",
            "verseOrgIds": [
              "MRK.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
