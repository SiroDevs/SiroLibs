              "items": [
                {
                  "text": "Mat 10:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Adieri awaco riwin, nyatoro je m'omiy win agwata pi amadha kwoŋbedo wi ji pa Kristo, go kilakeŋ kemba pere.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.41",
