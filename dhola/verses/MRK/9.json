              "attrs": {
                "loc": "LUK.22.24"
              },
              "items": [
                {
                  "text": "Luk 22:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jok'odwoko go, kwoŋbedo oyido nyaka jowok piem wegi kendi gin ni ŋa kwoŋ jo maloyo wadi gi dwoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.34",
            "verseOrgIds": [
              "MRK.9.34"
            ]
