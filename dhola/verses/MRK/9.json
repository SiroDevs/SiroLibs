          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Moro je m'omiy nyithindho me timo reco, d'ober ka otwey kidi madwoŋ i ŋute t'ibolo go i pendi wakawaka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.42",
            "verseOrgIds": [
