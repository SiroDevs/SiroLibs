                "loc": "MAL.3.1"
              },
              "items": [
                {
                  "text": "Mal 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ondiki i kitawo pa Isaya jatuci wac Were ni,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.2",
            "verseOrgIds": [
              "MRK.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Batisimo kodi karatem pa Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.8",
            "verseOrgIds": [
              "MRK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I hongo no ama Yesu owok'iye Nazareth i piny Galili aka Yohana obatisa go i jwom Yordan. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.9",
            "verseOrgIds": [
              "MRK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tekin Yesu wok i pi, oneno polo oyawere, to Cuny Maleŋ pie kwoŋe i cal p'akuru. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.10",
            "verseOrgIds": [
              "MRK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.2"
              },
              "items": [
                {
                  "text": "Cak 22:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.7"
              },
              "items": [
                {
                  "text": "Zab 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
