            "sid": "NUM 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa owaco ri jotel nonin ma Isiraili ni: Me apaka Rwoth owodho or. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
            "verseOrgIds": [
              "NUM.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka jacwo otimo cikirok ri Rwoth, kosa okwoŋere gi ciko gimoro, go kiripi turo wac pere. Go ripo timo gima go ociko gi dhoke je.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.2",
            "verseOrgIds": [
              "NUM.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
