        "style": "s1"
      },
      "items": [
        {
          "text": "Cik ma mako kwoŋ timo kwoŋirok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
