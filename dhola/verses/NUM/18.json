            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.30+LEV.27.31+LEV.27.32+LEV.27.33"
              },
              "items": [
                {
                  "text": "Jolevi 27:30-33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.22+DEU.14.23+DEU.14.24+DEU.14.25+DEU.14.26+DEU.14.27+DEU.14.28+DEU.14.29"
              },
              "items": [
                {
                  "text": "Cik 14:22-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ri nyikway Jolevi, atieko miyo acel wiy apar i Isiraili mar'alunja, kwoŋ tic ma jotimo, tic ma Wema ma romo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.21",
            "verseOrgIds": [
              "NUM.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joisiraili man jokiripi corok cegin gi Wema ma romo aka i nger me jonyalo kelo kwoŋ jo raco ma tho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.22",
            "verseOrgIds": [
              "NUM.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jolevi kende ama joripo timo tic ma Wema ma romo, aka jolabielo reco ma tim pajo; bino bedo cik ma cil gi cil ri luse mewin je. To i dier Joisiraili jok'olunji gimoro, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.23",
            "verseOrgIds": [
              "NUM.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "rupiri atieko miyo Jolevi paka adec pajo acel wiy apar pa Joisiraili, ma joketho gicen paka mic ri Rwoth. Riameno atieko luwo kwoŋ jo ni jokiripi lunjo gimoro i dier Joisiraili.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Acel wiy apar pa Jolevi",
          "type": "text"
        }
      ]
    },
    {
