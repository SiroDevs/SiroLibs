              "items": [
                {
                  "text": "Cik 3:23-27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.48+DEU.32.49+DEU.32.50+DEU.32.51+DEU.32.52"
              },
              "items": [
                {
                  "text": "32:48-52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwoth owaco ri Musa ni, “Idhi malo wi gote Abarim, akinen lowo m'atieko miyo Joisiraili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.12",
            "verseOrgIds": [
              "NUM.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'itieko neno ilatho, paka omin in Aron, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.13",
            "verseOrgIds": [
              "NUM.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwoŋbedo wigwenyere kwoŋ wac paran i thim ma Zin munyo lwak jodhaw kodan. Ikinyutho leŋo paran ruwaŋ jo i pi.” (Me pi manitie i Meriba Kades i thim ma Zin.)",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.14",
            "verseOrgIds": [
              "NUM.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
