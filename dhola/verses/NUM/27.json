                "loc": "EXO.24.13"
              },
              "items": [
                {
                  "text": "Wok 24:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth owaco ri Musa ni, “Ter Yosuwa wod pa Nun, jacwo manitie gi nyalo, aka ikethi cingin i wiye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.18",
            "verseOrgIds": [
              "NUM.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miy go cungo ruwaŋ Eliazar jacway ri Were i wi migam kodi lwak je, aka imiy go or lunjin ruwaŋ jo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.19",
            "verseOrgIds": [
              "NUM.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miy go dwoŋ perin moro, ŋey lwak pa Isiraili je jowowinji go. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.20",
            "verseOrgIds": [
              "NUM.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.30"
              },
              "items": [
                {
                  "text": "Wok 28:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.41"
              },
              "items": [
                {
                  "text": "1 Sam 14:41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.6"
              },
              "items": [
                {
                  "text": "28:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Go lagoŋere kwoŋ Eliazar jacway ri Were i wi migam, ma lamiyo go ŋeyo mito paran gi Urim ruwaŋ Rwoth. I nger me Eliazar latelo Yosuwa kodi lwak pa Isiraili i kisi gimoro.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.21",
            "verseOrgIds": [
              "NUM.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa otimo paka Rwoth omiyo go or. Go otero Yosuwa to miyo go cungo ruwaŋ Eliazar jacway ri Were i wi migam kodi lwak pa ji je. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.22",
            "verseOrgIds": [
              "NUM.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.23"
              },
              "items": [
                {
                  "text": "Cik 31:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musa oketho cinge i wi Yosuwa to miyo go or lunjo go paka Rwoth omiyo Musa or.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.23",
            "verseOrgIds": [
              "NUM.27.23"
            ]
          }
        }
      ]
    }
  ],
