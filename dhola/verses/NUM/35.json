                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ka nyatoro oneko nyawote, iripo neko janek ka ji jotieko miyo jakony; to wongoye dhano ma woneki gi miyo kony pa dhano acel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.30",
            "verseOrgIds": [
              "NUM.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiripi jolo cul ri kwo pa janek m'iripo neko, janek iripo neko. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.31",
            "verseOrgIds": [
              "NUM.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiripi jolo cul ri ŋat'oringo i tindi madwoŋ ma pondo, yeyo janek dok peco mafodi jadwoŋ pa jocway ri Were i wi migam k'otho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.32",
            "verseOrgIds": [
              "NUM.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiripi koco lowo ma wibed'iye, kole remo koco lowo, aka ongoye cul m'inyalo miyo ri lowo ri remo m'ooy'iye, kwanyowoko gi remo pa ŋat'oy'iye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.33",
            "verseOrgIds": [
              "NUM.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiripi koco lowo ma wibed'iye, ma an bende abed'iye, kole an Rwoth abedo i dier Joisiraili.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.34",
            "verseOrgIds": [
              "NUM.35.34"
            ]
          }
        }
      ]
