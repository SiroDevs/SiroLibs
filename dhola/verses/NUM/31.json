  "bookId": "NUM",
  "reference": "Kwan 31",
  "verseCount": 54,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "NUM 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lweny Maleŋ kwoŋ Jomidian",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth oluwo gi Musa ka waco ni: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.1",
            "verseOrgIds": [
              "NUM.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cul kwor ri Joisiraili kwoŋ Jomidian, aka rumacen icoki ji kanyacel.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.2",
            "verseOrgIds": [
              "NUM.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.2",
            "verseOrgIds": [
              "NUM.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa owaco ri ji ni, “Yer win cwo ma jolweny, ŋey jowomonji Jomidian nyalo culo kwor pa Rwoth kwoŋ Midian. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.3",
            "verseOrgIds": [
              "NUM.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wilayero cwo gana acel wok i kisi nono ma Isiraili kadho lweny. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.4",
            "verseOrgIds": [
              "NUM.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno joyero cwo gana acel wok i kis nono, aka kanyacel cwo gana apar g'ario joyikere lweny. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.5",
            "verseOrgIds": [
              "NUM.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ooro jo lweny kanyacel gi Finehas wod pa Eliazar jacway ri Were i wi migam, g'atewe ma Ot pa Were kodi gwarin ma kudho i cinge. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.6",
            "verseOrgIds": [
              "NUM.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jolwenyo gi Midian, paka Rwoth oyido owodho or ri Musa, aka joneko kisi jacwo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.7",
            "verseOrgIds": [
              "NUM.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joneko kerin ma Midian abic, Evi, Rekem, Zur, Hur kodi Reba medo i wi joman ma joneko; to joneko bende Balam wod pa Bewor g'abor. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.8",
            "verseOrgIds": [
              "NUM.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joisiraili jomako mon ma Midian kodi nyithindho pajo paka jotwec, jonyaga dhok pajo je, mwendi pajo, kodi gigipiny pajo je. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.9",
            "verseOrgIds": [
              "NUM.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jowaŋo woko tindin pajo je m'oyido jobed'iye kodi kambi je. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.10",
            "verseOrgIds": [
              "NUM.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "To jotero gigipiny pajo ma jomako kanyacel gi jotwec kodi ogwaŋe je. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.11",
            "verseOrgIds": [
              "NUM.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo jokelo jotwec je kodi gigipiny ma jonyaga ri Musa, Eliazar jacway ri Were i wi migam kodi lwak pa Isiraili i kambi i kam'obipere ma Mowab i thengi Yordan i Yeriko.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.12",
            "verseOrgIds": [
              "NUM.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jolweny jodwoko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.12",
            "verseOrgIds": [
              "NUM.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa, Eliazar jacway ri Were i wi migam kodi jotel pa lwak jowok romo gi jolweny woko ma kambi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.13",
            "verseOrgIds": [
              "NUM.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa omako nge gi jotel pa jolweny, jomituka ma ganin kodi jomituka ma miyin m'oyido jodwoko wok i lweny. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.14",
            "verseOrgIds": [
              "NUM.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa openjo jo ni, “Wiweyo mon je doŋ ma jokwo? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.15",
            "verseOrgIds": [
              "NUM.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mon me, ma Balam omiyo jo rieko, jomiyo Joisiraili timo maker kwoŋ Rwoth i wac ma mako kwoŋ Pewor, ŋey thoyamo opodho kwoŋ ji pa Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.16",
            "verseOrgIds": [
              "NUM.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo riameno, neki win nyithindho mayac je i dier jo kodi mon je ma jotieko nindo gi jacwo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.17",
            "verseOrgIds": [
              "NUM.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "To nyir mambula wey win jo makwo riwin. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.18",
            "verseOrgIds": [
              "NUM.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bedi win woko ma kambi ma ndelo abirio, kisi ŋat'oneko dhano moro je kosa omako delkwoŋ gim'otho, jowolonyere kodi jotwec mewin i ndelo mar'adek kodi i ndelo mar'abirio. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.19",
            "verseOrgIds": [
              "NUM.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiripo lonyo law je, kisi gim'otim gi pien je, kisi gim'otim gi yer diel, kodi kisi gim'otim gi mbawo.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.20",
            "verseOrgIds": [
              "NUM.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.20",
            "verseOrgIds": [
              "NUM.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliazar jacway ri Were i wi migam owaco ri ji m'oyido jowok i lweny ni, “Me fonji ma cik ma Rwoth owodho or ri Musa kwoŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.21",
            "verseOrgIds": [
              "NUM.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zahabu, feza, ywel, cuma, nyweny kodi waya, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.22",
            "verseOrgIds": [
              "NUM.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kisi gima kinyal waŋ i mac, iripo rewo i mac aka labedo m'olony. T'iripo bende lwoko gi pi, aka kisi gima nyalo waŋ i mac, ilalwoko gi pi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.23",
            "verseOrgIds": [
              "NUM.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiripo lwoko nangin mewin i ndelo mar'abirio, aka wilabedo m'olony, rumacen to widwoko i kambi.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.24",
            "verseOrgIds": [
              "NUM.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Poko gigipiny m'onyaga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.24",
            "verseOrgIds": [
              "NUM.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth oluwo gi Musa ka waco ni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.25",
            "verseOrgIds": [
              "NUM.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "In kodi Eliazar jacway ri Were i wi migam kodi jotel ma nonin wiripo kwano gigipiny m'onyaga, ji kodi ogwaŋe je. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.26",
            "verseOrgIds": [
              "NUM.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pok win gigipiny kadirio, i dier ji ma jowok lweny kodi lwak je. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.27",
            "verseOrgIds": [
              "NUM.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wok kwoŋ migew pa jolweny ma jowok lweny, kethi gicen misolo ri Rwoth, acel wok kwoŋ kisi gigipiny miya abic, obedi dhano, dhok, punde, rombo kosa diegi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.28",
            "verseOrgIds": [
              "NUM.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwany kwoŋ adec pajo aka imiy Eliazar jacway ri Were i wi migam paka mic ri Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.29",
            "verseOrgIds": [
              "NUM.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwany wok kwoŋ adec pa Joisiraili acel kwoŋ kisi piero abic, obedi ji, dhok, punde, rombo kosa diegi; wok kwoŋ ogwaŋe je aka imiy Jolevi ma jokuro Wema pa Rwoth.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.30",
            "verseOrgIds": [
              "NUM.31.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
