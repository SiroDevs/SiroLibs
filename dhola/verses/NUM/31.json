              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa kodi Eliazar jojolo zahabu wok bongi jo, je i cal ma gigipiny m'ocwey. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.51",
