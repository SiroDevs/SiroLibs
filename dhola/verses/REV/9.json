            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.23"
              },
              "items": [
                {
                  "text": "Dan 5:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ji m'odoŋ, ma thoyamo no k'oneko jo, jok'oŋuto kwoŋ gigipiny ma jotimo. Jok'oweyo lamo jwogi, kodi cal m'otimi gi zahabu, feza, ywel, tele kodi yath apaya ma kinyal neno, kosa winjo, kosa woth. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.20",
            "verseOrgIds": [
              "REV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
