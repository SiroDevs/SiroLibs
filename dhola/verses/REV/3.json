                }
              ]
            }
          ]
        },
        {
          "text": "Joma amaro, apusa jo odoko atwenyo jo. Am'omiyo bedi g'adieri kendo ŋuti kwoŋ reco perin. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.19",
            "verseOrgIds": [
              "REV.3.19"
            ]
          }
        },
        {
          "name": "verse",
