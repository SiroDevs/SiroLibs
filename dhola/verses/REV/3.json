            "number": "21",
            "style": "v",
            "sid": "REV 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat'oloy lweny abino miyo meni ma bedo bongan i kom paran ma dhum, paka abende atieko loyo lweny aka onyo abedo kabuti Baba i kom pere ma dhum.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.21",
            "verseOrgIds": [
              "REV.3.21"
            ]
