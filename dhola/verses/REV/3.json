          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka ee acungo dho thigo agudo; ka moro owinjo dwondan to yawo, abino donjo i ot pere t'acemo gine, to bende cemo kodan. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.20",
            "verseOrgIds": [
              "REV.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
