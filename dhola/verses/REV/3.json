              "items": [
                {
                  "text": "Luk 12:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ŋata loyo karatem bino rukere i ruk matar ameno, aka ak'orey woko nyinge i kitawo ma kwo aka abino tuco nyinge ruwaŋ Baba kodi jomalaika pere. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.5",
            "verseOrgIds": [
              "REV.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo ŋata nigi ithe, wowinji gima Cuny waco ri kitipin pa jom'oyeyo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.6",
            "verseOrgIds": [
              "REV.3.6"
            ]
          }
        }
      ]
    },
