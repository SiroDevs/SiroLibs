              "items": [
                {
                  "text": "Meny 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndiko m'owok bongi Yohana ri jom'oyeyo ma kitipin abirio ma iy'adec ma Asia.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        }
