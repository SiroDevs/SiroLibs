          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go omaro wan, aka gi remo pere ogonyo wan woko kwoŋ reco mawan, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
