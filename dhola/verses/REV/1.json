              "items": [
                {
                  "text": "Dan 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aka i dier gigipiny no, aneno ŋati m'ocalo Wod Dhano, m'oruko kanzu mabor to karo i kore del ma zahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
