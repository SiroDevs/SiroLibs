              "items": [
                {
                  "text": "Dan 10:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wiye kodi ye wiye oyido tar pa yer rombo matar, waŋe oyido cale mac maliel, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.14",
            "verseOrgIds": [
              "REV.1.14"
            ]
          }
