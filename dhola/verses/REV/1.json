                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "tiende oyido pilin pa nyweny m'onyel i kendo malieth, aka dwonde oyido cale derino ma gorok pa pi i nam. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.15",
            "verseOrgIds": [
              "REV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "I cinge maracuc, go oyido otiŋo micalin abirio, aka abor mabith ma nyalewe ario owok i dhoke, aka nyime onwaŋo cale waŋceŋ maliel gi meni mere je. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.16",
            "verseOrgIds": [
              "REV.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
