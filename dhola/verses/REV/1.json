            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.6"
              },
              "items": [
                {
                  "text": "Wok 19:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.10"
              },
              "items": [
                {
                  "text": "Meny 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " to loko wan bedo ker, kendo joma cwayo wi migam pa Were kendo Bamere. Dwoŋ kodi meni wobedi rigo cil gi cil. Ameno.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        }
