                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“An a marapena kendo macowe,” Rwoth Were Majameni je waco; go manitie pama, m'obedo con, kendo bino bedo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
