              },
              "items": [
                {
                  "text": "45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikenyo awinjo dwondi ŋatiman i polo, m'owaco ni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.4",
            "verseOrgIds": [
              "REV.18.4"
            ]
          }
