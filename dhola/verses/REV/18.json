          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka lero ma tala k'odoko oliel perin kendo. Odoko dwondi jamweha gi mweha pere k'odoko owinjere perin kendo. Jomitan perin oyido jobedo jomadongo loyo i piny gipi, aka thieth perin am'oyido iwondo gine ji je ma piny!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
          }
        }
