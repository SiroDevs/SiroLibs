                }
              ]
            }
          ]
        },
        {
          "text": "Wer pa jotongol kodi jower, jokudhi madundo kodi gwarin, k'owinji perin kendo! Ongoye jatic kosa jandijo moro je m'odoko bino nwaŋere perin kendo. Ongoye kidi kad'acel m'ibino winjo ka rego moko yu perin kendo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.22",
            "verseOrgIds": [
