        "style": "s1"
      },
      "items": [
        {
          "text": "Jatim giwickwot madwoŋ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
