              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.2",
            "verseOrgIds": [
              "REV.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.3",
            "verseOrgIds": [
              "REV.17.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "Meny 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo to malaika no tiŋan i Cuny Maleŋ to teran yuthim, t'aneno dhako m'obedo wi ogwaŋ m'obokere. Kwoŋ ogwaŋ no gipi oyido ondiki nyinge ma luwo gima k'otire kwoŋ Were aka oyido gi wic abirio kodi tunge apar. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.3",
            "verseOrgIds": [
              "REV.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Yer 51:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dheno oyido oruko nangin ma rangi ariŋo kodi m'obokere, aka kwoŋe oyido pilin gi zahabu, ge kodi telin ma welo. I cinge, go oyido otiŋo agwata ma zahabu m'opoŋ gi gigipiny ma timo cot kodi makoc, gima wok i kidakana pere. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.4",
            "verseOrgIds": [
              "REV.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nyime ondiki nyinge madwoŋ mere omuŋere ni: “Babilon madwoŋ, min mon ma jotana delkwoŋ jo i timo giwickwot je kodi joma duwo piny.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.5",
            "verseOrgIds": [
              "REV.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka aneno ni dhako no oyido omer gi remo pa ji maleŋ pa Were, kodi remo pa jom'onek rupiri jocwire kwoŋ Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.6",
            "verseOrgIds": [
              "REV.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo aneno go, adhier swa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.6",
            "verseOrgIds": [
              "REV.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo malaika no openjan ni, “Idhier raŋo?” Abino tuco rin dwoŋ nyaliŋliŋ ma mako kwoŋ dhako no kodi ogwaŋ m'otiŋo go, ma nyawic abirio gi tunge apar no. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.7",
            "verseOrgIds": [
              "REV.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.7"
              },
              "items": [
                {
                  "text": "Dan 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.7"
              },
              "items": [
                {
                  "text": "Meny 11:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.29"
              },
              "items": [
                {
                  "text": "Zab 69:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ogwaŋ m'ineno no oyido con kwo, to pama kikwo. Go cegin wok i bur mwombe ma bu gike aka bino tundo kama ilarey'iye go woko. Ji ma piny ma nyingi jo fodi k'ondiki i kitawo ma kwo wok i cakirok pa piny jobino dhier ka joneno ogwaŋ no, rupiri con oyido kwo, t'onyo pama kikwo, aka bino nenirok kendo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.8",
            "verseOrgIds": [
              "REV.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.8",
            "verseOrgIds": [
              "REV.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gime yenyo rieko kodi niaŋ. Wic abirio no obedo tendere abirio ma dheno bedo wiye, kendo jobedo kerin abirio bende. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.9",
            "verseOrgIds": [
              "REV.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoŋ jo, kerin abic jotieko podho, acel fodi dhumo, aka man fodi k'obino. Ka go obino go ripo cowo nyaka hongo macek. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.10",
            "verseOrgIds": [
              "REV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka ogwaŋ macon oyido kwo, t'onyo pama kikwo no, meno obedo kere mar'aboro manitie i kweth pa jabirio marapena aka bino tundo kam'ilarey'iye go woko.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.11",
            "verseOrgIds": [
              "REV.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.11",
            "verseOrgIds": [
              "REV.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.12",
            "verseOrgIds": [
              "REV.17.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.24"
              },
              "items": [
                {
                  "text": "Dan 7:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tunge apar m'ineno no, meno kerin apar ma fodi jok'ocako dhumo, t'ibino miyo jo meni ma dhum paka kerin cowo hongo ma sawa acel, kanyacel kodi ogwaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.12",
            "verseOrgIds": [
              "REV.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Japar me je jonitie g'atoŋa marom, aka jobino miyo ogwaŋ meni pajo gi nyalo ma dhum. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.13",
            "verseOrgIds": [
              "REV.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jobino lwenyo gi Nyathi rombo, to Nyathi rombo bino loyo jo, rupiri go obedo Rwoth kodi Kere pa kerin, aka joma ni bonge jobedo jom'olwoŋ kendo m'oyer aka jogenere.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.14",
            "verseOrgIds": [
              "REV.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.14",
            "verseOrgIds": [
              "REV.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika no bende owaco ran kendo ni, “Pi m'ineno, ma jatim giwickwot obed'iye no, meno ji, kodi Lwak ji, gi nonin gi dhodhok. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.15",
            "verseOrgIds": [
              "REV.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogwaŋ kodi tunge apar m'ineno no, jobino dak jatim giwickwot no. Jobino timo go kicar to joweyo go kinyoro, jobino camo delkwoŋe to joreyo woko go gi mac. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.16",
            "verseOrgIds": [
              "REV.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato Were oketho i cuny jono awanya ma tiyo g'atoŋa pere, munyo jotiyo gi paro acel to jomiyo ogwaŋ meni pajo ma dhum, cuka wac pa Were otimere.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.17",
            "verseOrgIds": [
              "REV.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.17",
            "verseOrgIds": [
              "REV.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Dhako m'ineno no meno tindi m'ombo ma dhumo kerin ma piny.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.18",
            "verseOrgIds": [
              "REV.17.18"
            ]
          }
        }
      ]
