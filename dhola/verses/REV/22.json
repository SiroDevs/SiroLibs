                "loc": "GEN.3.22"
              },
              "items": [
                {
                  "text": "3:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Josilwany a joma lwoko ruk pajo m'olony, aka ŋey jowobedi gi siem ma camo gima nyak kwoŋ yath ma kwo, gi donjo i tindi gi i waŋkac. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.14",
            "verseOrgIds": [
              "REV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "To woko koro nitie gwokere kodi jothieth, jocot kodi jonek, joma lamo cal makicar, kodi jotwodo je, i wac kodi i kwo pajo ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.15",
            "verseOrgIds": [
              "REV.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.1"
              },
              "items": [
                {
                  "text": "Isa 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“An, Yesu, aoro malaika paran rin gi mikwenda me ri kitipa pa jom'oyeyo. An anywola ma wok i ot pa Daudi, an a sulwe m'odikin maliel m'oasere.”",
          "type": "text",
