                }
              ]
            }
          ]
        },
        {
          "text": "Yesu owaco ni, “Neni, abino mayot. Anigi kemba paran, m'abino miyo kisi nyatoro cungo kwoŋ gima go otimo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.12",
            "verseOrgIds": [
              "REV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
