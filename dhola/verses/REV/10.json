                "loc": "AMO.3.7"
              },
              "items": [
                {
                  "text": "Amos 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikenyo malaika m'aneno munyo ocungo wi nam kodi wi lowo otiŋo cinge maracuc malo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.5",
            "verseOrgIds": [
              "REV.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "to kwoŋere i nyingi Were, ma bedo cil gi cil, m'ocweyo polo kodi gigipiny je manitie i iye, piny kodi gimoro je manitie i iye, kodi nam gi kisi gima nitie i iye. Malaika no owaco ni, “Galo odoko ongoye, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.6",
            "verseOrgIds": [
              "REV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "to i hongo ma malaika mar'abirio lakudh'iye gwara pere, gikenyo Were bino cowo can pere manyaliŋliŋ, paka cango onyutho jotic pere, jotuci wac Were.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.7",
            "verseOrgIds": [
              "REV.10.7"
            ]
          }
        }
      ]
    },
