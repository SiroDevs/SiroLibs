        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.10",
            "verseOrgIds": [
              "REV.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo owaco ran ni, “Iripo tuco mikwenda pa Were kendo ri ji mathoth kodi nonin, ri dhodhok kodi ri kerin je.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.11",
            "verseOrgIds": [
              "REV.10.11"
            ]
          }
        }
