              "items": [
                {
                  "text": "Meny 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Neni, Alabino nyaliŋliŋ pa jakwo! Jasilwany a ŋata bedo waŋe to gwoko ruk pere, ŋey wokiri wowothi kinyoro to kelo rigo wickwot!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
            "verseOrgIds": [
              "REV.16.15"
            ]
          }
        }
      ]
