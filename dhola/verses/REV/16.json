          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo malaika mar'abirio oolo atawo pere i hongo, to dwondi nyatoro ma luwo malo wok i kom ma dhum i Ot pa Were munyo waco ni, “Otieko timere!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.17",
            "verseOrgIds": [
              "REV.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 16:18"
          },
          "items": [
            {
              "text": "18",
