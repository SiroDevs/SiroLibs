              "items": [
                {
                  "text": "Isa 11:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo malaika mar'aucel oolo atawo pere i jwom madwoŋ m'ilwoŋo ni Yufrete, to jwom no dwono ma yawo royo ri kerin ma jowok yuwok ceŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.12",
            "verseOrgIds": [
              "REV.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo aneno cuny m'ocido jadek ma jocale g'ogwal munyo jowok i dhok bulir, i dhok ogwaŋ, kodi i dhok jatuci wac Were ma twodo ca. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jobedo cuny ma nyajwogi ma jotimo gir'aura. Cuny adek me jowok kareno jokidho pa kerin i piny gipi, coko jo kanyacel ma lweny i ndelo madwoŋ mapa Were Majameni je.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.14",
            "verseOrgIds": [
              "REV.16.14"
            ]
          }
        }
      ]
    },
