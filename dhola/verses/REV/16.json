                  "text": "Zek 12:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikenyo cuny no jokelo kerin kanyacel kam'ilwoŋo i Dhoyuda ni Amagedon.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.16",
