            "sid": "REV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo awinjo dwondi jo ma luwo malo munyo waco i Ot pa Were ri jomalaika abirio ni, “Kidhi wiol atewe abirio ma keme pa Were piny wi lowo!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        }
      ]
    },
    {
