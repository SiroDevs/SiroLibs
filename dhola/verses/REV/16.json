          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.9.10"
              },
              "items": [
                {
                  "text": "Wok 9:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika marapena okidho to olo atawo pere wi lowo, to adholin mareco kendo malith tula kwoŋ jom'oyido jonitie gi ranyuth p'ogwaŋ ca, ma jolamo cal pere.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo malaika mar'ario oolo atawo pere i nam, to pi lokere m'obokere pa remo dhano m'otho, to gima kwo i nam je jotho.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
