              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo aneno Nyathi rombo munyo halo woko acel kwoŋ gimwono papila abirio t'awinjo acel kwoŋ cwec aŋwen ca waco i dwonde ma cale lithkoth ma mwoc ni, “Biye!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.1",
            "verseOrgIds": [
              "REV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.1.8"
              },
              "items": [
                {
                  "text": "Zek 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.3"
              },
              "items": [
                {
                  "text": "6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aŋiyo aka ruwaŋan kenyo oyido nitie kayina matar. Ŋat'obedo wi kayina no otiŋo asere, aka omiy go sangaria. Go okadho paka jaloy lweny woloyi lweny kicutho.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
