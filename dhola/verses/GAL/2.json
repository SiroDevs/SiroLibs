                "loc": "ACT.11.30"
              },
              "items": [
                {
                  "text": "Tim 11:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.2"
              },
              "items": [
                {
                  "text": "15:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Munyo oro apar g'aŋwen okadho, agik Yerusalem kodi Barinaba, kareno akwanyo Tito bende awotho gine. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.1",
            "verseOrgIds": [
              "GAL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akidho rupiri Were oyido onyuthan nike akidhi; aka anyutho jotel Wac Manyen Maber m'oyido atito ri Jopath. To atimo gino nyaliŋliŋ gi lworo munyo akimito nike tic paran i hongo m'okadho kosa ma pama wotho nono. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.2",
            "verseOrgIds": [
              "GAL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odoko nyawotan Tito, kad'oyido obedo Jagrik, k'oromi go thumirok. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.3",
            "verseOrgIds": [
              "GAL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato jomoro, ma jorendere nike jobedo jom'oyeyo jowot wan, jodonjo i dier wan, aka oyido jomito ni wothum go. Jome oyido jolwi paka jopendo ka jomito ŋeyo ni siem aŋo ma wanigine i Kristo Yesu. Jono oyido jomito loko wan ŋecin. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.4",
            "verseOrgIds": [
              "GAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakiyeyo rijo kada masisiri, ŋey adieri ma Wac Manyen Maber wodoŋ riwin.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.5",
            "verseOrgIds": [
              "GAL.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.5",
            "verseOrgIds": [
              "GAL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.6",
            "verseOrgIds": [
              "GAL.2.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.17"
              },
              "items": [
                {
                  "text": "Cik 10:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "To jom'oyido itero jo paka jotel (awaco ama rupiri kikel ran pokirok moro gim'onwaŋo jobedo; kole Were kinen dhano cungo kwoŋ cal ma woko), jok'omedo wac moro je manyen kwoŋ mikwenda paran. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.6",
            "verseOrgIds": [
              "GAL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kucel, joneno ni Were oyido omiyan tic ma fonjo Jopath Wac Manyen Maber paka oyido omiyo Petero tic ma fonjo Joyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.7",
            "verseOrgIds": [
              "GAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato Were m'oyido tiyo i Petero paka jamoor pa Joyuda, bende am'oyido tiyo i an paka jamoor pa Jopath. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.8",
            "verseOrgIds": [
              "GAL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo, Petero, kodi Yohana, ma jobedo jotel, joyeyo riwo cingi jo gi wan kodi Barinaba munyo joniaŋ kwoŋ mic ma Were omiyan i nema pere. Wayere ni wan watiy i dier Jopath aka jo jowotiy i dier Joyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.9",
            "verseOrgIds": [
              "GAL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joyenyo kwoŋ wan gimoro acel kende ni wapoy jocandi, aka meno a gim'oyido abende ayiko timo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo ay kwoŋ Petero i Antiok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo Petero obino Antiok, apiemo gine i dier ji, rupiri banja oyido loyo go kamaler. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.11",
            "verseOrgIds": [
              "GAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo fodi jomoro ma Yakobo odhiro jok'otundo kenyo, Petero onwaŋo cemo kodi Jopath ma joyeyo. To munyo jome jotundo, to go dhire gicen munyo kwero cemo gi jono rupiri go oyido lworo joma joyenyo ni Jopath bende jowothumere. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.12",
            "verseOrgIds": [
              "GAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gino omiyo Joyuda man ma joyeyo bende jocako rendirok paka Petero; ma kiri Barinaba bende oyido tim ago ywayo go. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.13",
            "verseOrgIds": [
              "GAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo aneno ni jokiwothi i yo ma ripo kodi adieri ma Wac Manyen Maber, awaco ri Petero i waŋ joje ni, “Ka in Jayuda, itero kite pa Japath, makiweno apa Jayuda, inyalo nedi temo romo Jopath nike jowoteri kite pa Joyuda?”",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joyuda kodi Jopath je joboth ro yeyo pajo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adieri wabedo Joyuda i nywolirok mawan, makiweno Jopath ma jotimi reco. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.15",
            "verseOrgIds": [
              "GAL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.143.2"
              },
              "items": [
                {
                  "text": "Zab 143:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.20"
              },
              "items": [
                {
                  "text": "Rom 3:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.22"
              },
              "items": [
                {
                  "text": "Rom 3:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "To waŋeyo ni dhano iketho i tiro gi Were i yeyo kwoŋ Yesu Kristo, makiweno i timo gima Cik waco. Kole ongoye ŋat'iketho i tiro gi Were i timo gima Cik waco. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.16",
            "verseOrgIds": [
              "GAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo ka watemo ni wokethi wan i tiro gi Were, to nwaŋere nike fodi wabedo joreco paka Jopath, meno nyutho ni kosa Kristo tiyo ma konyo reco? K'ameno be! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.17",
            "verseOrgIds": [
              "GAL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'acako kendo gero gim'atieko kedho woko, meno nyutho ni aturo Cik. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.18",
            "verseOrgIds": [
              "GAL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato atieko tho kwoŋ luwo Cik, aka Cik won ama onekan, ŋey akwo ri Were. Otiek guran wi musalaba gi Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.19",
            "verseOrgIds": [
              "GAL.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "pama onyo aŋat'akikwo, to Kristo ama kwo i an. Aka kwo ma pama an gine, nitie i yeyo Wod Were m'omaran to miyo kwo pere ran. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.20",
            "verseOrgIds": [
              "GAL.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akikwer nema pa Were, rupiri ka dhano okethi i tiro gi Were ro luwo Cik, nyutho ni Kristo kere otho nono.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.21",
            "verseOrgIds": [
              "GAL.2.21"
            ]
          }
        }
      ]
    }
  ],
