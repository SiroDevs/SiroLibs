            "number": "23",
            "style": "v",
            "sid": "JDG 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideon odwoko jo ni, “An akiladhumo win, aka wodan kiladhumo win; Rwoth ama ladhumo win.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.23",
            "verseOrgIds": [
              "JDG.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideon omedo waco rijo ni, “Weyi atim kwac paran riwin, kisi dhano womiyan milom pere m'okwanyo.” Kole oyido jonitie gi milomin ma zahabu, kwoŋbedo oyido jobedo jonono pa Isimayil.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.24",
            "verseOrgIds": [
              "JDG.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.24",
            "verseOrgIds": [
              "JDG.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
