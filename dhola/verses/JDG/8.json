          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno Joisiraili jokengila Jomidian, aka jok'otiŋo wiy gin malo kendo. Lowo obedo m'okwe ma oro piero aŋwen i hongo pa Gideon.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.28",
            "verseOrgIds": [
              "JDG.8.28"
            ]
          }
        }
      ]
    },
    {
