      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.20",
            "verseOrgIds": [
              "JDG.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika pa Rwoth k'oneno kendo ri Manowa kodi cege. Kenyo Manowa oniaŋ nike oyido obedo malaika pa Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.21",
            "verseOrgIds": [
              "JDG.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manowa owaco ri cege ni, “Walatho adieri, kole watieko neno Were.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.22",
            "verseOrgIds": [
              "JDG.13.22"
            ]
          }
        }
      ]
    },
    {
