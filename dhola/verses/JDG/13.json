          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuny pa Rwoth ocako miyo go meni i Mahane Dan, i dier Zora kodi Esitayol.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.25",
