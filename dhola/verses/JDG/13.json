          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cege odwoko go ni, “Kabedi Rwoth oyido mito neko wan, dinyo k'ojolo mic awaŋa kodi mic ma cemo wok i cingi wan, kosa dinyo k'onyutho wan gime je, kosa pama miyo wan winjo nger gime.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.23",
            "verseOrgIds": [
              "JDG.13.23"
            ]
          }
        }
