          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhako onywolo wode, aka ocwoko nyinge ni Samson. Jayac odongo, aka Rwoth omiyo go silwany. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.24",
            "verseOrgIds": [
              "JDG.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
