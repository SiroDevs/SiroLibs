          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jodhum, jogavana, jomic rieko pa kere jocokere kanyacel aka joneno cwo me, ma mac k'onyalo waŋo jo, kosa yer pajo k'orewere, kosa law pajo k'owaŋ, aka kiri ŋwece mac oyido ongoye kwoŋ jo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.27",
            "verseOrgIds": [
              "DAN.3.27"
            ]
          }
        }
