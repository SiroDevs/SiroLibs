          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“To in kadhi i yo perin tundo i hongo ma gike. Ilaywomere t'iay jolo kemba perin i hongo ma gike.”",
          "type": "text",
