                "loc": "REV.12.14"
              },
              "items": [
                {
                  "text": "Meny 12:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jacwo m'oyido oruko nanga mafoth orieyo cinge maracuc kodi maracam malo yupolo. Awinjo munyo go kwoŋere i nyingi ŋata kwo cil gi cil, ka waco ni; dicel, dirio, g'adec, tekin go cowo kedho meni pa jomaleŋ, gime je latundo i kare. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.7",
            "verseOrgIds": [
              "DAN.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awinjo to oyido akiniaŋ; ameno apenjo ni, “Rwoth, aŋo ma lawok kwoŋ gime?”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.8",
            "verseOrgIds": [
              "DAN.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
