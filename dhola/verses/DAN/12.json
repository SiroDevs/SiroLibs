              },
              "items": [
                {
                  "text": "Yoh 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka mathoth kwoŋ jono ma jonindo i fukefuke ma lowo jolacew, megi i kwo makirum, megi i wickwot ma cil gi cil megi i kwo ma bukony. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.2",
            "verseOrgIds": [
              "DAN.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jomariek jolaliel paka lero ma pondeponde; aka jono ma jotelo ji kweth timo gim'otire jolaminyin paka micalin cil gi cil.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.3",
            "verseOrgIds": [
              "DAN.12.3"
            ]
          }
        }
      ]
    },
    {
