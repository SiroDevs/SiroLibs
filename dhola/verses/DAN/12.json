                {
                  "text": "12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I hongo no Mikaili laay, wod kere madwoŋ, m'obedo jatel pa ji perin. Labedo hongo ma candirok, nger candirok ma fodi k'otimere wok cuka nonin cakere. To i hongo no ilabotho ji perin, kisi ŋat'onwaŋ nyinge ondiki i kitawo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.1",
            "verseOrgIds": [
              "DAN.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.19"
              },
              "items": [
                {
                  "text": "Isa 26:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.46"
