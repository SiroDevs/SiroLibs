                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Wok i hongo m'ilakwanyo woko mic awaŋa ma cil gi cil kodi amien ma kelo kidamba, latero ndelo 290. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.11",
            "verseOrgIds": [
              "DAN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
