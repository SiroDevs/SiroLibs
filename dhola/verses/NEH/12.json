            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.23",
            "verseOrgIds": [
              "NEH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotel pa Jolevi, Hasabia, Serebia, Yesuwa, Binuy, kodi Kadmiel kodi wadi jo, jopoko Jolevi i kitipin ario, miyo Were pak, paka Kere Daudi, jacwo pa Were oyido owodho or.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.24",
            "verseOrgIds": [
              "NEH.12.24"
            ]
          }
        }
      ]
    },
    {
