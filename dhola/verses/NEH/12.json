            "sid": "NEH 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.21",
            "verseOrgIds": [
              "NEH.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "I hongo pa jodongo pa jocway ri Were i wi migam, Eliasib, Yoyada, Johanan, kodi Yaduwa, tundo kiri i hongo ma dhum pa Kere Dario ma Pasia, ondiki nyingi jotel ma pecin pa Jolevi kodi jocway ri Were i wi migam.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.22",
            "verseOrgIds": [
              "NEH.12.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.22",
            "verseOrgIds": [
              "NEH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ongoye gim'ondiki kwoŋ jotel ma pecin pa Jolevi munyo Yonathan, nyakwar Eliasib otieko tho.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.23",
            "verseOrgIds": [
              "NEH.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Poko tic ma Ot pa Were",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
