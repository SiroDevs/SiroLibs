              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo ka piero ario g'aŋwen ma dwe mar'abirio ji oyido jocokere joriyo kec i kutiyin to jowiro i wi jo fukefuke ma nyutho rem. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.1",
            "verseOrgIds": [
              "NEH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joisiraili jopokere kwoŋ jopath, aka jocungo to jotuco reco pajo gi reco pa kwarere pajo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.2",
            "verseOrgIds": [
              "NEH.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma sawa ma romo adek josoma Cik pa Rwoth Were pajo, aka ma sawa ma romo adek kendo jotuco reco pajo to jolamo Rwoth Were pajo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.3",
            "verseOrgIds": [
              "NEH.9.3"
            ]
          }
        }
      ]
    },
    {
