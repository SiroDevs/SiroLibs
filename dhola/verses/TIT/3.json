                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka tekin adhiro Aritema kosa Tikiko bongin, item paka inyalo bino bongan i Nikopoli, rupiri atieko yiko bedo kenyo i hongo ma pe ŋic'iye piny. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.12",
            "verseOrgIds": [
              "TIT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.24"
              },
              "items": [
                {
                  "text": "Tim 18:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.12"
              },
              "items": [
                {
                  "text": "1 Kor 16:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tem paka inyalo konyo Zena japido ri cik kodi Apolo i woth pajo, akinen ni jonitie gi gimoro je ma joyenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.13",
            "verseOrgIds": [
              "TIT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji mawan joripo fonjere timo tic mabeyo, ŋey jowolimi gikonyirok ma noknok aka nyaka jokiri jowobedi gi kwo m'ongoye kony.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        }
      ]
    },
