          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cwo me oyido jokelo gi nindo, atewe, degi, ŋano, bale, moko ŋano, ŋano m'obul, bijanjalo, ŋor, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.28",
            "verseOrgIds": [
              "2SA.17.28"
            ]
          }
        },
        {
          "name": "verse",
