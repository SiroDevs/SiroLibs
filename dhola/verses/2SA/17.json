          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo Daudi otundo i tindi Mahanayim, oromo gi Sobi wod pa Nahas, ma wok i tindi madwoŋ Raba i piny Amon, Makir wod pa Amiel, ma wok i tindi madwoŋ Lodebar, kodi Barzilay Jagiliad ma wok i tindi Rogelim. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.27",
            "verseOrgIds": [
              "2SA.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
