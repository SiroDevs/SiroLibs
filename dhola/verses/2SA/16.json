              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo Absalom owire bongi Ahithofel aka openjo go ni, “Miy rieko perin; watim aŋo?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.20",
            "verseOrgIds": [
              "2SA.16.20"
            ]
          }
        }
