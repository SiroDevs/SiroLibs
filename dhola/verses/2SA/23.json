            "sid": "2SA 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uriya ma wok Hiti; joje piero adek g'abirio.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.39",
            "verseOrgIds": [
              "2SA.23.39"
