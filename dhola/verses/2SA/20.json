          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ira m'owok i tindi ma Yayir bende oyido obedo jacway ri Were i wi migam pa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.26",
