                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aristariko, manitie i twec kodan, dhiro riwin moth kodi Mariko bende, omin Barinaba. (Witieko winjo wac kwoŋe; joli win go k'obino bongi win). ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.10",
            "verseOrgIds": [
              "COL.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
