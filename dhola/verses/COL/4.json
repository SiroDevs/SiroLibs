            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bedi win mariek i kite ma witero gine joma fodi jok'oyeyo, munyo wioro hongo ma winigine maber. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.5",
            "verseOrgIds": [
              "COL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiliesa mewin ripo ndir je bedo maŋon ma ywayo cuny jo pa kado cumbi, aka wiripo ŋeyo kite ma dwoko dhano je maber.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.6",
            "verseOrgIds": [
              "COL.4.6"
            ]
          }
        }
      ]
    },
