                "loc": "PHM.1.10+PHM.1.11+PHM.1.12"
              },
              "items": [
                {
                  "text": "Fili 1:10-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Go labino kodi Onesimo, omin wan ma genere ma wamaro, m'obedo acel kwoŋ win. Jobino waco riwin gimoro je ma timere ka.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
            "verseOrgIds": [
              "COL.4.9"
