          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awon anyalo ridho riwin ni go tiyo riwin matek kodi ri ji ma Lawodisia kodi Hirapoli. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.13",
            "verseOrgIds": [
