            "number": "11",
            "style": "v",
            "sid": "COL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu m'ilwoŋo ni Yusito, bende dhiro riwin moth. Jadek me kende a Joyuda ma joyeyo kwoŋ Kristo, ma jotiyo kodan ri Ker pa Were, aka jotieko konyan swa.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
