        },
        {
          "text": "Epafra, ma bende obedo acel kwoŋ win, kendo jatic pa Kristo Yesu bende m'otho win. Ndiri je go kwayo riwin gi maro madwoŋ, munyo kwayo Were womiy wicungi matek, ma witegino kareno wiridho paro ma timo gima Were yenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
