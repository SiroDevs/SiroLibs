              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were Baba kodi Rwoth Yesu Kristo, womiy jom'oyeyo je siem gi mar, medo wi yeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.23",
            "verseOrgIds": [
              "EPH.6.23"
            ]
