              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo adhiro go bongi win, wiŋey paka wanitie, aka wokwey cuny win. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
