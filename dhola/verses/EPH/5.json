                  "text": "1 Pet 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cwo, mari win mon mewin paka Kristo omaro kitipa pa jom'oyeyo to miyere rigo, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.25",
            "verseOrgIds": [
              "EPH.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EPH 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nike woloki go maleŋ kareno lonyo go gi pi kodi wac ma kwo, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.26",
            "verseOrgIds": [
              "EPH.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EPH 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋey wokel kitipa no bonge m'otieko lony ma bu cilo, kosa m'ongoye kam'ojony kendo m'ongoye kwoŋe sandi moro je. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.27",
            "verseOrgIds": [
              "EPH.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EPH 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno cwo bende joripo maro mon pajo paka delkwoŋ gin won. Ŋat'omaro cege meno won omare. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.28",
            "verseOrgIds": [
              "EPH.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EPH 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ongoye moro ma ruman dak delkwoŋe won, kucel pidho aka kuro maber, paka Kristo timo ri kitipa pa jom'oyeyo, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.29",
            "verseOrgIds": [
              "EPH.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EPH 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "rupiri wabedo adec ma delkwoŋe.) ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.30",
            "verseOrgIds": [
              "EPH.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EPH 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.24"
              },
              "items": [
                {
                  "text": "Cak 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Am'omiyo jacwo weyo bamere gi yokimere to cwire kwoŋ cege to jario no jolokere del acel. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.31",
            "verseOrgIds": [
              "EPH.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EPH 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me obedo wac m'opondo madwoŋ swa, aka me onyo ageda k'akidho kwoŋ Kristo kodi kitipa pa jom'oyeyo go. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.32",
            "verseOrgIds": [
              "EPH.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EPH 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno jacwo je ripo maro cege paka won omare, aka dhako bende ripo miyo cwore dwoŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.33",
            "verseOrgIds": [
              "EPH.5.33"
            ]
          }
        }
