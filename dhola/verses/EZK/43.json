                "loc": "EXO.27.1"
              },
              "items": [
                {
                  "text": "Wok 27:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.1"
              },
              "items": [
                {
                  "text": "2 Kigana 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Me rapim ma migam paka rapim ma Ot pa Were. Pende mere thoko labedo adec mita i ŋawirok, adec mita i laco, kodi thenge mere woko adec mar'adec mita i ŋawirok. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.13",
            "verseOrgIds": [
              "EZK.43.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 43:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wok i pende piny tundo i thenge piny obedo mita acel, gi laco ma adec mita, wok i thenge mathin tundo i madwoŋ obedo mita ario gi laco ma adec mita. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.14",
            "verseOrgIds": [
              "EZK.43.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 43:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malo ma migam obedo mita ario, aka wok malo kidho i tunge oyido nitie tunge aŋwen. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.15",
            "verseOrgIds": [
              "EZK.43.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 43:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malo ma migam labedo marom i kisi thenge, mita aucel i boro kodi mita aucel i laco. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.16",
            "verseOrgIds": [
              "EZK.43.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diere mere bende labedo marom i thenge je, mita ario i boro kodi mita ario i laco, gi thenge mere adec ma adec mita i laco, pende thoko adec mita. Madalin mere laŋiyo yuwok ceŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Loko migam maleŋ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 43:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.18",
            "verseOrgIds": [
              "EZK.43.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.35+EXO.29.36+EXO.29.37"
              },
              "items": [
                {
                  "text": "Wok 29:35-37",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go owaco ran ni, wod dhano, Rwoth Were waco ama. Me kwer ma migam, i ndelo m'ilaget'iye ri mic awaŋa i iye kodi ri kiro remo i iye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.18",
            "verseOrgIds": [
              "EZK.43.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 43:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth waco ni, ilamiyo jocway ri Were i wi migam, Jolevi, ma jobedo nyikway Zadok, ma jocore cegin kodan tiyo ran, thwon ri mic ma cwako reco. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.19",
            "verseOrgIds": [
              "EZK.43.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 43:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilakwanyo remo mere mogo, t'iketho i tunge aŋwen je ma migam, kodi i diere aŋwen, kodi i thenge thoko. Ameno apaka ilalonyo t'iloko maleŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.20",
            "verseOrgIds": [
              "EZK.43.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 43:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilakwanyo thwon ma mic ma cwako reco, aka ilawaŋo i kabedo m'oyer ma Ot pa Were, woko ma Kabedo Maleŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.21",
            "verseOrgIds": [
              "EZK.43.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 43:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ndelo mar'ario ilamiyo mic ma wod diel m'ongoye gi ŋolo ri mic ma cwako reco, aka ilalonyo migam gi remo mere paka olony gi remo ma thwon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.22",
            "verseOrgIds": [
              "EZK.43.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 43:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'itieko lonyo migam, ilamiyo mic ma thwon m'ongoye gi ŋolo kodi wod rombo wok i mwendi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.23",
            "verseOrgIds": [
              "EZK.43.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 43:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaketho ruwaŋ Rwoth, aka jocway ri Were i wi migam jolaywoyo kwoŋ jo cumbi to jomiyo paka mic awaŋa ri Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.24",
            "verseOrgIds": [
              "EZK.43.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 43:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndelo abirio, kisi ndelo, ilamiyo diel ri mic ma cwako reco, thwon kodi wod rombo bende ma jongoye gi ŋolo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.25",
            "verseOrgIds": [
              "EZK.43.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 43:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndelo abirio jocway ri Were i wi migam jolamiyo cowirok ma cwako reco ri migam aka jolalonyo to joloko maleŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.26",
            "verseOrgIds": [
              "EZK.43.26"
            ]
          }
        },
        {
