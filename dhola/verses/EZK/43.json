              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo jacwo no okelan i waŋkac ma ŋiyo yuwok ceŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.1",
            "verseOrgIds": [
              "EZK.43.1"
            ]
          }
        },
