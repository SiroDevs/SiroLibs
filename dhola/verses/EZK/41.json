{
  "id": "EZK.41",
  "number": "41",
  "bookId": "EZK",
  "reference": "Ezekiel 41",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
