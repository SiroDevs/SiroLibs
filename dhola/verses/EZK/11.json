              "EZK.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.22",
            "verseOrgIds": [
              "EZK.11.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.2+EZK.43.3+EZK.43.4+EZK.43.5"
              },
              "items": [
                {
                  "text": "Eze 43:2-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo kerubim joyaro bwombi jo, gi lipangala i thengi jo, aka dwoŋ pa Rwoth oyido nitie malo i wi jo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.22",
            "verseOrgIds": [
              "EZK.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwoŋ pa Rwoth oay malo wok i dier tindi madwoŋ, aka ocungo wi got yuwok ceŋ ma tindi madwoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.23",
            "verseOrgIds": [
              "EZK.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuny otiŋan to kelan i menyirok gi cuny pa Were bongi jotwec i Kaldeya meno i Babilon, aka rumacen menyirok no oweyan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.24",
            "verseOrgIds": [
              "EZK.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
