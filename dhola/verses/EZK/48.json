          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me lowo ma wilapoko paka lim alunja i dier nonin ma Isiraili, aka me adec pajo, Rwoth Were waco.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.29",
