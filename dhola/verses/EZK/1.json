              "items": [
                {
                  "text": "Eze 8:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aneno gima cale gima pilin, aka gima cale mac oumo thoko, aka wok i gima cale piere kadho malo kodi loro piny, aneno gima cale mac aka lero mere othoko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.27",
            "verseOrgIds": [
              "EZK.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
