              "items": [
                {
                  "text": "Meny 4:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "I wi cwec makwo oyido nitie gima cale pi m'omakere matek, ma pilin paka pe aka bwoko jo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.22",
            "verseOrgIds": [
              "EZK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "I pendi pi m'omakere matek bwombi jo oyare m'otire, ka geyo bwombi nyawote, aka kisi acel oumo delkwoŋe gi bwombe ario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.23",
            "verseOrgIds": [
              "EZK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.4+REV.1.5+REV.1.6+REV.1.7+REV.1.8+REV.1.9+REV.1.10+REV.1.11+REV.1.12+REV.1.13+REV.1.14+REV.1.15"
              },
              "items": [
                {
                  "text": "Meny 1:4-15",
                  "type": "text"
                }
