              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo aneno, apodho piny gi nyiman, aka awinjo dwondi dhano luwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
            "verseOrgIds": [
