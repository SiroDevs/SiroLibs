              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paka cal ma lifudo i pondeponde i ndelo ma koth, apaka cal ma lero thoko oyido nitie. Me oyido cal madwoŋ pa Rwoth.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
            "verseOrgIds": [
              "EZK.1.28"
            ]
          }
        }
