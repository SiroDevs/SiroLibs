              },
              "items": [
                {
                  "text": "19:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka jodhire awinjo derino ma bwombi jo paka derino ma nam, paka dwondi Jameni Je, kodi derino ma kambi pa jolweny. Ka jocungo jodolo bwombi jo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo dwondi owok malo ma pi m'omakere matek i wi jo, munyo jocungo to jodolo bwombi jo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
            "verseOrgIds": [
              "EZK.1.25"
            ]
          }
        }
