      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gima Were mito ni jatuci wac Were wotim",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rwoth thumo ri Samaria banja ma rerok",
          "type": "text"
        }
      ]
    },
