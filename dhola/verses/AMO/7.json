            }
          ]
        },
        {
          "text": "Rwoth Were onyuthan menyirok. Aneno go cweyo tome bonyo munyo nyaka otiek ŋado ri kere lum, aka lum oyido doko lothi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.1",
            "verseOrgIds": [
              "AMO.7.1"
            ]
          }
        },
        {
          "name": "verse",
