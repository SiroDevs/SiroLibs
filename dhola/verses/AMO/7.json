            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth onyuthan menyirok man. Aneno go ocungo i ŋeti kor ot m'ogeti gi kabiro, aka go oyido otiŋo kabiro i cinge. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.7",
            "verseOrgIds": [
              "AMO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka Rwoth openjan ni, “Amos, ineno aŋo?”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        }
      ]
