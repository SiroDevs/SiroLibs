              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.18.27+JDG.18.28+JDG.18.29"
              },
              "items": [
                {
                  "text": "Jothum 18:27-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "To munyo adec pa nyikway Dan orwenyo rijo, nyikway Dan jokidho malo to jolwenyo kodi Lesem, aka munyo jotieko mako to joneko ji mere, joloko apajo to jobed'iye, to jolwoŋo Lesem ni Dan, m'obedo nyingi Dan, kwari jo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.47",
            "verseOrgIds": [
              "JOS.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me a gir'alunja pa nono pa nyikway Dan, cungo kwoŋ pecin pajo tindin madongo me kodi calin pajo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.48",
            "verseOrgIds": [
              "JOS.19.48"
            ]
          }
        }
      ]
    },
    {
