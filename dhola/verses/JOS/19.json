          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwir mar'ario obol ri Simeo, nono pa nyikway Simeo cungo kwoŋ pecin; aka gir'alunja mere oyido nitie i dier gir'alunja pa nyikway Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.1",
            "verseOrgIds": [
              "JOS.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
