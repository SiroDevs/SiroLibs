          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 19:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me a gigipiny alunja ma Eliazar jacway ri Were i wi migam gi Yosuwa wod pa Nun kodi jotel ma pecin pa bacere ma nonin pa Joisiraili m'opok gi bolo kwir i Silo ruwaŋ Rwoth, i dhiot ma Wema ma romo. Onyo to jocowo poko lowo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.51",
            "verseOrgIds": [
              "JOS.19.51"
            ]
          }
        }
      ]
