        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me a kerin ma piny ma Yosuwa kodi Joisiraili jokengila yuthenge ma yupodho ceŋ ma Yordan, wok i Balgad i milelo ma Lebanon tundo i Got Halak, ma kadho yu Edom to Yosuwa miyo lowo pajo ri nonin ma Isiraili paka gipajo cungo kwoŋ pok pajo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.7",
            "verseOrgIds": [
              "JOS.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "i piny matendere, i lowo m'opiele, i Araba, i kamaloro, i thim, kodi yupiny, lowo pa Johiti, Joamor, Jokanan, Joperiz, Johivi, kodi Joyebus: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.8",
            "verseOrgIds": [
              "JOS.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kere ma Yeriko, acel; kere ma Ay, m'oluwere gi Bethel, acel; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.9",
            "verseOrgIds": [
              "JOS.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kere ma Yerusalem, acel; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.10",
            "verseOrgIds": [
              "JOS.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kere ma Hebron, acel; kere ma Yarmuth, acel; kere ma Lakis, acel; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.11",
            "verseOrgIds": [
              "JOS.12.11"
            ]
          }
        },
