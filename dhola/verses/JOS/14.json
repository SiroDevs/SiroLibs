              "JOS.14.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.30"
              },
              "items": [
                {
                  "text": "Kwan 14:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo to nyikway Yuda jobino bongi Yosuwa i Gilgal; to Kaleb wod pa Yefune Jakeniz waco rigo ni, “Iŋeyo gima Rwoth owaco ri Musa dhano pa Were i Kades Barineya ma mako in kodan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.6",
            "verseOrgIds": [
              "JOS.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.1+NUM.13.2+NUM.13.3+NUM.13.4+NUM.13.5+NUM.13.6+NUM.13.7+NUM.13.8+NUM.13.9+NUM.13.10+NUM.13.11+NUM.13.12+NUM.13.13+NUM.13.14+NUM.13.15+NUM.13.16+NUM.13.17+NUM.13.18+NUM.13.19+NUM.13.20+NUM.13.21+NUM.13.22+NUM.13.23+NUM.13.24+NUM.13.25+NUM.13.26+NUM.13.27+NUM.13.28+NUM.13.29+NUM.13.30"
              },
              "items": [
                {
                  "text": "Kwan 13:1-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oyido ajaoro piero aŋwen munyo Musa ŋeca pa Rwoth odhiran wok i Kades Barineya ma timo nyaliŋliŋ i piny; t'adwoko rigo wac mar'adieri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.7",
            "verseOrgIds": [
              "JOS.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "To wutmera ma jokidho malo kodan jomiyo cuny ji kirin; kucel aluwo Rwoth Were paran gi cunyan je.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
              "JOS.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.24"
              },
              "items": [
                {
                  "text": "Kwan 14:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "To Musa kwoŋere i ndelo no, ka waco ni, “Adieri lowo ma tiendin otieko nyono bino bedo gir'alunja rin kodi nyithindho perin cil gi cil, rupiri itieko luwo Rwoth Were paran gi cunyin je. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.9",
            "verseOrgIds": [
              "JOS.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "To pama, pak'ineno, Rwoth otieko kuran, paka owaco, oro piero aŋwen me gipi wok i hongo ma Rwoth oluwo wac me ri Musa, kareno Joisiraili oyido fodi jowotho i thim; aka onyo an e konon, ajaoro piero aboro g'abic. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fodi atek pa nyundu konon paka oyido abedo i ndelo no ma Musa odhiran; meni paran rom kodi ma ndino ca, ma lweny, ma kadho kodi ma dwoko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.11",
            "verseOrgIds": [
              "JOS.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo riameno miyan piny matendere me ma Rwoth oluwo kwoŋe ndelo no; kole iwinjo i ndelo no paka Joanakim oyido jonitie kenyo, gi tindin madongo m'otinda: Nyalo bedo ni Rwoth labedo kodan, aka alariemo jo woko paka Rwoth owaco.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo to Yosuwa miyo go silwany, to miyo Kaleb Hebron wod pa Yefune mar'alunja. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.13",
            "verseOrgIds": [
              "JOS.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno Hebron olokere gir'alunja pa Kaleb wod pa Yefune Jakeniz tundo konon, rupiri go oluwo Rwoth, Were pa Isiraili gi cunye je. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.14",
            "verseOrgIds": [
              "JOS.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo nyingi Hebron macon oyido obedo Kiriath Arba.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:15",
              "type": "text"
            },
            {
              "text": "Kiriath Araba",
              "type": "text"
            },
            {
              "text": "Dwoŋ mere nyutho Tindi Madwoŋ ma Araba",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arba me am'oyido obedo dhano madwoŋ loyo i dier Joanakim. To piny kwe m'ongoye lweny.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    }
  ],
