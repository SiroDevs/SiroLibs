              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.23",
            "verseOrgIds": [
              "ECC.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ECC 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
