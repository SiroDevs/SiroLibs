              "LUK.6.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 6:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raŋo ma wilwoŋan nike Rwoth, Rwoth, aka wikitim gim'awaco riwin? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.46",
            "verseOrgIds": [
              "LUK.6.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 6:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhano je ma bino bongan aka winjo wac paran to tiyo gine, abino nyutho win paka go cale: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.47",
            "verseOrgIds": [
              "LUK.6.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 6:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go cale dhano ma munyo geto ot pere, okunyo tiendi ot maluth tundo i ge; aka munyo mikula opoŋ to mol kwoŋ ot no, k'onyalo yengo, rupiri ot onwaŋo ogeti matek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.48",
            "verseOrgIds": [
              "LUK.6.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 6:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ŋata winjo wac me aka kitiy gine, cale dhano ma munyo geto ot pere, k'okunyo tiende maluth m'oromo; mikula omol kwoŋ ot no, to podho piyo piyo, to nyekere kicutho.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.49",
            "verseOrgIds": [
              "LUK.6.49"
            ]
          }
        }
      ]
