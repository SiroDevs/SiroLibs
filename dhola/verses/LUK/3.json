            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.35"
              },
              "items": [
                {
                  "text": "Luk 9:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikenyo Cuny Maleŋ oloro to pie kwoŋe i cal p'akuru, to dwondi jo moro wok i polo ma waco ni, “In i Wodan m'amaro; kendo asangala swa kodin.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
            "verseOrgIds": [
              "LUK.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tiendi nywolirok pa Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
