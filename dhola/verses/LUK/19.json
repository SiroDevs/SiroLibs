              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu otundo cegin gi tindi madwoŋ aka munyo oneno tindi no, oywako ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.41",
            "verseOrgIds": [
              "LUK.19.41"
            ]
          }
        },
