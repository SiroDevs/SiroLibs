              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu odonjo i Ot pa Were to cako riemo woko jomitan ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.45",
            "verseOrgIds": [
              "LUK.19.45"
            ]
          }
        },
