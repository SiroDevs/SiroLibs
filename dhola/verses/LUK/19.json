          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "munyo waco ni, “Bedi kada konon won iŋey gima d'okelo rin siem! To gino opanere ri waŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.42",
            "verseOrgIds": [
              "LUK.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole ndelo bino tundo ma jokwor perin jobino kuny'iye bur wugo thokin to jocegin iye je. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.43",
            "verseOrgIds": [
              "LUK.19.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jobino reyin woko kicutho gi ji manitie i cel perin; ongoye tele kad'acel ma jowey i wiy nyawote, rupiri ikinyalo ŋeyo ndir ma Were owend'iye rin.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.44",
            "verseOrgIds": [
              "LUK.19.44"
            ]
          }
        }
