                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.33"
              },
              "items": [
                {
                  "text": "Luk 11:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ongoye ŋata cwinyo tala to umo g'agono, kosa ketho i tiendi kitanda; kucel go ripo ŋawo tala no wi akare mere aka joma donjo i ot jowoneni lero. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.16",
            "verseOrgIds": [
              "LUK.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole ongoye gim'opanere ma k'othangi kamaler, kosa gima nyaliŋliŋ ma k'oŋeyere kamaler.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.17",
            "verseOrgIds": [
              "LUK.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
