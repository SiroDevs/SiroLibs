              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.33",
            "verseOrgIds": [
              "LUK.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“To gwokere win, cuny win wokiri wopoŋ awanya ma piny gi mero gi rembo ma kwo me, rupiri ndelo no nyalo coro win pa bwo m'ociki gine win. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.34",
            "verseOrgIds": [
              "LUK.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole Ndelo no bino tundo ri ji je man piny gipi p'apormalo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.35",
            "verseOrgIds": [
              "LUK.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo kure win aka wikway noknok nike wibedi gi meni ma ciro gigipiny ma bino timere me je to wicungo i nyim Wod Dhano.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.36",
            "verseOrgIds": [
              "LUK.21.36"
            ]
          }
        }
      ]
    },
