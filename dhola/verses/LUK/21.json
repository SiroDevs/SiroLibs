          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo Yesu oluwo iy'ageca ni, “Poyi win makuyu kodi yen man je. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.29",
            "verseOrgIds": [
              "LUK.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka wineno boke mere ocako lothi, wiŋeyo ni ceŋ cegin liel. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.30",
            "verseOrgIds": [
              "LUK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo bende ka wineno gigipiny me timere, ŋey win ni Ker pa Were cegin bino.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.31",
            "verseOrgIds": [
              "LUK.21.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.31",
            "verseOrgIds": [
              "LUK.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Adieri awaco riwin, luse ji ma ndir me jok'otho jorum mafodi gigipiny me je k'otimere. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.32",
            "verseOrgIds": [
              "LUK.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Polo gi piny bino rumo woko to wac paran kilarumo.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.33",
            "verseOrgIds": [
              "LUK.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gwokirok mitere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
