          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka odikin maŋic, ji je oyido jokidho bonge i Ot pa Were winjo fonji pere.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.38",
