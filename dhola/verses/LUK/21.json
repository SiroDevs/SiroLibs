            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ocowo ndelo moro munyo fonjo i Ot pa Were, to i dier wor go oyido omaro wok woko to bedo wi Got Oliv. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
