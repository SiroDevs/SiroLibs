        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika obino bonge to waco rigo ni, “Yoga, ijasilwany, Rwoth nitie kodin!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.28",
            "verseOrgIds": [
              "LUK.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go obwok swa munyo owinjo moth me, kende oparo g'icunye dwoŋ moth me. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.29",
            "verseOrgIds": [
              "LUK.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "To malaika no waco rigo ni, “Maria, ikir'ibedi gi lworo, rupiri ijasilwany ruwaŋ Were. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.30",
            "verseOrgIds": [
              "LUK.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.21"
              },
              "items": [
                {
                  "text": "Mat 1:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kole ibino gamo iyin, t'inywolo wodin; aka ibino cwoko nyinge ni Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.31",
            "verseOrgIds": [
              "LUK.1.31"
            ]
          }
        },
