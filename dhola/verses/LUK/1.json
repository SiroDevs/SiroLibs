          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maria owaco ni,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.46",
            "verseOrgIds": [
              "LUK.1.46"
            ]
          }
        }
