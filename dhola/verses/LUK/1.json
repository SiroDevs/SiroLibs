              },
              "items": [
                {
                  "text": "Isa 9:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Go bino bedo ŋatadwoŋ, aka ibino lwoŋo go ni Wod pa Were Madwoŋ Maloyo; aka Rwoth Were bino miyo go kom ma ker pa Daudi, kwari mere. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.32",
            "verseOrgIds": [
              "LUK.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go bino dhumo nyikway Yakobo cil gi cil aka Ker pere bino ngoye gike.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.33",
            "verseOrgIds": [
              "LUK.1.33"
            ]
          }
        }
