              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.9.2+ZEC.9.3+ZEC.9.4"
              },
              "items": [
                {
                  "text": "Zek 9:2-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Kidamba otundi rin, Korazin! Kidamba otundi rin, Bethsayida! Kole bedi gir'aura m'otimi i win tim i Tire kodi Sidon, di cango joŋuto con, aka di jobedo piny to joruko kutiya, to jobukere gi buru ma nyutho ni joŋuto reco. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were bino nyutho wor madwoŋ i ndelo ma thumo banja ri Tire kodi Sidon loyo riwin. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.14",
            "verseOrgIds": [
              "LUK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.13+ISA.14.14+ISA.14.15"
              },
              "items": [
                {
                  "text": "Isa 14:13-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka in Kapernaum, onwaŋo iyenyo tiŋirok malo tundo i polo? Ibino bolin i piny pa jom'otho ayino!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.15",
            "verseOrgIds": [
              "LUK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.40"
              },
              "items": [
                {
                  "text": "Mat 10:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.37"
              },
              "items": [
                {
                  "text": "Mar 9:37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.48"
              },
              "items": [
                {
                  "text": "Luk 9:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.20"
              },
              "items": [
                {
                  "text": "Yoh 13:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu owaco ri jofonjirok pere ni, “Ŋata winjo win, meno winjan; ŋata kwero win meno kweran; aka ŋata kweran, meno kwero Ŋat'ooran.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
            "verseOrgIds": [
              "LUK.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jofonjirok piero abirio g'ario jodwoko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
            "verseOrgIds": [
              "LUK.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jofonjirok piero abirio g'ario ca jodwoko munyo josangala, ka jowaco ni, “Rwoth, kiri jwogi je jowinjo wan ka waoro nyingin.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.17",
            "verseOrgIds": [
              "LUK.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu odwoko jo ni, “Aneno Sitan munyo podho pa lithkoth m'owok i polo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.18",
            "verseOrgIds": [
              "LUK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.91.13"
              },
              "items": [
                {
                  "text": "Zab 91:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Onyo atieko miyo win meni ma nyono gi tiendi win thwole kodi thwolgwok, gi nyalo woko meni pa jakwor je; kendo ongoye gima bino timo win marac. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.19",
            "verseOrgIds": [
              "LUK.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "To wikiri wisangala ni cuny m'ocido jowinjo win; kucel sangala win ni nyingi win ondiki i polo ayino.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.20",
            "verseOrgIds": [
              "LUK.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu sangala",
          "type": "text"
        }
      ]
    },
    {
