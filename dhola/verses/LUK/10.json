                "loc": "JHN.3.35"
              },
              "items": [
                {
                  "text": "Yoh 3:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.15"
              },
              "items": [
                {
                  "text": "Yoh 10:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Baba otieko miyan gimoro je; aka ongoye ŋat'oŋeyo Wode kwanyo woko Bamere, kendo ongoye ŋat'oŋeyo Baba kwanyo woko Wode kodi joma Wode oyero nyutho jo Bamere.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.22",
            "verseOrgIds": [
              "LUK.10.22"
            ]
          }
        }
