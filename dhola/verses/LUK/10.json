          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "I hongo no won Yesu osangala i Cuny Maleŋ aka owaco ni, “Afoyin Baba, Rwoth ma polo kodi piny, paka ipano gigipiny me ri jomariek kodi jom'ofonjere t'inyutho nyithindho ayin. Ey Baba, gime otimere paka iyenyo ni wotimere.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.21",
            "verseOrgIds": [
              "LUK.10.21"
            ]
          }
        }
      ]
    },
