          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.10",
            "verseOrgIds": [
              "ZEC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go odwokan ni, “Ma geto rigo ot i lowo ma Sinar, aka ilayiko, t'ijengo kenyo i kabedo mere.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.11",
            "verseOrgIds": [
              "ZEC.5.11"
            ]
          }
        }
