              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ndelo no ilandiko iy'olaŋere ma kayinin ni, “Leŋo ri Rwoth.” Degi ma Ot pa Rwoth lacale paka acerin ma ruwaŋ migam. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.20",
            "verseOrgIds": [
              "ZEC.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Degi je i Yerusalem kodi i Yuda labedo maleŋ ri Rwoth pa lwak jolweny, aka jono je ma jolabino miyo cowirok jolatero to joted'iye. I ndelo no, jamitan kilabedo i Ot pa Rwoth pa lwak jolweny.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.21",
            "verseOrgIds": [
              "ZEC.14.21"
            ]
          }
        }
      ]
    }
  ],
