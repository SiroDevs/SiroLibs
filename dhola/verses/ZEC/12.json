              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.20"
              },
              "items": [
                {
                  "text": "Mat 24:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Meny 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alakonjo kwoŋ ot pa Daudi kodi ji ma jobedo i Yerusalem, cuny ma wor kodi ma kwayo, aka jolanenan ŋata jocwowo to joywak paka ŋata ywako wode acel g'acel. Jolabedo gi geregere rigo, paka ŋata ywako kayo pere. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ndelo no ywak labedo madwoŋ i Yerusalem paka ywak ri Hadad Rimon i milelo ma Megido. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piny laywak, kisi peco won laywak; peco pa Daudi won kende, gi mon pajo kakendi gin; peco pa Nathan won kende, gi mon pajo kakendi gin; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "peco ma ot pa Levi won kende, gi mon pajo kakendi gin, peco pa Simey won kende, gi mon pajo kakendi gin, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "pecin je ma jodoŋ, kisi peco won kende, kodi mon pajo kakendi gin.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
      ]
    }
