              "items": [
                {
                  "text": "10:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Baba otieko miyan gimoro je, aka onyo ongoye ŋat'oŋeyo Wode kwanyo woko Bamere, kendo ongoye ŋat'oŋeyo Bamere kwanyo woko Wode kodi joma Wode odiero nyutho jo kamaler. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.27",
            "verseOrgIds": [
              "MAT.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biye win bongan wijoje ma wiol aka wilacere i tiŋo bieto mapek, labino miyo win ywomirok. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.28",
            "verseOrgIds": [
              "MAT.11.28"
