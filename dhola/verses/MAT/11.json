                }
              ]
            }
          ]
        },
        {
          "text": "Biel win okol paran i ŋuti win aka wifonjere kwoŋan; kole abedo moth aka abwonere iy'adundo paran; aka wibino nwaŋo ywomirok i cuny win. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
            "verseOrgIds": [
              "MAT.11.29"
