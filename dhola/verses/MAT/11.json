              "type": "text"
            }
          ]
        },
        {
          "text": "I hongo no Yesu owaco kamaler ni, “Afoyin Baba, Rwoth ma polo gi piny, rupiri ipano gigipiny me ri jomariek kodi jom'ofonjere t'iwodho kamaler ri nyithindho ayino. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ey, Baba, kole ama apaka cunyin osangala ni wotimere. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.26",
            "verseOrgIds": [
              "MAT.11.26"
            ]
          }
        },
        {
