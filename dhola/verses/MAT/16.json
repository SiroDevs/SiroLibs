              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero otero go gicen to cako ay kwoŋe ni, “Were wogeŋ gino, Rwoth! Gime wokiri wotimere rin!” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.22",
            "verseOrgIds": [
              "MAT.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
