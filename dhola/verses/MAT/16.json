          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu owire to waco ri Petero ni, “Eye bongan, Sitan! Iriwere ran i royo, rupiri paro perin me kiwoki bongi Were, to wok bongi dhano ayin.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.23",
