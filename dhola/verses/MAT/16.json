                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka ŋat'omiti botho kwo pere won bino rwenyo kwo; to ŋat'orweny kwo pere kwoŋbedo an bino nwaŋo kwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.25",
