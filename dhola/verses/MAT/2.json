            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.45"
              },
              "items": [
                {
                  "text": "Yoh 1:45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "to gero peco pere i tindi ma Nazareth. Go otimo ameno ma miyo gima jatuci wac Were owaco wotundi ni, “Ibino lwoŋo go ni Janazareth.”",
          "type": "text",
          "attrs": {
