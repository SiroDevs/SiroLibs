    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.7",
            "verseOrgIds": [
              "MAT.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikenyo jwogi otero Yesu wi got mabor swa, to nyutho go ker ma piny je, gi dwoŋ manitie i iye je. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.8",
            "verseOrgIds": [
              "MAT.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwogi owaco ni, “Abino miyin gi go je, ka iriewere ruwaŋan t'ilaman.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.9",
            "verseOrgIds": [
              "MAT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.13"
              },
              "items": [
                {
                  "text": "Cik 6:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikenyo Yesu odwoko ni, “Eye bongan Sitan! Ondiki ni, ‘Lami Rwoth Were perin aka itiy rigo won kende.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.10",
            "verseOrgIds": [
              "MAT.4.10"
            ]
          }
        }
      ]
    },
