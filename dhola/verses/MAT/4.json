            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu odwoko ni, “Kole ondiki bende ni, ‘Ikir'item Rwoth Were perin.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.7",
            "verseOrgIds": [
              "MAT.4.7"
            ]
          }
        }
