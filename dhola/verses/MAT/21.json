              "MAT.21.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 21:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo awaco riwin, Ker pa Were ibino kwanyo woko kwoŋ win t'imiyo ji ma jobino nyak gim'otire. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.43",
            "verseOrgIds": [
              "MAT.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "[Ŋat'opodhi wi tele me bino ŋadere wolokere mathindho thindho; aka ŋata tele me opodhi kwoŋe tele me opodhi kwoŋe, tele bino ŋinyo go loko go pa fukefuke].",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.44",
            "verseOrgIds": [
              "MAT.21.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.44",
            "verseOrgIds": [
              "MAT.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotel pa jocway ri Were i wi migam kodi Jofarisayo jowinjo agecin pa Yesu to joŋico nike go oyido luwo kwoŋ jo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.45",
            "verseOrgIds": [
              "MAT.21.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 21:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno jotemo mako go, to jolworo lwak ji ma joyeyo ni Yesu obedo jatuci wac Were.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.46",
            "verseOrgIds": [
              "MAT.21.46"
            ]
          }
        }
      ]
    }
