                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balwa m'owok bongi Paulo, Silvano kodi Timothe, Ri kitipa pa jom'oyeyo ma Thesalonika, ma jobedo apa Were Baba kodi Rwoth Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nema gi siem wobedi gi win.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwo kodi yeyo pa Jothesalonika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noknok wafoyo Were riwin, aka ndir je watuco win i kwayo mawan. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.2",
            "verseOrgIds": [
              "1TH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole wapoyo ruwaŋ Were mawan kodi Bawan paka wiketho yeyo mewin i tim, paka mar mewin omiyo witiyo matek, gi paka geno mewin i Rwodhiwan Yesu Kristo ocwiny. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.3",
            "verseOrgIds": [
              "1TH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waŋeyo, wutmin wan, nike Were omaro win aka oyero win ni wibedi apere won. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.4",
            "verseOrgIds": [
              "1TH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole Wac Manyen Maber ma wakelo riwin, k'obino nyaka i wac kende, to obino i meni kodi i Cuny Maleŋ, gi ridho kicutho kwoŋ adieri mere. Wiŋeyo paka kwo mawan obedo munyo oyido wanigi win kenyo; aka obedo ri bero mewin won. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.5",
            "verseOrgIds": [
              "1TH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.5+ACT.17.6+ACT.17.7+ACT.17.8+ACT.17.9"
              },
              "items": [
                {
                  "text": "Tim 17:5-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wilokere joma luwo wan kodi Rwoth; aka kada wicandere tektek, wijolo mikwenda gi kisangala ma wok bongi Cuny Maleŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.6",
            "verseOrgIds": [
              "1TH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno witieko lokirok ranen ri jom'oyeyo je i Makedonia kodi i Akaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.7",
            "verseOrgIds": [
              "1TH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole mikwenda ma mako kwoŋ Rwoth m'owok bongi win k'otundo ri Makedonia kodi Akaya kende, to wac kwoŋ yeyo mewin i Were olak i iye je. Am'omiyo, ongoye gima di wawaci kendo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.8",
            "verseOrgIds": [
              "1TH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole joma koro je jowaco paka wijolo wan munyo waliewo win, gi paka wiweyo lamo cal makicar to wigik bongi Were, tiyo ri Were mar'adieri odoko makwo, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.9",
            "verseOrgIds": [
              "1TH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "gi kuro Wode wobin wok i polo, m'obedo Yesu, ma Were ocerino go kwoŋ jom'otho, aka ama botho wan kwoŋ keme pa Were ma labino.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.10",
            "verseOrgIds": [
              "1TH.1.10"
            ]
          }
        }
      ]
    }
  ],
