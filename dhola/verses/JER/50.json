              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno winji win can ma Rwoth otieko timo kwoŋ Babilon, kodi atoŋa ma go otieko timo kwoŋ lowo ma Babilon. Adieri ilatero nyithindho pajo aka kisi dhano labwok. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.45",
            "verseOrgIds": [
              "JER.50.45"
            ]
          }
