        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.34",
            "verseOrgIds": [
              "JER.50.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 50:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth waco ama:",
