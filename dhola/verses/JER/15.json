          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alaketho rijo nger gima reyo jo aŋwen, Rwoth waco. Abor ma laneko, gwokere ma laywayo woko, winyin ma koyo kodi ogwaŋe madudi mager ma lacuto to reyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
