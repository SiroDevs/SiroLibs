              },
              "items": [
                {
                  "text": "Meny 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka jopenjin ni, “Wakidhi kune?” Dwoki jo ni: Me apaka Rwoth waco:",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
