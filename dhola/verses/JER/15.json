                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.1+2CH.33.2+2CH.33.3+2CH.33.4+2CH.33.5+2CH.33.6+2CH.33.7+2CH.33.8+2CH.33.9"
              },
              "items": [
                {
                  "text": "2 Kigana 33:1-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alaloko jo gilworo ri kerin je ma piny kwoŋbedo gima kere Manase wod Hezekia ma Yuda otimo i Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.4",
            "verseOrgIds": [
              "JER.15.4"
            ]
