          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "To i ndelo ma rumacen, aladwoko lim pa Elam kendo, Rwoth waco.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.39",
            "verseOrgIds": [
