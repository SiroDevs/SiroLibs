            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.27",
            "verseOrgIds": [
              "JER.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apenjere ni, “Kere Yehoyakin olokere paka jagi m'obare m'ibolo woko m'ongoye ŋata miti? Meno am'omiyo go kodi nyithindho pere obol jo woko i twec i piny ma jokuya?”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        }
      ]
    }
