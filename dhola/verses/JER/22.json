            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.8+2KI.24.9+2KI.24.10+2KI.24.11+2KI.24.12+2KI.24.13+2KI.24.14+2KI.24.15"
              },
              "items": [
                {
                  "text": "2 Kerin 24:8-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.9+2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Kigana 36:9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwoth owaco ri Kere Yehoyakin, wod pa Kere Yehoyakim ma Yuda ni, “Paka adieri Abedo Were makwo, kad'oyido ibedo atego ma cingan maracuc, alafudhin woko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.24",
            "verseOrgIds": [
              "JER.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "t'akethin i cingi jono ma jodwaro nekin, i cingi jono m'ilworo jo, kiri i cingi Kere Nebukadineza ma Babilon kodi i cingi jolweny pere. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.25",
            "verseOrgIds": [
              "JER.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alabolo win woko kodi dhako m'onywolo win i piny man, kama k'onywol'iye win, to witho kenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.26",
            "verseOrgIds": [
              "JER.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wilamito neno piny me kendo, to wik'ogiki.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.27",
            "verseOrgIds": [
              "JER.22.27"
            ]
          }
        }
      ]
    },
