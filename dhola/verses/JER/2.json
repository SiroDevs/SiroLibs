          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kidhi ititi mikwenda me ri kisi dhano ma Yerusalem. Me apaka Rwoth waco:",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.2",
            "verseOrgIds": [
              "JER.2.2"
            ]
          }
        }
