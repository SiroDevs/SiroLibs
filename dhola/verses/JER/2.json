          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winji win mikwenda pa Rwoth, win nyikway Yakobo, kodi pecin je ma ot pa Isiraili. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.4",
            "verseOrgIds": [
              "JER.2.4"
            ]
          }
        },
        {
