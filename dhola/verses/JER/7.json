              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno ibino luwo wac me je rijo, to jok'owinjin. Ilalwoŋo jo to jok'odwokin. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.27",
