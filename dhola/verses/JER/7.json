                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I Milelo ma Hinom jotieko geto migam m'ilwoŋo Tofeth, manitie i milelo pa wod Hinom, ma waŋo wot jo gi nyithindho manyir pajo i mac m'akioro jo, kosa k'obino kada i paro paran. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.31",
            "verseOrgIds": [
