          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno, adieri ndelo bino, Rwoth waco, ma doko k'olwoŋ ni Tofeth, kosa milelo pa wod pa Hinom, to milelo ma Yaŋirok; kole jolayikere i Tofeth cuka kabedo langoye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
