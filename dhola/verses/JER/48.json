                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.2.8+ZEP.2.9+ZEP.2.10+ZEP.2.11"
              },
              "items": [
                {
                  "text": "Zef 2:8-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Me wac ma mako kwoŋ Mowab,",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.1",
            "verseOrgIds": [
              "JER.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ireyo woko tindin madongo ma Mowab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.11",
            "verseOrgIds": [
              "JER.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno ndelo bino, Rwoth waco, m'abino dhiro ji ma jolayweyo go, aka jolalwindo atewe ma vini pere to joturo mathindho thindho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.12",
            "verseOrgIds": [
              "JER.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo wickwot lamako Jomowab gi were pajo Kemos, paka cango wickwot omako Joisiraili gi Bethel were m'oyido jogeno.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.13",
            "verseOrgIds": [
              "JER.48.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.20",
            "verseOrgIds": [
              "JER.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole otiek thumo banja ri piny m'obipere: Kwoŋ Holon, Jaza kodi Mefath. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.21",
            "verseOrgIds": [
              "JER.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dibon, Nebo kodi Beth Diblathayim. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.22",
            "verseOrgIds": [
              "JER.48.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiriathayim, Beth Gamul kodi Beth Mewon. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.23",
            "verseOrgIds": [
              "JER.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerioth, Bozra kodi tindin je i piny Mowab, bor kodi cegin. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.24",
            "verseOrgIds": [
              "JER.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otur woko tungi Mowab, aka dhum pere orey woko, Rwoth waco.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.25",
            "verseOrgIds": [
              "JER.48.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mowab lamwole",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.25",
            "verseOrgIds": [
              "JER.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth waco ni, Miy win Mowab womer, kwoŋbedo go otiŋere malo kwoŋ Rwoth. Weyi Mowab woŋindere i ŋok pere. Go bende lalokere ginyero. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.26",
            "verseOrgIds": [
              "JER.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiraili oyido obedo ginyero rin, makada nende k'omaki go i dier jokwo. To kisi k'oyido iluwo kwoŋ go, iyengo wiyin.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.27",
            "verseOrgIds": [
              "JER.48.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.33",
            "verseOrgIds": [
              "JER.48.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji ma Hesibon kodi Eliale joywak, aka ywak pajo winjere tundo kiri Yahaz. Dwondi jo winjere i Zowar kiri i Horonayim kodi Egilath Selisiya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.34",
            "verseOrgIds": [
              "JER.48.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth waco ni, “Alakwanyo woko ji ma jomiyo cowirok kodi mic ri werin pajo i kalamo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.35",
            "verseOrgIds": [
              "JER.48.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.35",
            "verseOrgIds": [
              "JER.48.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 48:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno adundo paran ywak ri Mowab paka madundo kodi ri ji ma Kiri Heres. Kole lim m'oyido jolimo orere woko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.36",
            "verseOrgIds": [
              "JER.48.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 48:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joje jotieko lielo ye wi jo kodi ye tik jo. Joje jogwero cingi jo to jotweyo kutiya i pier jo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.37",
            "verseOrgIds": [
              "JER.48.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 48:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "I wi udi ma Mowab je kodi kam'othangere je ongoye giman kwanyo woko ywak, kwoŋbedo an atieko turo woko Mowab paka atawo m'ongoye ŋata mito, Rwoth waco. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.38",
            "verseOrgIds": [
              "JER.48.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 48:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neni paka otur! Neni paka joyway! Neni paka Mowab owiro ŋeye i wickwot! Ameno apaka Mowab otieko lokere ginyero kodi gibwok ri joger pere je.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.39",
            "verseOrgIds": [
              "JER.48.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mowab kilakwale",
          "type": "text"
        }
      ]
    }
  ],
