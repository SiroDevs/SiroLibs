            "number": "10",
            "style": "v",
            "sid": "JER 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo t'awaco ni, “A, Rwoth Were, nga itieko wondo ji me kodi Yerusalem, k'iwaco ni, ‘Gigipiny lakadho maber gi win.’ Makada nende abor otieko tundo i dwondi jo!”",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.10",
            "verseOrgIds": [
              "JER.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jokwor jothoko Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rem pa Yeremia ri ji pere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Menyirok pa Yeremia ma rerok ma bino",
          "type": "text"
        }
      ]
    }
