              "type": "text"
            }
          ]
        },
        {
          "text": "Wutmera, agoyo riwin koko, i Rwoth Yesu Kristo kodi kwoŋ mar pa Cuny Maleŋ; riwere win kodan i kwayo m'ocwiny bongi Were, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.30",
            "verseOrgIds": [
              "ROM.15.30"
            ]
          }
        },
        {
