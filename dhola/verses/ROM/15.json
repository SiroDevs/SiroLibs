          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Am'omiyo alabino bongi win gi kisangala m'opoŋ, k'obedo mito pa Were, kareno awinjo siem i wendo paran bongi win. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.32",
            "verseOrgIds": [
              "ROM.15.32"
            ]
          }
        },
        {
