          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "nike go wokuran i bero kwoŋ joma jok'oyeyo i Yuda, ŋey ji pa Were jowojoli tic paran i Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.31",
            "verseOrgIds": [
              "ROM.15.31"
            ]
          }
        },
        {
