                "loc": "ISA.65.2"
              },
              "items": [
                {
                  "text": "Isa 65:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ma mako kwoŋ Isiraili go waco ni, “Atiŋo cingan malo ndelo gipi ri ji ma jocay kendo ma jopiem.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.21",
            "verseOrgIds": [
              "ROM.10.21"
            ]
          }
        }
      ]
