              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abraham oay kama delkwoŋ cege oyido nitie iye, aka okidho bongi Johiti to waco rijo ni, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.3",
            "verseOrgIds": [
              "GEN.23.3"
            ]
          }
        },
