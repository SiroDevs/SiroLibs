              "items": [
                {
                  "text": "Tim 7:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “An ajapath ma bedo i dier win, tana win an lowo moro, ŋey anyal yiko dhako paran.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.4",
            "verseOrgIds": [
              "GEN.23.4"
            ]
          }
        }
