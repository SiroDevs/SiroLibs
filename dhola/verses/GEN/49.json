              "items": [
                {
                  "text": "Tim 7:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Munyo Yakobo otieko ciko wote teltel, onindo piny kendo, to go tho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.33",
            "verseOrgIds": [
