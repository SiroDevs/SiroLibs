              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo bamere owaco rigo ni, “Core cegin wodan icwiy lemban.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.26",
            "verseOrgIds": [
