              "items": [
                {
                  "text": "Yak 2:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abram oyeyo gima Rwoth owaco, aka ro gime Rwoth oyeyo go paka ŋat'otire.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.6",
            "verseOrgIds": [
              "GEN.15.6"
            ]
          }
        }
      ]
