          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka winoter me bende kwoŋan to teko mako go, rem ma winokel ran dinyal nekan paka ati.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.29",
            "verseOrgIds": [
              "GEN.44.29"
