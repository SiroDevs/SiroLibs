              "type": "text"
            }
          ]
        },
        {
          "text": "Waŋceŋ oyido gulo munyo Loti otundo Zowar. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.23",
            "verseOrgIds": [
              "GEN.19.23"
