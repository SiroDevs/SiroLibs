        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo Farawo olwoŋo Musa aka owaco ni, “Kadhi wilam Rwoth, kiri gi nyithindho mewin kodi mon mewin jowokadhi. To weyi win rombo, diegi, kodi dhok mewin jowodoŋ ka.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.24",
            "verseOrgIds": [
              "EXO.10.24"
            ]
          }
        }
      ]
    },
    {
