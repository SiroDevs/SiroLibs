            "number": "28",
            "style": "v",
            "sid": "EXO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farawo owaco ri Musa ni, “Eye woko ruwaŋan! Ikir'imiyan anenin kendo! I ndelo ma inonenan iye, ibino tho.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.28",
