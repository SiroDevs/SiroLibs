          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth omiyo Farawo bedo gi wictek, aka k'onyalo weyo jo kadho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
              "EXO.10.27"
            ]
          }
