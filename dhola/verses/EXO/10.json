        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
            "verseOrgIds": [
              "EXO.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo Rwoth owaco ri Musa ni, “Riey cingin yupolo ŋey mudho wobin i lowo ma Misir, mudho mapek swa.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.21",
            "verseOrgIds": [
              "EXO.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.28"
              },
              "items": [
                {
                  "text": "Zab 105:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.10"
              },
              "items": [
                {
                  "text": "Meny 16:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ameno Musa orieyo cinge yupolo aka mudho mapek obedo i lowo ma Misir ma ndelo adek. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.22",
            "verseOrgIds": [
              "EXO.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jomisir jok'onyalo neno wegi, aka ongoye ŋat'owok i ot i hongo no. To Joisiraili oyido jonitie gi lero kama jobed'iye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.23",
            "verseOrgIds": [
              "EXO.10.23"
            ]
          }
        }
      ]
    },
