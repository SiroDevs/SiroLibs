          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa owaco ri Joisiraili ni, “Neni, Rwoth oyero Bezalel wod pa Uri, aka nyakwar Nun wok i nono pa Benyamin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were opoŋo go gi Cuny pa Were aka omiyo go ndijo, nyalo kodi niaŋ ri kisi tic ma pac, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma kidonya kodi timo jo gi zahabu, feza, kodi ywel, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.32",
            "verseOrgIds": [
              "EXO.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ŋado telin ma ketho, ma payo mbawin kodi tic man je ma pac. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.33",
            "verseOrgIds": [
              "EXO.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth bende omiyo go Oholiab wod pa Ahisamak wok i nono pa Dan, nyalo ma fonjo ji man bende ndijo pajo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 35:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth omiyo jo ndijo ma kisi nger tic ma timere gi jopac, jokwoco, kodi ji ma jokedo nangin mafoth, manyabululu, manyarangi ariŋo, kodi yer rombo m'obokere, kodi nangin man. Jonigi nyalo ma timo kisi nger tic aka jondijo ma kidonya.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.35",
            "verseOrgIds": [
              "EXO.35.35"
            ]
          }
        }
