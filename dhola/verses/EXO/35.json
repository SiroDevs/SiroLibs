              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa olwoŋo kweth pa Joisiraili je aka owaco rijo ni, “Me a gima Rwoth omiyo win cik timo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.1",
            "verseOrgIds": [
              "EXO.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.8+EXO.20.9+EXO.20.10+EXO.20.11"
              },
              "items": [
                {
                  "text": "Wok 20:8-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
