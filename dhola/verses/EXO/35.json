                "loc": "EXO.23.12"
              },
              "items": [
                {
                  "text": "23:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.31.15"
              },
              "items": [
                {
                  "text": "31:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
