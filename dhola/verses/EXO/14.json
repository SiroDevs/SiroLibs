              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi ogik to umo cawilin, jogwey, kodi jolweny pa Jomisir je m'oyido joluwo Joisiraili i nam, m'ongoye ŋat'obothi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.28",
            "verseOrgIds": [
