          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Joisiraili jowotho i lowo m'othwo gi pi i kisi thenge.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.29",
            "verseOrgIds": [
              "EXO.14.29"
            ]
          }
