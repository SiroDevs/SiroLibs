            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.17",
            "verseOrgIds": [
              "EXO.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo Musa okwayo ni, “Akwayin, nyuthan dwoŋ perin.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.18",
            "verseOrgIds": [
              "EXO.33.18"
            ]
          }
        }
