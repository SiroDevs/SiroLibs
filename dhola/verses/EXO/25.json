              "type": "text"
            }
          ]
        },
        {
          "text": "“Wotim raŋaw tala gi zahabu macil. Pende gi kore wotim gi zahabu m'ocadhi. Raŋaw tala gikululu kodi mawuwin mere iripo timo wok kwoŋ zahabu m'ocadhi ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.31",
            "verseOrgIds": [
              "EXO.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "gi jange aucel, adek i kisi thenge. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.32",
            "verseOrgIds": [
              "EXO.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisi jange wobedi gi mawuwin adek ma cale gi thiw yath alimond gi jange kodi thiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.33",
            "verseOrgIds": [
              "EXO.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kor raŋaw tala ripo bedo gi mawuwin aŋwen ma cale gi thiw yath alimond gi jange kodi thiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.34",
            "verseOrgIds": [
              "EXO.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ripo wobedi mawuwa kama kisi jange wok kwoŋ kore. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.35",
            "verseOrgIds": [
              "EXO.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawuwin, jange kodi raŋaw tala iripo timo gi zahabu macil m'ocadhi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.36",
            "verseOrgIds": [
              "EXO.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wotim talin abirio ri raŋaw tala, aka wokethi jowoliel ŋiyo yuwiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.37",
            "verseOrgIds": [
              "EXO.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wotim lew jo gi siniyin pajo gi zahabu macil. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.38",
            "verseOrgIds": [
              "EXO.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woor kilo piero adek g'abic ma zahabu macil ma timo raŋaw tala gi gigipiny mere je. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.39",
            "verseOrgIds": [
              "EXO.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
