                  "text": "9:3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wolier nanga m'iliero i ŋangi bol ma siragetere ma wi kisul Wema, aka wokethi Kakan ma Cikirok m'otiŋo telin mapando ario yuŋeye. Nanga m'olier bino poko Kabedo Maleŋ kwoŋ Kabedo Maleŋ Loyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wokethi giumo i wi Kakan ma Cikirok. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woko ma Kabedo Maleŋ Loyo, wokethi meza yumalo ma Wema kodi raŋaw tala yupiny.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
              "EXO.26.35"
            ]
          }
        }
