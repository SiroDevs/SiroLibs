                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ameno Saulo otho ro ngoye g'adieri ri Rwoth. Kole okwero winjo Rwoth munyo otemo rango kony wok bongi jwogi pa dhano m'otho, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka k'orango kony wok bongi Rwoth. Riameno Rwoth oneko go to miyo ker pere ri Daudi wod pa Yese.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
