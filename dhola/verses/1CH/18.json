                "loc": "PSA.60.2"
              },
              "items": [
                {
                  "text": "Zab 60:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisay, ma min obedo Zeruya okengila Joedom i milelo ma Cumbi aka oneko cwo 18,000. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
            "verseOrgIds": [
              "1CH.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oketho kambi ma lweny i Edom gipi, aka ji ma Edom jolokere ŋecin pa Daudi. Rwoth omiyo Daudi loyo kisi kam'okadh'iye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi odhumo Isiraili paka rom; aka otero ji pere maber gi tiro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.14",
            "verseOrgIds": [
              "1CH.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowab wod pa Zeruya oyido obedo jamituka jolweny pa Daudi; aka Yehosafat wod pa Ahilud am'oyido obedo jandiko kodi kano kisi gima timere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.15",
            "verseOrgIds": [
              "1CH.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zadok wod pa Ahitub, kodi Abimelek wod pa Abiatha oyido obedo jocway ri Were i wi migam; aka Seraya oyido obedo jandiko ma kapido. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.16",
            "verseOrgIds": [
              "1CH.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya wod pa Yehoyada oyido obedo jatel pa jokur pa Daudi; aka wot Daudi oyido jobedo toŋ waŋ kere.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.17",
            "verseOrgIds": [
              "1CH.18.17"
            ]
          }
        }
      ]
