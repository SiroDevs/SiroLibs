          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoŋ nyikway Izihar, Kenaya kodi wote, oyido omiy jo tic ma dhum, ndiko gim'otimere gi kano kodi thumo banjin ri Joisiraili.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
            "verseOrgIds": [
              "1CH.26.29"
            ]
          }
        }
      ]
