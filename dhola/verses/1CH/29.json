          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mic ma geto Ot pa Were",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.1",
            "verseOrgIds": [
              "1CH.29.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.5"
              },
              "items": [
                {
                  "text": "1 Kigana 22:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kere Daudi owaco ri ji je ni, “Wodan Solomon ama Were otieko yero, to go fodi thin aka ongoye gi ŋeyo ma tic. Tic m'iripo timo dwoŋ, kwoŋbedo me k'obedo peco pa ji to Ot pa Rwoth Were. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.1",
            "verseOrgIds": [
              "1CH.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno gi mindin paran atieko yiko gigipiny ma geto Ot pa Were; zahabu, feza, ywel, nyweny, mbawo kodi telin ma mitere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.2",
            "verseOrgIds": [
              "1CH.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka kiri, medo i wi meno, atieko miyo feza gi zahabu wok i lim paran ro mar paran ri Ot pa Were. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.3",
            "verseOrgIds": [
              "1CH.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atieko miyo tan ma kalo 100 ma zahabu macil kodi feza manyalo romo tan 240 makicin kor Ot pa Were ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.4",
            "verseOrgIds": [
              "1CH.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodi yiko gigipiny ma jondijo jolayiko. Onyo ŋa man ma lamiyo gi mito pere mic ri Rwoth?”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.5",
            "verseOrgIds": [
              "1CH.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.5",
            "verseOrgIds": [
              "1CH.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo jotel nonin, jodhum ma nonin, jomituka jolweny, kodi jodhum ma gigipiny pa kere jomiyere miyo ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.6",
            "verseOrgIds": [
              "1CH.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "gigipiny me ri tic ma Ot pa Were: Zahabu ma kalo tan 170 feza ma kalo tan 340 ywel manyalo romo tan 620 kodi nyweny ma kalo tan 3,400. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.7",
            "verseOrgIds": [
              "1CH.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jono m'oyido jonitie gi telin ma welo jomiyo i kakan pesa ma Ot pa Were, m'oyido dhumere gi Yehiel Jalevi ma wok Gerisom. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.8",
            "verseOrgIds": [
              "1CH.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo ji jofore kwoŋbedo oyido jomiyo Rwoth gigipiny kweth gi miyirok aka gi cuny gin acel. Kere Daudi bende osiemere swa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi pako Were",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo won ruwaŋ cokirok pa ji Kere Daudi opako Rwoth. Owaco ni, “Rwoth Were pa kwari wan Yakobo wopak cil gi cil. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.10",
            "verseOrgIds": [
              "1CH.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.13"
              },
              "items": [
                {
                  "text": "Mat 6:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aperin, awi Rwoth, obedo dwoŋo, meni, dwoŋ, loyo kodi dhum; kole gigipiny ma i polo kodi ma i piny obedo aperin; ibedo Kere, awi Rwoth, aka jadhum madwoŋ loyo kwoŋ gigipiny je. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.11",
            "verseOrgIds": [
              "1CH.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋaŋo je kodi lim wok bongin, aka idhumo je. Meni kodi teko nitie i cingin; aka inyalo loko dhano mogo je madwoŋ aka matek. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.12",
            "verseOrgIds": [
              "1CH.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyo, Were mawan, wafoyin, aka wapako nyingin ma didwoŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.13",
            "verseOrgIds": [
              "1CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.13",
            "verseOrgIds": [
              "1CH.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kucel an kodi ji paran wakinyalo miyin gimoro, kwoŋbedo gigipiny je jobedo mic ma wok bongin, aka wadwoko rin nyaka gim'obedo aperin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.14",
            "verseOrgIds": [
              "1CH.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iŋeyo Rwoth, nike waluwo i kwo paka jopath kodi jokicar, paka kwarere mawan jotimo. Ndelo i piny cale tipo, aka wangoye gi geno. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.15",
            "verseOrgIds": [
              "1CH.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awi Rwoth Were mawan, gigipiny ma gibe me je ma wamiyo ma geto rin ot ri nyingin maleŋ wok i cingin aka obedo aperin won. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.16",
            "verseOrgIds": [
              "1CH.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋeyo, Were paran, nike idwaro cuny dhano, aka iwinjo maber gi ji ma jotimo gim'otire. I tirok ma cunyan amiyo gigipiny me gi miyirok, aka onyo aneno ji perin, ma jonitie ka jomiyin mic gi miyirok kodi kisangala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.17",
            "verseOrgIds": [
              "1CH.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awi Rwoth, Were pa Abraham, Isaka kodi Yakobo, kwarere mawan, kur cil gi cil nger atoŋa kodi paro no i cuny ji perin, aka weyi jowobedi jor'adieri rin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.18",
            "verseOrgIds": [
              "1CH.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miy wodan Solomon wokur cik perin je gi cunye acel aka wogeti Ot pa Were m'atieko yiko gigipiny mere.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.19",
            "verseOrgIds": [
              "1CH.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.19",
            "verseOrgIds": [
              "1CH.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo Daudi omiyo ji je cik ni, “Pak win Rwoth Were mewin!” Aka cokirok pa ji je jopako Rwoth, Were pa kwarere pajo, aka jokule piny bwonirok ri Rwoth kodi kere pajo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndelo ma yawere jomiyo cowirok mar'ogwaŋe to jowaŋo mic ri Rwoth, aka jomiyo ji camo. Jothumo thwondhe 1,000 wot rombo 1,000 kodi nyithindhi rombo 1,000 ma jowaŋo paka cowirok ma gikululu i wi migam. Jokelo mic ma vini bende. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.21",
            "verseOrgIds": [
              "1CH.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno ndelo no josangala swa paka jocemo to jomedho ruwaŋ Rwoth.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owir Solomon gi mo madirio paka kere. I nyingi Rwoth owir go paka jadhum pajo kodi Zadok paka jacway ri Were i wi migam. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.12"
              },
              "items": [
                {
                  "text": "1 Kerin 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ameno Solomon olunjo bamere Daudi i kom ma dhum ma Rwoth oyido oketho. Go oyindira aka piny Isiraili gipi owinjo go. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.23",
            "verseOrgIds": [
              "1CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jodhum je kodi jolweny, kiri gi wot Daudi man je jociko woro Solomon paka kere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.24",
            "verseOrgIds": [
              "1CH.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
