{
  "id": "1CO.14",
  "number": "14",
  "bookId": "1CO",
  "reference": "1 Jokorintho 14",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
