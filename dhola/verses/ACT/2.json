        "style": "s1"
      },
      "items": [
        {
          "text": "Bino pa Cuny Maleŋ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
