{
  "id": "ACT.24",
  "number": "24",
  "bookId": "ACT",
  "reference": "Tim Pa Jomoor 24",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
