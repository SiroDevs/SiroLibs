          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.31",
            "verseOrgIds": [
              "ACT.4.31"
            ]
          }
        },
