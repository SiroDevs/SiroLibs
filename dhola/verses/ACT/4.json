          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jomoor jothielo wac ma cerino pa Rwoth Yesu gi meni m'oasere, aka joje jonwaŋo nema madwoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.33",
            "verseOrgIds": [
              "ACT.4.33"
            ]
          }
