              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "to joketho i cingi jomoor. Meno ama bin ipoko dhano je man kitipa m'onwaŋo cando gimoro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.35",
