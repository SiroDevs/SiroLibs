          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ongoye moro i kitipa pajo m'oyido cando gimoro, rupiri jom'onwaŋo jonitie gi lowo kosa udi jotana to jokelo pesa mere ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.34",
            "verseOrgIds": [
              "ACT.4.34"
            ]
          }
