            "sid": "1TI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balwa m'owok bongi Paulo, jamoor pa Kristo Yesu ro or pa Were ma Jaboth mawan kodi Kristo Yesu m'obedo geno mawan.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.1",
            "verseOrgIds": [
              "1TI.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.1",
            "verseOrgIds": [
              "1TI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.2",
            "verseOrgIds": [
              "1TI.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.1"
              },
              "items": [
                {
                  "text": "Tim 16:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ri Timothe, wodan adieri i yeyo.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.2",
            "verseOrgIds": [
              "1TI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weyi Were Bawan kodi Kristo Yesu Rwodhiwan womiy win nema, wor gi siem.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.2",
            "verseOrgIds": [
              "1TI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Juko jofonji ma twodo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.2",
            "verseOrgIds": [
              "1TI.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayenyo ni ibedi Efeso paka aorin munyo oyido anitie i woth paran acomo yu Makedonia. Juki joma kelo kenyo fonji ma twodo jowowey. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.3",
            "verseOrgIds": [
              "1TI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wac rijo jowowey kigana ma kiniaŋere kodi bol m'oruwo ma nyingi kwarere pajo, rupiri gino kelo piem kendekende, jokikony can pa Were, ma ŋeyere i yeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.4",
            "verseOrgIds": [
              "1TI.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atoŋa ma or me obedo mar, aka wok i cuny m'olony, kodi i paro m'otire, kodi i yeyo mar'adieri. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.5",
            "verseOrgIds": [
              "1TI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jomogo joloko ŋey gin ri gigipiny me to jorwenyo royo pajo i piem ma miŋo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.6",
            "verseOrgIds": [
              "1TI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jorodo bedo jofonji ma cik pa Were, to jokuya kiri dwoŋ wac pajo wegi, kosa gigipiny ma joluwo kwoŋe gi miseni.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.7",
            "verseOrgIds": [
              "1TI.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.7",
            "verseOrgIds": [
              "1TI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waŋeyo ni Cik ber k'oor i royo m'otire. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.8",
            "verseOrgIds": [
              "1TI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka waŋeyo, nike cik k'otimi ri ji mabeyo, to ri joma turo cik kodi jowictek, ri joma kilwor Were kodi joreco, ri joma kileŋ kodi joma kidew kwoŋ Were, ri joma neko bacere pajo kodi megi jo, ri joma neko jowoti gin. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.9",
            "verseOrgIds": [
              "1TI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ri jokidakana, ri jom'okom i timo giwickwot, ri joma tana ji, kodi jotwodo, gi joma wodho kony ma twodo, kosa joma timo gimoro je m'opokere kodi fonji m'otire ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.10",
            "verseOrgIds": [
              "1TI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma cungo kwoŋ Wac Manyen Maber ma didwoŋ, ma Were ma ripo g'apaka oketho i cingan.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.11",
            "verseOrgIds": [
              "1TI.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Foyo Were ro wor pere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.11",
            "verseOrgIds": [
              "1TI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afoyo Kristo Yesu Rwodhiwan, m'omiyan meni ma tic me, rupiri go oteran paka ŋata genere to kethan tiyo rigo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.12",
            "verseOrgIds": [
              "1TI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.3"
              },
              "items": [
                {
                  "text": "Tim 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.4+ACT.9.5"
              },
              "items": [
                {
                  "text": "9:4-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Makada nende con oyido aluwo kicar kwoŋe, kareno oyido alwenyo gi ji pere munyo aluwo kicar kwoŋe. To Were otimo kodan wor, rupiri oyido angoye gi yeyo aka oyido akuya kiri gim'atimo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.13",
            "verseOrgIds": [
              "1TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth okonjo ran nema pere m'oasere to miyan yeyo gi mar manitie i Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.14",
            "verseOrgIds": [
              "1TI.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me obedo wac mar'adieri, ma mitere ajola gi yeyo: Ni Kristo Yesu obino i piny botho joreco. Aka aŋat'aloyo i raco; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.15",
            "verseOrgIds": [
              "1TI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "to ro wac me Were onyuthan wor, ŋey Kristo Yesu wonyuthi diyo ici pere i tiyo kwoŋan, ŋatarac maloyo joreco je, paka ranen ri joma rumacen di joyeyo go to jolimo kwo makirum. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.16",
            "verseOrgIds": [
              "1TI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ri Kere ma cil gi cil, makitho aka kinenere, m'obedo Were kende, wor gi dwoŋ wobedi cil gi cil. Ameno.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.17",
            "verseOrgIds": [
              "1TI.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.17",
            "verseOrgIds": [
              "1TI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timothe, nyathi paran, amiyin or me ma ripo gi wac m'otuci kwoŋin con. Weyi wac no wobedi gilweny perin munyo ilwenyo lweny maber, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.18",
            "verseOrgIds": [
              "1TI.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka icwire kwoŋ yeyo perin kareno paro ma cunyin otire. Jomegi jok'owinjo paro ma cuny jo, to jonyeko woko yeyo pajo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.19",
            "verseOrgIds": [
              "1TI.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "I dier jo nitie Himenawo kodi Alekizanda, m'atieko bolo jo i meni pa Sitan, ŋey wofonji jo weyo luwo marac kwoŋ Were.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.20",
            "verseOrgIds": [
              "1TI.1.20"
            ]
          }
        }
      ]
    }
  ],
