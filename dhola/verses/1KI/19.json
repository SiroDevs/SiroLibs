        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.13",
            "verseOrgIds": [
              "1KI.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elia odwoko ni, “Rwoth Were Majameni je, noknok atiyo rin, to Joisiraili joturo cikirok pajo kodin, joturo piny migam, to neko jotuci wac Were perin je. An kendan aŋat'adoŋ, aka jorango nekan bende.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.14",
            "verseOrgIds": [
              "1KI.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
