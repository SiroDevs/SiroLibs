            "sid": "1KI 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa oweyo megikwe pere to luwo Elia gi ŋwec aka owaco rigo ni, “Weyi kudho asewila baba kodi mama aka ŋey aluwin.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.20",
            "verseOrgIds": [
              "1KI.19.20"
            ]
          }
        }
