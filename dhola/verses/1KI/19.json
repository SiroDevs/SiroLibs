                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth owaco ri Elia ni, “Gik Damasiko, aka ka itundo, wiri Hazael wobedi kere ma Siria, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.15",
            "verseOrgIds": [
              "1KI.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.1+2KI.9.2+2KI.9.3+2KI.9.4+2KI.9.5+2KI.9.6"
              },
              "items": [
                {
                  "text": "2 Kerin 9:1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wiri Yehu wod pa Nimisi wobedi kere ma Isiraili, aka i wiri Elisa wod pa Safat ma wok Abelmehola wolunjin paka jatuci wac Were. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.16",
            "verseOrgIds": [
              "1KI.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat'obothi abor pa Hazael, Yehu bino neko, aka ŋat'obothi abor pa Yehu Elisa bino neko. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.17",
            "verseOrgIds": [
              "1KI.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.4"
              },
              "items": [
                {
                  "text": "Rom 11:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kucel abino koyo ji 7,000 makwo i Isiraili. Jono je ma fodi jok'oguro congi gin ri Bal kosa jok'ocwiyo lembi cal pa Bal.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.18",
            "verseOrgIds": [
              "1KI.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lwoŋo pa Elisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.18",
            "verseOrgIds": [
              "1KI.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno Elia owok kenyo aka onwaŋo Elisa wod pa Safat furo gi megikwe i kitipin apar g'ario yuwiye, aka go oyido furo gi ma cen. Elia olunyo kanzu pere to bolo kwoŋ Elisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.19",
            "verseOrgIds": [
              "1KI.19.19"
            ]
          }
        },
        {
