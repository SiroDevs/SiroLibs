          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
            "verseOrgIds": [
              "1KI.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "I oro mar'adek ma dhum pa kere Asa ma Yuda, Basa obedo kere ma Isiraili gipi gi Tirisa, aka odhumo ma oro piero ario g'aŋwen. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
            "verseOrgIds": [
              "1KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basa otimo reco ruwaŋ Rwoth to miyo Joisiraili timo reco paka Yerobowam m'open dhumo rigo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.34",
            "verseOrgIds": [
              "1KI.15.34"
            ]
          }
        }
