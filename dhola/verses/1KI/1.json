          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.30",
            "verseOrgIds": [
              "1KI.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
