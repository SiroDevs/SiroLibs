          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathseba okule gi nyime piny aka owaco ni, “Weyi jadwoŋ paran kere wokwo cil gi cil!”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.31",
            "verseOrgIds": [
              "1KI.1.31"
            ]
          }
        }
      ]
