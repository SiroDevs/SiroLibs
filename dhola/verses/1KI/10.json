                  "text": "Cik 17:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka kayina ma donjo i piny pa Solomon oyido jowok i Misir kodi Kuwe, aka jomitan pere oyido jojolo gi Kuwe i welo moro. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
