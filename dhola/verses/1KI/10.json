                  "text": "Cik 17:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I ndir ma dhum pa Solomon feza oyido nitie kisi kamoro pa telin, aka yen sida oyido omore pa musikamol ma tiendi tendere i Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
