              "type": "text"
            }
          ]
        },
        {
          "text": "aka piny gibe oyido mito winjo rieko ma Were oyido omiyo go. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
