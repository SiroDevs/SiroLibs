          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerin ma piny gibe jowinjo kwoŋ rieko pere aka jooro ji winjo go.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.34",
            "verseOrgIds": [
