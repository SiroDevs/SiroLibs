            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SNG.1.1"
              },
              "items": [
                {
                  "text": "Wer 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwoth okuro cikirok pere ri Solomon aka omiyo go rieko. Siem obedo i dier Hiram kodi Solomon, aka jario jotimo cikirok.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kere Solomon oromo cwo 30,000 wok i Isiraili gipi ma jotimo tic mar'arom ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.13",
            "verseOrgIds": [
              "1KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka oketho jo i cingi Adoniram. Opoko jo i kitipin adek ma 10,000 aka kisi kitipa oyido bedo ma dwe i Lebanon kodi dwe ario peco. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.14",
            "verseOrgIds": [
              "1KI.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomon bende oyido nitie gi cwo 80,000 i piny matendere ma jogolo telin, kodi cwo 70,000 m'oyido jotiŋo, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.15",
            "verseOrgIds": [
              "1KI.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka oketho jo i cingi cwo 3,300 kikaŋasa tic pajo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.16",
            "verseOrgIds": [
              "1KI.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luwo kwoŋ cik pa kere Solomon, jogolo telin mafoth mapando ri kindi Ot pa Were. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.17",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameno jogeto pa Solomon gi jogeto pa Hiram kodi cwo ma jowok i Gebal joyiko telin gi mbawin ma geto Ot pa Were.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.18",
            "verseOrgIds": [
              "1KI.5.18"
            ]
          }
        }
      ]
    }
