            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth owaco ri Elia jatuci wac Were ni, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
