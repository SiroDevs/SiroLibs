          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahab otimo reco ma wickwot loyo to lamo cal pa Bal paka Joamor ma Rwoth oriemo wok i lowo no ndir ma Joisiraili jodonj'iye.)",
          "type": "text",
          "attrs": {
