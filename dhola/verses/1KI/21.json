              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyo Elia otieko luwo, Ahab oyeco woko nangin pere aka oruko kutiya. Okwero cemo, aka onindo i kutiya, to kadho kun.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
            "verseOrgIds": [
