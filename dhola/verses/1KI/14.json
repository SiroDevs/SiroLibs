          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehobowam otho aka oyiki go kam'oyik'iye bacere pere i tindi pa Daudi madwoŋ, aka wode m'ilwoŋo ni Abija olunjo go paka kere.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.31",
