              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.15+2CH.9.16"
              },
              "items": [
                {
                  "text": "2 Kigana 9:15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aka okwanyo lim je ma Ot pa Were gi ma cel pa kere pa kere, kiri gi kwote ma Solomon oyido otimo gi zahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
              "1KI.14.26"
            ]
          }
