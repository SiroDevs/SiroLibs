          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kere Rehobowam otimo kwote man gi ywel culo waŋ m'oyido otim gi zahabu aka omiyo jotel pa jokur ma waŋkac ma peco pere kuro. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka oyido kisi ka kere odonjo i Ot pa Rwoth, jokur oyido jotiŋo kwote, aka jodwoko i kisika m'ikuro iye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        }
