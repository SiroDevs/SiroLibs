              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giman je ma Rehobowam otimo ondiki i kitawo ma kigana ma mako kwoŋ kerin je ma Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
