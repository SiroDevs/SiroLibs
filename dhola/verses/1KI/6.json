          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thigin oyido oloki maŋon gi cal ma cwec ma jobwombi gin, cal ma yath thith, kodi cal ma mawuwin. Thigin, cwec ma jobwombi gin, kodi cal ma thith oyido oum gi zahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.32",
            "verseOrgIds": [
              "1KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
