              "1KI.6.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.18+EXO.25.19+EXO.25.20"
              },
              "items": [
                {
                  "text": "Wok 25:18-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otimi cwec ma jobwombi gin ario aka okethi i Kabedo Maleŋ Loyo, aka kisi acel oyido mita 4.4 i boro. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
              "1KI.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joje oyido jorom i dwoŋo gi cal. Joje oyido jobwombi gin ario, aka kisi bwombi gin oyido mita 2.2 i boro, ŋey wok i bwombi jo acel tundo i man obedo mita 4.4. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.24+1KI.6.25+1KI.6.26",
            "verseOrgIds": [
              "1KI.6.24",
              "1KI.6.25",
              "1KI.6.26"
