              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kor ot ma kisika madwoŋ gi kisika ma iye oloki maŋon gi cal ma cwec ma jobwombi gin, cal ma yath thith, kodi cal ma mawuwin. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.29",
