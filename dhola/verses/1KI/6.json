              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kindi ma Ot pa Were ocaki i dwe mar'ario, i dwe ma Ziv, i oro mar'aŋwen ma dhum pa Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
