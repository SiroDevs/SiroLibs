            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okethi jo i kisi thenge i Kabedo Maleŋ Loyo ŋey bwombi gin ario m'oyare jowomakere i dier kisika, aka bwombi gin ario man jowogey kor ot. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
