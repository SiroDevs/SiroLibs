          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otimi thigo m'olwowere gi mbawo yath nanzi m'oketh i dhiot ma Kabedo Maleŋ Loyo, aka wiye mere oyido oyedhere. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
              "1KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
