          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gime omiyo Saulo lworo Daudi, aka Daudi omedere bedo jakwor pere.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
