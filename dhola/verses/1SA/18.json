              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "To munyo Saulo oneno, oŋeyo ni Rwoth oyido nitie gi Daudi, aka kiri Joisiraili gi nyar Saulo Mikal je oyido jomaro go. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
