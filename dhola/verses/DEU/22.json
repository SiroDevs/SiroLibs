        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.10",
            "verseOrgIds": [
              "DEU.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiripi ruko nangin m'otimi kodi yer rombo gi nanga mafoth kanyacel.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.11",
            "verseOrgIds": [
              "DEU.22.11"
            ]
          }
        }
      ]
    },
