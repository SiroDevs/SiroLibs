          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka nitie nyako, mambula, aka obedo ombego pa jacwo moro, to jacwo man romo gi go i tindi to nindo gi go, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "joje iripo kelo jo i waŋkac ma tindi t'icadho jo gi tele cuka jotho, kwoŋbedo nyako k'oywaki ri kony i tindi aka jacwo no onindo gi cipa jager pere. Ameno wilakwanyo woko reco no i dier win.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
