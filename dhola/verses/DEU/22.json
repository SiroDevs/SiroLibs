          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paka jacwo no onwaŋo go kam'othangere, nyalo bedo nike go oywaki ri kony, to ngoye ŋat'okony go.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
            "verseOrgIds": [
              "DEU.22.27"
            ]
          }
        }
