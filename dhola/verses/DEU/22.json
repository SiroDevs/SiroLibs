                "loc": "LEV.19.19"
              },
              "items": [
                {
                  "text": "Jolevi 19:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiripi cwoyo kodhi man i ndelo vini perin, k'akameno kodhi m'icwoyo kodi ma vini lanyekere.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.9",
            "verseOrgIds": [
              "DEU.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.9",
            "verseOrgIds": [
              "DEU.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiripi fur gi megikwe kodi punde munyo otwey jo kanyacel.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.10",
            "verseOrgIds": [
              "DEU.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 22:10"
          },
          "items": [
            {
