                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.13"
              },
              "items": [
                {
                  "text": "Cak 28:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "maro Rwoth Were mewin, winjo dwondi go, kodi ketho go marapena. Kole go ama miyo win kwo kodi ndelo mabor, ŋey wibedi i lowo ma Rwoth okwoŋere ri kwarere mewin ri Abraham ri Isaka kodi ri Yakobo miyo jo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.20",
            "verseOrgIds": [
              "DEU.30.20"
            ]
          }
        }
      ]
