            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiripi fudho kew pa jager ma jodongo macon jocomo i lim m'ilamiyin i lowo ma Rwoth Were mewin miyo win.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cik ma mako kwoŋ jokony ma joluwo adieri",
          "type": "text"
        }
      ]
    },
