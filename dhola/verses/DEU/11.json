          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Silwany, ka winowinji or pa Rwoth Were mewin m'amiyo win konon. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.27",
            "verseOrgIds": [
