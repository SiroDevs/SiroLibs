            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ndelo acel no Musa omiyo ji or ka waco ama: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.11",
            "verseOrgIds": [
              "DEU.27.11"
            ]
