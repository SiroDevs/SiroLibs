          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka jacwo nyaka onywomo dhako, go kiripi kadho gi jolweny kosa timo tic ma makere gi lweny. Go ripo bedo peco ma oro acel, kisangala gi cege ma go onywomo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
