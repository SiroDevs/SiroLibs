          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wongoye dhano ma wosinga kidi kosa cuma ma rego, kole meno bedo paka kisinga kwo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
