          "items": [
            {
              "text": "\n        Jolevi 13:1—14:54\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwokere win kwoŋ thoyamo ma dhowo, luwo gi kinen fonji ma jocway ri Were i wi migam ma Jolevi jomiyo win, paka atieko miyo jo or. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
