            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiripi diyo jatic ma jacandi kosa jotic ma bu gimoro, obedi Joisiraili kosa jopath ma jobedo i lowo mewin i tindin mewin. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.14",
