          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iripo culo jo cul pajo kisi ndelo mafodi waŋceŋ k'opodho, kwoŋbedo jobedo jocandi aka meno apaka jokwo, ka k'obedo ameno jonyalo ywak ri Rwoth kwoŋin, aka labedo rin reco.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        }
