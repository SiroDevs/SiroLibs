                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.3"
              },
              "items": [
                {
                  "text": "Cak 26:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.13"
              },
              "items": [
                {
                  "text": "Cak 28:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwoth owaco rigo ni, “Me a lowo m'akwoŋere ri Abraham, Isaka kodi Yakobo, k'awaco ni, ‘Alamiyo nyikway win.’ Atieko miyin ineno gi waŋin, t'ikilatundo koro.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.4",
            "verseOrgIds": [
              "DEU.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.4",
            "verseOrgIds": [
              "DEU.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa, ŋeca pa Rwoth otho kenyo, i lowo ma Mowab, paka Rwoth owaco. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.5",
            "verseOrgIds": [
              "DEU.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyiki go i milelo i lowo ma Mowab, kam'otitere gi Beth Pewor, t'ongoye ŋat'oŋeyo kam'oyik'iye go kiri konon me. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.6",
            "verseOrgIds": [
              "DEU.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa otho munyo jaoro miya acel gi piero ario. Waŋe oyido fodi neno, aka go oyido fodi tek. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.7",
            "verseOrgIds": [
              "DEU.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joisiraili joywako Musa ma ndelo piero adek i milelo ma Mowab, kenyo hongo ma ywako Musa otundo i gike.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.8",
            "verseOrgIds": [
              "DEU.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.8",
            "verseOrgIds": [
              "DEU.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa wod pa Nun oyido opoŋ gi cuny ma rieko; rupiri Musa oyido otieko ketho cinge kwoŋe. Aka Joisiraili jowinjo go, timo paka Rwoth oyido omiyo Musa or.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.9",
            "verseOrgIds": [
              "DEU.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.9",
            "verseOrgIds": [
              "DEU.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ongoye kendo jatuci wac Were m'obedo i Isiraili m'ocalo Musa, ma Rwoth oyido oŋeyo awaŋ, g'awaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ranyuth je, kodi gir'aura ma Rwoth ooro go timo i lowo ma Misir, ri Farawo, ŋecin pere kodi lowo pere. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.11",
            "verseOrgIds": [
              "DEU.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "I cingi go ma meni, kodi gigipiny madongo ma kelo lworo, ma Musa otimo ruwaŋ Isiraili je.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.12",
            "verseOrgIds": [
              "DEU.34.12"
            ]
          }
        }
      ]
    }
