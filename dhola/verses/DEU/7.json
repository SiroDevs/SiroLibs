                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.18"
              },
              "items": [
                {
                  "text": "Kwan 14:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.9+DEU.5.10"
              },
              "items": [
                {
                  "text": "Cik 5:9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ŋey win riameno nike Rwoth Were mewin obedo Were, Were ma timo adieri ma kuro cikirok kiri i luse ganin pa jono ma jomaro go aka jokuro or pere, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.9",
            "verseOrgIds": [
              "DEU.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka go culo kwor kwoŋ jono ma jodak go. Go kibedi moth gi jo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.10",
            "verseOrgIds": [
              "DEU.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riameno kur win gi kinen, or, cik kodi fonji, m'amiyo win konon.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.11",
            "verseOrgIds": [
              "DEU.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Silwany ma winjo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.11",
            "verseOrgIds": [
              "DEU.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.12",
            "verseOrgIds": [
              "DEU.7.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.13+DEU.11.14+DEU.11.15+DEU.11.16+DEU.11.17"
              },
              "items": [
                {
                  "text": "Cik 11:13-17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka wiwinjo or me, gi kuro gi kinen, Rwoth Were mewin lakuro gi win cikirok i tirok ma go okwoŋere ri kwarere mewin. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.12",
            "verseOrgIds": [
              "DEU.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go lamaro win, lamiyo win silwany, lanyayo win, go lamiyo nywol mewin kodi nywol ma lowo mewin silwany, ŋano mewin kodi vini kodi mo mewin, nywol ma dhok mewin kodi mwendi mewin, i lowo ma go ociko kwarere mewin ni lamiyo win. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.13",
            "verseOrgIds": [
              "DEU.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wilabedo ji ma josilwany kwoŋ nonin je, m'ongoye ŋata kinywol i dier win kosa ogwaŋe mewin. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.14",
            "verseOrgIds": [
              "DEU.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth lakwanyo woko arama i dier win. Two marac je ma wineno i Misir, go kilakelo kwoŋ win, to lakelo kwoŋ jono ma jodak win. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.15",
            "verseOrgIds": [
              "DEU.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiripo reyo woko nonin je ma Rwoth Were mewin miyo win i cingi win, ongoye nyutho jo wor, kosa lamo werin pajo, kole meno labedo riwin bwo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.16",
            "verseOrgIds": [
              "DEU.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.16",
            "verseOrgIds": [
              "DEU.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wilawaco i cuny win ni, nonin me jothoth loyo wan, wanoriemi jo nedi? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.17",
            "verseOrgIds": [
              "DEU.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiri wibedi gi bwok rijo. Nyaka poyi win gima Rwoth Were mewin otimo ri Farawo kodi Misir gibe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.18",
            "verseOrgIds": [
              "DEU.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poy win thoyamo madongo ma wineno gi waŋ win, ranyuth kodi gir'aura, cinge ma meni kodi cinge m'oyare ma Rwoth Were mewin owodho gine win. Rwoth Were mewin latimo gimoro acel no ri nonin ma wibedo rijo gi bwok. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.19",
            "verseOrgIds": [
              "DEU.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka kiri Rwoth Were mewin ladhiro thoyamo kwoŋ jo, cuka kiri joma joboth kodi joma joringi je jorere woko. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.20",
            "verseOrgIds": [
              "DEU.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiri wibedi gi bwok rijo, kole Rwoth Were mewin, manitie gi win, obedo Were madwoŋ aka kelo lworo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.21",
            "verseOrgIds": [
              "DEU.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoth Were mewin lariemo woko nonin no ruwaŋ win, adec adec, wikilareyo woko jo dicel, ka k'obedo ameno ogwaŋe madudi jolamedere riwin. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.22",
            "verseOrgIds": [
              "DEU.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Rwoth Were mewin lajwango jo i cingi win, to bolo jo i kirin madwoŋ, cuka ireyo woko jo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.23",
            "verseOrgIds": [
              "DEU.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go lamiyo kerin pajo i cingi win aka wilareyo woko nyingi jo i pendi polo, ongoye ŋata lanyalo ciro win, cuka winotiek reyo woko jo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.24",
            "verseOrgIds": [
              "DEU.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cal ma werin pajo wiwaŋ woko gi mac. Wikiri wiwanya feza kosa zahabu manitie kwoŋ jo ma doŋ gine, kwoŋbedo labedo riwin bwo, kole obedo amien ri Rwoth Were mewin. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.25",
            "verseOrgIds": [
              "DEU.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikiri wikel gir'amien i pecin mewin, kosa win bende ilareyo woko win paka jo. Wiripo dak, to wikwero, kwoŋbedo okethi gicen ma reyo woko.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.26",
            "verseOrgIds": [
              "DEU.7.26"
            ]
          }
        }
      ]
    }
