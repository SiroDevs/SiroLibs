                "loc": "NUM.29.7+NUM.29.8+NUM.29.9+NUM.29.10+NUM.29.11"
              },
              "items": [
                {
                  "text": "Kwan 29:7-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka labedo cik riwin cil gi cil ni k'apar i dwe mar'abirio, wilamiyo delkwoŋ win litho aka wik'otim tic moro je, obedi japiny kosa jakicar ma bedo i dier win. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rupiri i ndelo no am'ila timo cowirok ma cwako reco riwin, ma cwako reco mewin je, aka ŋey winyal lony ruwaŋ Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me obedo sabato ma ywomirok adieri riwin, wilamiyo delkwoŋ win litho, obedo cik ma cil gi cil. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka jacway ri Were i wi migam m'owir gi mo t'iloko maleŋ paka jacway ri Were i wi migam m'olunjo waŋ bamere latimo cowirok ma cwako reco, aka laruko law matar mafoth, law ma leŋo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go latimo cowirok ma cwako reco ri Kabedo Maleŋ, Wema ma romo kodi ri migam, ri jocway ri were i wi migam kodi ri lwak ji je. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka me labedo cik cil gi cil riwin, timo cowirok ma cwako reco ri Joisiraili dicel i oro. Aka go otimo paka Rwoth omiyo Musa or.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
