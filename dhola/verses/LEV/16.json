            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyo Aron labino i Wema ma romo to lunyo woko law matar mafoth ma go oruko munyo donjo i Kabedo Maleŋ to weyo jo kenyo; ",
          "type": "text",
          "attrs": {
