          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me cik ma mako kwoŋ ogwaŋe, winyin, kodi kisi cwec ma wotho i pi, kodi cwec je ma jolak piny, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ketho pokirok i dier gimakoc kodi gim'olony, i dier cwec makwo m'icamo kodi ma kicam.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.47",
