              "LEV.14.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 14:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Me obedo cik kwoŋ two dhowo moro je; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.54",
            "verseOrgIds": [
              "LEV.14.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 14:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "ri dhowo ma nanga, kosa i ot, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.55",
            "verseOrgIds": [
              "LEV.14.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 14:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodi ri gima kwot kosa kam'otawa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.56",
            "verseOrgIds": [
              "LEV.14.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 14:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma nyutho ka koc kodi ka olony. Me obedo cik ri dhowo.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.57",
            "verseOrgIds": [
              "LEV.14.57"
            ]
          }
        }
      ]
