        },
        {
          "text": "Rwoth oluwo gi Musa ka waco ama: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.1",
            "verseOrgIds": [
              "LEV.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luw gi Joisiraili iwaci rijo ni: Kwoŋ kalimin pa Rwoth ma wiripo tuco paka cokirok maleŋ, me ama jobedo kalimin paran.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.2",
            "verseOrgIds": [
              "LEV.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kalima ma Kadho kodi Kalima ma Mugat ma buthow",
          "type": "text"
        }
      ]
    },
