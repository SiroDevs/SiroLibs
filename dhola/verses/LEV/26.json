          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me a cik kodi or ma Rwoth ocweyo i dier go kodi Joisiraili wi got Sinai ka luwo gi Musa.",
          "type": "text",
