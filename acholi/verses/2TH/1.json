              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bot lwak jo muye Kricito ma gibedo i Tecalonika ma gitye i Lubaŋa Won ki Rwotwa Yecu Kricito:",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
            ]
          }
        }
      ]
    },
    {
