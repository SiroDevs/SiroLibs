              "type": "text"
            }
          ]
        },
        {
          "text": " Doŋ macalo Cwiny Maleŋ oloko ni,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.7",
            "verseOrgIds": [
              "HEB.3.7"
            ]
