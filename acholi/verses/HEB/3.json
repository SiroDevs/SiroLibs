              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " macalo yam giwaco ni,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.15",
            "verseOrgIds": [
              "HEB.3.15"
            ]
