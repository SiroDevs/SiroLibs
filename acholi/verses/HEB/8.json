              "type": "text"
            }
          ]
        },
        {
          "text": " Ento Lubaŋa onoŋo bal tye i komgi, pien owaco ni,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        }
