            "verseId": "HEB.8.12",
            "verseOrgIds": [
              "HEB.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka oloko pi gicikke manyen, en tamo pi gicikke mukwoŋo ca macalo gin ma karene okato woko. Gin ma karene doŋ okato, ma oti woko bene, noŋo doŋ cok rwenyo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.13",
