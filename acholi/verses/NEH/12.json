              "NEH.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NEH 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom nino meno giyero jo ma giloyo kicika odi me kano jami, ka ma gigwoko iye jami ma gimiyo me kony pi ot pa Lubaŋa, kal manyen ki nyig yat mukwoŋo cek i mwaka acel acel, kacel ki dul acel me apar, me keto i igi jami ducu kit macalo cik mito pi konyo ajwagi ki Lulevi, kun lubo kit wei potti ma i gaŋi matino. Jo Juda cwinygi obedo yom twatwal i kom ajwagi ki Lulevi ma gubedo ka tic. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.44",
            "verseOrgIds": [
              "NEH.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NEH 12:45"
          },
          "items": [
