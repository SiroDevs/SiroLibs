            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.12"
              },
              "items": [
                {
                  "text": "26.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gin gutiyo gin ma Lubaŋagi ocikogi, dok bene gutiyo tic me lonyo dano, kit macalo yam luwer ki lugwok-doggola gutimo, kit macalo con Daudi ki wode Solomon guciko, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.45",
            "verseOrgIds": [
              "NEH.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NEH 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare pa Daudi ki Acap ma onoŋo ladit me wer, luwer onoŋo giwero wer me pak ki me miyo pwoc bot Lubaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
            "verseOrgIds": [
              "NEH.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NEH 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare pa Jerubabel ki i kare pa Nekemia jo Icrael ducu gubedo ka miyo jami macalo mot nino ducu pi konyo luwer me ot pa Lubaŋa, ki pi lugwok ot pa Lubaŋa. Lwak gumiyo gityer maleŋ bot Lulevi, ki Lulevi Pene gumiyo dul ma mitte bot ajwagi ma gin likwayo pa Aron.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.47",
            "verseOrgIds": [
              "NEH.12.47"
            ]
          }
        }
