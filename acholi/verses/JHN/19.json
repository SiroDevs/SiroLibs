              "items": [
                {
                  "text": "Yabo 1.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dok dul ginacoya mukene owaco ni,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
