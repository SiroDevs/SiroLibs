                "loc": "NUM.9.12"
              },
              "items": [
                {
                  "text": "Wel 9.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.20"
              },
              "items": [
                {
                  "text": "Jab 34.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pien meno ducu otimme wek ginacoya ocobbe kakare, ni,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.36",
            "verseOrgIds": [
              "JHN.19.36"
            ]
          }
        }
