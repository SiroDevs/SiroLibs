              "items": [
                {
                  "text": "Luka 10.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Won omaro Wod, ci omiyo jami ducu i ciŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.35",
            "verseOrgIds": [
              "JHN.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano ma ye Wod tye ki kwo ma pe tum; ŋat ma pe winyo dog Wod, pe bineno kwo, ento kiniga pa Lubaŋa bedo i kome.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.36",
            "verseOrgIds": [
              "JHN.3.36"
            ]
          }
        }
