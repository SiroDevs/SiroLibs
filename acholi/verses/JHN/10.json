            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " En dok ocito loka Jordan, i kabedo ka ma yam Jon okwoŋo batija dano iye, obedo kunnu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.40",
            "verseOrgIds": [
              "JHN.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo mapol gubino bote; guwaco ni, “Jon yam pe otiyo lanyut mo ento lok ducu ma Jon otito i kom dano man obedo me ada.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.41",
            "verseOrgIds": [
              "JHN.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo mapol guye en ki kunnu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.42",
            "verseOrgIds": [
              "JHN.10.42"
            ]
