              "1PE.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.25"
              },
              "items": [
                {
                  "text": "Ep 5.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.19"
              },
              "items": [
                {
                  "text": "Kol 3.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kit meno bene, wun co wubed ki monwu ki niaŋ maber, kun wumiyo deyo bot dako macalo lawoti ma kome pe tek, pien gin bene ginywako kica pa Lubaŋa kwedwa ma en aye kelo kwo. Kumeno gin mo pe ma bigeŋo legawu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me agikkine, wun ducu wubed ki tam acel dok ki cwiny acel. Wumarre calo omego, ma wutye ki kica dok ki cwiny mamwol. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.8",
            "verseOrgIds": [
              "1PE.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe wudwok tim marac pi tim marac, nyo yet ki yet; ento ma ka timo meno, wuleg gum pa Lubaŋa obed i komgi, pien gilwoŋowu pi man, wek wunoŋ gum. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.9",
            "verseOrgIds": [
              "1PE.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.12+PSA.34.13+PSA.34.14+PSA.34.15+PSA.34.16"
              },
              "items": [
                {
                  "text": "Jab 34.12-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pien yam gicoyo ni,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.12",
            "verseOrgIds": [
              "1PE.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋa mono ma bitimowu marac ka wuketo cwinywu me tiyo gin maber? ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.13",
            "verseOrgIds": [
              "1PE.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.10"
              },
              "items": [
                {
                  "text": "Mat 5.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ento kadi bed wuneno can pi lubo kit ma atir, ci wutye ki gum. Pe wulworgi, dok cwinywu bene pe opoti,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.14",
            "verseOrgIds": [
              "1PE.3.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.12"
              },
              "items": [
                {
                  "text": "Ic 8.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.14",
            "verseOrgIds": [
              "1PE.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento wuwor Kricito i cwinywu macalo Rwotwu. Wubed ma wuyubbe kare ducu pi dok i lok ma dano bipenyowu kwede i kom gen ma wutye kwede; ento wudok iye ki mwolo dok ki woro. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.15",
            "verseOrgIds": [
              "1PE.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wubed ma cwinwyu leŋ, wek lewic omak jo ma yeto kitwu maber i Kricito, ka ginywarowu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.16",
            "verseOrgIds": [
              "1PE.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bedo ber ka wuneno can pi timo gin maber, ka ce Lubaŋa mito kit meno, loyo ma wuneno can pi timo gin marac. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.17",
            "verseOrgIds": [
              "1PE.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien Kricito bene yam oneno can pi bal, kicel ma otyeko lok ducu; en ŋat ma kite atir oto pi jo ma kitgi pe atir, wek omi ekelwa bot Lubaŋa. Yam gineko kome, ento gicere woko i cwiny. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.18",
            "verseOrgIds": [
              "1PE.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "En yam owoto i cwiny ocito otito lok bot tipo pa jo ma tye i mabuc, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.19",
            "verseOrgIds": [
              "1PE.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Acak 6.1–7.24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ma yam con pe guwinyo Lubaŋa, kadi bed Lubaŋa odiyo cwinye i komgi i kare pa Nua ma onoŋo en tye ka payo yeya, ma dano manok ma romo aboro keken aye gularre ki i pii. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.20",
            "verseOrgIds": [
              "1PE.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ma rom ki man ma koni larowu en aye batija; pe me lwoko cilo me kom, ento obedo macalo lega bot Lubaŋa wek wudok jo ma cwinywu leŋ, pi cer pa Yecu Kricito, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.21",
            "verseOrgIds": [
              "1PE.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma doŋ odok woko i polo, tye i kabedo me deyo i ŋet Lubaŋa tuŋ acuc, kun lumalaika ki twer ki teko ducu gitye i te locce.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.22",
            "verseOrgIds": [
              "1PE.3.22"
            ]
          }
        }
      ]
    }
  ],
