          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obedo ka tiyo gin ma nen marac i wan Rwot kun lubo gin ducu ma yam kwarine gutiyo.",
          "type": "text",
