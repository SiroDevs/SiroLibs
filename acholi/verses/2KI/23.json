                "loc": "2CH.33.3"
              },
              "items": [
                {
                  "text": "2 Tek 33.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabaka ociko Ilkia, ajwaka madit, ki ajwagi ma i dul me aryo, ki lukurdoggola ni gukel jami ducu ma tye i ot pa Rwot ma yam gitiyogi pi Baal, ki pi jok ma dako ma gilwoŋo Acera, ki pi mony ma i polo ducu, Gucako wanogi woko i ŋe Jerucalem, i potti ma i ora kulu Kidron, gutero burugi wa i Betel. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orido wi ajwagi me waŋ jogi ma yam luker me Juda guketogi me waŋo odok eceta i waŋ jogi ma i wi godi ma i ŋet gaŋi madito ma i Juda, ki ma gurumo Jerucalem, kacel ki jo ma giwaŋo odok eceta bot jok Baal, ki bot ceŋ ki dwe, ki lakalatwe ki mony ducu ma i polo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.5",
            "verseOrgIds": [
              "2KI.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok okwanyo cal Acera ma jok ma dako-ni woko ki i ot pa Rwot, otero woko wa i ŋe Jerucalem, i kulu Kidron, ci owano woko i ora me Kidron, oluro matitino twatwal, ci oonyo ka ma giyiko iye dano ata. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuko odi pa lutim kwele ma luwor jogi, ma onoŋo gukubbe i kom ot pa Rwot, ka ma yam mon gicweyo iye boŋo pi Acera, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok okwanyo lwak ajwagi woko ki i gaŋi madito ma i Juda, ka obalo lwak waŋ jogi ma i wi godi ka ma yam ajwagi gubedo ka waŋo iye odok eceta; obalo cakke wa i Geba nio kwede wa i Beerceba. Omuko bene waŋ jogi pa jogi ma calo nyogi oyima, ma yam gitye i dog gaŋ ma gidonyo kwede i gaŋ pa Yocwa ma laloyo me gaŋ Jerucalem, yo tuŋ acam ka idonyo i dogcel. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.8",
            "verseOrgIds": [
              "2KI.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajwagi ducu ma i waŋ jogi ma i wi godi yam pe gibino i nyim keno tyer pa Rwot i Jerucalem, ento gubedo ka camo mugati ma tobi pe iye ki i kin utmegigi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.21"
              },
              "items": [
                {
                  "text": "Levi 18.21",
