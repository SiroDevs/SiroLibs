              "attrs": {
                "loc": "JER.35.1+JER.35.2+JER.35.3+JER.35.4+JER.35.5+JER.35.6+JER.35.7+JER.35.8+JER.35.9+JER.35.10+JER.35.11+JER.35.12+JER.35.13+JER.35.14+JER.35.15+JER.35.16+JER.35.17+JER.35.18+JER.35.19"
              },
              "items": [
                {
                  "text": "35.1-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yekoyakim ocamo ker ma mwaka me ditte pyeraryo wiye abic, ci obedo ka loc ki i Jerucalem pi mwaka apar wiye acel. Nyiŋ minne Jebida, nya pa Pedaya me Ruma, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.36",
            "verseOrgIds": [
              "2KI.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
