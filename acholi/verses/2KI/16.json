            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.23+1KI.7.24+1KI.7.25+1KI.7.26+1KI.7.27+1KI.7.28+1KI.7.29+1KI.7.30+1KI.7.31+1KI.7.32+1KI.7.33+1KI.7.34+1KI.7.35+1KI.7.36+1KI.7.37+1KI.7.38+1KI.7.39"
              },
              "items": [
                {
                  "text": "1 Luker 7.23-39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.2+2CH.4.3+2CH.4.4+2CH.4.5+2CH.4.6"
              },
              "items": [
                {
                  "text": "2 Tek 4.2-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabaka Akaj oŋolo mola ma apada ki i kom litino gadigadi, ci okwanyo otako ki i komgi, ka okwanyo nam woko ki i kom twoni mola ma onoŋo gitye i tere-ni, ci oketo i kom godi ma gipetogi piny. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.17",
            "verseOrgIds": [
              "2KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki yo ma giumo wiye ma giwok ki iye i ceŋ cabit, ki doggola pa kabaka ma tye woko, en okwanyogi woko ki i kom ot pa Rwot, pi kabaka me Aciria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lok kom Akaj mudoŋŋe ducu, ki gin ma yam otiyo, gityeko coyone i buk me Tekwaro pa Luker, me Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.19",
            "verseOrgIds": [
              "2KI.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.28"
              },
              "items": [
                {
                  "text": "Ic 14.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akaj oto, oywe kacel ki kwarine, ci giyiko kacel ki kwarine, i gaŋ kai pa Daudi; wode Kejekia aye oleyo ka tyene.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.20",
            "verseOrgIds": [
              "2KI.16.20"
            ]
          }
        }
      ]
