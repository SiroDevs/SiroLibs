            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "2 Tek 36.17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Lok bot Rwot piwa, pien Nebukadnejar kabaka me Babilon tye ka ero lweny i komwa. Gwok nyo Rwot bitiyo jami taŋone mogo piwa, ci bimiyo. Nebukadnejar jer dok cen ki ŋeye.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
