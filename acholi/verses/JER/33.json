          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimiyo lobo man bedo lobo mulony kit macalo yam onoŋo tye kwede wa con, man Rwot ma owaco.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
