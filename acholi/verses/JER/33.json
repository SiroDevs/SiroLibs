              },
              "items": [
                {
                  "text": "Wel 3.5-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "dok bene kare ducu ajwagi bibedo tye ma gia ki i kaka pa Levi ma gin aye gibicuŋ i nyima nakanaka ka tyero gitum awaŋa, gityer me moko kwoŋ, ki gitum mukene-gu ducu.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.18",
            "verseOrgIds": [
              "JER.33.18"
            ]
          }
        }
