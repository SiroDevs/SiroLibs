                "loc": "1CH.17.11+1CH.17.12+1CH.17.13+1CH.17.14"
              },
              "items": [
                {
                  "text": "1 Tek 17.11-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“An Rwot, doŋ atyeko cikke ni kare ducu dano mo bibedo tye ma en Lakwar Daudi ma myero obed kabaka me Icrael, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
