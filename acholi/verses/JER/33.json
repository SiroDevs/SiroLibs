                }
              ]
            }
          ]
        },
        {
          "text": "dwan me yomcwiny ki yomcwiny madwoŋ, dwan anyira ger ki dwan lunyom. Wubiwinyo dano giwero wer ka gikelo gityer me pwoc i oda; gibiwacci,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
