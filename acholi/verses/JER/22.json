              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.1+2CH.36.2+2CH.36.3+2CH.36.4"
              },
              "items": [
                {
                  "text": "2 Tek 36.1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pien Rwot owaco lok kuman mukemo Calum wod pa Yocia kabaka me Juda, ma obedo ka loc ma ka wonne Yocia, ma onoijo oa woko ki i kabedo man ocito gire woko ni, “En doŋ pe bidwogo cen kany matwal, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento en bito mere i kabedo ka ma gitere iye i opii, pe dok bineno lobo man tyen me aryo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        }
      ]
    },
