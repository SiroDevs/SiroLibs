          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.27",
            "verseOrgIds": [
              "JER.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia owacci, “En Yekonia mono doŋ olokke odoko macalo agulu muto ma doŋ gikwanyo gibolo woko, ma ŋat mo doŋ pe mito? Piŋo kono gikwanyo en kacel ki litinone gibologi i lobo ma gin pe giŋeyo lok i kome?",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        }
      ]
    }
