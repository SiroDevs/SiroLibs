          },
          "items": [
            {
              "text": "\n        2 Luker 23.36–24.6",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7"
              },
              "items": [
                {
                  "text": "2 Tek 36.5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pi meno Rwot owaco lok not Yekoyakim wod pa Yocia kabaka me Juda ni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
        }
