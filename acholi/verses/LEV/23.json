          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Magi aye nino madito ma Rwot ociko, gin gurre maleŋ ma wubituco pigi i kare ma Rwot ociko pigi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.4",
            "verseOrgIds": [
              "LEV.23.4"
            ]
          }
        },
        {
