                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Nwo 5.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wubitiyo tic nino abicel, ento i nino me abirone en ceŋ cabit me yweyo mot, en aye gurre maleŋ, Pe wuti iye tic mo; en aye ceŋ cabit pa Rwot ka ma wubibedo iye ducu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        }
      ]
    },
    {
