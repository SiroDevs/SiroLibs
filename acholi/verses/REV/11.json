          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Can me aryo doŋ okato; nen, can me adek doŋ cok bino.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.14",
