          "type": "text",
          "attrs": {
            "verseId": "REV.20.10",
            "verseOrgIds": [
              "REV.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
