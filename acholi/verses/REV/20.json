          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok aneno lamalaika mo oa ki i polo kun lor bino piny; onoŋo omako layab me bur ma tere pe gik, ki nyor mapek adada. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.1",
            "verseOrgIds": [
              "REV.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1"
              },
              "items": [
                {
                  "text": "Acak 3.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ci omako min kulu madit ca, ma obedo twol macon-ni, ma en aye Ladot dok Catan bene, ka otweye woko pi mwaka alip acel, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.2",
            "verseOrgIds": [
              "REV.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci obole woko i bur ma tere pe gik, oloro dog bur woko, omwono woko bene kun oketo lanen i wiye wek pe dok omedde ki bwolo rok ducu, nio waŋ ma mwaka alip acel doŋ okato. I ŋe meno myero gigonye woko pi kare mo manoknok.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.3",
            "verseOrgIds": [
              "REV.20.3"
            ]
          }
        }
      ]
    },
    {
