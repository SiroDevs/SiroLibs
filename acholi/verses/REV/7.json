                "loc": "DAN.7.2"
              },
              "items": [
                {
                  "text": "Dan 7.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.5"
              },
              "items": [
                {
                  "text": "Jek 6.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lacen aneno lumalaika aŋwen gucuŋ i but lobo aŋwen ducu, ma gigeŋo yamo me lobo woko, wek yamo mo pe okod i lobo, nyo i nam, kadi ki i kom yat mo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.1",
            "verseOrgIds": [
              "REV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok aneno lamalaika mukene ma ito cito malo ki ka ma ceŋ tuc ki iye, onoŋo tye ki lanyut pa Lubaŋa makwo. Ci okok ki dwan maloŋo bot lumalaika aŋwen ma onoŋo gimiyogi twero me balo lobo ki nam, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.2",
            "verseOrgIds": [
              "REV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Ejek 9.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kun wacci, “Pe wubal lobo nyo nam kadi ki yadi, nio waŋ ma doŋ waketo lanyut i tur nyim lutic pa Lubaŋawa.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.3",
            "verseOrgIds": [
              "REV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok awinyo bene wel dano ma giketo lanyut i komgi, gubedo dano alip miya acel ki pyeraŋwen wiye aŋwen, ma gua ki i kaka pa jo Icrael ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.4",
            "verseOrgIds": [
              "REV.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kaka pa Juda giketo lanyut i kom dano alip apar wiye aryo. I kaka pa Reuben giketo lanyut i kom dano alip apar wiye aryo. I kaka pa Gad giketo lanyut i kom dano alip apar wiye aryo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kaka pa Acer giketo lanyut i kom dano alip apar wiye aryo. I kaka pa Naputali giketo lanyut i kom dano alip apar wiye aryo. I kaka pa Manace giketo lanyut i kom dano alip apar wiye aryo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.6",
            "verseOrgIds": [
              "REV.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kaka pa Cimeon giketo lanyut i kom dano alip apar wiye aryo. I kaka pa Levi giketo lanyut i kom dano alip apar wiye aryo. I kaka pa Icakar giketo lanyut i kom dano alip apar wiye aryo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.7",
            "verseOrgIds": [
              "REV.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kaka pa Jabulon giketo lanyut i kom dano alip apar wiye aryo. I kaka pa Yucepu giketo lanyut i kom dano alip apar wiye aryo. I kaka pa Benjamin giketo lanyut i kom dano alip apar wiye aryo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lacen aneno lwak dano mapol ata, ma ŋat mo pe romo kwano welgi, ma gua ki i rok ducu, ki i kaka ducu, ki dano ducu me wi lobo, ki leb ducu, ci gucuŋ i nyim komker ki i nyim Latin romo, ma gurukke ki jor matar, kun gumako jaŋ otit i ciŋgi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.9",
            "verseOrgIds": [
              "REV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci gidaŋŋe ki dwan maloŋo ni, “Laro dano tye bot Lubaŋawa ma obedo i wi komker, ki bot Latin romo!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lumalaika ducu onoŋo gucuŋo gurumo komker woko dyere, gurumo bene ludoŋo ki lee makwo aŋwen-ni, ka guryebbe piny i nyim komker ci guworo Lubaŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.11",
            "verseOrgIds": [
              "REV.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kun giwacci, “Amen! Pak ki deyo ki ryeko ki pwoc, ki woro ki twero ki teko obed bot Lubaŋawa nakanaka. Amen.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci ŋat acel ki i kin ludoŋo oloko kweda, kun penya ni, “Jo magi ma guruko jor matar-ri aŋagi, gua kono ki kwene?” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.13",
            "verseOrgIds": [
              "REV.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.1"
              },
              "items": [
                {
                  "text": "Dan 12.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.21"
              },
              "items": [
                {
                  "text": "Mat 24.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.19"
              },
              "items": [
                {
                  "text": "Mar 13.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Adokke iye ni, “Ladit, in iŋeyo.” En dok owaco bota ni, “Magi aye gin jo ma gua ki i can madit atika, gin bene doŋ gutyeko lwoko jorgi i remo pa Latin romo odoko matar adada.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
            ]
          }
        }
      ]
    }
