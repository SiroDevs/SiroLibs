              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Paulo ki Barnaba gudoŋ i Antiokia, kun gipwonyo dano ki tito lok pa Rwot, kacel ki jo mukene mapol bene.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.35",
            "verseOrgIds": [
              "ACT.15.35"
            ]
