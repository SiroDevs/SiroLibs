              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci gubedo ka laro lok magwa, nio ka kingi opokke woko. Barnaba owoto ki Marako ci gukwaŋo nam gucito i Caiprac, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.39",
            "verseOrgIds": [
              "ACT.15.39"
            ]
