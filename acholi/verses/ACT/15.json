              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento Paulo oyero Cira ci gua ka doŋ utmego gumiyogi i ciŋ Rwot wek okonygi ki kicane. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.40",
