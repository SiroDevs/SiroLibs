          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka otyeko loko lok meno, ci orumo coŋe piny olego kwedgi ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.36",
            "verseOrgIds": [
              "ACT.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ducu gukok kun gikwako ŋut Paulo ki mot me mar. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.37",
            "verseOrgIds": [
              "ACT.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin mucwero cwinygi twatwal makato ducu obedo lok ma en owaco botgi ni pe dok gibineno waŋe. Ci gulwoke wa i mel.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.38",
            "verseOrgIds": [
              "ACT.20.38"
            ]
