          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obed kit meno bene ka ce larok mo, ma pe joni jo Icrael, obino kany ma oa ki i lobo mo mabor, ma obino pi nyiŋi madit-ti, ki badi matek-ki, ki ciŋi ma iryeyo, ka ce larok obino ce ocako lega ma okemo ot man, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci in Lubaŋa iwiny ki i polo ka ma ibedo iye-ni, itim kit gin ducu ma larok-ki okok kwede i nyimi, wek rok ma wi lobo ducu guŋe nyiŋi, gucak lwori, kit ma I wakki jo Icrael gilwori-ni, dok wek guŋe maber ni, ot man ma agero-ni, gilwoŋo ki nyiŋi keken.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        }
      ]
    },
