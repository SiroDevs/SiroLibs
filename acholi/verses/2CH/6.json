          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ce mony pa lumerok guloyo jonijo Icrael pi balgi ma gutimo i komi, ka ce guŋut gudwogo boti, ci gucako tuco nyiŋi, ma gilego in ka gibako doggi boti ki i ot man, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci iwinygi ki polo, iwek bal pa joni jo Icrael, ka dok idwokgi cen wa i lo bo ma yam i miyo bot kwarogi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        }
      ]
    },
