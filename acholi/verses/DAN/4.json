              "DAN.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "I agikki me kare meno ducu, an Nebukadnejar, ailo waŋa aneno polo, ci tipo koma ocako dwogo, omiyo apwoyo En ŋat Mamalo Twal mada, ka dok apake kun aketo deyo i kome en ma bedo kwo nakanaka-ni.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
            "verseOrgIds": [
              "DAN.4.34"
            ]
          }
        }
