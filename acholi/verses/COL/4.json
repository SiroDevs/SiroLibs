                  "text": "15.37-39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Aristako ma lamabuc lawota omotowu, ki Marako okeyo Barnaba ma yam doŋ acikowu pire; ka en oo botwu myero wujole maber, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.10",
            "verseOrgIds": [
              "COL.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki Yecu ma nyiŋe mukene Yucito bene omotowu. Jo magi adek-ki keken aye gin Lujudaya ma gitiyo tic kacel kwedwa kany i ker pa Lubaŋa. Gukweyo cwinya twatwal. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.7"
              },
              "items": [
                {
                  "text": "Kol 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.23"
              },
              "items": [
                {
                  "text": "Pile 23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Epapira latic pa Yecu Kricito ma en ŋat acel mua ki botwu, bene omotowu. En po piwu kare ducu i legane matek, wek wubed jo muteggi, kun wuniaŋ maber i gin ducu ma Lubaŋa mito ma pe wukalo akala wacel. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "An cadenne omiyo amoko ni en otiyo tic matek piwu ki pi jo ma tye i Laodikia ki Kerapoli. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.13",
            "verseOrgIds": [
              "COL.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.11"
              },
              "items": [
                {
                  "text": "2 Tem 4.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.24"
              },
              "items": [
                {
                  "text": "Pile 24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.10"
              },
              "items": [
                {
                  "text": "2 Tem 4.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.24"
              },
              "items": [
                {
                  "text": "Pile 24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Luka ma en daktar ma wamaro, kacel ki Dema bene gumotowu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.14",
            "verseOrgIds": [
              "COL.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wumot utmego ma tye i Laodikia, dok wumot Nimpa bene kacel ki jo muye Kricito ma gicokke i ode. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.15",
            "verseOrgIds": [
              "COL.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋ waraga man gityeko kwanone i kinwu, myero wumi gikwan bene bot jo muye Kricito ma gitye i Laodikia, ki wun bene myero wukwan waraga ma jo Laodikia gicwalo botwu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.16",
            "verseOrgIds": [
              "COL.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.2"
              },
              "items": [
                {
                  "text": "Pile 2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dok wuwac bot Arkipo ni, “Myero inen ni icobo tic ma doŋ igamo i Rwot.”",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.17",
            "verseOrgIds": [
              "COL.4.17"
            ]
          }
        }
