              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wun wegi opii, wuti ki opiiwu i yo ma atir ma romrom. kun wuŋeyo ni, wun bene laditwu tye malo i polo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.1",
            "verseOrgIds": [
              "COL.4.1"
            ]
          }
        }
      ]
    },
    {
