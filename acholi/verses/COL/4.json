              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "An Paulo acoyo botwu lok me mot man ki ciŋa.Wupo i kom twec man ma gitweya kwede ki nyor. Kica pa Lubaŋa obed kwedwu. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.18",
            "verseOrgIds": [
              "COL.4.18"
            ]
          }
