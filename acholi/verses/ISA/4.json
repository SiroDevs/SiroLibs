              "type": "text"
            }
          ]
        },
        {
          "text": "I nino meno mon abiro gibipoto i kom laco acel kun gimake woko Iikin ma giwacce ni, “Wan giwa wabicamo camwa dok bene wabiyenyo ginarukawa kikomwa, ento in myero itrm ber ilwonwa ki nyiŋi; kwany lewic woko ki i wiwa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
