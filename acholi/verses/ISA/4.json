        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
