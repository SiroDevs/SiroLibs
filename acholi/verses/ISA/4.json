            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.16"
              },
              "items": [
                {
                  "text": "24.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwot doŋ biketo pol dyeceŋ, ki yito ki mac ma caro piny Lyel dyewor, i kabedo ducu ma tye i wi got me Cion, ki i wi dano ducu ma gucokke iye; pien gin mo ma gitiyo macalo kema biumo wi deyone ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin meno bibedo me geŋo lyeto dyeceŋ, ki me geŋo yamo ki kot.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
          }
        }
