                "loc": "EXO.6.26"
              },
              "items": [
                {
                  "text": "Nia 6.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Camuel dok owaco bot lwak ni, “Rwot aye caden ma yam oyero Moses ki Aron ci okwanyo kwarowa woko ki i Ejipt. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.6",
            "verseOrgIds": [
              "1SA.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumiyo kombeddi doŋ wucuŋ mot, wek apid kop i komwu i nyim Rwot i kom tim ducu ma Rwot olarowu kwede, ma yam otimo piwu ki pi kwarowu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.7",
            "verseOrgIds": [
              "1SA.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.23"
              },
              "items": [
                {
                  "text": "Nia 2.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka yam Yakobo ki jone gucito i Ejipt, ci jo Ejipt gubwoyogi ki tek, mumi yo kwarowu gukok bot Rwot. Ka doŋ Rwot ocwalo Moses ki Aron ma gukwanyo kwarowu ki i Ejipt ci gumiyogi gubedo i kabedo man. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.8",
            "verseOrgIds": [
              "1SA.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.12"
              },
              "items": [
                {
                  "text": "Luŋol 3.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.4.2"
              },
              "items": [
                {
                  "text": "4.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.13.1"
              },
              "items": [
                {
                  "text": "13.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento wigi ocako wil i kom Rwot Lubaŋagi woko; ci omiyogi i ciŋ Cicera ma lawimony pa Jabin, kabaka me Kajor, ki i ciŋ jo Piliciti, ki i ciŋ kabaka me Moab, ci gucako lweny i komgi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.9",
            "verseOrgIds": [
              "1SA.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.10.10+JDG.10.11+JDG.10.12+JDG.10.13+JDG.10.14+JDG.10.15"
              },
              "items": [
                {
                  "text": "Luŋol 10.10-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ci gukok bot Rwot kun giwacci, ‘Wan doŋ wabalo, pien wabwoto Rwot woko, waworo jogi Baal ki jogi ma mon-gu, Ento doŋ ilarwa ki i cin lukworwa, ci wabiworo in keken.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.10",
            "verseOrgIds": [
              "1SA.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.3.20"
              },
              "items": [
                {
                  "text": "1 Cam 3.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.4.6"
              },
              "items": [
                {
                  "text": "Luŋol 4.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.1"
              },
              "items": [
                {
                  "text": "7.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.11.29"
              },
              "items": [
                {
                  "text": "11.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka dok Rwot ocwalo Jerubaal ki Barak, ki Jeputa ki Camuel, olarowu ki i ciŋ lumerokwu tuŋŋi ki tuŋŋi, ci wubedo mot ki kuc. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.11",
            "verseOrgIds": [
              "1SA.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.8.19"
              },
              "items": [
                {
                  "text": "1 Cam 8.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lacen ka wuneno ni Nakac kabaka pa jo Ammon obino ka lweny i komwu, ci wuwaco bota ni, ‘Pe kumeno; ento kabaka aye biloyowa,’ ma onoŋo Rwot Lubaŋawu aye kabakawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.12",
            "verseOrgIds": [
              "1SA.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kombeddi doŋ wunen kabakawu ma wuyero-ni, ma yam wupenya pireni. Nen, Rwot doŋ oketo kabaka ma loyowu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.13",
            "verseOrgIds": [
              "1SA.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce wubilworo Rwot ci wutiyo bote kun wuwinyo doge, ma kun pe wujemo nyo wukwero cik pa Rwot woko, dok ka wun ki kabakawu ma loyowu-ni ce wubilubo kor Rwot Lubaŋawu, ci bibedo ber. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.14",
            "verseOrgIds": [
              "1SA.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ka’ ce pe wubiwinyo dog Rwot, nyo wujemo ma wukwero cik pa Rwot woko, ci ciŋ Rwot bipoto i komwu ki i kom kabakawu, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.15",
            "verseOrgIds": [
              "1SA.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kombeddi wun doŋ wucuŋ mot wek wunen kit gin madit ma Rwot bitiyo i nyimwu, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.16",
            "verseOrgIds": [
              "1SA.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kare-ni kare me kayo ŋano; pe kumeno? Doŋ an abilego Rwot wek ocwal kot ma mor kun cwer kwede, ci wubineyo dok wubineno kit ma balwu dit kwede ma wutimo i nyim Rwot pi penyo pi kabaka piwu kenwu.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.17",
            "verseOrgIds": [
              "1SA.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit meno Camuel olego Rwot, ci Rwot ocwalo kot ma mor kun cwer kwede i nino meno; mumiyo lwak ducu gubedo ki lworo madwoŋ mada i kom Rwot ki i kom Camuel.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.18",
            "verseOrgIds": [
              "1SA.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.18",
            "verseOrgIds": [
              "1SA.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci lwak ducu guwaco bot Camuel ni, “Ladit, leg piwa bot Rwot Lubaŋani wek pe wato, pien wapoŋo wi bal wa ki tim marac man me penyo pi kabaka piwa kenwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.19",
            "verseOrgIds": [
              "1SA.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Camuel owaco bot lwak ni, “Pe wulwor, Wutyeko timo gin maraco magi ducu, ento pe dok wulokke wubarre woko ki ka lubo kor Rwot, ento doŋ wuti bot Rwot ki cwinywu ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.20",
            "verseOrgIds": [
              "1SA.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe wulokke wubarre woko wudok ka lubo kor gin atata ma pe konyo, ma pe laro dano mo, pien gin atata. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.21",
            "verseOrgIds": [
              "1SA.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien Rwot pe bibolo lwakke woko ata, pi nyiŋe madit-ti keken, pien yomcwiny oa ki i i Rwot ma oketowu me bedo jone kikome, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.22",
            "verseOrgIds": [
              "1SA.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok bene ki tuŋ bota pe myero atim bal bot Rwot me weko lego piwu; dok abipwonyowu kit me lubo yo atir ki maber. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.23",
            "verseOrgIds": [
              "1SA.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wulwor Rwot keken, dok wuti bote ki gen madwoŋ ki cwinywu ducu; pienno wubedo ka tamo kit gin madito ma yam Rwot obedo ka tiyone piwu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.24",
            "verseOrgIds": [
              "1SA.12.24"
            ]
          }
        },
