          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubaŋa Won Rwotwa Yecu Kricito, ma gipwoyo nakanaka, en ŋeyo ni pe aloko goba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.31",
