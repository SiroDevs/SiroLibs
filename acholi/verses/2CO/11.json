              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce onoŋo myero anyatte, abinyatte pi gin ma nyuto gorona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.30",
            "verseOrgIds": [
              "2CO.11.30"
            ]
