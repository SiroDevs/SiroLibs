          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lonyo pa Lubaŋa dwoŋ ma okato kare! Ryekone kacel ki ŋecce tut twatwal! Lok ma en ŋolo tere pe tatte, niaŋ i kite tek!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.33",
            "verseOrgIds": [
              "ROM.11.33"
            ]
          }
        }
      ]
    },
