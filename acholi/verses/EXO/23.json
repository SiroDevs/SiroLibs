        },
        {
          "text": "“Ibicoyo potoni ci icoko cam ma ocek iye pi mwaka abicel. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento i mwaka me abirone ibiweko ywe, okanne roc, wek arupinnye lucan ma i kinwu gunoŋ ginacama; ci ma obwotte lee tim bicamone. Ibitimo kit meno ki poto olokki ki poto jeitunini bene,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
