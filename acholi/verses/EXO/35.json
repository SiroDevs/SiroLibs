        },
        {
          "text": "Moses ocoko lwak jo Icrael ducu, owaco botgi ni, “Man aye gin ma Rwot ociko ni wutim. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.1",
            "verseOrgIds": [
              "EXO.35.1"
            ]
          }
        },
        {
