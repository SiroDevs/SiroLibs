              "items": [
                {
                  "text": "34.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.35.2"
              },
              "items": [
                {
                  "text": "35.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.3"
              },
              "items": [
                {
                  "text": "Levi 23.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Nwo 5.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wubitiyo tic nino abicel, ento nino me abiro en aye cabit me yweyo mot, nino maleŋ bot Rwot; ŋat ma otiyo tic mo i cabit gibineko woko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi meno myero jo Icrael gugwok cabit wa i kare pa likwayogi ducu, macalo gicikke ma bedo matwal. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.11"
              },
              "items": [
                {
                  "text": "Nia 20.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "En aye lanyut matwal i kin an ki jo Icrael, ni, Rwot yam otiyo polo ki lobo nino abicel, oywe mot i nino me abiro, oomo iye kero kome.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
