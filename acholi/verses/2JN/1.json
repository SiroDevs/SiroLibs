            "number": "12",
            "style": "v",
            "sid": "2JN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.12",
            "verseOrgIds": [
              "2JN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2JN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Litino pa lameru ma giyero gumoti.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.13",
            "verseOrgIds": [
              "2JN.1.13"
            ]
          }
        }
      ]
    }
