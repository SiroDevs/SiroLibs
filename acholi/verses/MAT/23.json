          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ada awaco botwu ni, lok man ducu bipoto i kom jo ma gin yalwak me kare man.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.36",
            "verseOrgIds": [
