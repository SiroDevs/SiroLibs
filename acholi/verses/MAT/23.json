                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wek remo pa jo ducu ma kitgi atir ma ginekogi i lobo obed i wiwu, cakke ki i kom remo pa Abel ma balle pe-ni nio kwede i kom remo pa Jekaria wod pa Barakia, ma yam wuneko i kin kabedo maleŋ ki keno tyer pa Lubaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.35",
            "verseOrgIds": [
              "MAT.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
