            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Wubineno can, wun Lupwony-cik ki Luparicayo, wun lugoba! Pien wurom ki lyel ma gipuyo ki gin matar, kun ki yo tuŋ woko nen maber, ento igi noŋo opoŋ ki cogo pa jo muto, ki jami ducu ma keni keken. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.27",
            "verseOrgIds": [
              "MAT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wun bene kit meno, ki woko wunen bot dano ni wun jo ma kitwu atir, ento iwu noŋo opoŋ ki gin maraco keken.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.28",
            "verseOrgIds": [
              "MAT.23.28"
            ]
          }
        }
      ]
