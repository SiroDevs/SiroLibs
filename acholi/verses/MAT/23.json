              "items": [
                {
                  "text": "Jer 22.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nen, doŋ gitenyo otwu botwu, iye odoŋ nono. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
