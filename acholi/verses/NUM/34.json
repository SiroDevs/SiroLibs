              "NUM.34.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.14.1+JOS.14.2+JOS.14.3+JOS.14.4+JOS.14.5"
              },
              "items": [
                {
                  "text": "Yoc 14.1-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moses dok ociko jo Icrael kun waco ni, “Man aye lobo ma wubileyo kun gipoko ki bolo kwir, ma yam Rwot ociko ni gimi bot kakawu aboŋwen ki nucu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "pien kaka pa Reuben ki kaka pa Gad gutyeko gamo ginaleyagi kun lubo dog odi pa kwarogi, kacel ki nucu kaka pa Manace bene, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.14",
            "verseOrgIds": [
              "NUM.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gutyeko gamo lobogi loka Jordan mukemo Jeriko, yo tuŋ wokceŋ, ka ma ceŋ tuc ki iye-ni.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot owaco bot Moses ni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.16",
            "verseOrgIds": [
              "NUM.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Man aye nyiŋ dano ma gibipoko botwu lobo me ginaleyawu: ajwaka Eleajar ki Yocwa wod pa Nun. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.17",
            "verseOrgIds": [
              "NUM.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok wubikwanyo latel wic acel ki i kaka acel acel wek gupok lobo me aleyawu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.18",
            "verseOrgIds": [
              "NUM.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi aye nyiŋ lutel; pi kaka pa Juda, Kaleb wod pa Jepune. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.19",
            "verseOrgIds": [
              "NUM.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi kaka pa Cimeon, Cemuel wod pa Amikud. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.20",
            "verseOrgIds": [
              "NUM.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi kaka pa Benjamin, Elidad wod pa Kicion, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.21",
            "verseOrgIds": [
              "NUM.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi kaka pa Dan, Buki wod pa Jogli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.22",
            "verseOrgIds": [
              "NUM.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi likwayo pa Yucepu, pi kaka pa Manace, Kaniel wod pa Epod; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.23",
            "verseOrgIds": [
              "NUM.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki i kaka pa Epraim, Kemuel wod pa Ciptan, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.24",
            "verseOrgIds": [
              "NUM.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi kaka pa Jabulon, Elijapan wod pa Pamak. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.25",
            "verseOrgIds": [
              "NUM.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi kaka pa Icakar, Paltiel wod pa Ajan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.26",
            "verseOrgIds": [
              "NUM.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi kaka pa Acer, Akiud wod pa Celomi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.27",
            "verseOrgIds": [
              "NUM.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi kaka pa Naputali, Pedael wod pa Amikud. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.28",
            "verseOrgIds": [
              "NUM.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi aye dano ma Rwot ociko ni gupok lobo me aleya pa jo Icrael ki i lobo Kanaan.’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.29",
            "verseOrgIds": [
              "NUM.34.29"
            ]
          }
        }
      ]
    }
  ],
