          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obot, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.43",
            "verseOrgIds": [
              "NUM.33.43"
            ]
          }
