          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gua ki i Dopka, gugony i Aluc, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.13",
            "verseOrgIds": [
              "NUM.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gua ki i Aluc, gugony i Repidim ka ma pii amata pa dano obedo pe,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.14",
            "verseOrgIds": [
              "NUM.33.14"
            ]
          }
        }
      ]
