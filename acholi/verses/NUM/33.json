          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gua ki i Repidim gucito wa i te got Kor. Ka pud gitye i yo me cito kunnu gugony i kabedo magi: tim Cinai, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.15",
