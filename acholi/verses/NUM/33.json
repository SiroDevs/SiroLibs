          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Almon-Diblataim. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.46",
            "verseOrgIds": [
              "NUM.33.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 33:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gua ki i Almon-diblataim gugony i dye godi Abarim, i nyim got Nebo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.47",
            "verseOrgIds": [
              "NUM.33.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 33:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gua ki kunnu, gugony i lobo aroo me Moab i ŋet Jordan ma cok ki Jeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.48",
            "verseOrgIds": [
              "NUM.33.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 33:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guguro kemagi i ŋet Jordan cakke i Bet-jecimot o kwede wa Abelcitim i bar aroo me Moab,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.49",
            "verseOrgIds": [
              "NUM.33.49"
            ]
          }
        }
      ]
    },
