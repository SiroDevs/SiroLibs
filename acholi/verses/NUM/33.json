              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka gua ki i te got Kor gugony i kabedo magi: Jalmona, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.41",
            "verseOrgIds": [
              "NUM.33.41"
