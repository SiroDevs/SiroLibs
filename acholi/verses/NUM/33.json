          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Punon, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.42",
            "verseOrgIds": [
              "NUM.33.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
