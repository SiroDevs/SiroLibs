          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gua ki i tim Cin, gugony i Dopka, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.12",
            "verseOrgIds": [
              "NUM.33.12"
            ]
          }
        },
        {
          "name": "verse",
