                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot owaco bot Moses ni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.5",
            "verseOrgIds": [
              "NUM.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wac ki jo Icrael ni, Ka ce laco mo nyo dako mo otimo bal mo ma dano timo kun ginayo waŋ Rwot, ce otiŋo alii, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.6",
            "verseOrgIds": [
              "NUM.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "en bituco bal mere ma otimo-ni; ka dok en biculo waŋ gin marac ma otimo; bimedo iye acel me abic, ci miyo bot dano ma en otimo marac-ci. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.7",
            "verseOrgIds": [
              "NUM.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ka dano meno watte mo pe ma myero giculle waŋ gin marac-ci, ci giculo Waŋ gin marac meno bot Rwot pi ajwaka, kun gibamo i kom nyok romo me kwanyo bal ma gitimo kwede gin lakwany bal ki i kome. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.8",
            "verseOrgIds": [
              "NUM.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gityer ducu, nyo jami ducu maleŋ pa jo Icrael ma gikelo bot ajwaka bibedo mere. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.9",
            "verseOrgIds": [
              "NUM.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jami maleŋ ma dano acel acel okelo bibedo mere; gin ducu ma dano mo omiyo bot ajwaka bibedo mere.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.10",
            "verseOrgIds": [
              "NUM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.10",
            "verseOrgIds": [
              "NUM.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot owaco bot Moses ni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.11",
            "verseOrgIds": [
              "NUM.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wac ki jo Icrael ni, Ka dako pa laco mo waŋe olal, ci otimo kir i kom cware, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.12",
            "verseOrgIds": [
              "NUM.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka laco-mo obuto kwede, ce cware pe oneyo, ma dako ojerre kekene kun lokke okanne woko, dok pe tye caden mo ma moko lok kom dako-nu, pien pe ginoŋe iye; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.13",
            "verseOrgIds": [
              "NUM.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka cwiny me nyeko omako laco, kun nyeko omake i kom dakone ma ojerre kekene-ni, nyo ka cwiny me nyeko omako laco, kun nyeko omake i kom dakone, kadi bed dako pe ojerre kekene, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.14",
            "verseOrgIds": [
              "NUM.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci laco bitero dakone bot ajwaka, kun tero gityer ma gimito pi dakone, agwata moko kwon acel me moko cayiri; pe bionyo moo i kome, pe biketo iye odok luban, pien meno gityer me moko kwon me nyeko, en gityer me moko kwon me lapo wic, ma bimiyo gipo pi bal meno.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.15",
            "verseOrgIds": [
              "NUM.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.15",
            "verseOrgIds": [
              "NUM.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ajwaka bikelo dako cok, ci cibo i nyim Rwot. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.16",
            "verseOrgIds": [
              "NUM.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok ajwaka bitero pii maleŋ ki otako, ci jobo apwa ma i dye ot me kema, onyo i pii. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.17",
            "verseOrgIds": [
              "NUM.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ajwaka bicibo dako i nyim Rwot, bigonyo yer wi dako wek oket ata lijayi, ci keto gityer me moko kwon me lapo wic i cinŋ, ma en aye gityer me moko kwon me nyeko. Ajwaka bimako pii makec me ceno dano i ciŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.18",
            "verseOrgIds": [
              "NUM.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ajwaka bimiyo dako-nu kwoŋo kwoŋ, kun waco ni, ‘Ka laco mo pe obuto kwedi, ka pe iŋak woko, kun ijerre kekeni ma it ye i te twero pa cwari, ci gin marac mo pe otimi pi pii man makec me ceno dano-ni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.19",
            "verseOrgIds": [
              "NUM.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ka ce waŋi olal woko, ma pud it ye i te twero pa cwari, ka ijerre kekeni, ci laco mo ma pe cwari obuto kwedi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.20",
            "verseOrgIds": [
              "NUM.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci (ajwaka bimiyo dako-nu kwoŋo kwoŋ ma kelo ceno dano kun waco ki dako-nu ni,) Rwot omi in idok ŋat ma giceno ki dano, kun dano gikwoŋo akwoŋa ki nyiŋi i kin lutuwu, i kare ma Rwot bitweyo nyodoŋi woko ci miyo ii bene deŋ woko; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.21",
            "verseOrgIds": [
              "NUM.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "wek pii man me ceno dano ocit i cin ii, omi ii odeŋ, ci otwe nyodoŋi woko.’ Dako bigamo ni, ‘Amen, Amen.’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.22",
            "verseOrgIds": [
              "NUM.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.22",
            "verseOrgIds": [
              "NUM.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lacen ajwaka bicoyo lok me ceno dano-ni i karatac, ka dok lwoko vinone woko ki pii makee-ci, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.23",
            "verseOrgIds": [
              "NUM.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci bimiyo dakonu mato pii makec ma giceno ki dano-ni, ci pii me ceno dano bidonyo i iye, miyo iye mwode matek. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.24",
            "verseOrgIds": [
              "NUM.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok ajwaka bikwanyo gityer me moko kwon me nyeko woko ki i cin dako-nu, ci kwato gityer me moko kwon i nyim Rwot, tero i keno tyer. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.25",
            "verseOrgIds": [
              "NUM.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ajwaka bijobo moko me gityer poŋ ciŋ acel obed gin me po i kome, biwaŋo i wi keno tyer; ka dok lacen en bimiyo dako-nu mato pii. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.26",
            "verseOrgIds": [
              "NUM.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋ omiyo omato pii, ka ce onoŋo en otyeko jerre kekene kun otimo kir i kom cware, ci pii me ceno dano bidonyo i iye, miyo iye mwode matek; iye biden woko, nyodoŋe bitwene woko, dako-ni bidoko ŋat ma giceno dano ki nyiŋe i kin lutugi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.27",
            "verseOrgIds": [
              "NUM.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ka dako-nu pe ojerre kekene, ma bal mo pe i kome, gin marac mo pe bitimo, ci en binywalo litino.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.28",
            "verseOrgIds": [
              "NUM.5.28"
            ]
          }
        }
      ]
    },
