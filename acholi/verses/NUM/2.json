          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wel jo ducu ma i gony pa Epraim, i bucagi, oromo alip miya acel ki aboro, ki miya acel. Gin gibimol me adekke.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.24",
            "verseOrgIds": [
              "NUM.2.24"
