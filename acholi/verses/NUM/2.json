          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma gikwano wel dano ma i buca monnye oromo alip pyeraŋwen wiye acel, ki miya abic. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.28",
            "verseOrgIds": [
              "NUM.2.28"
            ]
          }
        },
