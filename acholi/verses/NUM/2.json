          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ki yo tuŋ potoceŋ bendera pa jo Epraim bicuŋ iye, kun gilubo buca monygi; latel wi jo pa Epraim aye Elicama ma wod pa Amikud, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.18",
            "verseOrgIds": [
              "NUM.2.18"
            ]
          }
        },
        {
