          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma gikwano wel dano ma i buca monnye oromo alip pyeradek wiye abic, ki miya aŋwen. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.23",
            "verseOrgIds": [
              "NUM.2.23"
            ]
          }
        },
