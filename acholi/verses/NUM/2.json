          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo ma biguro kemagi ma cok kwede gibibedo kaka pa Acer; latel wi jo pa Acer en aye Pagiel ma wod pa Okoran, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.27",
            "verseOrgIds": [
              "NUM.2.27"
            ]
          }
        },
