          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma gikwano wel dano ma i buca monnye oromo alip pyerabicel wiye aryo, ki miya abiro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.26",
            "verseOrgIds": [
              "NUM.2.26"
            ]
          }
        },
        {
