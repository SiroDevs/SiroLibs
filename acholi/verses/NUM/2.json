              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma gikwano wel dano ma i buca monnye oromo alip pyerabic wiye adek, ki miya abicel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.30",
            "verseOrgIds": [
              "NUM.2.30"
            ]
          }
        },
