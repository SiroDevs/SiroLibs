          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma gikwano wel dano ma i buca monnye oromo alip pyeraŋwen, ki miya aŋwen, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.19",
            "verseOrgIds": [
              "NUM.2.19"
            ]
          }
        },
