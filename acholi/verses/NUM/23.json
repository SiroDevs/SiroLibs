        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaam owaco bot Balak ni, “Ber icanna keno tyer abiro kany, ci ikella twoni abiro ki romi bene abiro.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.1",
            "verseOrgIds": [
              "NUM.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balak otiyo kit ma Balaam ociko-ni; ci Balak ki Balaam gubedo ka tyero twon acel ki nyok romo acel i wi keno tyer acel acel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.2",
            "verseOrgIds": [
              "NUM.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Balaam owaco bot Balak ni, “Cuŋ kany i ŋet gitum awanani-ni, ci an abicito kunnu. Gwok nyo Rwot bibino ka rwatte kweda, ci gin ducu ma en binyutta abititti.” Ci ocito malo i wi got ka ma yadi pe iye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.3",
            "verseOrgIds": [
              "NUM.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.3",
            "verseOrgIds": [
              "NUM.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Lubaŋa orwatte ki Balaam.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.4",
            "verseOrgIds": [
              "NUM.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaam owaco bote ni, “Doŋ atyeko yubo keno tyer abiro, dok atyero twon acel ki nyok romo acel i wi keno tyer acel acel.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.4",
            "verseOrgIds": [
              "NUM.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Rwot oketo lokke i dog Balaam kun waco bote ni, “Dok cen bot Balak ci iwac kit man.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.5",
            "verseOrgIds": [
              "NUM.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odok cen ci onoŋo Balak pud ocuŋ ka ŋet gitum awaŋane kacel ki ludito pa jo Moab ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.6",
            "verseOrgIds": [
              "NUM.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaam ocako lokke kun loko macalo lanebi. Owacci,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.7",
            "verseOrgIds": [
              "NUM.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.10",
            "verseOrgIds": [
              "NUM.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Balak owaco ki Balaam ni, “Gin aŋo ma doŋ itimo tuŋ bota? Akeli kany ka ceno lumerokka, ci nen, in ilamo gum komgi keken.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.11",
            "verseOrgIds": [
              "NUM.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odok iye ni, “Myero agwokke ka loko gin ma Rwot oketo i doga.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.12",
            "verseOrgIds": [
              "NUM.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.12",
            "verseOrgIds": [
              "NUM.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balak dok owaco bote ni, “Bin doŋ kweda i kabedo mukene ka ma iromo nenogi iye. Ibineno jo ma gitye cok keken, pe ibinenogi ducu; ci icengi pira ki kunnu.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.13",
            "verseOrgIds": [
              "NUM.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci otere i poto pa Jopim wa i lacol got Piciga. Ocano keno tyer abiro kunnu, ci otyero twon acel ki nyok romo acel i wi keno tyer acel acel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.14",
            "verseOrgIds": [
              "NUM.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Balaam owaco bot Balak ni, “cuŋ kany ka ŋet gitum awaŋani, kun an arwatte ki Rwot kuca.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.15",
            "verseOrgIds": [
              "NUM.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Rwot orwatte ki Balaam, oketo lok i doge kun waco ni, “Dok cen bot Balak, ci iwac kit man.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.16",
            "verseOrgIds": [
              "NUM.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odok bote ci onoŋo Balak pud ocuŋ ka ŋet gitum awaŋane ki ludito pa jo Moab kacel kwede. Balak openye ni, “Rwot doŋ oloko niŋo?” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.17",
            "verseOrgIds": [
              "NUM.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaam ocako lokke kun loko macalo lanebi. Owacci,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.18",
            "verseOrgIds": [
              "NUM.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.24",
            "verseOrgIds": [
              "NUM.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Balak owaco bot Balaam ni, “Ka pe iye cenogi, myero pe dok ilam gum komgi aye.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.25",
            "verseOrgIds": [
              "NUM.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Balaam odok iye ki Balak ni, “Yam pe awaco boti ni, ‘Gin ducu ma Rwot ocika kwede, meno aye myero ati’?”. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.26",
            "verseOrgIds": [
              "NUM.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Balak owaco bot Balaam ni, “Koni doŋ ibin, abiteri i kabedo mukene; gwok Lubaŋa biye ni icengi ki kunnu.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.27",
            "verseOrgIds": [
              "NUM.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balak dok otero Balaam i wi lacol got Peor ma neno piny tuŋ tim aroo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.28",
            "verseOrgIds": [
              "NUM.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Balaam owaco bot Balak ni, “Canna bene keno tyer abiro kany, ikella twoni abiro ki nyogi romi abiro.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.29",
            "verseOrgIds": [
              "NUM.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balak otiyo kit ma Balaam owaco-ni, ci otyero twon acel ki nyok romo acel i wi keno tyer acel acel.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.30",
            "verseOrgIds": [
              "NUM.23.30"
            ]
          }
        }
      ]
    }
