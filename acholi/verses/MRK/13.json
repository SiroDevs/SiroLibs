          ]
        },
        {
          "text": " “Ento i kare meno ki i ŋe can madit-ti, bibedo kit macalo yam gicoyo ni.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.24",
            "verseOrgIds": [
