              "MRK.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 16:19"
          },
          "items": [
            {
              "text": "19",
