          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare ducu ma noŋo kabaka cito i ot pa Rwot, lugwok en gimako kwodi, ka dok gidwokogi kakagi i ot kicika pa lugwok kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
