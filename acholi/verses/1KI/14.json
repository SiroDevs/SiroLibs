              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka Rekoboam dok otiyo kwodi mukene ma kakagi; otiyo kwodi mola ci omiyogi i ciŋ ludito pa Lugwok kabaka, ma gigwoko doggola ot pa kabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
