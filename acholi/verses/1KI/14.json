              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lweny obedo i kin Rekoboam ki Jeroboam kare mapol. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
            "verseOrgIds": [
              "1KI.14.30"
