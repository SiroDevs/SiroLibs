          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Labeka dok owaco bot Icaka ni, “An doŋ kwona ool woko ki kit kwo pa mon Kit. Ka dok Yakobo bene binyomo anyira Kit ma rom ki mon ma gitye i lobo-ni, ci doŋ kwona konyo aŋo?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.46",
            "verseOrgIds": [
              "GEN.27.46"
            ]
          }
        }
