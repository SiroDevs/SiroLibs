          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kejero me Karmel, Parai ma jo Arbi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.35",
            "verseOrgIds": [
              "2SA.23.35"
            ]
          }
        },
