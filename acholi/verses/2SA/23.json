              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliaba me Caalbon ma wod pa Jacen, Yonacan, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.32",
            "verseOrgIds": [
              "2SA.23.32"
