          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cama ma jo Karar, Akiam wod pa Carar ma jo Karar, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.33",
            "verseOrgIds": [
              "2SA.23.33"
