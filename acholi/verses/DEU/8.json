              "DEU.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.11",
            "verseOrgIds": [
              "DEU.8.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.13.5+HOS.13.6"
              },
              "items": [
                {
                  "text": "Koc 13.5-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wugwokke kekenwu wek pe wiwu owil woko i kom Rwot Lubaŋawu, kun pe doŋ wugwoko lok ma en ociko; ki gin ma oŋolo, ki lwak cikke ducu ma atye ka cikowu kwede tin; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.11",
            "verseOrgIds": [
              "DEU.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "wek wiwu pe ocak doko dito ka doŋ wucamo, wuyeŋ, ma doŋ wugero odi mabeco ma wubedo iye, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.12",
            "verseOrgIds": [
              "DEU.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "dok ka dyaŋiwu ki romiwu doŋ onya mapol, ki ryalwu ki jabuwu omedde madwoŋ, ki jami ducu ma wutye kwedgi doŋ onya omedde madwoŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.13",
            "verseOrgIds": [
              "DEU.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe wiwu owil woko i kom Rwot Lubaŋawu, ma yam okwanyowu woko ki i lobo Ejipt, ki i ot me opii ca, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.14",
            "verseOrgIds": [
              "DEU.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma yam otelo wiwu wuwok kwede i tim malac ki malik bene, ma tye iye lwak twol ma kwirgi kec, ki oton, ki lobo ma orwo pii mako iye dano, ma pii pe iye-ni, ci en okelowu pii mua ki i pata got. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.15",
            "verseOrgIds": [
              "DEU.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "En bene opitowu i tim ki manna ma yam kwarowu pe giŋeyo, wek elokwu wudok mwol, kun temo ki cwinywu, wek otimwu ber lacen. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.16",
            "verseOrgIds": [
              "DEU.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wugwokke wuwek Lwodo lok ki i cwinywu ni, “Tek koma ki twero me bada gira aye omiyo alimo lonyo man.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.17",
            "verseOrgIds": [
              "DEU.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wun wubipo i kom Rwot Lubaŋawu, pien en aye ma miyowu tek me limo lonyo; wek en omok gicikkene ma yam okwoŋo pire bot kwarowu, macalo pud tye wa kombeddi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.18",
            "verseOrgIds": [
              "DEU.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce wiwu owil woko i kom Rwot Lubaŋawu, ci wucako lubo kor lwak lubaŋa mukene, ki tiyo botgi ki ryebbe piny i nyimgi, atitowu atyer tin ni, wubito wutum woko liweŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.19",
            "verseOrgIds": [
              "DEU.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wubito wutum woko macalo lurok ma Rwot tye ka miyogi to gitum woko ki i nyimwu-ni, pien pe wumedo ki woro dog Rwot Lubaŋawu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.20",
            "verseOrgIds": [
              "DEU.8.20"
            ]
          }
        }
      ]
    }
