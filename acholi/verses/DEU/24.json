            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ibipo ni yam ibedo opii i lobo Ejipt ci Rwot Lubaŋawu okoki woko ‘ki i kunnu, en gin mumiyo aciko ni itim kit meno.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.18",
            "verseOrgIds": [
