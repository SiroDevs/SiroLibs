          },
          "items": [
            {
              "text": "\n        Levi 13.1–14.54\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“I kom two dobo wubed ka gwokke matek kun wutimo gin ducu kit ma ajwaka ma Lalevi bititowu; kit ma yam acikogi kwede, wubigwokke ka tiyo kit meno. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.10"
              },
              "items": [
                {
                  "text": "Wel 12.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wupo gin ma yam Rwot Lubaŋawu otiyo i kom Miriam ki i yo ma onoŋo wua ki i Ejipt.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        }
