          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibipo ni yam ibedo opii i lobo Ejipt, engin mumiyo aciko ni itim kumeno.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.22",
