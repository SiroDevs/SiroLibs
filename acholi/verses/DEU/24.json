                  "text": "23.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ka ikayo cam i potoni, ce wii owil ki larita bel mo iweko odoŋ i poto, pe idok cen ka omone; doŋ bibedo pi labedo ki latin kic ki daa-to; wek Rwot Lubaŋawu omii gum i kom tic ducu ma ibitiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.19",
            "verseOrgIds": [
              "DEU.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce igoyo yat jeitunini pi coko nyige, pe idok ibek obote; doŋ bibedo pa labedo ki latin kic ki daa-to. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.20",
            "verseOrgIds": [
              "DEU.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka icoko nyig olok ki i potoni, pe idok cen ka beko obote; doŋ bibedo pa labedo ki latin kic ki daa-to. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.21",
            "verseOrgIds": [
              "DEU.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
