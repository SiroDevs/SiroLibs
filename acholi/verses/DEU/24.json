        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka laco mo pud onyomo nyen, pe bicito woko kacel ki mony, dok pe gibicwale i dog tic mo; en bibedo paco mot pi mwaka acel, wek obed ki yomcwiny gin ki dakone ma onyomo-ni,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
