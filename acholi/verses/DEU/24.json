            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ŋatti mo ginoŋo okwalo dano mo ki i kin omege jo Icrael, ce otimo en kit ma gitimo ki opii, nyo ocate woko, ci lakwo meno gibinekone woko; kit meno miyo wubijwero tim marac woko ki i kinwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.7",
            "verseOrgIds": [
              "DEU.24.7"
            ]
          }
        }
