                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pe ibikobo got ma poko waŋ lobo pa lawoti ma yam ludoŋo gutyeko pokone ki i lobo ma ibileyo bot kwarowu i lobo ma Rwot Lubaŋawu bimiyowu me bedo mewu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
