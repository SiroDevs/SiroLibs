                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.19+LEV.24.20"
              },
              "items": [
                {
                  "text": "Levi 24.19-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.38"
              },
              "items": [
                {
                  "text": "Mat 5.38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kica pe bimakowu i kome; kwo gibiculo ki kwo, waŋ ki waŋ, lak ki lak, bad ki bad, tyen ki tyen.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.21",
            "verseOrgIds": [
              "DEU.19.21"
            ]
          }
        }
