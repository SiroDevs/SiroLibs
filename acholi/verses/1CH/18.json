            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.11",
            "verseOrgIds": [
              "1CH.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
            "verseOrgIds": [
              "1CH.18.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.60"
              },
              "items": [
                {
                  "text": "Jab 60",
                  "type": "text"
                }
              ]
            },
            {
              "text": "(Title)",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok Abicai wod pa Jeruya oneko jo Edom alip apar wiye aboro i nota me Kado. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
            "verseOrgIds": [
              "1CH.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci oketo lumony i cel gogo i Edom; ci jo Edom ducu gudoko lutic pa Daudi. Rwot omiyo Daudi obwoyo lobo ka ma yam ocito iye ducu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi oloyo jo Icrael ducu kit meno; obedo ka ŋolo kop atir dok kakare i kom lwakke ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.14",
            "verseOrgIds": [
              "1CH.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab wod pa Jeruya obedo ladit me mony; ki Yekocapat wod pa Akilud obedo laco lok ma timme; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.15",
            "verseOrgIds": [
              "1CH.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jadok wod pa Akitub ki Akimelek wod pa Abiatar gubedo ajwagi; Cavica obedo karan, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.16",
            "verseOrgIds": [
              "1CH.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki Benaya wod pa Yekoyada obedo ladit ma loyo jo Keret ki jo Pelet; ki awobe pa Daudi gubedo ludito ma loyo tic pa kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.17",
            "verseOrgIds": [
              "1CH.18.17"
            ]
          }
        }
      ]
    }
