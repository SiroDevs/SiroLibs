                }
              ]
            }
          ]
        },
        {
          "text": " Ka ibino, kella ki boŋo ma yam aweko i Teroa tuŋ pa Karpo. Kwokka bene bukka, makatone maca me del ca. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.13",
            "verseOrgIds": [
