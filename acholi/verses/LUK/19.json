          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento pe gunoŋo gin mo ma myero gutim i kome, pien dano ducu guketo cwinygi ka winyo lokke.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.48",
