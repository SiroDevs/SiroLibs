            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yecu obedo ka pwony i ot pa Lubaŋa nino ducu. Ajwagi madito pa Lubaŋa ki lupwony-cik ki jo madito i kin lwak guyenyo yo me neke; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.47",
            "verseOrgIds": [
              "LUK.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
