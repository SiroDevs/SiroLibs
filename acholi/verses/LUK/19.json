  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "LUK 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yecu odonyo i Jeriko kun oekato akata. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.1",
            "verseOrgIds": [
              "LUK.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onoŋo tye kunnu dano mo ma nyiŋe Jakayo, lajogmucoro madit, dok lalonyo bene. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.2",
            "verseOrgIds": [
              "LUK.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oparo pi neno Yecu, ento pe otwero pi lwak, pien en cek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.3",
            "verseOrgIds": [
              "LUK.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oriŋo anyim, oito i wi yat olam wek enen, pien Yecu onoŋo oewok ki i yo-nu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.4",
            "verseOrgIds": [
              "LUK.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Yecu oo i kabedo-nu, oneno malo, owacce ni, “Jakayo, lor piny oyotoyot; pien tin myero abed i odi.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.5",
            "verseOrgIds": [
              "LUK.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakayo olor oyotoyot, ojole ki yomcwiny. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.6",
            "verseOrgIds": [
              "LUK.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dano ducu guneno, ci guŋur kun giwaco ni, “En odonyo i ot ka bedo welo pa dano ma labalo.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.7",
            "verseOrgIds": [
              "LUK.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakayo oa malo, owaco bot Rwot ni, “Nen, Ladit, abimiyo nucu jamina bot lucan; ka abumo ŋat mo i gin mo, abicule waŋ aŋwen.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.8",
            "verseOrgIds": [
              "LUK.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yecu owacce ni, “Tin lar obino i ot man, pien en bene lakwar Abraim. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.9",
            "verseOrgIds": [
              "LUK.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.11"
              },
              "items": [
                {
                  "text": "Mat 18.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pien Wod pa dano obino ka yenyo ki ka laro jo ma orwenyo.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.10",
            "verseOrgIds": [
              "LUK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.10",
            "verseOrgIds": [
              "LUK.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.11",
            "verseOrgIds": [
              "LUK.19.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.14+MAT.25.15+MAT.25.16+MAT.25.17+MAT.25.18+MAT.25.19+MAT.25.20+MAT.25.21+MAT.25.22+MAT.25.23+MAT.25.24+MAT.25.25+MAT.25.26+MAT.25.27+MAT.25.28+MAT.25.29+MAT.25.30"
              },
              "items": [
                {
                  "text": "Mat 25.14-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka pud giwinyo lok man, Yecu omedde ki lokke, obolo botgi carolok, pien onoŋo doŋ cok ki Jerucalem, dok pien onoŋo gitamo ni ker pa Lubaŋa binen cutcut. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.11",
            "verseOrgIds": [
              "LUK.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi meno owaco ni, “Yam tye wod ker mo ma oa ocito i lobo mabor ka limo twerone me loc ka doŋ odwog cen. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.12",
            "verseOrgIds": [
              "LUK.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwoŋo luticce apar, opoko botgi ciliŋ alip acel, owaco botgi ni, ‘Wucat ki wil nio waŋ ma an adwogo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.13",
            "verseOrgIds": [
              "LUK.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento dano me lobone gukwere, gucwalo lukwena i kore ki lok ni, ‘Pe wamito dano man olowa.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.14",
            "verseOrgIds": [
              "LUK.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋ en odwogo, ma doŋ ocamo ker, ociko ni gilwoŋ lutic ma yam emiyogi lim-mi, wek eŋe wel magoba ma gulimo i cato wilgi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.15",
            "verseOrgIds": [
              "LUK.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano mukwoŋo obino i nyime, owaco ni, ‘Ladit, ciliŋ miya ma imiya-ni omedde iye ciliŋ alip acel mukene.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.16",
            "verseOrgIds": [
              "LUK.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogamo ni, ‘Ber, in latic maber! Pien yam ibedo lagen i kom jami matidi mo, ibibedo ki twero i kom gaŋi apar.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.17",
            "verseOrgIds": [
              "LUK.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano me aryone obino, owaco ni, ‘Ladit, ciliŋ miya dok omedde iye ciliŋ miya abic mukene.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.18",
            "verseOrgIds": [
              "LUK.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owacce ni, ‘In bene ibibedo ki twero i kom gaŋi abic.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.19",
            "verseOrgIds": [
              "LUK.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat mukene dok obino, owaco mere ni, ‘Ladit, limmi en, agwoko, aboyo i kitambara, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.20",
            "verseOrgIds": [
              "LUK.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "pien onoŋo alwori, pien in i dano magwa; ikwanyo gin ma pe ikano, ikayo ka ma pe icoyo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.21",
            "verseOrgIds": [
              "LUK.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owacce ni, ‘Abiŋolo kop loyi kun lubo lok ma oa ki i dogi keni, in latic marac! Yam iŋeyo ni an a dano magwa, akwanyo gin ma pe akano, akayo ka ma pe acoyo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.22",
            "verseOrgIds": [
              "LUK.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "piŋo doŋ pe ikano limma i beŋŋe, wek ka adwogo, anoŋ kun acoko limma ki magobane?’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.23",
            "verseOrgIds": [
              "LUK.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owaco bot jo ma gucuŋ ka ŋete ni, ‘Wugam ciliŋ miya-ni woko ki bote wumi bot won ciliŋ alip acel-li.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.24",
            "verseOrgIds": [
              "LUK.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guwacce ni, ‘Ladit, en doŋ tye ki ciliŋ alip acel!’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.25",
            "verseOrgIds": [
              "LUK.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.12"
              },
              "items": [
                {
                  "text": "Mat 13.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.25"
              },
              "items": [
                {
                  "text": "Mar 4.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.18"
              },
              "items": [
                {
                  "text": "Luka 8.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ci en owacci, ‘Atito botwu ni, dano ducu ma mere tye gibimedo bote gin mo; ento ŋat ma mere pe, gibikwanyo woko ki bote kadi wa gin ma tye bote. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.26",
            "verseOrgIds": [
              "LUK.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento lukworra magi, ma gin gukwera ni pe alogi-ni, wukelgi kany, wunekgi ki pala lucwan i nyima.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.27",
            "verseOrgIds": [
              "LUK.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.27",
            "verseOrgIds": [
              "LUK.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Yecu otyeko loko lok man, ci owoto anyim kun cito malo i Jerucalem. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.28",
            "verseOrgIds": [
              "LUK.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋ onyiko cok ki Betepage ki Betania, i te got ma gilwoŋo Jeituni, Yecu ocako oro jo aryo ki i kin lupwonynyene, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.29",
            "verseOrgIds": [
              "LUK.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kun cikogi ni, “Wucit i gaŋ ma tye i nyimwu. Ka ce wudonyo iye wubinoŋo latin kana ma gitweyo, ma ŋat mo peya oito i wiye; ci wugony, wukel kany. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.30",
            "verseOrgIds": [
              "LUK.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ŋatti mo openyowu ni, ‘Wugonye piŋo?’ wun wubidok iye kit man ni, ‘Rwot aye mito.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.31",
            "verseOrgIds": [
              "LUK.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit meno jo ma giorogi gucito, ci gunoŋo kit macalo Yecu otito botgi-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.32",
            "verseOrgIds": [
              "LUK.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka gitye ka gonyo latin kana, wegine gupenyogi ni, “Wugonyo latin kana piŋo?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.33",
            "verseOrgIds": [
              "LUK.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gudok iye botgi ni, “Rwot aye mito.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.34",
            "verseOrgIds": [
              "LUK.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukelo latin kana bot Yecu. Ka doŋ gupeto ginarukagi i wiye, ci gicibo Yecu i wiye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.35",
            "verseOrgIds": [
              "LUK.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka en oewoto, gipeto ginarukagi i waŋayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.36",
            "verseOrgIds": [
              "LUK.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma doŋ onyiko cok ki Jerucalem, i luŋ me got Jeituni, lwak lupwonnyene ducu cwinygi obedo yom, gupako Lubaŋa ki dwan maloŋo pi tic madito ma guneno, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.37",
            "verseOrgIds": [
              "LUK.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.26"
              },
              "items": [
                {
                  "text": "Jab 118.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kun giwaco ni,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.38",
            "verseOrgIds": [
              "LUK.19.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.40",
            "verseOrgIds": [
              "LUK.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋ onyiko cok, ma oneno gaŋ, okok pire, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.41",
            "verseOrgIds": [
              "LUK.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "kun waco ni, “Tin-ni ka kono iŋeyo lok ma kelo kuc boti, kono ber! Ento koni gikano woko ki boti. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.42",
            "verseOrgIds": [
              "LUK.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien kare bibino i komi ma lukworri gibitoro lobo rumi dyere, gibidiri tuŋŋi ki tuŋŋi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.43",
            "verseOrgIds": [
              "LUK.19.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "gibireti piny, in ki litinoni; pe gibiweko gweŋ mo acel i ii doŋ ma ododde i wi wadi; pien yam pe iŋeyo kare ma gibilimi iye.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.44",
            "verseOrgIds": [
              "LUK.19.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.44",
            "verseOrgIds": [
              "LUK.19.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 19:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yecu odonyo i ot pa Lubaŋa, ocako ryemo lucat-wil woko ki iye, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.45",
            "verseOrgIds": [
              "LUK.19.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 19:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.7"
              },
              "items": [
                {
                  "text": "Ic 56.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.11"
              },
              "items": [
                {
                  "text": "Jer 7.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kun waco botgi ni, “Yam gicoyo ni ‘Oda bibedo ot me lega’; ento wun wuloko odoko boro pa luyak.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.46",
            "verseOrgIds": [
              "LUK.19.46"
            ]
          }
        }
      ]
    },
