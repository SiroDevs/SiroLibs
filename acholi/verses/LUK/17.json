          },
          "items": [
            {
              "text": "Acak 18.20–19.25",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kit meno bene i kare pa Lot, onoŋo gicamo, gimato, giwilo jami, gicato jami, gipito ginapita, gigero odi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.28",
            "verseOrgIds": [
              "LUK.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento i nino ma Lot oa woko ki i Codom mac ki gweŋ calfa ma mac oliyo ocwer ki i polo, otyekogi ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.29",
            "verseOrgIds": [
              "LUK.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bibedo kit meno i kare ma gibinyuto iye Wod pa dano. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.30",
            "verseOrgIds": [
              "LUK.17.30"
            ]
          }
        },
