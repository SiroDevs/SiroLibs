            }
          ]
        },
        {
          "text": " Yam gicamo, gimato, awobegi ki anyira ginyomme, nio i nino ma Nua odonyo kwede i yeya, pii aluka ocorre otyekogi ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.27",
            "verseOrgIds": [
