          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Co aryo bibedo i poto, gibikwanyo ŋat acel, gibiweko ŋat acel doŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.36",
            "verseOrgIds": [
              "LUK.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
