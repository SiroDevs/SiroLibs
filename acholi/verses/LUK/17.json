        },
        {
          "text": " Ŋat ma mito laro kwone birwenyone, ento ŋat ma rwenyo kwone, bigwoko. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.33",
            "verseOrgIds": [
              "LUK.17.33"
            ]
