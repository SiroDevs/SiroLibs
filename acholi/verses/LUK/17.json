              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atittiwu ni,, i dyewor meno co aryo bibuto wi kitanda acel, gibikwanyo ŋat acel, gibiweko ŋat acel doŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.34",
            "verseOrgIds": [
              "LUK.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mon aryo gibibedo ka rego kacel; gibikwanyo ŋat acel, gibiweko ŋat mukene doŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.35",
            "verseOrgIds": [
              "LUK.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
