            "number": "37",
            "style": "v",
            "sid": "LUK 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gupenye ni, “Kwene, Rwot?” En owaco botgi ni, “Ka ma kom dano muto tye iye, acut bene gicokke kunnu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
