      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kare okato manok, Yecu owoto i kin gaŋi madoŋo ki matino kun tito dok nyuto lok me kwena maber i kom ker pa Lubaŋa. Jone apar wiye aryo onoŋo tye kwede, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.1",
            "verseOrgIds": [
              "LUK.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.55"
              },
              "items": [
                {
                  "text": "Mat 27.55",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.56"
              },
              "items": [
                {
                  "text": "56",
