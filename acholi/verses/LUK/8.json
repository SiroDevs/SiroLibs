                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.49"
              },
              "items": [
                {
                  "text": "Luka 23.49",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kacel ki mon mogo ma yam en ocaŋogi i kom cen maraco ki i kom two; Maliam ma gilwoŋo ni Maliam me Magdala, ma cen maraco abiro yam oa woko ki i kome, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.2",
            "verseOrgIds": [
              "LUK.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joana dako pa Kuja, lagwok-lim pa Kerode, Cucana, ki mon mukene mapol, ma yam gikonye ki limgi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.3",
            "verseOrgIds": [
              "LUK.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.3",
            "verseOrgIds": [
              "LUK.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka lwak mapol gucokke kacel, kun dano gubino bote ma gia ki i gaŋi mapol, Yecu oloko i carolok ni, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.4",
            "verseOrgIds": [
              "LUK.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lacoc ocito ka coyo kodine. Ka kun coyo, ci kodi mogo okir i ŋet yo, dano gunyono, winyo me polo gubino gucamo woko. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.5",
            "verseOrgIds": [
              "LUK.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi mukene okir i kom pata; ka odoŋo, otwo woko, pien pii pe i tere. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.6",
            "verseOrgIds": [
              "LUK.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi mukene okir i kin okuto; okuto odoŋo kacel kwede, odiye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.7",
            "verseOrgIds": [
              "LUK.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi mukene okir i ŋom maber, ci odoŋo, guceko ma dodo tyen miya.” Ka doŋ oloko lok man, ci odaŋŋe owaco ni, “Ŋat ma tye ki it me winyone, owiny.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.8",
            "verseOrgIds": [
              "LUK.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.8",
            "verseOrgIds": [
              "LUK.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka lupwonnyene gupenye te lok me carolok man, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.9",
            "verseOrgIds": [
              "LUK.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.9+ISA.6.10"
              },
              "items": [
                {
                  "text": "Ic 6.9-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.21"
              },
              "items": [
                {
                  "text": "Jer 5.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.2"
              },
              "items": [
                {
                  "text": "Ejek 12.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ci en ogamo ni, “Wun gimiyowu me ŋeyo muŋ me ker pa Lubaŋa; ento jo mukene gimiyogi i carolok wek ka gineno, pe gunen, dok ka giwinyo, pe guniaŋ tere.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.10",
            "verseOrgIds": [
              "LUK.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.10",
            "verseOrgIds": [
              "LUK.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Carolok-ki tere ene: Kodi aye lok pa Lubaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.11",
            "verseOrgIds": [
              "LUK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ma i ŋet yo gin aye jo ma winyo; lacen Catan bino, kwanyo lok ki i cwinygi woko, wek pe guye, pe gularre. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.12",
            "verseOrgIds": [
              "LUK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ma i kom pata aye jo ma winyo, ci gigamo lok ki yomcwiny; ento pe gitye ki cwitgi, giye pi Kare manok, ento i kare me omo cwiny gipoto woko. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.13",
            "verseOrgIds": [
              "LUK.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ma okir i kin okuto, gin aye jo ma winyo, ento ka kare okato, ci tam mapol, ki lim, ki yomcwiny me kwo man diyogi, nyiggi pe cek maber. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.14",
            "verseOrgIds": [
              "LUK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ma i ŋom maber, gin aye jo ma ka guwinyo lok, ci gimako matek ki cwiny ma genne ki maber, ginyak nyiggi kun gidiyo cwinygi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.15",
            "verseOrgIds": [
              "LUK.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
