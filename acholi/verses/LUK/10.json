              },
              "items": [
                {
                  "text": "Jek 9.2-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ibikoko aŋee, in Korajin! Ibikoko aŋee, in Betecaida! Pien kono yam tic madito me twer ma gitiyo botwu gitiyo i Turo ki Cidon, kono jone guŋut wa con, kun giruko boŋo cola ma gibedo i buru bene. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento can pa Turo ki Cidon bibedo twaratwara i nino me ŋolo kop, makato can ma bipoto i komi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.14",
            "verseOrgIds": [
              "LUK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.13+ISA.14.14+ISA.14.15"
              },
              "items": [
                {
                  "text": "Ic 14.13-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ki in Kapernaum, gibitiŋi woko malo i polo? Pe kumeno, gibidwoki woko piny i Lyel.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.15",
            "verseOrgIds": [
              "LUK.10.15"
            ]
          }
        }
      ]
