          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yecu olokke bot lupwonnyene, owaco botgi i muŋ ni, “Tye ki gum, dano ma neno gin ma wun wuneno! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.23",
            "verseOrgIds": [
              "LUK.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien atittiwu ni, lunebi ki luker mapol yam guparo pi neno gin ma wun wuneno, ento pe guneno, ki winyo gin ma wun wuwinyo, ento pe guwinyo.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.24",
            "verseOrgIds": [
              "LUK.10.24"
            ]
          }
        }
      ]
    },
