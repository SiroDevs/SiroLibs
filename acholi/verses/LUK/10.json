              "items": [
                {
                  "text": "Jon 13.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ŋat ma winyowu, noŋo owinyo an, ŋat ma kwerowu, noŋo okwero an; ŋat ma kwera, noŋo okwero ŋat ma oora.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
