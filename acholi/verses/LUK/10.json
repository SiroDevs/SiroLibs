            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.15"
              },
              "items": [
                {
                  "text": "Mat 10.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Atito botwu ni, i nino meno can pa Codom bibedo twaratwara makato pa gaŋ meno.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.12",
            "verseOrgIds": [
              "LUK.10.12"
            ]
          }
        }
