              "type": "tag",
              "attrs": {
                "loc": "JOL.2.31"
              },
              "items": [
                {
                  "text": "Joel 2.31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.12"
              },
              "items": [
                {
                  "text": "Yabo 6.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Lanyut binen i kom ceŋ, i kom dwe ki i kom lakalatwe, rok mapol ma i wi lobo bikumo kun noŋo cwinygi oŋabbe aŋaba pi mor me biamwonyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.25",
            "verseOrgIds": [
              "LUK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kom dano bimyel ki lworo, ka gibitamo gin ma bipoto i kom lobo; pien twer ducu ma i polo biyeŋŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.26",
            "verseOrgIds": [
              "LUK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.13"
              },
              "items": [
                {
                  "text": "Dan 7.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Yabo 1.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lacen gibineno Wod pa dano kun bino i wi pol ki tek ki deyo madit. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.27",
            "verseOrgIds": [
              "LUK.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka gin magi ocako timme, myero wunen malo, myero wutiŋ wiwu malo, pien kare me kokowu doŋ onyiko cok.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.28",
            "verseOrgIds": [
              "LUK.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.28",
            "verseOrgIds": [
              "LUK.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
