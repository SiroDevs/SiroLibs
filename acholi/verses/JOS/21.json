          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lulevi mukene, ma gin aye doggola pa jo Merari, gulimo ki bot jo Jabulon Jokneam, Karta, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.34",
            "verseOrgIds": [
              "JOS.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimna ki Nakalal, gaŋi aŋwen ki olet ma i ŋetgi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.35",
            "verseOrgIds": [
              "JOS.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki bot jo Reuben gulimo Bejer, Jakaj, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.36",
            "verseOrgIds": [
              "JOS.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedemot ki Mepat, gaŋi aŋwen ki olet ma i netgi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.37",
            "verseOrgIds": [
              "JOS.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki bot jo Gad gulimo Ramot ma i Gilead ma gaŋ me laro lunek dano, Makanaim, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.38",
            "verseOrgIds": [
              "JOS.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kecbon ki Jajer, gaŋi aŋwen ki olet ma i ŋetgi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.39",
            "verseOrgIds": [
              "JOS.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaŋi ducu ma gimiyo bot doggola mapatpat pa jo Merari, en aye bot doggola pa Lulevi mudoŋŋe, obedo apar wiye aryo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.40",
            "verseOrgIds": [
              "JOS.21.40"
            ]
          }
        }
      ]
    },
