          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaŋi ducu pa Lulevi ma gitye i dye lobo pa jo Icrael gubedo pyeraŋwen wiye aboro, ki oletgi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.41",
            "verseOrgIds": [
              "JOS.21.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaŋ acel acel onoŋo tye ki lobo olet ma orume dyere; gaŋigi ducu gubedo kit meno.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.42",
            "verseOrgIds": [
              "JOS.21.42"
            ]
          }
        }
      ]
    },
    {
