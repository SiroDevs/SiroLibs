              "type": "text"
            }
          ]
        },
        {
          "text": "Yocwa ki jo Icrael ducu gulokke gudwogo cen i kom Debir, gulwenyo i kome, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.38",
            "verseOrgIds": [
              "JOS.10.38"
            ]
          }
