          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yocwa oloyogi cakke i Kadec-bamea o kwede wa i Gaja, kacel ki lobo Gocen ducu o wa i Gibeon. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.41",
            "verseOrgIds": [
              "JOS.10.41"
            ]
          }
