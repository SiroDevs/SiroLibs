              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yocwa oa woko ki i Makeda, okato ocito i Libna kacel ki jo Icrael ducu, olwenyo i kome, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.29",
            "verseOrgIds": [
              "JOS.10.29"
            ]
          }
