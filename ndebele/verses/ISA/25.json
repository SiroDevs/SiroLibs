            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakwelula izandla zakhe phakathi kwalo njengomuntu ontshezayo eselulela izandla zakhe ukuba antsheze; kodwa iNkosi izachitha ukuzikhukhumeza kwakhe, kanye lemisebenzi yezandla zakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.11",
            "verseOrgIds": [
              "ISA.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imiduli yakhe emide yezinqaba iNkosi izayidilizela phansi, iyiphosele emhlabathini lasothulini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.12",
            "verseOrgIds": [
              "ISA.25.12"
            ]
          }
        }
