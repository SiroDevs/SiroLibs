                {
                  "text": "2 Kho 15:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.26.23"
              },
              "items": [
                {
                  "text": "2 Lan 26:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
