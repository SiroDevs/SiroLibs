              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wokufa kwenkosi uUziya ngayibona iNkosi uNkulunkulu ihlezi esihlalweni sobukhosi esiphezulu lesiphakemeyo; umsila wengubo yayo wagcwalisa ithempeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
