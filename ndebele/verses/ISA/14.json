              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi izakumhawukela uJakobe, ibuye imkhethe futhi uIsrayeli, ibabeke elizweni lakibo; labezizwe bazahlangana labo, bahlale labo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.1",
            "verseOrgIds": [
              "ISA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bezizwe bazakubaphelekezela, babase endaweni zabo, abakoIsrayeli bazakubathumba elizweni leNkosi babe yizigqili zabo. Bazakuthumba abathumbi babo, babuse abacindezeli babo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.2",
            "verseOrgIds": [
              "ISA.14.2"
            ]
          }
        }
      ]
    },
