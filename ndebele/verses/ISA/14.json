          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho iNkosi isiliphumuzile ebuhlungwini benu lasekuhluphekeni kwenu lasemsebenzeni onzima ebelisetshenziswa kiwo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.3",
            "verseOrgIds": [
              "ISA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "lizakutsho lelilizwi lokukloloda ngenkosi yaseBabiloni lithi:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.4",
            "verseOrgIds": [
              "ISA.14.4"
            ]
          }
        }
