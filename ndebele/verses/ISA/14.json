          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakulenza libe yindawo yezinhloni lamatete amanzi, ngilithanyele ngomthanyelo wencithakalo, kutsho iNkosi yamabandla.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.23",
