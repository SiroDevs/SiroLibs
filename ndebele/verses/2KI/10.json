              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehu waya kwabaphansi, bamngcwabela eSamariya. UJehowahazi indodana yakhe waba yinkosi esikhundleni sakhe. ",
          "type": "text",
          "attrs": {
