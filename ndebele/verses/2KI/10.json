          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uJehu kaqaphelisanga ukuhamba ngomlayo weNkosi, uNkulunkulu kaIsrayeli, ngayo yonke inhliziyo yakhe; kazitshiyanga izono zikaJerobowamu ezenza uIsrayeli one.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.31",
            "verseOrgIds": [
              "2KI.10.31"
            ]
          }
        }
