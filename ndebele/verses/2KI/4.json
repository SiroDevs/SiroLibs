              "2KI.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.31",
            "verseOrgIds": [
              "2KI.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uElisha esengenile endlini, wambona umntwana elele embhedeni efile. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.32",
            "verseOrgIds": [
              "2KI.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasengena ngaphakathi, wazivalela khona, wakhuleka eNkosini. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.33",
            "verseOrgIds": [
              "2KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasekhwela embhedeni elala phezu komntwana, ebeka umlomo wakhe kowomntwana lamehlo akhe kwawakhe lezandla zakhe kwezakhe; kwathi esacambalele phezu kwakhe, umzimba womntwana wakhudumala. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.34",
            "verseOrgIds": [
              "2KI.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasevukake, wahambahamba kanye endlini, wabuya wakhwela embhedeni, wacambalala phezu komntwana; umntwana wathimula kwaze kwaba kasikhombisa, wasevula amehlo akhe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.35",
            "verseOrgIds": [
              "2KI.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "UElisha wabiza uGehazi wathi kuye: Akumbize lowowesifazana womShunami. Wasembizake. Kwathi esefikile, uElisha wathi kuye: Thatha, nangu umntanakho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.36",
            "verseOrgIds": [
              "2KI.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weza wawela ngasezinyaweni zakhe, wakhothamela phansi, wasethatha umntanakhe ephuma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.37",
            "verseOrgIds": [
              "2KI.4.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.37",
            "verseOrgIds": [
              "2KI.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "UElisha wasefika futhi eGiligali lapho kwakukhona indlala khona. Kwathi ixuku labaprofethi lihlezi phambi kwakhe, wathi encekwini yakhe: Beka imbiza enkulu eziko, uphekele abaprofethi ukudla. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.38",
            "verseOrgIds": [
              "2KI.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2KI 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunye wabo wasesiya ukukha imibhida egangeni, wabona intandela yeganga, wakha izithelo zayo, wagcwalisa uphiko lwengubo yakhe, waziqobela embizeni yokudla engazi ukuthi ziyini. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.39",
            "verseOrgIds": [
              "2KI.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaphakululwa ukuba badle; kodwa besadla ukudla bamemeza bathi: Wena muntu kaNkulunkulu, kulokufa embizeni. Kabazabe besakudla. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.40",
            "verseOrgIds": [
              "2KI.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesithi: Lethani impuphu. Waseyithela embizeni wathi: Baphakululeleni abantu, badle. Kwakungaselangozi embizeni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.41",
            "verseOrgIds": [
              "2KI.4.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.41",
            "verseOrgIds": [
              "2KI.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2KI 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwafika umuntu othile evela eBali‐Shalisha elethela umuntu kaNkulunkulu ukudla kwezithelo zokuqala, izinkwa ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.42",
            "verseOrgIds": [
              "2KI.4.42"
            ]
          }
        },
        {
          "text": " ezingamatshumi amabili, lezikhwebu zamabele amatsha emgodleni wakhe. UElisha wathi: Banike abantu ukuba badle. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.42",
            "verseOrgIds": [
              "2KI.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "2KI 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa inceku yakhe yathi: Ngizakubanika njani lokhu abantu abalikhulu na? Wasephinda esithi: Banike abantu ukuba badle, ngoba iNkosi ithi: Bazakudla, kuze kusale. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
              "2KI.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "2KI 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yasibanika inceku, badla kwaze kwasala, njengelizwi leNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.44",
            "verseOrgIds": [
              "2KI.4.44"
            ]
          }
        }
      ]
    }
  ],
