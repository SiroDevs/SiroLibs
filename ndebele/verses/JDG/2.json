              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isithunywa seNkosi sasuka eGiligali saya eBokimi, sathi: Ngalikhupha eGibithe, ngaliletha elizweni engafunga ukulinika okhokho benu. Ngathi kangisoze ngisaphule isivumelwano sami lani; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.1",
            "verseOrgIds": [
              "JDG.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "lani kaliyikwenza isivumelwano labakhileyo balelilizwe, lizadiliza ama‐altare abo. Kodwa kaliwulalelanga umlayo wami. Kuyini lokhu elikwenzileyo na?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.2",
            "verseOrgIds": [
              "JDG.2.2"
            ]
          }
        },
        {
