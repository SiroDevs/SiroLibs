            "sid": "JDG 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa esebadabulele abantu, abakoIsrayeli basuka ukuyakwakha elizweni, kwaba yilowo lalowo waya endaweni yakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.6",
            "verseOrgIds": [
              "JDG.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bayikhonza iNkosi kuzo zonke insuku zikaJoshuwa, lezabadala abasalayo ababewubonile umsebenzi omkhulu iNkosi eyawenzela uIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.7",
            "verseOrgIds": [
              "JDG.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa indodana kaNuni, inceku yeNkosi, wafa eleminyaka elikhulu letshumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.8",
            "verseOrgIds": [
              "JDG.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamngcwabela endaweni yakhe eTiminathi‐Heresi ezintabeni zakoEfrayimi, ngasenyakatho kwentaba iGashi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.9",
            "verseOrgIds": [
              "JDG.2.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.19.49+JOS.19.50"
              },
              "items": [
                {
                  "text": "Josh 19:49–50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.9",
            "verseOrgIds": [
              "JDG.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laso sonke lesosizukulwana safa, sambelwa kwabakibo; kwavela esinye emva kwaso esasingayazi iNkosi lomsebenzi eyayiwenzele uIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.10",
            "verseOrgIds": [
              "JDG.2.10"
            ]
          }
        }
      ]
    },
