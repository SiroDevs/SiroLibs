            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoIsrayeli benza okubi phambi kweNkosi, bakhonza ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.11",
            "verseOrgIds": [
              "JDG.2.11"
            ]
          }
        },
        {
          "text": ", ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.11",
            "verseOrgIds": [
              "JDG.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "batshiya iNkosi, uNkulunkulu wabokhokho babo, eyabakhupha elizweni laseGibithe, balandela abanye onkulunkulu, onkulunkulu bezizwe ababehlala phakathi kwazo, bakhothama kibo, bayithukuthelisa iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.12",
            "verseOrgIds": [
              "JDG.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batshiya iNkosi, bakhonza oBali ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.13",
            "verseOrgIds": [
              "JDG.2.13"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.13",
            "verseOrgIds": [
              "JDG.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho ulaka lweNkosi lwavutha kuIsrayeli, yabanikela kubaphangi ababaphangayo; yabanikela emandleni ezitha zabo ezazibahanqa, behluleka ukumelana lazo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.14",
            "verseOrgIds": [
              "JDG.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba besiya ngaphi, isandla seNkosi sabenzela okubi njengokutsho kwayo lanjengokufunga kwayo kibo, bahlupheka kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.15",
            "verseOrgIds": [
              "JDG.2.15"
            ]
          }
        }
