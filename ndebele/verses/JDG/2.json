                "loc": "DEU.7.2+DEU.7.3+DEU.7.4+DEU.7.5"
              },
              "items": [
                {
                  "text": "Dute 7:2–5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.2",
            "verseOrgIds": [
              "JDG.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khathesike ngithi kangiyikubaxotsha phambi kwenu, kodwa bazakuba yizitha zenu, labonkulunkulu babo babe ngumjibila kini. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.3",
            "verseOrgIds": [
              "JDG.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi isithunywa seNkosi sesikhulume lawomazwi kubo bonke abakoIsrayeli, badazuluka bakhala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.4",
            "verseOrgIds": [
              "JDG.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leyondawo bayibiza ngokuthi liBokimi, bayihlabela iNkosi lapho.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.5",
            "verseOrgIds": [
              "JDG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
