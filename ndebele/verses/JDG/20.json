  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "JDG 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abakoIsrayeli baphuma kusukela eDani kusiya eBerisheba kanye lelizwe leGileyadi, ibandla lonke labuthana njengamuntu munye eNkosini eMizipa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.1",
            "verseOrgIds": [
              "JDG.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinduna zabo bonke abantu lezizwe zonke zakoIsrayeli zazikhona emhlanganweni wabantu bakaNkulunkulu, izinkulungwane ezingamakhulu amane zamabutho ahlomileyo ahamba ngenyawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.2",
            "verseOrgIds": [
              "JDG.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoBenjamini bezwa kuthiwa abakoIsrayeli babuthene eMizipa. AbakoIsrayeli bathi: Sitsheleni ukuba lobububi benziwe kanjani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.3",
            "verseOrgIds": [
              "JDG.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "UmLevi indoda yalowowesifazana owayebulewe waphendula wathi: Ngafika eGibeya elakoBenjamini mina lomunye umfazi wami ukuba silale khona. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.4",
            "verseOrgIds": [
              "JDG.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadoda aseGibeya angivukela, azingelezela indlu engangikuyo ebusuku efuna ukungibulala, amdlova omunye umfazi wami, khathesi usefile. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.5",
            "verseOrgIds": [
              "JDG.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngamthatha, ngamquma iziqa, ngazithumela kulo lonke ilizwe lakoIsrayeli, ngoba lawomadoda enza amanyala lobubi koIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.6",
            "verseOrgIds": [
              "JDG.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke lina bantu bakoIsrayeli, lina lonke ake likhuphe ilizwi lenu lokweluleka. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.7",
            "verseOrgIds": [
              "JDG.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bonke basuka njengamuntu munye bathi: Kakukho loyedwa wethu ozabuyela ethenteni lakhe, lozabuyela emzini wakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.8",
            "verseOrgIds": [
              "JDG.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nankuke esizakukwenza eGibeya. Sizakwenza inkatho yokuhlasela, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.9",
            "verseOrgIds": [
              "JDG.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "sithathe abantu abalitshumi kuwo wonke amakhulu ezizwe zakoIsrayeli, lekhulu kuzo zonke inkulungwane, lenkulungwane kuzo zonke inkulungwane ezilitshumi, ukuba badinge umphako ebantwini owalabo abaphumele ukuhlasela iGibeya koBenjamini, ukuba kuphindiselwe ububi obenziwe koIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.10",
            "verseOrgIds": [
              "JDG.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke wonke amadoda akoIsrayeli awuhlasela umuzi, ehlangene njengamuntu munye.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.11",
            "verseOrgIds": [
              "JDG.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.11",
            "verseOrgIds": [
              "JDG.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izizwe zakoIsrayeli zathuma abantu kuso sonke isizwe sakoBenjamini zisithi: Yibubi bani lobu obenzeke phakathi kwenu na? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.12",
            "verseOrgIds": [
              "JDG.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke banikeleni labobantu ababi baseGibeya ukuze sibabulale, siqede okubi koIsrayeli. Kodwa abakoBenjamini kabalilalelanga ilizwi labafowabo, abantu bakoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.13",
            "verseOrgIds": [
              "JDG.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoBenjamini babuthana eGibeya bevela emizini yonke, ukuba balwe labakoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.14",
            "verseOrgIds": [
              "JDG.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoBenjamini babutha emizini yabo ngalolosuku abantu abahlomileyo abazinkulungwane ezingamatshumi amabili lesithupha ngaphandle kwabaseGibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.15",
            "verseOrgIds": [
              "JDG.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phakathi kwabo bonke laba kwakukhona abantu abakhethiweyo ababengamakhulu ayisikhombisa bengamanxele; bonke babekwazi ukujikijela ilitshe bengakhuthi ngitsho lonwele. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.16",
            "verseOrgIds": [
              "JDG.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoIsrayeli bodwa babutha amadoda ahlomileyo azinkulungwane ezingamakhulu amane; wonke ayengamadoda empi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.17",
            "verseOrgIds": [
              "JDG.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basuka baya eBetheli, babuza uNkulunkulu bathi: Ngubani ozakuhamba kuqala ukulwa labakoBenjamini na? INkosi yathi: NguJuda ozahamba kuqala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.18",
            "verseOrgIds": [
              "JDG.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoIsrayeli basebevuka ekuseni, bamisa ngaseGibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.19",
            "verseOrgIds": [
              "JDG.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baphuma ukuyakulwa labakoBenjamini, bazihlelela ukulwa labo eGibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.20",
            "verseOrgIds": [
              "JDG.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoBenjamini baphuma eGibeya, babulala ngalolosuku abantu bakoIsrayeli abazinkulungwane ezingamatshumi amabili lambili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.21",
            "verseOrgIds": [
              "JDG.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:23",
              "type": "text"
            },
            {
              "text": "Amazwi evesi 23 kabolandela amazwi evesi 21",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoIsrayeli basuka bayakhala phambi kweNkosi kwaze kwahlwa. Babuza eNkosini bathi: Sibuyele yini ukulwa labafowethu abakoBenjamini na? INkosi yathi: Yebo, hambani liyekulwa labo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.23",
            "verseOrgIds": [
              "JDG.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoIsrayeli basebeziqunga isibindi, bahlela impi kuleyondawo ababekuyo ngosuku lokuqala.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.22",
            "verseOrgIds": [
              "JDG.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.22",
            "verseOrgIds": [
              "JDG.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoIsrayeli basondela kwabakoBenjamini ngosuku lwesibili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.24",
            "verseOrgIds": [
              "JDG.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoBenjamini baphuma eGibeya ngosuku lwesibili, babulala kwabakoIsrayeli abantu abazinkulungwane ezilitshumi lezificaminwembili, bonke bengabantu abahlomileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.25",
            "verseOrgIds": [
              "JDG.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho bonke abantu bakoIsrayeli, yonke impi, basuka baya eBetheli, bakhala behlezi phambi kweNkosi, bazila ukudla kwaze kwahlwa, banikela iminikelo yokutshiswa leminikelo yokuthula phambi kweNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.26",
            "verseOrgIds": [
              "JDG.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babuza eNkosini ngoba umtshokotsho wesivumelwano sikaNkulunkulu wawulapho ngalezonsuku, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.27",
            "verseOrgIds": [
              "JDG.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "loFiniyasi indodana kaEleyazare kaAroni nguye owayewuphethe ngalezonsuku. Abantu bathi: Siphinde yini ukuyakulwa labafowethu abakoBenjamini, loba siyekele na? INkosi yathi: Hambani, ngoba kusasa ngizabanikela ezandleni zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.28",
            "verseOrgIds": [
              "JDG.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho abakoIsrayeli bacathamisa abantu inxa zonke zeGibeya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.29",
            "verseOrgIds": [
              "JDG.20.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.29",
            "verseOrgIds": [
              "JDG.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basuka ukuyahlasela abakoBenjamini ngosuku lwesithathu, bazihlelela ukulwa labo njengakwezinye izikhathi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.30",
            "verseOrgIds": [
              "JDG.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoBenjamini baphuma ukulwa labo, badonswa baphuma emzini; njengezikhathi eziphambili baqala ukubatshaya, babulala abalutshwana abaphosa baba ngamatshumi amathathu ezindleleni ezingasemagcekeni, enye yazo isiya eBetheli lenye isiya eGibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.31",
            "verseOrgIds": [
              "JDG.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoBenjamini bathi: Sibaqedile njengakuqala. Kodwa abakoIsrayeli bathi: Asibalekeni, sibakhuphe emzini, sibadonsele emigwaqweni engaphandle. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.32",
            "verseOrgIds": [
              "JDG.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebevuka bonke abakoIsrayeli endaweni zabo, babuthana eBali‐Tamari; abakoIsrayeli abacathameyo bavumbuluka endaweni yabo ngasentshonalanga kweGibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.33",
            "verseOrgIds": [
              "JDG.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alihlasela iGibeya amadoda akhethiweyo azinkulungwane ezilitshumi evela kubo bonke abakoIsrayeli ngokulwa okunzima. Kodwa abakoBenjamini babengazi ukuthi ingozi ifikile kubo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.34",
            "verseOrgIds": [
              "JDG.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yamnqoba uBenjamini phambi kukaIsrayeli. AbakoIsrayeli babulala abantu bakoBenjamini abazinkulungwane ezingamatshumi amabili lanhlanu lekhulu elilodwa ngalolosuku, bonke labo bengabantu abahlomileyo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.35",
            "verseOrgIds": [
              "JDG.20.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.35",
            "verseOrgIds": [
              "JDG.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoBenjamini basebebona ukuthi sebenqotshiwe. AbakoIsrayeli bamdedela uBenjamini, ngoba bathemba abantu ababecatheme ababebabeke ngaseGibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.36",
            "verseOrgIds": [
              "JDG.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labo ababecatheme basuka masinyane, balihlasela iGibeya inxa zonke, babulala bonke abakhona ngomkhonto. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.37",
            "verseOrgIds": [
              "JDG.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isibonakaliso esasimisiwe phakathi kwabakoIsrayeli labantu abacathemeyo sasingesokuba lapho sekuthunqa intuthu enkulu phakathi komuzi ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.38",
            "verseOrgIds": [
              "JDG.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakoIsrayeli baphenduke balwe. AbakoBenjamini baqalisa ukubabulala, babulala abakoIsrayeli abaphosa baba ngamatshumi amathathu, bathi: Impela sibaqedile njengasempini yakuqala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.39",
            "verseOrgIds": [
              "JDG.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho intuthu isiqalisa ukuthunqa phakathi komuzi, abakoBenjamini banyemukula bakubona bacabanga ukuthi umuzi wonke uyatsha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.40",
            "verseOrgIds": [
              "JDG.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JDG 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebephenduka abakoIsrayeli, abakoBenjamini batshaywa luvalo, ngoba babona ukuba ingozi isibehlele. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.41",
            "verseOrgIds": [
              "JDG.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JDG 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebebabalekela, baqonda enkangala; kodwa ukulwa kwafinyelela kubo, lalabo abaphuma phakathi komuzi bangena phakathi kwabo, bababulala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.42",
            "verseOrgIds": [
              "JDG.20.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JDG 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babahanqa abakoBenjamini, baxotshana labo bengabayekeli, babafica endaweni yasempumalanga kweGibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.43",
            "verseOrgIds": [
              "JDG.20.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JDG 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwabulawa abakoBenjamini abazinkulungwane ezilitshumi lezificaminwembili, bonke bengamaqhawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.44",
            "verseOrgIds": [
              "JDG.20.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JDG 20:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaseleyo baphenduka babalekela enkangala edwaleni laseRimoni. AbakoIsrayeli babulala abantu abazinkulungwane ezinhlanu ezindleleni, baxotshana labo baze babafica, babulala futhi abazinkulungwane ezimbili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.45",
            "verseOrgIds": [
              "JDG.20.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JDG 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho bonke abakoBenjamini ababulawayo mhlalokho babezinkulungwane ezingamatshumi amabili lanhlanu zamadoda ahlomileyo, bonke bengamaqhawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.46",
            "verseOrgIds": [
              "JDG.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JDG 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa abantu abangamakhulu ayisithupha babaleka, baqonda enkangala edwaleni laseRimoni, bahlala khona inyanga ezine. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.47",
            "verseOrgIds": [
              "JDG.20.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JDG 20:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoIsrayeli babuyela babahlasela futhi abakoBenjamini, babulala abantu lezinyamazana lakho konke abakufumanayo. Imizi yonke abayifumanayo bayitshisa ngomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.48",
            "verseOrgIds": [
              "JDG.20.48"
            ]
          }
        }
      ]
    }
