        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.9",
            "verseOrgIds": [
              "ECC.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowo othanda imali kayikwaneliswa yimali, laye othanda inotho kayikwaneliswa yinotho; lokho lakho kulize.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nxa inotho isanda, bayanda labayidlayo; lomnikazi wayo kumsizani ngaphandle kokuyibuka kuphela na?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isisebenzi silala ubuthongo obumnandi loba sisidla okulutshwana loba okunengi; kodwa onothileyo olokunengi kakhulu ahluleke ukulala.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukhona ububi obudanisayo esengibubonile ngaphansi kwelanga; ngibonile umuntu ezizuzela inotho ezakumlimaza, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.13",
            "verseOrgIds": [
              "ECC.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "leyonotho ichitheke ngonyanya omubi, azale umntwana engaselalutho. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.14",
            "verseOrgIds": [
              "ECC.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengokuphuma kwakhe esiswini sikanina uzabuyela khona eze enjengokuphuma kwakhe; konke ukutshikatshika kwakhe kakuyikumvezela ulutho angabuyela lalo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.15",
            "verseOrgIds": [
              "ECC.5.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
