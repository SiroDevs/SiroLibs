          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engikubonileyo mina ukuthi kuhle kuyikuba umuntu adle anathe azithokozise ekutshikatshikeni kwakhe konke atshikatshika kukho ngaphansi kwelanga ensukwini zakhe zonke ezilutshwana uNkulunkulu amnike zona zibe yisabelo sakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.18",
            "verseOrgIds": [
              "ECC.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyisiphiwo sikaNkulunkulu ukuba amnike inotho lempahla lamandla azithokozise ngakho, amukele isabelo sakhe, azithokozise ngomsebenzi wakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.19",
            "verseOrgIds": [
              "ECC.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayikukhumbula kakhulu insuku zokuphila kwakhe, ngoba uNkulunkulu emnikile ukuthokoza enhliziyweni yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.20",
            "verseOrgIds": [
              "ECC.5.20"
            ]
          }
        }
      ]
