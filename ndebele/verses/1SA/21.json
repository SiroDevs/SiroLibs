              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasesiya eNobi kuAhimeleki umpristi; uAhimeleki wamhlangabeza ethuthumela, wathi kuye: Kungani uwedwa, kungelamuntu olawe na?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.1",
            "verseOrgIds": [
              "1SA.21.1"
            ]
          }
        },
