    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba lihamba ngezimiso zami, ligcine imilayo yami, liyenze,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.3",
            "verseOrgIds": [
              "LEV.26.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.13+DEU.11.14+DEU.11.15"
              },
              "items": [
                {
                  "text": "Dute 11:13–15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.3",
            "verseOrgIds": [
              "LEV.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngizakulinisela izulu ngesikhathi salo, lelizwe lizathela izithelo, lezihlahla zeganga zithele izithelo zazo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.4",
            "verseOrgIds": [
              "LEV.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lizakubhula kuze kufike isikhathi sokuvuna amavini, livune amavini kuze kufike isikhathi sokuhlanyela; lizakudla ukudla kwenu, lisuthe, lihlale livikelekile elizweni lakini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.5",
            "verseOrgIds": [
              "LEV.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakulinika ukuthula elizweni, lilale lingethuswa muntu, ngisuse inyamazana ezimbi elizweni, lempi kayiyikuhlasela elizweni lakini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.6",
            "verseOrgIds": [
              "LEV.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lizakuxotsha izitha zenu, ziwe phambi kwenu empini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.7",
            "verseOrgIds": [
              "LEV.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahlanu benu bazaxotsha abalikhulu, labalikhulu benu bazaxotsha abazinkulungwane ezilitshumi; izitha zenu zizakubulawa phambi kwenu empini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.8",
            "verseOrgIds": [
              "LEV.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakuba lomusa kini, ngilenze ukuba lizale, lande, ngimise isivumelwano sami lani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.9",
            "verseOrgIds": [
              "LEV.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lizakudla okwesivuno esidala, likhuphe esidala ukuba lifake esitsha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.10",
            "verseOrgIds": [
              "LEV.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizahlala phakathi kwenu, kangiyikunengwa yini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.11",
            "verseOrgIds": [
              "LEV.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakuhamba phakathi kwenu, ngibe nguNkulunkulu wenu, libe ngabantu bami.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.12",
            "verseOrgIds": [
              "LEV.26.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.16"
              },
              "items": [
                {
                  "text": "2 Kor 6:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.12",
            "verseOrgIds": [
              "LEV.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "NgiyiNkosi uNkulunkulu wenu owalikhupha elizweni laseGibithe ukuba lingabi yizigqili zabo; ngephule izikeyi zejogwe lenu, ngenza ukuba lihambe liqondile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba lingangilaleli, lingagcini imilayo le yonke,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.14",
            "verseOrgIds": [
              "LEV.26.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.15+DEU.28.16+DEU.28.17+DEU.28.18+DEU.28.19+DEU.28.20+DEU.28.21+DEU.28.22+DEU.28.23+DEU.28.24+DEU.28.25+DEU.28.26+DEU.28.27+DEU.28.28+DEU.28.29+DEU.28.30+DEU.28.31+DEU.28.32+DEU.28.33+DEU.28.34+DEU.28.35+DEU.28.36+DEU.28.37+DEU.28.38+DEU.28.39+DEU.28.40+DEU.28.41+DEU.28.42+DEU.28.43+DEU.28.44+DEU.28.45+DEU.28.46+DEU.28.47+DEU.28.48+DEU.28.49+DEU.28.50+DEU.28.51+DEU.28.52+DEU.28.53+DEU.28.54+DEU.28.55+DEU.28.56+DEU.28.57+DEU.28.58+DEU.28.59+DEU.28.60+DEU.28.61+DEU.28.62+DEU.28.63+DEU.28.64+DEU.28.65+DEU.28.66+DEU.28.67+DEU.28.68"
              },
              "items": [
                {
                  "text": "Dute 28:15–68",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.14",
            "verseOrgIds": [
              "LEV.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "uba lilahla izimiso zami, lidelele izahlulelo zami, ukuze lingenzi imilayo yami yonke, leqe isivumelwano sami, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.15",
            "verseOrgIds": [
              "LEV.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngizakwenza kini lokhu, ngehlisele phezu kwenu ukwesaba okukhulu, lofuba, lomkhuhlane ozakufiphaza amehlo, liphele amandla. Lizakuhlanyelela inhlanyelo yenu ize, ngoba izitha zenu zizakuyidla. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.16",
            "verseOrgIds": [
              "LEV.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakumelana lani, lichithwe yizitha zenu. Abalizondayo bazakulibusa, libaleke lingaxotshwa muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.17",
            "verseOrgIds": [
              "LEV.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa loba kunjalo, uba lingangilaleli, ngizabuya ngilitshaye kasikhombisa ngenxa yezono zenu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.18",
            "verseOrgIds": [
              "LEV.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngiqede amandla enu aziphakamisileyo, ngenze amazulu enu abe njengensimbi ukuze izulu lingani, lomhlabathi wenu ube njengethusi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.19",
            "verseOrgIds": [
              "LEV.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "lamandla enu azakuchithelwa ize, ngoba ilizwe lenu kaliyikuthela izithelo zalo, lezihlahla zelizwe kaziyikuthela izithelo zazo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.20",
            "verseOrgIds": [
              "LEV.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.20",
            "verseOrgIds": [
              "LEV.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba lihamba ngokuphambene lami, lingangilaleli, ngizakwehlisela kini ezinye inhlupheko, ziphindwe kasikhombisa ezonweni zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.21",
            "verseOrgIds": [
              "LEV.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizathuma phakathi kwenu izilo ezizakulamuka abantwana benu, zibulale inkomo zenu, zilenze libe balutshwana, lezindlela zenu zibe yinkangala.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.22",
            "verseOrgIds": [
              "LEV.26.22"
            ]
          }
        }
      ]
    },
    {
