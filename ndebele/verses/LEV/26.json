              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.39",
            "verseOrgIds": [
              "LEV.26.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 26:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazakuvuma ububi babo lobubi baboyise, ububi ababenzayo kimi, futhi abahamba ngabo ngokuphambene lami. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.40",
            "verseOrgIds": [
              "LEV.26.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 26:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lami ngizahamba ngokuphambene labo, ngibase elizweni lezitha zabo; ng’khona inhliziyo zabo ezingcolileyo zizakuzithoba, bavume ukutshaywa ngenxa yobubi babo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.41",
            "verseOrgIds": [
              "LEV.26.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 26:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakukhumbula isivumelwano sami loJakobe, lesivumelwano sami loIsaka, lesivumelwano sami loAbrahama, ngilikhumbule lelizwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.42",
            "verseOrgIds": [
              "LEV.26.42"
            ]
          }
        },
        {
