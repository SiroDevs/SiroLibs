          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.22",
            "verseOrgIds": [
              "LEV.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba lingavumi ukuxwayiswa yimi ngalezizinto, kodwa lihamba ngokuphambene lami, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.23",
            "verseOrgIds": [
              "LEV.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "lami ngizahamba ngokuphambene lani, ngilitshaye kasikhombisa ngenxa yezono zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.24",
            "verseOrgIds": [
              "LEV.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakwehlisela impi phezu kwenu ezakuphindisela isivumelwano. Uba libuthana emizini yenu, ngizakuthuma umkhuhlane phakathi kwenu, linikelwe ezandleni zezitha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.25",
            "verseOrgIds": [
              "LEV.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho nginciphisa ukudla kwenu, abesifazana abalitshumi bazapheka izinkwa zenu eziko linye, balinike izinkwa ngobunzima bazo; lizakudla, kodwa lingasuthi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.26",
            "verseOrgIds": [
              "LEV.26.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.26",
            "verseOrgIds": [
              "LEV.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba lingangilaleli, lanxa izinto lezo zinjalo, lihambe ngokuphambene lami, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.27",
            "verseOrgIds": [
              "LEV.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "lami ngizakuhamba ngokuphambene lani ngilolaka, ngilitshaye kasikhombisa ngenxa yezono zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.28",
            "verseOrgIds": [
              "LEV.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lizakudla imizimba yamadodana enu leyamadodakazi enu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.29",
            "verseOrgIds": [
              "LEV.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakuvala indawo zenu eziphakemeyo zokukhonzela, ngidilize ama‐altare enu empepha, ngiphosele izidumbu zenu phezu kwezidumbu zezithombe zenu, nginengwe yini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.30",
            "verseOrgIds": [
              "LEV.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakwenza imizi yenu ibe ngamanxiwa, ngidilize izindlu zenu ezingcwele; kangiyikwamukela iphunga elimnandi leminikelo yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.31",
            "verseOrgIds": [
              "LEV.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakuchitha ilizwe ukuba izitha zenu ezihlala kulo zimangaliswe yilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.32",
            "verseOrgIds": [
              "LEV.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakulihlakazela ezizweni, ngihwatshe umhedla ngilixotshe; ilizwe lakini lizakuba yincithakalo, lemizi yenu ichitheke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.33",
            "verseOrgIds": [
              "LEV.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’khona ilizwe lizakuthokoza ngamaSabatha alo nxa lihlala lichithekile, lina lisekhona elizweni lezitha zenu; ilizwe lizakuphumula, lithokoze ngamaSabatha alo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.34",
            "verseOrgIds": [
              "LEV.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngesikhathi sonke elihlala lichithekile ngaso lizakuphumula, ukuphumula elalingelakho ngamaSabatha enu nxa lalihlala kilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.35",
            "verseOrgIds": [
              "LEV.26.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 26:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayelana lalabo abaseleyo phakathi kwenu, ngizakwenza inhliziyo zabo zesabe emazweni ezitha zabo; lapho besizwa ihlamvu linyikinyeka, bazakubaleka, babaleke njengomuntu obalekela impi, bawe bengaxotshwa muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.36",
            "verseOrgIds": [
              "LEV.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazakugwenxana kungathi babalekela impi, bengaxotshwa muntu. Kaliyikuba lamandla okumelana lezitha zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.37",
            "verseOrgIds": [
              "LEV.26.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 26:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lizakubhubhela ezizweni, lelizwe lezitha zenu lizakulidla. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.38",
            "verseOrgIds": [
              "LEV.26.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 26:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaseleyo phakathi kwenu bazakubhubha emazweni ezitha zabo ngenxa yobubi babo, babhubhe langenxa yobubi baboyise.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.39",
            "verseOrgIds": [
              "LEV.26.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 26:39"
          },
          "items": [
