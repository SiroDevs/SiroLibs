          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezi yizimiso lezahlulelo lemilayo iNkosi eyakwenzayo ngoMose phakathi kwayo labantu bakoIsrayeli entabeni yaseSinayi.",
          "type": "text",
          "attrs": {
