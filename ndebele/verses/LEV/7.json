          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokho kuyisabelo sikaAroni lesamadodana akhe esivela eminikelweni eyenzelwe iNkosi ngomlilo ebahlukaniselwe mhla belethwa eNkosini ukuba babe ngabapristi bayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yalaya ukuba abakoIsrayeli babanike lokhu ngosuku lokugcotshwa kwabo. Kuyisimiso esingelakuphela ezizukulwaneni zabo zonke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        }
      ]
    },
