              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowo ngumlayo weminikelo yokutshiswa, loweminikelo yempuphu, loweminikelo yesono, loweminikelo yecala, lowokwahlukaniselwa, lowomhlatshelo weminikelo yokuthula, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
