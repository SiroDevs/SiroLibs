  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "LEV 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanku umlayo womnikelo wecala. Ungcwele kakhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.1",
            "verseOrgIds": [
              "LEV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umnikelo wecala uzakuhlatshelwa endaweni lapho kuhlatshelwa khona umnikelo wokutshiswa, legazi lawo likhatshazelwe ealtareni inxa zonke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.2",
            "verseOrgIds": [
              "LEV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonke amahwahwa awo azanikelwa, umsila ononileyo, ledanga lemibilini, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.3",
            "verseOrgIds": [
              "LEV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "izinso zombili lamahwahwa azo angasezinkalweni, lamahwahwa angaphezu kwesibindi azakususwa lezinso; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.4",
            "verseOrgIds": [
              "LEV.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "umpristi akutshise ealtareni kube ngumnikelo owenzelwe iNkosi ngomlilo; kungumnikelo wecala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.5",
            "verseOrgIds": [
              "LEV.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abapristi besilisa bangawudla; kawudlelwe endaweni engcwele, ungcwele kakhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.6",
            "verseOrgIds": [
              "LEV.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umnikelo wecala ufanana lomnikelo wesono; umlayo wayo munye, ungowompristi owenza indlela yokubuyisana ngawo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.7",
            "verseOrgIds": [
              "LEV.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi onikela umnikelo wokutshiswa womuntu uzakuzithathela isikhumba somnikelo wokutshiswa anikele ngawo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.8",
            "verseOrgIds": [
              "LEV.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonke iminikelo yempuphu ephekwe eziko, layo yonke elungiswa embizeni loba emganwini wensimbi, izakuba ngeyompristi anikele ngayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.9",
            "verseOrgIds": [
              "LEV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Layo yonke iminikelo yempuphu evutshwe ngamafutha laleyo eyomileyo izakuba ngeyamadodana wonke kaAroni, enye indodana izuze njengenye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.10",
            "verseOrgIds": [
              "LEV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.10",
            "verseOrgIds": [
              "LEV.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanku umlayo womhlatshelo weminikelo yokuthula umuntu angayinikela eNkosini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.11",
            "verseOrgIds": [
              "LEV.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba ewunikela ube ngumnikelo wokubonga, kanikele kanye lomnikelo wokubonga amaqebelengwana angelamvubelo ahlanganiswe lamafutha, lezinkwa ezincinyane ezingelamvubelo ezigcotshwe ngamafutha, lamaqebelengwana empuphu ecolekileyo ixubene lamafutha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.12",
            "verseOrgIds": [
              "LEV.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umnikelo lo kanye lamaqebelengwana esinkwa esilemvubelo uzakukunikela lomhlatshelo weminikelo yokuthula. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.13",
            "verseOrgIds": [
              "LEV.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athathe kulowo lalowo umnikelo iqebelengwana libe linye, alinikele eNkosini; lizakuba ngelompristi okhaphaza igazi leminikelo yokuthula. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.14",
            "verseOrgIds": [
              "LEV.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyama yomhlatshelo weminikelo yakhe yokuthula ongowokubonga izakudliwa ngosuku lokunikela kwakhe, angatshiyi lutho kuze kube sekuseni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.15",
            "verseOrgIds": [
              "LEV.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.15",
            "verseOrgIds": [
              "LEV.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umhlatshelo womnikelo wakhe ungumnikelo wokugcwalisa isithembiso loba umnikelo wesihle, uzakudliwa ngosuku anikela ngalo ngomhlatshelo wakhe, okuseleyo kuwo kudliwe kusisa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.16",
            "verseOrgIds": [
              "LEV.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa okuseleyo enyameni yomhlatshelo ngosuku lwesithathu kuzatshiswa ngomlilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.17",
            "verseOrgIds": [
              "LEV.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba inyama yomhlatshelo weminikelo yakhe yokuthula idliwa ngosuku lwesithathu, kayiyikwamukeleka, kayiyikubalelwa kuye; izakuba yisinengiso, lomuntu oyidlayo uzakuthwala ububi bakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.18",
            "verseOrgIds": [
              "LEV.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyama ethinta into engcolileyo kayiyikudliwa, kodwa izakutshiswa ngomlilo. Bonke abahlambulukileyo bangadla inyama, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.19",
            "verseOrgIds": [
              "LEV.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa umuntu odla inyama yomhlatshelo weminikelo yokuthula eyeNkosi esengcolile, uzakukhutshwa ebantwini bakibo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.20",
            "verseOrgIds": [
              "LEV.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntu ethinta into engcolileyo, loba umuntu ongcolileyo, loba inyamazana engcolileyo, ingabe into engcolileyo eyisinengiso, abesesidla inyama yomhlatshelo weminikelo yokuthula eyeNkosi, lowo uzakukhutshwa ebantwini bakibo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.21",
            "verseOrgIds": [
              "LEV.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
