              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntu elala lomkamfowabo kayise, wambule ubunqunu bomfowabo kayise; bazathwala ububi babo, bafe bengelabantwana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.20",
            "verseOrgIds": [
              "LEV.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntu ethatha umkamfowabo, kuyikungcola; wambule ubunqunu bukamfowabo, ngakho kabayikuba lomntwana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.21",
            "verseOrgIds": [
