          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntu elala lowesifazana osemfuleni, ambule ubunqunu bakhe, unqunule umthombo wegazi lakhe, lowesifazana uzambule ubunqunu bakhe, bobabili kabakhutshwe ebantwini bakibo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.18",
            "verseOrgIds": [
              "LEV.20.18"
            ]
          }
        },
        {
