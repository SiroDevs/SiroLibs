            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntu ethatha udadewabo, indodakazi kayise loba ekanina, babonane ubunqunu bakhe, kulihlazo; kabakhutshwe emehlweni abakibo; wambule ubunqunu bukadadewabo, ngakho kathwale ububi bakhe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.17",
            "verseOrgIds": [
