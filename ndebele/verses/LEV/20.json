              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntu ethatha umfazi kanye lonina, lokhu kuyibubi. Kabatshiswe ngomlilo, yena labo, ukuba kungabi khona ububi phakathi kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.14",
            "verseOrgIds": [
