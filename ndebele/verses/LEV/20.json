            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntu elala lomalokazana, bobabili kababulawe; benzile ihlazo, bafanele ukufa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.12",
            "verseOrgIds": [
              "LEV.20.12"
            ]
          }
