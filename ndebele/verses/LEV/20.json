          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu olala lomkayise wambule ubunqunu bukayise; bobabili kababulawe, bafanele ukufa.",
          "type": "text",
          "attrs": {
