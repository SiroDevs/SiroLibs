            "style": "v",
            "sid": "LEV 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.26",
            "verseOrgIds": [
              "LEV.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntukazana esona, engoni ngabomu, esenza lokho iNkosi elaye ngakho ukuthi umuntu angakwenzi, abe lecala,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.27",
            "verseOrgIds": [
              "LEV.4.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.27+NUM.15.28"
              },
              "items": [
                {
                  "text": "Nani 15:27–28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.27",
            "verseOrgIds": [
              "LEV.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nxa esaziswa isono sakhe asenzileyo, uzaletha imbuzi, isibhuzikazi esingelasici, sibe ngumnikelo wakhe ngesono sakhe asenzileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.28",
            "verseOrgIds": [
              "LEV.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzabeka isandla sakhe enhlokweni yomnikelo wesono, awuhlabe endaweni yomnikelo wokutshiswa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.29",
            "verseOrgIds": [
              "LEV.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi athathe igazi lawo ngomunwe wakhe, alininde empondweni zealtare lomnikelo wokutshiswa, athululele lonke igazi lawo eliseleyo phansi kwealtare. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.30",
            "verseOrgIds": [
              "LEV.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
