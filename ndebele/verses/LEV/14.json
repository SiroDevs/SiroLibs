          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuba kwaziwe ukuthi kungcolile ingabe kuhlambulukile. Lowo ngumlayo omayelana lobulephero lokubola okunje.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.57",
