            "sid": "LEV 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "abulalela enye yezinyoni embizeni yebumba elamanzi amahle, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.50",
            "verseOrgIds": [
              "LEV.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "athathe umkusu ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.51",
            "verseOrgIds": [
              "LEV.14.51"
            ]
          }
        },
        {
          "text": " lelembu elibomvu, kanye lenyoni ephilayo, akucwilise egazini lenyoni ebuleweyo lasemanzini amahle, afafaze indlu kasikhombisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.51",
            "verseOrgIds": [
              "LEV.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokwenza njalo uzakuhlambulula indlu ngegazi lenyoni, langamanzi amahle, langenyoni ephilayo, langomkusu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.52",
            "verseOrgIds": [
              "LEV.14.52"
            ]
          }
        },
        {
          "text": " langelembu elibomvu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.52",
            "verseOrgIds": [
              "LEV.14.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 14:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayiyekele inyoni ephilayo ukuba iphume emzini, iye egangeni. Ngakhoke uzakuyenzela indlu indlela yokubuyisana, ihlambuluke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.53",
            "verseOrgIds": [
              "LEV.14.53"
            ]
          }
        }
      ]
