            "sid": "LEV 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.1",
            "verseOrgIds": [
              "LEV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lo uzakuba ngumlayo ngomuntu olobulephero ngosuku lokuhlanjululwa kwakhe. Kalethwe kumpristi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.2",
            "verseOrgIds": [
              "LEV.14.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.4"
              },
              "items": [
                {
                  "text": "Mat 8:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.44"
              },
              "items": [
                {
                  "text": "Mark 1:44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.14"
              },
              "items": [
                {
                  "text": "Luka 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.14"
              },
              "items": [
                {
                  "text": "17:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.2",
            "verseOrgIds": [
              "LEV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "umpristi aphume ezihonqweni, amhlole. Uba umuntu olobulephero esesilile esifweni sobulephero, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.3",
            "verseOrgIds": [
              "LEV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "umpristi alaye ukuba lowo ozahlanjululwa athathelwe inyoni ezimbili ezihlambulukileyo, lomkusu, lelembu elibomvu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.4",
            "verseOrgIds": [
              "LEV.14.4"
            ]
          }
        },
        {
          "text": "; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.4",
            "verseOrgIds": [
              "LEV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "umpristi alaye ukuba enye yezinyoni ihlatshelwe embizeni yebumba phezu kwamanzi agobhozayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.5",
            "verseOrgIds": [
              "LEV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzathatha inyoni ephilayo kanye lomkusu, lelembu elibomvu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.6",
            "verseOrgIds": [
              "LEV.14.6"
            ]
          }
        },
        {
          "text": ", akucwilise egazini lenyoni ehlatshelwe phezu kwamanzi agobhozayo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.6",
            "verseOrgIds": [
              "LEV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "amfafaze ngalo kasikhombisa lowo ozakuhlanjululwa esifweni sobulephero, atsho ukuthi usehlambulukile, ayekele inyoni ephilileyo ukuba izihambele egangeni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.7",
            "verseOrgIds": [
              "LEV.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowo ozakuhlanjululwa uzagezisa ingubo zakhe, aphuce zonke inwele zakhe, ageze ngamanzi, ahlambuluke; emva kwalokho uzabuyela ezihonqweni, kodwa ahlale ngaphandle kwethente lakhe insuku eziyisikhombisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.8",
            "verseOrgIds": [
              "LEV.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesikhombisa uzakuphuca zonke inwele zakhe, lendevu zakhe, lezintshiya zakhe, yebo, aphuce zonke inwele zakhe, agezise ingubo zakhe, ageze umzimba wakhe ngamanzi, ahlambuluke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesificaminwembili uzathatha amawundlu amaduna amabili angelasici, lewundlu elisikazi elilomnyaka munye elingelasici, lomnikelo wempuphu elingana lengxenye ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "text": " empuphu ecolekileyo ixubene lamafutha, lamagcobo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi ohlambulula lowomuntu ozakuhlanjululwa uzambeka kanye lalezizinto phambi kweNkosi, ngasemnyango wethente lokuhlangana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.11",
            "verseOrgIds": [
              "LEV.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi athathe elinye lamawundlu, anikele ngalo libe ngumnikelo wecala, kanye lamagcobo, akuzunguze kube ngumnikelo wokuzunguzwa phambi kweNkosi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.12",
            "verseOrgIds": [
              "LEV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahlabe iwundlu endaweni engcwele lapho kuhlatshelwa khona umnikelo wesono lomnikelo wokutshiswa; ngoba umnikelo wecala ungowompristi, njengomnikelo wesono, ungcwele kakhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.13",
            "verseOrgIds": [
              "LEV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi kathathe igazi lomnikelo wecala, alininde oqwangeni lwendlebe yokunene yalowo ozakuhlanjululwa, lesithupheni sesandla sakhe sokunene, lasezwaneni elikhulu lonyawo lwakhe lokunene; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.14",
            "verseOrgIds": [
              "LEV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "athathe amagcobo, athele amanye esandleni sakhe sokhohlo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.15",
            "verseOrgIds": [
              "LEV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "acwilise umunwe wakhe wokunene kuwo, afafaze ngawo kasikhombisa phambi kweNkosi ngomunwe wakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.16",
            "verseOrgIds": [
              "LEV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athathe kuwo amagcobo aseleyo asesandleni sakhe, awaninde oqwangeni lwendlebe yalowo ozakuhlanjululwa, lesithupheni sesandla sakhe sokunene, lasezwaneni elikhulu lonyawo lwakhe lokunene, phezu kwegazi lomnikelo wecala; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.17",
            "verseOrgIds": [
              "LEV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "lamagcobo aseleyo asesandleni sakhe kawabeke ekhanda lalowo ozakuhlanjululwa. Ngalokho umpristi uzakumenzela indlela yokubuyisana phambi kweNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.18",
            "verseOrgIds": [
              "LEV.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi kanikele ngomnikelo wesono ukuba amenzele indlela yokubuyisana lowo ozakuhlanjululwa ekungcoleni kwakhe, andubana ahlabe umnikelo wokutshiswa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.19",
            "verseOrgIds": [
              "LEV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "anikele umnikelo wokutshiswa lomnikelo wempuphu ealtareni. Ngalokho umpristi uzamenzela indlela yokubuyisana, ahlambuluke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwake uba engumyanga, esahluleka ukuletha lokho, kathathe iwundlu eliduna libe ngumnikelo wecala ozazunguzwa ukuba amenzelwe indlela yokubuyisana, kanye lengxenye ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.21",
            "verseOrgIds": [
              "LEV.14.21"
            ]
          }
        },
        {
          "text": " lempuphu ecolekileyo ixubene lamafutha kube ngumnikelo wempuphu, lamagcobo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.21",
            "verseOrgIds": [
              "LEV.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "lamajuba amabili loba inkwilimba ezimbili, loba yilokho alakho, okunye kube ngumnikelo wesono lokunye kube ngumnikelo wokutshiswa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.22",
            "verseOrgIds": [
              "LEV.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesificaminwembili kakulethe kumpristi, emnyango wethente lokuhlangana, phambi kweNkosi, ukuba ahlanjululwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.23",
            "verseOrgIds": [
              "LEV.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi kathathe iwundlu elomnikelo wecala, lamagcobo, akuzunguze kube ngumnikelo wokuzunguzwa phambi kweNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.24",
            "verseOrgIds": [
              "LEV.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahlabe iwundlu elomnikelo wecala, athathe igazi lomnikelo wecala, alininde oqwangeni lwendlebe yokunene yalowo ozahlanjululwa, lesithupheni sesandla sakhe sokunene, lasezwaneni elikhulu lonyawo lwakhe lokunene; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.25",
            "verseOrgIds": [
              "LEV.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "athele amagcobo esandleni sakhe sokhohlo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.26",
            "verseOrgIds": [
              "LEV.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "afafaze ngawo kasikhombisa phambi kweNkosi ngomunwe wakhe wokunene, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.27",
            "verseOrgIds": [
              "LEV.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "athatha kuwo amagcobo asesandleni sakhe, awaninde oqwangeni lwendlebe yokunene yalowo ozahlanjululwa, lesithupheni sesandla sakhe sokunene, lasezwaneni elikhulu lonyawo lwakhe lokunene, ezindaweni lapho kunindwe khona igazi lomnikelo wecala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.28",
            "verseOrgIds": [
              "LEV.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagcobo aseleyo asesandleni sakhe umpristi awabeke ekhanda lalowo ozahlanjululwa, amenzele indlela yokubuyisana phambi kweNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.29",
            "verseOrgIds": [
              "LEV.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakunikela ngamajuba amabili loba ngenkwilimba ezimbili, loba yilokho alakho, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.30",
            "verseOrgIds": [
              "LEV.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "okunye kube ngumnikelo wesono lokunye kube ngumnikelo wokutshiswa, kanye lomnikelo wempuphu. Umpristi uzamenzela ohlanjululwayo indlela yokubuyisana phambi kweNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.31",
            "verseOrgIds": [
              "LEV.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowo ngumlayo ngaye olesifo sobulephero, owehluleka ukuletha iminikelo ukuba ahlambuluke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
