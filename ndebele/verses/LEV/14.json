          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuba indlu ihlambuluke, uzakuthatha inyoni ezimbili ezincinyane, lomkusu, lelembu elibomvu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.49",
            "verseOrgIds": [
              "LEV.14.49"
            ]
          }
        },
        {
          "text": ", ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.49",
            "verseOrgIds": [
              "LEV.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
