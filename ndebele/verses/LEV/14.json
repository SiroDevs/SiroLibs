          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lo ngumlayo omayelana lezinhlobo zonke zobulephero, langoqweqwe olulumayo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.54",
            "verseOrgIds": [
              "LEV.14.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
