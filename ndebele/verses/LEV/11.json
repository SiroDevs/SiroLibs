          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuba kwehlukaniswe okungcolileyo lokuhlambulukileyo, lezidalwa eziphilayo ezidliwayo lezidalwa eziphilayo ezingadliwayo.",
          "type": "text",
