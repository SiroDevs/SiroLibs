          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowo ngumlayo omayelana lezinyamazana, lezinyoni, lezidalwa zonke eziphilayo ezihamba emanzini lezihamba emhlabathini, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
