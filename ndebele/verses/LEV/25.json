            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.12+DEU.15.13+DEU.15.14+DEU.15.15+DEU.15.16+DEU.15.17+DEU.15.18"
              },
              "items": [
                {
                  "text": "Dute 15:12–18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uba umfowenu olawe esehlelwa yibuyanga, azithengise kuwe, ungamphathi njengesigqili; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.39",
            "verseOrgIds": [
              "LEV.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "uzakuba njengoqatshiweyo lonjengowemizi, akusebenzele kuze kufike umnyaka ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.40",
            "verseOrgIds": [
              "LEV.25.40"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.40",
            "verseOrgIds": [
              "LEV.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’khona uzasukake kuwe, yena labantwana bakhe, abuyele ekhaya lakhe, elifeni labokhokho bakhe. — ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.41",
            "verseOrgIds": [
              "LEV.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba bayizinceku zami engabakhupha elizweni laseGibithe; kabayikuthengiswa babe yizigqili — ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.42",
            "verseOrgIds": [
              "LEV.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungamphathi nzima kodwa wesabe uNkulunkulu wakho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.43",
            "verseOrgIds": [
              "LEV.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izigqili zakho lezigqilikazi zakho uzakuzithenga ezizweni ezikuzingelezeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.44",
            "verseOrgIds": [
              "LEV.25.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ungazithenga kwabemzini abahlala lawe, lakubantwana babo abazalelwa elizweni lakini, babe ngabakho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.45",
            "verseOrgIds": [
              "LEV.25.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungabanika abantwana bakho emva kwakho babe yilifa labo kuze kube nininini; bona ungabenza babe yizigqili. Kodwa phakathi kwabakoIsrayeli, abantu abakini, kakungabi khona umuntu ozakuphatha nzima omunye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.46",
            "verseOrgIds": [
              "LEV.25.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.46",
            "verseOrgIds": [
              "LEV.25.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 25:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba owezizweni loba owemzini ohlala lawe enothile, umfowenu olaye abe ngumyanga, azithengise kowemzini loba kowezizweni ohlala lawe, ingabe kowakibo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.47",
            "verseOrgIds": [
              "LEV.25.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 25:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "angahlengwa nxa esethengisiwe; mhlawumbe omunye wabafowabo angamhlenga, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.48",
            "verseOrgIds": [
              "LEV.25.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 25:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "loba umalumakhe, loba umzawakhe, ingabe oyisihlobo sakhe esomuzi wakhe angamhlenga; uba enotha, angazihlenga yena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.49",
            "verseOrgIds": [
              "LEV.25.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 25:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakubalisana lowamthengayo, kusukela emnyakeni owazithengisa kuye kuze kufike umnyaka ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.50",
            "verseOrgIds": [
              "LEV.25.50"
            ]
          }
        },
        {
          "text": "; imali yentengiso izakulingana lenani leminyaka, lesikhathi sokusebenza kwakhe sibalwe njengesikhathi soqatshiweyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.50",
            "verseOrgIds": [
              "LEV.25.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 25:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba kusasele iminyaka eminengi, enanini layo uzakunika imali yokuhlengwa kwakhe, ayikhuphe emalini amthenga ngayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.51",
            "verseOrgIds": [
              "LEV.25.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 25:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba kusasele iminyaka emilutshwana kuze kufike umnyaka ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.52",
            "verseOrgIds": [
              "LEV.25.52"
            ]
          }
        },
        {
          "text": ", uzakubalisana laye, anike imali yokuhlengwa kwakhe njengenani laliminyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.52",
            "verseOrgIds": [
              "LEV.25.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 25:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakuba ngaphansi kwakhe njengoqatshiweyo iminyaka ngeminyaka; kayikumphatha nzima emehlweni akho. ",
