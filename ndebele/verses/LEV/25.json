          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "NgiyiNkosi uNkulunkulu wakho owakukhupha elizweni laseGibithe ukukunika ilizwe laseKanani, ngibe nguNkulunkulu wakho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        }
      ]
