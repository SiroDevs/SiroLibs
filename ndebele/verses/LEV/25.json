          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umfowenu ohlala lawe engumyanga, esehluleka ukuzithwala, wena uzakumthwala, ahlale lawe njengowemzini lanjengowezizweni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.35",
            "verseOrgIds": [
              "LEV.25.35"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
