      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAL 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yamabandla ithi: Khangelani, ngiyasithuma isithunywa sami ukulungisa indlela phambi kwami. INkosi eliyidingayo izafika masinyane ethempelini layo; isithunywa sesivumelwano elithokoza ngaso siyeza.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.1",
            "verseOrgIds": [
              "MAL.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
