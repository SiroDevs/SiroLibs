                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.22+DEU.14.23+DEU.14.24+DEU.14.25+DEU.14.26+DEU.14.27+DEU.14.28+DEU.14.29"
              },
              "items": [
                {
                  "text": "14:22–29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.12"
              },
              "items": [
                {
                  "text": "Neh 13:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.10",
            "verseOrgIds": [
              "MAL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizalikhuzela izibungu, ukuze zingadli izithelo zomhlabathi wenu; lamavini enu emasimini kawayikuphutha ukuthela, kutsho iNkosi yamabandla. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.11",
            "verseOrgIds": [
              "MAL.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke izizwe zizakuthi libusisiwe, ngoba lizakuba yilizwe elithokozisayo, kutsho iNkosi yamabandla.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.12",
            "verseOrgIds": [
              "MAL.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.12",
            "verseOrgIds": [
              "MAL.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazwi enu abelukhuni ngami, kutsho iNkosi. Kanti lina lithi: Sikhulume sathini ngawe na? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.13",
            "verseOrgIds": [
              "MAL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lithe lina: Kakusizi lutho ukukhonza uNkulunkulu. Kusizani ukugcina imilayo yakhe lokuba sihambe phambi kweNkosi yamabandla njengabakhalayo na? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.14",
            "verseOrgIds": [
              "MAL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khathesike sithi abaziphakamisayo babusisiwe; abenza okubi yibo abaphumelelayo; lalapho bemlinga uNkulunkulu bayayekelwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.15",
            "verseOrgIds": [
              "MAL.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.15",
            "verseOrgIds": [
              "MAL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebekhulumisana labo abayesabayo iNkosi; iNkosi yabalalela, yabezwa. Incwadi yesikhumbuzo yalotshwa phambi kwayo ngabo abayesabayo iNkosi, labahlonipha ibizo layo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.16",
            "verseOrgIds": [
              "MAL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazakuba ngabami, kutsho iNkosi yamabandla, babe yimpahla yami ngosuku lokwenza kwami, ngizabayekela njengalokhu umuntu eyekela indodana emsebenzelayo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.17",
            "verseOrgIds": [
              "MAL.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAL 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beselibuya lisahlukanisa phakathi kwabalungileyo lababi, laphakathi komuntu omkhonzayo uNkulunkulu longamkhonziyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.18",
            "verseOrgIds": [
              "MAL.3.18"
            ]
          }
        }
      ]
    }
