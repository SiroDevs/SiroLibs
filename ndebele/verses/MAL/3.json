                "loc": "MAT.11.10"
              },
              "items": [
                {
                  "text": "Mat 11:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.2"
              },
              "items": [
                {
                  "text": "Mark 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.76"
              },
              "items": [
                {
                  "text": "Luka 1:76",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.7.27"
              },
              "items": [
                {
                  "text": "7:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.1",
            "verseOrgIds": [
              "MAL.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngubani ongalumela usuku lokufika kwaso, longema ekubonakaleni kwaso na? Ngoba sinjengomlilo wompheki wensimbi, lanjengesepa yomgezisi.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.2",
            "verseOrgIds": [
              "MAL.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.17"
              },
              "items": [
                {
                  "text": "Isam 6:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.2",
            "verseOrgIds": [
              "MAL.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sizahlala esihlalweni saso sincibilikise sihlambulule isiliva, sihlambulule amadodana kaLevi, siwancibilikise njengegolide lanjengesiliva, aze anikele iminikelo efaneleyo eNkosini. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.3",
            "verseOrgIds": [
              "MAL.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’khona iminikelo yakoJuda leyaseJerusalema izakuyithokozisa iNkosi njengasensukwini zasendulo laseminyakeni yakuqala. INkosi yamabandla ithi: ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.4",
            "verseOrgIds": [
              "MAL.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Besengifika kini ukulithonisisa; ngizakuba ngufakazi okhutheleyo mayelana lezangoma, lezifebe, lokufungela amanga, lokucindezela abaqatshiweyo ngamaholo abo, lokucindezela abafelwakazi, lezintandane, lalabo abasunduzela eceleni abezizweni, bengangesabi mina.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.5",
            "verseOrgIds": [
              "MAL.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.5",
            "verseOrgIds": [
              "MAL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba mina Nkosi kangiphenduki; ngalokho lani madodana kaJakobe kalikaqedwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.6",
            "verseOrgIds": [
              "MAL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusukela ensukwini zabokhokho benu liphambukile ezimisweni zami, kalizigcinanga. Buyani kimi, lami ngizabuyela kini, kutsho iNkosi yamabandla. Kanti lina lithi: Sizabuya kanjani na? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.7",
            "verseOrgIds": [
              "MAL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu angamphanga uNkulunkulu na? Lina liyangiphanga. Kodwa lina lithi: Sikuphanga kanjani na? Ngithi: Ngokwetshumi kwenu langeminikelo yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.8",
            "verseOrgIds": [
              "MAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liqalekisiwe ngesiqalekiso, isizwe sonke siqalekisiwe, ngoba liyangiphanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.9",
            "verseOrgIds": [
              "MAL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lethani konke okwetshumi endlini yenotho ukuba kube khona ukudla endlini yami. Lingihlole ngalokho, kutsho iNkosi yamabandla, libone ukuba kangiyikulivulela iminyango yaphezulu, ngilehlisele izibusiso ezinengi na?",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.10",
            "verseOrgIds": [
              "MAL.3.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.30"
              },
              "items": [
                {
                  "text": "Levi 27:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21+NUM.18.22+NUM.18.23+NUM.18.24"
              },
              "items": [
                {
                  "text": "Nani 18:21–24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
