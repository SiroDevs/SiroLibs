          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAL 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khathesike nanku owenu umlayo, bapristi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.1",
            "verseOrgIds": [
              "MAL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba lingalaleli, uba lingananzi ukulidumisa ibizo lami, kutsho iNkosi yamabandla, ngizalithumela isiqalekiso, ngiphendule izibusiso zenu zibe yiziqalekiso. Yebo, sengisenza njalo, ngoba kalinanzi ukwenza lokho. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.2",
            "verseOrgIds": [
              "MAL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakhalimela inzalo yenu, ngilithele ngomswane ebusweni, umswane weminikelo yenu, ngilixotshe ebusweni bami. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.3",
            "verseOrgIds": [
              "MAL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho lizakwazi ukuba ngithumele lumlayo kini, ukuba isivumelwano sami loLevi sime, kutsho iNkosi yamabandla.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.4",
            "verseOrgIds": [
              "MAL.2.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.11+NUM.3.12+NUM.3.13"
              },
              "items": [
                {
                  "text": "Nani 3:11–13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.4",
            "verseOrgIds": [
              "MAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isivumelwano sami laye sasingesokuphila lokuthula, ngamnika khona ukuba esabe; wangesaba, walesaba lebizo lami.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.5",
            "verseOrgIds": [
              "MAL.2.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.12"
              },
              "items": [
                {
                  "text": "Nani 25:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.5",
            "verseOrgIds": [
              "MAL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukufundisa kwakhe kwakuliqiniso, ububi bungafunyaniswa ekufundiseni kwakhe. Wahamba lami ngokuthula langobuqotho, waphendula abanengi ebubini. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.6",
            "verseOrgIds": [
              "MAL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba umpristi umele agcine ukwazi okuqotho, labantu bamele badinge ukufundiswa kuye, ngoba uyisithunywa seNkosi yamabandla. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.7",
            "verseOrgIds": [
              "MAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lina bapristi, liphambukile endleleni, lakhubekisa abanengi ngokufundisa kwenu; lasona isivumelwano sikaLevi, kutsho iNkosi yamabandla. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.8",
            "verseOrgIds": [
              "MAL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke mina ngilenzile laba ngabadelelekayo labehliselwe phansi phambi kwabantu bonke, ngoba lingagcinanga indlela zami, kodwa libandlulule abantu ekufundiseni kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.9",
            "verseOrgIds": [
              "MAL.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.9",
            "verseOrgIds": [
              "MAL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasilaye ubaba munye thina sonke na? Kasidalwanga nguNkulunkulu munye na? Phoke, kungani sikhohlisana, sisona isivumelwano uNkulunkulu asenze labokhokho na? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.10",
            "verseOrgIds": [
              "MAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJuda ukhohlisile, kwenziwe amanyala koIsrayeli laseJerusalema; ngoba uJuda uyonile indawo engcwele ethandwa yiNkosi ngokuthatha indodakazi ekhonza unkulunkulu wezizweni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.11",
            "verseOrgIds": [
              "MAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungathi iNkosi ingakhupha emathenteni kaJakobe umuntu owenza lokhu, loba owakhileyo khona, loba engowezizwe, lanxa eletha umnikelo eNkosini yamabandla.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.12",
            "verseOrgIds": [
              "MAL.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.12",
            "verseOrgIds": [
              "MAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lalokhu futhi liyakwenza. Lithela ialtare leNkosi ngenyembezi, likhale, libubule, ngoba ingasawunanzi umnikelo, ungasamukeleki kuyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.13",
            "verseOrgIds": [
              "MAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liyabuza lithi: Kungani na? Kungoba iNkosi eyayingufakazi wesivumelwano sakho lomfazi wobutsha bakho iyakwazi ukuthi umkhohlisile wena, lanxa ebengumngane wakho lomfazi wakho wesivumelwano. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.14",
            "verseOrgIds": [
              "MAL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu kenzanga umuntu abe lenyama lomoya wokuphila na? UNkulunkulu ufunani kulokhu na? Ufuna ukuba umuntu azale abantwana abanikwe nguNkulunkulu. Ziqapheliseni ukuba omunye lomunye wenu angamkhohlisi umfazi wobutsha bakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.15",
            "verseOrgIds": [
              "MAL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakuzonda ukwahlukana, kutsho iNkosi uNkulunkulu kaIsrayeli. Ngiyazonda futhi ukuba umuntu abe lesihluku esinje kumkakhe, kutsho iNkosi yamabandla. Ngakhoke ziqapheliseni ukuba lingakhohlisi.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.16",
            "verseOrgIds": [
              "MAL.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.16",
            "verseOrgIds": [
              "MAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liyidinisile iNkosi ngamazwi enu. Kanti lithi: Siyidinise kanjani na? Liyidinise ngokuthi: Bonke abenza okubi balungile eNkosini, bayayithokozisa; loba lithi: Ungaphi uNkulunkulu wokwahlulela na?",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.17",
            "verseOrgIds": [
              "MAL.2.17"
            ]
          }
        }
      ]
    }
  ],
