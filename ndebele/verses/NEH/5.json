                "loc": "DEU.23.19"
              },
              "items": [
                {
                  "text": "Dute 23:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.7",
            "verseOrgIds": [
              "NEH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngathi kibo: Thina ngamandla esilawo sibahlengile abakithi abaJuda ababethengiswe kwezinye izizwe; kodwa lina selithengisa abakini, lizabuya libathenge lina uqobo na? Bathula bathi zwi, ngoba bengelakho abangakutsho. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.8",
            "verseOrgIds": [
              "NEH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengisithi: Into eliyenzayo kayilunganga. Kufanele ukuba lihambe ngokumesaba uNkulunkulu wethu ukuze liqede ukukloloda kwezizwe eziyizitha zethu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.9",
            "verseOrgIds": [
              "NEH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina uqobo lezihlobo zami kanye lezinceku zami besikade sinika abantu imali lamabele. Asiyekeleni ukwethwesa abantu ubunzima lobo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.10",
            "verseOrgIds": [
              "NEH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babuyiseleni abantu lamhlanje amasimu abo, lezivini zabo, lezihlahla zabo ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.11",
            "verseOrgIds": [
              "NEH.5.11"
            ]
          }
        },
        {
          "text": ", lezindlu zabo, liyekele lokuthatha inzuzo yemali leyamabele leyewayini leyamafutha ebeliyizuza kubo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.11",
            "verseOrgIds": [
              "NEH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebesithi: Sizabuyisela konke lokhu, singabizi lutho kubo. Sizakwenza njengokutsho kwakho. Ngasengibiza abapristi ngabafungisa labo ababesenza lokho ukuba benze njengokuthembisa kwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.12",
            "verseOrgIds": [
              "NEH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengithintitha ingubo yami ngisithi: Ngokunjalo uNkulunkulu kathintithe bonke abantu ezindlini zabo lasemisebenzini yabo abangasenziyo lesisithembiso. Bathintithwe ngokunjalo, bachithwe. Lonke ibandla lathi: Kakube njalo. Bayidumisa iNkosi; benza njengokuthembisa kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi eminyakeni elitshumi lambili ngingumbusi wakoJuda kusukela emnyakeni wamatshumi amabili wokubusa kukaAtakisekisi, kuze kube semnyakeni wamatshumi amathathu lambili, kasizanga sidle mina labakithi ukudla okuyisabelo sombusi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.14",
            "verseOrgIds": [
              "NEH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababusi ababengaphambi kwami babathwalisa nzima abantu, bethatha kibo ukudla kwensuku ngensuku lewayini okulingana ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.15",
            "verseOrgIds": [
              "NEH.5.15"
            ]
          }
        },
        {
          "text": " esiliva angamatshumi amane. Lezinceku zabo zabaphatha kalukhuni abantu. Kodwa mina kangikwenzanga lokho ngenxa yokwesaba uNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.15",
            "verseOrgIds": [
              "NEH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi nganikela wonke amandla ami emsebenzini wokwakha lumduli, kangaze ngazizuzela umhlaba; labantu bami bonke babuthana lapho emsebenzini. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.16",
            "verseOrgIds": [
              "NEH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganginika ukudla abantu abalikhulu lamatshumi amahlanu ababengabaJuda lezinduna, nginika lalabo ababevela ezizweni esakhelene lazo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.17",
            "verseOrgIds": [
              "NEH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Insuku ngensuku ngangihlaba inkabi eyodwa lezimvu ezinonileyo eziyisithupha, lezinkukhu ezinengi; langemva kwazo zonke insuku ezilitshumi ngiletha lemigodla yewayini elinengi. Phezu kwakho konke lokhu kangizanga ngibize isabelo sokudla kombusi, ngoba abantu bathi kimi kunzima. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.18",
            "verseOrgIds": [
              "NEH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akungikhumbule ngokuhle, Nkulunkulu wami, ngakho konke lokhu engikwenzele lababantu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.19",
            "verseOrgIds": [
              "NEH.5.19"
            ]
          }
        }
      ]
    }
  ],
