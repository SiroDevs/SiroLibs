        "number": "8",
        "style": "c",
        "sid": "NEH 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abantu babuthana njengomuntu munye egcekeni eliphambi kweSango laManzi; bacela uEzra umbhali ukuletha ugwalo lomlayo kaMose iNkosi eyayiwunike uIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.1",
            "verseOrgIds": [
              "NEH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UEzra umpristi wawuletha umlayo phambi kwebandla labesilisa labesifazana, labantwana bonke ababelamandla okuqedisisa. Kwakulusuku lokuqala lwenyanga yesikhombisa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.2",
            "verseOrgIds": [
              "NEH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabala ekhangelene legceke elaliphambi kweSango laManzi kusukela ekuseni kwaze kwaba semini, phambi kwabesilisa labesifazana, labantwana bonke abalamandla okuqedisisa; abantu bawulalela umlayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.3",
            "verseOrgIds": [
              "NEH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "UEzra umbhali wayemi phezu kwethala ababelenzile. Kwakumi eceleni kwakhe oMathithiya loShema loAnaya loUriya loHilikiya loMahaseya ngakwesokunene; oPedaya loMishayeli loMalikiya loHashuma loHashibadana loZekariya loMeshulamu bengakwesokhohlo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.4",
            "verseOrgIds": [
              "NEH.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "UEzra waluvula ugwalo phambi kwabo bonke abantu, wayemi ngaphezu kwabo bonke; nxa eluvula, bonke basukuma. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.5",
            "verseOrgIds": [
              "NEH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "UEzra wayibonga iNkosi, uNkulunkulu omkhulu. Bonke abantu baphakamisa izandla zabo bathi: Kakube njalo, kakube njalo. Bakhothama, bayikhonza iNkosi bethe mbo ngobuso phansi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "OJeshuwa loBani loSherebiya loJamini loAkubi loShabethayi loHodiya loMahaseya loKelita loAzariya loJozabadi loHanani loPelaya ababengamaLevi bachasisela abantu umlayo, abantu besendaweni zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.7",
            "verseOrgIds": [
              "NEH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babala ogwalweni lomlayo kaNkulunkulu ngokucacileyo, bechasisela abantu ukuba bawuzwisise.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.8",
            "verseOrgIds": [
              "NEH.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.8",
            "verseOrgIds": [
              "NEH.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNehemiya owayengumbusi, loEzra umpristi lombhali, lamaLevi ayefundisa abantu, bathi ebantwini bonke: Lolu lusuku olungcwele eNkosini uNkulunkulu wenu; lingalili likhale. Ngoba bonke abantu bakhala lapho besizwa amazwi omlayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.9",
            "verseOrgIds": [
              "NEH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UEzra wasesithi kibo: Hambani kuhle, lidle inyama enonileyo, linathe iwayini elimnandi, labelane labo izabelo bonke abangelalutho; ngoba lolusuku lungcwele eNkosini yethu, kungabi khona ukudana, ngoba ukuthokoza ngeNkosi kungamandla enu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.10",
            "verseOrgIds": [
              "NEH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaLevi asebathulisa bonke abantu esithi: Thulani, ngoba lolusuku lungcwele, lingadani. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.11",
            "verseOrgIds": [
              "NEH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abantu basebehamba, badla banatha, babelana labanye, bathokoza kakhulu, ngoba babewazwile kuhle amazwi ayekhulunywe kibo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.12",
            "verseOrgIds": [
              "NEH.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.12",
            "verseOrgIds": [
              "NEH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesibili inhloko zezindlu zabo bonke abantu kanye labapristi lamaLevi babuthana kuEzra umbhali ukuba bafunde amazwi omlayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.13",
            "verseOrgIds": [
              "NEH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafumanisa kulotshiwe emlayweni ukuthi iNkosi yayilayile ngoMose ukuba abantu bakoIsrayeli bahlale emadumbeni ngesikhathi somkhosi ngenyanga yesikhombisa,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
