                "loc": "DEU.16.13+DEU.16.14+DEU.16.15"
              },
              "items": [
                {
                  "text": "Dute 16:13–15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "lokuba bamemezele kuzwakale kuyo yonke imizi yabo laseJerusalema bathi: Yanini ezintabeni liyegamula ingatsha zezihlahla ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        },
        {
          "text": ", lezamaphane, lezomtshekisane, lezamalala lezezinye izihlahla ezilamahlamvu amanengi ukuba lakhe amadumba, njengokulotshiweyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebehambake abantu, babuya lazo, bazakhela amadumba, ilowo lalowo ophahleni lwendlu yakhe, lasemagumeni abo, lasegumeni lendlu kaNkulunkulu, lasegcekeni eliseSangweni laManzi leliseSangweni lakoEfrayimi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.16",
            "verseOrgIds": [
              "NEH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lonke ibandla lalabo ababebuyile ekuthunjweni bakha amadumba, bahlala kiwo. Ngoba kusukela ensukwini zikaJoshuwa indodana kaNuni kwaze kwaba yilolosuku abakoIsrayeli babengakwenzanga lokho. Bathokoza kakhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.17",
            "verseOrgIds": [
              "NEH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Insuku zonke kusukela osukwini lokuqala kwaze kwaba ngolokucina kwabalwa ugwalo lomlayo kaNkulunkulu. Bawugcina umkhosi insuku eziyisikhombisa; kwathi ngosuku lwesificaminwembili kwaba khona inkonzo yokucina, njengokumiswa komthetho.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.18",
            "verseOrgIds": [
              "NEH.8.18"
            ]
          }
        }
      ]
    }
  ],
