          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thina oPawuli, loSilivanu, loTimothi, sithi kulo ibandla labaseTesalonika elikuNkulunkulu uBaba laseNkosini uJesu Kristu: Kakube kini umusa lokuthula.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
