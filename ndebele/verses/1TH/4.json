  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1TH 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elokucinake, bazalwane, siyalincenga, sililaya ngeNkosi uJesu ukuba njengalokhu lakufunda kithi ukuthi lifanele ukuhamba lokumthokozisa kanjani uNkulunkulu, njengalokho lihamba ngokunjalo, kwenzenike lokhu kakhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.1",
            "verseOrgIds": [
              "1TH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba liyayazi imilayo esalinika yona ngayo iNkosi uJesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.2",
            "verseOrgIds": [
              "1TH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intando kaNkulunkulu yikuba libe ngcwele, lizithinte ekuphingeni; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.3",
            "verseOrgIds": [
              "1TH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilowo lalowo wenu kakwazi ukuphatha umzimba wakhe ngobungcwele langokuhlonipha. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.4",
            "verseOrgIds": [
              "1TH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingabuswa yinkanuko njengabangakholwayo abangamaziyo uNkulunkulu; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.5",
            "verseOrgIds": [
              "1TH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kakungabi khona loyedwa owonayo, aphambe umfowabo ngolutho, ngoba iNkosi ingumphindiseli kukho konke lokho, njengoba salitshela, saqinisa ngaphambili. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.6",
            "verseOrgIds": [
              "1TH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uNkulunkulu kasibizelanga emanyaleni, kodwa wasibizela ebungcweleni. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.7",
            "verseOrgIds": [
              "1TH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke lowo odelela lokhu kadeleli muntu, kodwa udelela uNkulunkulu olinika uMoya wakhe oNgcwele.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.8",
            "verseOrgIds": [
              "1TH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.8",
            "verseOrgIds": [
              "1TH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayelana lothando lobuzalwane kalidingi ukuba ngililobele, ngoba lina uqobo lifundisiwe nguNkulunkulu ukuba lithandane. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.9",
            "verseOrgIds": [
              "1TH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lempela liyakwenza lokhu, liyabathanda bonke abazalwane abaseMakedoniya lonke. Kodwa siyalilaya, bazalwane, ukuba likwenze lokhu kakhulu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.10",
            "verseOrgIds": [
              "1TH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "likhuthalele ukuhlala ngokuthula, ngokwenza okwenu, lisebenze ngezandla zenu, njengoba salilaya, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.11",
            "verseOrgIds": [
              "1TH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze lizuze ukuhlonitshwa ngabangaphandle, lingasweli lutho.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.12",
            "verseOrgIds": [
              "1TH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.12",
            "verseOrgIds": [
              "1TH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasithandi, bazalwane, ukuba lingabi lakwazi ngalabo asebefile, ukuze lingadabuki njengabanye abangelalo ithemba. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.13",
            "verseOrgIds": [
              "1TH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uba sikholwa ukuthi uJesu wafa, wabuya wavuka, ngokunjaloke uNkulunkulu uzakubavusa ngaye uJesu labo asebefile. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.14",
            "verseOrgIds": [
              "1TH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba lokhu sikutsho kini ngelizwi leNkosi ukuthi thina, esisekhona esitshiywe kuze kube sekufikeni kweNkosi, kasiyikubandulela isibili labo asebafa;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.15",
            "verseOrgIds": [
              "1TH.4.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.51"
              },
              "items": [
                {
                  "text": "1 Kor 15:51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.52"
              },
              "items": [
                {
                  "text": "52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.15",
            "verseOrgIds": [
              "1TH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba iNkosi uqobo izakwehla ivela ezulwini ngomdumo, ngokumemeza kwesithunywa, langokukhala kophondo lukaNkulunkulu; labafileyo kuKristu bazakuvuka kuqala; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.16",
            "verseOrgIds": [
              "1TH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "thinake esisekhona sisasele sizakuhluthunelwa kanye labo emayezini, sihlangabeza iNkosi emoyeni; sihlale layo kokuphela. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.17",
            "verseOrgIds": [
              "1TH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke duduzanane ngalamazwi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.18",
            "verseOrgIds": [
              "1TH.4.18"
            ]
          }
        }
      ]
    }
