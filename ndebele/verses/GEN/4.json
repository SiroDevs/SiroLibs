            "number": "24",
            "style": "v",
            "sid": "GEN 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.24",
            "verseOrgIds": [
              "GEN.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAdamu waphinda wangena lomkakhe engutsheni; wazala indodana wayitha ibizo wathi nguSeti; ngoba wathi: UNkulunkulu usenginikile enye inzalo esikhundleni sikaAbela, ngoba uKayini wambulala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.25",
            "verseOrgIds": [
              "GEN.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laye uSeti wazala indodana, wayitha ibizo wathi nguEnosi. Ngalesosikhathi abantu basebeqala ukukhuleka ebizweni leNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.26",
            "verseOrgIds": [
              "GEN.4.26"
            ]
          }
        }
      ]
    }
