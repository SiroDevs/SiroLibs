          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi sebethulula amasaka abo, bafumanisa isikhwama semali salowo lalowo sisesakeni lakhe. Lapho bona loyise bebona izikhwama zabo zemali, batshaywa luvalo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.35",
            "verseOrgIds": [
              "GEN.42.35"
            ]
          }
        },
        {
