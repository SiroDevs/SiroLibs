          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "URubeni wasekhuluma kuyise esithi: Bulala amadodana ami womabili uba ngingambuyisi kuwe uBenjamini; mnikele esandleni sami, ngizambuyisa kuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.37",
            "verseOrgIds": [
              "GEN.42.37"
            ]
          }
        },
        {
