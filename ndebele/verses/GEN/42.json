          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJakobe uyise wathi kubo: Liyangamuka abantwana bami; uJosefa kasekho loSimeyoni kasekho, lakhathesi selizakuthatha uBenjamini; konke lokhu kwehlela phezu kwami. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.36",
            "verseOrgIds": [
              "GEN.42.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
