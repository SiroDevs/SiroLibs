            "sid": "GEN 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbrama wasuka eGibithe kanye lomkakhe lakho konke ayelakho loLoti, waya eNegebi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.1",
            "verseOrgIds": [
              "GEN.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.1",
            "verseOrgIds": [
              "GEN.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbrama wayenothile kakhulu ngezinkomo langesiliva langegolide. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.2",
            "verseOrgIds": [
              "GEN.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahamba esuka eNegebi, waze wafika eBetheli, endaweni lapho lalikhona ithente lakhe kuqala phakathi kweBetheli leAyi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.3",
            "verseOrgIds": [
              "GEN.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "endaweni lapho lalikhona ialtare abelenzile kuqala; uAbrama wadumisa ibizo leNkosi lapho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.4",
            "verseOrgIds": [
              "GEN.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laye uLoti owayehamba loAbrama wayelezimvu lezinkomo lamathente. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.5",
            "verseOrgIds": [
              "GEN.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilizwe lalingelakubanela ukuba bahlale ndawonye, ngoba impahla yabo yayinengi, behluleka ukuhlala ndawonye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.6",
            "verseOrgIds": [
              "GEN.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaba khona ukuxabana phakathi kwabelusi bezinkomo zikaAbrama labelusi benkomo zikaLoti. Ngalesosikhathi amaKanani lamaPerizi ayehlala elizweni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.7",
            "verseOrgIds": [
              "GEN.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.7",
            "verseOrgIds": [
              "GEN.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbrama wasesithi kuLoti: Kakungabi khona ukuxabana phakathi kwami lawe, laphakathi kwabelusi bami labelusi bakho, ngoba singabazalwane. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.8",
            "verseOrgIds": [
              "GEN.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilizwe lonke kalisobala phambi kwakho na? Yahlukana lami; uba usiya ngakwesokhohlo, ngizakuya ngakwesokunene; kodwa uba usiya ngakwesokunene, ngizakuya ngakwesokhohlo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.9",
            "verseOrgIds": [
              "GEN.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ULoti wasephakamisa amehlo akhe, wabona ukuthi lonke igceke laseJordani lalilamanzi, iNkosi ingakachithi iSodoma leGomora; lalinjengensimu yeNkosi lanjengelizwe laseGibithe kuze kufike eZowari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.10",
            "verseOrgIds": [
              "GEN.13.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.10"
              },
              "items": [
                {
                  "text": "Gen 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.10",
            "verseOrgIds": [
              "GEN.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ULoti wasekhetha lonke igceke laseJordani, waya ngasempumalanga; behlukana omunye lomunye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.11",
            "verseOrgIds": [
              "GEN.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbrama wahlala elizweni laseKanani, uLoti wahlala emizini yasemagcekeni, wamisa ithente lakhe ngaseSodoma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.12",
            "verseOrgIds": [
              "GEN.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baseSodoma babebabi, besona kakhulu phambi kweNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.13",
            "verseOrgIds": [
              "GEN.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.13",
            "verseOrgIds": [
              "GEN.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuAbrama lapho uLoti esehlukene laye: Phakamisa amehlo akho lapho umi khona, ukhangele ngasenyakatho langaseningizimu langasempumalanga langasentshonalanga, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.14",
            "verseOrgIds": [
              "GEN.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba ilizwe lonke olibonayo ngizakukunika lona, ngilinike lenzalo yakho kuze kube nininini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.15",
            "verseOrgIds": [
              "GEN.13.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.5"
              },
              "items": [
                {
                  "text": "Seb 7:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.15",
            "verseOrgIds": [
              "GEN.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakuyenza inzalo yakho ibe ngangothuli lomhlaba, kuze kuthi uba umuntu engabala uthuli lomhlaba, izakubalwa lenzalo yakho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.16",
            "verseOrgIds": [
              "GEN.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suka udabule ilizwe, ubude balo lobubanzi balo, ngoba ngizakukunika lona. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.17",
            "verseOrgIds": [
              "GEN.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbrama wasukake wayakwakha eduze lezihlahla ezinkulu eziseMamre eliseHebroni, wakhela iNkosi khona ialtare.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.18",
            "verseOrgIds": [
              "GEN.13.18"
            ]
          }
        }
      ]
    }
  ],
