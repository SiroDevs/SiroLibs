              "type": "text"
            }
          ]
        },
        {
          "text": "UAdamu wahlala iminyaka elikhulu lamatshumi amathathu; wasezala indodana efana laye, wayitha ibizo wathi nguSeti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
              "GEN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kokuzalwa kukaSeti uAdamu wahlala iminyaka engamakhulu aficaminwembili; wazala amadodana lamadodakazi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAdamu wahlala iminyaka engamakhulu aficamunwemunye lamatshumi amathathu, wasesifa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.5",
            "verseOrgIds": [
              "GEN.5.5"
