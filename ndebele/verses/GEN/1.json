          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wasesithi: Umhlaba kawuveze inhlobo zonke zezidalwa eziphilayo, izifuyo, lokuhuquzelayo, lezinyamazana zomhlaba ngenhlobo zazo; kwaba njalo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.24",
