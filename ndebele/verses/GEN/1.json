            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekuqaleni uNkulunkulu wadala izulu lomhlaba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.1",
            "verseOrgIds": [
              "GEN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umhlaba wawungelasimo, wawungelalutho; kwakukhona umnyama phezu kwamanzi, kodwa umoya kaNkulunkulu wayehambahamba phezu kwamanzi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.2",
            "verseOrgIds": [
              "GEN.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.2",
            "verseOrgIds": [
              "GEN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wasesithi: Kakube khona ukukhanya; kwaba khona ukukhanya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.3",
            "verseOrgIds": [
              "GEN.1.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.6"
              },
              "items": [
                {
                  "text": "2 Kor 4:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.3",
            "verseOrgIds": [
              "GEN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wabona ukuthi ukukhanya kuhle; wahlukanisa ukukhanya lomnyama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.4",
            "verseOrgIds": [
              "GEN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wakubiza ukukhanya ngokuthi yimini, lomnyama wawubiza ngokuthi yibusuku. Kwaba khona ukuhlwa lokusa, kwaba lusuku lokuqala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.5",
            "verseOrgIds": [
              "GEN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.5",
            "verseOrgIds": [
              "GEN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wasesithi: Kakube khona umkhathi phakathi kwamanzi, wahlukanise amanzi lamanzi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.6",
            "verseOrgIds": [
              "GEN.1.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.5"
              },
              "items": [
                {
                  "text": "2 Pet 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.6",
            "verseOrgIds": [
              "GEN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wenza umkhathi, wahlukanisa amanzi angaphansi komkhathi lamanzi aphezu komkhathi; kwaba njalo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.7",
            "verseOrgIds": [
              "GEN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wasebiza umkhathi ngokuthi lizulu. Kwaba khona ukuhlwa lokusa, kwaba lusuku lwesibili.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.8",
            "verseOrgIds": [
              "GEN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
