        },
        {
          "text": "UNkulunkulu wababusisa, wathi kibo: Zalani lande, ligcwalise umhlaba liwunqobe, libuse phezu kwenhlanzi zolwandle, lenyoni zaphezulu, lakho konke okuphilayo okuhamba emhlabeni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.28",
            "verseOrgIds": [
              "GEN.1.28"
            ]
          }
        },
        {
          "name": "verse",
