          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke inyamazana zomhlaba lenyoni zonke zaphezulu lakho konke okuhuquzela emhlabeni okuphilayo, nginika zona yonke imibhida eluhlaza ukuba ibe yikudla; kwaba njalo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.30",
            "verseOrgIds": [
              "GEN.1.30"
            ]
          }
