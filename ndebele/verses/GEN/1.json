          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wasesithi: Khangelani, ngilinika yonke imibhida ethela inhlanyelo esemhlabeni wonke, lezihlahla zonke ezilezithelo eziveza inhlanyelo, ukuba kube yikudla kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.29",
            "verseOrgIds": [
              "GEN.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
