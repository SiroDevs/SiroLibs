              "GEN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wasesithi: Kakube khona emkhathini wezulu izikhanyiso ezahlukanisa imini lobusuku, zibe yizibonakaliso zezibanga, lezensuku lezeminyaka, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.14",
            "verseOrgIds": [
              "GEN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "zibe yizikhanyiso emkhathini wezulu ukuba zikhanyise emhlabeni; kwaba njalo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.15",
            "verseOrgIds": [
              "GEN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wenza izikhanyiso ezimbili ezinkulu, isikhanyiso esikhulu ukuba sibuse imini, lesikhanyiso esincinyane ukuba sibuse ubusuku; wenza lezinkanyezi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.16",
            "verseOrgIds": [
              "GEN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wazimisa emkhathini wezulu ukuba zikhanyise emhlabeni, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.17",
            "verseOrgIds": [
              "GEN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "lokuba zibuse imini lobusuku, zahlukanise ukukhanya lomnyama. UNkulunkulu wabona ukuthi kulungile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.18",
            "verseOrgIds": [
              "GEN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaba khona ukuhlwa lokusa, kwaba lusuku lwesine.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.19",
            "verseOrgIds": [
              "GEN.1.19"
            ]
          }
        }
      ]
    },
