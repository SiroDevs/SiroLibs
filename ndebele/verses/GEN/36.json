          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHushama wafa, loHadadi indodana kaBedadi owanqoba amaMidiyani emagcekeni aseMowabi waba yinkosi esikhundleni sakhe; ibizo lomuzi wakhe laliyiAvithi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.35",
            "verseOrgIds": [
              "GEN.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
