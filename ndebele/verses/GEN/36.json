          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "La ngamakhosi ayebusa elizweni lakoEdoma, abantu bakoIsrayeli bengakabuswa yinkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.31",
            "verseOrgIds": [
