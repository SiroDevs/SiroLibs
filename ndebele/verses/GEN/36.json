          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "UBali‐Hanani indodana kaAkibori wafa, loHadari waba yinkosi esikhundleni sakhe; ibizo lomuzi wakhe laliyiPawu; ibizo lomkakhe lalinguMehetabeli indodakazi kaMatiredi indodakazi kaMezahabi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.39",
            "verseOrgIds": [
              "GEN.36.39"
            ]
          }
