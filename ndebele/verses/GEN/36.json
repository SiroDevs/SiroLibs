          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "loDishoni loEzeri loDishani; lezo yizinduna ezadakuba kuwo amaHori, izinduna ngezinduna elizweni laseSeyiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.30",
            "verseOrgIds": [
