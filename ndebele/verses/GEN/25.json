          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJakobe wathi: Ngithengisela lamuhla ilungelo lobuzibulo bakho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.31",
            "verseOrgIds": [
