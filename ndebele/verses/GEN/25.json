              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "UEsawu wathi: Khangela, sengizakufa; ubuzibulo buzakungisiza njani na? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.32",
            "verseOrgIds": [
              "GEN.25.32"
            ]
