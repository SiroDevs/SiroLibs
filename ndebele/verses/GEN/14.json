          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uAbrama esebuyile ekunqobeni uKedolawoma lamakhosi ayelaye, yaphuma inkosi yaseSodoma ukumhlangabeza esigodini saseShave esiyisigodi senkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.17",
            "verseOrgIds": [
              "GEN.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMelkizedeki inkosi yaseSalema lompristi kaNkulunkulu oPhezukonke waletha isinkwa lewayini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.18",
            "verseOrgIds": [
              "GEN.14.18"
            ]
          }
        },
