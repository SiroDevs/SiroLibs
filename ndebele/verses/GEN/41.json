  "verseCount": 57,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "GEN 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi emva kweminyaka emibili waphupha uFaro; wazibona emi ngasemfuleni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.1",
            "verseOrgIds": [
              "GEN.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakhuphuka emfuleni amankomokazi ayisikhombisa, abukekayo anonileyo; adla emihlangeni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.2",
            "verseOrgIds": [
              "GEN.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakhuphuka emfuleni amanye amankomokazi ayisikhombisa emva kwawo, ekhangeleka kubi, ecakile; ema kwamanye amankomokazi okhunjini lomfula. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.3",
            "verseOrgIds": [
              "GEN.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawo akhangeleka kubi acakileyo adla abukekayo anonileyo. UFaro wasephaphama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.4",
            "verseOrgIds": [
              "GEN.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walala ubuthongo futhi, waphupha ngokwesibili; khangela, kwakhahlela izikhwebu eziyisikhombisa ohlangeni lunye, ezipheleleyo zilungile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.5",
            "verseOrgIds": [
              "GEN.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakhahlela emva kwazo izikhwebu eziyisikhombisa ezincinyane, zihangulwe ngumoya wasempumalanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.6",
            "verseOrgIds": [
              "GEN.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izikhwebu ezincinyane zaginya izikhwebu ezipheleleyo ezilungileyo. UFaro wasephaphama, wabona ukuthi kwakuliphupho nje. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.7",
            "verseOrgIds": [
              "GEN.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ekuseni umoya wakhe wakhathazeka; wabiza izangoma zonke zaseGibithe lazo zonke izazi. Wazilandisela iphupho lakhe; kodwa kwakungekho muntu owayengamchasisela lona.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.8",
            "verseOrgIds": [
              "GEN.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.8",
            "verseOrgIds": [
              "GEN.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Induna yabaphathizitsha yasikhuluma loFaro yathi: Khathesi ngiyawakhumbula amacala ami. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.9",
            "verseOrgIds": [
              "GEN.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uFaro esezithukuthelele inceku zakhe, wangifaka endlini yenduna yabalindi ukuba ngilondolozwe khona, mina lenduna yabaphekizinkwa; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.10",
            "verseOrgIds": [
              "GEN.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "saphupha amaphupho ngabusuku bunye, mina layo. Saphupha, ilowo lalowo waphupha iphupho elilencazelo ezehlukeneyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.11",
            "verseOrgIds": [
              "GEN.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona kanye lathi insizwa engumHeberu, inceku yenduna yabalindi; sayilandisela amaphupho ethu, yasichasisela wona; kwaba yilowo lalowo ngokwephupho lakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.12",
            "verseOrgIds": [
              "GEN.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenzakala njengokusichasisela kwayo; mina inkosi yangibuyisela esikhundleni sami, yena yamphanyeka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.13",
            "verseOrgIds": [
              "GEN.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.13",
            "verseOrgIds": [
              "GEN.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "UFaro wasembiza uJosefa; bamkhupha entolongweni ngokuphangisa; esephucile wafaka ezinye izigqoko, wangena kuFaro. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.14",
            "verseOrgIds": [
              "GEN.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UFaro wathi kuJosefa: Ngiphuphile iphupho, kakho ongalichasisa; ngizwile ngawe ukuthi nxa ulandiselwa iphupho, ungalichasisa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.15",
            "verseOrgIds": [
              "GEN.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa wamphendula uFaro wathi: Kakukho emandleni ami lokho. UNkulunkulu uzamphendula kuhle uFaro. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.16",
            "verseOrgIds": [
              "GEN.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "UFaro wathi kuJosefa: Ephupheni lami ngangimi okhunjini lomfula; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.17",
            "verseOrgIds": [
              "GEN.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "khangela, kwakukhuphuka emfuleni amankomokazi ayisikhombisa, anonileyo abukekayo, adla emihlangeni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.18",
            "verseOrgIds": [
              "GEN.41.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakhuphuka amanye amankomokazi ayisikhombisa emva kwawo, amabi, acakileyo; angizanga ngiwabone amabi njengawo kulo lonke ilizwe laseGibithe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.19",
            "verseOrgIds": [
              "GEN.41.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 41:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi amankomokazi akhangeleka kubi adla amankomokazi ayisikhombisa okuqala anonileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.20",
            "verseOrgIds": [
              "GEN.41.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho esewadlile kakubonakalanga ukuthi awadlile, ngoba ayelokhu ekhangeleka kubi njengakuqala. Ngasengiphaphama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.21",
            "verseOrgIds": [
              "GEN.41.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 41:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngabona kwelinye iphupho lami izikhwebu eziyisikhombisa zikhahlela ohlangeni lunye, ziphelele zilungile; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.22",
            "verseOrgIds": [
              "GEN.41.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 41:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwasekukhahlela emva kwazo izikhwebu eziyisikhombisa ezitshwabheneyo, zizincinyane, zihangulwe ngumoya wasempumalanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.23",
            "verseOrgIds": [
              "GEN.41.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izikhwebu ezincinyane zaginya izikhwebu eziyisikhombisa ezilungileyo. Ngakulandisela izanuse lokhu; kodwa kwakungekho sanuse esasingangichasisela khona.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.24",
            "verseOrgIds": [
              "GEN.41.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.24",
            "verseOrgIds": [
              "GEN.41.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa wasesithi kuFaro: Amaphupho kaFaro ayafanana. Lokho uNkulunkulu asezakukwenza, umazisile khona uFaro. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.25",
            "verseOrgIds": [
              "GEN.41.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amankomokazi ayisikhombisa alungileyo ayiminyaka eyisikhombisa; lezikhwebu eziyisikhombisa ezilungileyo ziyiminyaka eyisikhombisa. Amaphupho ayafanana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.26",
            "verseOrgIds": [
              "GEN.41.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 41:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amankomokazi acakileyo akhangeleka kubi akhuphuka emva kwawo ayiminyaka eyisikhombisa; izikhwebu eziyisikhombisa ezincinyane ezihangulwe ngumoya wasempumalanga ziyiminyaka eyisikhombisa yendlala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.27",
            "verseOrgIds": [
              "GEN.41.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 41:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyikho lokhu engikutshiloyo kuFaro ukuthi lokho uNkulunkulu asezakukwenza, ukubonakalisile kuFaro. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.28",
            "verseOrgIds": [
              "GEN.41.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 41:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzakuba khona iminyaka eyisikhombisa yenala enkulu kulo lonke ilizwe laseGibithe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.29",
            "verseOrgIds": [
              "GEN.41.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 41:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwayo kuzakuba khona iminyaka eyisikhombisa yendlala; izakhohlakala inala yonke elizweni laseGibithe; indlala izaliqeda ilizwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.30",
            "verseOrgIds": [
              "GEN.41.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 41:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inala kayiyikukhunjulwa elizweni ngenxa yendlala elandelayo, ngoba izakuba nzima kakhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.31",
            "verseOrgIds": [
              "GEN.41.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 41:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuba iphupho liphindwe kabili kuFaro kungoba lokhu kumisiwe nguNkulunkulu, futhi uNkulunkulu uzakukwenza masinyane. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.32",
            "verseOrgIds": [
              "GEN.41.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 41:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke uFaro kadinge umuntu oqaphelisayo lohlakaniphileyo, ambeke ukuba aphathe ilizwe laseGibithe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.33",
            "verseOrgIds": [
              "GEN.41.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 41:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "UFaro kenze nje, abeke ababonisi baphathe ilizwe; balondoloze okwesihlanu kwezithelo zelizwe laseGibithe eminyakeni eyisikhombisa yenala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.34",
            "verseOrgIds": [
              "GEN.41.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 41:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babuthe konke ukudla kwaliminyaka elungileyo ezayo, babuthele amabele okudla emizini ngokulaya kukaFaro, bawagcine. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.35",
            "verseOrgIds": [
              "GEN.41.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 41:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukudla lokhu kuzakubekelwa ilizwe ngenxa yeminyaka eyisikhombisa yendlala ezakuba khona elizweni laseGibithe, ukuba ilizwe lingabhujiswa yindlala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.36",
            "verseOrgIds": [
              "GEN.41.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 41:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.36",
            "verseOrgIds": [
              "GEN.41.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 41:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokhu kwaba kuhle kuFaro lasezincekwini zakhe zonke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.37",
            "verseOrgIds": [
              "GEN.41.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 41:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "UFaro wasesithi ezincekwini zakhe: Singamthola yini onjengaye, umuntu okukuye umoya kaNkulunkulu na? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.38",
            "verseOrgIds": [
              "GEN.41.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 41:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "UFaro wathi kuJosefa: Njengalokhu uNkulunkulu ekutshengisile lokhu konke, kakho oqaphelisayo lohlakaniphileyo njengawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.39",
            "verseOrgIds": [
              "GEN.41.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 41:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena uzaphatha indlu yami, bonke abantu bami bazabuswa ngelizwi lakho; mina ngizakuba mkhulu kulawe esihlalweni sobukhosi kuphela.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.40",
            "verseOrgIds": [
              "GEN.41.40"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.10"
              },
              "items": [
                {
                  "text": "Seb 7:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.40",
            "verseOrgIds": [
              "GEN.41.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 41:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "UFaro wathi futhi kuJosefa: Khangela, sengikubekile ukuphatha lonke ilizwe laseGibithe: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.41",
            "verseOrgIds": [
              "GEN.41.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 41:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "UFaro wakhupha indandatho yakhe esandleni sakhe, wayifaka esandleni sikaJosefa, wamambathisa izigqoko zelembu elihle, wamgaxa iketane legolide. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.42",
            "verseOrgIds": [
              "GEN.41.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 41:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamkhwelisa enqoleni yakhe yesibili; bahamba phambi kwakhe bememeza besithi: Mkhothameleni! Wambeka ukuba aphathe lonke ilizwe laseGibithe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.43",
            "verseOrgIds": [
              "GEN.41.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 41:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "UFaro wathi kuJosefa: NginguFaro; ngaphandle kwelizwi lakho kakho umuntu ozakuphakamisa isandla sakhe loba unyawo lwakhe elizweni lonke laseGibithe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.44",
            "verseOrgIds": [
              "GEN.41.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 41:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "UFaro wamutha ibizo uJosefa elokuthi nguZafenathi‐Paneya. Wamnika uAsenathi, indodakazi kaPotifera umpristi waseOni, ukuba abe ngumkakhe. UJosefa waphuma, walihamba ilizwe lonke laseGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.45",
            "verseOrgIds": [
              "GEN.41.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 41:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.45",
            "verseOrgIds": [
              "GEN.41.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 41:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa wayeleminyaka engamatshumi amathathu mhla esima phambi kukaFaro inkosi yaseGibithe. UJosefa waphuma kuFaro, wadabula ilizwe lonke laseGibithe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.46",
            "verseOrgIds": [
              "GEN.41.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "GEN 41:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eminyakeni eyisikhombisa yenala umhlaba wathela kakhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.47",
            "verseOrgIds": [
              "GEN.41.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "GEN 41:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waqoqa konke ukudla kweminyaka leyo eyisikhombisa elizweni laseGibithe, wakubuthela emizini; ukudla kwamasimu azingelezele lowo lalowo umuzi wakubuthela kuwo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.48",
            "verseOrgIds": [
              "GEN.41.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 41:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa wabutha amabele aba ngangetshebetshebe lolwandle, aba manengi kakhulu waze wayekela ukulinganisa, ngoba engasalinganiseki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.49",
            "verseOrgIds": [
              "GEN.41.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 41:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.49",
            "verseOrgIds": [
              "GEN.41.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "GEN 41:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa wazala amadodana amabili ungakafiki umnyaka wendlala, ewazala kuAsenathi indodakazi kaPotifera umpristi waseOni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.50",
            "verseOrgIds": [
              "GEN.41.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "GEN 41:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa waqamba ibizo lezibulo wathi nguManase, wathi: Ngoba uNkulunkulu ungenze ukuba ngikhohlwe konke ukuhlupheka kwami lendlu yami yonke kababa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.51",
            "verseOrgIds": [
              "GEN.41.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 41:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabiza ibizo leyesibili wathi nguEfrayimi, wathi: Ngoba uNkulunkulu ungenze ukuba ngizale elizweni lokuhlupheka kwami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.52",
            "verseOrgIds": [
              "GEN.41.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 41:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.52",
            "verseOrgIds": [
              "GEN.41.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "GEN 41:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekuphela iminyaka eyisikhombisa yenala eyayiselizweni laseGibithe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.53",
            "verseOrgIds": [
              "GEN.41.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "GEN 41:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekuqala ukufika iminyaka eyisikhombisa yendlala, njengokutsho kukaJosefa. Kwaba khona indlala emazweni wonke, kodwa elizweni laseGibithe kwakukhona ukudla.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.54",
            "verseOrgIds": [
              "GEN.41.54"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.11"
              },
              "items": [
                {
                  "text": "Seb 7:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.54",
            "verseOrgIds": [
              "GEN.41.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "GEN 41:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ilizwe lonke laseGibithe selilamba, abantu bakhala ngokudla kuFaro. UFaro wathi kiwo wonke amaGibithe: Yanini kuJosefa, lenze lokho azalitshela khona.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.55",
            "verseOrgIds": [
              "GEN.41.55"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.5"
              },
              "items": [
                {
                  "text": "Joha 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.55",
            "verseOrgIds": [
              "GEN.41.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "GEN 41:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke kwathi sekulendlala emhlabeni wonke, uJosefa wasevula zonke iziphala, wathengisela amaGibithe amabele; indlala yayinkulu elizweni laseGibithe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.56",
            "verseOrgIds": [
              "GEN.41.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "GEN 41:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonke amazwe ayefika kuJosefa eGibithe ukuzathenga amabele, ngoba indlala yayinkulu emhlabeni wonke.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.57",
            "verseOrgIds": [
              "GEN.41.57"
            ]
          }
        }
      ]
    }
