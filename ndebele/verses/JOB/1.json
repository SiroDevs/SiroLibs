          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.19",
            "verseOrgIds": [
              "JOB.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJobe wasesuka edabula ingubo yakhe, waphuca ikhanda lakhe, wawa phansi, wakhuleka; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.20",
            "verseOrgIds": [
              "JOB.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
