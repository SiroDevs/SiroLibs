              "HEB.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokukhuluma ngesivumelwano esitsha wenza esokuqala sibe ngesigugileyo; osekugugile sekukudala sekuzakunyamalala.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.13",
