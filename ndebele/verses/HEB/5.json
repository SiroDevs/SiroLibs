        },
        {
          "text": "Ngoba ilowo lalowo umpristi omkhulu okhethwa ebantwini umiselwa abantu ezintweni zikaNkulunkulu, ukuze anikele izipho lemihlatshelo ngenxa yezono; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.1",
            "verseOrgIds": [
              "HEB.5.1"
            ]
          }
        },
        {
