              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngenxa yalokhu kufanele ukuba, njengalokhu enikelela izono zabantu, anikelele lezakhe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.3",
