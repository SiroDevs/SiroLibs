            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba ngingakhuluma ngendimi zabantu lezezithunywa, kodwa uba ngingelalo uthando, ngiyisigubhu esikhalayo lensimbi encencethayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.1",
            "verseOrgIds": [
              "1CO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba ngingaba lamandla okutshumayela, ngiqedisisa imfihlakalo zonke lokwazi konke, loba ngingaba lokukholwa konke kokuba ngisuse intaba, kodwa uba ngingelalo uthando, kangisilutho.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.2",
            "verseOrgIds": [
              "1CO.13.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
