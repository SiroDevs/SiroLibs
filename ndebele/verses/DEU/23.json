          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingeboleka owezizweni ngomvuzo, kodwa lingeboleki umfowenu ngomvuzo, ukuba iNkosi uNkulunkulu wenu ilibusise kukho konke elizakukwenza elizweni elingena kulo ukulithumba.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.20"
            ]
          }
        }
