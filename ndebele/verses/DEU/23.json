          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingasibuyiseli kumniniso isigqili esibalekele kini; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.15",
            "verseOrgIds": [
              "DEU.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "sizakuhlala phakathi kwenu, endaweni esiyikhethayo, komunye wemizi yenu lapho sithanda khona; lingasixotshi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.16",
            "verseOrgIds": [
              "DEU.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
