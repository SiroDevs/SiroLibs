          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa usuku lwesikhombisa luliSabatha leNkosi uNkulunkulu wakho; ungasebenzi ngalo wena lendodana yakho lendodakazi yakho lenceku yakho lencekukazi yakho lenkabi yakho lobabhemi wakho lezinkomo zakho, lowemzini osemzini wakho, ukuba inceku lencekukazi zakho ziphumule njengawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "verse",
