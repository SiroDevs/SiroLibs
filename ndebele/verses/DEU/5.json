          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungalisebenzisi ngeze ibizo leNkosi uNkulunkulu wakho; ngoba olisebenzisa ngeze ibizo layo uzakuba lecala eNkosini.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
