        {
          "text": "Ungazenzeli izithombe ezibaziweyo lomfanekiso walokho okusezulwini lalokho okusemhlabeni lalokho okusemanzini angaphansi komhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.8",
