              "items": [
                {
                  "text": "Eks 23:14–19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.1",
            "verseOrgIds": [
              "DEU.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lizakuthatha ezimvini zenu loba ezinkomeni zenu, linikele umhlatshelo wePhasika eNkosini uNkulunkulu wenu endaweni iNkosi ezakuyikhetha ukuba idunyiselwe kiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.2",
            "verseOrgIds": [
              "DEU.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingadli isinkwa esilemvubelo kanye lomhlatshelo wePhasika; insuku eziyisikhombisa lizawudla kanye lesinkwa esingelamvubelo, isinkwa senhlupheko — ngoba laphuma eGibithe ngokuphangisa. — Ngalokhu lizakulukhumbula usuku lokuphuma kwenu eGibithe zonke insuku zokuhamba kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.3",
            "verseOrgIds": [
              "DEU.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakungabonwa mvubelo kulo lonke ilizwe lenu insuku eziyisikhombisa; futhi inyama eliyihlaba ngosuku lokuqala kusihlwa kayingalali ubusuku bonke kuze kuse. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.4",
            "verseOrgIds": [
              "DEU.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingawunikeli umhlatshelo wePhasika emizini yenu elinika yona iNkosi uNkulunkulu wenu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.5",
            "verseOrgIds": [
              "DEU.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa kuphela endaweni iNkosi uNkulunkulu wenu ezakuyikhetha ukuba idunyiselwe kiyo. Nikelani khona umhlatshelo wePhasika ekutshoneni kwelanga, ngesikhathi elaphuma ngaso eGibithe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.6",
            "verseOrgIds": [
              "DEU.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lizakuwupheka, lilidlele iPhasika endaweni iNkosi uNkulunkulu wenu ezakuyikhetha; ekuseni lizabuyela emathenteni enu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.7",
            "verseOrgIds": [
              "DEU.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Insuku eziyisithupha lizakudla isinkwa esingelamvubelo; ngosuku lwesikhombisa kube lenkonzo yokucina eNkosini uNkulunkulu wenu; lingasebenzi ngalo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.8",
            "verseOrgIds": [
              "DEU.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalibobala amaviki aba yisikhombisa, liwabale kusukela esikhathini eliqala ngaso ukuvuna amabele.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.15+LEV.23.16+LEV.23.17+LEV.23.18+LEV.23.19+LEV.23.20+LEV.23.21"
              },
              "items": [
                {
                  "text": "Levi 23:15–21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.26+NUM.28.27+NUM.28.28+NUM.28.29+NUM.28.30+NUM.28.31"
              },
              "items": [
                {
                  "text": "Nani 28:26–31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’khona lizakuyigcinela iNkosi uNkulunkulu wenu umkhosi wamaviki ngokupha umnikelo wesihle ngezandla zenu, liwunike njengokubusiswa kwenu yiNkosi uNkulunkulu wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endaweni iNkosi ezakuyikhetha ukuba lidunyiselwe kiyo lizakuthokoza phambi kwayo lina lamadodana enu lamadodakazi enu, lenceku zenu lencekukazi zenu, lomLevi ohlala emizini yenu, lowezizweni, lentandane, lomfelwakazi, abahlala kini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khumbulani ukuthi laliyizigqili eGibithe, ligcine kuhle lezizimiso.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
