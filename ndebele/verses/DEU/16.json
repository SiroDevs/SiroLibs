          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gcinani inyanga kaAbibi, liyidumise iNkosi, uNkulunkulu wenu, ngokugcina iPhasika, ngoba ngenyanga kaAbibi iNkosi uNkulunkulu wenu yalikhupha eGibithe ebusuku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.1",
            "verseOrgIds": [
              "DEU.16.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
