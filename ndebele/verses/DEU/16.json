          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nxwanelani ukulunga kuphela, ukuba lisile, lithumbe ilizwe elinika lona iNkosi uNkulunkulu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.20",
            "verseOrgIds": [
              "DEU.16.20"
            ]
