  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "DEU 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho zonke izinto lezi sezehlele phezu kwenu, isibusiso lesiqalekiso engizibekileyo phambi kwenu, lizikhumbule phakathi kwezizwe zonke lapho iNkosi uNkulunkulu wenu elixotshele khona, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.1",
            "verseOrgIds": [
              "DEU.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "lizabuyela eNkosini uNkulunkulu wenu lina labantwana benu, lilalele ilizwi layo ngenhliziyo yenu yonke langomphefumulo wenu wonke, kukho konke engililaya khona lamuhla. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi uNkulunkulu wenu izalihawukela, ibuyise abathunjiweyo benu, ilibuthe futhi ebantwini lapho iNkosi uNkulunkulu wenu elihlakazele khona. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba bekhona abakini abaxotshelwe emikhawulweni yomhlaba, lalapho iNkosi uNkulunkulu wenu izakulibutha, ilithathe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.4",
            "verseOrgIds": [
              "DEU.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilibuyisele elizweni okhokho benu abalithumba ukuba libe ngelenu, liphumelele, lande kakhulu kulabokhokho benu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.5",
            "verseOrgIds": [
              "DEU.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi uNkulunkulu wenu izakuhlambulula inhliziyo zenu lenhliziyo zenzalo yenu, ukuba liyithande iNkosi uNkulunkulu wenu ngenhliziyo yenu yonke langomphefumulo wenu wonke ukuze liphile. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.6",
            "verseOrgIds": [
              "DEU.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi uNkulunkulu wenu izakwehlisela zonke iziqalekiso lezi phezu kwezitha zenu labafo benu ababelizingela. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.7",
            "verseOrgIds": [
              "DEU.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lizabuya lilalele ilizwi leNkosi, ligcine yonke imilayo yayo engililaya yona lamuhla. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.8",
            "verseOrgIds": [
              "DEU.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi izakuliphumelelisa kakhulu emisebenzini yonke yezandla zenu, enzalweni yezisu zenu, lenzalweni yenkomo zenu, lezithelweni zomhlaba wenu; ngoba iNkosi izakuthaba futhi ngokuliphumelelisa, njengalokhu yayithaba ngokhokho benu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "uba lilalela ilizwi leNkosi uNkulunkulu wenu, ligcine imilayo yayo lezimiso zayo ezilotshwe kulolugwalo lomlayo, liphendukela eNkosini uNkulunkulu wenu ngenhliziyo yenu yonke langomphefumulo wenu wonke.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba lumlayo engililaya wona lamuhla kawulukhuni kini, futhi kawukhatshana lani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.11",
            "verseOrgIds": [
              "DEU.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kawukho ezulwini ukuba lithi: Ngubani ozakusenyukela aye ezulwini, asilandele wona ukuba siwuzwe siwugcine na?",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.12",
            "verseOrgIds": [
              "DEU.30.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.6+ROM.10.7+ROM.10.8"
              },
              "items": [
                {
                  "text": "Roma 10:6–8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.12",
            "verseOrgIds": [
              "DEU.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi kawungaphetsheya kolwandle ukuba lithi: Ngubani ozakuwela ulwandle, asilandele wona ukuba siwuzwe siwugcine na? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.13",
            "verseOrgIds": [
              "DEU.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwake ilizwi liseduze lani, lisemilonyeni yenu lenhliziyweni zenu ukuba liligcine.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.14",
            "verseOrgIds": [
              "DEU.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.14",
            "verseOrgIds": [
              "DEU.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khangelani, ngibekile phambi kwenu lamhla ukuphila lokulunga, ukufa lobubi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.15",
            "verseOrgIds": [
              "DEU.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba lilalela imilayo yeNkosi uNkulunkulu wenu engililaya yona lamuhla, liyithande iNkosi uNkulunkulu wenu, lihambe endleleni zayo, ligcine imilayo yayo lezimiso zayo lezahlulelo zayo, lizakuphila lande; iNkosi uNkulunkulu wenu izalibusisa elizweni elingena kulo ukulithumba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.16",
            "verseOrgIds": [
              "DEU.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba inhliziyo zenu ziphenduka lingalaleli, liduhiswe, lidumise abanye onkulunkulu, libakhonze, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.17",
            "verseOrgIds": [
              "DEU.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngiyalitshela lamhla ukuthi lizakubhubha; kaliyikuhlala isikhathi eside elizweni elizangena kulo ukulithumba selichaphile iJordani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.18",
            "verseOrgIds": [
              "DEU.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamuhla ngiyabiza izulu lomhlaba ukufakaza ngani ukuthi ngibekile phambi kwenu ukuphila lokufa, isibusiso lesiqalekiso. Ngakhoke khethani ukuphila ukuba liphile lina lenzalo yenu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.19",
            "verseOrgIds": [
              "DEU.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "liyithande iNkosi uNkulunkulu wenu, lilalele ilizwi layo, libambelele kuyo; ngoba lokho kuzakulilethela ukuphila lokwanda kwensuku zenu ukuze lihlale elizweni iNkosi eyafunga kubokhokho benu oAbrahama loIsaka loJakobe ukubanika lona.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.20",
            "verseOrgIds": [
              "DEU.30.20"
            ]
          }
        },
