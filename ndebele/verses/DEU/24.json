                "loc": "EXO.21.16"
              },
              "items": [
                {
                  "text": "Eks 21:16",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
