          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.14",
            "verseOrgIds": [
              "DEU.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnike iholo lakhe insuku ngensuku, ilanga lingakatshoni, ngoba engumyanga, uyaliswela; uba ungenzi njalo, yena uzakhala eNkosini ngawe, kube yisono sakho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        }
      ]
    },
