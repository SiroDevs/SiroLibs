              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyise kabayikubulawa ngenxa yabantwana, labantwana kabayikubulawa ngenxa yaboyise; wonke umuntu uzakubulawa ngenxa yesakhe isono.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.16",
