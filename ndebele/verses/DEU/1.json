              },
              "items": [
                {
                  "text": "Seb 13:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.31",
            "verseOrgIds": [
              "DEU.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwake, lanxa kunjalo, kalikholwanga iNkosi uNkulunkulu wenu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.32",
            "verseOrgIds": [
              "DEU.1.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
