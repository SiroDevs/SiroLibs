              "items": [
                {
                  "text": "Heb 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.32",
            "verseOrgIds": [
              "DEU.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyahamba phambi kwenu endleleni ukulidingela indawo ukuba limise kuyo amathente enu; yahamba ngomlilo ebusuku, ukuba ilitshengise indlela elifanele lihambe ngayo, langeyezi emini.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.33",
            "verseOrgIds": [
              "DEU.1.33"
            ]
          }
        }
      ]
