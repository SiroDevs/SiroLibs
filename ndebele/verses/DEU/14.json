          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasekupheleni kweminyaka yonke emithathu lizakukhupha okwetshumi kwezithelo zenu zonke ngawona lowomnyaka, likubuthelele phakathi kwemizi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.28",
            "verseOrgIds": [
              "DEU.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
