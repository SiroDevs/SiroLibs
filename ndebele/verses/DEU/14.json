            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingabokudla ulutho oluzifeleyo; lingabanika lona abezizweni abahlala emizini yenu ukuba baludle, loba liluthengise kwabezizwe; ngoba lingabantu abangcwele eNkosini uNkulunkulu wenu. Futhi lingapheki izinyane lembuzi ngochago lukanina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
