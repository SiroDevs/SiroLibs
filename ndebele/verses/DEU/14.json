          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iminyaka ngeminyaka lizakukhupha okwetshumi kuzo zonke izithelo zenhlanyelo yenu ezivela emasimini.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.22",
            "verseOrgIds": [
              "DEU.14.22"
            ]
          }
        },
        {
