            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.11.1+LEV.11.2+LEV.11.3+LEV.11.4+LEV.11.5+LEV.11.6+LEV.11.7+LEV.11.8+LEV.11.9+LEV.11.10+LEV.11.11+LEV.11.12+LEV.11.13+LEV.11.14+LEV.11.15+LEV.11.16+LEV.11.17+LEV.11.18+LEV.11.19+LEV.11.20+LEV.11.21+LEV.11.22+LEV.11.23+LEV.11.24+LEV.11.25+LEV.11.26+LEV.11.27+LEV.11.28+LEV.11.29+LEV.11.30+LEV.11.31+LEV.11.32+LEV.11.33+LEV.11.34+LEV.11.35+LEV.11.36+LEV.11.37+LEV.11.38+LEV.11.39+LEV.11.40+LEV.11.41+LEV.11.42+LEV.11.43+LEV.11.44+LEV.11.45+LEV.11.46+LEV.11.47"
