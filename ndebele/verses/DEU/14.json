        },
        {
          "text": "Lina lingabantwana beNkosi uNkulunkulu wenu. Kaliyikuzisika, lingaziphuculi emabunzini enu ngenxa yabafileyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
