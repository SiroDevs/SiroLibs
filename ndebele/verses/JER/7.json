              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bakoJuda benzile okubi phambi kwami; babekile izinengiso zabo endlini lapho ibizo lami lidunyiselwa khona, ukuba bayingcolise, kutsho iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhile indawo ephakemeyo yokukhonzela eTofethi, esesihotsheni seBeni‐Hinomu, ukuba batshise amadodana lamadodakazi abo ngomlilo, into engingabalayanga yona lengingacabanganga ngayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.31",
            "verseOrgIds": [
              "JER.7.31"
            ]
          }
        },
