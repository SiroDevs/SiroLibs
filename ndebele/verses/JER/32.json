          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakha indawo eziphakemeyo zikaBali esihotsheni seBeni‐Hinomu, ukuba banikele amadodana lamadodakazi awo kuNkulunkulu uMoloki, into engingabalayanga yona lengafikanga engqondweni yami, ukuba benze uJuda one.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        },
