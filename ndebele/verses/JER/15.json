              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho bekubuza besithi: Sizakuya ngaphi? uzakuthi kibo:",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
