          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Induna yabalindi yathatha uSeraya umpristi omkhulu loZefaniya umpristi omlandelayo, labalindi besango abathathu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.24",
            "verseOrgIds": [
              "JER.52.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 52:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "yathatha emzini induna eyayiphethe amadoda empi, lamadoda ayisikhombisa awenkundla yenkosi ayefunyaniswe emzini, lomabhalane wenduna eyayiphethe impi eyayibuthela abantu emabuthweni, lamadoda angamatshumi ayisithupha elizwe ayefunyaniswe phakathi komuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.25",
            "verseOrgIds": [
              "JER.52.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 52:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNebuzaradani induna yabalindi wabathatha, wabasa enkosini yaseBabiloni eRibila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.26",
            "verseOrgIds": [
              "JER.52.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yaseBabiloni yabatshaya, yababulalela eRibila elizweni laseHamathi. Wathunjwa ngokunjalo uJuda elizweni lakhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 52:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanti inani labantu abathunjwa nguNebukadineza; ngomnyaka wesikhombisa, abaJuda abazinkulungwane ezintathu, lamatshumi amabili, lantathu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
              "JER.52.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 52:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngomnyaka wetshumi lesificaminwembili wokubusa kukaNebukadineza wathumba eJerusalema abantu abangamakhulu aficaminwembili, lamatshumi amathathu, lambili; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 52:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngomnyaka wamatshumi amabili lantathu wokubusa kukaNebukadineza, uNebuzaradani induna yabalindi wathumba abaJuda abangamakhulu ayisikhombisa, lamatshumi amane lanhlanu; bonke abantu sebehlangene baba zinkulungwane ezine, lamakhulu ayisithupha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 52:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngomnyaka wamatshumi amathathu lesikhombisa wokuthunjwa kukaJehoyakini inkosi yakoJuda, ngosuku lwamatshumi amabili lanhlanu lwenyanga yetshumi lambili, uEvili‐Merodaki inkosi yaseBabiloni, ngomnyaka abekwa ngawo abe yinkosi, waba lomusa kuJehoyakini, wamkhupha entolongweni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakhuluma laye kuhle, wamnika isihlalo esedlula zonke izihlalo zamakhosi ayelaye eBabiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke uJehoyakini wakhumula izigqoko zokubotshwa; insuku zonke zokuphila kwakhe wadla lenkosi; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "wayelesabelo esimiyo esensuku zonke, asinikwa yinkosi njengokuswela kwakhe insuku zonke zokuhamba kwakhe, waze wafa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
            "verseOrgIds": [
              "JER.52.34"
            ]
          }
        }
      ]
    }
