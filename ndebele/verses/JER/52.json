        "sid": "JER 52"
      },
      "items": [
        {
          "text": "52",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 52:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UZedekiya wayeleminyaka engamatshumi amabili lanye ekuqaleni kwakhe ukubusa; wabusa iminyaka elitshumi lanye eJerusalema. Ibizo likanina lalinguHamutali, indodakazi kaJeremiya waseLibina.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.1",
            "verseOrgIds": [
              "JER.52.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Kho 24:18—25:21, 27–30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.1",
            "verseOrgIds": [
              "JER.52.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza okubi emehlweni eNkosi, njengakho konke okwenziwa nguJehoyakimi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.2",
            "verseOrgIds": [
              "JER.52.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenxa yokuthukuthela kweNkosi, izinto zenzeka eJerusalema lakoJuda yaze yabalahla phambi kwayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "UZedekiya wawuvukela umbuso waseBabiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wesificamunwemunye wokubusa kwakhe, ngosuku lwetshumi lwenyanga yetshumi, uNebukadineza inkosi yaseBabiloni wafika layo yonke impi yakhe ukulwa leJerusalema; balivimbezela, balakhela imiduli yokuvimbezela inxa zonke.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.4",
            "verseOrgIds": [
              "JER.52.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.24.2"
              },
              "items": [
                {
                  "text": "Hez 24:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.4",
            "verseOrgIds": [
              "JER.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuzi wavinjezelwa kwaze kwaba ngumnyaka wetshumi lanye wokubusa kwenkosi uZedekiya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.5",
            "verseOrgIds": [
              "JER.52.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesificamunwemunye lwenyanga yesine indlala yaba nkulu phakathi komuzi, kwasweleka ukudla kwabantu elizweni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.6",
            "verseOrgIds": [
              "JER.52.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 52:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebewufohlela umuzi; wonke amadoda empi abaleka, aphuma emzini ebusuku, ngendlela yesango eliphakathi kwemiduli emibili, ngasesangweni lensimu yenkosi, lanxa amaKaladiya ayewuzingelezele umuzi. Ahamba aqonda ngaseAraba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.7",
            "verseOrgIds": [
              "JER.52.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.21"
              },
              "items": [
                {
                  "text": "Hez 33:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.7",
            "verseOrgIds": [
              "JER.52.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impi yamaKaladiya yaxotshana layo inkosi uZedekiya; yamfica emagcekeni aseJeriko; lempi yakhe yonke yahlakazeka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.8",
            "verseOrgIds": [
              "JER.52.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebeyibamba inkosi, bayiletha enkosini yaseBabiloni eRibila elizweni laseHamathi, yamgweba khona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.9",
            "verseOrgIds": [
              "JER.52.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 52:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yaseBabiloni yabulala amadodana kaZedekiya phambi kwakhe, yazibulala lazo zonke izikhulu zakoJuda eRibila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.10",
            "verseOrgIds": [
              "JER.52.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 52:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamkhupha amehlo uZedekiya, yambopha ngamaketane, yamusa eBabiloni, yamfaka entolongweni, kwaze kwaba lusuku lokufa kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.11",
            "verseOrgIds": [
              "JER.52.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.13"
              },
              "items": [
                {
                  "text": "Hez 12:13",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 52:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.11",
            "verseOrgIds": [
              "JER.52.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 52:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwetshumi lwenyanga yesihlanu, ngomnyaka wetshumi lesificamunwemunye wokubusa kukaNebukadineza inkosi yaseBabiloni, uNebuzaradani induna yabalindi benkosi, owayengaphansi kwenkosi yaseBabiloni, wangena eJerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.12",
            "verseOrgIds": [
              "JER.52.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 52:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walitshisa ithempeli, lesigodlo senkosi, lezindlu zonke ezinkulu zaseJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.13",
            "verseOrgIds": [
              "JER.52.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.8"
              },
              "items": [
                {
                  "text": "1 Kho 9:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.13",
            "verseOrgIds": [
              "JER.52.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 52:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi yonke impi yamaKaladiya, eyayilenduna yabalindi, yabhidliza yonke imiduli ezingelezele iJerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.14",
            "verseOrgIds": [
              "JER.52.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 52:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNebuzaradani induna yabalindi wathumba bonke abantu ababesele emzini, lalabo ababehlamukele enkosini yaseBabiloni kanye lezingcitshi zemisebenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.15",
            "verseOrgIds": [
              "JER.52.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 52:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uNebuzaradani induna yabalindi watshiya abanye abantukazana elizweni ukuba balime izivini lamasimu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.16",
            "verseOrgIds": [
              "JER.52.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 52:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.16",
            "verseOrgIds": [
              "JER.52.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 52:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Insika zethusi ezazisethempelini, lezinyawo, lolwandle lwethusi, amaKaladiya akuphahlaza, athatha lonke ithusi, alisa eBabiloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
              "JER.52.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.15+1KI.7.16+1KI.7.17+1KI.7.18+1KI.7.19+1KI.7.20+1KI.7.21+1KI.7.22+1KI.7.23+1KI.7.24+1KI.7.25+1KI.7.26+1KI.7.27+1KI.7.28+1KI.7.29+1KI.7.30+1KI.7.31+1KI.7.32+1KI.7.33+1KI.7.34+1KI.7.35+1KI.7.36+1KI.7.37+1KI.7.38+1KI.7.39+1KI.7.40+1KI.7.41+1KI.7.42+1KI.7.43+1KI.7.44+1KI.7.45+1KI.7.46+1KI.7.47"
              },
              "items": [
                {
                  "text": "1 Kho 7:15–47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
              "JER.52.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 52:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athatha izimbiza, lamafotsholo, lezindlawu, lemiganu yokuchela, lezitsha zempepha, lazo zonke izitsha zethusi ezazisetshenziswa enkonzweni yethempeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.18",
            "verseOrgIds": [
              "JER.52.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 52:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanye lemiganywana, lezitsha zokuthwala umlilo, lemiganu yokuchela, lezimbiza, lezinti zezibane, lezinkezo zempepha, lemiganu yomnikelo wokuthululwa. Okwakwenziwe ngegolide induna yabalindi yakuthatha, lalokho okwakwenziwe ngesiliva yakuthatha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.19",
            "verseOrgIds": [
              "JER.52.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 52:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Insika zombili, lolwandle olwalulunye nje, lenkabi zethusi ezazilitshumi lambili ezazingaphansi kolwandle kanye lezinyawo inkosi uSolomoni ayekwenzele ithempeli, ithusi lazo zonke lezizinto lalingelakulinganiswa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.20",
            "verseOrgIds": [
              "JER.52.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 52:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubude bensika babuzingalo ezilitshumi lesificaminwembili, ububanzi bayo babuzingalo ezilitshumi lambili, lohlonzi lwayo lwaluyiminwe emine, futhi yayilomholo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.21",
            "verseOrgIds": [
              "JER.52.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 52:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona isiduku sethusi, ubude baso sisinye babuzingalo ezinhlanu, lesihlengo ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.22",
            "verseOrgIds": [
              "JER.52.22"
            ]
          }
        },
        {
          "text": ", konke kwenziwe ngethusi, kwakuzingelezele isiduku phezulu. Lensika yesibili yayinjalo ilamapomegranati. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.22",
            "verseOrgIds": [
              "JER.52.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 52:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakubonakala ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.23",
            "verseOrgIds": [
              "JER.52.23"
            ]
          }
        },
        {
          "text": " angamatshumi ayisificamunwemunye lesithupha; wonke amapomegranati ayephezu kwesihlengo inxa zonke ayelikhulu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.23",
            "verseOrgIds": [
              "JER.52.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
