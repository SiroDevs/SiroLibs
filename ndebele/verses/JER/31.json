            "sid": "JER 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khangela, insuku ziyeza, kutsho iNkosi, lapho ngizakwenza isivumelwano esitsha lendlu kaIsrayeli lendlu kaJuda,",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.31",
            "verseOrgIds": [
              "JER.31.31"
            ]
          }
        },
