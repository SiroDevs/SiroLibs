              "JER.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJeremiya wasethatha omunye umqulu, wawunika uBaruki umbhali indodana kaNeriya, owaloba kiwo wonke amazwi kaJeremiya, wonke amazwi omqulu wokuqala owatshiswa nguJehoyakimi inkosi yakoJuda; kwengezelelwa kiwo amazwi amanengi afana lawo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
