              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yileli ilizwi leNkosi elafika kuJeremiya mhla inkosi uZedekiya ethumela kuye uPashuri indodana kaMalikiya, loZefaniya umpristi, indodana kaMahaseya isithi: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ake usibuzele eNkosini, ngoba uNebukadineza inkosi yaseBabiloni uyasihlasela; mhlawumbe iNkosi ingasenzela njengazo zonke izimangaliso zayo, imenze asuke kithi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
