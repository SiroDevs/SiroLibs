          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyo indlu yenkosi yakoJuda lithi: Zwana ilizwi leNkosi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
              "JER.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "lina ndlu kaDavida. INkosi ithi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
