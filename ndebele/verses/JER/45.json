        },
        {
          "text": "Ilizwi uJeremiya umprofethi alikhuluma kuBaruki indodana kaNeriya, ekulobeni kwakhe lamazwi encwadini, uJeremiya emtshela wona, ngomnyaka wesine wokubusa kukaJehoyakimi indodana kaJosiya, inkosi yakoJuda,",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.1",
            "verseOrgIds": [
              "JER.45.1"
            ]
          }
        },
