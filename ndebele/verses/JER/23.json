          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho iNkosi yamabandla ithi mayelana labaprofethi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.15",
            "verseOrgIds": [
              "JER.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.15",
            "verseOrgIds": [
              "JER.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yamabandla ithi: Lingawalaleli amazwi abaprofethi abawatshumayela kini belithembisa okuyize, bekhuluma imibono yengqondo zabo, kungesikho okuvela eNkosini. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.16",
            "verseOrgIds": [
              "JER.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahlala besithi kulabo abadelela ilizwi leNkosi: Kuzalilungela lonke; lakubo bonke abalandela inhliziyo zabo ezilenkani bathi: Kaliyikwehlelwa ngokubi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.17",
            "verseOrgIds": [
              "JER.23.17"
            ]
          }
        }
      ]
    }
