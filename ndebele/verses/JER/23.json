        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.14",
            "verseOrgIds": [
              "JER.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
