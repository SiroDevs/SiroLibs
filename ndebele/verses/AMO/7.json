          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAmaziya wasesithi kuAmosi: Wena mboni, hamba ubalekele elizweni lakoJuda, udle ukudla khona, utshumayele lapho, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.12",
            "verseOrgIds": [
              "AMO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ungatshumayeli futhi eBetheli, ngoba liyindlu yokukhonzela yenkosi lethempeli lombuso.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.13",
            "verseOrgIds": [
              "AMO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
