              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi uNkulunkulu yangitshengisa lokhu; yenza isikhongwane ekuhlumeni kotshani bamuva, kwakungutshani bamuva emva kokusikwa kotshani benkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.1",
            "verseOrgIds": [
              "AMO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho sesidlile utshani belizwe, ngathi:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.2",
            "verseOrgIds": [
              "AMO.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
