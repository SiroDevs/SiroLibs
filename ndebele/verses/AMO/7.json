          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.13",
            "verseOrgIds": [
              "AMO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAmosi wasemphendula uAmaziya esithi: Kangisuye umprofethi mina, futhi kangisindodana yomprofethi; kodwa ngingumalusi lomhlanyeli wezihlahla zephane. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
              "AMO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yangithatha ekwaluseni, yathi kimi: Hamba uyetshumayela ebantwini bami uIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.15",
            "verseOrgIds": [
              "AMO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "AMO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke zwana ilizwi leNkosi. Wena uthi: Ungatshumayeli ngoIsrayeli, ungakhulumi ngendlu kaIsaka. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.16",
            "verseOrgIds": [
              "AMO.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "AMO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yona ithi:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
