      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elokucinake, bazalwane, thokozani eNkosini. Ukulilobela futhi ngalezizinto kakungidinisi, kodwa lina kuyalivikela. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.1",
            "verseOrgIds": [
              "PHP.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xwayani izinja, lixwaye abenza okubi, lixwaye abazisikayo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.2",
            "verseOrgIds": [
              "PHP.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba singabokusoka thina esikhonza uNkulunkulu ngoMoya, siziqhenya kuKristu Jesu, singathembeli kokomzimba. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.3",
            "verseOrgIds": [
              "PHP.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa mina uqobo bengingaba lokuthembela kokomzimba. Uba umuntu ecabanga ukuthi ulokuthembela kokomzimba, mina ngilakho kakhulu; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.4",
            "verseOrgIds": [
              "PHP.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngasokwa ngosuku lwesificaminwembili ngingowohlanga lukaIsrayeli, owesizwe sakoBenjamini, umHeberu wamaHeberu; ngokomlayo ngingumFarisi;",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.5",
            "verseOrgIds": [
              "PHP.3.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
