              },
              "items": [
                {
                  "text": "Roma 11:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.5",
            "verseOrgIds": [
              "PHP.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngokokukhuthala ngazingela ibandla; ngokulunga okusemlayweni ngingongasolekiyo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.6",
            "verseOrgIds": [
              "PHP.3.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
