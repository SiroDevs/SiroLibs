            "sid": "2CH 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uHezekiya katshengisanga ukubonga ngokuhle enzelwe khona, ngoba inhliziyo yakhe yayisiziphakamisile. Ngakho ulaka lweNkosi lwehlela phezu kwabakoJuda labaseJerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.25",
            "verseOrgIds": [
              "2CH.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHezekiya wasezithoba ngenxa yokuziphakamisa kwenhliziyo yakhe, yena labaseJerusalema, ngakho ulaka lweNkosi kalwehlelanga kibo futhi ensukwini zikaHezekiya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.26",
            "verseOrgIds": [
              "2CH.32.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
