        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.31",
            "verseOrgIds": [
              "2CH.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye indaba zikaHezekiya lezenzo zakhe zonke ezinhle zilotshiwe embonweni kaIsaya umprofethi indodana kaAmozi, logwalweni lwamakhosi akoJuda lawakoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.32",
            "verseOrgIds": [
              "2CH.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHezekiya waya kwabaphansi, wangcwatshelwa ngaphezulu kwamaliba amadodana kaDavida; bonke abakoJuda labaseJerusalema bamenzela isililo esikhulu. UManase indodana yakhe waba yinkosi esikhundleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.33",
            "verseOrgIds": [
              "2CH.32.33"
            ]
          }
        }
      ]
