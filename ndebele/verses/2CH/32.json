            "sid": "2CH 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngemva kwalezizenzo zobuqotho zikaHezekiya uSenakeribi inkosi yaseAsiriya wafika ukuhlasela uJuda, wamisa maqondana lemizi ebiyelweyo eqonde ukuzithumbela yona.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.1",
            "verseOrgIds": [
              "2CH.32.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
