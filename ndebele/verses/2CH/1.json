            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "USolomoni indodana kaDavida waqina embusweni wakhe, leNkosi uNkulunkulu wakhe yayilaye, yamenza waba mkhulu kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.1",
            "verseOrgIds": [
              "2CH.1.1"
            ]
          }
        }
      ]
    },
    {
