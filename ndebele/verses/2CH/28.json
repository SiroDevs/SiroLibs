  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "2CH 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAhazi wayeleminyaka engamatshumi amabili lapho eqalisa ukubusa; wabusa iminyaka elitshumi lesithupha eJerusalema. Kenzanga okulungileyo phambi kweNkosi uNkulunkulu wakhe, njengokwenza kukakhokho wakhe uDavida. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.1",
            "verseOrgIds": [
              "2CH.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa walandela indlela zamakhosi akoIsrayeli, wenza lezithombe ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.2",
            "verseOrgIds": [
              "2CH.28.2"
            ]
          }
        },
        {
          "text": " ezibunjiweyo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.2",
            "verseOrgIds": [
              "2CH.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "watshisa impepha esihotsheni saseBeni‐Hinomu, watshisa lamadodana akhe aba ngumnikelo, elingisa amanyala enziwa yizizwe iNkosi eyazixotsha phambi kwabakoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.3",
            "verseOrgIds": [
              "2CH.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanikela imihlatshelo, watshisa impepha endaweni eziphakemeyo zokukhonzela laphezu kwamaqaqa langaphansi kwazo zonke izihlahla ezinkulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.4",
            "verseOrgIds": [
              "2CH.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.4",
            "verseOrgIds": [
              "2CH.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho iNkosi uNkulunkulu wakhe yamnikela esandleni senkosi yaseSiriya eyamnqobayo, yathumba abantu bakhe abanengi kakhulu, yabasa eDamaseko. Futhi wanikelwa esandleni senkosi yakoIsrayeli eyamnqobayo, yabulala abantu abanengi kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.5",
            "verseOrgIds": [
              "2CH.28.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.16.5"
              },
              "items": [
                {
                  "text": "2 Kho 16:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.1"
              },
              "items": [
                {
                  "text": "Isa 7:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.5",
            "verseOrgIds": [
              "2CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uPeka indodana kaRemaliya wabulala koJuda abantu abazinkulungwane ezilikhulu lamatshumi amabili ngasuku lunye, bonke bengamaqhawe, ngoba babeyidelile iNkosi, uNkulunkulu wabokhokho babo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.6",
            "verseOrgIds": [
              "2CH.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UZikiri iqhawe lakoEfrayimi wabulala uMahaseya indodana yenkosi loAzirikamu umphathi wesigodlo loElkana induna enkulu yenkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.7",
            "verseOrgIds": [
              "2CH.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoIsrayeli bathumba ezihlotsheni zabo abantu abazinkulungwane ezingamakhulu amabili, abesifazana lamadodana lamadodakazi; babutha kibo impango enengi, bayiletha eSamariya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.8",
            "verseOrgIds": [
              "2CH.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.8",
            "verseOrgIds": [
              "2CH.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona lapho umprofethi weNkosi uOdedi; waphuma ukuyihlangabeza impi eyayisiza eSamariya, wathi kiyo: Ngoba iNkosi uNkulunkulu wabokhokho benu ibibathukuthelele abakoJuda, ibanikele ezandleni zenu; lina libabulele ngolunya olufinyelele ezulwini. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.9",
            "verseOrgIds": [
              "2CH.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seliqonde ukubanqoba abakoJuda labaseJerusalema abesilisa labesifazana, libenze izigqili zenu. Lina kalilasono yini phambi kweNkosi uNkulunkulu wenu na? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.10",
            "verseOrgIds": [
              "2CH.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngilalelani; buyiselani abathunjiweyo bonke elibathumbe ezihlotsheni zenu, ngoba ulaka oluvuthayo lweNkosi luzakwehlela phezu kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.11",
            "verseOrgIds": [
              "2CH.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezinduna ezithile zabakoEfrayimi, oAzariya indodana kaJohanani loBerekiya indodana kaMeshilemothi loJehizikiya indodana kaShaluma loAmasa indodana kaHadilayi, bamelana lalabo ababevela empini, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.12",
            "verseOrgIds": [
              "2CH.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bathi kibo: Kaliyikubangenisa abathunjiweyo lapha; ngoba lifuna ukwenza lokho okuzasilethela icala phambi kweNkosi uNkulunkulu, kwengezelele izono zethu leziphambeko zethu. Ngoba icala lethu livele selilikhulu, lolaka lweNkosi seluphezu kukaIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.13",
            "verseOrgIds": [
              "2CH.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho amadoda ahlomileyo asebatshiya abathunjiweyo kanye lempango phambi kwezikhulu laphambi kwebandla lonke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.14",
            "verseOrgIds": [
              "2CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labo abakhethiweyo basuka bathatha abathunjiweyo, babadingela izigqoko phakathi kwempango bonke ababehambaze; babagqokisa, babafaka lamanyathelo, babanika ukudla lokunathwayo, babagcoba ngamagcobo, bathwala bonke ababuthakathaka ngabobabhemi, babasa ezihlotsheni zabo eJeriko, umuzi wamalala; basebebuyela eSamariya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.15",
            "verseOrgIds": [
              "2CH.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.15",
            "verseOrgIds": [
              "2CH.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalesosikhathi inkosi uAhazi wathumela enkosini yaseAsiriya ukucela usizo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.16",
            "verseOrgIds": [
              "2CH.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba amaEdoma ayesebuye abahlasela abahlula abakoJuda, abathumba abanye babo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.17",
            "verseOrgIds": [
              "2CH.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "LamaFilistiya ayehlasele imizi yaseShefela laseNegebi lakoJuda, athumba iBeti‐Shemeshi leAjaloni leGederothi, leSoko lemizana yalo, leTimina lemizana yalo, leGimizo lemizana yalo; ahlala khona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.18",
            "verseOrgIds": [
              "2CH.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yamehlisela phansi uJuda ngenxa kaAhazi inkosi yakoJuda, ngoba wayengazithintanga koJuda, wona kakhulu eNkosini. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.19",
            "verseOrgIds": [
              "2CH.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uTiligathi‐Pileseri inkosi yaseAsiriya yamhlasela, yamhlupha endaweni yokumqinisa, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.20",
            "verseOrgIds": [
              "2CH.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "lanxa uAhazi wayethethe impahla ethempelini lasesigodlweni lakuzikhulu, wathela ngayo enkosini yaseAsiriya; kodwa lokhu kakumsizanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.21",
            "verseOrgIds": [
              "2CH.28.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.21",
            "verseOrgIds": [
              "2CH.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Linkosi uAhazi isithwele nzima yandisa ukona kwayo eNkosini uNkulunkulu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.22",
            "verseOrgIds": [
              "2CH.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba yahlabela onkulunkulu baseDamaseko elalimnqobile, wathi: Ngoba onkulunkulu bamakhosi aseSiriya babasiza, ngizahlabela bona ukuze lami bangisize. Kodwa bambangela ukuchitheka yena labo bonke abakoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.23",
            "verseOrgIds": [
              "2CH.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waseqoqa izitsha zendlu kaNkulunkulu, wazibulala, wavala iminyango yendlu; wazenzela ama‐altare kulo lonke iJerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.24",
            "verseOrgIds": [
              "2CH.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emizini yonke yakoJuda wamisa indawo eziphakemeyo zokukhonzela ukuba atshisele abanye onkulunkulu impepha, eyithukuthelisa iNkosi uNkulunkulu wabokhokho bakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.25",
            "verseOrgIds": [
              "2CH.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye izindaba zakhe lakho konke ukwenza kwakhe, kusukela ekuqaleni kuze kube sekucineni, kulotshiwe ogwalweni lwamakhosi akoJuda lawakoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.26",
            "verseOrgIds": [
              "2CH.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
