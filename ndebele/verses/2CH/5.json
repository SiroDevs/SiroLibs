              "type": "text"
            }
          ]
        },
        {
          "text": "USolomoni wasebuthanisa eJerusalema abadala bakoIsrayeli lazo zonke izinduna zezizwe eziyizikhulu zezindlu zabakoIsrayeli, ukuba bakhuphe umtshokotsho ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "text": " seNkosi emzini kaDavida othiwa yiZiyone.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
