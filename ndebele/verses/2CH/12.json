                "loc": "2CH.9.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.9",
            "verseOrgIds": [
              "2CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uRehobowamu yenza endaweni yazo izihlangu zethusi, yazinikeza ezinduneni zabalindi ababelinda umnyango wesigodlo senkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.10",
            "verseOrgIds": [
              "2CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izikhathi zonke zokuya kwenkosi ethempelini abalindi babeziletha khona, babuye bazibuyisele endlini yabalindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.11",
            "verseOrgIds": [
              "2CH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isizithobile, ulaka lweNkosi uNkulunkulu lwadeda kuyo ukuze ingayibhubhisi; futhi izinto zasezilungile koJuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.12",
            "verseOrgIds": [
              "2CH.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.12",
            "verseOrgIds": [
              "2CH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uRehobowamu yaqinisa amandla ayo eJerusalema, yaqhubeka ibusa. Yayisileminyaka engamatshumi amane lanye lapho iqalisa ukubusa, yabusa iminyaka elitshumi lesikhombisa eJerusalema, umuzi iNkosi uNkulunkulu eyayiwukhethile phakathi kwazo zonke izizwe zakoIsrayeli ukuba ibizo layo lidunyiselwe khona. Ibizo likanina lalinguNahama umAmoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.13",
            "verseOrgIds": [
              "2CH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "URehobowamu wenza okubi ngokungazimiseli ngenhliziyo yakhe ukuyidinga iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.14",
            "verseOrgIds": [
              "2CH.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indaba zikaRehobowamu, kusukela ekuqaleni kuze kube sekucineni, zilotshiwe ogwalweni lwezindaba zomprofethi uShemaya lezikaIdo umboni. Kwakuhlala kusiba khona ukulwa phakathi kukaRehobowamu loJerobowamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.15",
            "verseOrgIds": [
              "2CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "URehobowamu waya kwabaphansi, wangcwatshelwa emzini kaDavida. UAbija indodana yakhe waba yinkosi esikhundleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.16",
            "verseOrgIds": [
              "2CH.12.16"
            ]
          }
        }
      ]
    }
