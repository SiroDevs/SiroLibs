        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngesimiso sikaDavida uyise wamisa izigaba zabapristi zenkonzo yabo, lezamaLevi zokuhlabelela izindumiso lokusiza abapristi njengokufunekayo ngalolo lalolosuku, lezabalindi bamasango kulelo lalelosango; ngoba wayetsho njalo uDavida umuntu kaNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaphambukanga kulokho inkosi uDavida eyayikutshilo mayelana labapristi lamaLevi lezindlu zenotho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
