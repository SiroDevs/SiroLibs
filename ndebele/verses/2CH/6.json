          ]
        },
        {
          "text": "baphenduke elizweni abathunjelwe kilo, bakhuleke kuwe elizweni lelo bathi: Sonile, senza okungalunganga lokubi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
