          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza lendawo engcwele kakhulu; ubude bayo babulingana lobubanzi bendlu, buzingalo ezingamatshumi amabili, lobubanzi bayo buzingalo ezingamatshumi amabili; wayibhada ngegolide elihle ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "text": " angamakhulu ayisithupha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
