          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubunzima bezipikili ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        },
        {
          "text": " egolide angamatshumi amahlanu. Wazigudula izindlu ezingaphezulu ngegolide. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endaweni engcwele kakhulu wabaza ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.10",
            "verseOrgIds": [
              "2CH.3.10"
            ]
          }
        },
        {
          "text": " amabili, wawabhada ngegolide.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.10",
            "verseOrgIds": [
              "2CH.3.10"
            ]
          }
        },
