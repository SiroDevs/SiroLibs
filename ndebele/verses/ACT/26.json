          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yasisukuma inkosi lombusi loBernike kanye lalabo ababehlezi labo; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.30",
            "verseOrgIds": [
              "ACT.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwathi sebephumile, bakhulumisana besithi: Lumuntu kenzi lutho olufanele ukufa kumbe ukubotshwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.31",
            "verseOrgIds": [
              "ACT.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAgripha wathi kuFestusi: Lumuntu ubengakhululwa uba ebengalidluliselanga kuKesari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.32",
