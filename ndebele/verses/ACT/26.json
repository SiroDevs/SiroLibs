        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.29",
            "verseOrgIds": [
              "ACT.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
