    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi besakhuluma ebantwini, abapristi lenduna yethempeli labaSadusi babafikela, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.1",
            "verseOrgIds": [
              "ACT.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "benengekile ngoba babefundisa abantu betshumayela ukuvuka kwabafileyo ngoJesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.2",
            "verseOrgIds": [
              "ACT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bababamba, babafaka entolongweni kwaze kwaba kusasa, ngoba kwasekuhlwile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.3",
            "verseOrgIds": [
              "ACT.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa abanengi abalizwayo ilizwi bakholwa; ubunengi bamadoda babungaba zinkulungwane ezinhlanu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.4",
            "verseOrgIds": [
              "ACT.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.4",
            "verseOrgIds": [
              "ACT.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi kusasa kwabuthana eJerusalema ababusi labadala lababhali, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.5",
            "verseOrgIds": [
              "ACT.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanye loAnasi umpristi omkhulu, loKayafasi, loJohane, loAleksandro, labo bonke abendlu yompristi omkhulu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.6",
            "verseOrgIds": [
              "ACT.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "sebebamise phakathi kwabo, bababuza bathi: Lokhu likwenze ngawaphi amandla ingabe ngaliphi ibizo na? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.7",
            "verseOrgIds": [
              "ACT.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwang’khona uPetro egcwele uMoya oNgcwele wathi kubo: Babusi babantu labadala, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.8",
            "verseOrgIds": [
              "ACT.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nxa sibuzwa lamuhla ngomsebenzi omuhle owenziweyo emuntwini oyisilima ukuba yena usiliswe ngani, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.9",
            "verseOrgIds": [
              "ACT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "yazini lonke kanye laso sonke isizwe sakoIsrayeli ukuthi ngebizo likaJesu Kristu waseNazaretha elambethelayo, amvusayo kwabafileyo uNkulunkulu, ngaye lumuntu umi phambi kwenu esesilile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.10",
            "verseOrgIds": [
              "ACT.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu lo uyilitshe elaliwa ngabakhi, kodwa eseliyinhloko yengonsi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.11",
            "verseOrgIds": [
              "ACT.4.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.22"
              },
              "items": [
                {
                  "text": "Hubo 118:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.11",
            "verseOrgIds": [
              "ACT.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakukho ukusiliswa ngomunye, ngoba kalikho elinye ibizo ngaphansi kwezulu elinikiweyo ebantwini, esingasiliswa ngalo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.12",
            "verseOrgIds": [
              "ACT.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.12",
            "verseOrgIds": [
              "ACT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi bebona isibindi sikaPetro loJohane, besazi ukuthi kabafundanga, bangabantu nje, bamangala; babazi ukuba babeloJesu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.13",
            "verseOrgIds": [
              "ACT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa bebona umuntu osilisiweyo emi labo, babengelakuphika ulutho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.14",
            "verseOrgIds": [
              "ACT.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa sebebalayile ukuba baphume emphakathini bakhulumisana bodwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.15",
            "verseOrgIds": [
              "ACT.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "besithi: Sizakubenza njani lababantu na? Ngoba kusobala kubo bonke abahlezi eJerusalema ukuthi isibonakaliso esidumisekayo senziwa yibo, singekuphike. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.16",
            "verseOrgIds": [
              "ACT.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ukuze kungabe kusanda phakathi kwabantu, asibaqonqosele ukuthi bangabe besakhuluma lamuntu ngalelibizo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.17",
            "verseOrgIds": [
              "ACT.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebebabiza, babalaya ukuthi bangakhulumi, bangafundisi lakanye ngebizo likaJesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.18",
            "verseOrgIds": [
              "ACT.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uPetro loJohane babaphendula bathi: Yahlukanisani lina ukuba kulungile yini phambi kukaNkulunkulu ukulalela lina kulokulalela uNkulunkulu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.19",
            "verseOrgIds": [
              "ACT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba thina kasilakuyekela ukukhuluma ngalokho esikubonileyo lesikuzwileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.20",
            "verseOrgIds": [
              "ACT.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi sebebaqonqosele futhi, babayekela; kabafumananga indlela yokubatshaya, ngoba bonke abantu basebedumisa uNkulunkulu ngalokho okwenzekileyo; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.21",
            "verseOrgIds": [
              "ACT.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba umuntu esenziwa kuye lesisibonakaliso sokusilisa wayeleminyaka edlula amatshumi amane.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.22",
            "verseOrgIds": [
              "ACT.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
