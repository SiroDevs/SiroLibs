          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.31",
            "verseOrgIds": [
              "ACT.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ixuku labakholwayo lalinhliziyonye lomoya munye; kungekho loyedwa owathi impahla zakhe zingezakhe, kodwa bahlanganyela izinto zonke.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.32",
            "verseOrgIds": [
              "ACT.4.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.44"
              },
              "items": [
                {
                  "text": "Seb 2:44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.45"
              },
              "items": [
                {
                  "text": "45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.32",
            "verseOrgIds": [
              "ACT.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaphostoli baveza ngamandla amakhulu ubufakazi babo ngokuvuka kweNkosi uJesu; lomusa omkhulu waba phezu kwabo bonke. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.33",
            "verseOrgIds": [
              "ACT.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
