{
  "id": "ACT.14",
  "number": "14",
  "bookId": "ACT",
  "reference": "Seb 14",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "ACT 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi eIkoniyuma bangena esinagogeni labaJuda, bakhuluma kwaze kwakholwa ixuku elikhulu labaJuda lamaGriki. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.1",
            "verseOrgIds": [
              "ACT.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa abaJuda abangakholwayo bavusa abezizwe, babafaka umoya omubi ngabazalwane. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.2",
            "verseOrgIds": [
              "ACT.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahlala isikhathi eside, bekhuluma ngesibindi ngeNkosi eyafakazela ilizwi lomusa wayo, ibanika ukuba kwenziwe izibonakaliso lezimangaliso ngezandla zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.3",
            "verseOrgIds": [
              "ACT.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa abantu bomuzi behlukana phakathi, abanye baba ngakubaJuda labanye baba ngakubaphostoli. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.4",
            "verseOrgIds": [
              "ACT.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ukuba kuvele umzamo kwabezizwe labaJuda kanye lababusi babo wokubaphatha kubi lokubakhanda ngamatshe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.5",
            "verseOrgIds": [
              "ACT.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "sebekwazi lokhu, babalekela eListra leDerbe, imizi yaseLikawoniya, lasemazweni akhona, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.6",
            "verseOrgIds": [
              "ACT.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "batshumayela khona ivangeli.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.7",
            "verseOrgIds": [
              "ACT.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.7",
            "verseOrgIds": [
              "ACT.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "EListra kwakuhlezi indoda ethile eyisilima enyaweni zayo, eyisiqhuli kusukela ekuzalweni kwayo, engazanga ihambe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.8",
            "verseOrgIds": [
              "ACT.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yona yamuzwa uPawuli ekhuluma. UPawuli eyijolozela wabona ukuba ilokukholwa kokuba isiliswe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.9",
            "verseOrgIds": [
              "ACT.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wathi ngelizwi elikhulu: Sukuma, ume ngenyawo zakho. Yasukuma yathi lothu, yahamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.10",
            "verseOrgIds": [
              "ACT.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ukuba amaxuku abone okwenziweyo nguPawuli, aphakamisa ilizwi esithi ngolimi lwaseLikawoniya: Onkulunkulu behlele kithi befana labantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.11",
            "verseOrgIds": [
              "ACT.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UBarnabasi bambiza bathi nguZewusi, loPawuli bathi nguHermesi, ngoba nguye owayekhokhela ekukhulumeni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.12",
            "verseOrgIds": [
              "ACT.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi kaZewusi othempeli lakhe laliphambi komuzi waletha inkabi lemigaxo ngasesangweni, wafuna ukubahlabela ekanye labantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.13",
            "verseOrgIds": [
              "ACT.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa abaphostoli oBarnabasi loPawuli sebekuzwile, badabula ingubo zabo, baphoseka exukwini bememeza besithi: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.14",
            "verseOrgIds": [
              "ACT.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madoda, likwenzelani lokhu na? Lathi singabantu abanjengani ngokwemvelo, sililethele ivangeli ukuze liphenduke kulokho okuyize, liphendukele kuNkulunkulu ophilayo owenza izulu lomhlaba, lolwandle, lakho konke okukukho, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.15",
            "verseOrgIds": [
              "ACT.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "owathi ezizukulwaneni ezidlulileyo wayekela izizwe zonke zahamba ngendlela zazo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.16",
            "verseOrgIds": [
              "ACT.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kayekelanga ukuzifakazela ngokwenza okuhle, walinika izulu livela ezulwini lezikhathi zenala, esuthisa inhliziyo zenu ngokudla langokujabula. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.17",
            "verseOrgIds": [
              "ACT.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalamazwi babayekelisa abantu ngokulukhuni ukuba babahlabele.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.18",
            "verseOrgIds": [
              "ACT.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.18",
            "verseOrgIds": [
              "ACT.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kwafika abaJuda abavela eAntiyoki leIkoniyuma, sebevumelene labantu bamkhanda uPawuli ngamatshe, bamhudulela ngaphandle komuzi besithi ufile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.19",
            "verseOrgIds": [
              "ACT.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kwathi abafundi bebuthana kuye, wasukuma, wangena emzini; kusasa wasuka loBarnabasi, baya eDerbe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.20",
            "verseOrgIds": [
              "ACT.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebetshumayele ivangeli kulowomuzi, bezuzile abafundi abanengi, babuyela eListra, laseIkoniyuma, laseAntiyoki, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.21",
            "verseOrgIds": [
              "ACT.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "beqinisa imimoya yabafundi bebaluleka ukuba babambelele ekukholweni, besithi: Simele ukungena embusweni kaNkulunkulu ngenhlupheko ezinengi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.22",
            "verseOrgIds": [
              "ACT.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebebakhethele abadala emabandleni wonke, bakhuleka bezila ukudla, babanikela eNkosini asebekholwa kiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.23",
            "verseOrgIds": [
              "ACT.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebedabula iPisidiya, baya ePamfiliya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.24",
            "verseOrgIds": [
              "ACT.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebekhulumile ilizwi ePerga, behlela eAtaliya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.25",
            "verseOrgIds": [
              "ACT.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basuka lapho ngomkolo, baya eAntiyoki, lapho babenikezelwe khona emuseni kaNkulunkulu kulowo umsebenzi abasebewenzile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.26",
            "verseOrgIds": [
              "ACT.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi sebefikile, balihlanganisa ibandla, balandisa konke uNkulunkulu abekwenzile ngabo lokuthi uvulele abezizwe umnyango wokukholwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.27",
            "verseOrgIds": [
              "ACT.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebehlala isikhathi eside labafundi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.28",
            "verseOrgIds": [
              "ACT.14.28"
            ]
          }
        }
      ]
    }
  ],
