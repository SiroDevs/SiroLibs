{
  "id": "ACT.9",
  "number": "9",
  "bookId": "ACT",
  "reference": "Seb 9",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ACT 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "USawuli esafutheka ngokusongela lokubulala abafundi beNkosi, waya kumpristi omkhulu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.1",
            "verseOrgIds": [
              "ACT.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "wacela incwadi zokuya eDamaseko emasinagogeni, ukuze kuthi uba efumana abantu baleyoNdlela, abesilisa labesifazana, abalethe eJerusalema bebotshiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.2",
            "verseOrgIds": [
              "ACT.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ekuhambeni kwakhe, esesondele eDamaseko, kwaphazima masinyane inxa zonke ukukhanya okuvela ezulwini. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.3",
            "verseOrgIds": [
              "ACT.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wawela phansi, wezwa ilizwi lisithi kuye: Sawuli, Sawuli, ungizingelelani na? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.4",
            "verseOrgIds": [
              "ACT.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: Ungubani, Nkosi? Yathi: NginguJesu omzingelayo; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.5",
            "verseOrgIds": [
              "ACT.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa sukuma ungene emzini, uzakutshelwa lokhu omele ukukwenza. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.6",
            "verseOrgIds": [
              "ACT.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadoda ayehamba laye ayemi engelakukhuluma, ngoba ezwa ilizwi kodwa engaboni muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.7",
            "verseOrgIds": [
              "ACT.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "USawuli wasevuka phansi; kwathi esevule amehlo akhe, kabe esabona. Ngakho basebembamba ngesandla, bamusa eDamaseko. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.8",
            "verseOrgIds": [
              "ACT.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaba zinsuku ezintathu engaboni, engadli, enganathi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.9",
            "verseOrgIds": [
              "ACT.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.9",
            "verseOrgIds": [
              "ACT.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona eDamaseko umfundi othile, othiwa nguAnaniya; iNkosi yathi kuye ngombono: Ananiya! Yena wathi: Ngikhona, Nkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.10",
            "verseOrgIds": [
              "ACT.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuye: Suka uye endleleni ethiwa iQondile, udinge endlini kaJudasi umuntu othiwa nguSawuli waseTarsusi; uzamfumana ekhuleka; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.11",
            "verseOrgIds": [
              "ACT.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubonile ngombono umuntu, othiwa nguAnaniya, engena, ebeka izandla zakhe phezu kwakhe ukuba abone. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.12",
            "verseOrgIds": [
              "ACT.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uAnaniya wathi: Nkosi, ngizwile ngabanengi ngalowomuntu konke okubi akwenzileyo kwabangcwele bakho abaseJerusalema; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.13",
            "verseOrgIds": [
              "ACT.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "lalapha ulamandla avela kubapristi abakhulu okubopha bonke labo abakhuleka ebizweni lakho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.14",
            "verseOrgIds": [
              "ACT.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa iNkosi yathi kuye: Hamba, ngoba lowo uyisitsha sami esikhethiweyo sokuphatha ibizo lami phambi kwezizwe, lamakhosi, labakoIsrayeli; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.15",
            "verseOrgIds": [
              "ACT.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba mina ngizakumtshengisa konke amele ukuhlutshwa ngakho ngenxa yebizo lami. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.16",
            "verseOrgIds": [
              "ACT.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uAnaniya wasuka, wangena endlini, wabeka izandla zakhe phezu kwakhe esithi: Sawuli, mzalwane, iNkosi uJesu ebonakele kuwe endleleni oze ngayo, ungithumile ukuba ubuye ubone, ugcwaliswe ngoMoya oNgcwele. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.17",
            "verseOrgIds": [
              "ACT.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwahle kwawa emehlweni akhe kwangathi zinkwethu, wabona, wasukuma, wabhaphathizwa; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.18",
            "verseOrgIds": [
              "ACT.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "esedlile wathola amandla.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.19",
            "verseOrgIds": [
              "ACT.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahlala labafundi baseDamaseko insuku ezithile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.19",
            "verseOrgIds": [
              "ACT.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masinyane emasinagogeni abo watshumayela ngoJesu esithi uyiNdodana kaNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.20",
            "verseOrgIds": [
              "ACT.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abezwayo bamangala besithi: Lo kayisuye yini owachitha eJerusalema bonke labo abakhuleka kulelibizo, lalapha uzele khona lokho ukuba abathathe abase kubapristi abakhulu bebotshiwe na? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.21",
            "verseOrgIds": [
              "ACT.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uSawuli wakhula kakhulu emandleni, wabehlula abaJuda abakhileyo eDamaseko eqinisa ukuthi uJesu unguKristu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.22",
            "verseOrgIds": [
              "ACT.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sekudlule insuku ezinengi, abaJuda benza icebo ukuba bambulale.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.23",
            "verseOrgIds": [
              "ACT.9.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.32"
              },
              "items": [
                {
                  "text": "2 Kor 11:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.33"
              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.23",
            "verseOrgIds": [
              "ACT.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa icebo labo laziwa nguSawuli. Babemlindele emasangweni emini lebusuku ukuba bambulale. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.24",
            "verseOrgIds": [
              "ACT.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa abafundi bamthatha ebusuku, bamehlisela ngaphandle komthangala ngesilulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.25",
            "verseOrgIds": [
              "ACT.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esefikile eJerusalema wazama ukuzihlanganisa labafundi; kodwa bonke bamesaba, bengakholwa ukuba ungumfundi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.26",
            "verseOrgIds": [
              "ACT.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uBarnabasi wamthatha, wamusa kubaphostoli, wabalandisela ukuthi uyibonile iNkosi endleleni, lokuthi ikhulumile kuye, lokuthi eDamaseko utshumayele ngesibindi ngebizo likaJesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.27",
            "verseOrgIds": [
              "ACT.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahlala labo eJerusalema, ephuma engena phakathi kwabo etshumayela ngesibindi ngebizo leNkosi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.28",
            "verseOrgIds": [
              "ACT.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekhuluma ephikisana labaJuda abakhuluma isiGriki; bona bazama ukumbulala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.29",
            "verseOrgIds": [
              "ACT.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazalwane sebekwazi lokho bamehlisela eKesariya, bamthumela eTarsusi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.30",
            "verseOrgIds": [
              "ACT.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho ibandla laba lokuthula kulo lonke elaseJudiya, lelaseGalili, lelaseSamariya, lakheka, lihamba ngokwesaba kweNkosi, landa ngokuqiniswa nguMoya oNgcwele.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.31",
            "verseOrgIds": [
              "ACT.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.31",
            "verseOrgIds": [
              "ACT.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uPetro ehambela izindawo zonke, wafika lakwabangcwele abahlala eLida. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.32",
            "verseOrgIds": [
              "ACT.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafumana khona indoda ethiwa nguEneya, eyayiyisilima isilele ecansini iminyaka eficaminwembili. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.33",
            "verseOrgIds": [
              "ACT.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPetro wathi kuye: Eneya, uJesu Kristu uyakusilisa; vuka, wendlule icansi lakho. Wasevuka masinyane. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.34",
            "verseOrgIds": [
              "ACT.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bambona bonke abakhileyo eLida leSaroni, baphendukela eNkosini.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.35",
            "verseOrgIds": [
              "ACT.9.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.35",
            "verseOrgIds": [
              "ACT.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona eJopha umfundikazi othiwa nguTabitha okuyikuthi uDorkasi; wayelemisebenzi emihle lokusiza abayanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.36",
            "verseOrgIds": [
              "ACT.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulezonsuku wagula, wafa; sebemgezisile bamlalisa endlini ephezulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.37",
            "verseOrgIds": [
              "ACT.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengoba iLida laliseduze leJopha, abafundi sebezwile ukuthi uPetro ukhona lapho, bathumela amadoda amabili kuye bemncenga besithi: Ake uze kithi ungaphuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.38",
            "verseOrgIds": [
              "ACT.9.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPetro wasesuka, wahamba labo. Esefikile, bamthatha bamusa endlini ephezulu; bonke abafelwakazi bema laye bekhala, bemtshengisa izambatho lengubo uDorkasi ayezenzile eseselabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.39",
            "verseOrgIds": [
              "ACT.9.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPetro wasebakhuphela phandle bonke, eguqa ngamadolo wakhuleka. Wasephendukela esidunjini esithi: Tabitha, vuka! Wasevula amehlo akhe, wabona uPetro, walulama. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.40",
            "verseOrgIds": [
              "ACT.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wambamba ngesandla, wamsukumisa, wasebiza abangcwele labafelwakazi, wambeka phambi kwabo esilile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.41",
            "verseOrgIds": [
              "ACT.9.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwezwakala kulo lonke iJopha; abanengi bakholwa eNkosini. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.42",
            "verseOrgIds": [
              "ACT.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahlala eJopha insuku ezinengi loSimoni umkhuhli.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.43",
            "verseOrgIds": [
              "ACT.9.43"
            ]
          }
        }
      ]
    }
