          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "langaphezu kwaleyo banikela iminikelo yokutshiswa yensuku zonke, leminikelo yasekuthwaseni kwenyanga, layemikhosi yonke emisiweyo yeNkosi, leminikelo yabo bonke abanikela ngesihle eNkosini.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Nani 28:11—29:39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lokuqala lwenyanga yesikhombisa baqalisa ukunikela iminikelo yokutshiswa eNkosini, lanxa izisekelo zethempeli leNkosi zazingakabekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banika ababazi bamatshe lababazi bezigodo imali, banika abaseSidoni labaseTire ukudla lokunathwayo lamafutha ukuba balande imikusu eLebanoni bayilethe olwandle eJopha, ngemvumo kaKurosi inkosi yasePerisiya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.7",
            "verseOrgIds": [
              "EZR.3.7"
            ]
          }
        }
      ]
    },
