              "EZR.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho abakhi sebebekile isisekelo sethempeli leNkosi, abapristi beqgoke izambatho zabo bephethe impondo zokukhaliswa basondela kanye lamaLevi, amadodana kaAsafi, elezigubhu ukuba badumise iNkosi, ngendlela eyamiswa nguDavida inkosi yakoIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
