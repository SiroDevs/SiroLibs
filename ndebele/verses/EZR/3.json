            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho isifikile inyanga yesikhombisa, labakoIsrayeli sebehlezi emizini yabo, abantu babuthana eJerusalema njengomuntu munye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.1",
            "verseOrgIds": [
              "EZR.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasuka uJeshuwa indodana kaJozadaki kanye labanye abapristi, loZerubabeli indodana kaSalatiyeli lezihlobo zakhe, bakha ialtare likaNkulunkulu kaIsrayeli ukuba banikele iminikelo yokutshiswa phezu kwalo, njengokulotshiweyo emlayweni kaMose umuntu kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.2",
            "verseOrgIds": [
              "EZR.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.1"
              },
              "items": [
                {
                  "text": "Eks 27:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.2",
            "verseOrgIds": [
              "EZR.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balimisa ialtare endaweni yalo, lanxa babesesaba abantu balelolizwe, banikela eNkosini iminikelo yokutshiswa phezu kwalo ekuseni lantambama.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.1+NUM.28.2+NUM.28.3+NUM.28.4+NUM.28.5+NUM.28.6+NUM.28.7+NUM.28.8"
              },
              "items": [
                {
                  "text": "Nani 28:1–8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagcina umkhosi wamadumba njengokulotshiweyo, banikela iminikelo yokutshiswa insuku zonke njengokumiswa kwayo kwensuku ngensuku;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.4",
            "verseOrgIds": [
              "EZR.3.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.29.12+NUM.29.13+NUM.29.14+NUM.29.15+NUM.29.16+NUM.29.17+NUM.29.18+NUM.29.19+NUM.29.20+NUM.29.21+NUM.29.22+NUM.29.23+NUM.29.24+NUM.29.25+NUM.29.26+NUM.29.27+NUM.29.28+NUM.29.29+NUM.29.30+NUM.29.31+NUM.29.32+NUM.29.33+NUM.29.34+NUM.29.35+NUM.29.36+NUM.29.37+NUM.29.38"
              },
              "items": [
                {
                  "text": "Nani 29:12–38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.4",
