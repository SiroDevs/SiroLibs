              "type": "text"
            }
          ]
        },
        {
          "text": "Wafa eseluphele kakhulu eseleminyaka eminengi lenotho lodumo; uSolomoni indodana yakhe waba yinkosi esikhundleni sakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.28",
