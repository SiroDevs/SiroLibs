              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida indodana kaJese wayebuse uIsrayeli wonke; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.26",
            "verseOrgIds": [
              "1CH.29.26"
