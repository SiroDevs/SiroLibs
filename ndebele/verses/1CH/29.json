          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izenzo zenkosi uDavida ezokuqala lezokucina zilotshiwe engwalweni zezindaba zikaSamuweli umboni lengwalweni zezindaba zikaNathani umprofethi lengwalweni zezindaba zikaGadi umboni, ",
          "type": "text",
