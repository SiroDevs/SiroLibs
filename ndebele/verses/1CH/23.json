          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba njengokutsho kukaDavida kokucina amaLevi abhalwa kusukela kwaleminyaka engamatshumi amabili kusiya phezulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.27",
            "verseOrgIds": [
              "1CH.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umsebenzi wawo wawuyikusiza amadodana kaAroni enkonzweni yethempeli, ukugcina amaguma lezindlu, lokuhlambulula zonke izinto ezingcwele, lokwenza eminye imisebenzi yethempeli,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
