                "loc": "NUM.3.5+NUM.3.6+NUM.3.7+NUM.3.8+NUM.3.9"
              },
              "items": [
                {
                  "text": "Nani 3:5–9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
