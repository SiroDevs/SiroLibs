              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekuthwaseni komnyaka ngesikhathi sokuhlasela kwamakhosi uJowabi wakhokhela impi, wahlasela ilizwe lamaAmoni, wavimbezela iRaba. Kodwa uDavida wayesele eJerusalema. UJowabi walihlasela iRaba, walichitha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.1",
            "verseOrgIds": [
              "1CH.20.1"
            ]
          }
        },
