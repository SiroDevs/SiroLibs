          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoIsakari abantu ababelokwazi izikhathi ezifanele okungenziwa nguIsrayeli babezinduna ezingamakhulu amabili lezihlobo zabo zonke ezaziphethwe yibo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.32",
            "verseOrgIds": [
              "1CH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoZebuluni babezinkulungwane ezingamatshumi amahlanu zabantu abafundiswe ukulwa, behlomele impi ngazo zonke izikhali zokulwa ukuba basize uDavida ngenhliziyonye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.33",
            "verseOrgIds": [
              "1CH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoNafitali babengabantu abayizinkulungwane ezingamatshumi amathathu lesikhombisa behlomile ngezihlangu lemikhonto, belezinduna eziyinkulungwane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.34",
            "verseOrgIds": [
              "1CH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoDani babengabantu abayizinkulungwane ezingamatshumi amabili lesificaminwembili lamakhulu ayisithupha behlomele ukulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.35",
            "verseOrgIds": [
              "1CH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoAsheri babeyizinkulungwane ezingamatshumi amane zamabutho alungele ukulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.36",
            "verseOrgIds": [
              "1CH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoRubeni labakoGadi lengxenye yesizwe sakoManase ababevela ngaphetsheya kweJordani babezinkulungwane ezilikhulu lamatshumi amabili zabantu abahlomileyo ngazo zonke izikhali zokulwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.37",
            "verseOrgIds": [
              "1CH.12.37"
            ]
          }
        }
      ]
    },
