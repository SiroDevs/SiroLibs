      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanka amadodana kaRubeni izibulo likaIsrayeli — wayelizibulo, kodwa njengoba wayelele lomunye wabafazi bakayise, ubuzibulo bakhe banikwa amadodana kaJosefa indodana kaIsrayeli; futhi wayengalotshwanga njengezibulo;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.1",
            "verseOrgIds": [
              "1CH.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
