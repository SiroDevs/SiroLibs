    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abakoIsrayeli balotshwa ngezizukulwana zabo ogwalweni lwamakhosi akoIsrayeli; kodwa abakoJuda bathunjwa besiwa eBabiloni ngenxa yezono zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.1",
            "verseOrgIds": [
              "1CH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abokuqala abakha futhi elizweni labo bahlala emizini yabo babengabantu bakoIsrayeli, labapristi, lamaLevi, lezinceku zasethempelini.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.2",
            "verseOrgIds": [
              "1CH.9.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.2.27"
              },
              "items": [
                {
                  "text": "Ezra 2:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.7.73"
              },
              "items": [
                {
                  "text": "Neh 7:73",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.2",
            "verseOrgIds": [
              "1CH.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanye bakoJuda labakoBenjamini labakoEfrayimi labakoManase bahlala eJerusalema; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.3",
            "verseOrgIds": [
              "1CH.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwakunguUthayi indodana kaAmihudi kaOmri kaImri kaBani, omunye wamadodana kaPerezi kaJuda; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.4",
            "verseOrgIds": [
              "1CH.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakumaShiloni kungoAsaya izibulo, lamadodana akhe; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.5",
            "verseOrgIds": [
              "1CH.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakumadodana kaZera kunguJeyuweli lezihlobo zawo ezingamakhulu ayisithupha lamatshumi aficamunwemunye; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.6",
            "verseOrgIds": [
              "1CH.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwabakoBenjamini uSalu indodana kaMeshulamu kaHodaviya kaHasenuwa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.7",
            "verseOrgIds": [
              "1CH.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "loIbineya indodana kaJerohamu, loEla indodana kaUzi kaMikiri, loMeshulamu indodana kaShefathiya kaRehuweli kaIbinija, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.8",
            "verseOrgIds": [
              "1CH.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "lezihlobo zabo ezilotshwa ngezizukulwana zazo ezingamakhulu aficamunwemunye lamatshumi amahlanu lesithupha. Bonke labo babeyizinhloko zezindlu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.9",
            "verseOrgIds": [
              "1CH.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.9",
            "verseOrgIds": [
              "1CH.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abapristi babengoJedaya loJehoyaribi loJakini ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.10",
            "verseOrgIds": [
              "1CH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "loAzariya indodana kaHilikiya kaMeshulamu kaZadoki kaMerayothi kaAhitubi, umphathi wendlu kaNkulunkulu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.11",
            "verseOrgIds": [
              "1CH.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "loAdaya indodana kaJerohamu kaPashuri kaMalikiya loMahasayi kaAdiyeli kaJahizera kaMeshulamu kaMeshilemithi kaImeri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.12",
            "verseOrgIds": [
              "1CH.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanye lezihlobo zabo, izinhloko zezindlu, beyinkulungwane lamakhulu ayisikhombisa lamatshumi ayisithupha, abantu abalamandla lolwazi ngenkonzo yendlu kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.13",
            "verseOrgIds": [
              "1CH.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.13",
            "verseOrgIds": [
              "1CH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaLevi ayengoShemaya indodana kaHashubi kaAzirikamu kaHashabiya, omunye wamadodana kaMerari, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.14",
            "verseOrgIds": [
              "1CH.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "loBakibakari loHereshi loGalali loMathaniya indodana kaMika kaZikiri kaAsafi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.15",
            "verseOrgIds": [
              "1CH.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "loObadiya indodana kaShemaya kaGalali kaJeduthuni, loBerekiya indodana kaAsa kaElkana owahlala emizini yamaNetofa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.16",
            "verseOrgIds": [
              "1CH.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.16",
            "verseOrgIds": [
              "1CH.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagcini bamasango babengoShaluma loAkubi loTalimoni loAhimani lezihlobo zabo; uShaluma wayeyinhloko yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.17",
            "verseOrgIds": [
              "1CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaze kwaba yilesosikhathi babengabagcini bamasango ezihonqweni zamaLevi ngasesangweni lenkosi, ngasempumalanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.18",
            "verseOrgIds": [
              "1CH.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "UShaluma indodana kaKore kaEbiyasafi kaKora, lezihlobo zakhe zamaKora, baphatha umsebenzi wokulinda iminyango yeTabernakeli, njengalokhu okhokho babo babelindile izintuba zesihonqo seNkosi uNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.19",
            "verseOrgIds": [
              "1CH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UFiniyasi indodana kaEleyazare wayengumphathi wabo ngaphambili; iNkosi kayibe laye! ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.20",
            "verseOrgIds": [
              "1CH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "UZekariya indodana kaMeshelemiya wayengumgcini wesango lethente lokuhlangana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.21",
            "verseOrgIds": [
              "1CH.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke labo abakhethwayo baba ngabagcini bamasango babengamakhulu amabili letshumi lambili; balotshwa ngezizukulwana zabo emizini yabo. ODavida loSamuweli umboni babamisa ezikhundleni zabo ngenxa yokuthembeka kwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.22",
            "verseOrgIds": [
              "1CH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bona lamadodana abo baphatha umsebenzi wokulinda amasango ethempeli, ithente lokuhlangana kwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.23",
            "verseOrgIds": [
              "1CH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalindi bamasango babekhona ezinhlangothini zozine, ngasempumalanga langasentshonalanga langasenyakatho langaseningizimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.24",
            "verseOrgIds": [
              "1CH.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izihlobo zabo ezazisemizini yabo zazifanele ukuyalinda labo ngezikhathi ngezikhathi, okwensuku eziyisikhombisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.25",
            "verseOrgIds": [
              "1CH.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagcini bamasango abakhulu bobane babengamaLevi, belamandla agcweleyo, bekhangela izindlu lempahla endlini kaNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.26",
            "verseOrgIds": [
              "1CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babehlala ebusuku ngasendlini kaNkulunkulu, ngoba umsebenzi wabo wawuyikuyilinda lokuyivula insuku zonke ekuseni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.27",
            "verseOrgIds": [
              "1CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanye babo babelondoloza izitsha zenkonzo, bezibala lapho zikhutshwa lalapho zingeniswa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.28",
            "verseOrgIds": [
              "1CH.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labanye babo babelondoloza impahla lazo zonke izitsha ezingcwele, lempuphu ecolekileyo, lewayini lamafutha, lempepha, lamakha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.29",
            "verseOrgIds": [
              "1CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanye abapristi babelungisa amafutha okwenza amakha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.30",
            "verseOrgIds": [
              "1CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMathithiya umLevi, izibulo likaShaluma umKora, waphatha umsebenzi wokupheka amaqebelengwana ngoba ethembekile. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.31",
            "verseOrgIds": [
              "1CH.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanye bezihlobo zamaKohathi babephethe umsebenzi wokulungisa isinkwa esahlukaniselwe uNkulunkulu ngamaSabatha wonke.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.32",
            "verseOrgIds": [
              "1CH.9.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.32",
            "verseOrgIds": [
              "1CH.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba bangabahlabeleli, beyizinhloko zezindlu zamaLevi; babehlala ezindlini zethempeli lapho bekhululekile kweminye imisebenzi, ngoba babefanele ukusebenza emini lebusuku.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.33",
            "verseOrgIds": [
              "1CH.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.33",
            "verseOrgIds": [
              "1CH.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labo bayizinhloko zezindlu zamaLevi ngezizukulwana zabo, bahlala eJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.34",
            "verseOrgIds": [
              "1CH.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.34",
            "verseOrgIds": [
              "1CH.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehiyeli uyise kaGibeyoni wahlala eGibeyoni; ibizo lomkakhe lalinguMahaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.35",
            "verseOrgIds": [
              "1CH.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana akhe ayengoAbidoni izibulo, eselanywa nguZuri loKishi loBali loNeri loNadabi ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.36",
            "verseOrgIds": [
              "1CH.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "loGedori loAhiyo loZekariya loMikilothi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.37",
            "verseOrgIds": [
              "1CH.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMikilothi wazala uShimeyamu; laba labo babehlala eJerusalema eduze lezihlobo zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.38",
            "verseOrgIds": [
              "1CH.9.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNeri wazala uKishi; uKishi wazala uSawuli; uSawuli wazala uJonathani loMalikishuwa loAbinadaba loEshi‐Bali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.39",
            "verseOrgIds": [
              "1CH.9.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indodana kaJonathani yayinguMeribali; uMeribali wazala uMika. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.40",
            "verseOrgIds": [
              "1CH.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaMika ayengoPithoni loMeleki loTareya loAhazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.41",
            "verseOrgIds": [
              "1CH.9.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAhazi wazala uJara; uJara wazala oAlemethi loAzimavethi loZimri. UZimri wazala uMoza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.42",
            "verseOrgIds": [
              "1CH.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMoza wazala uBineya, owazala uRefaya, owazala uEleyasa, uyise kaAzeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.43",
            "verseOrgIds": [
              "1CH.9.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 9:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAzeli wayelamadodana ayisithupha, oAzirikamu loBokeru loIshmayeli loSheyariya loObadiya loHanani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.44",
            "verseOrgIds": [
              "1CH.9.44"
            ]
          }
        }
      ]
    }
