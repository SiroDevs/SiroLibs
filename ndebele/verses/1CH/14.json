            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHiramu inkosi yaseTire wathuma izithunywa kuDavida, lemikusu, lababazi bamatshe labezigodo ukumakhela uDavida indlu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.1",
            "verseOrgIds": [
              "1CH.14.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.11+2SA.5.12+2SA.5.13+2SA.5.14+2SA.5.15+2SA.5.16"
              },
              "items": [
                {
                  "text": "2 Sam 5:11–16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.1",
            "verseOrgIds": [
              "1CH.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wabona ukuthi iNkosi yayimmisile ukuba abe yinkosi koIsrayeli, lokuthi iwuphakamisile umbuso wakhe ngenxa yabantu bayo uIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.2",
            "verseOrgIds": [
              "1CH.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.2",
            "verseOrgIds": [
              "1CH.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wathatha abanye abafazi eJerusalema, wazala amanye amadodana lamadodakazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.3",
            "verseOrgIds": [
              "1CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanka amabizo alabo abazalelwa eJerusalema; oShamuwa, loShobabi loNathani, loSolomoni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.4",
            "verseOrgIds": [
              "1CH.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "loIbihari, loElishuwa, loElipeleti ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.5",
            "verseOrgIds": [
              "1CH.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "loNoga loNefegi, loJafiya ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.6",
            "verseOrgIds": [
              "1CH.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "loElishama, loBeyeliyada loElifeleti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.7",
            "verseOrgIds": [
              "1CH.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.7",
            "verseOrgIds": [
              "1CH.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi amaFilistiya esezwile ukuba uDavida ugcotshiwe ukuba abe yinkosi yabo bonke abakoIsrayeli, wonke amaFilistiya enyuka ukuyamdinga; uDavida wakuzwa lokhu, waphuma ukuyakulwa lawo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.8",
            "verseOrgIds": [
              "1CH.14.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.17+2SA.5.18+2SA.5.19+2SA.5.20+2SA.5.21+2SA.5.22+2SA.5.23+2SA.5.24+2SA.5.25"
              },
              "items": [
                {
                  "text": "2 Sam 5:17–25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.8",
            "verseOrgIds": [
              "1CH.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaFilistiya ayefikile ukuhlasela esihotsheni saseRefayimi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.9",
            "verseOrgIds": [
              "1CH.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasebuza kuNkulunkulu esithi: Ngiyewahlasela amaFilistiya na? Uzawanikela esandleni sami na? INkosi yathi kuye: Yebo, hamba, ngoba ngizawanikela esandleni sakho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.10",
            "verseOrgIds": [
              "1CH.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida waya eBali‐Perazimi, wawahlula khona amaFilistiya, wathi: UNkulunkulu uzifohlile izitha zami ngesandla sami njengamanzi afohlayo. Ngakhoke leyondawo yasithiwa yiBali‐Perazimi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.11",
            "verseOrgIds": [
              "1CH.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaFilistiya abaleka atshiya onkulunkulu bawo lapho, uDavida wathi kabatshiswe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.12",
            "verseOrgIds": [
              "1CH.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.12",
            "verseOrgIds": [
              "1CH.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaFilistiya abuya ahlasela esihotsheni futhi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.13",
            "verseOrgIds": [
              "1CH.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho uDavida ebuza futhi kuNkulunkulu, yena wathi kuye: Ungayi; bhoda ngemva kwawo, uwasukele maqondana lezihlahla zebhalisamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.14",
            "verseOrgIds": [
              "1CH.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzakuthi lapho usizwa umsindo wokuhamba phezu kwezihlahla uwahlaseleke, ngoba ngizabe ngihamba phambi kwakho ukunqoba impi yamaFilistiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.15",
            "verseOrgIds": [
              "1CH.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wenza njengokulaywa kwakhe nguNkulunkulu, wawaxotsha amaFilistiya kusukela eGibeyoni kwaze kwafika eGezeri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.16",
            "verseOrgIds": [
              "1CH.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udomo lukaDavida lwafinyelela kuwo wonke amazwe; iNkosi yenza zonke izizwe ukuba zimesabe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.17",
            "verseOrgIds": [
              "1CH.14.17"
            ]
          }
        }
      ]
    }
  ],
