          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMizirayimi wazala amaLudi lamaAnami lamaLehabi lamaNafetuhi ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.11",
            "verseOrgIds": [
              "1CH.1.11"
            ]
          }
