        },
        {
          "text": "Amadodana kaJafethi ayengoGomeri loMagogi loMadayi loJavani loTubali loMesheki loTirasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.5",
            "verseOrgIds": [
              "1CH.1.5"
