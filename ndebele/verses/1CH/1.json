          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaKushi ayengoSeba loHavila loSabitha loRama loSabitheka. Amadodana kaRama ayengoSheba loDedani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.9",
            "verseOrgIds": [
              "1CH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UKushi wazala uNimrodi owaba liqhawe lokuqala emhlabeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.10",
            "verseOrgIds": [
              "1CH.1.10"
            ]
