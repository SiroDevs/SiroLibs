          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanka amadodana kaIshmayeli njengokuzalwa kwawo; izibulo likaIshmayeli kwakunguNebayothi, elandelwa ngoKedari loAdibeli loMibisama ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.29",
            "verseOrgIds": [
              "1CH.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "loMishima loDuma loMasa loHadadi loTema ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.30",
            "verseOrgIds": [
              "1CH.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "loJeturi loNafishi loKedema; yiwo lawoke amadodana kaIshmayeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.31",
            "verseOrgIds": [
              "1CH.1.31"
            ]
          }
        }
