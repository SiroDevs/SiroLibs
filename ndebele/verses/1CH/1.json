          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "UEberi wazala amadodana amabili, ibizo lenye linguPelegi, ngoba ensukwini zayo umhlaba wadatshulwa; ibizo lomfowabo lalinguJokithani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.19",
            "verseOrgIds": [
              "1CH.1.19"
            ]
          }
