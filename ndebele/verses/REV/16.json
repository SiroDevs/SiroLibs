              },
              "items": [
                {
                  "text": "Eks 9:10",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lesithunywa sesibili sathululela olwandle okusemganwini waso; lwaselusiba njengegazi lomuntu ofileyo, lakho konke okuphilayo okusolwandle kwafa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isithunywa sesithathu sathululela okusemganwini waso emifuleni lasemithonjeni yamanzi; kwaphenduka kwaba ligazi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.4",
            "verseOrgIds": [
              "REV.16.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.17+EXO.7.18+EXO.7.19+EXO.7.20+EXO.7.21"
              },
              "items": [
                {
                  "text": "Eks 7:17–21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.44"
              },
              "items": [
                {
                  "text": "Hubo 78:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.4",
            "verseOrgIds": [
              "REV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngezwa isithunywa samanzi sisithi: Wena oNgcwele okhona lowayekhona, ulungile ngokuthonisisa kwakho; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba abantu bachitha igazi labangcwele lelabaprofethi, wabanika ukuba balinathe igazi; lokhu kubafanele. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.6",
            "verseOrgIds": [
              "REV.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengisizwa ialtare lisithi: Yebo, Nkosi Nkulunkulu, Somandla, kuqotho kulungile ukuthonisisa kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isithunywa sesine sathululela elangeni okusemganwini waso; lavunyelwa ukutshisa abantu ngomlilo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.8",
            "verseOrgIds": [
              "REV.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu batshiswa yikutshisa okukhulu; kodwa balithuka ibizo likaNkulunkulu obelamandla phezu kwalezizifo, kabaphendukanga ukuba bamdumise.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.9",
            "verseOrgIds": [
              "REV.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.9",
            "verseOrgIds": [
              "REV.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isithunywa sesihlanu sathululela okusemganwini waso phezu kwesihlalo sesilo; lombuso waso waba semnyameni. Abantu baxhanxatha inlimi zabo ngenxa yobuhlungu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.10.21"
              },
              "items": [
                {
                  "text": "Eks 10:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa bamthuka uNkulunkulu wezulu ngenxa yobuhlungu bezilonda zabo, kabaphendukanga emisebenzini yabo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isithunywa sesithupha sathululela okusemganwini waso emfuleni omkhulu iYufrathi; kwatsha amanzi awo, ukuba indlela ilungiselwe amakhosi avela ngasempumalanga.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.12",
            "verseOrgIds": [
              "REV.16.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.15"
              },
              "items": [
                {
                  "text": "Isa 11:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.12",
            "verseOrgIds": [
              "REV.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngabona kuphuma emlonyeni womgobho, lasemlonyeni wesilo, lasemlonyeni womprofethi wamanga, imimoya engcolileyo emithathu efana lamaxoxo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yona ingomoya ababi abenza izibonakaliso, abaphuma ukuya emakhosini omhlaba wonke ukuwahlanganisela ekulweni ngosuku olukhulu lukaNkulunkulu, uSomandla. — ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.14",
            "verseOrgIds": [
              "REV.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khangela, ngiyeza njengesela. Ubusisiwe olindayo, alondoloze ingubo zakhe ukuba angahambize, kuze kubonwe ihlazo lakhe. — ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
            "verseOrgIds": [
              "REV.16.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
