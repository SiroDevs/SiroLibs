            "sid": "REV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengisizwa ilizwi elikhulu livela ethempelini lisithi kuzo izithunywa eziyisikhombisa: Hambani, lithululele emhlabeni okusemiganwini eyisikhombisa okululaka lukaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isithunywa sokuqala sahambake, sathululela okusemganwini waso emhlabeni; kwasekuvela ebantwini abalophawu lwesilo labakhonza umfanekiso waso izilonda ezimbi ezibuhlungu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
