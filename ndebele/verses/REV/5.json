            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengibona phakathi kwesihlalo sobukhosi lezidalwa ezine eziphilayo langaphakathi kwabadala iWundlu limi kungathi lihlatshiwe, lilempondo eziyisikhombisa lamehlo ayisikhombisa okungomoya abayisikhombisa bakaNkulunkulu, abathunyelwe kuwo wonke umhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.6",
            "verseOrgIds": [
              "REV.5.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
