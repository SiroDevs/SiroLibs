                "loc": "ISA.53.7"
              },
              "items": [
                {
                  "text": "Isa 53:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.4.10"
              },
              "items": [
                {
                  "text": "Zek 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.6",
            "verseOrgIds": [
              "REV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leza, layithatha incwadi esandleni sakhe sokunene ohlezi esihlalweni sobukhosi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.7",
            "verseOrgIds": [
              "REV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuthe seliyithethe incwadi, izidalwa ezine eziphilayo labadala abangamatshumi amabili lane baziwisela phansi phambi kweWundlu, kuyilowo lalowo ephethe ichacho lemiganu yegolide igcwele impepha eyimikhuleko yabangcwele.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.8",
            "verseOrgIds": [
              "REV.5.8"
            ]
          }
        },
