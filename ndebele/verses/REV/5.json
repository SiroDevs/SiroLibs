              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengibona esandleni sokunene sakhe owayehlezi esihlalweni sobukhosi incwadi elotshwe ngaphakathi langaphandle, inanyekiwe ngempawu eziyisikhombisa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.1",
            "verseOrgIds": [
              "REV.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
