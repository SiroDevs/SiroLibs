          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhosi omhlaba aphinga lalo ezikholisa lalo azakukhala alile, lapho ebona intuthu yokutsha kwalo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.9",
            "verseOrgIds": [
