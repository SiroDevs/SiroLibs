          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba izono zalo zifinyelele ezulwini, loNkulunkulu ukhumbule ukungalungi kwalo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.5",
            "verseOrgIds": [
              "REV.18.5"
            ]
          }
        },
        {
