            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokho ngabona esinye isithunywa sisehla sivela ezulwini, silamandla amakhulu, lomhlaba wakhanyiswa yikukhazimula kwaso. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.1",
            "verseOrgIds": [
              "REV.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samemeza ngelizwi elikhulu sisithi: Liwile, liwile iBabiloni elikhulu! Seliyindawo yokuhlala omoya ababi, indawo yokuhlala omoya bonke abangcolileyo lezinyoni zonke ezingcolileyo lezizondekayo;",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
