          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "amaxolo esihlahla esithiwa ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.13",
            "verseOrgIds": [
              "REV.18.13"
            ]
          }
        },
        {
          "text": ", lokulephunga elimnandi, lempepha, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.13",
            "verseOrgIds": [
              "REV.18.13"
            ]
          }
        },
        {
          "text": ", lamakha, lewayini, lamafutha, lempuphu ecolekileyo, lamabele; inkomo lezimvu, amabhiza, lezinqola, lezigqili, lemiphefumulo yabantu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.13",
            "verseOrgIds": [
              "REV.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazakuthi: Izithelo ezazifiswa ngumphefumulo wakho zisukile kuwe, lakho konke okunothileyo lokukhazimulayo kukulahlekele, kakusoze kubuye kufunyaniswe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.14",
            "verseOrgIds": [
              "REV.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abathengisi balezizinto abanothiswe yilo bazakuma khatshana, besesaba ukuhlupheka kwalo, bekhala, belila kakhulu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.15",
            "verseOrgIds": [
              "REV.18.15"
            ]
          }
        },
