          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azakuma khatshana ngokwesaba ukuhlupheka kwalo esithi: Maye, maye kuwe muzi omkhulu waseBabiloni! Ngesikhatshana kufikile kuwe ukuthonisiswa kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
