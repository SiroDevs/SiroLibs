        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.6",
            "verseOrgIds": [
              "REV.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Linikeni ukuhlupheka lokulila okungangalokho elizidumise lazikholisa ngakho. Lithi enhliziyweni yalo: Ngihlezi ngiyinkosikazi, kangisuye umfelwakazi, futhi kangisoze ngabona ukulila.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.7",
            "verseOrgIds": [
              "REV.18.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.47.7+ISA.47.8+ISA.47.9"
              },
              "items": [
                {
                  "text": "Isa 47:7–9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.7",
            "verseOrgIds": [
              "REV.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke zizakufika ngasuku lunye izifo zalo, imikhuhlane lokulila lendlala, futhi lizakutshiswa ngomlilo; ngoba iNkosi uNkulunkulu elithonisisayo ilamandla.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.8",
            "verseOrgIds": [
              "REV.18.8"
            ]
          }
        }
      ]
    },
