          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.11",
            "verseOrgIds": [
              "REV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "impahla yegolide lesiliva, lamatshe amahle, lamangqongqo aligugu, lamalembu amahle ayibubende layisilika labomvu; lazo zonke izihlahla ezilephunga, lezinto zempondo zendlovu, lezinto zezihlahla ezibiza imali enengi, lezethusi, lezensimbi, lezelitshe elimhlophe;",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.12",
            "verseOrgIds": [
              "REV.18.12"
            ]
          }
        },
