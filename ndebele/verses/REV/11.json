          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isithunywa sesikhombisa salukhalisa uphondo; kwezwakala amazwi amakhulu ezulwini esithi:",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.15",
