                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Kho 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.17+EXO.7.18+EXO.7.19"
              },
              "items": [
                {
                  "text": "Eks 7:17–19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.4.8"
              },
              "items": [
                {
                  "text": "1 Sam 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.6",
            "verseOrgIds": [
              "REV.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzakuthi sebebuqedile ubufakazi babo, isilo esiphuma emgodini ongelamkhawulo silwe labo, sibanqobe, sibabulale.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.7",
            "verseOrgIds": [
              "REV.11.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
