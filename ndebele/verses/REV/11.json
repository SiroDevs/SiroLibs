        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba kukhona ofuna ukubalimaza laba, kuphuma umlilo emilonyeni yabo, uqothule izitha zabo; uzakufa ngokunjalo ofisa ukubalimaza. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.5",
            "verseOrgIds": [
              "REV.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamandla laba okuvala izulu ukuba lingani ngezinsuku zokutshumayela kwabo; futhi balamandla phezu kwamanzi okuba bawaphendule abe ligazi lawokwehlisela umhlaba izifo zonke ngokuthanda kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.6",
            "verseOrgIds": [
              "REV.11.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
