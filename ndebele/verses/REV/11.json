          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.18",
            "verseOrgIds": [
              "REV.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekuvulwa ithempeli likaNkulunkulu elisezulwini, kwabonakala umtshokotsho ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.19",
            "verseOrgIds": [
              "REV.11.19"
            ]
          }
        },
