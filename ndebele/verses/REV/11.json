            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasenginikwa umhlanga wokulinganisa, ofana lodondolo, kwathiwa: Sukuma, ulinganise ithempeli likaNkulunkulu, lealtare, ubale labakhonzayo khona.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.1",
            "verseOrgIds": [
              "REV.11.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
