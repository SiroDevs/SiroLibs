          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.3",
            "verseOrgIds": [
              "REV.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba bayizihlahla ezimbili ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.4",
            "verseOrgIds": [
              "REV.11.4"
            ]
          }
        },
        {
          "text": " lezinti zezibane ezimbili ezimiswe phambi kweNkosi yomhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.4",
            "verseOrgIds": [
              "REV.11.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
