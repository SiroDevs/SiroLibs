          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.7",
            "verseOrgIds": [
              "REV.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina Johane nginguye owazizwayo lowazibonayo lezizinto. Kuthe sengizizwile, ngazibona, ngaziwisela phansi ukuba ngikhuleke ngasenyaweni zesithunywa esangitshengisa zona. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.8",
            "verseOrgIds": [
              "REV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa sathi kimi: Musa ukukwenza lokhu; ngiyinceku kanye lawe labazalwane bakho abaprofethi lalabo abagcina amazwi alincwadi. Khonza uNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.9",
            "verseOrgIds": [
              "REV.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
