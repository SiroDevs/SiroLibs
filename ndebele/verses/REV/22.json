          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasengitshengisa umfula wamanzi okuphila acwengekileyo kakhulu, evela esihlalweni sobukhosi sikaNkulunkulu leseWundlu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.1",
            "verseOrgIds": [
              "REV.22.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.47.1"
              },
              "items": [
                {
                  "text": "Hez 47:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.14.8"
              },
              "items": [
                {
                  "text": "Zek 14:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.1",
            "verseOrgIds": [
              "REV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "egeleza phakathi kwendlela yomuzi. Kwakumi inxa zombili zomfula isihlahla sokuphila esithela izithelo ezilitshumi lambili, sithela izithelo zaso inyanga ngenyanga, lamahlamvu aso angawokwelapha izizwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.2",
            "verseOrgIds": [
              "REV.22.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.9"
              },
              "items": [
                {
                  "text": "Gen 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.2",
            "verseOrgIds": [
              "REV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakusayikuba khona lokukodwa okuqalekisiweyo. Isihlalo sobukhosi sikaNkulunkulu leseWundlu zizakuba kuwo, lezinceku zakhe zizakumdumisa,",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.3",
            "verseOrgIds": [
              "REV.22.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.14.11"
              },
              "items": [
                {
                  "text": "Zek 14:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.3",
            "verseOrgIds": [
              "REV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "zizakubona ubuso bakhe, lebizo lakhe lizakuba semabunzini azo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.4",
            "verseOrgIds": [
              "REV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubusuku kabusayikuba khona; kazidingi ukukhanya kwesibane loba okwelanga, ngoba iNkosi uNkulunkulu izakuba yikukhanya kwazo; zizakubusa kuze kube nini lanini.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.5",
            "verseOrgIds": [
              "REV.22.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.19"
              },
              "items": [
                {
                  "text": "Isa 60:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.18"
              },
              "items": [
                {
                  "text": "Dan 7:18",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
