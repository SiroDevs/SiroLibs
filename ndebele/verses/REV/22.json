              "REV.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasesisithi kimi: Lamazwi aqinisile aqotho; iNkosi uNkulunkulu wemimoya yabaprofethi isithumile isithunywa sayo ukuzitshengisa inceku zayo okuzakwenzeka masinyane. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.6",
            "verseOrgIds": [
              "REV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khangela, ngiyeza masinyane. Ubusisiwe owagcinayo amazwi esiprofethi alotshiweyo kulincwadi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.7",
            "verseOrgIds": [
              "REV.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
