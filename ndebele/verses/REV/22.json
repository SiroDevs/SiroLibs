          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sathi kimi: Ungawenzi imfihlo amazwi esiprofethi alotshiweyo kulincwadi, ngoba isikhathi siseduze. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.10",
            "verseOrgIds": [
              "REV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ongalunganga kahlale esenza okungalunganga; ongcolileyo ahlale engcolile, kodwa olungileyo ahlale esenza ukulunga, longcwele ahlale engcwele.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.11",
            "verseOrgIds": [
              "REV.22.11"
            ]
          }
        },
        {
