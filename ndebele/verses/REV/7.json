        },
        {
          "text": "Emva kwalokhu ngabona izithunywa ezine zimi emagumbini womane omhlaba, zibambe imimoya emine yomhlaba ukuze kungavunguzi moya emhlabeni, lasolwandle, lakwesisodwa isihlahla.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.1",
            "verseOrgIds": [
              "REV.7.1"
            ]
          }
        },
        {
