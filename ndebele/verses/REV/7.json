              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengitshelwa ubunengi bababekwa uphawu, baba zinkulungwane ezilikhulu lamatshumi amane lane, ababekwa uphawu ezizweni zonke zakoIsrayeli; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.4",
            "verseOrgIds": [
              "REV.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "esizweni sakoJuda babekwa uphawu abayizinkulungwane ezilitshumi lambili; esizweni sakoRubeni baba zinkulungwane ezilitshumi lambili; esizweni sakoGadi baba zinkulungwane ezilitshumi lambili; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "esizweni sakoAsheri baba zinkulungwane ezilitshumi lambili; esizweni sakoNafitali baba zinkulungwane ezilitshumi lambili; esizweni sakoManase baba zinkulungwane ezilitshumi lambili; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.6",
            "verseOrgIds": [
              "REV.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
