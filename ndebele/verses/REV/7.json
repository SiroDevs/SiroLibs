          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "esizweni sakoSimeyoni baba zinkulungwane ezilitshumi lambili; esizweni sakoLevi baba zinkulungwane ezilitshumi lambili; esizweni sakoIsakari baba zinkulungwane ezilitshumi lambili; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.7",
            "verseOrgIds": [
              "REV.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
