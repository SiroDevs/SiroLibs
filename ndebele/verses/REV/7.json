          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokhu ngakhangela, ngabona ixuku elikhulu elingelakubalwa muntu, elivela kuzo zonke izizwe, lakuyo yonke imihlobo, lakibo bonke abantu, lasezindimini zonke, limi phambi kwesihlalo sobukhosi laphambi kweWundlu, lambethe ingubo ezimhlophe, liphethe ingatsha zamalala ezandleni, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.9",
            "verseOrgIds": [
              "REV.7.9"
            ]
          }
        },
