              "items": [
                {
                  "text": "Amos 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.5",
            "verseOrgIds": [
              "REV.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "safunga yena ophilayo kuze kube nininini, owadala izulu lakho konke okukulo, lomhlaba lakho konke okukuwo, lolwandle lakho konke okukulo, sathi: Kakusayikuphuzwa; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.6",
            "verseOrgIds": [
              "REV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa lapho sesifikile isikhathi sokuba isithunywa sesikhombisa sikhalise uphondo lwaso, kuzabe sekugcwalisekile imfihlakalo yecebo likaNkulunkulu ayithembisa ezincekwini zakhe abaprofethi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.7",
            "verseOrgIds": [
              "REV.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.7",
            "verseOrgIds": [
              "REV.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilizwi engalizwa livela ezulwini lakhuluma lami futhi lathi: Hamba uyethatha incwadi evulekileyo esesandleni sesithunywa esimi phezu kolwandle laphezu komhlabathi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.8",
            "verseOrgIds": [
              "REV.10.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Hez 2:8—3:3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.8",
            "verseOrgIds": [
              "REV.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaya kuso isithunywa, ngathi kuso kasinginike incwadi encinyane. Sathi kimi: Ithathe, uyidle uyiqede; izakubaba esiswini sakho, kodwa emlonyeni wakho izakuba mnandi njengenyosi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.9",
            "verseOrgIds": [
              "REV.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengiyithatha incwadi encinyane esandleni sesithunywa, ngayidla; yayimnandi njengenyosi emlonyeni wami; kodwa lapho sengiyidlile, yababa esiswini sami. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.10",
            "verseOrgIds": [
              "REV.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekuthiwa kimi: Kumele ukuba uphinde utshumayele ngabantu abanengi, langezizwe, langezindimi, langamakhosi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.11",
            "verseOrgIds": [
              "REV.10.11"
            ]
          }
        }
      ]
    }
