          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwake basekhona abantu abayingcosana eSardisi abangangcolisanga ingubo zabo; bazakuhamba lami bembethe okumhlophe, ngoba bafanele. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.4",
            "verseOrgIds": [
              "REV.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onqobayo uzakwambathiswa ngokunjalo ingubo ezimhlophe; kangiyikulesula ibizo lakhe encwadini yokuphila, ngoba ngizakulivuma phambi kukaBaba laphambi kwezithunywa zakhe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.5",
            "verseOrgIds": [
              "REV.3.5"
            ]
          }
        },
