          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi izithunywa eziyisikhombisa ezaziphethe impondo eziyisikhombisa zazilungisela ukuba zizikhalise.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.6",
