          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibizo lenkanyezi lalithiwa nguMhlonyane; ingxenye yesithathu yamanzi yaba njengomhlonyane, labantu abanengi bafa bebulawa ngamanzi, ngoba ayesebaba.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        },
