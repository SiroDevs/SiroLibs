          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isithunywa sesithathu salukhalisa uphondo; kwasekusiwa kuvela ezulwini inkanyezi enkulu ikhanya njengesibane, yawela phezu kwengxenye yesithathu yemifula laphezu kwemithombo yamanzi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
