            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isithunywa sesibili salukhalisa uphondo; kwaphoselwa olwandle ulutho olunjengentaba enkulu evutha umlilo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ingxenye yesithathu yolwandle yaphenduka yaba ligazi, kwafa ingxenye yesithathu yezidalwa eziphilayo ezisolwandle, kwafa ingxenye yesithathu yemikolo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
      ]
    },
    {
