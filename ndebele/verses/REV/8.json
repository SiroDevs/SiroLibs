            "sid": "REV 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isithunywa sokuqala salukhalisa uphondo; kwasekusiba khona isiqhotho lomlilo kuhlanganiswe legazi, kwaphoselwa emhlabeni; kwathi ingxenye yesithathu yomhlaba yatsha lengxenye yesithathu yezihlahla, labo bonke utshani obuluhlaza batshiswa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.7",
            "verseOrgIds": [
              "REV.8.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
