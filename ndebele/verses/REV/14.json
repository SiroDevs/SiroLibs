              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esinye isithunywa saphuma ethempelini elisezulwini, laso siphethe isikela ebukhali. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.17",
            "verseOrgIds": [
              "REV.14.17"
            ]
          }
        },
