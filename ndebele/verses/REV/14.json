          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanti ithuba lokubekezela kwabangcwele, labo abagcina imilayo kaNkulunkulu lokukholwa kuJesu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.12",
            "verseOrgIds": [
              "REV.14.12"
            ]
          }
        }
