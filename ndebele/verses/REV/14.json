            "number": "9",
            "style": "v",
            "sid": "REV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salandela esinye isithunywa sesithathu, simemeza ngelizwi elikhulu sisithi: Uba kukhona okhonza isilo lomfanekiso waso, obekwe uphawu ebunzini lakhe kumbe esandleni sakhe, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.9",
            "verseOrgIds": [
              "REV.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "laye uzakunatha iwayini lolaka lukaNkulunkulu elilungisiweyo enkezweni yolaka lwakhe, lingaxutshaniswanga; uzakuhlutshwa ngomlilo ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.10",
            "verseOrgIds": [
              "REV.14.10"
            ]
          }
        },
        {
          "text": " phambi kwezithunywa ezingcwele laphambi kweWundlu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.10",
            "verseOrgIds": [
              "REV.14.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
