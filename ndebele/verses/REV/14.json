          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lentuthu yomlilo wokuhlutshwa kwabo ithunqa kuze kube nininini; kabalakuphumula emini lebusuku laba abakhonza isilo lomfanekiso waso, lalowo obekwe uphawu lwebizo laso.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.11",
            "verseOrgIds": [
              "REV.14.11"
            ]
          }
        },
