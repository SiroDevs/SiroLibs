        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.7",
            "verseOrgIds": [
              "REV.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salandelwa ngesinye isithunywa sesibili sisithi: Liwile, liwile iBabiloni elikhulu, elinathise izizwe zonke iwayini lolaka lokuphinga kwabo!",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.8",
            "verseOrgIds": [
              "REV.14.8"
            ]
          }
        },
        {
