          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lalapho livula uphawu lwesibili, ngezwa isidalwa sesibili sisithi: Woza! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.3",
            "verseOrgIds": [
              "REV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekuphuma elinye ibhiza elibomvu, oligadileyo wavunyelwa ukuqeda ukuthula emhlabeni, ukuze abantu babulalane, wanikwa umhedla omkhulu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.4",
            "verseOrgIds": [
              "REV.6.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
