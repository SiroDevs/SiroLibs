            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengibona lapho iWundlu livula olunye lwezimpawu eziyisikhombisa, ngezwa esinye sezidalwa ezine eziphilayo sisithi ngelizwi elidumayo: Woza! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.1",
            "verseOrgIds": [
              "REV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhangela, ngabona ibhiza elimhlophe, oligadileyo ephethe umtshoko; wanikwa umqhele, waphuma engonqobayo lokuyakunqoba.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        },
