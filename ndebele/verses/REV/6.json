        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengisizwa kungathi yilizwi phakathi kwezidalwa ezine eziphilayo lisithi: Ingcebethu yamabele izakuthengwa ngendibilitshi ezilitshumi, lezingcebethu ezintathu ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        },
        {
          "text": " zizakuthengwa ngendibilitshi ezilitshumi; kodwa ungoni amafutha lewayini.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
