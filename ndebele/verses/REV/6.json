          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lalapho livula uphawu lwesithathu, ngezwa isidalwa sesithathu sisithi: Woza! Ngakhangela, ngabona ibhiza elimnyama, oligadileyo ephethe isilinganiso.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.5",
            "verseOrgIds": [
              "REV.6.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
