          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakuJesu Kristu ufakazi othembekileyo, olizibulo kwabafileyo lombusi wamakhosi omhlaba. Kuye osithandayo lowasikhulula ezonweni zethu ngegazi lakhe,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
