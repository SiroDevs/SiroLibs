          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengiphenduka ukuba ngimbone lowo obekhuluma lami; ngithe ngiphenduka, ngabona izinti zezibane zegolide eziyisikhombisa; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.12",
            "verseOrgIds": [
              "REV.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "phakathi kwezinti zezibane kukhona ofana lomuntu, embethe ingubo ekhawula enyaweni, ezibophe ngeqhele legolide esifubeni sakhe;",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
