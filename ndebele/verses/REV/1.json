        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lesi yisambulelo sikaJesu Kristu amnika sona uNkulunkulu, ukuba abonise inceku zakhe izinto ezimele ukwenzeka masinyane. Wathuma isithunywa sakhe ukuyibonisa inceku yakhe uJohane, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.1",
            "verseOrgIds": [
              "REV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "owafakazela ilizwi likaNkulunkulu lobufakazi bukaJesu Kristu lakukho konke akubonayo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.2",
            "verseOrgIds": [
              "REV.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubusisiwe owafundayo amazwi alesisiprofethi, babusisiwe lalabo abezwayo bagcine okulotshiweyo kuso, ngoba isikhathi siseduze.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.3",
            "verseOrgIds": [
              "REV.1.3"
            ]
          }
        }
      ]
    },
    {
