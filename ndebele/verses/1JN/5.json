  "copyright": "PUBLIC DOMAIN",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "1JN 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1JN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilowo lalowo okholwa ukuthi uJesu unguKristu, ungumntwana kaNkulunkulu; lalowo othanda umzali uthanda laye ozelweyo nguye. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.1",
            "verseOrgIds": [
              "1JN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho siyazi ukuthi siyabathanda abantwana bakaNkulunkulu, nxa sithanda uNkulunkulu silalela imilayo yakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.2",
            "verseOrgIds": [
              "1JN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ukumthanda uNkulunkulu yilokhu ukuba sigcine imilayo yakhe; lemilayo yakhe kayinzima.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.3",
            "verseOrgIds": [
              "1JN.5.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.15"
              },
              "items": [
                {
                  "text": "Joha 14:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.3",
            "verseOrgIds": [
              "1JN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba konke okuzelwe nguNkulunkulu kuyawunqoba umhlaba; lokho okunqoba umhlaba yikukholwa kwethu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.4",
            "verseOrgIds": [
              "1JN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngubani onqoba umhlaba uba kungesuye okholwa ukuthi uJesu uyiNdodana kaNkulunkulu na? ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.5",
            "verseOrgIds": [
              "1JN.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguye lo oweza ngamanzi langegazi, uJesu Kristu; kezanga ngamanzi kuphela, kodwa weza ngamanzi langegazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.6",
            "verseOrgIds": [
              "1JN.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMoya ungufakazi walokhu, ngoba uMoya uliqiniso. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.7",
            "verseOrgIds": [
              "1JN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathathu ofakazi, uMoya lamanzi legazi, laba abathathu bayavumelana. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.8",
            "verseOrgIds": [
              "1JN.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba sisamukela ubufakazi babantu, ubufakazi bukaNkulunkulu bukhulu kulalobo; ngoba ubufakazi bukaNkulunkulu buyilobu bokuthi ubufakazile ngeNdodana yakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.9",
            "verseOrgIds": [
              "1JN.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okholwa eNdodaneni kaNkulunkulu ulobufakazi phakathi kwakhe. Ongakholwa kuNkulunkulu umenza abe ngumqambi wamanga, ngoba engakholwanga yibufakazi uNkulunkulu abufakazileyo ngeNdodana yakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.10",
            "verseOrgIds": [
              "1JN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1JN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilobu ubufakazi ukuthi uNkulunkulu usinikile ukuphila okungapheliyo, lalokhukuphila kuseNdodaneni yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.11",
            "verseOrgIds": [
              "1JN.5.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.36"
              },
              "items": [
                {
                  "text": "Joha 3:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.11",
            "verseOrgIds": [
              "1JN.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olayo iNdodana ulokuphila; ongelayo iNdodana kalakho ukuphila.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.12",
            "verseOrgIds": [
              "1JN.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.12",
            "verseOrgIds": [
              "1JN.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1JN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngililobela lokhu lina elikholwayo ebizweni leNdodana kaNkulunkulu, ukuze lazi ukuthi lilokuphila okungapheliyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.13",
            "verseOrgIds": [
              "1JN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilesi isibindi esilaso kuye sokuthi, uba sicela ulutho ngokwentando yakhe, uyasizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.14",
            "verseOrgIds": [
              "1JN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba sisazi ukuthi uyasizwa loba sicelani, siyazi ukuthi sesikuzuzile esikucela kuye. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.15",
            "verseOrgIds": [
              "1JN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntu ebona umzalwane wakhe esenza isono esingesiso sokufa, kamkhulekele kuNkulunkulu; uzakumnika ukuphila, ngitsho labo abangenzanga isono sokufa. Sikhona isono sokufa, kangitsho ukuba kukhulekelwe leso; ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.16",
            "verseOrgIds": [
              "1JN.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "konke ukungalungi kuyisono, kodwa kukhona isono esingesiso sokufa. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.17",
            "verseOrgIds": [
              "1JN.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siyazi ukuthi lowo ozelwe nguNkulunkulu koni; ngoba iNdodana kaNkulunkulu iyamgcina, loSathane kamthinti. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.18",
            "verseOrgIds": [
              "1JN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siyazi ukuthi thina singabakaNkulunkulu, lokuthi umhlaba wonke usemandleni kaSathane. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.19",
            "verseOrgIds": [
              "1JN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siyazi ukuthi iNdodana kaNkulunkulu isifikile, yasinika ukuqedisisa ukuze simazi oweqiniso; sikuye oweqiniso lokhu sikiyo iNdodana yakhe uJesu Kristu. Yena unguNkulunkulu weqiniso lokuphila okungapheliyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.20",
            "verseOrgIds": [
              "1JN.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1JN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantwana, zilondolozeni ezithombeni.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.21",
            "verseOrgIds": [
              "1JN.5.21"
            ]
          }
        }
      ]
    }
  ],
