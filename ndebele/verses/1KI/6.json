          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "text": " endaweni engaphakathi kwendlu; impiko zawo zazinabile, uphiko lwelinye luthinta umduli, lophiko lwelinye luthinta omunye umduli, ezinye impiko zawo zithintana ngaphakathi kwendlu. ",
          "type": "text",
          "attrs": {
