          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabaza kuzo imifanekiso ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        },
        {
          "text": " lezihlahla zamalala lamaluba, wazibhada ngegolide elendlala kuhle phezu kokubaziweyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
