        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wamakhulu amane lamatshumi aficaminwembili emva kokuphuma kwabakoIsrayeli eGibithe, ngomnyaka wesine wokubusa kukaSolomoni koIsrayeli, enyangeni kaZivi eyinyanga yesibili, uSolomoni waqala ukwakha ithempeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.1",
            "verseOrgIds": [
              "1KI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubude balo babuzingalo ezingamatshumi ayisithupha, ububanzi balo buzingalo ezingamatshumi amabili, lokuphakama kwalo kuzingalo ezingamatshumi amathathu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkoto owawungaphambili ubude bawo babuzingalo ezingamatshumi amabili ulingana lobubanzi bendlu, lobubanzi bawo buzingalo ezilitshumi ngaphambi kwendlu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.3",
            "verseOrgIds": [
              "1KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlu wayenzela amawindi abanzi ngaphandle kulangaphakathi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.4",
            "verseOrgIds": [
              "1KI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi wayenzela isakhiwo emdulini esibhoda lomduli wendlu, umduli wethempeli lowendlu engaphakathi. Wayenzela lezindlwana emaceleni wonke. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.5",
            "verseOrgIds": [
              "1KI.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlwana engaphansi ububanzi bayo babuzingalo ezinhlanu, lephakathi buzingalo eziyisithupha, leyesithathu buzingalo eziyisikhombisa. Ngaphandle kwendlu emdulini wenza izisekelo ukuba insika ezisekeleyo zingagxunyekwa emidulini yendlu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlu yakhiwa ngamatshe ayelungiswe enkwalini, ukuze kungezwakali ukukhala kwesando lehloka lesinye isikhali nje sensimbi ethempelini nxa lisakhiwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.7",
            "verseOrgIds": [
              "1KI.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.7",
            "verseOrgIds": [
              "1KI.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umnyango wendlwana engaphansi wawusohlangothini lwendlu olungaseningizimu, kukhwelwa ngesikhwelo ukuya endlwaneni engaphakathi, lokusuka endlwaneni engaphakathi kusiya endlwaneni yesithathu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.8",
            "verseOrgIds": [
              "1KI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayakhake indlu, wayiqeda; wakha uphahla lwayo ngamapulanka emikusu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.9",
            "verseOrgIds": [
              "1KI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlu yonke wayenzela isakhiwo, ubude baso buzingalo ezinhlanu, sixhunywe endlini ngezigodo zemikusu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.10",
            "verseOrgIds": [
              "1KI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.10",
            "verseOrgIds": [
              "1KI.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilizwi leNkosi lafika kuSolomoni lathi: ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.11",
            "verseOrgIds": [
              "1KI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayelana lendlu oyakhayo, uba uhamba ngezimiso zami, ulalela imithetho yami, ugcina yonke imilayo yami uhamba ngayo, ngizaligcwalisa ilizwi lami kuwe engalikhuluma kuyihlo uDavida; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.12",
            "verseOrgIds": [
              "1KI.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngizahlala phakathi kwabantu bakoIsrayeli, ngingabatshiyi abantu bami.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.13",
            "verseOrgIds": [
              "1KI.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.13",
            "verseOrgIds": [
              "1KI.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "USolomoni walakha ithempeli, waliqeda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.14",
            "verseOrgIds": [
              "1KI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakha imiduli yendlu engaphakathi ngamapulanka emikusu, kusukela phansi kuze kufike ophahleni, wayendlala phansi ngamapulanka ephane. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.15",
            "verseOrgIds": [
              "1KI.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasemsamo waquma indawo eyizingalo ezingamatshumi amabili, wayakhela ngamapulanka omkusu kusukela phansi kwaze kwafika ophahleni, yaba yindlwana engaphakathi okuthiwa yindlu engcwele kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.16",
            "verseOrgIds": [
              "1KI.6.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.33+EXO.26.34"
              },
              "items": [
                {
                  "text": "Eks 26:33–34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.16",
            "verseOrgIds": [
              "1KI.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlu engaphambi kwalindlwana ubude bayo babuzingalo ezingamatshumi amane. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.17",
            "verseOrgIds": [
              "1KI.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emikuswini engaphakathi kwendlu kwakubaziwe kuyo amaluba lamaqhaga; kwakuyimikusu yodwa, kungabonakali amatshe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.18",
            "verseOrgIds": [
              "1KI.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walungisa indlwana engaphakathi ukubeka kuyo umtshokotsho ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "text": " seNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlwana engaphakathi ubude bayo babuzingalo ezingamatshumi amabili, lobubanzi bayo kanye lokuphakama kwayo; wayigudula ngegolide elihle. Wenza lealtare ngamapulanka omkusu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.20",
            "verseOrgIds": [
              "1KI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "USolomoni wayigudula indlu ngaphakathi ngegolide elihle, wayivalela ngeveli elilamaketane egolide phambi kwendlwana engaphakathi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.21",
            "verseOrgIds": [
              "1KI.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlu yonke wayigudula ngegolide yaze yahlangana yathi ngqwa; lealtare lonke elisendlini engaphakathi walibhada ngegolide.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.22",
            "verseOrgIds": [
              "1KI.6.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.1+EXO.30.2+EXO.30.3"
              },
              "items": [
                {
                  "text": "Eks 30:1–3",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
