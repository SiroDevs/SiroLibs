              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iguma elingaphakathi walakhela ngamatshe abaziweyo ayimizila emithathu, wafaka umzila owodwa wezigodo zemikusu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
