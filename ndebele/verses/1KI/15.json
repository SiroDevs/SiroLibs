    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wetshumi lesificaminwembili wokubusa kwenkosi uJerobowamu indodana kaNebati uAbijamu waba yinkosi koJuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.1",
            "verseOrgIds": [
              "1KI.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabusa iminyaka emithathu eJerusalema. Ibizo likanina lalinguMahaka indodakazi kaAbishalomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.2",
            "verseOrgIds": [
              "1KI.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza zonke izono ezenziwa nguyise ngaphambi kwakhe, lenhliziyo yakhe yayingaphelelanga eNkosini uNkulunkulu wakhe njengenhliziyo kakhokho wakhe uDavida. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.3",
            "verseOrgIds": [
              "1KI.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngenxa kaDavida iNkosi uNkulunkulu wakhe yamnika isibane eJerusalema ngokubeka indodana yakhe esikhundleni sakhe langokuqinisa iJerusalema;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.4",
            "verseOrgIds": [
              "1KI.15.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.36"
              },
              "items": [
                {
                  "text": "1 Kho 11:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.4",
            "verseOrgIds": [
              "1KI.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba uDavida wenza okulungileyo phambi kweNkosi, kaphambukanga kukho konke eyamlaya khona insuku zonke zokuphila kwakhe ngaphandle kwendaba kaUriya umHethi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.5",
            "verseOrgIds": [
              "1KI.15.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.11.1+2SA.11.2+2SA.11.3+2SA.11.4+2SA.11.5+2SA.11.6+2SA.11.7+2SA.11.8+2SA.11.9+2SA.11.10+2SA.11.11+2SA.11.12+2SA.11.13+2SA.11.14+2SA.11.15+2SA.11.16+2SA.11.17+2SA.11.18+2SA.11.19+2SA.11.20+2SA.11.21+2SA.11.22+2SA.11.23+2SA.11.24+2SA.11.25+2SA.11.26+2SA.11.27"
              },
              "items": [
                {
                  "text": "2 Sam 11:1–27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.5",
            "verseOrgIds": [
              "1KI.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona impi phakathi kukaAbijamu loJerobowamu zonke insuku zokuhamba kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.6",
            "verseOrgIds": [
              "1KI.15.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.13.3+2CH.13.4+2CH.13.5+2CH.13.6+2CH.13.7+2CH.13.8+2CH.13.9+2CH.13.10+2CH.13.11+2CH.13.12+2CH.13.13+2CH.13.14+2CH.13.15+2CH.13.16+2CH.13.17+2CH.13.18+2CH.13.19+2CH.13.20+2CH.13.21"
              },
              "items": [
                {
                  "text": "2 Lan 13:3–21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.6",
            "verseOrgIds": [
              "1KI.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye indaba zikaAbijamu lakho konke akwenzayo kulotshiwe ogwalweni lwezindaba zamakhosi zakoJuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.7",
            "verseOrgIds": [
              "1KI.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbijamu waya kwabaphansi, bamngcwabela emzini kaDavida. UAsa indodana yakhe waba yinkosi esikhundleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.8",
            "verseOrgIds": [
              "1KI.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.8",
            "verseOrgIds": [
              "1KI.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wamatshumi amabili wokubusa kukaJerobowamu inkosi yakoIsrayeli uAsa waba yinkosi yakoJuda; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.9",
            "verseOrgIds": [
              "1KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wabusa iminyaka engamatshumi amane lanye eJerusalema. Ibizo likaninakhulu lalinguMahaka indodakazi kaAbishalomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.10",
            "verseOrgIds": [
              "1KI.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAsa wenza okulungileyo phambi kweNkosi njengoDavida ukhokho wakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.11",
            "verseOrgIds": [
              "1KI.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxotsha elizweni amadoda ayengamawule emathempeleni, wasusa zonke izithombe oyise ababezenzile.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.12",
            "verseOrgIds": [
              "1KI.15.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.15.8+2CH.15.9+2CH.15.10+2CH.15.11+2CH.15.12+2CH.15.13+2CH.15.14+2CH.15.15"
              },
              "items": [
                {
                  "text": "2 Lan 15:8–15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.12",
            "verseOrgIds": [
              "1KI.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakhupha loninakhulu uMahaka esikhundleni sokuba yindlovukazi, ngoba wayemenzele unkulunkulukazi ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.13",
            "verseOrgIds": [
              "1KI.15.13"
            ]
          }
        },
        {
          "text": " isithombe esinengisayo. UAsa wasigamula isithombe, wasitshisela esifuleni iKidroni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.13",
            "verseOrgIds": [
              "1KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanti indawo eziphakemeyo zokukhonzela kazivalwanga; kodwa inhliziyo kaAsa yayiqotho eNkosini insuku zakhe zonke. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.14",
            "verseOrgIds": [
              "1KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangenisa ethempelini izinto uyise ayezahlukanisele iNkosi, kanye lezakhe izinto ezahlukaniselwe iNkosi, isiliva legolide lezitsha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.15",
            "verseOrgIds": [
              "1KI.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.15",
            "verseOrgIds": [
              "1KI.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona impi phakathi kukaAsa loBahasha inkosi yakoIsrayeli zonke insuku zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.16",
            "verseOrgIds": [
              "1KI.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "UBahasha inkosi yakoIsrayeli wahlasela uJuda, wakha iRama ukuvalela abantu ukuba bangahambelani loAsa inkosi yakoJuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.17",
            "verseOrgIds": [
              "1KI.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAsa wasethatha sonke isiliva lalo lonke igolide okwakusele enothweni yethempeli lakweyakhe indlu, wakunika inceku zakhe, wazithuma kuBenihadadi indodana kaTabirimoni kaHeziyoni, inkosi yaseSiriya, owayehlala eDamaseko, wathi: ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.18",
            "verseOrgIds": [
              "1KI.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ake senze isivumelwano njengobaba loyihlo; ngiyakuthumela nanso isipho sesiliva legolide. Yephula isivumelwano sakho loBahasha inkosi yakoIsrayeli ukuze asuke kimi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.19",
            "verseOrgIds": [
              "1KI.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UBenihadadi wayilalela inkosi uAsa, wathumela induna zakhe zempi ukuhlasela imizi yakoIsrayeli, zathumba iIjoni leDani leAbeli‐Beti‐Mahaka, lalo lonke iKinerethi lelizwe lonke lakoNafitali. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.20",
            "verseOrgIds": [
              "1KI.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uBahasha ekuzwa lokhu wayekela ukwakha iRama, wabuyela eTiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.21",
            "verseOrgIds": [
              "1KI.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uAsa yasisenza isimemezelo kulo lonke lakoJuda, ukuba bonke abantu basuse amatshe eRama kanye lezigodo zalo uBahasha ayesakha ngakho; kakho owavunyelwa ukuba angenzi lokhu. Inkosi uAsa wakha ngakho iGeba elakoBenjamini leMizipa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.22",
            "verseOrgIds": [
              "1KI.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye indaba zikaAsa lobuqhawe bakhe lakho konke akwenzayo lemizi ayakhayo kulotshiwe ogwalweni lwezindaba zamakhosi akoJuda. Kodwa ebudaleni bakhe wayebulawa zinyawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.23",
            "verseOrgIds": [
              "1KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAsa waya kwabaphansi, wangcwatshwa kuboyise emzini kaDavida ukhokho wakhe. UJehoshafati indodana yakhe waba yinkosi esikhundleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.24",
            "verseOrgIds": [
              "1KI.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.24",
            "verseOrgIds": [
              "1KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNadabi indodana kaJerobowamu waba yinkosi koIsrayeli ngomnyaka wesibili wokubusa kukaAsa inkosi yakoJuda; wabusa koIsrayeli iminyaka emibili. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza okubi phambi kweNkosi, wahamba ngendlela kayise, wenza izono ezenza uIsrayeli one. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "UBahasha indodana kaAhija, owendlu kaIsakari, wamenzela amacebo, wambulala eGibethoni elamaFilistiya, lapho uNadabi loIsrayeli wonke bevimbezele iGibethoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.27",
            "verseOrgIds": [
              "1KI.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "UBahasha wambulala ngomnyaka wesithathu wokubusa kukaAsa inkosi yakoJuda, wasesiba yinkosi esikhundleni sakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.28",
            "verseOrgIds": [
              "1KI.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi eseyinkosi wahle wabulala bonke abendlu kaJerobowamu, kaze atshiya loyedwa wabo njengelizwi leNkosi uNkulunkulu eyalikhuluma ngenceku yayo uAhija waseShiloni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.10"
              },
              "items": [
                {
                  "text": "1 Kho 14:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokhu kwenzeka ngenxa yezono zikaJerobowamu langenxa yezono enza ngazo uIsrayeli one, ngoba wayithukuthelisa iNkosi, uNkulunkulu kaIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye indaba zikaNadabi lakho konke akwenzayo kulotshiwe ogwalweni lwezindaba zamakhosi akoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona impi phakathi kukaAsa loBahasha inkosi yakoIsrayeli insuku zabo zonke.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
            "verseOrgIds": [
              "1KI.15.32"
            ]
          }
        }
      ]
    },
