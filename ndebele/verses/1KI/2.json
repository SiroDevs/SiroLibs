              },
              "items": [
                {
                  "text": "1 Sam 2:27–36",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.27",
            "verseOrgIds": [
              "1KI.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho kufika umbiko kuJowabi — ngoba uJowabi wayesekele uAdonija lanxa wayengamsekelanga uAbisalomu — wabalekela ethenteni leNkosi uNkulunkulu, wabamba impondo zealtare. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.28",
            "verseOrgIds": [
              "1KI.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nxa kubikelwa inkosi uSolomoni ukuthi uJowabi usebalekele ethenteni lokuhlangana, useceleni kwealtare, uSolomoni wathuma uBenaya indodana kaJehoyada esithi: Hamba uyemtshaya umbulale. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.29",
            "verseOrgIds": [
              "1KI.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uBenaya wasesiya ethenteni, wathi kuye: Inkosi uSolomoni ithi: Phuma! Kodwa yena wathi: Atshi, ngizafela khonapha. UBenaya waseyibikela inkosi amazwi kaJowabi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.30",
            "verseOrgIds": [
              "1KI.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yamphendula yathi: Yenza njengokutsho kwakhe, umtshaye umbulale, umngcwabe; ngalokho ususe kimi lendlini kababa icala legazi uJowabi alichitha ngaphandle kwecala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.31",
            "verseOrgIds": [
              "1KI.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi uNkulunkulu izakwehlisela ekhanda lakhe izenzo zakhe zokuchitha igazi, ngoba kwathi ubaba uDavida engazi, wahlasela wabulala amadoda amabili ayelungile engcono kulaye, ngitsho uAbineri indodana kaNeri induna yempi yakoIsrayeli, loAmasa indodana kaJetheri induna yempi yakoJuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.32",
            "verseOrgIds": [
              "1KI.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho igazi labo lizaphindiselwa kuJowabi lasenzalweni yakhe kuze kube nininini; kodwa kuDavida lasenzalweni yakhe, lasendlini yakhe, lasembusweni wakhe, kuzakuba lokuthula okuvela eNkosini uNkulunkulu kuze kube nininini. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.33",
            "verseOrgIds": [
              "1KI.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesuka uBenaya indodana kaJehoyada, wamtshaya wambulala uJowabi; wangcwatshelwa endlini yakhe enkangala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.34",
            "verseOrgIds": [
              "1KI.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yasibeka uBenaya indodana kaJehoyada ukuba yinduna yempi esikhundleni sikaJowabi, yabeka uZadoki umpristi esikhundleni sikaAbiyatha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.35",
            "verseOrgIds": [
              "1KI.2.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.35",
            "verseOrgIds": [
              "1KI.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uSolomoni yasibiza uShimeyi, yathi kuye: Zakhele indlu eJerusalema, uhlale khona, ungaphumi lapho uye kwenye indawo loba kunjani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.36",
            "verseOrgIds": [
              "1KI.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba mhla uphumayo, ucaphe isifula iKidroni, wazi impela ukuthi uzakufa, legazi lakho lizakuba phezu kwakho. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.37",
            "verseOrgIds": [
              "1KI.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "UShimeyi wasesithi enkosini: Lokho okutshoyo kulungile; inceku yakho izakwenza lokho okutshiwo yinkosi yami. UShimeyi wahlala eJerusalema insuku ezinengi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.38",
            "verseOrgIds": [
              "1KI.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kwathi ngemuva kweminyaka emithathu izigqili zakhe ezimbili zabalekela kuAkishi indodana kaMahaka inkosi yaseGathi. Kwathi lapho ebikelwa uShimeyi ukuthi izigqili zakhe ziseGathi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.39",
            "verseOrgIds": [
              "1KI.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "wasuka, wagada ubabhemi, waya eGathi kuAkishi ukudinga izigqili zakhe; wazifica eGathi, wabuya lazo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.40",
            "verseOrgIds": [
              "1KI.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho uSolomoni ebikelwa ukuthi uShimeyi ubephumile eJerusalema waya eGathi, wabuya, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.41",
            "verseOrgIds": [
              "1KI.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "wambiza uShimeyi wathi kuye: Kanje kangikufungisanga ngeNkosi uNkulunkulu, ngakulayisisa ngathi: Yazi impela ukuthi mhla uphumayo ukuya lakuyiphi indawo uzakufa na? Wena wathi: Lokho okutshoyo kulungile, ngizakukulalela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.42",
            "verseOrgIds": [
              "1KI.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phoke, kungani ungasigcinanga isifungo sakho eNkosini lomthetho engakulaya wona na? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.43",
            "verseOrgIds": [
              "1KI.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyazi enhliziyweni yakho bonke ububi owabenza kubaba uDavida; ngakho iNkosi uNkulunkulu izaphindisela ububi bakho phezu kwakho. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.44",
            "verseOrgIds": [
              "1KI.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa mina nkosi uSolomoni ngizakubusiswa, lombuso kaDavida uzaqiniswa phambi kweNkosi kuze kube nininini. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.45",
            "verseOrgIds": [
              "1KI.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yasilaya uBenaya indodana kaJehoyada ukuba ambulale, yena waphuma wamtshaya wambulala. Ngakho umbuso waqiniswa kuSolomoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.46",
            "verseOrgIds": [
              "1KI.2.46"
            ]
          }
        }
      ]
    }
