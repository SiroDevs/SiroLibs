              "1KI.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uSolomoni yasisithi kuAbiyatha umpristi: Hamba uye eAnathothi endaweni yakho, ngoba wena ufanele ukufa; kodwa kangiyikukubulala ngoba wawuthwala ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.26",
            "verseOrgIds": [
              "1KI.2.26"
            ]
          }
        },
        {
          "text": " weNkosi uNkulunkulu phambi kukababa uDavida, wahlupheka kanye lobaba kuzo zonke inhlupheko zakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.26",
            "verseOrgIds": [
              "1KI.2.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
