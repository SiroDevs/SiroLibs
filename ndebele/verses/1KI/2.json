                "loc": "2SA.15.24"
              },
              "items": [
                {
                  "text": "2 Sam 15:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.22.20+1SA.22.21+1SA.22.22+1SA.22.23"
              },
              "items": [
                {
                  "text": "1 Sam 22:20–23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.26",
            "verseOrgIds": [
              "1KI.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uSolomoni wasemkhupha uAbiyatha esikhundleni sobupristi beNkosi, wagcwalisa ilizwi leNkosi eyalikhuluma mayelana lendlu kaEli eShilo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.27",
            "verseOrgIds": [
              "1KI.2.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
