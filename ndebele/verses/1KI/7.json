          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "USolomoni wazenzake zonke izinto ezazisethempelini; ialtare legolide, itafula yezinkwa ezahlukaniselwa uNkulunkulu,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
