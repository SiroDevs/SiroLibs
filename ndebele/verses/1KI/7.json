          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "izinti zezibane zegolide elihle, ezinhlanu ngakwesokunene, lezinhlanu ngakwesokhohlo kwendlwana engaphakathi, lamaluba, lezibane, lezindlawu, wakwenza ngegolide;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.49",
            "verseOrgIds": [
              "1KI.7.49"
            ]
          }
        },
        {
