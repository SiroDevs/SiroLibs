              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31+EXO.25.32+EXO.25.33+EXO.25.34+EXO.25.35+EXO.25.36+EXO.25.37+EXO.25.38+EXO.25.39+EXO.25.40"
              },
              "items": [
                {
                  "text": "Eks 25:31–40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.49",
            "verseOrgIds": [
              "1KI.7.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "lezinkezo, lezindlawu, lemiganu yokuchela, lemiganu yempepha, lezitsha zokuthwala umlilo, wakwenza ngegolide elihle; lamabhanti ezivalo zendlwana engaphakathi, yindawo engcwele kakhulu, lamabhanti ezivalo zethempeli, wakwenza ngegolide.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.50",
