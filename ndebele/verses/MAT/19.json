              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPetro wasekhuluma esithi kuye: Khangela, thina sitshiye konke, sakulandela. Pho, sizakuzuzani na? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.27",
            "verseOrgIds": [
              "MAT.19.27"
            ]
          }
        },
        {
