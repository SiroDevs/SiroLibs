          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba njengalokhu umbane ubaneka empumalanga, ukhanye uze ubonakale entshonalanga, kuzakuba njalo ukufika kweNdodana yomuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.27",
            "verseOrgIds": [
              "MAT.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba kungaphi lapho kukhona isidumbu, kulapho amanqe azakubuthana khona.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.28",
