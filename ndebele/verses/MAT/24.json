          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kung’khonake kuzakubonakala ezulwini isibonakaliso seNdodana yomuntu, zikhale zonke izizwe zomhlaba, zibone iNdodana yomuntu isiza emayezini ezulu, ilamandla lenkazimulo enkulu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.30",
            "verseOrgIds": [
              "MAT.24.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
