              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngithi kini: Kuzakuba ngcono kulo ilizwe laseSodoma ngosuku lokulahlwa kulakuwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.24",
