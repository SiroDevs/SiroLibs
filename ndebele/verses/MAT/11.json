            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.15",
            "verseOrgIds": [
              "MAT.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngizakusifanisa lani lesisizukulwana na? Sifana labantwana abahlezi emidangeni bememeza abanye besithi: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.16",
            "verseOrgIds": [
              "MAT.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salitshayela umhubhe, kalisinanga; salililela, kalikhalanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.17",
            "verseOrgIds": [
              "MAT.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uJohane wafika engadli, enganathi; bathi: Ulomoya omubi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.18",
            "verseOrgIds": [
              "MAT.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa iNdodana yomuntu yafika isidla, inatha; bathi: Khangelani umuntu oyisidli lesinathi, umngane wabathelisi lezoni. Kodwa ukuhlakanipha kubonakaliswa ukuthi kulungile ngabantwana bakho.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.19",
            "verseOrgIds": [
              "MAT.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.19",
            "verseOrgIds": [
              "MAT.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waseqala ukusola imizi okwakwenziwe phakathi kwayo ubunengi bemisebenzi yakhe yamandla, ngoba ingaphendukanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.20",
            "verseOrgIds": [
              "MAT.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: Maye kuwe Korazini! Maye kuwe Betsayida! Ngoba uba kwakwenziwe eTire leSidoni imisebenzi yamandla eyenziwe kini, ngabe kade baphenduka bembatha amasaka bazithela ngomlotha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.21",
            "verseOrgIds": [
              "MAT.11.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
