              "type": "text"
            }
          ]
        },
        {
          "text": "Wozani kimi lonke elikhatheleyo lelisindiweyo, mina ngizakuliphumuza. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.28",
            "verseOrgIds": [
              "MAT.11.28"
