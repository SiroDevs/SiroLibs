              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thwalani ijokwe lami phezu kwenu, lifunde kimi, ngoba ngimnene ngithobekile; kung’khona imiphefumulo yenu izakufumana ukuphumula.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
