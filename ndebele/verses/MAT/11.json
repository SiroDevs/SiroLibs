          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yebo, Baba, ngoba kwaba kuhle kuwe ukuba kube njalo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.26",
            "verseOrgIds": [
              "MAT.11.26"
