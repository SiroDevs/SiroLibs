          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wazihawukela, wathinta amehlo azo; zasezibona masinyane, zamlandela.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.34",
