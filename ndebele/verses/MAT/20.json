          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakunjalo phakathi kwenu, kodwa yilowo othanda ukuba ngomkhulu phakathi kwenu, kabe ngumfokazi wenu;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
            "verseOrgIds": [
              "MAT.20.26"
            ]
          }
        },
        {
