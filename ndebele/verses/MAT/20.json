              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.31"
              },
              "items": [
                {
                  "text": "Mark 10:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.30"
              },
              "items": [
                {
                  "text": "Luka 13:30",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
