              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "njengalokhu iNdodana yomuntu kayizanga ukukhonzwa, kodwa ukukhonza lokunika ukuphila kwayo, kube lihlawulo labanengi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.28",
