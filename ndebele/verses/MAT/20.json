        },
        {
          "text": "lalowo othanda ukuba ngowokuqala phakathi kwenu kabe yinceku yenu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.27",
            "verseOrgIds": [
              "MAT.20.27"
            ]
          }
        },
        {
