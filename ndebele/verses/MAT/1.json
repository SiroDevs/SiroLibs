              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
