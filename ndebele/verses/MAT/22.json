          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebebuthene abaFarisi, uJesu wababuza, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.41",
            "verseOrgIds": [
              "MAT.22.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
