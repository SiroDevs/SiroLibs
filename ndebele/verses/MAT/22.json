          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kibo: Pho, uDavida watsho kanjani ngoMoya ukuthi yiNkosi? esithi:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.43",
            "verseOrgIds": [
