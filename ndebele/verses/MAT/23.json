          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khangelani, indlu yenu isele ilunxiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
