          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lithi: Uba besikhona ensukwini zabokhokho bethu besingayikuhlanganyela labo egazini labaprofethi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.30",
            "verseOrgIds": [
              "MAT.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunjalo liyazifakazela lina ukuthi lingamadodana alabo ababulala abaprofethi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.31",
            "verseOrgIds": [
              "MAT.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
