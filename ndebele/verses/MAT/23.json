              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maye kini babhali labaFarisi, bazenzisi! ngoba lihlambulula ingaphandle yenkezo leyomganu, kodwa ingaphakathi igcwele ubuhwaba lokuphanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.25",
            "verseOrgIds": [
              "MAT.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "MFarisi ndini oyisiphofu! hlambulula kuqala ingaphakathi yenkezo, ukuze ihlambuluke lengaphandle yayo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.26",
            "verseOrgIds": [
              "MAT.23.26"
            ]
          }
        }
      ]
    },
    {
