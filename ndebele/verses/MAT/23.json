          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maye kini babali labaFarisi, bazenzisi! ngoba lithela okwetshumi kwemfe, lolude, lamakhomane, liyekele izinto ezinkulu zomlayo, ukulunga lesihawu lokuthembeka. Belifanele ukukwenza lokhu lingakuyekeli lalokho.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.23",
            "verseOrgIds": [
              "MAT.23.23"
            ]
          }
        },
