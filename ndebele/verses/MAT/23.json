              "type": "text"
            }
          ]
        },
        {
          "text": "Maye kini babhali labaFarisi, bazenzisi! ngoba lakha amaliba abaprofethi, licecise amaliba abalungileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.29",
            "verseOrgIds": [
