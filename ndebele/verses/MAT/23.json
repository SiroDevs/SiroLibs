          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunjalo lani ngaphandle libonakala ebantwini lilungile, kanti ngaphakathi ligcwele ukuzenzisa lobubi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.28",
            "verseOrgIds": [
