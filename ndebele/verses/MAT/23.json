          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sukanike, qedisani okwaqaliswa ngokhokho benu! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.32",
            "verseOrgIds": [
              "MAT.23.32"
            ]
          }
