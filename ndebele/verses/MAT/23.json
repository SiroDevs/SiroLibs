      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wakhuluma emaxukwini lakubafundi bakhe, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.1",
            "verseOrgIds": [
              "MAT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "wathi: Ababhali labaFarisi bahlezi esihlalweni sikaMose. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.2",
            "verseOrgIds": [
              "MAT.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke konke abalitshela khona, kwenzeni, likugcine, kodwa lingenzi njengemisebenzi yabo; ngoba bayakhuluma, bengenzi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.3",
            "verseOrgIds": [
              "MAT.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bayabopha imithwalo enzima, bayibeke emahlombe abantu; kodwa bona kabavumi ukuyisusa ngomunwe wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.4",
            "verseOrgIds": [
              "MAT.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imisebenzi yabo yonke bayenza ukuba babonwe ngabantu; ngoba benza izicwatsho zabo zokukhuleka zibe banzi, lentshaka zengubo zabo zibe zinkulu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.5",
            "verseOrgIds": [
              "MAT.23.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.1"
              },
              "items": [
                {
                  "text": "Mat 6:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.38"
              },
              "items": [
                {
                  "text": "Nani 15:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.8"
              },
              "items": [
                {
                  "text": "Dute 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.5",
            "verseOrgIds": [
              "MAT.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathanda indawo eziphakemeyo ekudleni lezihlalo ezingaphambili emasinagogeni, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.6",
            "verseOrgIds": [
              "MAT.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "lokubingelelwa emidangeni, lokubizwa ngabantu ngokuthi Rabi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.7",
            "verseOrgIds": [
              "MAT.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lina kalingabizwa ngokuthi Rabi, ngoba munye ongumfundisi wenu, lina lonke lingabazalwane. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.8",
            "verseOrgIds": [
              "MAT.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingabizi muntu emhlabeni ngokuthi nguyihlo; ngoba munye onguYihlo, osezulwini. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.9",
            "verseOrgIds": [
              "MAT.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalingabizwa ngokuthi lingabafundisi; ngoba munye ongumfundisi wenu, uKristu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.10",
            "verseOrgIds": [
              "MAT.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lowo omkhulu kini kabe ngumfokazi wenu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.11",
            "verseOrgIds": [
              "MAT.23.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
