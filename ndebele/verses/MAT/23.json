          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke, khangelani, ngithuma kini abaprofethi, labahlakaniphileyo, lababhali; abanye babo lizakubabulala, libabethele; abanye lizakubatshaya emasinagogeni enu, libaxotshe imizi ngemizi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.34",
            "verseOrgIds": [
              "MAT.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
