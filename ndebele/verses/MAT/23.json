        },
        {
          "text": "Bakhokheli abayiziphofu, likhetha umyane kodwa liginye ikamela.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.24",
            "verseOrgIds": [
              "MAT.23.24"
            ]
          }
