          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maye kini babhali labaFarisi, bazenzisi! ngoba lifana lamaliba aconjiweyo, abonakala emahle ngaphandle, kanti ngaphakathi agcwele amathambo abafileyo lokungcola konke.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.27",
            "verseOrgIds": [
              "MAT.23.27"
            ]
          }
        },
        {
          "name": "note",
