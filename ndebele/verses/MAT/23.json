          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lina zinyoka, nzalo yamabululu, lizakukuphepha kanjani ukulahlwa kwasesihogweni na?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.33",
            "verseOrgIds": [
