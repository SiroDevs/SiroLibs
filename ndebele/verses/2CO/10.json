  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "2CO 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina Pawuli uqobo ngiyalincenga ngobumnene langothando lukaKristu, mina engithobileyo nxa ngikhona phakathi kwenu, njengokutsho kwenu, kodwa engilesibindi nxa ngingekho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.1",
            "verseOrgIds": [
              "2CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyalincenga ukuthi, nxa ngifikayo, kungadingeki ukuba ngibasukele ngesibindi engizimisele ukuba laso kwabanye abatshoyo ngathi ukuthi sihamba ngokomhlaba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.2",
            "verseOrgIds": [
              "2CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba lanxa sikhona emhlabeni kasilwi impi yasemhlabeni; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.3",
            "verseOrgIds": [
              "2CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba izikhali zokulwa kwethu kayisizo zasemhlabeni, kodwa zilamandla kaNkulunkulu okubhidliza izinqaba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.4",
            "verseOrgIds": [
              "2CO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sichitha inkani, lakho konke okuziphakamisela ukumelana lokumazi uNkulunkulu, lemicabango yonke siyithumbela ukumlalela uKristu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.5",
            "verseOrgIds": [
              "2CO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "futhi silungele ukutshaya ukungalaleli konke, nxa ukulalela kwenu sekuphelele.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.6",
            "verseOrgIds": [
              "2CO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.6",
            "verseOrgIds": [
              "2CO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khangelani iqiniso eliphambi kwenu. Uba umuntu ezithemba yena ukuba ungokaKristu, kanakane ukuthi, njengoba yena engokaKristu, sinjalo lathi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.7",
            "verseOrgIds": [
              "2CO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba ngingaze ngizincome ngaphezudlwana ngamandla ethu eyasinika wona iNkosi ukuba lakhiwe lingachithwa ngawo, kangiyikuyangeka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.8",
            "verseOrgIds": [
              "2CO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kangithandi ukuba kube njengokungathi ngiyalethusa ngencwadi zami. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.9",
            "verseOrgIds": [
              "2CO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba kuthiwa: Incwadi zakhe zinzima, zibukhali; kodwa nxa ekhona ngomzimba, ubuthakathaka, lokukhuluma kwakhe kudelelekile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.10",
            "verseOrgIds": [
              "2CO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanjalo kabanakane ukuthi lokhu esikutshoyo ngencwadi nxa singekho, sizakukwenza nxa sesikhona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.11",
            "verseOrgIds": [
              "2CO.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasilasibindi sokuzilinganisa lokuzifanisa labathile babo abaziqhenyayo. Kodwa bona bazilinganisa omunye ngomunye bazifanisa bona uqobo lwabo, kabalakuqedisisa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.12",
            "verseOrgIds": [
              "2CO.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.12",
            "verseOrgIds": [
              "2CO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa thina kasiyikuzincoma ngokudlula indawo yethu, kodwa sizakuzincoma ngendawo uNkulunkulu asimisele yona ukuba ibe yindawo yethu, indawo ehamba ize ifike lakini. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.13",
            "verseOrgIds": [
              "2CO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba kasizeluli ngokweqileyo ngokungathi kasizanga sifinyelele kini, ngoba yithi abokuqala ukufika kini levangeli likaKristu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.14",
            "verseOrgIds": [
              "2CO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasizincomi ngokudlulayo ngomsebenzi owenziwe ngabanye, kodwa silethemba lokuthi ngokukhula kokukholwa kwenu indawo yomsebenzi wethu izakukhuliswa phakathi kwenu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.15",
            "verseOrgIds": [
              "2CO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "size sitshumayele ivangeli lasendaweni ezingaphambili kwenu, singazincomi ngomsebenzi osuwenziwe endaweni yomunye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.16",
            "verseOrgIds": [
              "2CO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ozincomayo kazincome ngeNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.24"
              },
              "items": [
                {
                  "text": "Jer 9:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba kasuye ozincomayo ovunywayo, kodwa yilowo onconywa yiNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.18",
            "verseOrgIds": [
              "2CO.10.18"
            ]
          }
        }
      ]
    }
  ],
