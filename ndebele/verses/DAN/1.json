                "loc": "2KI.20.17+2KI.20.18"
              },
              "items": [
                {
                  "text": "2 Kho 20:17–18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.10+2KI.24.11+2KI.24.12+2KI.24.13+2KI.24.14+2KI.24.15+2KI.24.16"
              },
              "items": [
                {
                  "text": "24:10–16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
