            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wesithathu wokubusa kukaJehoyakimi inkosi yakoJuda, uNebukadineza inkosi yaseBabiloni wafika eJerusalema, walivimbezela.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
          }
        },
        {
