              },
              "items": [
                {
                  "text": "Dan 9:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.11"
              },
              "items": [
                {
                  "text": "12:11",
