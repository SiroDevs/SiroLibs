              "items": [
                {
                  "text": "Mark 13:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.31",
            "verseOrgIds": [
              "DAN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakubakhohlisa ngokubabamba amehlo labo abephula isivumelwano; kodwa abantu abamaziyo uNkulunkulu wabo bazakuma baqine, balwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.32",
            "verseOrgIds": [
              "DAN.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahlakaniphileyo babantu bazafundisa abanengi, lanxa bezabulawa empini langomlilo, babanjwe, bathunjwe okwensuku ezithile. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.33",
            "verseOrgIds": [
              "DAN.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekubulaweni kwabo bazasizwa kancinyane, loba abanengi balabo abazihlanganisa labo bengelaqiniso. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.34",
            "verseOrgIds": [
              "DAN.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanye babahlakaniphileyo bazabulawa ukuze abanye bahlolwe, bahlanjululwe, benziwe babe mhlophe, kuze kufike isikhathi sokuphela, ngoba kungokwesikhathi esimisiweyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.35",
            "verseOrgIds": [
              "DAN.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi izakwenza ekuthandayo; izaziphakamisa izikhulise ngaphezu kwabo bonke onkulunkulu, ikhulume okumangalisayo ngoNkulunkulu, iphumelele kuze kuphelele intukuthelo, ngoba okumisiweyo kuzakwenziwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.36",
            "verseOrgIds": [
              "DAN.11.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.3+2TH.2.4"
              },
              "items": [
                {
                  "text": "2 Tes 2:3–4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.5+REV.13.6"
              },
              "items": [
                {
                  "text": "Isam 13:5–6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.36",
            "verseOrgIds": [
              "DAN.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayiyikunanza onkulunkulu babokhokho bayo lonkulunkulu othandwa ngabesifazana; kayiyikunanza loyedwa unkulunkulu, ngoba izazikhulisa ibe phezu kwabo bonke. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.37",
            "verseOrgIds": [
              "DAN.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DAN 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izadumisa unkulunkulu wezinqaba; unkulunkulu owayengaziwa ngokhokho bakhe izamdumisa ngegolide langesiliva, langamatshe amahle, langeziphiwo ezibiza imali enengi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.38",
            "verseOrgIds": [
              "DAN.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DAN 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izagcwalisa inqaba zayo eziqinileyo ngabantu bezizweni, abantu abakhonza unkulunkulu wezizweni; labo abayivumayo ibanike udumo, ibenze ababusi phezu kwabanengi, ibanike umvuzo wamazwe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.39",
            "verseOrgIds": [
              "DAN.11.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DAN 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.39",
            "verseOrgIds": [
              "DAN.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DAN 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngesikhathi sokuphela inkosi yaseningizimu izakuyihlasela; kodwa inkosi yasenyakatho izayisukela njengesivunguzane ilezinqota zokulwa, labagadi bamabhiza, lemikolo eminengi, ihlasele amazwe, ikhukhule, idlule. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.40",
            "verseOrgIds": [
              "DAN.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DAN 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izangena elizweni elihle, ibulale amatshumi azinkulungwane; kodwa iEdoma leMowabi lengxenye enkulu yabaseAmoni bazaphunyuka esandleni sayo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.41",
            "verseOrgIds": [
              "DAN.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DAN 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izaphakamisela isandla sayo emazweni, lelizwe laseGibithe kaliyikuphepha. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.42",
            "verseOrgIds": [
              "DAN.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DAN 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izathatha inotho yegolide leyesiliva lazo zonke izinto eziligugu zaseGibithe; amaLibiya lamaEtiyopiya azayikhonza. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.43",
            "verseOrgIds": [
              "DAN.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DAN 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa izakwethuswa yimibiko evela empumalanga lasenyakatho, iphume ngokuthukuthela okukhulu ukuqeda lokubhubisa abanengi, baphele nya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.44",
            "verseOrgIds": [
              "DAN.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DAN 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izamisa amathente ayo obukhosi phakathi kolwandle lentaba enhle engcwele. Kodwa izakufa, kungekho ongayisiza.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.45",
            "verseOrgIds": [
              "DAN.11.45"
            ]
          }
        }
      ]
    }
