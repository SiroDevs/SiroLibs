  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "JHN 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngosuku lokuqala lweviki uMariya Magadalena wafika elibeni ekuseni kusesemnyama, wabona ilitshe lisusiwe elibeni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.1",
            "verseOrgIds": [
              "JHN.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho wagijima waya kuSimoni Petro lakulowomfundi omunye owayethandwa nguJesu, wathi kibo: Bayisusile iNkosi elibeni, kasazi lapho bayibeke khona. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.2",
            "verseOrgIds": [
              "JHN.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uPetro wasephuma lomunye umfundi, baya elibeni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.3",
            "verseOrgIds": [
              "JHN.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagijima bobabili kanyekanye; kodwa lomunye umfundi wagijima kakhulu wamtshiya uPetro, wafika kuqala elibeni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.4",
            "verseOrgIds": [
              "JHN.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elunguza wabona amalembu ekhona, kodwa kangenanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.5",
            "verseOrgIds": [
              "JHN.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "USimoni Petro laye wafika emlandela, wangena elibeni, wabona amalembu ekhona, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.6",
            "verseOrgIds": [
              "JHN.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "lelembu elalisekhanda lakhe lingekho emalenjini amanye, kodwa libekwe lodwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.7",
            "verseOrgIds": [
              "JHN.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasengena laye umfundi omunye owayefike kuqala elibeni, wabona, wakholwa; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.8",
            "verseOrgIds": [
              "JHN.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba babengakaqedisisi umbhalo othi ubefanele ukuvuka kwabafileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.9",
            "verseOrgIds": [
              "JHN.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebesuka abafundi, babuyela ekhaya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.10",
            "verseOrgIds": [
              "JHN.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.10",
            "verseOrgIds": [
              "JHN.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uMariya wema elibeni phandle ekhala; esakhala walunguza elibeni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.11",
            "verseOrgIds": [
              "JHN.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabona izithunywa ezimbili zambethe okumhlophe, zihlezi lapho isidumbu sikaJesu besilele khona, esinye singekhanda lesinye singenyaweni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.12",
            "verseOrgIds": [
              "JHN.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zona zathi kuye: Mama, ukhalelani na? Wathi kuzo: Bayithethe iNkosi yami, kangazi lapho bayibeke khona. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.13",
            "verseOrgIds": [
              "JHN.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esetshilo lokhu waphenduka, wabona uJesu emi, kodwa wayengamazi ukuthi nguJesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.14",
            "verseOrgIds": [
              "JHN.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wathi kuye: Mama, ukhalelani na? Ufuna ubani na? Kodwa yena esithi ngumphathi wensimu wathi kuye: Nkosi, uba esuswe nguwe, ngitshele lapho umbeke khona, ngizakumthatha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.15",
            "verseOrgIds": [
              "JHN.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wathi kuye: Mariya! Yena waphendula wathi kuye ngesiHeberu: Raboni! okuyikuthi: Mfundisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.16",
            "verseOrgIds": [
              "JHN.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wathi kuye: Ungangibambi, ngoba angikenyukeli kuBaba. Kodwa yana kubafowethu, uthi kibo ngiyenyukela kuBaba lakuYihlo, kuNkulunkulu wami loNkulunkulu wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.17",
            "verseOrgIds": [
              "JHN.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMariya Magadalena wasuka wababikela abafundi wathi: Ngiyibonile iNkosi. Njalo wabatshela amazwi ayo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.18",
            "verseOrgIds": [
              "JHN.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.18",
            "verseOrgIds": [
              "JHN.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi kusihlwa ngalolosuku, usuku lokuqala lweviki, iminyango ivaliwe lapho abafundi babekhona ngenxa yokwesaba abaJuda, uJesu wafika wema phakathi kwabo, wathi kibo: Ukuthula akube kini. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.19",
            "verseOrgIds": [
              "JHN.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esetshilo lokhu wabatshengisa izandla zakhe lohlangothi lwakhe. Ngakhoke bathokoza abafundi beyibona iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.20",
            "verseOrgIds": [
              "JHN.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wabuya wathi kibo: Ukuthula akube kini. Njengokuba uBaba engithumile mina, lami ngiyalithuma lina. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.21",
            "verseOrgIds": [
              "JHN.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi esetshilo lokhu waphephetha phezu kwabo wathi kibo: Yamukelani uMoya oNgcwele. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.22",
            "verseOrgIds": [
              "JHN.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labo elibathethelela izono zabo zithethelelwe; lezono zalabo elizibambayo zibanjiwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.23",
            "verseOrgIds": [
              "JHN.20.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
