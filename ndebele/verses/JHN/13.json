                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.20",
            "verseOrgIds": [
              "JHN.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu esetshilo lokhu wakhathazeka emoyeni, waqinisa wathi: Ngiqinisile, ngiqinisile ngithi kini: Omunye wenu uzakunginikela. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.21",
            "verseOrgIds": [
              "JHN.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafundi bakhangelana bengaqondi ukuthi ukhuluma ngobani. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.22",
            "verseOrgIds": [
              "JHN.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi omunye wabafundi yena uJesu amthandayo, wayeyeme esifubeni sikaJesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.23",
            "verseOrgIds": [
              "JHN.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uSimoni Petro wamqhweba wathi kuye: Sitshele ukuba ukhuluma ngobani. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.24",
            "verseOrgIds": [
              "JHN.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenake eyeme esifubeni sikaJesu wathi kuye: Nkosi, ngubani na? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.25",
            "verseOrgIds": [
              "JHN.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu waphendula wathi: Yilowo engizakumnika ucezu lwesinkwa sengilutshebile. Ngakho eselutshebile ucezu, walunika uJudasi, indodana kaSimoni Iskariyothi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.26",
            "verseOrgIds": [
              "JHN.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJudasi eselwamukele ucezu uSathane wangena kuye. UJesu wasesithi kuye: Okwenzayo kwenze masinyane. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.27",
            "verseOrgIds": [
              "JHN.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kakukho loyedwa kwababehlezi ekudleni owayekwazi ukuthi ukutsho ngani lokhu kuye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.28",
            "verseOrgIds": [
              "JHN.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa abanye bacabanga ukuthi kungoba uJudasi wayephatha isikhwama, uJesu wathi kuye: Thenga esikufunayo emkhosini, loba ukuthi kabele abayanga okuthile. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.29",
            "verseOrgIds": [
              "JHN.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi eselwamukele ucezu waphuma masinyane; kwakusebusuku.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.30",
            "verseOrgIds": [
              "JHN.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
