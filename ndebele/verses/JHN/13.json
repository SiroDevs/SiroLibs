              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokhu bonke bazakukwazi ukuba lingabafundi bami, aluba lithandana.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.35",
            "verseOrgIds": [
