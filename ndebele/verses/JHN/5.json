  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "JHN 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokhu kwaba khona umkhosi wabaJuda; uJesu wakhuphukela eJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.1",
            "verseOrgIds": [
              "JHN.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.1",
            "verseOrgIds": [
              "JHN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhonake lapho eJerusalema eduze lesango lezimvu ichibi elithiwa ngesiHeberu iBethesda, elilamathuli amahlanu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.2",
            "verseOrgIds": [
              "JHN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakulele kiwo abagulayo abanengi, iziphofu, iziqhuli, labatshwabheneyo. [",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.3",
            "verseOrgIds": [
              "JHN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba isithunywa seNkosi sasisehlela echibini ngezikhathi ezithile, sizamazamise amanzi, kuthi lowo ongene kuqala emva kokuzanyazanyiswa kwamanzi asiliswe esifweni sakhe, loba elesifo sini.] ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.4",
            "verseOrgIds": [
              "JHN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona lapho umuntu owayesegule iminyaka engamatshumi amathathu lesificaminwembili. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.5",
            "verseOrgIds": [
              "JHN.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi nxa uJesu embona elele lapho, esazi ukuba ulesikhathi eside enjalo, wathi kuye: Uyathanda ukusiliswa na? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.6",
            "verseOrgIds": [
              "JHN.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogulayo wamphendula wathi: Nkosi, kangilamuntu wokungifaka echibini nxa amanzi ezanyazanyiswa; kuthi nxa ngiyayo, kwehle omunye phambi kwami. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.7",
            "verseOrgIds": [
              "JHN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wathi kuye: Sukuma, uthathe ithala lakho, uhambe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.8",
            "verseOrgIds": [
              "JHN.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowomuntu wasila masinyane, wathatha ithala lakhe, wahamba.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.9",
            "verseOrgIds": [
              "JHN.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "KwakuyiSabatha mhlalokho. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.9",
            "verseOrgIds": [
              "JHN.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho abaJuda bathi kosilisiweyo: KuyiSabatha, kakuvunyelwa ukuba uthwale ithala lakho.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.10",
            "verseOrgIds": [
              "JHN.5.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.19"
              },
              "items": [
                {
                  "text": "Neh 13:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.21"
              },
              "items": [
                {
                  "text": "Jer 17:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.10",
            "verseOrgIds": [
              "JHN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa wabaphendula wathi: Yena ongisilisileyo uthe kimi: Thatha ithala lakho, uhambe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.11",
            "verseOrgIds": [
              "JHN.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bambuza bathi: Ngubani lowomuntu othe kuwe: Thatha ithala lakho uhambe, na? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.12",
            "verseOrgIds": [
              "JHN.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa osilisiweyo wayengamazi ukuba ungubani, ngoba uJesu wayesesukile lapho, kukhona ixuku kuleyondawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.13",
            "verseOrgIds": [
              "JHN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokhu uJesu wamfumana ethempelini, wathi kuye: Khangela, usilile; ungabe usona, funa wehlelwe ngokukhulu kulalokhu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.14",
            "verseOrgIds": [
              "JHN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesuka lowomuntu, watshela abaJuda ukuthi nguJesu omsilisileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.15",
            "verseOrgIds": [
              "JHN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenxa yalokhu abaJuda bamzingela uJesu, ngoba wenza lokhu ngeSabatha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.16",
            "verseOrgIds": [
              "JHN.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uJesu wabaphendula wathi: UBaba uyasebenza kuze kube lamhlanje, lamike ngiyasebenza. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.17",
            "verseOrgIds": [
              "JHN.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenxa yalokhuke abaJuda bafuna kakhulu ukumbulala, ngoba wayengaphulanga iSabatha kuphela, kodwa wabuya wathi uNkulunkulu unguYise, ezenza olingana loNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.18",
            "verseOrgIds": [
              "JHN.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.18",
            "verseOrgIds": [
              "JHN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesithi kibo: Ngiqinisile, ngiqinisile ngithi kini: INdodana ingenze lutho ngokwayo, kodwa kuphela lokho ebona uYise ekwenza, ngoba lokhu akwenzayo leNdodana iyakwenza njalo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.19",
            "verseOrgIds": [
              "JHN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uYise uyayithanda iNdodana, ayitshengise konke akwenzayo yena; uzakuyitshengisa imisebenzi emikhulu kulale ukuze limangale. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.20",
            "verseOrgIds": [
              "JHN.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengalokhu uYise evusa abafileyo, abanike ukuphila, kunjaloke leNdodana iyabanika ukuphila labo ethanda ukubasilisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.21",
            "verseOrgIds": [
              "JHN.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uYise kahluleli muntu; kodwa unikele iNdodana konke ukwahlulela, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.22",
            "verseOrgIds": [
              "JHN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze bonke badumise iNdodana, njengalokhu bedumisa uYise. Ongayidumisiyo iNdodana kamdumisi uYise oyithumileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.23",
            "verseOrgIds": [
              "JHN.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiqinisile, ngiqinisile ngithi kini: Olizwayo ilizwi lami, akholwe kuye ongithumileyo, ulokuphila okungapheliyo; kangeni ekwahlulelweni, kodwa usephumile ekufeni, wangena ekuphileni.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.24",
            "verseOrgIds": [
              "JHN.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.24",
            "verseOrgIds": [
              "JHN.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiqinisile, ngiqinisile ngithi kini: Isikhathi siyeza, njalo sesikhona, lapho abafileyo bazakulizwa ilizwi leNdodana kaNkulunkulu; labo abezwayo bazakuphila. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.25",
            "verseOrgIds": [
              "JHN.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengoba uYise elokuphila ngokwakhe, kunjaloke uyinikile iNdodana ukuba ibe lokuphila ngokwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.26",
            "verseOrgIds": [
              "JHN.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyiphile amandla okwahlulela, ngoba iyiNdodana yomuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.27",
            "verseOrgIds": [
              "JHN.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingamangali ngalokhu, ngoba isikhathi siyeza, lapho bonke abasemalibeni bazakulizwa ilizwi layo, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.28",
            "verseOrgIds": [
              "JHN.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuthi labo abenze okulungileyo baphumele ekuvukeni kokuphila, lalabo abenze okubi baphumele ekuvukeni kokulahlwa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.29",
            "verseOrgIds": [
              "JHN.5.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.2"
              },
              "items": [
                {
                  "text": "Dan 12:2",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.29",
            "verseOrgIds": [
              "JHN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina ngingenze lutho ngokwami; ngithonisisa njengokuzwa kwami; ukuthonisisa kwami kulungile, ngoba kangifuni intando yami kodwa ngifuna intando yalowo ongithumileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.30",
            "verseOrgIds": [
              "JHN.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluba ngizifakazela mina, ubufakazi bami kabulaqiniso. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.31",
            "verseOrgIds": [
              "JHN.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukhona ongifakazelayo mina; njalo ngiyazi ukuthi ubufakazi bakhe ngami buliqiniso. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.32",
            "verseOrgIds": [
              "JHN.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lina lathumela kuJohane, walifakazela iqiniso.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.33",
            "verseOrgIds": [
              "JHN.5.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.19+JHN.1.20+JHN.1.21+JHN.1.22+JHN.1.23+JHN.1.24+JHN.1.25+JHN.1.26+JHN.1.27"
              },
              "items": [
                {
                  "text": "Joha 1:19–27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.27+JHN.3.28+JHN.3.29+JHN.3.30"
              },
              "items": [
                {
                  "text": "3:27–30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.33",
            "verseOrgIds": [
              "JHN.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kangibamukeli ubufakazi obuvela emuntwini; kodwa ngitsho lokhu ukuze lisiliswe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.34",
            "verseOrgIds": [
              "JHN.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wayeyisibane esivuthayo lesikhanyayo; lani lathokoza okwesikhatshana ekukhanyeni kwakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.35",
            "verseOrgIds": [
              "JHN.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ubufakazi engilabo bukhulu kulobukaJohane, ngoba imisebenzi uBaba anginike yona ukuba ngiyiqede, yona limisebenzi engiyenzayo, iyangifakazela ukuthi uBaba ungithumile. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.36",
            "verseOrgIds": [
              "JHN.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laye uBaba ongithumileyo ungifakazele. Kalizanga lilizwe ilizwi lakhe, lesimo sakhe kalizanga lisibone.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.37",
            "verseOrgIds": [
              "JHN.5.37"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.17"
              },
              "items": [
                {
                  "text": "Mat 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.11"
              },
              "items": [
                {
                  "text": "Mark 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.22"
              },
              "items": [
                {
                  "text": "Luka 3:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.37",
            "verseOrgIds": [
              "JHN.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelizwi lakhe kalihlalanga phakathi kwenu, ngoba kalikholwanga kulowo amthumileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.38",
            "verseOrgIds": [
              "JHN.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lihlola imibhalo, ngoba lisithi lilokuphila okungapheliyo kiyo; yiyo engifakazelayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.39",
            "verseOrgIds": [
              "JHN.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanti kalivumi ukuza kimi ukuba libe lokuphila. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.40",
            "verseOrgIds": [
              "JHN.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina angamukeli udumo ebantwini. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.41",
            "verseOrgIds": [
              "JHN.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngiyalazi lina ukuthi kalilalo uthando lukaNkulunkulu phakathi kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.42",
            "verseOrgIds": [
              "JHN.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizile ebizweni likaBaba, kodwa kalingamukeli; uba omunye esiza ngebizo lakhe, lizakumamukela yena. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.43",
            "verseOrgIds": [
              "JHN.5.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 5:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingakholwa kanjani nxa lisadumisana lodwa, lingalufuni udumo oluvela kuNkulunkulu oyedwa na? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.44",
            "verseOrgIds": [
              "JHN.5.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 5:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingacabangi ukuthi ngizakuliceba kuBaba; ukhona olicebayo, uMose elithemba kuye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.45",
            "verseOrgIds": [
              "JHN.5.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 5:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba belikholwa kuMose, belizakukholwa lakimi, ngoba yena waloba ngami. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.46",
            "verseOrgIds": [
              "JHN.5.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 5:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba lingakholwa imibhalo yakhe, lizakukholwa kanjani amazwi ami na?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.47",
            "verseOrgIds": [
              "JHN.5.47"
            ]
          }
        }
      ]
    }
