              "type": "text"
            }
          ]
        },
        {
          "text": "Kuye olamandla okulilinda ukuba lingakhubeki, lokulimisa phambi kwenkazimulo yakhe lingelasici, lilokuthokoza okukhulu, ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.24",
            "verseOrgIds": [
              "JUD.1.24"
            ]
          }
        },
        {
