        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.9",
            "verseOrgIds": [
              "JUD.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JUD 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lababantu bathuka konke abangakwaziyo; lalokho abakwaziyo ngemvelo njengezinyamazana ezingelangqondo babhubha ngakho. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.10",
            "verseOrgIds": [
              "JUD.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JUD 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maye kibo! Ngoba bahamba endleleni kaKayini; baziwisele ekuduheni kukaBalami ngenxa yenzuzo; baphika njengoKora, ngakho babhubha.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.11",
            "verseOrgIds": [
              "JUD.1.11"
            ]
          }
        },
