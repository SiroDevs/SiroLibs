        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.5",
            "verseOrgIds": [
              "JUD.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JUD 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezithunywa ezingagcinanga izikhundla zazo, kodwa zatshiya indawo zazo, zigcinelwe ukulahlwa mhla wosuku olukhulu, zibotshiwe ngezibopho ezingaqamukiyo ngaphansi komnyama. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.6",
            "verseOrgIds": [
              "JUD.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JUD 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokunjalo iSodoma leGomora lemizi yakhona eyenza ukuphinga njengazo, yazinikela enkanukweni ezingasizo zemvelo, yenziwa isibonelo ngokutshaywa ngomlilo ongapheliyo.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.7",
            "verseOrgIds": [
              "JUD.1.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
