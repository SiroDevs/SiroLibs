              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JUD 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathandekayo, lapho ngisatshisakela ukulilobela ngokusiliswa esikuhlanganyelayo, ngabona ukuthi kuswelekile ukuba ngililobele, ngilikhuthaze, ukuba lilwele ukukholwa abakunikwayo abangcwele kwaba kanye. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.3",
            "verseOrgIds": [
              "JUD.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JUD 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba sekungenile ngokunyenya abantu abathile abamiselwa lokhukulahlwa kudala, abantu abeyisa uNkulunkulu, abaphendula umusa kaNkulunkulu wethu ube ngamanyala, bephika uMbusi oyedwa leNkosi yethu uJesu Kristu. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.4",
            "verseOrgIds": [
              "JUD.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JUD 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngithanda ukulikhumbuza, loba belikwazi konke, ukuthi iNkosi eyasilisa isizwe ngokusikhupha elizweni laseGibithe yabuya yababhubhisa labo abangakholwanga.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.5",
            "verseOrgIds": [
              "JUD.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
