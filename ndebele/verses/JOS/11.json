                  "text": "Dute 7:16",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.20",
            "verseOrgIds": [
              "JOS.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa wasuka ngalesosikhathi, wachitha amaAnaki ngasezintabeni, eHebroni leDebiri leAnabi lasezintabeni zakoJuda, lakuzo zonke ezakoIsrayeli; uJoshuwa wawaqothula kanye lemizi yawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.21",
            "verseOrgIds": [
              "JOS.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakusalanga lelilodwa iAnaki elizweni labantu bakoIsrayeli, kuseGaza kuphela leGathi leAshidodi lapho kwasala amanye khona.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.22",
            "verseOrgIds": [
              "JOS.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.22",
            "verseOrgIds": [
              "JOS.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa walithumba ilizwe lonke njengakho konke iNkosi eyakukhuluma kuMose. UJoshuwa wabanika abakoIsrayeli ilizwe ngezizwe zabo, laba ngelabo. Ilizwe laseliphumulake ekulweni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.23",
            "verseOrgIds": [
              "JOS.11.23"
            ]
          }
        }
      ]
