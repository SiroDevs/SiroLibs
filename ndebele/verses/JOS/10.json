          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa wathumba wonke lamakhosi lamazwe awo ngasikhathi sinye, ngoba iNkosi uNkulunkulu kaIsrayeli yamlwela uIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
