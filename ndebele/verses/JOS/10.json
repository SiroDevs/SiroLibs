          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "balithumba ngalolosuku, balichitha ngomkhonto, babaqeda bonke abantu ababekilo ngalolosuku, njengokwenza kwabo eLakishi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.35",
            "verseOrgIds": [
              "JOS.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
