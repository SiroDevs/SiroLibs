          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa wabanqoba kusukela eKadeshi‐Barneya kwaze kwafika eGaza, lalo lonke ilizwe laseGosheni, kwaze kwafika eGibeyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.41",
            "verseOrgIds": [
