          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "balithumba, balichitha ngomkhonto, inkosi yalo kanye lemizi yalo labo bonke abantu ababekilo; kabatshiyanga muntu, njengokwenza kwabo eEgiloni, baqeda bonke abantu ababekilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.37",
            "verseOrgIds": [
              "JOS.10.37"
            ]
          }
        },
