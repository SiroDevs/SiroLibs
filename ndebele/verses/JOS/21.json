          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esizweni sakoRubeni anikwa iBezeri lamadlelo alo, leJahazi lamadlelo alo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.36",
