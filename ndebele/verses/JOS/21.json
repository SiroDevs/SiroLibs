              "type": "text"
            }
          ]
        },
        {
          "text": "Inhloko zezindlu zamaLevi zeza kuEleyazare umpristi lakuJoshuwa indodana kaNuni lakuzo inhloko zezindlu zaboyise bezizwe zakoIsrayeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.1",
            "verseOrgIds": [
              "JOS.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "eShilo elizweni laseKanani, zathi kibo: INkosi yalaya uMose ukuba siphiwe imizi ukuba sihlale kiyo, siphiwe lamadlelo ezifuyo zethu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.2",
            "verseOrgIds": [
              "JOS.21.2"
            ]
          }
        },
