          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engxenyeni yesizwe sakoManase anikwa iTanaki lamadlelo alo, leJibileyamu lamadlelo alo, imizi emibili. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.25",
            "verseOrgIds": [
              "JOS.21.25"
            ]
