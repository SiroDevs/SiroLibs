            "sid": "JOS 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anikwa iShekema, umuzi wokuphephela umbulali, kanye lamadlelo alo ezintabeni zakoEfrayimi, leGezeri lamadlelo alo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.21",
            "verseOrgIds": [
              "JOS.21.21"
            ]
          }
        },
