          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imizi eyanikwa amanye amaKohathi angamaLevi ngenkatho yayivela esizweni sakoEfrayimi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.20",
