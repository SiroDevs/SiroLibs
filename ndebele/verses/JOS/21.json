          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowo lalowomuzi wawulamadlelo inxa zonke, kwakunjalo kuleyo yonke imizi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.42",
