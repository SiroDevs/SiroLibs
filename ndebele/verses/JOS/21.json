          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esizweni sakoAsheri anikwa iMishali lamadlelo alo, leAbidoni lamadlelo alo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.30",
            "verseOrgIds": [
