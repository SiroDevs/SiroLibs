          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaba yimizi elitshumi lambili isiyonke eyanikwa ngenkatho abaseleyo osendweni lwamaMerari angamaLevi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.40",
