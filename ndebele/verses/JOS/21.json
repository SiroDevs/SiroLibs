              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yabanikake abakoIsrayeli lonke ilizwe eyafunga ukubanika lona okhokho babo; sebelithethe bahlala kulo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
