              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esizweni sakoGadi anikwa iRamothi eGileyadi, umuzi wokuphephela umbulali, lamadlelo alo, leMahanayimi lamadlelo alo, ",
          "type": "text",
          "attrs": {
