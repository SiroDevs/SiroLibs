          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esizweni sakoIsakari anikwa iKishiyoni lamadlelo alo, leDaberathi lamadlelo alo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.28",
