          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "leAjaloni lamadlelo alo, leGathi‐Rimoni lamadlelo alo, imizi emine. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.24",
            "verseOrgIds": [
