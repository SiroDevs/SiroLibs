          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "leKedemothi lamadlelo alo, leMefahathi lamadlelo alo, imizi emine. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.37",
            "verseOrgIds": [
              "JOS.21.37"
