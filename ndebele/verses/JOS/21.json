          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "leHeshiboni lamadlelo alo, leJazeri lamadlelo alo, imizi emine isiyonke. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.39",
