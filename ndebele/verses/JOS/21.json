          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imizi yosendo lwamanye amaKohathi yayilitshumi isiyonke kanye lamadlelo ayo.",
          "type": "text",
