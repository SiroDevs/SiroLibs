                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "UIsrayeli wayikhonza iNkosi zonke insuku zikaJoshuwa lazo zonke insuku zabadala abasalayo, ababewazi wonke umsebenzi iNkosi eyawenzela uIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        }
