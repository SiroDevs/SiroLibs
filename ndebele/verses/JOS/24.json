              },
              "items": [
                {
                  "text": "Dute 6:10–11",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.13",
            "verseOrgIds": [
              "JOS.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke yesabeni iNkosi, liyikhonze ngobuqotho langeqiniso, lisuse onkulunkulu okhokho benu ababakhonza ngaphetsheya komfula iYufrathi laseGibithe, likhonze iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.14",
            "verseOrgIds": [
              "JOS.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba lingafuni ukuyikhonza iNkosi, khethani lamhla lowo elizamkhonza, onkulunkulu abakhonzwa ngokhokho benu elizweni elingaphetsheya komfula iYufrathi, loba onkulunkulu bamaAmori elihlala elizweni lawo. Mina lendlu yami sizayikhonza iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.15",
            "verseOrgIds": [
              "JOS.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebephendula abantu besithi: Kakube khatshana lathi ukuba sitshiye iNkosi, sikhonze abanye onkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.16",
            "verseOrgIds": [
              "JOS.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba kuyiyo iNkosi uNkulunkulu wethu eyasikhuphayo thina labokhokho elizweni laseGibithe, endaweni yobugqili, yenza lezizimangaliso ezinkulu phambi kwethu, yasilondoloza kuyo yonke indawo esahamba kiyo, laphakathi kwabo bonke abantu esidlule kibo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.17",
            "verseOrgIds": [
              "JOS.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaxotsha phambi kwethu zonke izizwe, lamaAmori ayehlala kulelilizwe. Ngakhoke lathi sizayikhonza iNkosi, ngoba inguNkulunkulu wethu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.18",
            "verseOrgIds": [
              "JOS.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa wathi ebantwini: Lina lingeyikhonze iNkosi ngoba inguNkulunkulu ongcwele, loNkulunkulu olomona. Kayiyikuthethelela iziphambeko zenu lezono zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.19",
            "verseOrgIds": [
              "JOS.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba liyitshiya iNkosi likhonze onkulunkulu bezizweni, izaphenduka ilenzele okubi, iliqede, ngemva kokulenzela okuhle. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.20",
            "verseOrgIds": [
              "JOS.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bathi kuJoshuwa: Atshi! kodwa sizayikhonza iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.21",
            "verseOrgIds": [
              "JOS.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa wasesithi ebantwini: Lizazifakazela lina ukuthi liyikhethile iNkosi ukuba liyikhonze. Basebesithi: Singofakazi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.22",
            "verseOrgIds": [
              "JOS.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: Khuphanike onkulunkulu bezizweni abaphakathi kwenu, liphendulele inhliziyo zenu eNkosini, uNkulunkulu kaIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.23",
            "verseOrgIds": [
              "JOS.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bathi kuJoshuwa: INkosi uNkulunkulu wethu sizayikhonza, sililalele ilizwi layo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.24",
            "verseOrgIds": [
              "JOS.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke uJoshuwa wasebenzela abantu isivumelwano ngalolosuku, wababekela izimiso lemithetho eShekema. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.25",
            "verseOrgIds": [
              "JOS.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa waloba lawomazwi ogwalweni lomlayo kaNkulunkulu; wathatha ilitshe elikhulu, walibeka khonapho ngaphansi kwesihlahla esikhulu ngasendlini yeNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.26",
            "verseOrgIds": [
              "JOS.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesithi ebantwini bonke: Khangelani, lelilitshe lizakuba ngufakazi ngathi, ngoba liwezwile wonke amazwi iNkosi eyawakhuluma kithi; ngakhoke lizakuba ngufakazi ngani funa limkhohlise uNkulunkulu wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.27",
            "verseOrgIds": [
              "JOS.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa wasebayekela abantu ukuba bahambe, baye endaweni zabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.28",
            "verseOrgIds": [
              "JOS.24.28"
            ]
          }
        }
      ]
    },
