            "sid": "JOS 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngemva kwalezizinto uJoshuwa indodana kaNuni, inceku yeNkosi, wafa eleminyaka elikhulu letshumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamngcwabela endaweni yakhe eTiminathi‐Sera entabeni zakoEfrayimi ngasenyakatho kwentaba iGashi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        },
