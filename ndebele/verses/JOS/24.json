                "loc": "GEN.12.1+GEN.12.2+GEN.12.3+GEN.12.4+GEN.12.5+GEN.12.6+GEN.12.7+GEN.12.8+GEN.12.9"
              },
              "items": [
                {
                  "text": "Gen 12:1–9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.21.1+GEN.21.2+GEN.21.3"
              },
              "items": [
                {
                  "text": "21:1–3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.3",
            "verseOrgIds": [
              "JOS.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "uIsaka ngamnika uJakobe loEsawu. Ngamnika uEsawu izintaba zaseSeyiri ukuba zibe ngezakhe, kodwa uJakobe labantwana bakhe baya eGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.4",
            "verseOrgIds": [
              "JOS.24.4"
            ]
          }
        },
        {
          "name": "note",
