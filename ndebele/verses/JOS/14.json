      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "La ngamazwe abawaphiwayo abakoIsrayeli elizweni laseKanani; uEleyazare umpristi loJoshuwa indodana kaNuni lezinhloko zezindlu zezizwe zabakoIsrayeli babanika wona. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.1",
            "verseOrgIds": [
              "JOS.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazwe abo bawanikwa ngenkatho njengokulaywa kukaMose yiNkosi ngezizwe ezificamunwemunye lengxenye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
