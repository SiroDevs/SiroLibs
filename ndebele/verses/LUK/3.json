          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi bebhaphathiziwe bonke abantu, laye uJesu esebhaphathiziwe, ekhuleka, izulu lavuleka, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.21",
            "verseOrgIds": [
              "LUK.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "uMoya oNgcwele elesimo sejuba wehlela phezu kwakhe; kwezwakala ilizwi livela ezulwini lisithi: Wena uyiNdodana yami ethandekayo; ngithokozile ngawe.",
          "type": "text",
