            "number": "32",
            "style": "v",
            "sid": "LUK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kibo: Hambani lilitshele lelokhanka ukuthi: Khangela, ngiyakhupha omoya ababi, ngisilise lamuhla lakusasa, ngomhlomunye ngiphelelise umsebenzi wami. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngimele ukuba ngihambe lamuhla lakusasa langomhlomunye; ngoba kakulakwenzeka ukuba umprofethi abhubhele ngaphandle kweJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.33",
            "verseOrgIds": [
              "LUK.13.33"
            ]
          }
        }
