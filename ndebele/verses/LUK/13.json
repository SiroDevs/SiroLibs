              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalesosikhathi kwafika abaFarisi abathile, bathi kuye: Suka lapha, ngoba uHerodi ufuna ukukubulala. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.31",
            "verseOrgIds": [
              "LUK.13.31"
            ]
          }
        },
        {
