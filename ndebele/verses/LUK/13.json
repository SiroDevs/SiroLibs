              "type": "text"
            }
          ]
        },
        {
          "text": "Bazakufika bevela empumalanga, lasentshonalanga, lasenyakatho, laseningizimu, bahlale ekudleni embusweni kaNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.29",
