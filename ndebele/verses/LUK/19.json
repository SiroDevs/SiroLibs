              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "esithi kibo: Kulotshiwe ukuthi: Indlu yami izakuba yindlu yokukhuleka; kodwa lina liyenzile ubhalu lwabaphangi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.46",
