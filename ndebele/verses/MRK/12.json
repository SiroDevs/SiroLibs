              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.6.6"
              },
              "items": [
                {
                  "text": "Hos 6:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.33",
            "verseOrgIds": [
              "MRK.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu embona ukuba uphendule ngokuqonda, wathi kuye: Kawukhatshana lombuso kaNkulunkulu. Kakwabe kusaba khona umuntu olesibindi sokumbuza.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.34",
            "verseOrgIds": [
              "MRK.12.34"
            ]
          }
        }
      ]
