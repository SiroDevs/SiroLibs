              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.35"
              },
              "items": [
                {
                  "text": "Dute 4:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.32",
            "verseOrgIds": [
              "MRK.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuyithanda ngenhliziyo yonke, langokuqedisisa konke, langamandla wonke, lokuthanda umakhelwane wakho njengalokhu umuntu ezithanda yena kuyedlula yonke iminikelo yokutshiswa lemihlatshelo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.33",
            "verseOrgIds": [
              "MRK.12.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
