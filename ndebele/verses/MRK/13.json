          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "izakuthuma izithunywa zayo, iqoqe abakhethiweyo bayo emimoyeni emine, kusukela emikhawulweni yomhlaba kuze kube semikhawulweni yezulu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.27",
            "verseOrgIds": [
              "MRK.13.27"
            ]
          }
        }
      ]
