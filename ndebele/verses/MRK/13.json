          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kung’khonake bazakubona iNdodana yomuntu isiza emayezini, ilamandla amakhulu lenkazimulo,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.26",
            "verseOrgIds": [
              "MRK.13.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
