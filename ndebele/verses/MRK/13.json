          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.10"
              },
              "items": [
                {
                  "text": "Isa 13:10",
                  "type": "text"
