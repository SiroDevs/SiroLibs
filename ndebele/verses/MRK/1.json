              "MRK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona esinagogeni labo umuntu owayelomoya omubi, wamemeza, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.23",
            "verseOrgIds": [
              "MRK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "wathi: Silani lawe Jesu waseNazaretha? Uze ukusibhubhisa na? Ngiyakwazi ukuba ungubani: ungoNgcwele kaNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.24",
            "verseOrgIds": [
              "MRK.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wamkhuza wathi: Thula, uphume kuye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.25",
            "verseOrgIds": [
              "MRK.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umoya omubi emhlukuza, ekhala ngelizwi elikhulu, waphuma kuye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.26",
            "verseOrgIds": [
              "MRK.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamangala bonke, baze babuzana bathi: Kuyini lokhu? Yikufundisa okutsha! Ngoba ngamandla uyalaya labomoya ababi, bamlalele. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.27",
            "verseOrgIds": [
              "MRK.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwahle lwanda udumo lwakhe kulo lonke ilizwe laseGalili.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.28",
            "verseOrgIds": [
              "MRK.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.28",
            "verseOrgIds": [
              "MRK.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebephumile esinagogeni bangena masinyane endlini kaSimoni loAndreya beloJakobe loJohane. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.29",
            "verseOrgIds": [
              "MRK.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uninazala kaSimoni wayelele elomkhuhlane; bahle bamtshela ngaye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.30",
            "verseOrgIds": [
              "MRK.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waya kuye, wambamba ngesandla wamlulamisa; umkhuhlane wamyekela, wabasebenzela.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.31",
            "verseOrgIds": [
              "MRK.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.31",
            "verseOrgIds": [
              "MRK.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sekuhlwile, ilanga selitshonile, baletha kuye bonke abagulayo lababengenwe ngomoya ababi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.32",
            "verseOrgIds": [
              "MRK.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuzi wonke wawubuthene ngasemnyango. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.33",
            "verseOrgIds": [
              "MRK.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasilisa abanengi ababegula izifo ngezifo, wakhupha omoya ababi abanengi, kavumelanga omoya ababi ukuthi bakhulume, ngoba babemazi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.34",
            "verseOrgIds": [
              "MRK.1.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.34",
            "verseOrgIds": [
              "MRK.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekuseni kusesemnyama kakhulu, wavuka waphuma, waya endaweni eyinkangala, wakhuleka khona. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.35",
            "verseOrgIds": [
              "MRK.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "USimoni lababelaye bamdinga. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.36",
            "verseOrgIds": [
              "MRK.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebemfumene bathi kuye: Bonke bayakufuna. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.37",
            "verseOrgIds": [
              "MRK.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kubo: Asiye kwezinye indawo emizini eseduze ukuze ngitshumayele lakhona, ngoba ngiphumele lokhu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.38",
            "verseOrgIds": [
              "MRK.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahamba etshumayela emasinagogeni abo kulo lonke elaseGalili, ekhupha omoya ababi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.39",
            "verseOrgIds": [
              "MRK.1.39"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
