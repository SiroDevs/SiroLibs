          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.44",
            "verseOrgIds": [
              "MRK.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa yena esephumile waqala ukutshumayela kakhulu wayandisa leyondaba, kwaze kwathi uJesu kabesaba lakho ukungena emzini obala; kodwa wayengaphandle endaweni eziyinkangala; beza kuye bevela inxa zonke.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.45",
            "verseOrgIds": [
              "MRK.1.45"
            ]
          }
        }
