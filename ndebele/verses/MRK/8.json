              "MRK.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu labafundi bakhe baphuma, baya emizini yaseKesariya Filiphi. Besendleleni, wababuza abafundi bakhe, wathi kubo: Abantu bathi ngingubani na? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.27",
            "verseOrgIds": [
              "MRK.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baphendula bathi: UJohane uMbhaphathizi; abanye bathi: UnguElija; labanye bathi: Ungomunye wabaprofethi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.28",
            "verseOrgIds": [
              "MRK.8.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.14+MRK.6.15"
              },
              "items": [
                {
                  "text": "Mark 6:14–15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.7+LUK.9.8"
              },
              "items": [
                {
                  "text": "Luka 9:7–8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.28",
            "verseOrgIds": [
              "MRK.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasebabuza esithi: Linake lithi ngingubani na? UPetro wamphendula wathi kuye: Wena unguKristu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.29",
            "verseOrgIds": [
              "MRK.8.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.68+JHN.6.69"
              },
              "items": [
                {
                  "text": "Joha 6:68–69",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.29",
            "verseOrgIds": [
              "MRK.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabalayisisa ukuba bangatsheli muntu ngaye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.30",
            "verseOrgIds": [
              "MRK.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
