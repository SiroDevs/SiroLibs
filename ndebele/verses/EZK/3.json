  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "EZK 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yasisithi kimi: Ndoda, dlana okunikwayo, dlana lumqulu, uhambe uyekhuluma koIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.1",
            "verseOrgIds": [
              "EZK.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.10.9+REV.10.10"
              },
              "items": [
                {
                  "text": "Isam 10:9–10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.1",
            "verseOrgIds": [
              "EZK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengivula umlomo wami, yanginika umqulu ukuba ngiwudle. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.2",
            "verseOrgIds": [
              "EZK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yathi kimi: Ndoda, dlana lumqulu engikunika wona, ukuba usuthe. Ngasengiwudla, waba mnandi njengoluju emlonyeni wami.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.3",
            "verseOrgIds": [
              "EZK.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.3",
            "verseOrgIds": [
              "EZK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yasisithi kimi: Ndoda, hamba uye koIsrayeli, ukhulume amazwi ami kibo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.4",
            "verseOrgIds": [
              "EZK.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba kangikuthumi ebantwini abakhuluma ulimi lwezizweni lolimi olulukhuni, kodwa ngikuthuma koIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.5",
            "verseOrgIds": [
              "EZK.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kangikuthumi ebantwini abakhulu abakhuluma ulimi lwezizweni lolulukhuni, abalamazwi ongeke uwezwe. Uba bengikuthuma kwabanjalo, bebezakukuzwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.6",
            "verseOrgIds": [
              "EZK.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa abakoIsrayeli kabayikukuzwa, ngoba kabathandi ukungizwa mina; bonke balukhuni, kabezwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.7",
            "verseOrgIds": [
              "EZK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lawe ngizakukwenza ufane labo, ngizakukwenza ube lukhuni njengabo, ngikwenze ukuba ungezwa njengabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.8",
            "verseOrgIds": [
              "EZK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakukwenza ube njengendayimana elukhuni kulensengentshe. Ungabesabi, ungathuthumeli ngabo ngoba bengabahlamukileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.9",
            "verseOrgIds": [
              "EZK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi yathi kimi: Ndoda, wonke amazwi ami engiwatshoyo kuwe amukele enhliziyweni yakho, uwezwe ngendlebe zakho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.10",
            "verseOrgIds": [
              "EZK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suka, uye ebantwini bakini abathunjiweyo, ukhulume kibo, loba bezakukuzwa loba bengayikukuzwa, uthi: Nanka amazwi eNkosi uNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.11",
            "verseOrgIds": [
              "EZK.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.11",
            "verseOrgIds": [
              "EZK.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umoya wasengiphakamisa; kwathi lapho ubukhosi beNkosi busuka endaweni yabo, ngezwa emva kwami umdumo unjengowokunyikinyeka komhlaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.12",
            "verseOrgIds": [
              "EZK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakungumdumo wokuthintana kwempiko zezidalwa eziphilayo, lomsindo wamavili ayeseceleni kwazo, okwezwakala njengokunyikinyeka komhlaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.13",
            "verseOrgIds": [
              "EZK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umoya wasengiphakamisa, wangisusa; ngahamba ngifutheka emoyeni wami, isandla seNkosi sinzima phezu kwami.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.14",
            "verseOrgIds": [
              "EZK.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.14",
            "verseOrgIds": [
              "EZK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngafikake kwabathunjiweyo eTelabibi, ababehlala ngasemfuleni iKebari. Ngahlala phakathi kwabo insuku eziyisikhombisa ngithithibele. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.15",
            "verseOrgIds": [
              "EZK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekucineni kwensuku eziyisikhombisa ilizwi leNkosi lafika kimi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.16",
            "verseOrgIds": [
              "EZK.3.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.1+EZK.33.2+EZK.33.3+EZK.33.4+EZK.33.5+EZK.33.6+EZK.33.7+EZK.33.8+EZK.33.9"
              },
              "items": [
                {
                  "text": "Hez 33:1–9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.16",
            "verseOrgIds": [
              "EZK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "lathi: Ndoda, ngikwenzile waba ngumlindi wabakoIsrayeli. Lapho usizwa ilizwi elivela kimi, ungixwayisele bona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.17",
            "verseOrgIds": [
              "EZK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho ngisithi komubi: Uzakufa impela; wena uba ungamxwayisi, loba ungakhulumi ukumxwayisa omubi endleleni yakhe embi ukuze aphephe, lowomuntu omubi uzafela ebubini bakhe; kodwa igazi lakhe ngizalibiza kuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.18",
            "verseOrgIds": [
              "EZK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba wena umxwayisa omubi, angabuyi ebubini bakhe loba endleleni yakhe embi, uzafela ebubini bakhe; kodwa wena uzakuphepha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.19",
            "verseOrgIds": [
              "EZK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lalapho olungileyo ephambuka ekulungeni kwakhe, enze okubi, ngibeke isikhubekiso phambi kwakhe, uzakufa. Ngoba ungamxwayisanga yena, uzafela ezonweni zakhe kuthi izenzo zakhe ezilungileyo azenzileyo zingakhunjulwa. Kodwa igazi lakhe ngizalibiza kuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.20",
            "verseOrgIds": [
              "EZK.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lapho umxwayisa olungileyo ukuba angoni, angaze ona, uzaphila, ngoba ezwile ukuxwayisa kwakho; wena uzakuphepha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.21",
            "verseOrgIds": [
              "EZK.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.21",
            "verseOrgIds": [
              "EZK.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isandla seNkosi saba phezu kwami lapho, yathi kimi: Sukuma, uye esigodini, ngizakhuluma kuwe khona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.22",
            "verseOrgIds": [
              "EZK.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengisukuma ngisiya esigodini. Inkazimulo yeNkosi yayimi khona, injengenkazimulo engangiyibonile ngasemfuleni iKebari; ngathi mbo ngobuso. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.23",
            "verseOrgIds": [
              "EZK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umoya wangena kimi, wangimisa ngenyawo zami, wakhuluma kimi wathi: Hamba uyezivalela endlini yakho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.24",
            "verseOrgIds": [
              "EZK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenake, ndoda, uzabotshwa ngamagoda ukuze ungaphumeli ebantwini; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.25",
            "verseOrgIds": [
              "EZK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngizakwenza ukuba ulimi lwakho lunamathele olwangeni lomlomo wakho ube yisimungulu, ungabakhuzi, ngoba bayisizwe esihlamukileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.26",
            "verseOrgIds": [
              "EZK.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lapho sengikhuluma kuwe, ngizavula umlomo wakho, uzakuthi kibo: Nanka amazwi eNkosi uNkulunkulu. Lowo othanda ukuzwa kezwe; ongathandiyo ukuzwa angezwa; ngoba bayisizwe esihlamukileyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.27",
            "verseOrgIds": [
              "EZK.3.27"
            ]
          }
        }
      ]
    }
  ],
