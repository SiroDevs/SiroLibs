              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wetshumi lambili, ngosuku lokuqala enyangeni yetshumi lambili, ilizwi leNkosi lafika kimi lathi:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.1",
            "verseOrgIds": [
              "EZK.32.1"
            ]
          }
        }
