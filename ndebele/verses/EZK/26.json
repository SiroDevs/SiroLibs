              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi uNkulunkulu ithi: Ngizaletha eTire uNebukadineza inkosi yaseBabiloni, ivela enyakatho, eyinkosi yamakhosi, elamabhiza lenqola zokulwa, labagadi bamabhiza, lexuku elikhulu lamabutho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.7",
            "verseOrgIds": [
              "EZK.26.7"
            ]
          }
        }
