        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi uNkulunkulu ithi kulo iTire: Kawayikuthuthumela yini amazwe angasolwandle ngomdumo wokuwa kwakho, lapho abagwaziweyo bebubula labafayo besifa phakathi kwakho na? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.15",
            "verseOrgIds": [
              "EZK.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’khonake zonke izikhulu zangasolwandle zizakwehla ezihlalweni zazo zobukhosi, zikhumule izingubo zazo, zikhuphe izambatho zazo ezicecisiweyo; zigcwale ukuthuthumela, zihlale phansi zithuthumele isikhathi sonke, zimangale zonke.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.16",
            "verseOrgIds": [
              "EZK.26.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
