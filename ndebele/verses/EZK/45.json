      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekwahlukaniseni kwenu ilizwe ngenkatho ukuba zonke izizwe zinikwe isabelo, lizakwahlukanisela iNkosi ingxenye yelizwe ibe yindawo engcwele, ubude bayo bube zingalo ezizinkulungwane ezingamatshumi amabili lanhlanu, lobubanzi bayo bube zingalo ezizinkulungwane ezingamatshumi amabili. Yonke izakuba ngcwele. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.1",
            "verseOrgIds": [
              "EZK.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulokhu indawo eyizingalo ezingamakhulu amahlanu ubude, lamakhulu amahlanu ububanzi, izakuba yindawo yendlu engcwele, ibe legceke eliyibhodayo elizingalo ezingamatshumi amahlanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.2",
            "verseOrgIds": [
              "EZK.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endaweni engcwele lizalinganisa isigaba, ubude baso bube zingalo ezizinkulungwane ezingamatshumi amabili lanhlanu, lobubanzi baso bube zingalo ezizinkulungwane ezilitshumi, okuzakuba khona indlu engcwele, indawo engcwele kakhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.3",
            "verseOrgIds": [
              "EZK.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibe yingxenye engcwele yelizwe, sizakuba ngesabapristi abakhonzayo endlini engcwele, abasondela ukukhonza iNkosi, sizakuba yindawo yezindlu zabo lendawo engcwele yendlu engcwele. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.4",
            "verseOrgIds": [
              "EZK.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esinye isigaba ubude baso buzingalo ezizinkulungwane ezingamatshumi amabili lanhlanu, lobubanzi baso bube zingalo ezizinkulungwane ezilitshumi, sizakuba ngesamaLevi akhonzayo ethempelini, sibe ngesemizi yawo ahlala kiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.5",
            "verseOrgIds": [
              "EZK.45.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lizanika umuzi indawo phansi kwelizwe lendlu engcwele, ubude bayo bube zingalo ezizinkulungwane ezingamatshumi amabili lanhlanu, lobubanzi bayo bube zingalo ezizinkulungwane ezinhlanu, izakuba ngeyakhe wonke uIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.6",
            "verseOrgIds": [
              "EZK.45.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indawo esemaceleni womabili endawo engcwele lawendawo yomuzi izakuba ngeyesikhulu, lendawo eseduze lendawo engcwele leseduze lomuzi, esuka entshonalanga eqonda entshonalanga, lesuka empumalanga eqonda empumalanga, ubukhulu bayo bulingana lesinye sezigaba phakathi kwentshonalanga lempumalanga yemingcele yelizwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.7",
            "verseOrgIds": [
              "EZK.45.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izakuba yindawo yesikhulu koIsrayeli. Izikhulu zami kaziyikubacindezela abantu bami, kodwa zizavumela abakoIsrayeli balisebenzise ilizwe libe ngelezizwe zabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.8",
            "verseOrgIds": [
              "EZK.45.8"
            ]
          }
        }
      ]
    },
