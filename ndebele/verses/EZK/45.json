          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "imvu eyodwa emhlambini wezimvu ezingamakhulu amabili, emizini yakoIsrayeli. Nanku umnikelo weminikelo yempuphu, leminikelo yokutshiswa, leminikelo yokuthula yokubenzela ukubuyisana, kutsho iNkosi uNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.15",
            "verseOrgIds": [
              "EZK.45.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abantu belizwe bazanika isikhulu sakoIsrayeli lumnikelo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.16",
            "verseOrgIds": [
              "EZK.45.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzakuba ngumsebenzi wesikhulu ukunika iminikelo yokutshiswa leminikelo yempuphu leminikelo yokuthululwa emikhosini, ngesikhathi sokuthwasa kwenyanga, langamaSabatha, lakuyo yonke imikhosi emisiweyo yakoIsrayeli. Sizanikela umnikelo wesono lomnikelo wempuphu lomnikelo wokutshiswa lomnikelo wokuthula ukubenzela ukubuyisana labakoIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.17",
            "verseOrgIds": [
              "EZK.45.17"
            ]
          }
        }
      ]
    },
