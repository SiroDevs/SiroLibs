          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanku umnikelo abantu abazakuwunikela; ingxenye yesithupha ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13",
            "verseOrgIds": [
              "EZK.45.13"
            ]
          }
        },
        {
