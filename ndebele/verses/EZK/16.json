          ]
        },
        {
          "text": "kanti ngizakhumbula isivumelwano sami lawe, esensukwini zobutsha bakho, ngenze lawe isivumelwano esingelakuphela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.16.60",
            "verseOrgIds": [
              "EZK.16.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
