          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’khona uzakhumbula indlela zakho, ube lenhloni lapho sengithatha odadewenu, omdala kanye lomncinyane, ngikunike babe ngamadodakazi akho, kodwa kungabi ngenxa yesivumelwano sami lawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.16.61",
            "verseOrgIds": [
              "EZK.16.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "EZK 16:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakwenza isivumelwano sami lawe ukuba wazi ukuthi ngiyiNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.16.62",
            "verseOrgIds": [
              "EZK.16.62"
            ]
          }
        },
        {
