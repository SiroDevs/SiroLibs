                "loc": "REV.8.5"
              },
              "items": [
                {
                  "text": "Isam 8:5",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
