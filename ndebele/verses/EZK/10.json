              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.2"
              },
              "items": [
                {
                  "text": "Isam 4:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yasisithi emuntwini ogqoke ilembu elihle: Ngena phakathi kwamavili atshibilika ngaphansi ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "text": ", ugcwalise izandla zakho ngamalahle avuthayo avela phakathi ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "text": ", uwachithele phakathi komuzi. Ngambonake engena.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
