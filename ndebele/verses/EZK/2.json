      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lathi kimi: Ndoda, sukuma ume ngenyawo, ngizakhuluma kuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.1",
            "verseOrgIds": [
              "EZK.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisakhuluma lami kwangena kimi umoya; wangimisa ngenyawo zami; ngalilalela likhuluma, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.2",
            "verseOrgIds": [
              "EZK.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "lathi kimi: Ndoda, ngiyakuthuma ebantwini bakoIsrayeli, esizweni esihlamukayo, esingivukelayo. Bona labokhokho babo bonile kimi kuze kube lamuhla. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.3",
            "verseOrgIds": [
              "EZK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lalesisizukulwana engikuthuma kiso silukhuni, kasizwa lapho usithi kiso: Nanka amazwi eNkosi uNkulunkulu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.4",
            "verseOrgIds": [
              "EZK.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "bazakwazi ukuthi kukhona umprofethi phakathi kwabo loba belalela, loba bengalaleli, ngoba bayisizwe esihlamukayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.5",
            "verseOrgIds": [
              "EZK.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndoda, ungabesabi, ungawesabi lamazwi abo, lanxa usemeveni, uhlezi phezu kwabofezela. Ungawesabi amazwi abo, ungabesabi, ngoba bayisizwe esihlamukayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.6",
            "verseOrgIds": [
              "EZK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakhuluma amazwi ami kibo, loba besizwa loba bengezwa; ngoba bayisizwe esihlamukayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.7",
            "verseOrgIds": [
              "EZK.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
