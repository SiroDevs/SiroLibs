                {
                  "text": "Isam 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.9",
            "verseOrgIds": [
              "EZK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawusombulula phambi kwami, wawubhaliwe ngaphakathi langaphandle amazwi okulila lokukhala lokububula.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.10",
