            "sid": "EZK 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wesificamunwemunye, ngosuku lwetshumi enyangeni yetshumi, ilizwi leNkosi lafika kimi lathi: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.1",
            "verseOrgIds": [
              "EZK.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndoda, bhala ibizo lalolusuku, lona lolusuku kanye, ngoba inkosi yaseBabiloni isivimbezele iJerusalema ngalona lolusuku.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.2",
            "verseOrgIds": [
              "EZK.24.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
