            }
          ]
        },
        {
          "text": "INkosi uNkulunkulu ithi: Lalokhu abakoIsrayeli bazangicela ukuba ngibenzele khona, ukuba ngandise abantu babo ngangomhlambi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.37",
            "verseOrgIds": [
              "EZK.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
