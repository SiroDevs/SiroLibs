  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "EZK 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasengikhuphela egumeni elingaphandle, ngasenyakatho, wangisa ezindlini ezaziqondene legceke lethempeli maqondana lendlu engasenyakatho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.1",
            "verseOrgIds": [
              "EZK.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubude bendlu eyayingasenyakatho babuzingalo ezilikhulu, lobubanzi bayo buzingalo ezingamatshumi amahlanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.2",
            "verseOrgIds": [
              "EZK.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endaweni eseleyo eyizingalo ezingamatshumi amabili eyayihlangene lendlu engaphakathi ledundulwini eligandelweyo elegceke elingaphandle, kwakukhona imikhandlo emithathu eyelekeneyo efananayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.3",
            "verseOrgIds": [
              "EZK.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphambi kwezindlu kwakukhona indlela, ububanzi bayo buzingalo ezilitshumi, lobude bayo buzingalo ezilikhulu eyayiqonda egumeni elingaphakathi; iminyango yazo yayikhangele ngasenyakatho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.4",
            "verseOrgIds": [
              "EZK.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izindlu ezingaphezulu zazinciphile kulezindlu ezingaphansi leziphakathi, ngoba imikhandlo yayiziminyanisile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.5",
            "verseOrgIds": [
              "EZK.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba zonke zazelekene zintathu, zingelansika njengeguma; eziphezulu zinciphile kuleziphakathi lezingaphansi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.6",
            "verseOrgIds": [
              "EZK.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umduli wangaphandle ubude bawo buzingalo ezingamakhulu amahlanu, wahamba ngaphambi kwezindlu, ulinganisene lazo, ngasendaweni yeguma elingaphandle. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.7",
            "verseOrgIds": [
              "EZK.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izindlu ezazixhumene leguma elingaphandle ubude bazo babuzingalo ezingamatshumi amahlanu; lalezo ezazikhangelene lethempeli ubude bazo buzingalo ezilikhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.8",
            "verseOrgIds": [
              "EZK.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphansi kwalezizindlu kwakukhona umnyango ovelela ngasempumalanga lapho umuntu engena evelela egumeni elingaphandle, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.9",
            "verseOrgIds": [
              "EZK.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "lapho kwakuqalisa khona umduli weguma. Lasendaweni engaseningizimu, ukudlula igceke eliseleyo kanye lendlu, kwakukhona ezinye izindlu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.10",
            "verseOrgIds": [
              "EZK.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulendlela phambi kwazo. Lezizindlu zazifanana ngobude langobubanzi langesinye isimo lalezo ezikhangele inyakatho, leminyango yazo yokuphuma leyokungena eyayifana leyezindlu ezingaseningizimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.11",
            "verseOrgIds": [
              "EZK.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho umuntu eqonda ngasempumalanga, lapho kuqalisa indlela khona, kwakulomnyango emdulini wangaphakathi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesithi kimi: Izindlu ezingasenyakatho leziqondene lazo ngaseningizimu ziyizindlu ezingcwele, lapho abapristi abeza eNkosini bazadlela khona iminikelo engcwele kakhulu; babeke khona iminikelo engcwele kakhulu, umnikelo wamabele, lomnikelo wesono, lomnikelo wecala, ngoba indawo ingcwele. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.13",
            "verseOrgIds": [
              "EZK.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho abapristi bengena endaweni engcwele, kabayikuphumela egumeni elingaphandle bengazibekanga lapho izambatho abakhonza ngazo, ngoba lezi zingcwele. Bazagqoka ezinye izambatho bengakasondeli eduze lalokho okungokwabantu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi nxa eseqedile ukulinganisa ngaphakathi kwethempeli, wangikhupha ngesango elikhangele impumalanga, walinganisa ithempeli ngakuleyondawo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.15",
            "verseOrgIds": [
              "EZK.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomhlanga wokulinganisa walinganisa indawo engasempumalanga, yaba zingalo ezingamakhulu amahlanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.16",
            "verseOrgIds": [
              "EZK.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasephenduka elinganisa indawo engasenyakatho, yaba zingalo ezingamakhulu amahlanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.17",
            "verseOrgIds": [
              "EZK.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasephenduka elinganisa indawo engaseningizimu, yaba zingalo ezingamakhulu amahlanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.18",
            "verseOrgIds": [
              "EZK.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasephenduka elinganisa indawo engasentshonalanga, yaba zingalo ezingamakhulu amahlanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.19",
            "verseOrgIds": [
              "EZK.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walinganisa indawo zozine. Lalilomduli olizingelezeleyo, uzingalo ezingamakhulu amahlanu ubude, lezingalo ezingamakhulu amahlanu ububanzi, ukwahlukanisa okungcwele lokungangcwele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.20",
            "verseOrgIds": [
              "EZK.42.20"
            ]
          }
        }
      ]
    }
  ],
