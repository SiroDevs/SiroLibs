          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.29",
            "verseOrgIds": [
              "EXO.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusisa uMose wathi ebantwini: Lenze isono esikhulu; khathesi sengizakukhuphukela eNkosini; mhlawumbe ngingenza indlela yokubuyisana esonweni senu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.30",
            "verseOrgIds": [
              "EXO.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wasebuyela eNkosini wathi: Maye! Lababantu benzile isono esikhulu, bazenzele onkulunkulu begolide. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.31",
            "verseOrgIds": [
              "EXO.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba ubathethelela isono — uba ungabathetheleli, ungisuse ogwalweni lwakho olulobileyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.32",
            "verseOrgIds": [
              "EXO.32.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
