      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJetro umpristi waseMidiyani, uyisezala kaMose, wezwa konke uNkulunkulu amenzele khona uMose labakoIsrayeli abantu bakhe, ukuthi iNkosi yayibakhuphile eGibithe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.1",
            "verseOrgIds": [
              "EXO.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJetro uyisezala kaMose wamamukela uZipora umkaMose emva kokumbuyisela kwakhe uMose,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.2",
            "verseOrgIds": [
              "EXO.18.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.21"
              },
              "items": [
                {
                  "text": "Eks 2:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.2",
            "verseOrgIds": [
              "EXO.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanye lamadodana akhe amabili; ibizo lenye lalinguGereshoma, ngoba wathi: Ngangihlala elizweni lasezizweni;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.3",
            "verseOrgIds": [
              "EXO.18.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.29"
              },
              "items": [
                {
                  "text": "Seb 7:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.3",
            "verseOrgIds": [
              "EXO.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibizo lenye linguEliyezeri, ngoba wathi: UNkulunkulu kababa ube ngumsizi wami, wangikhulula emkhontweni kaFaro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.4",
            "verseOrgIds": [
              "EXO.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJetro uyisezala kaMose wafika kuMose enkangala elamadodana akhe lomkakhe, ngasentabeni kaNkulunkulu lapho wayemise khona amathente akhe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.5",
            "verseOrgIds": [
              "EXO.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwabikwa kuMose kwathiwa: UJetro uyihlozala uyeza kuwe kanye lomkakho lamadodana akho amabili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.6",
            "verseOrgIds": [
              "EXO.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose waphuma ukumhlangabeza uyisezala, wakhothama, wamanga. Babuzana impilo; bangena ethenteni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.7",
            "verseOrgIds": [
              "EXO.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wasemlandisela uyisezala ngakho konke iNkosi eyayikwenzile kuFaro lakuwo amaGibithe ngenxa yabakoIsrayeli, langezinhlupheko zonke ezazibehlele endleleni, lokuthi iNkosi yayibakhulule. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.8",
            "verseOrgIds": [
              "EXO.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJetro wathokoza ngakho konke okuhle iNkosi ebikwenzele abakoIsrayeli ngokubakhulula kwayo ezandleni zamaGibithe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.9",
            "verseOrgIds": [
              "EXO.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJetro wathi: Kayibongwe iNkosi elikhulule ezandleni zamaGibithe lasesandleni sikaFaro; yabophula abantu ababecindezelwa ngamaGibithe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.10",
            "verseOrgIds": [
              "EXO.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khathesi sengisazi ukuthi iNkosi yinkulu kulabo bonke onkulunkulu, yebo kulokho amaGibithe ayezigabisa ngakho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.11",
            "verseOrgIds": [
              "EXO.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJetro uyisezala kaMose wanikela kuNkulunkulu umnikelo wokutshiswa lemihlatshelo; kweza uAroni labo bonke abalisa bakoIsrayeli, badla loyisezala kaMose phambi kukaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.12",
            "verseOrgIds": [
              "EXO.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.12",
            "verseOrgIds": [
              "EXO.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi kusisa uMose wahlala ukwahlulela abantu; abantu bema kuMose kusukela ekuseni kwaze kwahlwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.13",
            "verseOrgIds": [
              "EXO.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho uyisezala kaMose esekubonile konke uMose akwenzela abantu wathi: Kuyini lokhu okwenzela abantu na? Uhlalelani wedwa, abantu bonke bemi kuwe kusukela ekuseni kuze kuhlwe na? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.14",
            "verseOrgIds": [
              "EXO.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wathi kuyisezala: Kungoba abantu beza kimi ukubuza kuNkulunkulu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.15",
            "verseOrgIds": [
              "EXO.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nxa belendaba, beza kimi, ngahlulele phakathi komuntu lomakhelwane wakhe, ngibazise imithetho lemilayezelo kaNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.16",
            "verseOrgIds": [
              "EXO.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyisezala kaMose wathi kuye: Lokho okwenzayo kakulunganga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.17",
            "verseOrgIds": [
              "EXO.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impela uzakuzidinisa kanye lalababantu abalawe; ngoba lokhu kuyakusinda, kawulakukwenza wedwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.18",
            "verseOrgIds": [
              "EXO.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lalela ilizwi lami; ngizakukweluleka, uNkulunkulu abe lawe. Ube ngumkhulumeli wabantu phambi kukaNkulunkulu, ulethe izindaba zabo kuNkulunkulu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.19",
            "verseOrgIds": [
              "EXO.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubafundise imithetho lemilayezelo, ubatshengise indlela abamele bahambe ngayo, lezinto abamele bazenze. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.20",
            "verseOrgIds": [
              "EXO.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhike ukhethe phakathi kwabo bonke abantu amadoda alamandla, amesabayo uNkulunkulu, aqotho, azonda inzuzo engalunganga, uwabeke phezu kwabantu ukuba abe yizinduna zezinkulungwane lezinduna zamakhulu lezinduna zamatshumi amahlanu lezinduna zamatshumi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.21",
            "verseOrgIds": [
              "EXO.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kube yizo ezahlulela abantu ngazo zonke izikhathi, kulethwe kuwe zonke indaba ezinkulu, kodwa indaba ezincinyane zahlulelwe yizo, ukuze kube lula kuwe, zithwalisane lawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.22",
            "verseOrgIds": [
              "EXO.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba usenza lokhu, loNkulunkulu evumelana lakho, uzakuba lamandla okusebenza, labo bonke lababantu bazabuyela endaweni zabo ngokuthula.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.23",
            "verseOrgIds": [
              "EXO.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.23",
            "verseOrgIds": [
              "EXO.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose walilalela ilizwi likayisezala, wenza konke akutshiloyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.24",
            "verseOrgIds": [
              "EXO.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wakhetha amadoda alamandla phakathi kwabo bonke abakoIsrayeli, wawabeka aba yizinhloko zabantu, induna zezinkulungwane lezinduna zamakhulu lezinduna zamatshumi amahlanu lezinduna zamatshumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.25",
            "verseOrgIds": [
              "EXO.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zabahlulela abantu ngezikhathi zonke; zaletha kuMose indaba ezinkulu, kodwa indaba ezincinyane zazahlulela zona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.26",
            "verseOrgIds": [
              "EXO.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wamvalelisa uyisezala; wasuka wabuyela elizweni lakibo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.27",
            "verseOrgIds": [
              "EXO.18.27"
            ]
          }
        }
      ]
    }
  ],
