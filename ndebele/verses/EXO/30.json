          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impepha ozakuyenza ngendlela yokwenziwa kwayo ungazenzeli yona; kayibe ngcwele kuwe, yenzelwe iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.37",
            "verseOrgIds": [
              "EXO.30.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 30:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowo ozakuyenza efanana layo ngephunga layo ayisebenzise, uzakukhutshwa ebantwini bakibo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.38",
