          "attrs": {
            "verseId": "EXO.30.24",
            "verseOrgIds": [
              "EXO.30.24"
            ]
          }
        },
        {
          "text": " angamakhulu amahlanu ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.24",
            "verseOrgIds": [
              "EXO.30.24"
            ]
          }
        },
        {
          "text": " lendlu engcwele, kanye lamafutha ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.24",
            "verseOrgIds": [
              "EXO.30.24"
            ]
          }
        },
        {
          "text": " ",
