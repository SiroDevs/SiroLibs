              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose: Thatha amakha amnandi, ngitsho isitakete leonika legalibanu, amakha kanye lenhlaka enhle, kulingane konke; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.34",
            "verseOrgIds": [
              "EXO.30.34"
            ]
          }
        },
        {
