            "verseId": "EXO.30.24",
            "verseOrgIds": [
              "EXO.30.24"
            ]
          }
        },
        {
          "text": " linye; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.24",
            "verseOrgIds": [
              "EXO.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "wenze konke lokhu ukuba kube ngamagcobo angcwele okugcoba, amakha axutshanisiweyo njengokwenza kompheki wamakha; azakuba ngamagcobo angcwele okugcoba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.25",
            "verseOrgIds": [
              "EXO.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakugcoba ngawo ithente lokuhlangana lomtshokotsho wobufakazi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.26",
            "verseOrgIds": [
              "EXO.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "letafula lezitsha zayo zonke, loluthi lwesibane lezitsha zalo, lealtare lempepha, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.27",
            "verseOrgIds": [
              "EXO.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "lealtare lomnikelo wokutshiswa lezitsha zalo zonke, lomkolo lenyawo zawo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.28",
            "verseOrgIds": [
              "EXO.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukwahlukanisele konke ukuba kube ngcwele kakhulu; lalokho okukuthintayo kuzakuba ngcwele. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.29",
            "verseOrgIds": [
              "EXO.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubagcobe uAroni lamadodana akhe, ubalukhanisele ukuba babe ngabapristi bokuphatha umsebenzi wami. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.30",
            "verseOrgIds": [
              "EXO.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utshele abantu bakoIsrayeli uthi: Lokhu kuzakuba ngamagcobo ami angcwele okugcoba kuzo zonke izizukulwana zenu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.31",
            "verseOrgIds": [
              "EXO.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "angabothelwa emzimbeni womuntu nje; lingawenzi amanye afane lawo ngokwenziwa kwawo; angcwele, futhi abe ngcwele kini. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.32",
            "verseOrgIds": [
              "EXO.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowo owenza afanana lawo loba ewathela kowemzini, uzakukhutshwa ebantwini bakibo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.33",
            "verseOrgIds": [
              "EXO.30.33"
            ]
          }
        }
      ]
