          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yakhuluma kuMose yathi: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.17",
            "verseOrgIds": [
              "EXO.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakwenza umkolo wethusi wokugezela olenyawo zethusi, uwubeke phakathi kwethente lokuhlangana lealtare, uthele kuwo amanzi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.18",
            "verseOrgIds": [
              "EXO.30.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.38.8"
              },
              "items": [
                {
                  "text": "Eks 38:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.18",
            "verseOrgIds": [
              "EXO.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuba uAroni lamadodana akhe bagezele izandla lenyawo kuwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.19",
            "verseOrgIds": [
              "EXO.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nxa bengena ethenteni lokuhlangana loba besondela ealtareni ukuba bakhonze, batshise umnikelo ngomlilo eNkosini, bazageza ngamanzi, ukuba bangafi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.20",
            "verseOrgIds": [
              "EXO.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke bazakugeza izandla lenyawo ukuba bangafi; kuzakuba yisimiso esingapheliyo kubo, kuAroni lenzalo yakhe ezizukulwaneni zabo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.21",
            "verseOrgIds": [
              "EXO.30.21"
            ]
          }
        }
      ]
    },
