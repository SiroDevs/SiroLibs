          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ucholisise enye, uyibeke phambi kobufakazi ethenteni lokuhlangana, lapho ngizahlangana khona lawe; izakuba ngcwele kakhulu kini. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.36",
            "verseOrgIds": [
              "EXO.30.36"
            ]
          }
        },
        {
