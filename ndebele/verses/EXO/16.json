              "type": "text"
            }
          ]
        },
        {
          "text": "Kanti ngosuku lwesikhombisa kwaphuma abanye abantu ukukubutha, kodwa kabakutholanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.27",
