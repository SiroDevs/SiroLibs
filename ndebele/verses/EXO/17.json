          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wakha ialtare, walitha ibizo lokuthi iNkosi iluphawu lwami; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "wathi: Phatha uphawu lweNkosi. Izakulwa loAmaleki izizukulwana ngezizukulwana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        }
      ]
