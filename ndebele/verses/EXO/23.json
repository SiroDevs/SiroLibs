        },
        {
          "text": "Ungalandeli inengi labantu ukwenza okubi, ungabasekeli ngokufakaza ecaleni ukuba kwenziwe isahlulelo esibi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.2",
