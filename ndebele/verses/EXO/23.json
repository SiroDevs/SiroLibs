          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kawuyikwamukela isiphiwo, ngoba isiphiwo siphumputhekisa ababonayo, sonakalise indaba yabalungileyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.8",
