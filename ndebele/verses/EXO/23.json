        },
        {
          "text": "Kodwa ngomnyaka wesikhombisa uzakusiyekela sibe lifusi, ukuba abayanga bakini badle, lalokho okuseleyo kudliwe zinyamazana zeganga. Wenze njalo langesivini sakho ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        },
        {
          "text": " akho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngensuku eziyisithupha uzakwenza umsebeni wakho, uphumule ngosuku lwesikhombisa, kuphumule futhi lenkabi yakho labobabhemi bakho, kuvuseleleke indodana yencekukazi yakho kanye lowezizweni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.12",
            "verseOrgIds": [
