              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hlala khatshana lendaba yamanga, ungabulali ongelacala lolungileyo, ngoba kangiyikumyekela owonileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.7",
            "verseOrgIds": [
              "EXO.23.7"
            ]
          }
        },
        {
