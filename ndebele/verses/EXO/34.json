              "EXO.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugcine umkhosi wesinkwa esingelamvubelo; njengokukulaya kwami udle isinkwa esingelamvubelo insuku eziyisikhombisa ngesikhathi esimisiweyo senyanga kaAbibi, ngoba ngenyanga kaAbibi waphuma eGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.18",
            "verseOrgIds": [
              "EXO.34.18"
            ]
          }
        },
        {
