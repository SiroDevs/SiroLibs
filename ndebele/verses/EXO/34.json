                "loc": "EXO.13.13"
              },
              "items": [
                {
                  "text": "Eks 13:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.20",
            "verseOrgIds": [
              "EXO.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebenza insuku eziyisithupha, kodwa uphumule ngosuku lwesikhombisa, langesikhathi sokulima lesokuvuna.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.21",
            "verseOrgIds": [
              "EXO.34.21"
            ]
          }
        },
