                "loc": "EXO.12.10"
              },
              "items": [
                {
                  "text": "Eks 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.25",
            "verseOrgIds": [
              "EXO.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikhethelo lezithelo zakuqala zamasimu akho ulilethe endlini yeNkosi uNkulunkulu wakho. Ungapheki izinyane ngochago lukanina.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        },
