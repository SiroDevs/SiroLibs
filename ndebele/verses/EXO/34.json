        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose: Baza amanye amatshe amabili anjengawakuqala; ngibhale kuwo amazwi ayesematsheni akuqala owawaphahlazayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.1",
            "verseOrgIds": [
              "EXO.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekuseni ubusulungile, ukhwele entabeni yaseSinayi, uze phambi kwami engqongeni yentaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.2",
            "verseOrgIds": [
              "EXO.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungakhweli muntu kanye lawe, kungabonakali muntu kuyo yonke intaba; ungayekeli izimvu lezinkomo zalukele phambi kwaleyontaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.3",
            "verseOrgIds": [
              "EXO.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wasebaza amatshe amabili anjengawakuqala; wavuka ekuseni, wakhwela entabeni yaseSinayi, njengokutsho kweNkosi, ephethe amatshe amabili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.4",
            "verseOrgIds": [
              "EXO.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yehla ngeyezi, yema laye khona, yamemeza ibizo layo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.5",
            "verseOrgIds": [
              "EXO.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yedlula phambi kwakhe, yamemeza yathi: YiNkosi! YiNkosi! nguNkulunkulu olesihawu olomusa, ophuza ukuthukuthela, ogcwele uthando olungapheliyo lobuqotho,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.6",
            "verseOrgIds": [
              "EXO.34.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
