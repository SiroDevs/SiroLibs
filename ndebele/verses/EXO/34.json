          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konke okuvula isizalo kungokwami, lawo wonke amazibulo amaduna enkomo lawezimvu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.19",
            "verseOrgIds": [
              "EXO.34.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Eks 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.19",
            "verseOrgIds": [
              "EXO.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izibulo likababhemi ulihlenge ngezinyane; uba ungalihlengi ulephule intamo. Wonke amazibulo amadodana akho uzawahlenga; kungezi muntu phambi kwami engaphethe lutho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.20",
            "verseOrgIds": [
              "EXO.34.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
