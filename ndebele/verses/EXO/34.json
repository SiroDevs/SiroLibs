              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kathathu ngomnyaka bonke abesilisa bazakuza phambi kweNkosi uNkulunkulu, uNkulunkulu kaIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngizaxotsha izizwe phambi kwakho, ngandise imikhawulo yelizwe lakho; kakuyikuba lamuntu ofisa ilizwe lakho lapho wenyuka ukuyabonakala phambi kweNkosi uNkulunkulu wakho kathathu ngomnyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unganikeli igazi lomhlatshelo wami kanye lesinkwa esilemvubelo; futhi kakungasali kuze kuse umhlatshelo womkhosi wePhasika.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.25",
            "verseOrgIds": [
              "EXO.34.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
