              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "La ngamabizo amadodana kaIsrayeli afika eGibithe; yileyo laleyo yafika lomuzi wayo,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.1",
            "verseOrgIds": [
              "EXO.1.1"
            ]
          }
        },
        {
