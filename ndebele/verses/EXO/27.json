    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakwenza ialtare ngesihlahla somvagazi, ubude balo bube zingalo ezinhlanu, ububanzi balo bube zingalo ezinhlanu, lilingane inxa zonke, ukudepha kwalo kube zingalo ezintathu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.1",
            "verseOrgIds": [
              "EXO.27.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.38.1+EXO.38.2+EXO.38.3+EXO.38.4+EXO.38.5+EXO.38.6+EXO.38.7"
              },
              "items": [
                {
                  "text": "Eks 38:1–7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.1",
            "verseOrgIds": [
              "EXO.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakwenza impondo zalo engonsini zalo zozine, ukuba lona lempondo zalo kube yintonye kanye lalo; ulibhade ngethusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.2",
            "verseOrgIds": [
              "EXO.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenze izimbiza zokususa umlotha walo, lamafotsholo alo, lemiganu yalo yokuchela, lamafolokwe alo, lezitsha zalo zokuthwala umlilo, uzenze zonke izinto zalo ngethusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.3",
            "verseOrgIds": [
              "EXO.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulenzele isihlengo sethusi esinjengembule, wenze phezu kwalo amasongo amane ethusi ngasengonsini zalo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.4",
            "verseOrgIds": [
              "EXO.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "usibeke ngaphansi komphetho wealtare ukuba imbule lilenge lifinyelele phakathi kwealtare. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.5",
            "verseOrgIds": [
              "EXO.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulenzele ialtare imijabo yesihlahla somvagazi, uyibhade ngethusi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.6",
            "verseOrgIds": [
              "EXO.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "imijabo ifakwe emasongweni ukuba ibe sezinhlangothini zombili zealtare nxa lithwalwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.7",
            "verseOrgIds": [
              "EXO.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulenze ngamapulanka, lifane lomkolo, libe njengalokho watshengiswa entabeni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.8",
            "verseOrgIds": [
              "EXO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.8",
            "verseOrgIds": [
              "EXO.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakwenza iguma ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.9",
            "verseOrgIds": [
              "EXO.27.9"
            ]
          }
        },
        {
          "text": ", libe sohlangothini olungaseningizimu lamakhetheni elembu elihle lentambo ephothiweyo, ubude bawo bube zingalo ezilikhulu ohlangothini lunye;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.9",
            "verseOrgIds": [
              "EXO.27.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.38.9+EXO.38.10+EXO.38.11+EXO.38.12+EXO.38.13+EXO.38.14+EXO.38.15+EXO.38.16+EXO.38.17+EXO.38.18+EXO.38.19+EXO.38.20"
              },
              "items": [
                {
                  "text": "Eks 38:9–20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.9",
            "verseOrgIds": [
              "EXO.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "insika zawo ezingamatshumi amabili lenyawo zazo ezingamatshumi amabili zibe ngezethusi, kodwa ingwegwe zezinsika lezibopho zazo zibe ngezesiliva. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.10",
            "verseOrgIds": [
              "EXO.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohlangothini olungasenyakatho kakube lamakhetheni, ubude bawo bube zingalo ezilikhulu, lensika zawo ezingamatshumi amabili lenyawo zazo ezingamatshumi amabili zibe ngezethusi, kodwa ingwegwe zezinsika lezibopho zazo zibe ngezesiliva. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.11",
            "verseOrgIds": [
              "EXO.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohlangothini olungasentshonalanga, ebubanzini beguma, kakube khona amakhetheni, ububanzi bawo bube zingalo ezingamatshumi amahlanu, kube khona lensika ezilitshumi lenyawo ezilitshumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.12",
            "verseOrgIds": [
              "EXO.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ububanzi beguma lohlangothi olungasempumalanga bube zingalo ezingamatshumi amahlanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.13",
            "verseOrgIds": [
              "EXO.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhetheni olunye uhlangothi lomnyango abe yizingalo ezilitshumi lanhlanu, kanye lensika ezintathu lenyawo ezintathu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.14",
            "verseOrgIds": [
              "EXO.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakolunye uhlangothi amakhetheni abe yizingalo ezilitshumi lanhlanu, kanye lensika ezintathu lenyawo ezintathu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.15",
            "verseOrgIds": [
              "EXO.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umnyango weguma uzakuba leveli, ubude balo bube zingalo ezingamatshumi amabili, lenziwe ngelembu elihle lentambo ephothiweyo eluhlaza leyibubende lebomvu, kube ngumsebenzi womthungi; lizakuba lensika ezine kanye lenyawo ezine. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.16",
            "verseOrgIds": [
              "EXO.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke insika zeguma kazibe lezibopho zesiliva, ingwegwe zazo zibe ngezesiliva lenyawo zazo zibe ngezethusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.17",
            "verseOrgIds": [
              "EXO.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubude beguma bube zingalo ezilikhulu, ububanzi bube zingalo ezingamatshumi amahlanu, ukudepha kube zingalo ezinhlanu, libe lamaveli elembu elihle lentambo ephothiweyo lenyawo zethusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.18",
            "verseOrgIds": [
              "EXO.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke izinto zomsebenzi ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.19",
            "verseOrgIds": [
              "EXO.27.19"
            ]
          }
        },
        {
          "text": " lezikhonkwane zalo zonke kanye lazo zonke izikhonkwane zeguma zizakuba ngezethusi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.19",
            "verseOrgIds": [
              "EXO.27.19"
            ]
          }
        }
      ]
    },
