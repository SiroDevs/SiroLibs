            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.19",
            "verseOrgIds": [
              "EXO.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakubalaya abakoIsrayeli ukuba bakulethele amafutha amahle ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.20",
            "verseOrgIds": [
              "EXO.27.20"
            ]
          }
        },
        {
          "text": " elungiselwe ukukhanyisa, ukuze izibane zivuthe insuku zonke.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.20",
            "verseOrgIds": [
              "EXO.27.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.1+LEV.24.2+LEV.24.3+LEV.24.4"
              },
              "items": [
                {
                  "text": "Levi 24:1–4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.20",
            "verseOrgIds": [
              "EXO.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethenteni lokuhlangana ngaphandle kweveli eliphambi kobufakazi, uAroni lamadodana akhe bazakuzilondoloza phambi kweNkosi, kusukela kusihlwa kuze kube sekuseni; kuzakuba yisimiso esingapheliyo esizagcinwa ngabakoIsrayeli ezizukulwaneni zonke.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.21",
            "verseOrgIds": [
              "EXO.27.21"
            ]
          }
        }
      ]
    }
