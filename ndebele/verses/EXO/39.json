            "sid": "EXO 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "umzila wesine waba ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.13",
            "verseOrgIds": [
              "EXO.39.13"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.13",
            "verseOrgIds": [
              "EXO.39.13"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.13",
            "verseOrgIds": [
              "EXO.39.13"
            ]
          }
        },
        {
          "text": "; amatshe la ayezingelezelwe ngezinto ezitshiliweyo zegolide. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.13",
            "verseOrgIds": [
              "EXO.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona amatshe alitshumi lambili elamabizo amadodana kaIsrayeli; ilelo lalelo ilitshe lalilebizo lesinye sezizwe ezilitshumi lambili libhaliwe njengokubhalwa kwendandatho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.14",
            "verseOrgIds": [
              "EXO.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benza engutsheni yesifuba amaketane egolide elihle anjengamagoda aphothiweyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.15",
            "verseOrgIds": [
              "EXO.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benza izinto ezimbili ezitshiliweyo ngegolide lamasongo amabili egolide, bawathungela womabili emaceleni womabili engubo yesifuba, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.16",
            "verseOrgIds": [
              "EXO.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "bawabeka amaketane amabili egolide emasongweni amabili asemaceleni engubo yesifuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.17",
            "verseOrgIds": [
              "EXO.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izihloko zamaketane womabili bazihlanganisa lezinto ezimbili ezitshiliweyo zegolide, bawabeka ngaphambili ezichibini zengubo yamahlombe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.18",
            "verseOrgIds": [
              "EXO.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benza amasongo amabili egolide, bawathungela emaceleni womabili engubo yesifuba, emphethweni wayo oseduze lengubo yamahlombe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.19",
            "verseOrgIds": [
              "EXO.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benza amasongo amabili egolide, bawathungela ngaphambili ngaphansi kwezichibi zengubo yamahlombe, ekuhlanganeni kwazo, phezu kwebhanti elalukiweyo lengubo yamahlombe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.20",
            "verseOrgIds": [
              "EXO.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawabophela amasongo engubo yesifuba emasongweni engubo yamahlombe ngentambo eluhlaza, ukuba ingubo yesifuba ibe phezu kwebhanti elalukiweyo, ingakhumuki engutsheni yamahlombe; njengokutsho kweNkosi kuMose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.21",
            "verseOrgIds": [
              "EXO.39.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.21",
            "verseOrgIds": [
              "EXO.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasenza lesambatho esiyingubo yamahlombe ngelembu eliluhlaza elalukiweyo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.22",
            "verseOrgIds": [
              "EXO.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "isambatho saba lesikhala ngaphakathi sinjengesikhala sesigqoko, silomphetho owalukiweyo osizingelezayo ukuba singadabuki. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.23",
            "verseOrgIds": [
              "EXO.39.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emiphethweni yaso benza umfanekiso wezithelo ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.24",
            "verseOrgIds": [
              "EXO.39.24"
            ]
          }
        },
        {
          "text": " ngelembu eliluhlaza leliyibubende lelibomvu, ilembu eliphothiweyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.24",
            "verseOrgIds": [
              "EXO.39.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 39:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benza izinto ezikhencezayo zegolide elihle, bazifaka phakathi kwezithelo emiphethweni yesambatho, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.25",
            "verseOrgIds": [
              "EXO.39.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "esinye lesinye isithelo sasilandelwa yinto ekhencezayo yegolide, emiphethweni yesambatho sokukhonza, njengokutsho kweNkosi kuMose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.26",
            "verseOrgIds": [
              "EXO.39.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 39:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebebenzela oAroni lamadodana akhe amabhatshi elembu elihle elalukiweyo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.27",
            "verseOrgIds": [
              "EXO.39.27"
            ]
          }
        },
        {
