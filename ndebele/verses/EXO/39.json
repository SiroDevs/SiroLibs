              "type": "text"
            }
          ]
        },
        {
          "text": "uluthi lwesibane segolide elihle lezibane zalo, izibane zasezifakiwe kulo, lezitsha zalo zonke lamafutha okukhanyisa, ",
          "type": "text",
          "attrs": {
