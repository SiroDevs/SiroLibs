              "EXO.39.10"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.10",
            "verseOrgIds": [
              "EXO.39.10"
            ]
          }
        },
        {
          "text": "; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.10",
            "verseOrgIds": [
              "EXO.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "umzila wesibili waba ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.11",
            "verseOrgIds": [
              "EXO.39.11"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.11",
            "verseOrgIds": [
              "EXO.39.11"
            ]
          }
        },
        {
          "text": " lendayimana; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.11",
            "verseOrgIds": [
              "EXO.39.11"
            ]
          }
        },
