              "type": "text"
            }
          ]
        },
        {
          "text": "lesifulelo sezikhumba ezibomvu zezinqama, lesifulelo sezinzwezwe, leveli elilikhetheni, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.34",
