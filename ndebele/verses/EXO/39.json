              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngelembu eliluhlaza leliyibubende lelibomvu benza izambatho ezinhle zokukhonza endaweni engcwele lezambatho ezingcwele zikaAroni, njengalokhu iNkosi ibimlayile uMose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.1",
            "verseOrgIds": [
              "EXO.39.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
