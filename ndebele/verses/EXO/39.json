              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ialtare lethusi, lesihlengo salo sethusi, lemijabo yalo, lazo zonke izinto zalo, lomkolo lenyawo zawo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.39",
            "verseOrgIds": [
