          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benza incence yomqhele ongcwele ngegolide elihle, babhala kuyo njengokubhalwa kwendandatho ukuthi: Wahlukaniselwe iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.30",
            "verseOrgIds": [
              "EXO.39.30"
            ]
          }
        },
        {
