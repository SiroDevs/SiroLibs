          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babophela kuyo intambo eluhlaza ukuba ibotshelwe eqhiyeni ngaphezulu; njengokutsho kweNkosi kuMose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.31",
