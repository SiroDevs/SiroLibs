              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "lealtare legolide, lamagcobo okugcoba, lempepha elephunga elimnandi, leveli lomnyango wethente, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.38",
