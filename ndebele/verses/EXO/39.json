              "type": "text"
            }
          ]
        },
        {
          "text": "amakhetheni eguma, lensika zalo, lenyawo zalo, leveli lomnyango weguma, lentambo zalo lezikhonkwane zalo, lempahla yonke yenkonzo ",
          "type": "text",
