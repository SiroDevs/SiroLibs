              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakwenza ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.1",
            "verseOrgIds": [
              "EXO.26.1"
            ]
          }
        },
        {
          "text": " ngamaveli alitshumi elembu elihle elenziwe ngentambo ephothiweyo eluhlaza leyibubende lebomvu, abe ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.1",
            "verseOrgIds": [
              "EXO.26.1"
            ]
          }
        },
        {
          "text": " enziwe ngumuntu oyingcitshi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.1",
            "verseOrgIds": [
              "EXO.26.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
