              "items": [
                {
                  "text": "Tit 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.5",
            "verseOrgIds": [
              "EXO.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "lizakuba ngumbuso wabapristi lesizwe esingcwele kimi. Yiwo amazwi ozakuwatsho kwabakoIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.6",
            "verseOrgIds": [
              "EXO.19.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.6"
              },
              "items": [
                {
                  "text": "Isam 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.10"
              },
              "items": [
                {
                  "text": "5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.6",
            "verseOrgIds": [
              "EXO.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wayabiza abalisa babantu, wabatshela wonke amazwi la emlaye wona iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.7",
            "verseOrgIds": [
              "EXO.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abantu baphendula kanyekanye bathi: Konke iNkosi ekukhulumileyo sizakukwenza. UMose wabika eNkosini amazwi abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.8",
            "verseOrgIds": [
              "EXO.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose: Ngiyeza kuwe ngeyezi elimnyama ukuba abantu bezwe nxa ngikhuluma lawe, bakukholwe kuze kube nininini.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.9",
            "verseOrgIds": [
              "EXO.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wayibikela iNkosi amazwi abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.9",
            "verseOrgIds": [
              "EXO.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose: Hamba uye ebantwini, ubatshele bazihlambulule lamuhla lakusasa, bagezise ingubo zabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.10",
            "verseOrgIds": [
              "EXO.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "babe sebelungile ngosuku lwesithathu; ngoba ngosuku lwesithathu iNkosi izakwehlela entabeni yaseSinayi phambi kwabantu bonke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.11",
            "verseOrgIds": [
              "EXO.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakubamisela abantu umkhawulo inxa zonke uthi: Qaphelani ukuba lingakhweli entabeni, lingafinyeleli ewatheni layo. Lowo othinta intaba uzakubulawa;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.12",
            "verseOrgIds": [
              "EXO.19.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.18+HEB.12.19+HEB.12.20"
              },
              "items": [
                {
                  "text": "Heb 12:18–20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.12",
            "verseOrgIds": [
              "EXO.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kazukuthintwa ngesandla, kodwa uzakukhandwa ngamatshe loba ahlatshwe ngomkhonto; loba kuyinyamazana loba kungumuntu, kakuyikuphila. Lapho uphondo selukhala okwesikhathi eside bazakuza entabeni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.13",
            "verseOrgIds": [
              "EXO.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wehla entabeni waya ebantwini, wabatshela ukuba bazihlambulule, bagezise ingubo zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.14",
            "verseOrgIds": [
              "EXO.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi ebantwini: Libe selilungile ngosuku lwesithathu; lingasondeli kowesifazana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.15",
            "verseOrgIds": [
              "EXO.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.15",
            "verseOrgIds": [
              "EXO.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesithathu sekusile, kwaba khona ukuduma lemibane leyezi elimnyama entabeni, kwezwakala ukukhala okukhulu kophondo; bonke abantu ababesemathenteni bathuthumela.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.16",
            "verseOrgIds": [
              "EXO.19.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.11"
              },
              "items": [
                {
                  "text": "Dute 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.16",
            "verseOrgIds": [
              "EXO.19.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.5"
              },
              "items": [
                {
                  "text": "Isam 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.16",
            "verseOrgIds": [
              "EXO.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wasebakhupha abantu emathenteni ukuyamhlangabeza uNkulunkulu; bema ngaphansi kwentaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.17",
            "verseOrgIds": [
              "EXO.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intaba yaseSinayi yayithunqa intuthu, ngoba iNkosi yehlela phezu kwayo ngomlilo; intuthu yayo yenyuka njengentuthu yesithando somlilo; intaba yonke yazamazama kakhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.18",
            "verseOrgIds": [
              "EXO.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukukhala kophondo kwayakukhula. UMose wakhuluma, uNkulunkulu wamphendula ngokuduma. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.19",
            "verseOrgIds": [
              "EXO.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yehlela entabeni yaseSinayi, yafika engqongeni yentaba; yambiza uMose ukuba eze engqongeni yentaba; uMose wakhwela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.20",
            "verseOrgIds": [
              "EXO.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose: Yehla, ubaxwayise abantu funa bafohle ukuzabona iNkosi, bafe abanengi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.21",
            "verseOrgIds": [
              "EXO.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labapristi abasondela eNkosini bazihlambulule funa iNkosi ibadumele. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
              "EXO.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wathi eNkosini: Abantu bangekhwele entabeni yaseSinayi, ngoba wena usilayile wathi: Misa umkhawulo entabeni, uyahlukanise ibe ngcwele. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.23",
            "verseOrgIds": [
              "EXO.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuye: Yehla, ubuye ukhwele uze kimi kanye loAroni; kodwa abapristi labantu ungabavumeli ukuba bafohle beze eNkosini, funa ibadumele. ",
          "type": "text",
          "attrs": {
