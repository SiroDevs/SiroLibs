        },
        {
          "text": "Ngokunjalo lani bafazi, zehliseleni ngaphansi kwamadoda enu, ukuze kuthi, uba ekhona ongakholwayo ilizwi, azuzwe ngaphandle kokukhuluma ngenxa yokuhamba kwabafazi bawo,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.1",
            "verseOrgIds": [
              "1PE.3.1"
            ]
          }
        },
        {
