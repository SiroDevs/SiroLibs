              "type": "text"
            }
          ]
        },
        {
          "text": "Okokucina, wobani lanhliziyonye lonke, lizwelane, lithande abazalwane, libe lobubele lokuthobeka, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.8",
