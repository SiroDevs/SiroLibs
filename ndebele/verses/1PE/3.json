            "sid": "1PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokunjalo lani madoda, hlalani labomkenu ngokwazi, limhloniphe owesifazana njengomuntu obuthakathaka, lokhu beyizindlalifa zomusa wokuphila kanye lani, ukuze imikhuleko yenu ingavimbeleki.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        },
