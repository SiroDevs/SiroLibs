          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "lingaphindiseli okubi ngokubi lokuthuka ngokuthuka, kodwa ikakhulu busisani, ngoba labizelwa khona lokho ukuba lidle ilifa lokubusiswa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.9",
