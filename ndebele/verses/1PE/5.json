          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "NgoSilivanu, umzalwane othembekileyo ngokumazi kwami, ngililobele ngokufitshane, ngililaya, ngifakaza ukuthi lo yiwo umusa oqotho kaNkulunkulu; manini liqine kuwo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
        },
