          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibandla eliseBabiloni elikhethiweyo njengani liyalibingelela, loMarko indodana yami.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
