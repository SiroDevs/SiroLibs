            "sid": "2TI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yazi lokhu ukuthi ensukwini zokucina kuzakufika izikhathi ezinzima. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.1",
            "verseOrgIds": [
              "2TI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba abantu bazakuba ngabazithandayo, labathanda imali, labazigqajayo, labaziqakisayo, labathukayo, labangalaleli abazali babo, labangabongiyo, lababi, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.2",
            "verseOrgIds": [
              "2TI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "labangelathando, labanhliziyo zilukhuni, labahlebayo, labangazikhuziyo, labalolaka, labazonda okuhle, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.3",
            "verseOrgIds": [
              "2TI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "labanikela abanye, labalamawala, labagcwele ukuzikhukhumeza, labathanda ukuzithokozisa kulokuthanda uNkulunkulu, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.4",
            "verseOrgIds": [
              "2TI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "labalesimo sokukholwa kodwa amandla akho bewaphika. Baxwaye abanjalo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.5",
            "verseOrgIds": [
              "2TI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phakathi kwabo bakhona abanyenyela ezindlini bathumbe abesifazana ababuthakathaka, abasindwa yizono bebuswa yizinkanuko eziyizinhlobonhlobo, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.6",
            "verseOrgIds": [
              "2TI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "bethanda ukufundiswa njalonjalo, kodwa bengeke bafinyelele ekulazini iqiniso. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.7",
            "verseOrgIds": [
              "2TI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengoba uJane loJambere bamelana loMose, ngokunjalo lalaba bamelana leqiniso, bengabantu abalengqondo eyonakeleyo, abehluleka ukukholwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.8",
            "verseOrgIds": [
              "2TI.3.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.11"
              },
              "items": [
                {
                  "text": "Eks 7:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.8",
            "verseOrgIds": [
              "2TI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kabayikufika ngaphi, ubuthutha babo buzakuba sobala kibo bonke, njengoba kwaba njalo lakulabo ababili.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
            "verseOrgIds": [
              "2TI.3.9"
            ]
          }
        }
      ]
    },
    {
