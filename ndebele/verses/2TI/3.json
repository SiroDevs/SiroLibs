        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.11",
            "verseOrgIds": [
              "2TI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yebo, bonke abathanda ukuhamba ngobuqotho kuKristu Jesu bazazingelwa; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.12",
            "verseOrgIds": [
              "2TI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa abantu ababi labakhohlisi bazakuqhubekela phambili ebubini, bekhohlisana. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.13",
            "verseOrgIds": [
              "2TI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa wena mana kulokho okufundileyo lowaqiniseka kukho, wazi ukuthi ukufunde kubani, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.14",
            "verseOrgIds": [
              "2TI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "lokuthi kusukela ebuntwaneni wayazi imibhalo engcwele elamandla okukufundisela ukusiliswa ngokukholwa kuKristu Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.15",
            "verseOrgIds": [
              "2TI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonke imibhalo yafunzelelwa nguMoya kaNkulunkulu, ilungele ukufundisa lokukhalimela lokuqondisa, lokufundisela ukulunga, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.16",
            "verseOrgIds": [
              "2TI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze umuntu kaNkulunkulu aphelele, alungiselwe yonke imisebenzi emihle.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.17",
            "verseOrgIds": [
              "2TI.3.17"
            ]
          }
        }
