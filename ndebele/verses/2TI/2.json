  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "2TI 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke, wena mntanami, qina emuseni okuKristu Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.1",
            "verseOrgIds": [
              "2TI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokho okuzwileyo kimi phambi kwabofakazi abanengi kunikele amadoda athembekileyo azakuba lamandla okukufundisa labanye. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.2",
            "verseOrgIds": [
              "2TI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hlanganyela lami ukuhlupheka njengebutho elihle likaJesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.3",
            "verseOrgIds": [
              "2TI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakho owebutho osempini olibala ngezinto zabangabuthwanga, ukuba amkholise lowo ombuthileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.4",
            "verseOrgIds": [
              "2TI.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi nxa umuntu encintisana labanye, kanikwa umqhele uba engancintisananga ngokomthetho. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.5",
            "verseOrgIds": [
              "2TI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungumlimi osebenza kakhulu ofanele ukuba amukele izithelo kuqala. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.6",
            "verseOrgIds": [
              "2TI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakana ngengikutshoyo, ngoba iNkosi izakukunika ukuqedisisa ngezinto zonke. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.7",
            "verseOrgIds": [
              "2TI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khumbula uJesu Kristu ovukileyo kwabafileyo, owenzalo kaDavida ngokwevangeli lami, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.8",
            "verseOrgIds": [
              "2TI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivangeli engihlupheka ngenxa yalo ngibotshwa njengesigebengu; kanti ilizwi likaNkulunkulu kalibotshwanga. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.9",
            "verseOrgIds": [
              "2TI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke ngikhuthazelele konke ngenxa yabakhethiweyo, ukuze labo bazuze ukusiliswa kuKristu Jesu kanye lobukhosi obungapheliyo.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.10",
            "verseOrgIds": [
              "2TI.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.13",
            "verseOrgIds": [
              "2TI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubakhumbuze ngalokho, ubalaye phambi kukaNkulunkulu ukuba baxwaye ukuphikisana ngamazwi; kakusizi lutho, kodwa kuchitha abezwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.14",
            "verseOrgIds": [
              "2TI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khuthalela ukuba uziveze kuNkulunkulu uthembekile, uyisisebenzi esingelanhloni esiphatha kuhle ilizwi leqiniso. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.15",
            "verseOrgIds": [
              "2TI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xwaya ukukhuluma okomhlaba okuyize, ngoba abakwenzayo bazakuholelwa phambili ebubini, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.16",
            "verseOrgIds": [
              "2TI.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "lelizwi labo lizakuhlihla njengesilonda esibhibhidlayo. Phakathi kwabo ngoHimenewo loFileto ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.17",
            "verseOrgIds": [
              "2TI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaduhileyo eqinisweni, besithi ukuvuka kwabafileyo sekudlule, bechitha ukukholwa kwabanye. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.18",
            "verseOrgIds": [
              "2TI.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2TI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa isisekelo esiqinileyo sikaNkulunkulu simi silaloluphawu lokuthi: INkosi iyabazi abangabayo; lokuthi: Ilowo lalowo ophatha ibizo leNkosi kahlukane lokungalungi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.19",
            "verseOrgIds": [
              "2TI.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2TI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endlini enkulu kakukho izitsha zegolide lezesiliva kuphela, kodwa kukhona lezesihlahla lezebumba, ezinye zilomsebenzi omkhulu, ezinye zilomsebenzi omncinyane. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.20",
            "verseOrgIds": [
              "2TI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2TI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntu ezihlambulula ezintweni ezimbi, uzakuba yisitsha esilomsebenzi omkhulu, esenziwe saba ngcwele, esilosizo kumninindlu, esilungiselwe umsebenzi wonke omuhle. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.21",
            "verseOrgIds": [
              "2TI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2TI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho xwaya inkanuko zobutsha, ulandele ukulunga, lokukholwa, lothando, lokuthula kanye labo abakhuleka eNkosini ngenhliziyo emhlophe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.22",
            "verseOrgIds": [
              "2TI.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2TI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuphikisana okulobuthutha lokungazi kuxwaye, wazi ukuthi kubanga ukulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.23",
            "verseOrgIds": [
              "2TI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2TI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inceku yeNkosi kayifanele ukulwa, kodwa kayibe mnene kibo bonke, ibe lelisu lokufundisa, ibekezele, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.24",
            "verseOrgIds": [
              "2TI.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2TI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibaluleke ngomoya omnene abamelana layo. Kumbe uNkulunkulu angabanika ukuphenduka, baze balazi iqiniso, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.25",
            "verseOrgIds": [
              "2TI.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2TI 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "baphaphame baphunyuke emjibileni kaSathane ababanjwe nguye ukuba benze intando yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.26",
            "verseOrgIds": [
              "2TI.2.26"
            ]
          }
        }
      ]
    }
  ],
