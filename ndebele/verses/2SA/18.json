              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekufika umEtiyopiya wathi: Kuzindaba ezinhle, nkosi yami! INkosi uNkulunkulu ikuphindisele lamuhla kubo bonke abakuvukelayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
