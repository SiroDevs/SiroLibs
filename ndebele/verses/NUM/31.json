          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose loEleyazare umpristi bamukela igolide lelo, zonke izinto eziligugu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.51",
            "verseOrgIds": [
              "NUM.31.51"
            ]
