          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obabhemi babezinkulungwane ezingamatshumi amathathu, lamakhulu amahlanu; isabelo seNkosi kubo sasingamatshumi ayisithupha lanye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
