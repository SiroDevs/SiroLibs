              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu babezinkulungwane ezilitshumi lesithupha; isabelo seNkosi kubo sasingamatshumi amathathu lambili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.40",
