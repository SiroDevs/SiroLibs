          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkomo zazizinkulungwane ezingamatshumi amathathu lesithupha; isabelo seNkosi kuzo sasingamatshumi ayisikhombisa lambili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.38",
