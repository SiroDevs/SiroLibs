          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lonke igolide lalokho okwanikelwa eNkosini yizinduna zezinkulungwane lezinduna zamakhulu ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.52",
            "verseOrgIds": [
              "NUM.31.52"
            ]
          }
        },
        {
          "text": " azinkulungwane ezilitshumi lesithupha, lamakhulu ayisikhombisa, lamatshumi amahlanu. ",
          "type": "text",
          "attrs": {
