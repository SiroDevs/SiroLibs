        },
        {
          "text": "Izinduna ezaziphethe amabutho empi, izinduna zezinkulungwane lezinduna zamakhulu, zasezisondela kuMose, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.48",
