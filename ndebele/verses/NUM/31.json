          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "isabelo seNkosi sezimvu sasingamakhulu ayisithupha, lamatshumi ayisikhombisa lanhlanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.37",
            "verseOrgIds": [
