              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "labantu abazinkulungwane ezingamatshumi amathathu lambili, ngitsho abesifazana abangalalanga lamadoda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.35",
