              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "zathi kuye: Thina zinceku zakho sesibalile amabutho esiwaphathayo; kakulamuntu ongekho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.49",
