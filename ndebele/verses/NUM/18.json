        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.25",
            "verseOrgIds": [
              "NUM.18.25"
            ]
          }
        },
        {
