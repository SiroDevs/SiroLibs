          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.9",
            "verseOrgIds": [
              "NUM.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodakazi kaZelofehadi enza njengokutsho kweNkosi kuMose; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.10",
            "verseOrgIds": [
              "NUM.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba amadodakazi kaZelofehadi, oMahla loTiriza loHogila loMilka loNowa endela emadodaneni abafowabo bakayise. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.11",
            "verseOrgIds": [
              "NUM.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endela kwabosendo lwamadodana kaManase indodana kaJosefa, ilifa lawo lahlala esizweni sikayise.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.12",
            "verseOrgIds": [
              "NUM.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.12",
            "verseOrgIds": [
              "NUM.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yiyo leyomilayo lezimiso iNkosi eyalaya abantu bakoIsrayeli ngazo ngoMose emagcekeni aseMowabi ngaseJordani eduze leJeriko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.13",
            "verseOrgIds": [
              "NUM.36.13"
            ]
          }
        }
      ]
    }
