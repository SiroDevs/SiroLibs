              "NUM.22.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusisa uBalaki wamthatha uBalami, wamkhwelisa endaweni ephakemeyo yokukhonzela ethiwa iBamothi‐Bali, wabona lapho ingxenye yezihonqo zabakoIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.41",
            "verseOrgIds": [
              "NUM.22.41"
            ]
          }
        }
      ]
