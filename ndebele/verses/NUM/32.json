  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "NUM 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoRubeni labakoGadi babelezinkomo ezinenginengi. Babona ukuthi amazwe aseJazeri lelizwe laseGileyadi ayezindawo zokwalusela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.1",
            "verseOrgIds": [
              "NUM.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho abakoRubeni labakoGadi beza bakhuluma loMose loEleyazare umpristi lezikhulu zebandla, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.2",
            "verseOrgIds": [
              "NUM.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bathi: IAtarothi leDiboni leJazeri leNimra leHeshiboni leEleyale leSebamu leNebo leBeyoni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.3",
            "verseOrgIds": [
              "NUM.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilizwe iNkosi eyalinqoba phambi kwebandla lakoIsrayeli, liyilizwe lokwalusela; futhi thina zinceku zenu sifuyile. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.4",
            "verseOrgIds": [
              "NUM.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba sifumene umusa emehlweni enu, ilizwe leli kaliphiwe thina zinceku zenu libe ngelethu; lingasiwezi iJordani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.5",
            "verseOrgIds": [
              "NUM.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.5",
            "verseOrgIds": [
              "NUM.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uMose wathi kubo abakoGadi labakoRubeni: Abakini bazakuphuma impi, lisale lapha lina na? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.6",
            "verseOrgIds": [
              "NUM.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lizadaniselani inhliziyo zabakoIsrayeli ukuba bangaweli ukuya elizweni iNkosi ebanike lona na? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.7",
            "verseOrgIds": [
              "NUM.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yikho lokho abakwenzayo oyihlo mhla ngibathuma besuka eKadeshi‐Barneya ukuyabona ilizwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.8",
            "verseOrgIds": [
              "NUM.32.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.17+NUM.13.18+NUM.13.19+NUM.13.20+NUM.13.21+NUM.13.22+NUM.13.23+NUM.13.24+NUM.13.25+NUM.13.26+NUM.13.27+NUM.13.28+NUM.13.29+NUM.13.30+NUM.13.31+NUM.13.32+NUM.13.33"
              },
              "items": [
                {
                  "text": "Nani 13:17–33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.8",
            "verseOrgIds": [
              "NUM.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ekuhambeni kwabo ukuya esihotsheni saseEshikoli, babona ilizwe, basebedanisa inhliziyo zabakoIsrayeli ukuze bangangeni elizweni iNkosi eyayibanike lona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.9",
            "verseOrgIds": [
              "NUM.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolusuku iNkosi yathukuthela, yafunga yathi:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.10",
            "verseOrgIds": [
              "NUM.32.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.26+NUM.14.27+NUM.14.28+NUM.14.29+NUM.14.30+NUM.14.31+NUM.14.32+NUM.14.33+NUM.14.34+NUM.14.35"
              },
              "items": [
                {
                  "text": "Nani 14:26–35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.10",
            "verseOrgIds": [
              "NUM.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impela kulabo abaphuma eGibithe abaleminyaka engamatshumi amabili lengaphezulu kakuyikuba loyedwa ozakubona ilizwe engafunga ukulinika uAbrahama loIsaka loJakobe, ngoba kabangilandelanga ngokupheleleyo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.11",
            "verseOrgIds": [
              "NUM.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kakuyikuba loyedwa ngaphandle kukaKalebi indodana kaJefune umKenizi, loJoshuwa indodana kaNuni, ngoba balandele iNkosi ngokupheleleyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.12",
            "verseOrgIds": [
              "NUM.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intukuthelo yeNkosi yabavuthela abakoIsrayeli, yabazulisa enkangala iminyaka engamatshumi amane, kwaze kwaphela lesosizukulwana sonke esasenzile okubi emehlweni eNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.13",
            "verseOrgIds": [
              "NUM.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khangelani, selilingisa oyihlo, ngoba liyinzalo yabantu abonayo, liyavusa futhi intukuthelo yeNkosi evuthela uIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.14",
            "verseOrgIds": [
              "NUM.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uba lisala ukuyilandela, izakuphinda ibatshiye enkangala; lizabalethela ukubhujiswa bonke lababantu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.15",
            "verseOrgIds": [
              "NUM.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.15",
            "verseOrgIds": [
              "NUM.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebesondela kuye bathi: Sizakwakhela lapha izimvu zethu izibaya labantwana bethu imizi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.16",
            "verseOrgIds": [
              "NUM.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa thina sizakuhloma ukuba sihole abakoIsrayeli, size sibafikise endaweni yabo, abantwana bethu bangahlala emizini ebiyelweyo bevikelekile ebantwini belizwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.17",
            "verseOrgIds": [
              "NUM.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasiyikubuyela emizini yethu, omunye lomunye wabakoIsrayeli engakazuzi ilizwe libe yilifa lakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.18",
            "verseOrgIds": [
              "NUM.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba kasiyikwamukela kubo ilizwe ngaphetsheya kweJordani langaphambili, ngoba sesiphiwe elethu nganeno kweJordani ngasempumalanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.19",
            "verseOrgIds": [
              "NUM.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wasesithi kubo: Uba lisenza njengokutsho kwenu lihlome, liphume impi lilwe phambi kweNkosi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.20",
            "verseOrgIds": [
              "NUM.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "beselichapha iJordani lina lonke elihlomileyo phambi kweNkosi lihlale khona, ize ixotshe zonke izitha zayo phambi kwayo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.21",
            "verseOrgIds": [
              "NUM.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "lelizwe linqotshwe phambi kwayo, ng’khona emva kwalokho lizakubuya, lingabi lamlandu eNkosini lakuIsrayeli; lelilizwe lizakuba yilifa lenu phambi kweNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.22",
            "verseOrgIds": [
              "NUM.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwake uba lingenzi njalo, lizabe lonile eNkosini; yazini ukuthi isono senu sizakuba phezu kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.23",
            "verseOrgIds": [
              "NUM.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakhelani abantwana benu imizi lezimvu zenu izibaya, kodwa yenzani lokho elikuthembisileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.24",
            "verseOrgIds": [
              "NUM.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoGadi labakoRubeni bathi kuMose: Thina zinceku zakho sizakwenza njengokutsho kwakho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.25",
            "verseOrgIds": [
              "NUM.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bethu, labomkenu, lezimvu zethu, lazo zonke inkomo zethu kuzakusala emizini yaseGileyadi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.26",
            "verseOrgIds": [
              "NUM.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa thina zinceku zakho sizakuchapha phambi kweNkosi, thina sonke sizahloma silwe, njengokulaya kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.27",
            "verseOrgIds": [
              "NUM.32.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.27",
            "verseOrgIds": [
              "NUM.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose waselayezela ngabo uEleyazare umpristi, loJoshuwa indodana kaNuni, lezinhloko zezindlu zezizwe zabakoIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.28",
            "verseOrgIds": [
              "NUM.32.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.12+JOS.1.13+JOS.1.14+JOS.1.15"
              },
              "items": [
                {
                  "text": "Josh 1:12–15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.28",
            "verseOrgIds": [
              "NUM.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wathi kubo: Uba abakoGadi labakoRubeni, bonke abahlomileyo phambi kweNkosi, bechapha lani iJordani, lelizwe linqotshwe yini, lizakubanika ilizwe laseGileyadi libe ngelabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.29",
            "verseOrgIds": [
              "NUM.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba bengahlomi bachaphe lami, bazakunikwa ilizwe phakathi kwenu elizweni laseKanani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.30",
            "verseOrgIds": [
              "NUM.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoGadi labakoRubeni baphendula bathi: Njengalokhu iNkosi itshilo kithi izinceku zakho, sizakwenza njalo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.31",
            "verseOrgIds": [
              "NUM.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "sizahloma sichaphe phambi kweNkosi, singene elizweni laseKanani; sizakuba lelizwe lethu ngapha ngaphetsheya kweJordani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.32",
            "verseOrgIds": [
              "NUM.32.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.32",
            "verseOrgIds": [
              "NUM.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wasenika abakoGadi labakoRubeni lengxenye yesizwe sakoManase, indodana kaJosefa, umbuso kaSihoni inkosi yamaAmori, lombuso kaOgi inkosi yaseBashani, lelizwe lonke kanye lemizi ephakathi kwalo inxa zonke. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.33",
            "verseOrgIds": [
              "NUM.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoGadi bakha iDiboni leAtarothi leAroweri ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.34",
            "verseOrgIds": [
              "NUM.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "leAtirothi‐Shofani leJazeri leJogibeha, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.35",
            "verseOrgIds": [
              "NUM.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "leBeti‐Nimra leBeti‐Harani, imizi ebiyelweyo, lezibaya zezimvu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.36",
            "verseOrgIds": [
              "NUM.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoRubeni bakha iHeshiboni leElayale leKiriyathayimi ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.37",
            "verseOrgIds": [
              "NUM.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "leNebo leBali‐Meyoni — sekuphendulwe amabizo ayo — leSibima; bayibiza imizi abayakhayo ngamanye amabizo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.38",
            "verseOrgIds": [
              "NUM.32.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaMakiri indodana kaManase, ahlasela iGileyadi, alinqoba, achitha amaAmori ayekulo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.39",
            "verseOrgIds": [
              "NUM.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wanika uMakiri indodana kaManase iGileyadi, wakha kilo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.40",
            "verseOrgIds": [
              "NUM.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJayiri indodana kaManase wayahlasela imizi elitshumi, wayithumba, wayibiza ngokuthi yiHavothi‐Jayiri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
            "verseOrgIds": [
              "NUM.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNoba wayahlasela iKenathi, walithumba lemizana yalo, walibiza ngokuthi yiNoba ngebizo lakhe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.42",
            "verseOrgIds": [
              "NUM.32.42"
            ]
          }
        }
      ]
    }
