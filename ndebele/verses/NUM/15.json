              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.26",
            "verseOrgIds": [
              "NUM.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntu oyedwa esona engoni ngabomu, uzanikela ngesibhuzikazi esilomnyaka munye, sibe ngumnikelo wesono.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.27",
            "verseOrgIds": [
              "NUM.15.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
