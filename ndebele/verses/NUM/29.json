          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "linikele njalo lempongo eyodwa ibe ngumnikelo wesono, ukuze kwenzelwe lina indlela yokubuyisana; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.5",
            "verseOrgIds": [
              "NUM.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
