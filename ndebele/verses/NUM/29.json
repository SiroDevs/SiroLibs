            }
          ]
        },
        {
          "text": "Ngosuku lokuqala lwenyanga yesikhombisa lizakuba lenkonzo enkulu; lingenzi umsebenzi ngalo. Kuzakuba lusuku lokutshaya impondo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.1",
            "verseOrgIds": [
              "NUM.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lizanikela umnikelo wokutshiswa, iphunga elimnandi eNkosini, inkunzi eyodwa, lenqama eyodwa, lamawundlu amaduna ayisikhombisa alomnyaka munye, angelasici. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.2",
            "verseOrgIds": [
              "NUM.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umnikelo oqondene lalokho owempuphu ecolekileyo ixubene lamafutha uzakuba yingxenye ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "text": " ngenkunzi, lengxenye ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "text": " ngenqama, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
