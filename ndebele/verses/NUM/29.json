          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanye lomnikelo wokutshiswa wenyanga ethwasayo lomnikelo wawo wempuphu, lomnikelo wokutshiswa wensuku ngensuku lomnikelo wawo wempuphu, leminikelo yayo yokuthululwa ngokwesimiso sayo, kube liphunga elimnandi, lomnikelo owenzelwe iNkosi ngomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        }
