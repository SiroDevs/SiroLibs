          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.22",
            "verseOrgIds": [
              "NUM.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshono kuAroni lamadodana akhe uthi: Lizakubusisa kanje abantu bakoIsrayeli. Lithi kubo:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.23",
            "verseOrgIds": [
              "NUM.6.23"
            ]
          }
        }
      ]
