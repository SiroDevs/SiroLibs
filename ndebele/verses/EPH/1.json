                "loc": "ACT.18.19+ACT.18.20+ACT.18.21"
              },
              "items": [
                {
                  "text": "Seb 18:19–21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.1"
              },
              "items": [
                {
                  "text": "19:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.1",
            "verseOrgIds": [
              "EPH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakube kini umusa lokuthula okuvela kuNkulunkulu uBaba laseNkosini uJesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.2",
            "verseOrgIds": [
              "EPH.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.2",
            "verseOrgIds": [
              "EPH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabongwe uNkulunkulu, uYise weNkosi yethu uJesu Kristu osibusisileyo kuKristu ngesibusiso sonke sokomoya ezulwini. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.3",
            "verseOrgIds": [
              "EPH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasikhetha ngoKristu ngaphambi kokudatshulwa komhlaba ukuba sibe ngcwele, singasoleki phambi kwakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.4",
            "verseOrgIds": [
              "EPH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasimisela ngothando ukuba sibe ngabantwana bakhe ngoJesu Kristu, ngokwecebo lentando yakhe, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.5",
            "verseOrgIds": [
              "EPH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze adunyiswe ngomusa wakhe omangalisayo asiphe wona ngesihle ngaye oThandiweyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.6",
            "verseOrgIds": [
              "EPH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaye silokuhlengwa ngegazi lakhe, lokuthethelelwa kweziphambeko zethu ngokwenotho yomusa wakhe",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.7",
            "verseOrgIds": [
              "EPH.1.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.14"
              },
              "items": [
                {
                  "text": "Kol 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.7",
            "verseOrgIds": [
              "EPH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "awandise kithi kukho konke ukuhlakanipha lokuqonda. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.8",
            "verseOrgIds": [
              "EPH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usazisile imfihlakalo yentando yakhe ngokwecebo lakhe alimisa ngaphambili kuKristu, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.9",
            "verseOrgIds": [
              "EPH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze aphumelelise nxa isikhathi sesiphelele ukuhlanganisela ndawonye izinto zonke ezisezulwini lezisemhlabeni kuKristu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.10",
            "verseOrgIds": [
              "EPH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "KuKristu thina sabelwa ilifa, esamiselwa lona ngaphambili ngokwecebo lakhe osebenzayo ezintweni zonke ngokwentando yakhe, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.11",
            "verseOrgIds": [
              "EPH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuba thina, esakholwa kuKristu kuqala, siphilele udumo lobukhosi bakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.12",
            "verseOrgIds": [
              "EPH.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lani, eselizwile ilizwi leqiniso elilivangeli lokusiliswa kwenu lakholwa kuye, libekwe uphawu loMoya oNgcwele othenjisiweyo ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.13",
            "verseOrgIds": [
              "EPH.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyisibambiso selifa lethu, size samukeliswe lona, lapho uNkulunkulu esehlengile abantu bakhe, kube ludumo lwakhe lobukhosi bakhe.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.14",
            "verseOrgIds": [
              "EPH.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
