                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Hubo 110:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.20",
            "verseOrgIds": [
              "EPH.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngaphezu kwakho konke ukubusa, lobukhulu, lamandla, lobukhosi, laphezu kwamabizo wonke aphathwayo, kungesikho kulesisikhathi kuphela kodwa lesikhathini esizayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.21",
            "verseOrgIds": [
              "EPH.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabeka konke ngaphansi kwenyawo zakhe, wamenza waba yinhloko yakho konke kulo ibandla,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.22",
            "verseOrgIds": [
              "EPH.1.22"
            ]
          }
        },
        {
