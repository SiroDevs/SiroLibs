              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.14",
            "verseOrgIds": [
              "EPH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenxa yalokho lami, esengizwile ngokukholwa kwenu eNkosini uJesu lothando lwenu kubo bonke abangcwele, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.15",
            "verseOrgIds": [
              "EPH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kangiyekeli ukulibongela, ngilikhumbula emikhulekweni yami, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.16",
            "verseOrgIds": [
              "EPH.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze uNkulunkulu weNkosi yethu uJesu Kristu, uYise olobukhosi, alinike umoya wokuhlakanipha lokwambulwa ekumazini yena. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.17",
            "verseOrgIds": [
              "EPH.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungathi kungavulwa amehlo enhliziyo zenu, ukuze lazi ithemba elibizelwa kulo, lenotho enkulu yelifa alinika lona kubo abangcwele, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.18",
            "verseOrgIds": [
              "EPH.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "lobukhulu obumangalisayo bamandla akhe kithi esikholwayo. Lokhu kuyikusebenza kwamandla akhe amakhulu ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.19",
            "verseOrgIds": [
              "EPH.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "awasebenzisa kuKristu ngokumvusa kwabafileyo, lapho emhlalisa ngakwesokunene sakhe ezulwini,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.20",
            "verseOrgIds": [
              "EPH.1.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
