                "loc": "COL.3.9"
              },
              "items": [
                {
                  "text": "Kol 3:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.22",
            "verseOrgIds": [
              "EPH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "lenziwe libe batsha emoyeni wengqondo zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.23",
            "verseOrgIds": [
              "EPH.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lambathe isimo esitsha esifuze uNkulunkulu esibonakala ekulungeni lasebungcweleni beqiniso.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.24",
            "verseOrgIds": [
              "EPH.4.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
