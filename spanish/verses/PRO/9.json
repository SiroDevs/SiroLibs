{
  "id": "PRO.9",
  "number": "9",
  "bookId": "PRO",
  "reference": "Proverbios 9",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "PRO 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "LA sabiduría",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.1",
            "verseOrgIds": [
              "PRO.9.1"
            ]
          }
        },
        {
          "text": "edificó su casa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.1",
            "verseOrgIds": [
              "PRO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:1"
      },
      "items": [
        {
          "text": "Labró sus siete columnas;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.1",
            "verseOrgIds": [
              "PRO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mató sus víctimas, templó su vino,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.2",
            "verseOrgIds": [
              "PRO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:2"
      },
      "items": [
        {
          "text": "Y puso su mesa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.2",
            "verseOrgIds": [
              "PRO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Envió sus criadas;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.3",
            "verseOrgIds": [
              "PRO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:3"
      },
      "items": [
        {
          "text": "Sobre lo más alto de la ciudad clamó:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.3",
            "verseOrgIds": [
              "PRO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cualquiera simple, venga acá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.4",
            "verseOrgIds": [
              "PRO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:4"
      },
      "items": [
        {
          "text": "A los faltos de cordura dijo:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.4",
            "verseOrgIds": [
              "PRO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Venid, comed mi pan,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.5",
            "verseOrgIds": [
              "PRO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:5"
      },
      "items": [
        {
          "text": "Y bebed del vino que yo he templado.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.5",
            "verseOrgIds": [
              "PRO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dejad las simplezas, y vivid;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.6",
            "verseOrgIds": [
              "PRO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:6"
      },
      "items": [
        {
          "text": "Y andad por el camino de la inteligencia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.6",
            "verseOrgIds": [
              "PRO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que corrige al escarnecedor, afrenta se acarrea:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.7",
            "verseOrgIds": [
              "PRO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:7"
      },
      "items": [
        {
          "text": "El que reprende al impío, se",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.7",
            "verseOrgIds": [
              "PRO.9.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "atrae",
              "type": "text",
              "attrs": {
                "verseId": "PRO.9.7",
                "verseOrgIds": [
                  "PRO.9.7"
                ]
              }
            }
          ]
        },
        {
          "text": "mancha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.7",
            "verseOrgIds": [
              "PRO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "No reprendas al escarnecedor, porque no te aborrezca:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.8",
            "verseOrgIds": [
              "PRO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:8"
      },
      "items": [
        {
          "text": "Corrige al sabio, y te amará.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.8",
            "verseOrgIds": [
              "PRO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da al sabio, y será más sabio:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.9",
            "verseOrgIds": [
              "PRO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:9"
      },
      "items": [
        {
          "text": "Enseña al justo, y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.9",
            "verseOrgIds": [
              "PRO.9.9"
            ]
          }
        },
        {
          "text": "acrecerá su saber.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.9",
            "verseOrgIds": [
              "PRO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Proverbios sobre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 diversos asuntos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "El temor de Jehová es el principio de la sabiduría;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.10",
            "verseOrgIds": [
              "PRO.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:10"
      },
      "items": [
        {
          "text": "Y la ciencia de los santos es inteligencia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.10",
            "verseOrgIds": [
              "PRO.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.11",
            "verseOrgIds": [
              "PRO.9.11"
            ]
          }
        },
        {
          "text": "por mí se aumentarán tus días,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.11",
            "verseOrgIds": [
              "PRO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:11"
      },
      "items": [
        {
          "text": "Y años de vida se te añadirán.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.11",
            "verseOrgIds": [
              "PRO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si fueres sabio, para ti lo serás:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.12",
            "verseOrgIds": [
              "PRO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:12"
      },
      "items": [
        {
          "text": "Mas si fueres escarnecedor,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.12",
            "verseOrgIds": [
              "PRO.9.12"
            ]
          }
        },
        {
          "text": "pagarás tú solo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.12",
            "verseOrgIds": [
              "PRO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "La mujer loca es alborotadora;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.13",
            "verseOrgIds": [
              "PRO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Es",
              "type": "text",
              "attrs": {
                "verseId": "PRO.9.13",
                "verseOrgIds": [
                  "PRO.9.13"
                ]
              }
            }
          ]
        },
        {
          "text": "simple é ignorante.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.13",
            "verseOrgIds": [
              "PRO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siéntase en una silla á la puerta de su casa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.14",
            "verseOrgIds": [
              "PRO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:14"
      },
      "items": [
        {
          "text": "En lo alto de la ciudad,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.14",
            "verseOrgIds": [
              "PRO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para llamar á los que pasan por el camino,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.15",
            "verseOrgIds": [
              "PRO.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:15"
      },
      "items": [
        {
          "text": "Que van por sus caminos derechos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.15",
            "verseOrgIds": [
              "PRO.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cualquiera simple,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.16",
            "verseOrgIds": [
              "PRO.9.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "dice,",
              "type": "text",
              "attrs": {
                "verseId": "PRO.9.16",
                "verseOrgIds": [
                  "PRO.9.16"
                ]
              }
            }
          ]
        },
        {
          "text": "venga acá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.16",
            "verseOrgIds": [
              "PRO.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:16"
      },
      "items": [
        {
          "text": "A los faltos de cordura dijo:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.16",
            "verseOrgIds": [
              "PRO.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las aguas hurtadas son dulces,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.17",
            "verseOrgIds": [
              "PRO.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 9:17"
      },
      "items": [
        {
          "text": "Y el pan",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.17",
            "verseOrgIds": [
              "PRO.9.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "comido",
              "type": "text",
              "attrs": {
                "verseId": "PRO.9.17",
