{
  "id": "PRO.16",
  "number": "16",
  "bookId": "PRO",
  "reference": "Proverbios 16",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "PRO 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "DEL hombre son las disposiciones del corazón:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.1",
            "verseOrgIds": [
              "PRO.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:1"
      },
      "items": [
        {
          "text": "Mas de Jehová la respuesta de la lengua.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.1",
            "verseOrgIds": [
              "PRO.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Proverbios sobre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 diversos asuntos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todos los caminos del hombre son limpios en su opinión:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.2",
            "verseOrgIds": [
              "PRO.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:2"
      },
      "items": [
        {
          "text": "Mas Jehová pesa los espíritus.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.2",
            "verseOrgIds": [
              "PRO.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Encomienda á Jehová tus obras,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.3",
            "verseOrgIds": [
              "PRO.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:3"
      },
      "items": [
        {
          "text": "Y tus pensamientos serán afirmados.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.3",
            "verseOrgIds": [
              "PRO.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todas las cosas ha hecho Jehová por sí mismo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.4",
            "verseOrgIds": [
              "PRO.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:4"
      },
      "items": [
        {
          "text": "Y aun",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.4",
            "verseOrgIds": [
              "PRO.16.4"
            ]
          }
        },
        {
          "text": "al impío para el día malo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.4",
            "verseOrgIds": [
              "PRO.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abominación es á Jehová todo altivo de corazón:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.5",
            "verseOrgIds": [
              "PRO.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Aunque esté",
              "type": "text",
              "attrs": {
                "verseId": "PRO.16.5",
                "verseOrgIds": [
                  "PRO.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "mano sobre mano, no será reputado inocente.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.5",
            "verseOrgIds": [
              "PRO.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con misericordia y verdad se corrige el pecado:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.6",
            "verseOrgIds": [
              "PRO.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:6"
      },
      "items": [
        {
          "text": "Y con el temor de Jehová se apartan del mal los hombres.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.6",
            "verseOrgIds": [
              "PRO.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando los caminos del hombre son agradables á Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.7",
            "verseOrgIds": [
              "PRO.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:7"
      },
      "items": [
        {
          "text": "Aun á sus enemigos pacificará con él.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.7",
            "verseOrgIds": [
              "PRO.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mejor es lo poco con justicia,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.8",
            "verseOrgIds": [
              "PRO.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:8"
      },
      "items": [
        {
          "text": "Que la muchedumbre de frutos sin derecho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.8",
            "verseOrgIds": [
              "PRO.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "El corazón del hombre piensa su camino:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.9",
            "verseOrgIds": [
              "PRO.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:9"
      },
      "items": [
        {
          "text": "Mas Jehová endereza sus pasos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.9",
            "verseOrgIds": [
              "PRO.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adivinación está en los labios del rey:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.10",
            "verseOrgIds": [
              "PRO.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:10"
      },
      "items": [
        {
          "text": "En juicio no prevaricará su boca.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.10",
            "verseOrgIds": [
              "PRO.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peso y balanzas justas son de Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.11",
            "verseOrgIds": [
              "PRO.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:11"
      },
      "items": [
        {
          "text": "Obra suya son todas las pesas de la bolsa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.11",
            "verseOrgIds": [
              "PRO.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abominación es á los reyes hacer impiedad:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.12",
            "verseOrgIds": [
              "PRO.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:12"
      },
      "items": [
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.12",
            "verseOrgIds": [
              "PRO.16.12"
            ]
          }
        },
        {
          "text": "con justicia será afirmado el trono.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.12",
            "verseOrgIds": [
              "PRO.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los labios justos son el contentamiento de los reyes;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.13",
            "verseOrgIds": [
              "PRO.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:13"
      },
      "items": [
        {
          "text": "Y aman al que habla lo recto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.13",
            "verseOrgIds": [
              "PRO.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "La ira del rey es mensajero de muerte:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.14",
            "verseOrgIds": [
              "PRO.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:14"
      },
      "items": [
        {
          "text": "Mas el hombre sabio la evitará.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.14",
            "verseOrgIds": [
              "PRO.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "En la alegría del rostro del rey está la vida;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.15",
            "verseOrgIds": [
              "PRO.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:15"
      },
      "items": [
        {
          "text": "Y su benevolencia es como nube de lluvia tardía.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.15",
            "verseOrgIds": [
              "PRO.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mejor es adquirir sabiduría que oro preciado;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.16",
            "verseOrgIds": [
              "PRO.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:16"
      },
      "items": [
        {
          "text": "Y adquirir inteligencia vale más que la plata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.16",
            "verseOrgIds": [
              "PRO.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "El camino de los rectos es apartarse del mal:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.17",
            "verseOrgIds": [
              "PRO.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:17"
      },
      "items": [
        {
          "text": "Su alma guarda el que guarda su camino.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.17",
            "verseOrgIds": [
              "PRO.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antes del quebrantamiento",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.18",
            "verseOrgIds": [
              "PRO.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es",
              "type": "text",
              "attrs": {
                "verseId": "PRO.16.18",
                "verseOrgIds": [
                  "PRO.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "la soberbia;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.18",
            "verseOrgIds": [
              "PRO.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:18"
      },
      "items": [
        {
          "text": "Y antes de la caída la altivez de espíritu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.18",
            "verseOrgIds": [
              "PRO.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mejor es humillar el espíritu con los humildes,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.19",
            "verseOrgIds": [
              "PRO.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:19"
      },
      "items": [
        {
          "text": "Que partir despojos con los soberbios.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.19",
            "verseOrgIds": [
              "PRO.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "El entendido en la palabra, hallará el bien:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.20",
            "verseOrgIds": [
              "PRO.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:20"
      },
      "items": [
        {
          "text": "Y el que confía en Jehová, él es bienaventurado.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.20",
            "verseOrgIds": [
              "PRO.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "El sabio de corazón es llamado entendido:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.21",
            "verseOrgIds": [
              "PRO.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:21"
      },
      "items": [
        {
          "text": "Y la dulzura de labios aumentará la doctrina.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.21",
            "verseOrgIds": [
              "PRO.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manantial de vida es el entendimiento al que lo posee:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.22",
            "verseOrgIds": [
              "PRO.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:22"
      },
      "items": [
        {
          "text": "Mas la erudición de los necios es necedad.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.22",
            "verseOrgIds": [
              "PRO.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "El corazón del sabio hace prudente su boca;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.23",
            "verseOrgIds": [
              "PRO.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:23"
      },
      "items": [
        {
          "text": "Y con sus labios aumenta la doctrina.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.23",
            "verseOrgIds": [
              "PRO.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panal de miel son los dichos suaves.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.24",
            "verseOrgIds": [
              "PRO.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:24"
      },
      "items": [
        {
          "text": "Suavidad al alma y medicina á los huesos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.24",
            "verseOrgIds": [
              "PRO.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hay camino que parece derecho al hombre,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.25",
            "verseOrgIds": [
              "PRO.16.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:25"
      },
      "items": [
        {
          "text": "Mas su salida son caminos de muerte.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.25",
            "verseOrgIds": [
              "PRO.16.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "El alma del que trabaja, trabaja para sí;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.26",
            "verseOrgIds": [
              "PRO.16.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:26"
      },
      "items": [
        {
          "text": "Porque su boca le constriñe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.26",
            "verseOrgIds": [
              "PRO.16.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hombre perverso cava el mal;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.27",
            "verseOrgIds": [
              "PRO.16.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:27"
      },
      "items": [
        {
          "text": "Y en sus labios hay como",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.27",
            "verseOrgIds": [
              "PRO.16.27"
            ]
          }
        },
        {
          "text": "llama de fuego.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.27",
            "verseOrgIds": [
              "PRO.16.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hombre perverso levanta contienda;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.28",
            "verseOrgIds": [
              "PRO.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:28"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.28",
            "verseOrgIds": [
              "PRO.16.28"
            ]
          }
        },
        {
          "text": "el chismoso",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.28",
            "verseOrgIds": [
              "PRO.16.28"
            ]
          }
        },
        {
          "text": "aparta los mejores amigos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.28",
            "verseOrgIds": [
              "PRO.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hombre malo lisonjea á su prójimo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.29",
            "verseOrgIds": [
              "PRO.16.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:29"
      },
      "items": [
        {
          "text": "Y le hace andar por el camino no bueno:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.29",
            "verseOrgIds": [
              "PRO.16.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cierra sus ojos para pensar perversidades;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.30",
            "verseOrgIds": [
              "PRO.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:30"
      },
      "items": [
        {
          "text": "Mueve sus labios, efectúa el mal.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.30",
            "verseOrgIds": [
              "PRO.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Proverbios sobre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 diversos asuntos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Corona de honra es la vejez,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.31",
            "verseOrgIds": [
              "PRO.16.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:31"
      },
      "items": [
        {
          "text": "Que se hallará en el camino de justicia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.31",
            "verseOrgIds": [
              "PRO.16.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mejor es el que tarde se aira que el fuerte;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.32",
            "verseOrgIds": [
              "PRO.16.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:32"
      },
      "items": [
        {
          "text": "Y el que se enseñorea de su espíritu, que el que toma una ciudad.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.32",
            "verseOrgIds": [
              "PRO.16.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "La suerte se echa en el seno:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.33",
            "verseOrgIds": [
              "PRO.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 16:33"
      },
      "items": [
        {
          "text": "Mas de Jehová es el juicio de ella.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.33",
            "verseOrgIds": [
              "PRO.16.33"
            ]
          }
        }
      ]
    }
