{
  "id": "PRO.24",
  "number": "24",
  "bookId": "PRO",
  "reference": "Proverbios 24",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "PRO 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "NO",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.1",
            "verseOrgIds": [
              "PRO.24.1"
            ]
          }
        },
        {
          "text": "tengas envidia de los hombres malos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.1",
            "verseOrgIds": [
              "PRO.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:1"
      },
      "items": [
        {
          "text": "Ni desees estar con ellos:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.1",
            "verseOrgIds": [
              "PRO.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque su corazón piensa en robar,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.2",
            "verseOrgIds": [
              "PRO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:2"
      },
      "items": [
        {
          "text": "E iniquidad hablan sus labios.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.2",
            "verseOrgIds": [
              "PRO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con sabiduría se edificará la casa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.3",
            "verseOrgIds": [
              "PRO.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:3"
      },
      "items": [
        {
          "text": "Y con prudencia se afirmará;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.3",
            "verseOrgIds": [
              "PRO.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y con ciencia se henchirán las cámaras",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.4",
            "verseOrgIds": [
              "PRO.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:4"
      },
      "items": [
        {
          "text": "De todo bien preciado y agradable.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.4",
            "verseOrgIds": [
              "PRO.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hombre sabio es fuerte;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.5",
            "verseOrgIds": [
              "PRO.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:5"
      },
      "items": [
        {
          "text": "Y de pujante vigor el hombre docto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.5",
            "verseOrgIds": [
              "PRO.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque con ingenio harás la guerra:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.6",
            "verseOrgIds": [
              "PRO.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:6"
      },
      "items": [
        {
          "text": "Y la salud está en la multitud de consejeros.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.6",
            "verseOrgIds": [
              "PRO.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alta está",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        },
        {
          "text": "para el insensato la sabiduría:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:7"
      },
      "items": [
        {
          "text": "En la puerta no abrirá él su boca.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al que piensa mal hacer",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.8",
            "verseOrgIds": [
              "PRO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:8"
      },
      "items": [
        {
          "text": "Le llamarán hombre de malos pensamientos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.8",
            "verseOrgIds": [
              "PRO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "El pensamiento del necio es pecado:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.9",
            "verseOrgIds": [
              "PRO.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:9"
      },
      "items": [
        {
          "text": "Y abominación á los hombres el escarnecedor.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.9",
            "verseOrgIds": [
              "PRO.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si fueres flojo en el día de trabajo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.10",
            "verseOrgIds": [
              "PRO.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:10"
      },
      "items": [
        {
          "text": "Tu fuerza será reducida.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.10",
            "verseOrgIds": [
              "PRO.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si dejares de librar los que son tomados para la muerte,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.11",
            "verseOrgIds": [
              "PRO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:11"
      },
      "items": [
        {
          "text": "Y los que son llevados al degolladero;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.11",
            "verseOrgIds": [
              "PRO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si dijeres: Ciertamente no lo supimos;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "¿No lo entenderá",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        },
        {
          "text": "el que pesa los corazones?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "El que mira por tu alma, él lo conocerá,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "Y dará al hombre según sus obras.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Come, hijo mío, de la miel, porque es buena,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.13",
            "verseOrgIds": [
              "PRO.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:13"
      },
      "items": [
        {
          "text": "Y del panal dulce á tu paladar:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.13",
            "verseOrgIds": [
              "PRO.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tal será el conocimiento de la sabiduría á tu alma:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:14"
      },
      "items": [
        {
          "text": "Si la hallares tendrá recompensa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:14"
      },
      "items": [
        {
          "text": "Y al fin tu esperanza no será cortada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh impío, no aceches la tienda del justo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.15",
            "verseOrgIds": [
              "PRO.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:15"
      },
      "items": [
        {
          "text": "No saquees su cámara;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.15",
            "verseOrgIds": [
              "PRO.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Breves discursos morales.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Otros proverbios",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque siete veces cae el justo, y se torna á levantar;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.16",
            "verseOrgIds": [
              "PRO.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:16"
      },
      "items": [
        {
          "text": "Mas los impíos caerán en el mal.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.16",
            "verseOrgIds": [
              "PRO.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando cayere tu enemigo, no te huelgues;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.17",
            "verseOrgIds": [
              "PRO.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:17"
      },
      "items": [
        {
          "text": "Y cuando tropezare, no se alegre tu corazón:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.17",
            "verseOrgIds": [
              "PRO.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque Jehová no lo mire, y le desagrade,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.18",
            "verseOrgIds": [
              "PRO.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:18"
      },
      "items": [
        {
          "text": "Y aparte de sobre él su enojo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.18",
            "verseOrgIds": [
              "PRO.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "No te entrometas con los malignos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.19",
            "verseOrgIds": [
              "PRO.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:19"
      },
      "items": [
        {
          "text": "Ni tengas envidia de los impíos;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.19",
            "verseOrgIds": [
              "PRO.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque para el malo no habrá",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.20",
            "verseOrgIds": [
              "PRO.24.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "buen",
              "type": "text",
              "attrs": {
                "verseId": "PRO.24.20",
                "verseOrgIds": [
                  "PRO.24.20"
                ]
              }
            }
          ]
        },
        {
          "text": "fin,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.20",
            "verseOrgIds": [
              "PRO.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:20"
      },
      "items": [
        {
          "text": "Y la candela de los impíos será apagada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.20",
            "verseOrgIds": [
              "PRO.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teme á Jehová, hijo mío, y al rey;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.21",
            "verseOrgIds": [
              "PRO.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:21"
      },
      "items": [
        {
          "text": "No te entrometas con los veleidosos:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.21",
            "verseOrgIds": [
              "PRO.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque su quebrantamiento se levantará de repente;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.22",
            "verseOrgIds": [
              "PRO.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:22"
      },
      "items": [
        {
          "text": "Y el quebrantamiento de ambos, ¿quién lo comprende?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.22",
            "verseOrgIds": [
              "PRO.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "También estas cosas",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.23",
            "verseOrgIds": [
              "PRO.24.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "pertenecen",
              "type": "text",
              "attrs": {
                "verseId": "PRO.24.23",
                "verseOrgIds": [
                  "PRO.24.23"
                ]
              }
            }
          ]
        },
        {
          "text": "á los sabios.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.23",
            "verseOrgIds": [
              "PRO.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PRO 24:23"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:23"
      },
      "items": [
        {
          "text": "Tener respeto á personas en el juicio no es bueno.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.23",
            "verseOrgIds": [
              "PRO.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que dijere al malo, Justo eres,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.24",
            "verseOrgIds": [
              "PRO.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:24"
      },
      "items": [
        {
          "text": "Los pueblos lo maldecirán, y le detestarán las naciones:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.24",
            "verseOrgIds": [
              "PRO.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas los que",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.25",
            "verseOrgIds": [
              "PRO.24.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "lo",
              "type": "text",
              "attrs": {
                "verseId": "PRO.24.25",
                "verseOrgIds": [
                  "PRO.24.25"
                ]
              }
            }
          ]
        },
        {
          "text": "reprenden, serán agradables,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.25",
            "verseOrgIds": [
              "PRO.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:25"
      },
      "items": [
        {
          "text": "Y sobre ellos vendrá bendición de bien.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.25",
            "verseOrgIds": [
              "PRO.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Besados serán los labios",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.26",
            "verseOrgIds": [
              "PRO.24.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:26"
      },
      "items": [
        {
          "text": "Del que responde palabras rectas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.26",
            "verseOrgIds": [
              "PRO.24.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apresta tu obra de afuera,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.27",
            "verseOrgIds": [
              "PRO.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:27"
      },
      "items": [
        {
          "text": "Y disponla en tu heredad;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.27",
            "verseOrgIds": [
              "PRO.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:27"
      },
      "items": [
        {
          "text": "Y después edificarás tu casa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.27",
            "verseOrgIds": [
              "PRO.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "No seas sin causa testigo contra tu prójimo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.28",
            "verseOrgIds": [
              "PRO.24.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:28"
      },
      "items": [
        {
          "text": "Y no lisonjees con tus labios.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.28",
            "verseOrgIds": [
              "PRO.24.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "No digas: Como me hizo, así le haré;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.29",
            "verseOrgIds": [
              "PRO.24.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:29"
      },
      "items": [
        {
          "text": "Daré el pago al hombre según su obra.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.29",
            "verseOrgIds": [
              "PRO.24.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasé junto á la heredad del hombre perezoso,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.30",
            "verseOrgIds": [
              "PRO.24.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:30"
      },
      "items": [
        {
          "text": "Y junto á la viña del hombre falto de entendimiento;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.30",
            "verseOrgIds": [
              "PRO.24.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.31",
            "verseOrgIds": [
              "PRO.24.31"
            ]
          }
        },
        {
          "text": "he aquí que por toda ella habían ya crecido espinas,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.31",
            "verseOrgIds": [
              "PRO.24.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:31"
      },
      "items": [
        {
          "text": "Ortigas habían ya cubierto su haz,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.31",
            "verseOrgIds": [
              "PRO.24.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:31"
      },
      "items": [
        {
          "text": "Y su cerca de piedra estaba ya destruída.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.31",
            "verseOrgIds": [
              "PRO.24.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y yo miré, y púse",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.32",
            "verseOrgIds": [
              "PRO.24.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "lo",
              "type": "text",
              "attrs": {
                "verseId": "PRO.24.32",
                "verseOrgIds": [
                  "PRO.24.32"
                ]
              }
            }
          ]
        },
        {
          "text": "en mi corazón:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.32",
            "verseOrgIds": [
              "PRO.24.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:32"
      },
      "items": [
        {
          "text": "Vi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.32",
            "verseOrgIds": [
              "PRO.24.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "lo,",
              "type": "text",
              "attrs": {
                "verseId": "PRO.24.32",
                "verseOrgIds": [
                  "PRO.24.32"
                ]
              }
            }
          ]
        },
        {
          "text": "y tomé consejo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.32",
            "verseOrgIds": [
              "PRO.24.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un poco de sueño, cabeceando otro poco,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.33",
            "verseOrgIds": [
              "PRO.24.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:33"
      },
      "items": [
        {
          "text": "Poniendo mano sobre mano otro poco para dormir;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.33",
            "verseOrgIds": [
              "PRO.24.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Así vendrá como caminante tu necesidad,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.34",
            "verseOrgIds": [
              "PRO.24.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 24:34"
      },
      "items": [
        {
          "text": "Y tu pobreza como hombre de escudo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.34",
            "verseOrgIds": [
              "PRO.24.34"
            ]
          }
        }
      ]
    }
  ],
