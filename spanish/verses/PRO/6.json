{
  "id": "PRO.6",
  "number": "6",
  "bookId": "PRO",
  "reference": "Proverbios 6",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "PRO 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "HIJO mío,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.1",
            "verseOrgIds": [
              "PRO.6.1"
            ]
          }
        },
        {
          "text": "si salieres fiador por tu amigo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.1",
            "verseOrgIds": [
              "PRO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:1"
      },
      "items": [
        {
          "text": "Si tocaste tu mano por el extraño,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.1",
            "verseOrgIds": [
              "PRO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enlazado eres con las palabras de tu boca,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.2",
            "verseOrgIds": [
              "PRO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:2"
      },
      "items": [
        {
          "text": "Y preso con las razones de tu boca.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.2",
            "verseOrgIds": [
              "PRO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haz esto ahora, hijo mío, y líbrate,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:3"
      },
      "items": [
        {
          "text": "Ya que has caído en la mano de tu prójimo:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:3"
      },
      "items": [
        {
          "text": "Ve, humíllate, y asegúrate de tu amigo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "No des sueño á tus ojos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.4",
            "verseOrgIds": [
              "PRO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:4"
      },
      "items": [
        {
          "text": "Ni á tus párpados adormecimiento.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.4",
            "verseOrgIds": [
              "PRO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Escápate como el corzo de la mano",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.5",
            "verseOrgIds": [
              "PRO.6.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "del cazador,",
              "type": "text",
              "attrs": {
                "verseId": "PRO.6.5",
                "verseOrgIds": [
                  "PRO.6.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:5"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.5",
            "verseOrgIds": [
              "PRO.6.5"
            ]
          }
        },
        {
          "text": "como el ave de la mano del parancero.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.5",
            "verseOrgIds": [
              "PRO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ve á la hormiga, oh perezoso",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.6",
            "verseOrgIds": [
              "PRO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:6"
      },
      "items": [
        {
          "text": "Mira sus caminos, y sé sabio;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.6",
            "verseOrgIds": [
              "PRO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "La cual no teniendo capitán,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.7",
            "verseOrgIds": [
              "PRO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:7"
      },
      "items": [
        {
          "text": "Ni gobernador, ni señor,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.7",
            "verseOrgIds": [
              "PRO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Prepara en el verano su comida",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.8",
            "verseOrgIds": [
              "PRO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:8"
      },
      "items": [
        {
          "text": "Y allega en el tiempo de la siega su mantenimiento.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.8",
            "verseOrgIds": [
              "PRO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perezoso, ¿hasta cuándo has de dormir?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.9",
            "verseOrgIds": [
              "PRO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:9"
      },
      "items": [
        {
          "text": "¿Cuándo te levantarás de tu sueño?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.9",
            "verseOrgIds": [
              "PRO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un poco de sueño, un poco de dormitar,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.10",
            "verseOrgIds": [
              "PRO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:10"
      },
      "items": [
        {
          "text": "Y cruzar por un poco las manos para reposo:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.10",
            "verseOrgIds": [
              "PRO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Así",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.11",
            "verseOrgIds": [
              "PRO.6.11"
            ]
          }
        },
        {
          "text": "vendrá tu necesidad como caminante,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.11",
            "verseOrgIds": [
              "PRO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:11"
      },
      "items": [
        {
          "text": "Y tu pobreza como hombre de escudo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.11",
            "verseOrgIds": [
              "PRO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hombre malo, el hombre depravado,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.12",
            "verseOrgIds": [
              "PRO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:12"
      },
      "items": [
        {
          "text": "Anda en perversidad de boca;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.12",
            "verseOrgIds": [
              "PRO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiña de sus ojos, habla con sus pies,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:13"
      },
      "items": [
        {
          "text": "Indica con sus dedos;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perversidades hay en su corazón,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.14",
            "verseOrgIds": [
              "PRO.6.14"
            ]
          }
        },
        {
          "text": "anda pensando mal en todo tiempo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.14",
            "verseOrgIds": [
              "PRO.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:14"
      },
      "items": [
        {
          "text": "Enciende rencillas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.14",
            "verseOrgIds": [
              "PRO.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por tanto su calamidad vendrá de repente;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:15"
      },
      "items": [
        {
          "text": "Súbitamente",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        },
        {
          "text": "será quebrantado, y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        },
        {
          "text": "no",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "habrá",
              "type": "text",
              "attrs": {
                "verseId": "PRO.6.15",
                "verseOrgIds": [
                  "PRO.6.15"
                ]
              }
            }
          ]
        },
        {
          "text": "remedio.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seis cosas aborrece Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16",
            "verseOrgIds": [
              "PRO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:16"
      },
      "items": [
        {
          "text": "Y aun siete abomina su alma:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16",
            "verseOrgIds": [
              "PRO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los ojos altivos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.17",
            "verseOrgIds": [
              "PRO.6.17"
            ]
          }
        },
        {
          "text": "la lengua mentirosa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.17",
            "verseOrgIds": [
              "PRO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:17"
      },
      "items": [
        {
          "text": "Las manos derramadoras de sangre inocente,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.17",
            "verseOrgIds": [
              "PRO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "El corazón que maquina pensamientos inicuos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.18",
            "verseOrgIds": [
              "PRO.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:18"
      },
      "items": [
        {
          "text": "Los pies presurosos para correr al mal,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.18",
            "verseOrgIds": [
              "PRO.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "El testigo falso que habla mentiras,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.19",
            "verseOrgIds": [
              "PRO.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:19"
      },
      "items": [
        {
          "text": "Y el que",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.19",
            "verseOrgIds": [
              "PRO.6.19"
            ]
          }
        },
        {
          "text": "enciende rencillas entre los hermanos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.19",
            "verseOrgIds": [
              "PRO.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 El joven amonestado",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 contra el adulterio.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guarda, hijo mío, el mandamiento de tu padre,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.20",
            "verseOrgIds": [
              "PRO.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:20"
      },
      "items": [
        {
          "text": "Y no dejes la enseñanza de tu madre:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.20",
            "verseOrgIds": [
              "PRO.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atalos siempre en tu corazón,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.21",
            "verseOrgIds": [
              "PRO.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:21"
      },
      "items": [
        {
          "text": "Enlázalos á tu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.21",
            "verseOrgIds": [
              "PRO.6.21"
            ]
          }
        },
        {
          "text": "cuello.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.21",
            "verseOrgIds": [
              "PRO.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te guiarán cuando anduvieres; cuando durmieres te guardarán;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.22",
            "verseOrgIds": [
              "PRO.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:22"
      },
      "items": [
        {
          "text": "Hablarán contigo cuando despertares.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.22",
            "verseOrgIds": [
              "PRO.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque el mandamiento es antorcha, y la enseñanza luz;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.23",
            "verseOrgIds": [
              "PRO.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:23"
      },
      "items": [
        {
          "text": "Y camino de vida las reprensiones de la enseñanza:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.23",
            "verseOrgIds": [
              "PRO.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para que te guarden de la mala mujer,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.24",
            "verseOrgIds": [
              "PRO.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:24"
      },
      "items": [
        {
          "text": "De la blandura de la lengua de la extraña.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.24",
            "verseOrgIds": [
              "PRO.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "No codicies su hermosura en tu corazón,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.25",
            "verseOrgIds": [
              "PRO.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:25"
      },
      "items": [
        {
          "text": "Ni ella te prenda con sus ojos:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.25",
            "verseOrgIds": [
              "PRO.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.26",
            "verseOrgIds": [
              "PRO.6.26"
            ]
          }
        },
        {
          "text": "a causa de la mujer ramera",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.26",
            "verseOrgIds": [
              "PRO.6.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es reducido el hombre",
              "type": "text",
              "attrs": {
                "verseId": "PRO.6.26",
                "verseOrgIds": [
                  "PRO.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": "á un bocado de pan;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.26",
            "verseOrgIds": [
              "PRO.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:26"
      },
      "items": [
        {
          "text": "Y la mujer",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.26",
            "verseOrgIds": [
              "PRO.6.26"
            ]
          }
        },
        {
          "text": "caza la preciosa alma del varón.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.26",
            "verseOrgIds": [
              "PRO.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Tomará el hombre fuego en su seno,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.27",
            "verseOrgIds": [
              "PRO.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:27"
      },
      "items": [
        {
          "text": "Sin que sus vestidos se quemen?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.27",
            "verseOrgIds": [
              "PRO.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Andará el hombre sobre las brasas,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.28",
            "verseOrgIds": [
              "PRO.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:28"
      },
      "items": [
        {
          "text": "Sin que sus pies se abrasen?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.28",
            "verseOrgIds": [
              "PRO.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Así el que entrare á la mujer de su prójimo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.29",
            "verseOrgIds": [
              "PRO.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:29"
      },
      "items": [
        {
          "text": "No será sin culpa cualquiera que la tocare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.29",
            "verseOrgIds": [
              "PRO.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "No tienen en poco al ladrón, cuando hurtare",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.30",
            "verseOrgIds": [
              "PRO.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:30"
      },
      "items": [
        {
          "text": "Para saciar su alma teniendo hambre:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.30",
            "verseOrgIds": [
              "PRO.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empero tomado,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.31",
            "verseOrgIds": [
              "PRO.6.31"
            ]
          }
        },
        {
          "text": "paga las setenas,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.31",
            "verseOrgIds": [
              "PRO.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:31"
      },
      "items": [
        {
          "text": "Da toda la sustancia de su casa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.31",
            "verseOrgIds": [
              "PRO.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas el que comete adulterio con la mujer, es",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.32",
            "verseOrgIds": [
              "PRO.6.32"
            ]
          }
        },
        {
          "text": "falto de entendimiento:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.32",
            "verseOrgIds": [
              "PRO.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:32"
      },
      "items": [
        {
          "text": "Corrompe su alma el que tal hace.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.32",
            "verseOrgIds": [
              "PRO.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Plaga y vergüenza hallará;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.33",
            "verseOrgIds": [
              "PRO.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:33"
      },
      "items": [
        {
          "text": "Y su afrenta nunca será raída.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.33",
            "verseOrgIds": [
              "PRO.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque los celos son el furor del hombre,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.34",
            "verseOrgIds": [
              "PRO.6.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:34"
      },
      "items": [
        {
          "text": "Y no perdonará en el día de la venganza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.34",
            "verseOrgIds": [
              "PRO.6.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PRO 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "No tendrá respeto á ninguna redención;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.35",
            "verseOrgIds": [
              "PRO.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 6:35"
      },
      "items": [
        {
          "text": "Ni querrá",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.35",
            "verseOrgIds": [
              "PRO.6.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "perdonar,",
              "type": "text",
              "attrs": {
                "verseId": "PRO.6.35",
                "verseOrgIds": [
                  "PRO.6.35"
                ]
              }
            }
          ]
