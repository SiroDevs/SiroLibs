          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanto",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.22",
            "verseOrgIds": [
              "HEB.7.22"
            ]
          }
        },
