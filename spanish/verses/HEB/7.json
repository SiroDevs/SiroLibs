          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque tal",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.26",
            "verseOrgIds": [
              "HEB.7.26"
            ]
          }
        },
        {
          "text": "pontífice nos convenía:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.26",
            "verseOrgIds": [
              "HEB.7.26"
            ]
          }
        },
        {
          "text": "santo, inocente, limpio,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.26",
            "verseOrgIds": [
              "HEB.7.26"
            ]
          }
        },
        {
          "text": "apartado de los pecadores,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.26",
            "verseOrgIds": [
              "HEB.7.26"
            ]
          }
        },
        {
          "text": "y hecho más sublime que los cielos;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.26",
            "verseOrgIds": [
              "HEB.7.26"
            ]
          }
        }
      ]
    },
