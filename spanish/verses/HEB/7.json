          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y los otros cierto fueron muchos sacerdotes, en cuanto por la muerte no podían permanecer.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.23",
            "verseOrgIds": [
              "HEB.7.23"
            ]
          }
        }
      ]
    },
    {
