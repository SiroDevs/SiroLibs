                "verseId": "HEB.7.27",
                "verseOrgIds": [
                  "HEB.7.27"
                ]
              }
            }
          ]
        },
        {
          "text": "sacerdotes, de ofrecer",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.27",
            "verseOrgIds": [
              "HEB.7.27"
            ]
          }
        },
        {
          "text": "primero sacrificios por sus pecados, y luego por los del pueblo: porque",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.27",
            "verseOrgIds": [
              "HEB.7.27"
            ]
          }
        },
        {
          "text": "esto",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.27",
            "verseOrgIds": [
              "HEB.7.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "lo",
              "type": "text",
              "attrs": {
                "verseId": "HEB.7.27",
                "verseOrgIds": [
                  "HEB.7.27"
                ]
              }
            }
          ]
        },
        {
          "text": "hizo",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.27",
            "verseOrgIds": [
              "HEB.7.27"
            ]
          }
        },
