              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que no tiene necesidad",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.27",
            "verseOrgIds": [
              "HEB.7.27"
            ]
          }
        },
        {
          "text": "cada día, como los",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.27",
            "verseOrgIds": [
              "HEB.7.27"
            ]
          }
        },
