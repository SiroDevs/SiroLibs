          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "No hay Judío, ni Griego;",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.28",
            "verseOrgIds": [
              "GAL.3.28"
            ]
          }
        },
        {
          "text": "no hay siervo, ni libre; no hay varón, ni hembra: porque todos vosotros sois",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.28",
            "verseOrgIds": [
              "GAL.3.28"
            ]
          }
        },
        {
          "text": "uno en Cristo Jesús.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.28",
            "verseOrgIds": [
              "GAL.3.28"
            ]
          }
        }
