          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas venida la fe, ya no estamos bajo ayo;",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.25",
            "verseOrgIds": [
              "GAL.3.25"
            ]
          }
        }
      ]
    },
    {
