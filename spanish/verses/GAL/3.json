              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.27",
            "verseOrgIds": [
              "GAL.3.27"
            ]
          }
        },
        {
          "text": "todos los que habéis sido bautizados en Cristo,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.27",
            "verseOrgIds": [
              "GAL.3.27"
            ]
          }
        },
        {
