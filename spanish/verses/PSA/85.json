{
  "id": "PSA.85",
  "number": "85",
  "bookId": "PSA",
  "reference": "Salmos 85",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "85",
        "style": "c",
        "sid": "PSA 85"
      },
      "items": [
        {
          "text": "85",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: Salmo para los hijos de Coré.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 85:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "FUISTE propicio á tu tierra, oh Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.1",
            "verseOrgIds": [
              "PSA.85.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 85:1"
      },
      "items": [
        {
          "text": "Volviste la cautividad de Jacob.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.1",
            "verseOrgIds": [
              "PSA.85.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 85:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perdonaste la iniquidad de tu pueblo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.2",
            "verseOrgIds": [
              "PSA.85.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 85:2"
      },
      "items": [
        {
          "text": "Todos los pecados de ellos cubriste. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.2",
            "verseOrgIds": [
              "PSA.85.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 85:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dejaste toda tu saña:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.3",
            "verseOrgIds": [
              "PSA.85.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 85:3"
      },
      "items": [
        {
          "text": "Te volviste de la ira de tu furor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.3",
            "verseOrgIds": [
              "PSA.85.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 85:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuélvenos, oh Dios, salud nuestra,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.4",
            "verseOrgIds": [
              "PSA.85.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 85:4"
      },
      "items": [
        {
          "text": "Y haz cesar tu ira de sobre nosotros.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.4",
            "verseOrgIds": [
              "PSA.85.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 85:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Estarás enojado contra nosotros para siempre?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.5",
            "verseOrgIds": [
              "PSA.85.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 85:5"
      },
      "items": [
        {
          "text": "¿Extenderás tu ira de generación en generación?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.5",
            "verseOrgIds": [
              "PSA.85.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 85:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿No volverás tú á darnos vida,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.6",
            "verseOrgIds": [
              "PSA.85.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 85:6"
      },
      "items": [
        {
          "text": "Y tu pueblo se alegrará en ti?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.6",
            "verseOrgIds": [
              "PSA.85.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 85:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muéstranos, oh Jehová, tu misericordia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.7",
            "verseOrgIds": [
              "PSA.85.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 85:7"
      },
      "items": [
        {
          "text": "Y danos tu salud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.7",
            "verseOrgIds": [
              "PSA.85.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 85:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Escucharé lo que hablará el Dios Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 85:8"
      },
      "items": [
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        },
        {
          "text": "hablará paz á su pueblo y á sus",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        },
        {
          "text": "santos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 85:8"
      },
      "items": [
        {
          "text": "Para que no se conviertan",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        },
        {
          "text": "a la locura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 85:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciertamente cercana está su salud á los que le temen;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.9",
            "verseOrgIds": [
              "PSA.85.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 85:9"
      },
      "items": [
        {
          "text": "Para que habite la gloria en nuestra tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.9",
            "verseOrgIds": [
              "PSA.85.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 85:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "La misericordia y la verdad se encontraron:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.10",
            "verseOrgIds": [
              "PSA.85.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 85:10"
      },
      "items": [
        {
          "text": "La justicia y la paz se besaron.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.10",
            "verseOrgIds": [
              "PSA.85.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 85:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "La verdad brotará de la tierra;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.11",
            "verseOrgIds": [
              "PSA.85.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 85:11"
      },
      "items": [
        {
          "text": "Y la justicia mirará desde los cielos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.11",
            "verseOrgIds": [
              "PSA.85.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 85:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová dará también el bien;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.12",
            "verseOrgIds": [
              "PSA.85.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 85:12"
      },
      "items": [
        {
          "text": "Y nuestra",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.12",
            "verseOrgIds": [
              "PSA.85.13"
            ]
          }
        },
        {
          "text": "tierra dará su fruto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.12",
            "verseOrgIds": [
              "PSA.85.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 85:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "La justicia irá delante de él;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.13",
            "verseOrgIds": [
              "PSA.85.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 85:13"
      },
      "items": [
        {
          "text": "Y sus pasos pondrá en camino.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.13",
            "verseOrgIds": [
              "PSA.85.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.86",
    "number": "86",
    "bookId": "PSA"
  },
  "previous": {
    "id": "PSA.84",
