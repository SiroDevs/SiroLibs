{
  "id": "PSA.38",
  "number": "38",
  "bookId": "PSA",
  "reference": "Salmos 38",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "PSA 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo de David,",
          "type": "text"
        },
        {
          "text": "para recordar.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "JEHOVÁ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.1",
            "verseOrgIds": [
              "PSA.38.2"
            ]
          }
        },
        {
          "text": "no me reprendas en tu furor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.1",
            "verseOrgIds": [
              "PSA.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:1"
      },
      "items": [
        {
          "text": "Ni me castigues en tu ira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.1",
            "verseOrgIds": [
              "PSA.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.2",
            "verseOrgIds": [
              "PSA.38.3"
            ]
          }
        },
        {
          "text": "tus saetas descendieron á mí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.2",
            "verseOrgIds": [
              "PSA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:2"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.2",
            "verseOrgIds": [
              "PSA.38.3"
            ]
          }
        },
        {
          "text": "sobre mí ha caído tu mano.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.2",
            "verseOrgIds": [
              "PSA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "No hay sanidad en mi carne á causa de tu ira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.3",
            "verseOrgIds": [
              "PSA.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:3"
      },
      "items": [
        {
          "text": "Ni hay paz en mis huesos á causa de mi pecado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.3",
            "verseOrgIds": [
              "PSA.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.4",
            "verseOrgIds": [
              "PSA.38.5"
            ]
          }
        },
        {
          "text": "mis iniquidades han pasado mi cabeza:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.4",
            "verseOrgIds": [
              "PSA.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:4"
      },
      "items": [
        {
          "text": "Como carga pesada se han",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.4",
            "verseOrgIds": [
              "PSA.38.5"
            ]
          }
        },
        {
          "text": "agravado sobre mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.4",
            "verseOrgIds": [
              "PSA.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pudriéronse, corrompiéronse mis llagas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.5",
            "verseOrgIds": [
              "PSA.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:5"
      },
      "items": [
        {
          "text": "A causa de mi locura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.5",
            "verseOrgIds": [
              "PSA.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Estoy encorvado,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.6",
            "verseOrgIds": [
              "PSA.38.7"
            ]
          }
        },
        {
          "text": "estoy humillado en gran manera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.6",
            "verseOrgIds": [
              "PSA.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:6"
      },
      "items": [
        {
          "text": "Ando enlutado todo el día.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.6",
            "verseOrgIds": [
              "PSA.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque mis lomos están llenos de irritación,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.7",
            "verseOrgIds": [
              "PSA.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:7"
      },
      "items": [
        {
          "text": "Y no hay sanidad en mi carne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.7",
            "verseOrgIds": [
              "PSA.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Estoy debilitado y molido en gran manera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.8",
            "verseOrgIds": [
              "PSA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:8"
      },
      "items": [
        {
          "text": "Bramo á causa de la conmoción de mi corazón.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.8",
            "verseOrgIds": [
              "PSA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Señor, delante de ti están todos mis deseos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.9",
            "verseOrgIds": [
              "PSA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:9"
      },
      "items": [
        {
          "text": "Y mi suspiro no te es oculto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.9",
            "verseOrgIds": [
              "PSA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi corazón está acongojado, hame dejado mi vigor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.10",
            "verseOrgIds": [
              "PSA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:10"
      },
      "items": [
        {
          "text": "Y aun",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.10",
            "verseOrgIds": [
              "PSA.38.11"
            ]
          }
        },
        {
          "text": "la misma luz de mis ojos no está conmigo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.10",
            "verseOrgIds": [
              "PSA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mis amigos y mis compañeros se quitaron de delante de mi plaga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.11",
            "verseOrgIds": [
              "PSA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:11"
      },
      "items": [
        {
          "text": "Y mis cercanos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.11",
            "verseOrgIds": [
              "PSA.38.12"
            ]
          }
        },
        {
          "text": "se pusieron lejos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.11",
            "verseOrgIds": [
              "PSA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y los que buscaban mi alma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.12",
            "verseOrgIds": [
              "PSA.38.13"
            ]
          }
        },
        {
          "text": "armaron lazos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.12",
            "verseOrgIds": [
              "PSA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:12"
      },
      "items": [
        {
          "text": "Y los que procuraban mi mal hablaban iniquidades,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.12",
            "verseOrgIds": [
              "PSA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:12"
      },
      "items": [
        {
          "text": "Y meditaban fraudes todo el día.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.12",
            "verseOrgIds": [
              "PSA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas yo, como",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.13",
            "verseOrgIds": [
              "PSA.38.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "si fuera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.38.13",
                "verseOrgIds": [
                  "PSA.38.14"
                ]
              }
            }
          ]
        },
        {
          "text": "sordo no oía;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.13",
            "verseOrgIds": [
              "PSA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Y estaba",
              "type": "text",
              "attrs": {
                "verseId": "PSA.38.13",
                "verseOrgIds": [
                  "PSA.38.14"
                ]
              }
            }
          ]
        },
        {
          "text": "como un mudo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.13",
            "verseOrgIds": [
              "PSA.38.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "que",
              "type": "text",
              "attrs": {
                "verseId": "PSA.38.13",
                "verseOrgIds": [
                  "PSA.38.14"
                ]
              }
            }
          ]
        },
        {
          "text": "no abre su boca.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.13",
            "verseOrgIds": [
              "PSA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuí pues como un hombre que no oye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.14",
            "verseOrgIds": [
              "PSA.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:14"
      },
      "items": [
        {
          "text": "Y que en su boca no tiene reprensiones.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.14",
            "verseOrgIds": [
              "PSA.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque á ti, oh Jehová, esperé yo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.15",
            "verseOrgIds": [
              "PSA.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:15"
      },
      "items": [
        {
          "text": "Tú responderás, Jehová Dios mío.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.15",
            "verseOrgIds": [
              "PSA.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque dije:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.16",
            "verseOrgIds": [
              "PSA.38.17"
            ]
          }
        },
        {
          "text": "Que no se alegren de mí:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.16",
            "verseOrgIds": [
              "PSA.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:16"
      },
      "items": [
        {
          "text": "Cuando mi pie resbalaba, sobre mí se engrandecían.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.16",
            "verseOrgIds": [
              "PSA.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empero yo estoy á pique de claudicar,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.17",
            "verseOrgIds": [
              "PSA.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:17"
      },
      "items": [
        {
          "text": "Y mi dolor está delante de mí continuamente.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.17",
            "verseOrgIds": [
              "PSA.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por tanto denunciaré mi maldad;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.18",
            "verseOrgIds": [
              "PSA.38.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:18"
      },
      "items": [
        {
          "text": "Congojaréme por mi pecado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.18",
            "verseOrgIds": [
              "PSA.38.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque mis enemigos están vivos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.19",
            "verseOrgIds": [
              "PSA.38.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "y",
              "type": "text",
              "attrs": {
                "verseId": "PSA.38.19",
                "verseOrgIds": [
                  "PSA.38.20"
                ]
              }
            }
          ]
        },
        {
          "text": "fuertes:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.19",
            "verseOrgIds": [
              "PSA.38.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:19"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.19",
            "verseOrgIds": [
              "PSA.38.20"
            ]
          }
        },
        {
          "text": "hanse aumentado los que me aborrecen sin causa:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.19",
            "verseOrgIds": [
              "PSA.38.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.20",
            "verseOrgIds": [
              "PSA.38.21"
            ]
          }
        },
        {
          "text": "pagando mal por bien",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.20",
            "verseOrgIds": [
              "PSA.38.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:20"
      },
      "items": [
        {
          "text": "Me son contrarios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.20",
            "verseOrgIds": [
              "PSA.38.21"
            ]
          }
        },
        {
          "text": "por seguir yo lo bueno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.20",
            "verseOrgIds": [
              "PSA.38.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "No me desampares, oh Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.21",
            "verseOrgIds": [
              "PSA.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:21"
      },
      "items": [
        {
          "text": "Dios mío, no te alejes de mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.21",
            "verseOrgIds": [
              "PSA.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apresúrate á ayudarme,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.22",
            "verseOrgIds": [
              "PSA.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 38:22"
      },
      "items": [
        {
          "text": "Oh Señor, mi salud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.22",
            "verseOrgIds": [
              "PSA.38.23"
            ]
          }
        }
