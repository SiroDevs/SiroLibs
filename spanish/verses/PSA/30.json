{
  "id": "PSA.30",
  "number": "30",
  "bookId": "PSA",
  "reference": "Salmos 30",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "PSA 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo cantado en la",
          "type": "text"
        },
        {
          "text": "dedicación de la Casa:",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Salmo",
              "type": "text"
            }
          ]
        },
        {
          "text": "de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "GLORIFICARTE he, oh Jehová; porque me has ensalzado,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.1",
            "verseOrgIds": [
              "PSA.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 30:1"
      },
      "items": [
        {
          "text": "Y no hiciste á mis enemigos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.1",
            "verseOrgIds": [
              "PSA.30.2"
            ]
          }
        },
        {
          "text": "alegrarse de mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.1",
            "verseOrgIds": [
              "PSA.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová Dios mío,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.2",
            "verseOrgIds": [
              "PSA.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 30:2"
      },
      "items": [
        {
          "text": "A ti clamé, y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.2",
            "verseOrgIds": [
              "PSA.30.3"
            ]
          }
        },
        {
          "text": "me sanaste.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.2",
            "verseOrgIds": [
              "PSA.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.3",
            "verseOrgIds": [
              "PSA.30.4"
            ]
          }
        },
        {
          "text": "hiciste subir mi alma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.3",
            "verseOrgIds": [
              "PSA.30.4"
            ]
          }
        },
        {
          "text": "del sepulcro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.3",
            "verseOrgIds": [
              "PSA.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 30:3"
      },
      "items": [
        {
          "text": "Dísteme vida, para que no",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.3",
            "verseOrgIds": [
              "PSA.30.4"
            ]
          }
        },
        {
          "text": "descendiese á la sepultura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.3",
            "verseOrgIds": [
              "PSA.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cantad á Jehová, vosotros sus santos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.4",
            "verseOrgIds": [
              "PSA.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 30:4"
      },
      "items": [
        {
          "text": "Y celebrad la memoria de su santidad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.4",
            "verseOrgIds": [
              "PSA.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        },
        {
          "text": "un momento será su furor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 30:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Mas",
              "type": "text",
              "attrs": {
                "verseId": "PSA.30.5",
                "verseOrgIds": [
                  "PSA.30.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        },
        {
          "text": "en su voluntad está",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "la",
              "type": "text",
              "attrs": {
                "verseId": "PSA.30.5",
                "verseOrgIds": [
                  "PSA.30.6"
                ]
              }
            }
          ]
        },
        {
          "text": "vida:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 30:5"
      },
      "items": [
        {
          "text": "Por la tarde durará el",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        },
        {
          "text": "lloró,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 30:5"
      },
      "items": [
        {
          "text": "Y á la mañana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "vendrá",
              "type": "text",
              "attrs": {
                "verseId": "PSA.30.5",
                "verseOrgIds": [
                  "PSA.30.6"
                ]
              }
            }
          ]
        },
        {
          "text": "la alegría.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Misericordia de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Aflicción de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y dije yo en mi prosperidad:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.6",
            "verseOrgIds": [
              "PSA.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 30:6"
      },
      "items": [
        {
          "text": "No seré jamás conmovido;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.6",
            "verseOrgIds": [
              "PSA.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque tú, Jehová, por tu benevolencia has asentado mi monte con fortaleza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.7",
            "verseOrgIds": [
              "PSA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 30:7"
      },
      "items": [
        {
          "text": "Escondiste tu rostro, fuí conturbado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.7",
            "verseOrgIds": [
              "PSA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ti, oh Jehová, clamaré;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.8",
            "verseOrgIds": [
              "PSA.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 30:8"
      },
      "items": [
        {
          "text": "Y al Señor suplicaré.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.8",
            "verseOrgIds": [
              "PSA.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Qué provecho hay en mi muerte, cuando yo descienda al hoyo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.9",
            "verseOrgIds": [
              "PSA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 30:9"
      },
      "items": [
        {
          "text": "¿Te alabará el polvo? ¿anunciará tu verdad?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.9",
            "verseOrgIds": [
              "PSA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oye, oh Jehová, y ten misericordia de mí:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.10",
            "verseOrgIds": [
              "PSA.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 30:10"
      },
      "items": [
        {
          "text": "Jehová, sé tú mi ayudador.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.10",
            "verseOrgIds": [
              "PSA.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Has tornado mi endecha en baile;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.11",
            "verseOrgIds": [
              "PSA.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 30:11"
      },
      "items": [
        {
          "text": "Desataste mi saco, y ceñísteme de alegría.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.11",
            "verseOrgIds": [
              "PSA.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por tanto á ti cantaré,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.12",
            "verseOrgIds": [
              "PSA.30.13"
            ]
          }
        },
        {
          "text": "gloria",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.12",
            "verseOrgIds": [
              "PSA.30.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "mía,",
              "type": "text",
              "attrs": {
                "verseId": "PSA.30.12",
                "verseOrgIds": [
                  "PSA.30.13"
                ]
              }
            }
          ]
        },
        {
          "text": "y no estaré callado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.12",
            "verseOrgIds": [
              "PSA.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 30:12"
      },
      "items": [
        {
          "text": "Jehová Dios mío, te alabaré para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.12",
            "verseOrgIds": [
              "PSA.30.13"
            ]
          }
        }
      ]
    }
  ],
