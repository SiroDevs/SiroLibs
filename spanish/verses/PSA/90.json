{
  "id": "PSA.90",
  "number": "90",
  "bookId": "PSA",
  "reference": "Salmos 90",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "90",
        "style": "c",
        "sid": "PSA 90"
      },
      "items": [
        {
          "text": "90",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Oración de",
          "type": "text"
        },
        {
          "text": "Moisés varón de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 90:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "SEÑOR,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.1",
            "verseOrgIds": [
              "PSA.90.1"
            ]
          }
        },
        {
          "text": "tú nos has sido refugio",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.1",
            "verseOrgIds": [
              "PSA.90.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:1"
      },
      "items": [
        {
          "text": "En generación y en generación.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.1",
            "verseOrgIds": [
              "PSA.90.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 90:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antes que naciesen los montes",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:2"
      },
      "items": [
        {
          "text": "Y formases la tierra y el mundo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:2"
      },
      "items": [
        {
          "text": "Y desde el siglo y hasta el siglo, tú eres Dios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Fragilidad del hombre.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 \"Al abrigo del Altísimo.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 90:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuelves al hombre hasta ser quebrantado,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.3",
            "verseOrgIds": [
              "PSA.90.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:3"
      },
      "items": [
        {
          "text": "Y dices:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.3",
            "verseOrgIds": [
              "PSA.90.3"
            ]
          }
        },
        {
          "text": "Convertíos, hijos de los hombres.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.3",
            "verseOrgIds": [
              "PSA.90.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 90:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque mil años delante de tus ojos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.4",
            "verseOrgIds": [
              "PSA.90.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:4"
      },
      "items": [
        {
          "text": "Son como el día de ayer, que pasó,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.4",
            "verseOrgIds": [
              "PSA.90.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:4"
      },
      "items": [
        {
          "text": "Y como una de las vigilias de la noche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.4",
            "verseOrgIds": [
              "PSA.90.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 90:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Háceslos pasar como avenida de aguas;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.5",
            "verseOrgIds": [
              "PSA.90.5"
            ]
          }
        },
        {
          "text": "son como sueño;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.5",
            "verseOrgIds": [
              "PSA.90.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:5"
      },
      "items": [
        {
          "text": "Como la hierba que crece en la mañana:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.5",
            "verseOrgIds": [
              "PSA.90.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 90:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "En la mañana florece y crece;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.6",
            "verseOrgIds": [
              "PSA.90.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:6"
      },
      "items": [
        {
          "text": "A la tarde es cortada, y se seca.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.6",
            "verseOrgIds": [
              "PSA.90.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 90:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque con tu furor somos consumidos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.7",
            "verseOrgIds": [
              "PSA.90.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:7"
      },
      "items": [
        {
          "text": "Y con tu ira somos conturbados.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.7",
            "verseOrgIds": [
              "PSA.90.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 90:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pusiste nuestras maldades delante de ti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.8",
            "verseOrgIds": [
              "PSA.90.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:8"
      },
      "items": [
        {
          "text": "Nuestros yerros á la luz de tu rostro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.8",
            "verseOrgIds": [
              "PSA.90.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 90:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque todos nuestros días declinan á causa de tu ira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.9",
            "verseOrgIds": [
              "PSA.90.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:9"
      },
      "items": [
        {
          "text": "Acabamos nuestros años como un pensamiento.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.9",
            "verseOrgIds": [
              "PSA.90.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 90:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los días de nuestra edad son setenta años;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "Que si en los más robustos son ochenta años,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "Con todo su fortaleza es molestia y trabajo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "Porque es cortado presto, y volamos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 90:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién conoce la fortaleza de tu ira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.11",
            "verseOrgIds": [
              "PSA.90.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:11"
      },
      "items": [
        {
          "text": "Y tu indignación según que debes ser temido?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.11",
            "verseOrgIds": [
              "PSA.90.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 90:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enséñanos de tal modo á contar nuestros días,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.12",
            "verseOrgIds": [
              "PSA.90.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:12"
      },
      "items": [
        {
          "text": "Que traigamos al corazón sabiduría.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.12",
            "verseOrgIds": [
              "PSA.90.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 90:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuélvete, oh Jehová: ¿hasta cuándo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.13",
            "verseOrgIds": [
              "PSA.90.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:13"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.13",
            "verseOrgIds": [
              "PSA.90.13"
            ]
          }
        },
        {
          "text": "aplácate para con tus siervos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.13",
            "verseOrgIds": [
              "PSA.90.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 90:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sácianos presto de tu misericordia:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.14",
            "verseOrgIds": [
              "PSA.90.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:14"
      },
      "items": [
        {
          "text": "Y cantaremos y nos alegraremos todos nuestros días.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.14",
            "verseOrgIds": [
              "PSA.90.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 90:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alégranos conforme á los días que nos afligiste,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.15",
            "verseOrgIds": [
              "PSA.90.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:15"
      },
      "items": [
        {
          "text": "Y los años que vimos mal.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.15",
            "verseOrgIds": [
              "PSA.90.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 90:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aparezca en tus siervos tu obra,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.16",
            "verseOrgIds": [
              "PSA.90.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 90:16"
      },
      "items": [
        {
          "text": "Y tu gloria sobre sus hijos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.16",
            "verseOrgIds": [
              "PSA.90.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 90:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y sea la luz de Jehová nuestro Dios sobre nosotros:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.17",
            "verseOrgIds": [
              "PSA.90.17"
