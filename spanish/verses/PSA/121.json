    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Cántico gradual.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 121:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ALZARÉ mis ojos á",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.1",
            "verseOrgIds": [
              "PSA.121.1"
            ]
          }
        },
        {
          "text": "los montes,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.1",
            "verseOrgIds": [
              "PSA.121.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 121:1"
      },
      "items": [
        {
          "text": "De donde vendrá mi socorro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.1",
            "verseOrgIds": [
              "PSA.121.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 121:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi socorro",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "viene",
              "type": "text",
              "attrs": {
                "verseId": "PSA.121.2",
                "verseOrgIds": [
                  "PSA.121.2"
                ]
              }
            }
          ]
        },
        {
          "text": "de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 121:2"
      },
      "items": [
        {
          "text": "Que hizo los cielos y la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 121:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "No dará tu pie al resbaladero;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.3",
            "verseOrgIds": [
              "PSA.121.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 121:3"
      },
      "items": [
        {
          "text": "Ni se dormirá el que te guarda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.3",
            "verseOrgIds": [
              "PSA.121.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 121:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí, no se adormecerá ni dormirá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.4",
            "verseOrgIds": [
              "PSA.121.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 121:4"
      },
      "items": [
        {
          "text": "El que guarda á Israel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.4",
            "verseOrgIds": [
              "PSA.121.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 121:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová es tu guardador:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.5",
            "verseOrgIds": [
              "PSA.121.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 121:5"
      },
      "items": [
        {
          "text": "Jehová es",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.5",
            "verseOrgIds": [
              "PSA.121.5"
            ]
          }
        },
        {
          "text": "tu sombra á tu mano derecha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.5",
            "verseOrgIds": [
              "PSA.121.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 121:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "El sol no te fatigará de día,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.6",
            "verseOrgIds": [
              "PSA.121.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 121:6"
      },
      "items": [
        {
          "text": "Ni la luna de noche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.6",
            "verseOrgIds": [
              "PSA.121.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 121:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová te guardará de todo mal:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.7",
            "verseOrgIds": [
              "PSA.121.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 121:7"
      },
      "items": [
        {
          "text": "El",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.7",
            "verseOrgIds": [
              "PSA.121.7"
            ]
          }
        },
        {
          "text": "guardará tu alma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.7",
            "verseOrgIds": [
              "PSA.121.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 121:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.8",
            "verseOrgIds": [
              "PSA.121.8"
            ]
          }
        },
        {
          "text": "guardará tu salida y tu entrada,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.8",
            "verseOrgIds": [
              "PSA.121.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 121:8"
      },
      "items": [
        {
          "text": "Desde ahora y para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.8",
            "verseOrgIds": [
              "PSA.121.8"
            ]
          }
        }
      ]
    }
  ],
