  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "146",
        "style": "c",
        "sid": "PSA 146"
      },
      "items": [
        {
          "text": "146",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Aleluya.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 146:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ALABA,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.1",
            "verseOrgIds": [
              "PSA.146.1"
            ]
          }
        },
        {
          "text": "oh alma mía, á Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.1",
            "verseOrgIds": [
              "PSA.146.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 146:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alabaré á Jehová en mi vida:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.2",
            "verseOrgIds": [
              "PSA.146.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 146:2"
      },
      "items": [
        {
          "text": "Cantaré salmos á mi Dios mientras viviere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.2",
            "verseOrgIds": [
              "PSA.146.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 146:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "No confiéis en los príncipes,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.3",
            "verseOrgIds": [
              "PSA.146.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 146:3"
      },
      "items": [
        {
          "text": "Ni en hijo de hombre, porque no hay en él salud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.3",
            "verseOrgIds": [
              "PSA.146.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 146:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saldrá su espíritu, tornaráse en su tierra:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.4",
            "verseOrgIds": [
              "PSA.146.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 146:4"
      },
      "items": [
        {
          "text": "En aquel día perecerán sus pensamientos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.4",
            "verseOrgIds": [
              "PSA.146.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 146:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienaventurado aquel en cuya ayuda es el Dios de Jacob,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.5",
            "verseOrgIds": [
              "PSA.146.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 146:5"
      },
      "items": [
        {
          "text": "Cuya esperanza es en Jehová su Dios:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.5",
            "verseOrgIds": [
              "PSA.146.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 146:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "El cual hizo los cielos y la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.6",
            "verseOrgIds": [
              "PSA.146.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 146:6"
      },
      "items": [
        {
          "text": "La mar, y todo lo que en ellos hay;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.6",
            "verseOrgIds": [
              "PSA.146.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 146:6"
      },
      "items": [
        {
          "text": "Que guarda verdad para siempre;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.6",
            "verseOrgIds": [
              "PSA.146.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 146:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que hace derecho á los agraviados;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.7",
            "verseOrgIds": [
              "PSA.146.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 146:7"
      },
      "items": [
        {
          "text": "Que da pan á los hambrientos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.7",
            "verseOrgIds": [
              "PSA.146.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 146:7"
      },
      "items": [
        {
          "text": "Jehová suelta á los aprisionados;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.7",
            "verseOrgIds": [
              "PSA.146.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 146:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová abre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.8",
            "verseOrgIds": [
              "PSA.146.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "los ojos",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.8",
                "verseOrgIds": [
                  "PSA.146.8"
                ]
              }
            }
          ]
        },
        {
          "text": "á los ciegos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.8",
            "verseOrgIds": [
              "PSA.146.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 146:8"
      },
      "items": [
        {
          "text": "Jehová levanta á los caídos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.8",
            "verseOrgIds": [
              "PSA.146.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 146:8"
      },
      "items": [
        {
          "text": "Jehová ama á los justos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.8",
            "verseOrgIds": [
              "PSA.146.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 146:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová guarda á los extranjeros;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.9",
            "verseOrgIds": [
              "PSA.146.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 146:9"
      },
      "items": [
        {
          "text": "Al huérfano y á la viuda levanta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.9",
            "verseOrgIds": [
              "PSA.146.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 146:9"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.9",
            "verseOrgIds": [
              "PSA.146.9"
            ]
          }
        },
        {
          "text": "el camino de los impíos trastorna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.9",
            "verseOrgIds": [
              "PSA.146.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 146:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reinará Jehová para siempre;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.10",
            "verseOrgIds": [
              "PSA.146.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 146:10"
      },
      "items": [
        {
          "text": "Tu Dios, oh Sión, por generación y generación.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.10",
            "verseOrgIds": [
              "PSA.146.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 146:10"
      },
      "items": [
        {
          "text": "Aleluya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.10",
            "verseOrgIds": [
              "PSA.146.10"
            ]
          }
        }
      ]
    }
  ],
