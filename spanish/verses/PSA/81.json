{
  "id": "PSA.81",
  "number": "81",
  "bookId": "PSA",
  "reference": "Salmos 81",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "81",
        "style": "c",
        "sid": "PSA 81"
      },
      "items": [
        {
          "text": "81",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: sobre Gittith: Salmo de Asaph.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 81:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "CANTAD á Dios, fortaleza nuestra:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.1",
            "verseOrgIds": [
              "PSA.81.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:1"
      },
      "items": [
        {
          "text": "Al Dios de Jacob",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.1",
            "verseOrgIds": [
              "PSA.81.2"
            ]
          }
        },
        {
          "text": "celebrad con júbilo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.1",
            "verseOrgIds": [
              "PSA.81.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 81:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomad la canción, y tañed el adufe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.2",
            "verseOrgIds": [
              "PSA.81.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:2"
      },
      "items": [
        {
          "text": "El arpa deliciosa con el salterio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.2",
            "verseOrgIds": [
              "PSA.81.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 81:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tocad la",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.3",
            "verseOrgIds": [
              "PSA.81.4"
            ]
          }
        },
        {
          "text": "trompeta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.3",
            "verseOrgIds": [
              "PSA.81.4"
            ]
          }
        },
        {
          "text": "en la nueva luna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.3",
            "verseOrgIds": [
              "PSA.81.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:3"
      },
      "items": [
        {
          "text": "En el día señalado, en el día de nuestra solemnidad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.3",
            "verseOrgIds": [
              "PSA.81.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 81:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque estatuto es de Israel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.4",
            "verseOrgIds": [
              "PSA.81.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:4"
      },
      "items": [
        {
          "text": "Ordenanza del Dios de Jacob.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.4",
            "verseOrgIds": [
              "PSA.81.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 81:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por testimonio",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        },
        {
          "text": "en José lo ha constituído,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:5"
      },
      "items": [
        {
          "text": "Cuando salió por la tierra de Egipto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Donde",
              "type": "text",
              "attrs": {
                "verseId": "PSA.81.5",
                "verseOrgIds": [
                  "PSA.81.6"
                ]
              }
            }
          ]
        },
        {
          "text": "oí lenguaje que no entendía.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 81:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aparté su hombro de debajo de la carga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.6",
            "verseOrgIds": [
              "PSA.81.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:6"
      },
      "items": [
        {
          "text": "Sus manos se quitaron de vasijas de barro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.6",
            "verseOrgIds": [
              "PSA.81.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 81:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "En la calamidad clamaste, y yo te libré:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:7"
      },
      "items": [
        {
          "text": "Te respondí en el secreto del trueno;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:7"
      },
      "items": [
        {
          "text": "Te probé sobre las aguas de Meriba. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 81:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oye, pueblo mío y te protestaré.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.8",
            "verseOrgIds": [
              "PSA.81.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:8"
      },
      "items": [
        {
          "text": "Israel, si me oyeres,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.8",
            "verseOrgIds": [
              "PSA.81.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 81:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "No habrá en ti dios ajeno,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.9",
            "verseOrgIds": [
              "PSA.81.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:9"
      },
      "items": [
        {
          "text": "Ni te encorvarás á dios extraño.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.9",
            "verseOrgIds": [
              "PSA.81.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 81:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo soy Jehová tu Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:10"
      },
      "items": [
        {
          "text": "Que te hice subir de la tierra de Egipto:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:10"
      },
      "items": [
        {
          "text": "Ensancha tu boca, y henchirla he.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 81:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas mi pueblo no oyó mi voz,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.11",
            "verseOrgIds": [
              "PSA.81.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:11"
      },
      "items": [
        {
          "text": "E Israel",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.11",
            "verseOrgIds": [
              "PSA.81.12"
            ]
          }
        },
        {
          "text": "no me quiso á mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.11",
            "verseOrgIds": [
              "PSA.81.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 81:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dejélos por tanto á la dureza de su corazón:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.12",
            "verseOrgIds": [
              "PSA.81.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:12"
      },
      "items": [
        {
          "text": "Caminaron en sus consejos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.12",
            "verseOrgIds": [
              "PSA.81.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 81:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "¡Oh, si me hubiera oído mi pueblo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.13",
            "verseOrgIds": [
              "PSA.81.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:13"
      },
      "items": [
        {
          "text": "Si en mis caminos hubiera Israel andado!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.13",
            "verseOrgIds": [
              "PSA.81.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 81:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "En una nada habría yo derribado sus enemigos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.14",
            "verseOrgIds": [
              "PSA.81.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:14"
      },
      "items": [
        {
          "text": "Y vuelto mi mano sobre sus adversarios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.14",
            "verseOrgIds": [
              "PSA.81.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 81:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los aborrecedores de Jehová se le hubieran sometido;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.15",
            "verseOrgIds": [
              "PSA.81.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:15"
      },
      "items": [
        {
          "text": "Y el tiempo de ellos fuera para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.15",
            "verseOrgIds": [
              "PSA.81.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 81:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Y Dios",
              "type": "text",
              "attrs": {
                "verseId": "PSA.81.16",
                "verseOrgIds": [
                  "PSA.81.17"
                ]
              }
            }
          ]
        },
        {
          "text": "lo hubiera mantenido de grosura de trigo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.16",
            "verseOrgIds": [
              "PSA.81.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 81:16"
      },
      "items": [
        {
          "text": "Y de miel de la piedra te hubiera saciado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.16",
            "verseOrgIds": [
              "PSA.81.17"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.82",
    "number": "82",
    "bookId": "PSA"
  },
  "previous": {
    "id": "PSA.80",
    "number": "80",
    "bookId": "PSA"
  }
}