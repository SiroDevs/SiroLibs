{
  "id": "PSA.140",
  "number": "140",
  "bookId": "PSA",
  "reference": "Salmos 140",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "140",
        "style": "c",
        "sid": "PSA 140"
      },
      "items": [
        {
          "text": "140",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 140:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "LÍBRAME, oh Jehová, de hombre malo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.1",
            "verseOrgIds": [
              "PSA.140.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:1"
      },
      "items": [
        {
          "text": "Guárdame de hombre violento;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.1",
            "verseOrgIds": [
              "PSA.140.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 140:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los cuales maquinan males en el corazón,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.2",
            "verseOrgIds": [
              "PSA.140.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:2"
      },
      "items": [
        {
          "text": "Cada día urden contiendas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.2",
            "verseOrgIds": [
              "PSA.140.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 140:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aguzaron su lengua como la serpiente;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.3",
            "verseOrgIds": [
              "PSA.140.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:3"
      },
      "items": [
        {
          "text": "Veneno de áspid hay debajo de sus labios. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.3",
            "verseOrgIds": [
              "PSA.140.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 140:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guárdame, oh Jehová, de manos del impío,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.4",
            "verseOrgIds": [
              "PSA.140.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:4"
      },
      "items": [
        {
          "text": "Presérvame del hombre injurioso;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.4",
            "verseOrgIds": [
              "PSA.140.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:4"
      },
      "items": [
        {
          "text": "Que han pensado de trastornar mis pasos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.4",
            "verseOrgIds": [
              "PSA.140.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 140:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanme escondido lazo y cuerdas los soberbios;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.5",
            "verseOrgIds": [
              "PSA.140.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:5"
      },
      "items": [
        {
          "text": "Han tendido red junto á la senda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.5",
            "verseOrgIds": [
              "PSA.140.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:5"
      },
      "items": [
        {
          "text": "Me han puesto lazos. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.5",
            "verseOrgIds": [
              "PSA.140.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 140:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "He dicho á Jehová: Dios mío eres tú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.6",
            "verseOrgIds": [
              "PSA.140.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:6"
      },
      "items": [
        {
          "text": "Escucha, oh Jehová, la voz de mis ruegos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.6",
            "verseOrgIds": [
              "PSA.140.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 140:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová Señor, fortaleza de mi salud,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.7",
            "verseOrgIds": [
              "PSA.140.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:7"
      },
      "items": [
        {
          "text": "Tú pusiste á cubierto mi cabeza el día de las armas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.7",
            "verseOrgIds": [
              "PSA.140.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 140:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "No des, oh Jehová, al impío sus deseos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.8",
            "verseOrgIds": [
              "PSA.140.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:8"
      },
      "items": [
        {
          "text": "No saques adelante su pensamiento,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.8",
            "verseOrgIds": [
              "PSA.140.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "que no",
              "type": "text",
              "attrs": {
                "verseId": "PSA.140.8",
                "verseOrgIds": [
                  "PSA.140.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.8",
            "verseOrgIds": [
              "PSA.140.9"
            ]
          }
        },
        {
          "text": "se ensoberbezca. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.8",
            "verseOrgIds": [
              "PSA.140.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 140:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "En cuanto á los que por todas partes me rodean,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.9",
            "verseOrgIds": [
              "PSA.140.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:9"
      },
      "items": [
        {
          "text": "La maldad de sus propios labios cubrirá su cabeza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.9",
            "verseOrgIds": [
              "PSA.140.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 140:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Caerán sobre ellos brasas;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.10",
            "verseOrgIds": [
              "PSA.140.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Dios",
              "type": "text",
              "attrs": {
                "verseId": "PSA.140.10",
                "verseOrgIds": [
                  "PSA.140.11"
                ]
              }
            }
          ]
        },
        {
          "text": "los hará caer en el fuego,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.10",
            "verseOrgIds": [
              "PSA.140.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:10"
      },
      "items": [
        {
          "text": "En profundos hoyos de donde no salgan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.10",
            "verseOrgIds": [
              "PSA.140.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 140:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hombre deslenguado no será firme en la tierra:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.11",
            "verseOrgIds": [
              "PSA.140.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:11"
      },
      "items": [
        {
          "text": "El mal cazará al hombre injusto para derribarle.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.11",
            "verseOrgIds": [
              "PSA.140.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 140:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo sé que",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.12",
            "verseOrgIds": [
              "PSA.140.13"
            ]
          }
        },
        {
          "text": "hará Jehová el juicio del afligido,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.12",
            "verseOrgIds": [
              "PSA.140.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:12"
      },
      "items": [
        {
          "text": "El juicio de los menesterosos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.12",
            "verseOrgIds": [
              "PSA.140.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 140:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciertamente los justos alabarán tu nombre;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.13",
            "verseOrgIds": [
              "PSA.140.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 140:13"
      },
      "items": [
        {
          "text": "Los rectos morarán en tu presencia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.13",
            "verseOrgIds": [
              "PSA.140.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.141",
    "number": "141",
    "bookId": "PSA"
  },
