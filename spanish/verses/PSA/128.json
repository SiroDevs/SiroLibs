            "sid": "PSA 128:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "BIENAVENTURADO",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.1",
            "verseOrgIds": [
              "PSA.128.1"
            ]
          }
        },
        {
          "text": "todo aquel que teme á Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.1",
            "verseOrgIds": [
              "PSA.128.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 128:1"
      },
      "items": [
        {
          "text": "Que anda en sus caminos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.1",
            "verseOrgIds": [
              "PSA.128.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 128:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando comieres el trabajo de tus manos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.2",
            "verseOrgIds": [
              "PSA.128.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 128:2"
      },
      "items": [
        {
          "text": "Bienaventurado tú, y tendrás bien.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.2",
            "verseOrgIds": [
              "PSA.128.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 128:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tu mujer será",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        },
        {
          "text": "como parra que lleva fruto á los lados de tu casa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 128:3"
      },
      "items": [
        {
          "text": "Tus hijos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        },
        {
          "text": "como plantas de olivas alrededor de tu mesa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 128:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí que así será bendito el hombre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.4",
            "verseOrgIds": [
              "PSA.128.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 128:4"
      },
      "items": [
        {
          "text": "Que teme á Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.4",
            "verseOrgIds": [
              "PSA.128.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 128:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bendígate Jehová desde Sión,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.5",
            "verseOrgIds": [
              "PSA.128.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 128:5"
      },
      "items": [
        {
          "text": "Y veas el bien de Jerusalem todos los días de tu vida.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.5",
            "verseOrgIds": [
              "PSA.128.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 128:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y veas los hijos de tus hijos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.6",
            "verseOrgIds": [
              "PSA.128.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 128:6"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.6",
            "verseOrgIds": [
              "PSA.128.6"
            ]
          }
        },
        {
          "text": "la paz sobre Israel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.6",
            "verseOrgIds": [
              "PSA.128.6"
            ]
          }
        }
      ]
    }
