{
  "id": "PSA.143",
  "number": "143",
  "bookId": "PSA",
  "reference": "Salmos 143",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "143",
        "style": "c",
        "sid": "PSA 143"
      },
      "items": [
        {
          "text": "143",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 143:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OH Jehová, oye mi oración, escucha mis ruegos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:1"
      },
      "items": [
        {
          "text": "Respóndeme por tu verdad, por tu justicia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 143:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y no entres en juicio con tu siervo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.2",
            "verseOrgIds": [
              "PSA.143.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:2"
      },
      "items": [
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.2",
            "verseOrgIds": [
              "PSA.143.2"
            ]
          }
        },
        {
          "text": "no se justificará delante de ti ningún viviente.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.2",
            "verseOrgIds": [
              "PSA.143.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 143:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque ha perseguido el enemigo mi alma;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:3"
      },
      "items": [
        {
          "text": "Ha postrado en tierra mi vida;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:3"
      },
      "items": [
        {
          "text": "Hame hecho habitar",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        },
        {
          "text": "en tinieblas como los ya muertos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 143:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y mi espíritu se angustió dentro de mí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.4",
            "verseOrgIds": [
              "PSA.143.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:4"
      },
      "items": [
        {
          "text": "Pasmóse mi corazón.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.4",
            "verseOrgIds": [
              "PSA.143.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 143:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acordéme de los días antiguos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.5",
            "verseOrgIds": [
              "PSA.143.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:5"
      },
      "items": [
        {
          "text": "Meditaba en todas tus obras,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.5",
            "verseOrgIds": [
              "PSA.143.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:5"
      },
      "items": [
        {
          "text": "Reflexionaba en las obras de tus manos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.5",
            "verseOrgIds": [
              "PSA.143.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 143:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Extendí mis manos á ti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.6",
            "verseOrgIds": [
              "PSA.143.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:6"
      },
      "items": [
        {
          "text": "Mi alma á ti como la tierra sedienta. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.6",
            "verseOrgIds": [
              "PSA.143.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 143:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Respóndeme presto, oh Jehová que desmaya mi espíritu:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "No escondas de mí tu rostro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "Y venga yo á ser semejante á los que descienden á la sepultura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 143:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazme oir",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        },
        {
          "text": "por la mañana tu misericordia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "Porque en ti he confiado:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "Hazme saber el camino por donde ande,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "Porque á ti he alzado mi alma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 143:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Líbrame de mis enemigos, oh Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.9",
            "verseOrgIds": [
              "PSA.143.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:9"
      },
      "items": [
        {
          "text": "A ti me acojo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.9",
            "verseOrgIds": [
              "PSA.143.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 143:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enséñame á hacer tu voluntad, porque tú eres mi Dios:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:10"
      },
      "items": [
        {
          "text": "Tu buen espíritu me guíe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        },
        {
          "text": "a tierra de rectitud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Acciones de gracias.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 \"Ensalzarte he, mi Dios.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 143:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por tu nombre, oh Jehová me vivificarás:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.11",
            "verseOrgIds": [
              "PSA.143.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:11"
      },
      "items": [
        {
          "text": "Por tu justicia, sacarás mi alma de angustia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.11",
            "verseOrgIds": [
              "PSA.143.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 143:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y por tu misericordia",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.12",
            "verseOrgIds": [
              "PSA.143.12"
            ]
          }
        },
        {
          "text": "disiparás mis enemigos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.12",
            "verseOrgIds": [
              "PSA.143.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:12"
      },
      "items": [
        {
          "text": "Y destruirás todos los adversarios de mi alma:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.12",
            "verseOrgIds": [
              "PSA.143.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 143:12"
      },
      "items": [
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.12",
            "verseOrgIds": [
              "PSA.143.12"
            ]
          }
        },
        {
          "text": "yo soy tu siervo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.12",
            "verseOrgIds": [
              "PSA.143.12"
            ]
          }
        }
      ]
    }
  ],
