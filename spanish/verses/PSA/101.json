{
  "id": "PSA.101",
  "number": "101",
  "bookId": "PSA",
  "reference": "Salmos 101",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "101",
        "style": "c",
        "sid": "PSA 101"
      },
      "items": [
        {
          "text": "101",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 101:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MISERICORDIA y juicio cantaré:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.1",
            "verseOrgIds": [
              "PSA.101.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 101:1"
      },
      "items": [
        {
          "text": "A ti cantaré yo, oh Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.1",
            "verseOrgIds": [
              "PSA.101.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 101:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entenderé en el camino de la perfección",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 101:2"
      },
      "items": [
        {
          "text": "Cuando vinieres á mí:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 101:2"
      },
      "items": [
        {
          "text": "En integridad de mi corazón andaré en medio de mi casa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 101:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "No pondré delante de mis ojos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        },
        {
          "text": "cosa injusta:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 101:3"
      },
      "items": [
        {
          "text": "Aborrezco la obra de los que se desvían:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 101:3"
      },
      "items": [
        {
          "text": "Ninguno",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "de ellos",
              "type": "text",
              "attrs": {
                "verseId": "PSA.101.3",
                "verseOrgIds": [
                  "PSA.101.3"
                ]
              }
            }
          ]
        },
        {
          "text": "se allegará á mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 101:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Corazón perverso se apartará de mí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.4",
            "verseOrgIds": [
              "PSA.101.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 101:4"
      },
      "items": [
        {
          "text": "No conoceré al malvado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.4",
            "verseOrgIds": [
              "PSA.101.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Oración del afligido",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 por los males de Sión.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 101:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al que solapadamente infama á su prójimo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        },
        {
          "text": "yo le cortaré;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 101:5"
      },
      "items": [
        {
          "text": "No sufriré al de ojos altaneros, y de corazón vanidoso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 101:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mis ojos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "pondré",
              "type": "text",
              "attrs": {
                "verseId": "PSA.101.6",
                "verseOrgIds": [
                  "PSA.101.6"
                ]
              }
            }
          ]
        },
        {
          "text": "en los fieles de la tierra, para que estén conmigo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 101:6"
      },
      "items": [
        {
          "text": "El que anduviere en el camino de la perfección, éste me servirá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 101:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "No habitará dentro de mi casa el que hace fraude:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 101:7"
      },
      "items": [
        {
          "text": "El que habla mentiras no se afirmará delante de mis ojos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 101:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por las mañanas cortaré á todos los impíos de la tierra;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 101:8"
      },
      "items": [
        {
          "text": "Para extirpar",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        },
        {
          "text": "de la ciudad de Jehová á todos los que obraren iniquidad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.102",
