      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:5"
      },
      "items": [
        {
          "text": "Y respondióme JAH,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.5",
            "verseOrgIds": [
              "PSA.118.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "poniéndome",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.5",
                "verseOrgIds": [
                  "PSA.118.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.5",
            "verseOrgIds": [
              "PSA.118.5"
            ]
          }
        },
        {
          "text": "en anchura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.5",
            "verseOrgIds": [
              "PSA.118.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 La piedra angular.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 La ley de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 118:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová está por mí:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.6",
            "verseOrgIds": [
              "PSA.118.6"
            ]
          }
        },
        {
          "text": "no temeré",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.6",
            "verseOrgIds": [
              "PSA.118.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:6"
      },
      "items": [
        {
          "text": "Lo que me pueda hacer el hombre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.6",
            "verseOrgIds": [
              "PSA.118.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 118:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová está por mí entre los que me ayudan:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.7",
            "verseOrgIds": [
              "PSA.118.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:7"
      },
      "items": [
        {
          "text": "Por tanto yo veré",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.7",
            "verseOrgIds": [
              "PSA.118.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "mi deseo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.7",
                "verseOrgIds": [
                  "PSA.118.7"
                ]
              }
            }
          ]
        },
        {
          "text": "en los que me aborrecen.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.7",
            "verseOrgIds": [
              "PSA.118.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 118:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mejor es esperar en Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.8",
            "verseOrgIds": [
              "PSA.118.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:8"
      },
      "items": [
        {
          "text": "Que esperar en hombre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.8",
            "verseOrgIds": [
              "PSA.118.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 118:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mejor es esperar en Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.9",
            "verseOrgIds": [
              "PSA.118.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:9"
      },
      "items": [
        {
          "text": "Que esperar en príncipes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.9",
            "verseOrgIds": [
              "PSA.118.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 118:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todas las gentes me cercaron:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.10",
            "verseOrgIds": [
              "PSA.118.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:10"
      },
      "items": [
        {
          "text": "En nombre de Jehová, que yo los romperé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.10",
            "verseOrgIds": [
              "PSA.118.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 118:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cercáronme y asediáronme:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.11",
            "verseOrgIds": [
              "PSA.118.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:11"
      },
      "items": [
        {
          "text": "En nombre de Jehová, que yo los romperé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.11",
            "verseOrgIds": [
              "PSA.118.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 118:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cercáronme como abejas;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.12",
            "verseOrgIds": [
              "PSA.118.12"
            ]
          }
        },
        {
          "text": "fueron apagados como",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.12",
            "verseOrgIds": [
              "PSA.118.12"
            ]
          }
        },
        {
          "text": "fuegos de espinos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.12",
            "verseOrgIds": [
              "PSA.118.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:12"
      },
      "items": [
        {
          "text": "En nombre de Jehová, que yo los romperé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.12",
            "verseOrgIds": [
              "PSA.118.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 118:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empujásteme con violencia para que cayese:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.13",
            "verseOrgIds": [
              "PSA.118.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:13"
      },
      "items": [
        {
          "text": "Empero ayudóme Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.13",
            "verseOrgIds": [
              "PSA.118.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 118:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi fortaleza y mi canción es JAH;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.14",
            "verseOrgIds": [
              "PSA.118.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:14"
      },
      "items": [
        {
          "text": "Y él me ha sido por salud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.14",
            "verseOrgIds": [
              "PSA.118.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 118:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voz de júbilo y de salvación hay en las tiendas de los justos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.15",
            "verseOrgIds": [
              "PSA.118.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:15"
      },
      "items": [
        {
          "text": "La diestra de Jehová hace proezas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.15",
            "verseOrgIds": [
              "PSA.118.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 118:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "La diestra de Jehová sublime:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.16",
            "verseOrgIds": [
              "PSA.118.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:16"
      },
      "items": [
        {
          "text": "La diestra de Jehová hace valentías.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.16",
            "verseOrgIds": [
              "PSA.118.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 118:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "No moriré, sino que viviré,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.17",
            "verseOrgIds": [
              "PSA.118.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:17"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.17",
            "verseOrgIds": [
              "PSA.118.17"
            ]
          }
        },
        {
          "text": "contaré las obras de JAH.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.17",
            "verseOrgIds": [
              "PSA.118.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 118:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Castigóme gravemente JAH:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.18",
            "verseOrgIds": [
              "PSA.118.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:18"
      },
      "items": [
        {
          "text": "Mas no me entregó á la muerte.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.18",
            "verseOrgIds": [
              "PSA.118.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 118:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abridme las puertas de la justicia:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.19",
            "verseOrgIds": [
              "PSA.118.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:19"
      },
      "items": [
        {
          "text": "Entraré por ellas, alabaré á JAH.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.19",
            "verseOrgIds": [
              "PSA.118.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 118:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esta puerta de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.20",
            "verseOrgIds": [
              "PSA.118.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:20"
      },
      "items": [
        {
          "text": "Por ella entrarán los justos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.20",
            "verseOrgIds": [
              "PSA.118.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 118:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te alabaré porque me has oído,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.21",
            "verseOrgIds": [
              "PSA.118.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:21"
      },
      "items": [
        {
          "text": "Y me fuiste por salud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.21",
            "verseOrgIds": [
              "PSA.118.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 118:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "La piedra que desecharon los edificadores,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.22",
            "verseOrgIds": [
              "PSA.118.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:22"
      },
      "items": [
        {
          "text": "Ha venido á ser cabeza del ángulo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.22",
            "verseOrgIds": [
              "PSA.118.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 118:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "De parte de Jehová es esto:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.23",
            "verseOrgIds": [
              "PSA.118.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:23"
      },
      "items": [
        {
          "text": "Es maravilla en nuestros ojos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.23",
            "verseOrgIds": [
              "PSA.118.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 118:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Este es el día que hizo Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.24",
            "verseOrgIds": [
              "PSA.118.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:24"
      },
      "items": [
        {
          "text": "Nos gozaremos y alegraremos en él.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.24",
            "verseOrgIds": [
              "PSA.118.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 118:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Jehová, salva ahora, te ruego:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.25",
            "verseOrgIds": [
              "PSA.118.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:25"
      },
      "items": [
        {
          "text": "Oh Jehová, ruégote hagas prosperar ahora.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.25",
            "verseOrgIds": [
              "PSA.118.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 118:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bendito el que viene en nombre de Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.26",
            "verseOrgIds": [
              "PSA.118.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:26"
      },
      "items": [
        {
          "text": "Desde la casa de Jehová os bendecimos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.26",
            "verseOrgIds": [
              "PSA.118.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PSA 118:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dios es Jehová que nos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.27",
            "verseOrgIds": [
              "PSA.118.27"
            ]
          }
        },
        {
          "text": "ha resplandecido:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.27",
            "verseOrgIds": [
              "PSA.118.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:27"
      },
      "items": [
        {
          "text": "Atad víctimas con cuerdas á los",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.27",
            "verseOrgIds": [
              "PSA.118.27"
            ]
          }
        },
        {
          "text": "cuernos del altar.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.27",
            "verseOrgIds": [
              "PSA.118.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 118:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi Dios eres tú, y á ti alabaré:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.28",
            "verseOrgIds": [
              "PSA.118.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:28"
      },
      "items": [
        {
          "text": "Dios mío, á ti ensalzaré.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.28",
            "verseOrgIds": [
              "PSA.118.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PSA 118:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alabad á Jehová porque es bueno;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.29",
            "verseOrgIds": [
              "PSA.118.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 118:29"
      },
      "items": [
        {
          "text": "Porque para siempre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.29",
            "verseOrgIds": [
              "PSA.118.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.29",
                "verseOrgIds": [
                  "PSA.118.29"
                ]
              }
            }
          ]
        },
        {
          "text": "su misericordia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.29",
            "verseOrgIds": [
              "PSA.118.29"
            ]
          }
        }
      ]
    }
