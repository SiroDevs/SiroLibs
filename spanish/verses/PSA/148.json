  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "148",
        "style": "c",
        "sid": "PSA 148"
      },
      "items": [
        {
          "text": "148",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Aleluya.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 148:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ALABAD á Jehová desde los cielos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.1",
            "verseOrgIds": [
              "PSA.148.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:1"
      },
      "items": [
        {
          "text": "Alabadle en las alturas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.1",
            "verseOrgIds": [
              "PSA.148.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 148:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alabadle, vosotros todos sus ángeles:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.2",
            "verseOrgIds": [
              "PSA.148.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:2"
      },
      "items": [
        {
          "text": "Alabadle, vosotros todos sus ejércitos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.2",
            "verseOrgIds": [
              "PSA.148.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 148:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alabadle, sol y luna:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.3",
            "verseOrgIds": [
              "PSA.148.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:3"
      },
      "items": [
        {
          "text": "Alabadle, vosotras todas, lucientes estrellas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.3",
            "verseOrgIds": [
              "PSA.148.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 148:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alabadle, cielos de los cielos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.4",
            "verseOrgIds": [
              "PSA.148.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:4"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.4",
            "verseOrgIds": [
              "PSA.148.4"
            ]
          }
        },
        {
          "text": "las aguas que están sobre los cielos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.4",
            "verseOrgIds": [
              "PSA.148.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 148:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alaben el nombre de Jehová;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.5",
            "verseOrgIds": [
              "PSA.148.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:5"
      },
      "items": [
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.5",
            "verseOrgIds": [
              "PSA.148.5"
            ]
          }
        },
        {
          "text": "él mandó, y fueron criadas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.5",
            "verseOrgIds": [
              "PSA.148.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 148:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y las hizo ser para siempre por los siglos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.6",
            "verseOrgIds": [
              "PSA.148.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:6"
      },
      "items": [
        {
          "text": "Púso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.6",
            "verseOrgIds": [
              "PSA.148.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "les",
              "type": "text",
              "attrs": {
                "verseId": "PSA.148.6",
                "verseOrgIds": [
                  "PSA.148.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ley que no será quebrantada.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.6",
            "verseOrgIds": [
              "PSA.148.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 148:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alabad á Jehová, de la tierra",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.7",
            "verseOrgIds": [
              "PSA.148.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:7"
      },
      "items": [
        {
          "text": "Los dragones y todos los abismos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.7",
            "verseOrgIds": [
              "PSA.148.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 148:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "El fuego y el granizo, la nieve y el vapor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.8",
            "verseOrgIds": [
              "PSA.148.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:8"
      },
      "items": [
        {
          "text": "El viento de tempestad que",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.8",
            "verseOrgIds": [
              "PSA.148.8"
            ]
          }
        },
        {
          "text": "ejecuta su palabra;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.8",
            "verseOrgIds": [
              "PSA.148.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 148:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los montes y todos los collados;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.9",
            "verseOrgIds": [
              "PSA.148.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:9"
      },
      "items": [
        {
          "text": "El árbol de fruto, y todos los cedros;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.9",
            "verseOrgIds": [
              "PSA.148.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 148:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "La bestia y todo animal;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.10",
            "verseOrgIds": [
              "PSA.148.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:10"
      },
      "items": [
        {
          "text": "Reptiles y volátiles;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.10",
            "verseOrgIds": [
              "PSA.148.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 148:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los reyes de la tierra y todos los pueblos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.11",
            "verseOrgIds": [
              "PSA.148.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:11"
      },
      "items": [
        {
          "text": "Los príncipes y todos los jueces de la tierra;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.11",
            "verseOrgIds": [
              "PSA.148.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 148:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los mancebos y también las doncellas;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.12",
            "verseOrgIds": [
              "PSA.148.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:12"
      },
      "items": [
        {
          "text": "Los viejos y los niños,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.12",
            "verseOrgIds": [
              "PSA.148.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 148:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alaben el nombre de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.13",
            "verseOrgIds": [
              "PSA.148.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:13"
      },
      "items": [
        {
          "text": "Porque sólo su nombre es elevado;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.13",
            "verseOrgIds": [
              "PSA.148.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:13"
      },
      "items": [
        {
          "text": "Su gloria es sobre tierra y cielos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.13",
            "verseOrgIds": [
              "PSA.148.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 148:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "El ensalzó el cuerno de su pueblo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:14"
      },
      "items": [
        {
          "text": "Aláben",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "le",
              "type": "text",
              "attrs": {
                "verseId": "PSA.148.14",
                "verseOrgIds": [
                  "PSA.148.14"
                ]
              }
            }
          ]
        },
        {
          "text": "todos sus santos, los hijos de Israel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:14"
      },
      "items": [
        {
          "text": "El pueblo á él cercano.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 148:14"
      },
      "items": [
        {
          "text": "Aleluya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        }
      ]
    }
  ],
