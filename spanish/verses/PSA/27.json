{
  "id": "PSA.27",
  "number": "27",
  "bookId": "PSA",
  "reference": "Salmos 27",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "PSA 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "JEHOVÁ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        },
        {
          "text": "es mi luz y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        },
        {
          "text": "mi salvación: ¿de quién temeré?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:1"
      },
      "items": [
        {
          "text": "Jehová es la fortaleza de mi vida: ¿de quién he de atemorizarme?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando se allegaron contra mí los malignos, mis angustiadores y mis enemigos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:2"
      },
      "items": [
        {
          "text": "Para comer mis carnes, ellos tropezaron y cayeron.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aunque se asiente campo contra mí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "No temerá mi corazón:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "Aunque contra mí se levante guerra,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "Yo en esto confío.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Una cosa he demandado á Jehová, ésta buscaré:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "Que esté yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        },
        {
          "text": "en la casa de Jehová todos los días de mi vida,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "Para contemplar",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        },
        {
          "text": "la hermosura de Jehová, y para inquirir en su templo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque él me esconderá en su tabernáculo en el día del mal;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:5"
      },
      "items": [
        {
          "text": "Ocultaráme en lo reservado de su pabellón;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:5"
      },
      "items": [
        {
          "text": "Pondráme en alto sobre una roca.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y luego ensalzará",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        },
        {
          "text": "mi cabeza sobre mis enemigos en derredor de mí:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "Y yo sacrificaré en su tabernáculo sacrificios de júbilo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "Cantaré y salmearé á Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oye, oh Jehová, mi voz",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.7",
            "verseOrgIds": [
              "PSA.27.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "con que á ti",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.7",
                "verseOrgIds": [
                  "PSA.27.7"
                ]
              }
            }
          ]
        },
        {
          "text": "clamo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.7",
            "verseOrgIds": [
              "PSA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:7"
      },
      "items": [
        {
          "text": "Y ten misericordia de mí, respóndeme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.7",
            "verseOrgIds": [
              "PSA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi corazón ha dicho de ti:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.8",
            "verseOrgIds": [
              "PSA.27.8"
            ]
          }
        },
        {
          "text": "Buscad mi rostro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.8",
            "verseOrgIds": [
              "PSA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:8"
      },
      "items": [
        {
          "text": "Tu rostro buscaré, oh Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.8",
            "verseOrgIds": [
              "PSA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "No escondas tu rostro de mí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:9"
      },
      "items": [
        {
          "text": "No apartes con ira á tu siervo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:9"
      },
      "items": [
        {
          "text": "Mi ayuda has sido;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:9"
      },
      "items": [
        {
          "text": "No me dejes y no me desampares,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        },
        {
          "text": "Dios de mi salud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aunque mi padre y mi madre me dejaran,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.10",
            "verseOrgIds": [
              "PSA.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:10"
      },
      "items": [
        {
          "text": "Jehová con todo me recogerá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.10",
            "verseOrgIds": [
              "PSA.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enséñame, oh Jehová, tu camino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.11",
            "verseOrgIds": [
              "PSA.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:11"
      },
      "items": [
        {
          "text": "Y guíame por senda de rectitud,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.11",
            "verseOrgIds": [
              "PSA.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:11"
      },
      "items": [
        {
          "text": "A causa de mis enemigos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.11",
            "verseOrgIds": [
              "PSA.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "No me entregues á la voluntad de mis enemigos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.12",
            "verseOrgIds": [
              "PSA.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:12"
      },
      "items": [
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.12",
            "verseOrgIds": [
              "PSA.27.12"
            ]
          }
        },
        {
          "text": "se han levantado contra mí testigos falsos, y los que",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.12",
            "verseOrgIds": [
              "PSA.27.12"
            ]
          }
        },
        {
          "text": "respiran crueldad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.12",
            "verseOrgIds": [
              "PSA.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Hubiera yo desmayado,",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.13",
                "verseOrgIds": [
                  "PSA.27.13"
                ]
              }
            }
          ]
        },
        {
          "text": "si no creyese que tengo de ver la bondad de Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.13",
            "verseOrgIds": [
              "PSA.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 27:13"
      },
      "items": [
        {
          "text": "En la tierra de los vivientes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.13",
            "verseOrgIds": [
              "PSA.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aguarda á Jehová;",
          "type": "text",
