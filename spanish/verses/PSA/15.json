  "reference": "Salmos 15",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 5,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "PSA 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "JEHOVÁ, ¿quién habitará en tu tabernáculo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.1",
            "verseOrgIds": [
              "PSA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 15:1"
      },
      "items": [
        {
          "text": "¿Quién residirá en el",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.1",
            "verseOrgIds": [
              "PSA.15.1"
            ]
          }
        },
        {
          "text": "monte de tu santidad?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.1",
            "verseOrgIds": [
              "PSA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que anda en integridad, y obra justicia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.2",
            "verseOrgIds": [
              "PSA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 15:2"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.2",
            "verseOrgIds": [
              "PSA.15.2"
            ]
          }
        },
        {
          "text": "habla verdad en su corazón.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.2",
            "verseOrgIds": [
              "PSA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que no detrae con su lengua,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.3",
            "verseOrgIds": [
              "PSA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 15:3"
      },
      "items": [
        {
          "text": "Ni hace mal á su prójimo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.3",
            "verseOrgIds": [
              "PSA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 15:3"
      },
      "items": [
        {
          "text": "Ni contra su prójimo acoge oprobio alguno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.3",
            "verseOrgIds": [
              "PSA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aquel á cuyos ojos es menospreciado el vil;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 15:4"
      },
      "items": [
        {
          "text": "Mas honra á los que temen á Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 15:4"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        },
        {
          "text": "habiendo jurado en daño suyo, no por eso muda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Quien su dinero no dió á usura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.5",
            "verseOrgIds": [
              "PSA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 15:5"
      },
      "items": [
        {
          "text": "Ni contra el inocente tomó cohecho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.5",
            "verseOrgIds": [
              "PSA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 15:5"
      },
      "items": [
        {
          "text": "El que hace estas cosas, no resbalará para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.5",
            "verseOrgIds": [
              "PSA.15.5"
            ]
          }
        }
      ]
    }
  ],
