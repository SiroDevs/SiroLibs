          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que deshago las señales de los adivinos, y",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.25",
            "verseOrgIds": [
              "ISA.44.25"
            ]
          }
        },
        {
          "text": "enloquezco á los agoreros; que hago tornar atrás los sabios, y",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.25",
            "verseOrgIds": [
              "ISA.44.25"
            ]
          }
        },
        {
          "text": "desvanezco su sabiduría;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.25",
            "verseOrgIds": [
              "ISA.44.25"
            ]
          }
        }
      ]
    },
