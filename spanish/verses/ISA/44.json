          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que despierta la palabra de",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.26",
            "verseOrgIds": [
              "ISA.44.26"
            ]
          }
        },
        {
          "text": "su siervo, y cumple el consejo de sus mensajeros; que dice á Jerusalem: Serás habitada; y á las ciudades de Judá: Reedificadas serán, y sus ruinas levantaré;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.26",
            "verseOrgIds": [
              "ISA.44.26"
            ]
          }
        }
      ]
