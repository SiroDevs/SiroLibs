          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Así dice Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        },
        {
          "text": "tu Redentor, y",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        },
        {
          "text": "formador tuyo desde el vientre: Yo Jehová, que lo hago todo, que extiendo solo los cielos, que extiendo la tierra por mí mismo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        }
      ]
    },
    {
