          "text": "Y alzará pendón",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.26",
            "verseOrgIds": [
              "ISA.5.26"
            ]
          }
        },
        {
          "text": "a gentes de lejos, y",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.26",
            "verseOrgIds": [
              "ISA.5.26"
            ]
          }
        },
        {
          "text": "silbará al",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.26",
            "verseOrgIds": [
              "ISA.5.26"
            ]
          }
        },
        {
          "name": "char",
