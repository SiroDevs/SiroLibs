            "style": "add"
          },
          "items": [
            {
              "text": "se la",
              "type": "text",
              "attrs": {
                "verseId": "ISA.5.29",
                "verseOrgIds": [
                  "ISA.5.29"
                ]
              }
            }
          ]
        },
        {
          "text": "quitará.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.29",
            "verseOrgIds": [
