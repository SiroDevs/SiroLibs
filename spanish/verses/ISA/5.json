              "ISA.5.23"
            ]
          }
        },
        {
          "text": "por cohechos, y al justo quitan su justicia!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.23",
            "verseOrgIds": [
              "ISA.5.23"
            ]
          }
        }
      ]
