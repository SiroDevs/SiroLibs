              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí, yo estoy á la puerta y",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.20",
            "verseOrgIds": [
              "REV.3.20"
            ]
          }
        },
        {
          "text": "llamo: si alguno oyere mi voz y abriere la puerta,",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.20",
            "verseOrgIds": [
              "REV.3.20"
            ]
          }
        },
        {
          "text": "entraré á él, y cenaré con él, y él conmigo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.20",
            "verseOrgIds": [
              "REV.3.20"
            ]
          }
        }
      ]
