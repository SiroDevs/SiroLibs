        },
        {
          "text": "Yo reprendo",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.19",
            "verseOrgIds": [
              "REV.3.19"
            ]
          }
        },
        {
          "text": "y castigo á todos los que amo: sé pues celoso, y",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.19",
            "verseOrgIds": [
              "REV.3.19"
            ]
          }
        },
        {
          "text": "arrepiéntete.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.19",
            "verseOrgIds": [
              "REV.3.19"
            ]
          }
        }
