              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al que venciere,",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.21",
            "verseOrgIds": [
              "REV.3.21"
            ]
          }
        },
        {
          "text": "yo le daré que se siente conmigo en mi trono; así como yo he",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.21",
            "verseOrgIds": [
              "REV.3.21"
            ]
          }
        },
        {
          "text": "vencido, y me he sentado con mi Padre en su trono.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.21",
            "verseOrgIds": [
              "REV.3.21"
            ]
          }
