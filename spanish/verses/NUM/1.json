            "number": "51",
            "style": "v",
            "sid": "NUM 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y cuando el tabernáculo partiere, los Levitas lo desarmarán; y cuando el tabernáculo parare, los Levitas lo armarán:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.51",
            "verseOrgIds": [
              "NUM.1.51"
            ]
          }
        },
        {
          "text": "y el extraño que se llegare, morirá.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.51",
            "verseOrgIds": [
              "NUM.1.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
