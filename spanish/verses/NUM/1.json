          "text": "Mas los Levitas asentarán las suyas alrededor del tabernáculo del testimonio,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.53",
            "verseOrgIds": [
              "NUM.1.53"
            ]
          }
        },
        {
