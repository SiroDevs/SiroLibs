          "text": "Y los hijos de Israel asentarán sus tiendas",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.52",
            "verseOrgIds": [
              "NUM.1.52"
            ]
          }
        },
        {
          "text": "cada uno en su escuadrón, y cada uno junto á su bandera, por sus cuadrillas;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.52",
            "verseOrgIds": [
              "NUM.1.52"
            ]
          }
        }
      ]
    },
