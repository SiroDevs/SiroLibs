          "type": "text",
          "attrs": {
            "verseId": "NUM.1.53",
            "verseOrgIds": [
              "NUM.1.53"
            ]
          }
        },
        {
          "text": "y los Levitas tendrán la guarda del tabernáculo del testimonio.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.53",
            "verseOrgIds": [
              "NUM.1.53"
            ]
          }
        }
      ]
