            "verseId": "NUM.20.24",
            "verseOrgIds": [
              "NUM.20.24"
            ]
          }
        },
        {
          "text": "mandamiento en las aguas de la rencilla.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.24",
            "verseOrgIds": [
              "NUM.20.24"
            ]
          }
        }
      ]
    },
