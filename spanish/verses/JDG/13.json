          "attrs": {
            "verseId": "JDG.13.20",
            "verseOrgIds": [
              "JDG.13.20"
            ]
          }
        },
        {
          "text": "se postraron en tierra sobre sus rostros.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.20",
            "verseOrgIds": [
              "JDG.13.20"
            ]
          }
        }
