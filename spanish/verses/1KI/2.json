          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dijo además el rey á Semei: Tú sabes",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.44",
            "verseOrgIds": [
              "1KI.2.44"
            ]
          }
        },
        {
          "text": "todo el mal, el cual tu corazón bien sabe, que cometiste contra mi padre David;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.44",
            "verseOrgIds": [
              "1KI.2.44"
            ]
          }
        },
        {
          "text": "Jehová pues, ha tornado el mal sobre tu cabeza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.44",
            "verseOrgIds": [
              "1KI.2.44"
            ]
          }
        }
      ]
