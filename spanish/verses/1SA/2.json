{
  "id": "1SA.2",
  "number": "2",
  "bookId": "1SA",
  "reference": "1 Samuel 2",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1SA 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y ANNA oró y dijo:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "Mi corazón se regocija en Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "Mi cuerno es ensalzado en Jehová;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "Mi boca se ensanchó sobre mis enemigos,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "Por cuanto me",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        },
        {
          "text": "alegré en tu salud.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "No hay santo como Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.2",
            "verseOrgIds": [
              "1SA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:2"
      },
      "items": [
        {
          "text": "Porque no hay ninguno fuera de ti;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.2",
            "verseOrgIds": [
              "1SA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:2"
      },
      "items": [
        {
          "text": "Y no hay",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.2",
            "verseOrgIds": [
              "1SA.2.2"
            ]
          }
        },
        {
          "text": "refugio como el Dios nuestro.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.2",
            "verseOrgIds": [
              "1SA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "No multipliquéis hablando grandezas,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        },
        {
          "text": "altanerías;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:3"
      },
      "items": [
        {
          "text": "Cesen las palabras arrogantes de vuestra boca;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:3"
      },
      "items": [
        {
          "text": "Porque el Dios de todo saber es Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:3"
      },
      "items": [
        {
          "text": "Y á él toca el pesar las acciones.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los arcos de los fuertes fueron quebrados,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.4",
            "verseOrgIds": [
              "1SA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:4"
      },
      "items": [
        {
          "text": "Y los flacos se ciñeron de fortaleza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.4",
            "verseOrgIds": [
              "1SA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los hartos se alquilaron por pan:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:5"
      },
      "items": [
        {
          "text": "Y cesaron los hambrientos:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:5"
      },
      "items": [
        {
          "text": "Hasta parir siete la estéril,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:5"
      },
      "items": [
        {
          "text": "Y la que tenía muchos hijos enfermó.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Maldad de los hijos de Eli.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Mensaje del varón de Dios",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová mata, y él da vida:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.6",
            "verseOrgIds": [
              "1SA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:6"
      },
      "items": [
        {
          "text": "El hace descender al sepulcro, y hace subir.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.6",
            "verseOrgIds": [
              "1SA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová empobrece, y él enriquece:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.7",
            "verseOrgIds": [
              "1SA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:7"
      },
      "items": [
        {
          "text": "Abate, y ensalza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.7",
            "verseOrgIds": [
              "1SA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "El levanta del polvo al pobre,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "Y al menesteroso ensalza del estiércol,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "Para asentarlo con los príncipes;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "Y hace que tengan por heredad asiento de honra:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "Porque de Jehová son las columnas de la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "Y él asentó sobre ellas el mundo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "El guarda los pies de sus santos,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.9",
            "verseOrgIds": [
              "1SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:9"
      },
      "items": [
        {
          "text": "Mas los impíos perecen en tinieblas;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.9",
            "verseOrgIds": [
              "1SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:9"
      },
      "items": [
        {
          "text": "Porque nadie será fuerte por",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.9",
            "verseOrgIds": [
              "1SA.2.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "su",
              "type": "text",
              "attrs": {
                "verseId": "1SA.2.9",
                "verseOrgIds": [
                  "1SA.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "fuerza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.9",
            "verseOrgIds": [
              "1SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delante de Jehová serán",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        },
        {
          "text": "quebrantados sus adversarios,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "Y sobre ellos tronará",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        },
        {
          "text": "desde los cielos:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "Jehová juzgará los términos de la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "Y dará fortaleza á su Rey,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        },
        {
          "text": "ensalzará el cuerno de su Mesías.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y Elcana se volvió á su casa en",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.11",
            "verseOrgIds": [
              "1SA.2.11"
            ]
          }
        },
        {
          "text": "Ramatha; y el niño ministraba á Jehová delante del sacerdote Eli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.11",
            "verseOrgIds": [
              "1SA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas los hijos de Eli eran hombres impíos, y no tenían conocimiento de Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.12",
            "verseOrgIds": [
              "1SA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y la costumbre de los sacerdotes con el pueblo era que, cuando alguno ofrecía sacrificio, venía el criado del sacerdote mientras la carne estaba á cocer,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.13",
            "verseOrgIds": [
              "1SA.2.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "trayendo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.2.13",
                "verseOrgIds": [
                  "1SA.2.13"
                ]
              }
            }
          ]
        },
        {
          "text": "en su mano un garfio de tres ganchos;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.13",
            "verseOrgIds": [
              "1SA.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y hería con él en la caldera, ó en la olla, ó en el caldero, ó en el pote; y",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.14",
            "verseOrgIds": [
              "1SA.2.14"
            ]
          }
        },
        {
          "text": "todo lo que sacaba el garfio, el sacerdote lo tomaba para sí. De esta manera hacían á todo Israelita que venía á Silo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.14",
            "verseOrgIds": [
              "1SA.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asimismo,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.15",
            "verseOrgIds": [
              "1SA.2.15"
            ]
          }
        },
        {
          "text": "antes de quemar el sebo, venía el criado del sacerdote, y decía al que sacrificaba: Da carne que ase para el sacerdote; porque no tomará de ti carne cocida, sino cruda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.15",
            "verseOrgIds": [
              "1SA.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y si le respondía el varón, Quemen luego el sebo hoy, y después toma tanta como quisieres; él respondía: No, sino ahora la has de dar: de otra manera yo la tomaré por fuerza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.16",
            "verseOrgIds": [
              "1SA.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era pues el pecado de los mozos muy grande delante de Jehová;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.17",
            "verseOrgIds": [
              "1SA.2.17"
            ]
          }
        },
        {
          "text": "porque los hombres menospreciaban los sacrificios de Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.17",
            "verseOrgIds": [
              "1SA.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y el joven Samuel ministraba delante de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.18",
            "verseOrgIds": [
              "1SA.2.18"
            ]
          }
        },
        {
          "text": "vestido de un ephod de lino.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.18",
            "verseOrgIds": [
              "1SA.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y hacíale su madre una túnica pequeña, y traíasela cada año, cuando subía con su marido á ofrecer el sacrificio acostumbrado.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.19",
            "verseOrgIds": [
              "1SA.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.20",
            "verseOrgIds": [
              "1SA.2.20"
            ]
          }
        },
        {
          "text": "Eli bendijo á Elcana y á su mujer, diciendo: Jehová te dé simiente de esta mujer en lugar de esta",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.20",
            "verseOrgIds": [
              "1SA.2.20"
            ]
          }
        },
        {
          "text": "petición que hizo á Jehová. Y volviéronse á su casa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.20",
            "verseOrgIds": [
              "1SA.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.21",
            "verseOrgIds": [
              "1SA.2.21"
            ]
          }
        },
        {
          "text": "visitó Jehová á Anna, y concibió, y parió tres hijos, y dos hijas. Y el joven Samuel crecía delante de Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.21",
            "verseOrgIds": [
              "1SA.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli empero era muy viejo, y oyó todo lo que sus hijos",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.22",
            "verseOrgIds": [
              "1SA.2.22"
            ]
          }
        },
        {
          "text": "hacían á todo Israel, y como dormían con las mujeres que velaban á la puerta del tabernáculo del testimonio.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.22",
            "verseOrgIds": [
              "1SA.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y díjoles: ¿Por qué hacéis cosas semejantes? Porque yo oigo de todo este pueblo vuestros malos procederes.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.23",
            "verseOrgIds": [
              "1SA.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "No, hijos míos; porque no es buena fama la que yo oigo: que hacéis pecar al pueblo de Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.24",
            "verseOrgIds": [
              "1SA.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si pecare el hombre contra el hombre, los",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.25",
            "verseOrgIds": [
              "1SA.2.25"
            ]
          }
        },
        {
          "text": "jueces le juzgarán; mas si alguno pecare contra Jehová, ¿quién rogará por él? Mas ellos no oyeron la voz de su padre,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.25",
            "verseOrgIds": [
              "1SA.2.25"
            ]
          }
        },
        {
          "text": "porque Jehová los quería matar.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.25",
            "verseOrgIds": [
              "1SA.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y el joven Samuel iba creciendo, y",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        },
        {
          "text": "adelantando delante de Dios y delante de los hombres.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.27",
            "verseOrgIds": [
              "1SA.2.27"
            ]
          }
        },
        {
          "text": "vino un varón de Dios á Eli, y díjole: Así ha dicho Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.27",
            "verseOrgIds": [
              "1SA.2.27"
            ]
          }
        },
        {
          "text": "¿No me manifesté yo claramente á la casa de tu padre, cuando estaban en Egipto en casa de Faraón?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.27",
            "verseOrgIds": [
              "1SA.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y yo le escogí por mi sacerdote entre todas las tribus de Israel, para que ofreciese sobre mi altar, y quemase perfume, y",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.28",
            "verseOrgIds": [
              "1SA.2.28"
            ]
          }
        },
        {
          "text": "trajese ephod delante de mí; y",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.28",
            "verseOrgIds": [
              "1SA.2.28"
            ]
          }
        },
        {
          "text": "dí á la casa de tu padre todas las ofrendas de los hijos de Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.28",
            "verseOrgIds": [
              "1SA.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 contra la casa de Eli.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Visión del joven Samuel.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Por qué habéis hollado mis sacrificios y mis presentes, que yo mandé",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.29",
            "verseOrgIds": [
              "1SA.2.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "ofrecer",
              "type": "text",
              "attrs": {
                "verseId": "1SA.2.29",
                "verseOrgIds": [
                  "1SA.2.29"
                ]
              }
            }
          ]
        },
        {
          "text": "en el",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.29",
            "verseOrgIds": [
              "1SA.2.29"
            ]
          }
        },
        {
          "text": "tabernáculo; y has honrado á tus hijos más que á mí, engordándoos de lo principal de todas las ofrendas de mi pueblo Israel?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.29",
            "verseOrgIds": [
              "1SA.2.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por tanto, Jehová el Dios de Israel dice:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.30",
            "verseOrgIds": [
              "1SA.2.30"
            ]
          }
        },
        {
          "text": "Yo había dicho que tu casa y la casa de tu padre andarían delante de mí perpetuamente; mas ahora ha dicho Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.30",
            "verseOrgIds": [
              "1SA.2.30"
            ]
          }
        },
        {
          "text": "Nunca yo tal haga, porque yo honraré á los que me honran, y los que me tuvieren en poco, serán viles.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.30",
            "verseOrgIds": [
              "1SA.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.31",
            "verseOrgIds": [
              "1SA.2.31"
            ]
          }
        },
        {
          "text": "vienen días, en que cortaré tu brazo, y el brazo de la casa de tu padre, que no haya viejo en tu casa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.31",
            "verseOrgIds": [
              "1SA.2.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y verás competidor en el tabernáculo, en todas las cosas en que hiciere bien á Israel;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.32",
            "verseOrgIds": [
              "1SA.2.32"
            ]
          }
        },
        {
          "text": "y en ningún tiempo habrá viejo en tu casa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.32",
            "verseOrgIds": [
              "1SA.2.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y no te cortaré",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.33",
            "verseOrgIds": [
              "1SA.2.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
