{
  "id": "1TI.2",
  "number": "2",
  "bookId": "1TI",
  "reference": "1 Timoteo 2",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1TI 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMONESTO pues, ante todas cosas, que se hagan",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.1",
            "verseOrgIds": [
              "1TI.2.1"
            ]
          }
        },
        {
          "text": "rogativas, oraciones, peticiones, hacimientos de gracias, por todos los hombres;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.1",
            "verseOrgIds": [
              "1TI.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por los reyes y",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.2",
            "verseOrgIds": [
              "1TI.2.2"
            ]
          }
        },
        {
          "text": "por todos los que están en eminencia, para que vivamos quieta y reposadamente en toda piedad y honestidad.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.2",
            "verseOrgIds": [
              "1TI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque esto es",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.3",
            "verseOrgIds": [
              "1TI.2.3"
            ]
          }
        },
        {
          "text": "bueno y agradable delante",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.3",
            "verseOrgIds": [
              "1TI.2.3"
            ]
          }
        },
        {
          "text": "de Dios nuestro Salvador;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.3",
            "verseOrgIds": [
              "1TI.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Un Dios y un Mediador.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Obispos y diáconos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "El cual",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.4",
            "verseOrgIds": [
              "1TI.2.4"
            ]
          }
        },
        {
          "text": "quiere que todos los hombres sean salvos, y",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.4",
            "verseOrgIds": [
              "1TI.2.4"
            ]
          }
        },
        {
          "text": "que vengan al conocimiento de la verdad.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.4",
            "verseOrgIds": [
              "1TI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque hay un Dios,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.5",
            "verseOrgIds": [
              "1TI.2.5"
            ]
          }
        },
        {
          "text": "asimismo",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.5",
            "verseOrgIds": [
              "1TI.2.5"
            ]
          }
        },
        {
          "text": "un mediador entre Dios y los hombres, Jesucristo hombre;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.5",
            "verseOrgIds": [
              "1TI.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "El cual se dió",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.6",
            "verseOrgIds": [
              "1TI.2.6"
            ]
          }
        },
        {
          "text": "a sí mismo",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.6",
            "verseOrgIds": [
              "1TI.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "en",
              "type": "text",
              "attrs": {
                "verseId": "1TI.2.6",
                "verseOrgIds": [
                  "1TI.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "precio del rescate por todos,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.6",
            "verseOrgIds": [
              "1TI.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "para",
              "type": "text",
              "attrs": {
                "verseId": "1TI.2.6",
                "verseOrgIds": [
                  "1TI.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "testimonio",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.6",
            "verseOrgIds": [
              "1TI.2.6"
            ]
          }
        },
        {
          "text": "en sus tiempos:",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.6",
            "verseOrgIds": [
              "1TI.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "De lo que yo soy puesto por predicador y",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.7",
            "verseOrgIds": [
              "1TI.2.7"
            ]
          }
        },
        {
          "text": "apóstol, (digo verdad en Cristo, no miento)",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.7",
            "verseOrgIds": [
              "1TI.2.7"
            ]
          }
        },
        {
          "text": "doctor de los Gentiles en fidelidad y verdad.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.7",
            "verseOrgIds": [
              "1TI.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Quiero, pues, que los hombres oren",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.8",
            "verseOrgIds": [
              "1TI.2.8"
            ]
          }
        },
        {
          "text": "en todo lugar, levantando",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.8",
            "verseOrgIds": [
              "1TI.2.8"
            ]
          }
        },
        {
          "text": "manos limpias, sin ira ni contienda.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.8",
            "verseOrgIds": [
              "1TI.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asimismo también",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.9",
            "verseOrgIds": [
              "1TI.2.9"
            ]
          }
        },
        {
          "text": "las mujeres, ataviándose en hábito honesto, con vergüenza y modestia; no con cabellos encrespados, ú oro, ó perlas, ó vestidos costosos.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.9",
            "verseOrgIds": [
              "1TI.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sino de buenas obras,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.10",
            "verseOrgIds": [
              "1TI.2.10"
            ]
          }
        },
        {
          "text": "como conviene á mujeres que profesan piedad.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.10",
            "verseOrgIds": [
              "1TI.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "La mujer aprenda en silencio, con toda sujeción.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.11",
            "verseOrgIds": [
              "1TI.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque no permito",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.12",
            "verseOrgIds": [
              "1TI.2.12"
            ]
          }
        },
        {
          "text": "a la mujer enseñar, ni tomar autoridad sobre el hombre, sino estar en silencio.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.12",
            "verseOrgIds": [
              "1TI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque Adam fué",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.13",
            "verseOrgIds": [
              "1TI.2.13"
            ]
          }
        },
        {
          "text": "formado el primero, después Eva;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.13",
            "verseOrgIds": [
              "1TI.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y Adam no fué engañado, sino",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.14",
            "verseOrgIds": [
              "1TI.2.14"
            ]
          }
        },
        {
          "text": "la mujer, siendo seducida, vino á ser",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.14",
            "verseOrgIds": [
              "1TI.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "envuelta",
              "type": "text",
              "attrs": {
                "verseId": "1TI.2.14",
                "verseOrgIds": [
                  "1TI.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "en transgresión:",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.14",
            "verseOrgIds": [
              "1TI.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empero se salvará engendrando hijos, si permaneciere en la fe y caridad y santidad, con modestia.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.15",
            "verseOrgIds": [
              "1TI.2.15"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1TI.3",
    "number": "3",
    "bookId": "1TI"
  },
