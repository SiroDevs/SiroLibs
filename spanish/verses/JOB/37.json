      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:18"
      },
      "items": [
        {
          "text": "Firmes como un espejo sólido?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.18",
            "verseOrgIds": [
              "JOB.37.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
