      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:21"
      },
      "items": [
        {
          "text": "Luego que pasa el viento y los limpia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.21",
            "verseOrgIds": [
              "JOB.37.21"
            ]
          }
        }
      ]
    },
    {
