              "text": "Porque",
              "type": "text",
              "attrs": {
                "verseId": "JOB.37.19",
                "verseOrgIds": [
                  "JOB.37.19"
                ]
              }
            }
          ]
        },
        {
          "text": "nosotros no podemos componer",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.19",
            "verseOrgIds": [
              "JOB.37.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "las ideas",
              "type": "text",
              "attrs": {
                "verseId": "JOB.37.19",
                "verseOrgIds": [
                  "JOB.37.19"
                ]
              }
            }
          ]
        },
        {
          "text": "á causa de las tinieblas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.19",
            "verseOrgIds": [
              "JOB.37.19"
            ]
          }
