{
  "id": "JOB.37",
  "number": "37",
  "bookId": "JOB",
  "reference": "Job 37",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "JOB 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ESTO también se espanta mi corazón,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.1",
            "verseOrgIds": [
              "JOB.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:1"
      },
      "items": [
        {
          "text": "Y salta de su lugar.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.1",
            "verseOrgIds": [
              "JOB.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oid atentamente su voz terrible, y el sonido que sale de su boca.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.2",
            "verseOrgIds": [
              "JOB.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Debajo de todos los cielos lo dirige,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.3",
            "verseOrgIds": [
              "JOB.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:3"
      },
      "items": [
        {
          "text": "Y su luz hasta los fines de la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.3",
            "verseOrgIds": [
              "JOB.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Después de ella bramará el sonido,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:4"
      },
      "items": [
        {
          "text": "Tronará él con la voz de su magnificencia;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:4"
      },
      "items": [
        {
          "text": "Y aunque sea oída su voz, no los detiene.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tronará Dios maravillosamente con su voz;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.5",
            "verseOrgIds": [
              "JOB.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:5"
      },
      "items": [
        {
          "text": "El hace",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.5",
            "verseOrgIds": [
              "JOB.37.5"
            ]
          }
        },
        {
          "text": "grandes cosas, que nosotros no entendemos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.5",
            "verseOrgIds": [
              "JOB.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque á la nieve dice:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.6",
            "verseOrgIds": [
              "JOB.37.6"
            ]
          }
        },
        {
          "text": "Desciende á la tierra;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.6",
            "verseOrgIds": [
              "JOB.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:6"
      },
      "items": [
        {
          "text": "También á la llovizna,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.6",
            "verseOrgIds": [
              "JOB.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:6"
      },
      "items": [
        {
          "text": "Y á los aguaceros de su fortaleza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.6",
            "verseOrgIds": [
              "JOB.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Así hace retirarse á todo hombre,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.7",
            "verseOrgIds": [
              "JOB.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:7"
      },
      "items": [
        {
          "text": "Para que los hombres todos reconozcan su obra.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.7",
            "verseOrgIds": [
              "JOB.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "La bestia se entrará en su escondrijo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.8",
            "verseOrgIds": [
              "JOB.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:8"
      },
      "items": [
        {
          "text": "Y estaráse en sus moradas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.8",
            "verseOrgIds": [
              "JOB.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Grandeza de la obra de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Dios responde á Job.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Del mediodía viene el torbellino,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.9",
            "verseOrgIds": [
              "JOB.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:9"
      },
      "items": [
        {
          "text": "Y el frío de los vientos del norte.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.9",
            "verseOrgIds": [
              "JOB.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por el soplo de Dios se da el hielo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.10",
            "verseOrgIds": [
              "JOB.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:10"
      },
      "items": [
        {
          "text": "Y las anchas aguas son constreñidas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.10",
            "verseOrgIds": [
              "JOB.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Regando también llega á disipar la densa nube,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.11",
            "verseOrgIds": [
              "JOB.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:11"
      },
      "items": [
        {
          "text": "Y con su luz esparce la niebla.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.11",
            "verseOrgIds": [
              "JOB.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asimismo por sus designios se revuelven las nubes en derredor,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.12",
            "verseOrgIds": [
              "JOB.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:12"
      },
      "items": [
        {
          "text": "Para hacer sobre la haz del mundo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.12",
            "verseOrgIds": [
              "JOB.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:12"
      },
      "items": [
        {
          "text": "En la tierra, lo que él les mandara.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.12",
            "verseOrgIds": [
              "JOB.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unas veces por azote, otras por causa de",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.13",
            "verseOrgIds": [
              "JOB.37.13"
            ]
          }
        },
        {
          "text": "su tierra,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.13",
            "verseOrgIds": [
              "JOB.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:13"
      },
      "items": [
        {
          "text": "Otras",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.13",
            "verseOrgIds": [
              "JOB.37.13"
            ]
          }
        },
        {
          "text": "por misericordia las hará parecer.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.13",
            "verseOrgIds": [
              "JOB.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Escucha esto, Job;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.14",
            "verseOrgIds": [
              "JOB.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:14"
      },
      "items": [
        {
          "text": "Repósate, y considera las maravillas de Dios.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.14",
            "verseOrgIds": [
              "JOB.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Supiste tú cuándo Dios las ponía en concierto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.15",
            "verseOrgIds": [
              "JOB.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:15"
      },
      "items": [
        {
          "text": "Y hacía levantar la luz de su nube?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.15",
            "verseOrgIds": [
              "JOB.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Has tú conocido las diferencias de las nubes,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.16",
            "verseOrgIds": [
              "JOB.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:16"
      },
      "items": [
        {
          "text": "Las maravillas del",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.16",
            "verseOrgIds": [
              "JOB.37.16"
            ]
          }
        },
        {
          "text": "Perfecto en sabiduría?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.16",
            "verseOrgIds": [
              "JOB.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Por qué están calientes tus vestidos",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.17",
            "verseOrgIds": [
              "JOB.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:17"
      },
      "items": [
        {
          "text": "Cuando se fija el",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.17",
            "verseOrgIds": [
              "JOB.37.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "viento del",
              "type": "text",
              "attrs": {
                "verseId": "JOB.37.17",
                "verseOrgIds": [
                  "JOB.37.17"
                ]
              }
            }
          ]
        },
        {
          "text": "mediodía sobre la tierra?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.17",
            "verseOrgIds": [
              "JOB.37.17"
