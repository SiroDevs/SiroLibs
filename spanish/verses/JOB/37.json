              "type": "text",
              "attrs": {
                "verseId": "JOB.37.23",
                "verseOrgIds": [
                  "JOB.37.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Todopoderoso,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.23",
            "verseOrgIds": [
              "JOB.37.23"
            ]
          }
        },
        {
          "text": "al cual no alcanzamos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.23",
            "verseOrgIds": [
              "JOB.37.23"
            ]
          }
        },
        {
