      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:22"
      },
      "items": [
        {
          "text": "En Dios hay una majestad terrible.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.22",
            "verseOrgIds": [
              "JOB.37.22"
            ]
          }
        }
      ]
