          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Extendiste tú con él los cielos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.18",
            "verseOrgIds": [
              "JOB.37.18"
            ]
          }
