      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 37:20"
      },
      "items": [
        {
          "text": "Por más que el hombre razone, quedará como abismado.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.20",
            "verseOrgIds": [
              "JOB.37.20"
            ]
          }
        }
      ]
    },
    {
