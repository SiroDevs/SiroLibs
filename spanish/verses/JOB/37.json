          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Viniendo de la parte del norte la dorada claridad.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.22",
            "verseOrgIds": [
              "JOB.37.22"
            ]
          }
        }
      ]
