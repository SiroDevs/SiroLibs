{
  "id": "JOB.15",
  "number": "15",
  "bookId": "JOB",
  "reference": "Job 15",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JOB 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y RESPONDIÓ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.1",
            "verseOrgIds": [
              "JOB.15.1"
            ]
          }
        },
        {
          "text": "Eliphaz Temanita, y dijo:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.1",
            "verseOrgIds": [
              "JOB.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Si proferirá",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        },
        {
          "text": "el sabio",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        },
        {
          "text": "vana sabiduría,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:2"
      },
      "items": [
        {
          "text": "Y henchirá su vientre de viento solano?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Disputará con palabras inútiles,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.3",
            "verseOrgIds": [
              "JOB.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:3"
      },
      "items": [
        {
          "text": "Y con razones sin provecho?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.3",
            "verseOrgIds": [
              "JOB.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú también disipas el temor,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.4",
            "verseOrgIds": [
              "JOB.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:4"
      },
      "items": [
        {
          "text": "Y menoscabas la oración delante de Dios.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.4",
            "verseOrgIds": [
              "JOB.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque tu boca declaró tu iniquidad,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.5",
            "verseOrgIds": [
              "JOB.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:5"
      },
      "items": [
        {
          "text": "Pues has escogido el hablar de los astutos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.5",
            "verseOrgIds": [
              "JOB.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tu boca te condenará, y no yo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.6",
            "verseOrgIds": [
              "JOB.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:6"
      },
      "items": [
        {
          "text": "Y tus labios testificarán contra ti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.6",
            "verseOrgIds": [
              "JOB.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Naciste tú primero que Adam?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.7",
            "verseOrgIds": [
              "JOB.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:7"
      },
      "items": [
        {
          "text": "¿O fuiste formado antes que los collados?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.7",
            "verseOrgIds": [
              "JOB.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Oíste tú el",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.8",
            "verseOrgIds": [
              "JOB.15.8"
            ]
          }
        },
        {
          "text": "secreto de Dios,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.8",
            "verseOrgIds": [
              "JOB.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:8"
      },
      "items": [
        {
          "text": "Que detienes en ti solo la sabiduría?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.8",
            "verseOrgIds": [
              "JOB.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Qué sabes tú que no sepamos?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.9",
            "verseOrgIds": [
              "JOB.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:9"
      },
      "items": [
        {
          "text": "¿Qué entiendes que no se halle en nosotros?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.9",
            "verseOrgIds": [
              "JOB.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entre nosotros también hay cano, también hay viejo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.10",
            "verseOrgIds": [
              "JOB.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:10"
      },
      "items": [
        {
          "text": "Mucho mayor en días que tu padre.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.10",
            "verseOrgIds": [
              "JOB.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿En tan poco tienes las consolaciones de Dios?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.11",
            "verseOrgIds": [
              "JOB.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:11"
      },
      "items": [
        {
          "text": "¿Tienes acaso alguna cosa oculta cerca de ti?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.11",
            "verseOrgIds": [
              "JOB.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Por qué te enajena tu corazón,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.12",
            "verseOrgIds": [
              "JOB.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:12"
      },
      "items": [
        {
          "text": "Y por qué guiñan tus ojos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.12",
            "verseOrgIds": [
              "JOB.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pues haces frente á Dios con tu espíritu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.13",
            "verseOrgIds": [
              "JOB.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:13"
      },
      "items": [
        {
          "text": "Y sacas",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.13",
            "verseOrgIds": [
              "JOB.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "tales",
              "type": "text",
              "attrs": {
                "verseId": "JOB.15.13",
                "verseOrgIds": [
                  "JOB.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "palabras de tu boca?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.13",
            "verseOrgIds": [
              "JOB.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Qué cosa es el hombre para que sea limpio,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.14",
            "verseOrgIds": [
              "JOB.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:14"
      },
      "items": [
        {
          "text": "Y que se justifique el nacido de mujer?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.14",
            "verseOrgIds": [
              "JOB.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Inquietud de los impíos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Quéjase Job",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí que en sus",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.15",
            "verseOrgIds": [
              "JOB.15.15"
            ]
          }
        },
        {
          "text": "santos no confía,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.15",
            "verseOrgIds": [
              "JOB.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:15"
      },
      "items": [
        {
          "text": "Y ni los cielos son limpios delante de sus ojos:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.15",
            "verseOrgIds": [
              "JOB.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Cuánto menos el hombre abominable y vil,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.16",
            "verseOrgIds": [
              "JOB.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:16"
      },
      "items": [
        {
          "text": "Que bebe la iniquidad como agua?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.16",
            "verseOrgIds": [
              "JOB.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Escúchame; yo te mostraré",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.17",
            "verseOrgIds": [
              "JOB.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:17"
      },
      "items": [
        {
          "text": "Y te contaré lo que he visto:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.17",
            "verseOrgIds": [
              "JOB.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Lo que los sabios nos",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.18",
            "verseOrgIds": [
              "JOB.15.18"
            ]
          }
        },
        {
          "text": "contaron",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.18",
            "verseOrgIds": [
              "JOB.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:18"
      },
      "items": [
        {
          "text": "De sus padres, y no lo encubrieron;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.18",
            "verseOrgIds": [
              "JOB.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "A los cuales solos fué dada la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.19",
            "verseOrgIds": [
              "JOB.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:19"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.19",
            "verseOrgIds": [
              "JOB.15.19"
            ]
          }
        },
        {
          "text": "no pasó extraño por medio de ellos:)",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.19",
            "verseOrgIds": [
              "JOB.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todos los días del impío, él es atormentado de dolor,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.20",
            "verseOrgIds": [
              "JOB.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:20"
      },
      "items": [
        {
          "text": "Y el número de años es escondido al violento.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.20",
            "verseOrgIds": [
              "JOB.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Estruendos espantosos hay en sus oídos;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.21",
            "verseOrgIds": [
              "JOB.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:21"
      },
      "items": [
        {
          "text": "En la paz le vendrá quien lo asuele.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.21",
            "verseOrgIds": [
              "JOB.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "El no creerá que ha de volver de las tinieblas,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.22",
            "verseOrgIds": [
              "JOB.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:22"
      },
      "items": [
        {
          "text": "Y está mirando al cuchillo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.22",
            "verseOrgIds": [
              "JOB.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Desasosegado á comer siempre,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.23",
            "verseOrgIds": [
              "JOB.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:23"
      },
      "items": [
        {
          "text": "Sabe que le está aparejado día de tinieblas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.23",
            "verseOrgIds": [
              "JOB.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tribulación y angustia le asombrarán,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.24",
            "verseOrgIds": [
              "JOB.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:24"
      },
      "items": [
        {
          "text": "Y esforzaránse contra él como un rey apercibido para la batalla.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.24",
            "verseOrgIds": [
              "JOB.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por cuanto él extendió su mano contra Dios,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.25",
            "verseOrgIds": [
              "JOB.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:25"
      },
      "items": [
        {
          "text": "Y se esforzó contra el Todopoderoso,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.25",
            "verseOrgIds": [
              "JOB.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "El le acometerá en la cerviz,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.26",
            "verseOrgIds": [
              "JOB.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:26"
      },
      "items": [
        {
          "text": "En lo grueso de las hombreras de sus escudos:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.26",
            "verseOrgIds": [
              "JOB.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque cubrió su rostro con su gordura,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.27",
            "verseOrgIds": [
              "JOB.15.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:27"
      },
      "items": [
        {
          "text": "E hizo pliegues sobre los ijares;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.27",
            "verseOrgIds": [
              "JOB.15.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y habitó las ciudades asoladas,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.28",
            "verseOrgIds": [
              "JOB.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:28"
      },
      "items": [
        {
          "text": "Las casas inhabitadas,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.28",
            "verseOrgIds": [
              "JOB.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:28"
      },
      "items": [
        {
          "text": "Que estaban puestas en montones.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.28",
            "verseOrgIds": [
              "JOB.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "No enriquecerá, ni será firme su potencia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.29",
            "verseOrgIds": [
              "JOB.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:29"
      },
      "items": [
        {
          "text": "Ni extenderá por la tierra su hermosura.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.29",
            "verseOrgIds": [
              "JOB.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "No se escapará de las tinieblas:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.30",
            "verseOrgIds": [
              "JOB.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:30"
      },
      "items": [
        {
          "text": "La llama secará sus ramos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.30",
            "verseOrgIds": [
              "JOB.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:30"
      },
      "items": [
        {
          "text": "Y con el aliento de su boca perecerá.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.30",
            "verseOrgIds": [
              "JOB.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "No confíe el iluso en la vanidad;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.31",
            "verseOrgIds": [
              "JOB.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:31"
      },
      "items": [
        {
          "text": "Porque ella será su recompensa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.31",
            "verseOrgIds": [
              "JOB.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "El será cortado antes de su tiempo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.32",
            "verseOrgIds": [
              "JOB.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:32"
      },
      "items": [
        {
          "text": "Y sus",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.32",
            "verseOrgIds": [
              "JOB.15.32"
            ]
          }
        },
        {
          "text": "renuevos no reverdecerán.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.32",
            "verseOrgIds": [
              "JOB.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "El perderá su",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.33",
            "verseOrgIds": [
              "JOB.15.33"
            ]
          }
        },
        {
          "text": "agraz como la vid,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.33",
            "verseOrgIds": [
              "JOB.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:33"
      },
      "items": [
        {
          "text": "Y derramará su flor como la oliva.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.33",
            "verseOrgIds": [
              "JOB.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque la sociedad de los hipócritas será asolada,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.34",
            "verseOrgIds": [
              "JOB.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:34"
      },
      "items": [
        {
          "text": "Y fuego consumirá las tiendas de soborno.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.34",
            "verseOrgIds": [
              "JOB.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOB 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Concibieron dolor, y parieron iniquidad;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.35",
            "verseOrgIds": [
              "JOB.15.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 15:35"
      },
      "items": [
        {
          "text": "Y las entradas de ellos meditan engaño.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.35",
            "verseOrgIds": [
              "JOB.15.35"
            ]
          }
        }
      ]
    }
  ],
