          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Calificaba yo el camino de ellos, y sentábame en cabecera;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.25",
            "verseOrgIds": [
              "JOB.29.25"
            ]
          }
        }
      ]
