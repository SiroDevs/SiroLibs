            "sid": "JOB 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tras mi palabra no replicaban,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.22",
            "verseOrgIds": [
              "JOB.29.22"
            ]
          }
        }
      ]
    },
