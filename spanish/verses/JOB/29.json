      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 29:23"
      },
      "items": [
        {
          "text": "Y abrían su boca",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.23",
            "verseOrgIds": [
              "JOB.29.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "como",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.23",
                "verseOrgIds": [
                  "JOB.29.23"
                ]
              }
            }
          ]
        },
        {
          "text": "á",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.23",
            "verseOrgIds": [
              "JOB.29.23"
            ]
          }
        },
        {
          "text": "la lluvia tardía.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.23",
            "verseOrgIds": [
              "JOB.29.23"
            ]
          }
        }
