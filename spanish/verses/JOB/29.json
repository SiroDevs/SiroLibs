      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 29:24"
      },
      "items": [
        {
          "text": "Y no abatían la luz de mi rostro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.24",
            "verseOrgIds": [
              "JOB.29.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
