      "attrs": {
        "style": "q",
        "vid": "JOB 29:25"
      },
      "items": [
        {
          "text": "Y moraba como rey en el ejército,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.25",
            "verseOrgIds": [
              "JOB.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 29:25"
      },
      "items": [
        {
          "text": "Como el que consuela llorosos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.25",
            "verseOrgIds": [
              "JOB.29.25"
            ]
          }
        }
