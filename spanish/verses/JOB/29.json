      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 29:22"
      },
      "items": [
        {
          "text": "Y mi razón",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.22",
            "verseOrgIds": [
              "JOB.29.22"
            ]
          }
        },
        {
          "text": "destilaba sobre ellos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.22",
            "verseOrgIds": [
              "JOB.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y esperábanme como á la lluvia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.23",
            "verseOrgIds": [
              "JOB.29.23"
            ]
          }
        }
      ]
    },
