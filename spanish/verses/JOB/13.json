{
  "id": "JOB.13",
  "number": "13",
  "bookId": "JOB",
  "reference": "Job 13",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "JOB 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "HE AQUÍ que todas estas cosas han visto mis ojos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.1",
            "verseOrgIds": [
              "JOB.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:1"
      },
      "items": [
        {
          "text": "Y oído y entendido de por sí mis oídos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.1",
            "verseOrgIds": [
              "JOB.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Como vosotros lo sabéis, lo sé yo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.2",
            "verseOrgIds": [
              "JOB.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:2"
      },
      "items": [
        {
          "text": "No soy menos que vosotros.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.2",
            "verseOrgIds": [
              "JOB.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas yo hablaría con el Todopoderoso,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.3",
            "verseOrgIds": [
              "JOB.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:3"
      },
      "items": [
        {
          "text": "Y querría razonar con Dios.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.3",
            "verseOrgIds": [
              "JOB.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que ciertamente vosotros sois",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.4",
            "verseOrgIds": [
              "JOB.13.4"
            ]
          }
        },
        {
          "text": "fraguadores de mentira;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.4",
            "verseOrgIds": [
              "JOB.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:4"
      },
      "items": [
        {
          "text": "Sois todos vosotros médicos nulos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.4",
            "verseOrgIds": [
              "JOB.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Job espera en Dios",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 y apela á su juicio.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojalá callarais del todo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.5",
            "verseOrgIds": [
              "JOB.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:5"
      },
      "items": [
        {
          "text": "Porque os fuera sabiduría.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.5",
            "verseOrgIds": [
              "JOB.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oid ahora mi razonamiento,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.6",
            "verseOrgIds": [
              "JOB.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:6"
      },
      "items": [
        {
          "text": "Y estad atentos á los argumentos de mis labios.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.6",
            "verseOrgIds": [
              "JOB.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Habéis de hablar",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.7",
            "verseOrgIds": [
              "JOB.13.7"
            ]
          }
        },
        {
          "text": "iniquidad por Dios?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.7",
            "verseOrgIds": [
              "JOB.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:7"
      },
      "items": [
        {
          "text": "¿Habéis de hablar por él engaño?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.7",
            "verseOrgIds": [
              "JOB.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Habéis de hacer acepción de su persona?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.8",
            "verseOrgIds": [
              "JOB.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:8"
      },
      "items": [
        {
          "text": "¿Habéis de pleitear vosotros por Dios?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.8",
            "verseOrgIds": [
              "JOB.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Sería bueno que él os escudriñase?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.9",
            "verseOrgIds": [
              "JOB.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:9"
      },
      "items": [
        {
          "text": "¿Os burlaréis de él como quien se burla de algún hombre?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.9",
            "verseOrgIds": [
              "JOB.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "El os reprochará de seguro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.10",
            "verseOrgIds": [
              "JOB.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:10"
      },
      "items": [
        {
          "text": "Si solapadamente hacéis acepción de personas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.10",
            "verseOrgIds": [
              "JOB.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "De cierto su alteza os había de espantar,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.11",
            "verseOrgIds": [
              "JOB.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:11"
      },
      "items": [
        {
          "text": "Y su pavor había de caer sobre vosotros.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.11",
            "verseOrgIds": [
              "JOB.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuestras memorias serán comparadas",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.12",
            "verseOrgIds": [
              "JOB.13.12"
            ]
          }
        },
        {
          "text": "a la ceniza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.12",
            "verseOrgIds": [
              "JOB.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:12"
      },
      "items": [
        {
          "text": "Y vuestros cuerpos como cuerpos de lodo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.12",
            "verseOrgIds": [
              "JOB.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Escuchadme, y hablaré yo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.13",
            "verseOrgIds": [
              "JOB.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:13"
      },
      "items": [
        {
          "text": "Y véngame después lo que viniere.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.13",
            "verseOrgIds": [
              "JOB.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Por qué quitaré yo mi carne con mis dientes,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.14",
            "verseOrgIds": [
              "JOB.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:14"
      },
      "items": [
        {
          "text": "Y pondré mi alma en mi mano?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.14",
            "verseOrgIds": [
              "JOB.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí, aunque me matare,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.15",
            "verseOrgIds": [
              "JOB.13.15"
            ]
          }
        },
        {
          "text": "en él esperaré;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.15",
            "verseOrgIds": [
              "JOB.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:15"
      },
      "items": [
        {
          "text": "Empero defenderé delante de él mis caminos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.15",
            "verseOrgIds": [
              "JOB.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y él mismo me será salud,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.16",
            "verseOrgIds": [
              "JOB.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:16"
      },
      "items": [
        {
          "text": "Porque no entrará en su presencia el hipócrita.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.16",
            "verseOrgIds": [
              "JOB.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oid con atención mi razonamiento,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.17",
            "verseOrgIds": [
              "JOB.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:17"
      },
      "items": [
        {
          "text": "Y mi denunciación con vuestros oídos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.17",
            "verseOrgIds": [
              "JOB.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí ahora, si yo me apercibiere á juicio,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.18",
            "verseOrgIds": [
              "JOB.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:18"
      },
      "items": [
        {
          "text": "Sé que seré justificado.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.18",
            "verseOrgIds": [
              "JOB.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién es el que pleiteará conmigo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.19",
            "verseOrgIds": [
              "JOB.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:19"
      },
      "items": [
        {
          "text": "Porque si ahora yo callara, fenecería.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.19",
            "verseOrgIds": [
              "JOB.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "A lo menos dos cosas no hagas conmigo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.20",
            "verseOrgIds": [
              "JOB.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:20"
      },
      "items": [
        {
          "text": "Entonces no me esconderé de tu rostro:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.20",
            "verseOrgIds": [
              "JOB.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aparta de mí tu mano,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.21",
            "verseOrgIds": [
              "JOB.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:21"
      },
      "items": [
        {
          "text": "Y no me asombre tu terror.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.21",
            "verseOrgIds": [
              "JOB.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Llama luego, y yo responderé;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.22",
            "verseOrgIds": [
              "JOB.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:22"
      },
      "items": [
        {
          "text": "O yo hablaré, y respóndeme tú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.22",
            "verseOrgIds": [
              "JOB.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Cuántas iniquidades y pecados tengo yo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.23",
            "verseOrgIds": [
              "JOB.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:23"
      },
      "items": [
        {
          "text": "Hazme entender mi prevaricación y mi pecado.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.23",
            "verseOrgIds": [
              "JOB.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Por qué escondes tu rostro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.24",
            "verseOrgIds": [
              "JOB.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:24"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.24",
            "verseOrgIds": [
              "JOB.13.24"
            ]
          }
        },
        {
          "text": "me cuentas por tu enemigo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.24",
            "verseOrgIds": [
              "JOB.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿A la hoja arrebatada has de quebrantar?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.25",
            "verseOrgIds": [
              "JOB.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:25"
      },
      "items": [
        {
          "text": "¿Y á una arista seca has de perseguir?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.25",
            "verseOrgIds": [
              "JOB.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Por qué escribes contra mí amarguras,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.26",
            "verseOrgIds": [
              "JOB.13.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:26"
      },
      "items": [
        {
          "text": "Y me haces cargo de los pecados de mi mocedad?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.26",
            "verseOrgIds": [
              "JOB.13.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pones además mis pies en el cepo, y guardas todos mis caminos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.27",
            "verseOrgIds": [
              "JOB.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:27"
      },
      "items": [
        {
          "text": "Imprimiéndolo á las raíces de mis pies.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.27",
            "verseOrgIds": [
              "JOB.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y el",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.28",
            "verseOrgIds": [
              "JOB.13.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "cuerpo mío",
              "type": "text",
              "attrs": {
                "verseId": "JOB.13.28",
                "verseOrgIds": [
                  "JOB.13.28"
                ]
              }
            }
          ]
        },
        {
          "text": "se va gastando como de carcoma,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.28",
            "verseOrgIds": [
              "JOB.13.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 13:28"
      },
      "items": [
        {
          "text": "Como vestido que se come de polilla.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.28",
            "verseOrgIds": [
              "JOB.13.28"
            ]
          }
        }
      ]
    }
