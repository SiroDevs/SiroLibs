{
  "id": "JOB.16",
  "number": "16",
  "bookId": "JOB",
  "reference": "Job 16",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "JOB 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y RESPONDIÓ Job, y dijo:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.1",
            "verseOrgIds": [
              "JOB.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchas veces he oído cosas",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.2",
            "verseOrgIds": [
              "JOB.16.2"
            ]
          }
        },
        {
          "text": "como estas:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.2",
            "verseOrgIds": [
              "JOB.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:2"
      },
      "items": [
        {
          "text": "Consoladores molestos sois todos vosotros.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.2",
            "verseOrgIds": [
              "JOB.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Tendrán fin las palabras ventosas?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.3",
            "verseOrgIds": [
              "JOB.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:3"
      },
      "items": [
        {
          "text": "O ¿qué te animará á responder?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.3",
            "verseOrgIds": [
              "JOB.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "También yo hablaría como vosotros.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "Ojalá vuestra alma estuviera en lugar de la mía,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "Que yo os tendría compañía en las palabras,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "Y sobre vosotros movería mi cabeza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Mas",
              "type": "text",
              "attrs": {
                "verseId": "JOB.16.5",
                "verseOrgIds": [
                  "JOB.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "yo os alentaría con mis palabras,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.5",
            "verseOrgIds": [
              "JOB.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:5"
      },
      "items": [
        {
          "text": "Y la consolación de mis labios apaciguaría",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.5",
            "verseOrgIds": [
              "JOB.16.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "el dolor vuestro.",
              "type": "text",
              "attrs": {
                "verseId": "JOB.16.5",
                "verseOrgIds": [
                  "JOB.16.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si hablo, mi dolor no cesa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.6",
            "verseOrgIds": [
              "JOB.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:6"
      },
      "items": [
        {
          "text": "Y si dejo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.6",
            "verseOrgIds": [
              "JOB.16.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "de hablar,",
              "type": "text",
              "attrs": {
                "verseId": "JOB.16.6",
                "verseOrgIds": [
                  "JOB.16.6"
                ]
              }
            }
          ]
        },
        {
          "text": "no se aparta de mí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.6",
            "verseOrgIds": [
              "JOB.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empero ahora me ha fatigado:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.7",
            "verseOrgIds": [
              "JOB.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:7"
      },
      "items": [
        {
          "text": "Has tú asolado toda",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.7",
            "verseOrgIds": [
              "JOB.16.7"
            ]
          }
        },
        {
          "text": "mi compañía.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.7",
            "verseOrgIds": [
              "JOB.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú me has arrugado; testigo es",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.8",
            "verseOrgIds": [
              "JOB.16.8"
            ]
          }
        },
        {
          "text": "mi flacura,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.8",
            "verseOrgIds": [
              "JOB.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:8"
      },
      "items": [
        {
          "text": "Que se levanta contra mí para testificar en mi rostro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.8",
            "verseOrgIds": [
              "JOB.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 de sus amigos y se",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 lamenta de su mal.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Su furor",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "me",
              "type": "text",
              "attrs": {
                "verseId": "JOB.16.9",
                "verseOrgIds": [
                  "JOB.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "destrizó, y me ha sido contrario:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:9"
      },
      "items": [
        {
          "text": "Crujió sus dientes contra mí;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:9"
      },
      "items": [
        {
          "text": "Contra mí",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        },
        {
          "text": "aguzó sus ojos mi enemigo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrieron contra mí su boca;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:10"
      },
      "items": [
        {
          "text": "Hirieron mis mejillas con afrenta;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:10"
      },
      "items": [
        {
          "text": "Contra mí se juntaron todos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hame entregado Dios al mentiroso,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.11",
            "verseOrgIds": [
              "JOB.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:11"
      },
      "items": [
        {
          "text": "Y en las manos de los impíos me hizo estremecer.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.11",
            "verseOrgIds": [
              "JOB.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Próspero estaba, y desmenuzóme:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:12"
      },
      "items": [
        {
          "text": "Y arrebatóme por la cerviz, y despedazóme,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:12"
      },
      "items": [
        {
          "text": "Y púsome por",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        },
        {
          "text": "blanco suyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cercáronme sus",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        },
        {
          "text": "flecheros,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:13"
      },
      "items": [
        {
          "text": "Partió mis riñones, y no perdonó:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:13"
      },
      "items": [
        {
          "text": "Mi hiel",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        },
        {
          "text": "derramó por tierra.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Quebrantóme de",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.14",
            "verseOrgIds": [
              "JOB.16.14"
            ]
          }
        },
        {
          "text": "quebranto sobre quebranto;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.14",
            "verseOrgIds": [
              "JOB.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 16:14"
      },
      "items": [
        {
          "text": "Corrió contra mí como un gigante.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.14",
            "verseOrgIds": [
              "JOB.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
