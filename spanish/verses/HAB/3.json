{
  "id": "HAB.3",
  "number": "3",
  "bookId": "HAB",
  "reference": "Habacuc 3",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "HAB 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAB 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ORACIÓN de Habacuc profeta, sobre Sigionoth.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.1",
            "verseOrgIds": [
              "HAB.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Jehová, oído he tu palabra, y temí:",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "Oh Jehová, aviva tu obra en medio de los tiempos,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "En medio de los tiempos hazla conocer;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "En la ira acuérdate de la misericordia.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dios vendrá de Temán,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "Y el Santo del monte de Parán. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "Su gloria cubrió los cielos,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "Y la tierra se llenó de su alabanza.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y el resplandor fué como la luz;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:4"
      },
      "items": [
        {
          "text": "Rayos brillantes salían de su mano;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:4"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        },
        {
          "text": "allí estaba escondida su fortaleza.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delante de su rostro iba mortandad,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.5",
            "verseOrgIds": [
              "HAB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:5"
      },
      "items": [
        {
          "text": "Y á sus pies salían carbones encendidos.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.5",
            "verseOrgIds": [
              "HAB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paróse, y midió la tierra:",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "Miró, é hizo temblar las gentes;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "Y los montes antiguos fueron desmenuzados,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "Los collados antiguos se humillaron á él.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "Sus caminos son eternos.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "He visto las tiendas de Cushán en aflicción;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.7",
            "verseOrgIds": [
              "HAB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:7"
      },
      "items": [
        {
          "text": "Las tiendas de la tierra de Madián temblaron.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.7",
            "verseOrgIds": [
              "HAB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAB 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Airóse Jehová contra los ríos?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "¿Contra los ríos fué tu enojo?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "¿Tu ira contra la mar,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "Cuando subiste sobre tus caballos,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "Y sobre tus carros de salud?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAB 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Descubrióse enteramente tu arco,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.9",
            "verseOrgIds": [
              "HAB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:9"
      },
      "items": [
        {
          "text": "Los juramentos á las tribus, palabra",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.9",
            "verseOrgIds": [
              "HAB.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "segura.",
              "type": "text",
              "attrs": {
                "verseId": "HAB.3.9",
                "verseOrgIds": [
                  "HAB.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "(Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.9",
            "verseOrgIds": [
              "HAB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:9"
      },
      "items": [
        {
          "text": "Hendiste la tierra con ríos.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.9",
            "verseOrgIds": [
              "HAB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAB 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Viéronte, y",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        },
        {
          "text": "tuvieron temor los montes:",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:10"
      },
      "items": [
        {
          "text": "Pasó la inundación de las aguas:",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:10"
      },
      "items": [
        {
          "text": "El abismo dió su voz,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:10"
      },
      "items": [
        {
          "text": "La hondura alzó sus manos.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "El sol y la luna",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.11",
            "verseOrgIds": [
              "HAB.3.11"
            ]
          }
        },
        {
          "text": "se pararon en su estancia:",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.11",
            "verseOrgIds": [
              "HAB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:11"
      },
      "items": [
        {
          "text": "A la luz de tus saetas anduvieron,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.11",
            "verseOrgIds": [
              "HAB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:11"
      },
      "items": [
        {
          "text": "Y al resplandor de tu fulgente lanza.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.11",
            "verseOrgIds": [
              "HAB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAB 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con ira hollaste la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.12",
            "verseOrgIds": [
              "HAB.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:12"
      },
      "items": [
        {
          "text": "Con furor trillaste las gentes.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.12",
            "verseOrgIds": [
              "HAB.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAB 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saliste para salvar tu pueblo,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.13",
            "verseOrgIds": [
              "HAB.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:13"
      },
      "items": [
        {
          "text": "Para salvar con tu ungido.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.13",
            "verseOrgIds": [
              "HAB.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:13"
      },
      "items": [
        {
          "text": "Traspasaste la cabeza de la casa del impío,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.13",
            "verseOrgIds": [
              "HAB.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:13"
      },
      "items": [
        {
          "text": "Desnudando el cimiento hasta el cuello. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.13",
            "verseOrgIds": [
              "HAB.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAB 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Horadaste con sus báculos las cabezas de sus villas,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.14",
            "verseOrgIds": [
              "HAB.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:14"
      },
      "items": [
        {
          "text": "Que como tempestad acometieron para derramarme:",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.14",
            "verseOrgIds": [
              "HAB.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:14"
      },
      "items": [
        {
          "text": "Su orgullo era como para devorar al pobre encubiertamente.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.14",
            "verseOrgIds": [
              "HAB.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAB 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiciste camino en la mar á tu caballos,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.15",
            "verseOrgIds": [
              "HAB.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:15"
      },
      "items": [
        {
          "text": "Por montón de grandes aguas.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.15",
            "verseOrgIds": [
              "HAB.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HAB 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oí, y",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.16",
            "verseOrgIds": [
              "HAB.3.16"
            ]
          }
        },
        {
          "text": "tembló mi vientre;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.16",
            "verseOrgIds": [
              "HAB.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:16"
      },
      "items": [
        {
          "text": "A la voz se batieron mis labios;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.16",
            "verseOrgIds": [
              "HAB.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:16"
      },
      "items": [
        {
          "text": "Pudrición se entró en mis huesos, y en mi asiento me estremecí;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.16",
            "verseOrgIds": [
              "HAB.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:16"
      },
      "items": [
        {
          "text": "Si bien estaré quieto en el día de la angustia,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.16",
            "verseOrgIds": [
              "HAB.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:16"
      },
      "items": [
        {
          "text": "Cuando suba al pueblo el que lo invadirá con sus tropas.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.16",
            "verseOrgIds": [
              "HAB.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HAB 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aunque la higuera no florecerá,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.17",
            "verseOrgIds": [
              "HAB.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:17"
      },
      "items": [
        {
          "text": "Ni en las vides habrá frutos;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.17",
            "verseOrgIds": [
              "HAB.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:17"
      },
      "items": [
        {
          "text": "Mentirá la obra de la oliva,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.17",
            "verseOrgIds": [
              "HAB.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:17"
      },
      "items": [
        {
          "text": "Y los labrados no darán mantenimiento,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.17",
            "verseOrgIds": [
              "HAB.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Y",
              "type": "text",
              "attrs": {
                "verseId": "HAB.3.17",
                "verseOrgIds": [
                  "HAB.3.17"
                ]
              }
            }
          ]
        },
        {
          "text": "las ovejas serán quitadas de la majada,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.17",
            "verseOrgIds": [
              "HAB.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:17"
      },
      "items": [
        {
          "text": "Y no habrá vacas en los corrales;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.17",
            "verseOrgIds": [
              "HAB.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HAB 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con todo",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.18",
            "verseOrgIds": [
              "HAB.3.18"
            ]
          }
        },
        {
          "text": "yo me alegraré en Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.18",
            "verseOrgIds": [
              "HAB.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:18"
      },
      "items": [
        {
          "text": "Y me gozaré en el Dios de mi salud.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.18",
            "verseOrgIds": [
              "HAB.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HAB 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová el Señor es mi fortaleza,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.19",
            "verseOrgIds": [
              "HAB.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:19"
      },
      "items": [
        {
          "text": "El cual pondrá mis pies",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.19",
            "verseOrgIds": [
              "HAB.3.19"
            ]
          }
        },
        {
          "text": "como de ciervas,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.19",
            "verseOrgIds": [
              "HAB.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HAB 3:19"
      },
      "items": [
        {
          "text": "Y me hará andar",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.19",
            "verseOrgIds": [
              "HAB.3.19"
            ]
          }
        },
        {
          "text": "sobre mis alturas.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.19",
            "verseOrgIds": [
              "HAB.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "HAB 3:19"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "HAB 3:19"
      },
      "items": [
        {
          "text": "Al Jefe de los cantores sobre mis instrumentos de cuerdas.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.19",
            "verseOrgIds": [
              "HAB.3.19"
            ]
          }
        }
      ]
    }
  ],
