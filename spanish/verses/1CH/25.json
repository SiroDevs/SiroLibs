          "type": "text",
          "attrs": {
            "verseId": "1CH.25.14",
            "verseOrgIds": [
              "1CH.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
