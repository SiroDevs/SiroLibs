          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y fué el más honrado de los treinta, mas no llegó á los tres",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
              "1CH.11.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "primeros.",
              "type": "text",
              "attrs": {
                "verseId": "1CH.11.25",
                "verseOrgIds": [
                  "1CH.11.25"
                ]
              }
            }
          ]
        },
        {
          "text": "A este puso David en su consejo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
              "1CH.11.25"
            ]
          }
        }
      ]
    },
    {
