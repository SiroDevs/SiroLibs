      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 4:11"
      },
      "items": [
        {
          "text": "Miel y leche hay debajo de tu lengua;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 4:11"
      },
      "items": [
        {
          "text": "Y el olor de tus vestidos",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        },
        {
          "text": "como el olor del Líbano.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
