        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Como",
              "type": "text",
              "attrs": {
                "verseId": "SNG.4.11",
                "verseOrgIds": [
                  "SNG.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "panal de miel destilan tus labios, oh esposa;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        }
      ]
    },
