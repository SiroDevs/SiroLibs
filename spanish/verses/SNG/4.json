          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huerto cerrado",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.12",
            "verseOrgIds": [
              "SNG.4.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "eres,",
              "type": "text",
              "attrs": {
                "verseId": "SNG.4.12",
                "verseOrgIds": [
                  "SNG.4.12"
                ]
              }
            }
          ]
        },
        {
          "text": "mi hermana, esposa",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.12",
            "verseOrgIds": [
              "SNG.4.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "mía;",
              "type": "text",
              "attrs": {
                "verseId": "SNG.4.12",
                "verseOrgIds": [
                  "SNG.4.12"
                ]
              }
            }
          ]
        }
      ]
