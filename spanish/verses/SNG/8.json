        "vid": "SNG 8:11"
      },
      "items": [
        {
          "text": "La cual entregó á guardas,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.11",
            "verseOrgIds": [
              "SNG.8.11"
            ]
