      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:12"
      },
      "items": [
        {
          "text": "Las mil serán tuyas, oh Salomón,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.12",
            "verseOrgIds": [
              "SNG.8.12"
            ]
          }
        }
      ]
