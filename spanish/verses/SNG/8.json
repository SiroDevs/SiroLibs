      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:12"
      },
      "items": [
        {
          "text": "Y doscientas, de los que guardan su fruto.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.12",
            "verseOrgIds": [
              "SNG.8.12"
            ]
          }
        }
      ]
