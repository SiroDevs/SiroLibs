          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi viña, que es mía, está delante de mí:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.12",
            "verseOrgIds": [
              "SNG.8.12"
            ]
          }
        }
      ]
    },
