{
  "id": "SNG.8",
  "number": "8",
  "bookId": "SNG",
  "reference": "Cantares 8",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "SNG 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "¡OH quién te me diese como hermano",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "Que mamó los pechos de mi madre;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "De modo",
              "type": "text",
              "attrs": {
                "verseId": "SNG.8.1",
                "verseOrgIds": [
                  "SNG.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "que te halle yo fuera, y te bese,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "Y no me menosprecien!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo te llevaría, te metiera en casa de mi madre:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "Tú me enseñarías,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "Y yo te hiciera beber vino",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "Adobado del mosto de mis",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        },
        {
          "text": "granadas.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Su izquierda",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.3",
            "verseOrgIds": [
              "SNG.8.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "esté",
              "type": "text",
              "attrs": {
                "verseId": "SNG.8.3",
                "verseOrgIds": [
                  "SNG.8.3"
                ]
              }
            }
          ]
        },
        {
          "text": "debajo de mi cabeza,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.3",
            "verseOrgIds": [
              "SNG.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:3"
      },
      "items": [
        {
          "text": "Y su derecha me abrace.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.3",
            "verseOrgIds": [
              "SNG.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Conjúroos,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        },
        {
          "text": "oh doncellas de Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:4"
      },
      "items": [
        {
          "text": "Que no despertéis, ni hagáis velar al amor,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:4"
      },
      "items": [
        {
          "text": "Hasta que quiera.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién es ésta",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        },
        {
          "text": "que sube del desierto,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "Recostada sobre su amado?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "Debajo de un manzano te desperté:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "Allí tuvo tu madre dolores,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "Allí tuvo dolores la que te parió.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ponme",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        },
        {
          "text": "como un sello sobre tu corazón, como una marca sobre tu brazo:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        },
        {
          "text": "fuerte es como la muerte el amor;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "Duro como el sepulcro el celo:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "Sus brasas, brasas de fuego,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "Fuerte llama.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las muchas aguas no podrán apagar el amor,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "Ni lo ahogarán los ríos.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "Si diese el hombre toda la hacienda de su casa por este amor,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "De cierto lo menospreciaran.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tenemos una pequeña hermana,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:8"
      },
      "items": [
        {
          "text": "Que no tiene pechos:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:8"
      },
      "items": [
        {
          "text": "¿Qué haremos á nuestra hermana",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:8"
      },
      "items": [
        {
          "text": "Cuando de ella se hablare?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si ella es muro,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:9"
      },
      "items": [
        {
          "text": "Edificaremos sobre él un palacio de plata:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:9"
      },
      "items": [
        {
          "text": "Y si fuere puerta,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:9"
      },
      "items": [
        {
          "text": "La guarneceremos con tablas de cedro.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo soy muro, y mis pechos",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.10",
            "verseOrgIds": [
              "SNG.8.10"
            ]
          }
        },
        {
          "text": "como torres,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.10",
            "verseOrgIds": [
              "SNG.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "SNG 8:10"
      },
      "items": [
        {
          "text": "Desde que fuí en sus ojos como la que halla paz.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.10",
            "verseOrgIds": [
              "SNG.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomón",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.11",
            "verseOrgIds": [
              "SNG.8.11"
            ]
          }
        },
        {
          "text": "tuvo una viña en Baal-hamón,",
          "type": "text",
          "attrs": {
