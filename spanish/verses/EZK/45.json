        {
          "text": "Todo el pueblo de la tierra será",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.16",
            "verseOrgIds": [
              "EZK.45.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "obligado",
              "type": "text",
              "attrs": {
                "verseId": "EZK.45.16",
                "verseOrgIds": [
                  "EZK.45.16"
                ]
              }
            }
          ]
        },
        {
          "text": "á esta ofrenda para el príncipe de Israel.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.16",
            "verseOrgIds": [
              "EZK.45.16"
            ]
          }
        }
