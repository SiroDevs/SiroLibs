          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y tú, oh hijo del hombre, he aquí",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.25",
            "verseOrgIds": [
              "EZK.3.25"
            ]
          }
        },
        {
          "text": "que pondrán sobre ti cuerdas, y con ellas te ligarán, y no saldrás entre ellos.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.25",
            "verseOrgIds": [
              "EZK.3.25"
            ]
          }
        }
      ]
    },
    {
