                "verseOrgIds": [
                  "MRK.3.24"
                ]
              }
            }
          ]
        },
        {
          "text": "reino contra sí mismo fuere dividido, no puede permanecer el tal reino.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.24",
            "verseOrgIds": [
              "MRK.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
