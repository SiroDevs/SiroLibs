          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vosotros pues ahora sois",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.23",
            "verseOrgIds": [
              "JOS.9.23"
            ]
          }
        },
        {
          "text": "malditos, y no faltará de vosotros siervo, y quien corte la leña y saque el agua para la casa de mi Dios.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.23",
            "verseOrgIds": [
              "JOS.9.23"
            ]
          }
        }
      ]
    },
