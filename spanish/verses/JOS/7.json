          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y dijo Josué: ¿Por qué",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        },
        {
          "text": "nos has turbado? Túrbete Jehová en este día.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        },
        {
          "text": "Y todos los Israelitas los apedrearon, y los quemaron á fuego, después de apedrearlos con piedras;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
