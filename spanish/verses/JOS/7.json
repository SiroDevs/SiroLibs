          "attrs": {
            "verseId": "JOS.7.26",
            "verseOrgIds": [
              "JOS.7.26"
            ]
          }
        },
        {
          "text": "levantaron sobre él un gran montón de piedras, hasta hoy. Y",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.26",
            "verseOrgIds": [
              "JOS.7.26"
            ]
          }
        },
        {
          "text": "Jehová se tornó de la ira de su furor. Y por esto fué llamado aquel lugar el Valle",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.26",
            "verseOrgIds": [
              "JOS.7.26"
            ]
          }
        },
        {
          "text": "de",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.26",
            "verseOrgIds": [
              "JOS.7.26"
            ]
          }
        },
        {
          "text": "Achôr, hasta hoy.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.26",
            "verseOrgIds": [
              "JOS.7.26"
            ]
          }
