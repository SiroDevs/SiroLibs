        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.29",
            "verseOrgIds": [
              "ISA.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vosi valahulira mwoyo gwa Yahova gwilitiihiza kandi valahulira vululu vwu vutima vwivwe. Uvutima vwivwe vulava kuli olomemo lwu muliru gusambaa, kandi kuli liatuluruka lia malesi, imbura yamagina kandi imbura yizingulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.30",
            "verseOrgIds": [
              "ISA.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Asiria valava nu vuti lwavahulira mwoyo gwa Yahova kandi valahulira vulitu vwa mageri geege. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.31",
            "verseOrgIds": [
              "ISA.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yahova ahaanaa amageri ku vandu va Asiria vuli ing'inga, avandu veve valimba zinyimbu nu kukuba zindumba nu vukana. Nyasaye mwene alwaana avandu va Asiria. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.32",
            "verseOrgIds": [
              "ISA.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ISA 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu madiku ga kale, havundu haloombwa hukusambira mwami wa Asiria nu muliru munene. Haveeye havundu havambalaru kandi hazia musi, vaviika mu zingu zinyingi ligali. Mwika gwa yahova gulava kuli lomemo gwu kuhambiza muliru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.33",
            "verseOrgIds": [
              "ISA.30.33"
            ]
          }
        }
      ]
    }
