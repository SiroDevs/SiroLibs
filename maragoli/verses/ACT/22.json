            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa munene wa vasikari wa Varumi oyo yazia ku Paolo namuteeva, “Mbolera, hene ivi oveeye Murumi?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.27",
            "verseOrgIds": [
              "ACT.22.27"
            ]
          }
        }
