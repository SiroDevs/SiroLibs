              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munene wa vasikari oyo yavoola, “Inzi ndaagwa mulala ku Avarumi mu litunga mabese manyingi ligali.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.28",
