              "type": "text"
            }
          ]
        },
        {
          "text": "Yaazizagilira komoloma nu vuluviliri nu kuguuta Vayuda imbiri wa avandu, navamanyia kuvitira mu Mang'oda Matakatifu ndi Yeso aveeye Mesia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.28",
