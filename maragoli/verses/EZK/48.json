          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami Munene Yahova avoora, “Yiki nicho kivala cha ugavula mu vidieli hagati hi zihiiri zia Isiraeli keve kuli miandu kuvo.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.29",
