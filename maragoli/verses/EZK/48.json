        },
        {
          "text": "Ihiiri ya Zabuloni ilanyoola kidieli kikagata ni kidieli cha Isakari kutura Ivugwi kuduuka Imadioli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
