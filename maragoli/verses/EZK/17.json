          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaga nigo ga Yahova Wuvunyali avoora:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.22",
            "verseOrgIds": [
              "EZK.17.22"
            ]
          }
        }
      ]
    }
