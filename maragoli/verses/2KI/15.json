          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vindu vindi viosi via Jozamu yakola viang'odwa mu vitabu via makuva ga kale ga vami vi Ivuyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.36",
            "verseOrgIds": [
              "2KI.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu madiku gene yago, Yahova yaatanga kutuma Rezini mwami wa Siria kandi Peka muyaayi wa Remalia kuzia kulwaana kivala chi Ivuyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jozamu yakuza nayavirwa mu vilindwa viu vwami mu Lidaala linene lia Daudi. Muyaayi weve Ahazi yavugula vogono vwivwe kuli mwami wi Ivuyuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.38",
            "verseOrgIds": [
              "2KI.15.38"
            ]
          }
        }
