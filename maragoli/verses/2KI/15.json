          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu muhiga gwa sirini gwi liamiiha lia Jozamu muyaayi wa Uzia kuli mwami wi Vuyuda, Hoshea muyaayi wa Ela yaazira haasi mwami Peka, namwiita kandi navugura ovogono vwivwe kuli mwami wa Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.30",
            "verseOrgIds": [
              "2KI.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vindu vindi viosi viu mwami Peka yakola viang'odwa mu vitabu via makuva ga kale ga vami va Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.31",
            "verseOrgIds": [
              "2KI.15.31"
            ]
          }
        }
      ]
    },
