        "style": "s1"
      },
      "items": [
        {
          "text": "Mwami Azaria wi Vuyuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu muhiga gwa sirini na saba gwi liamiiha liu mwami Jeroboamu wa kaviri wa Isiraeli, Azaria",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.1",
            "verseOrgIds": [
              "2KI.15.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:1",
              "type": "text"
            },
            {
              "text": "Azaria:",
              "type": "text"
            },
            {
              "text": "Vitabu vilala viu Luheburaina vivoora Uzia (2 Zin. 26:1-20).",
              "type": "text"
            }
          ]
        },
        {
          "text": " muyaayi wa Amazia mwami wi Ivuyuda yaatanga kwamiiha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.1",
            "verseOrgIds": [
              "2KI.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaali ni mihiga kumi na sita lwa yaatanga kwamiiha na yamiha mu Jerusalemi ku mihiga amusini na mbiri. Lieta lia mama weve liali Jekolia kutura Jerusalemi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.2",
            "verseOrgIds": [
              "2KI.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalondaa liiva lia baba weve, Amazia, yakola agaali gu kuyaanziza Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.3",
            "verseOrgIds": [
              "2KI.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa havundu hu kusigamira misambwa sihononywa mba, na vandu vazizagilira kuhaanira ho ivisiuviliru kandi kusamba vimuli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.4",
            "verseOrgIds": [
              "2KI.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yahova yakuya mwami Azaria nu vulwaye vudamanu vwo vogere mu livamwoyo lilie liosi. Yamenya munyumba yeeye mwene, na muyaayi weve walangwa Jozamu yamiha nu kukalagira avandu vi Ivuyuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.5",
            "verseOrgIds": [
              "2KI.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.5",
            "verseOrgIds": [
              "2KI.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vikolwa viosi via Azaria yakola viang'odwa mu kitabu cha makuva ga kale ga vami vi Vuyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.6",
            "verseOrgIds": [
              "2KI.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaria yakuza, ma nayavilwa mu vilindwa viu vwami mu Lidaala linene lia Daudi, na muyaayi weve Jozamu yavugula vogono vwivwe kuli mwami wi Ivuyuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.7",
            "verseOrgIds": [
              "2KI.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwami Zakaria wa Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.7",
            "verseOrgIds": [
              "2KI.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu muhiga gwa salasini na nane gwi liamiiha liu mwami Azaria, wi Ivuyuda, Zakaria muyaayi wa Jeroboamu 2 yaatanga kwamiiha kuli mwami wa Isiraeli, na yamiha mu Samaria ku mieli sita. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.8",
            "verseOrgIds": [
              "2KI.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yakola agaali madamanu mu zimoni zia Yahova, kuli avaguuga veve vakora. Siyeleha kutura ku vwoni vwa Jeroboamu muyaayi wa Nebati, uvwayakola Isiraeli ukwona imbiri wa Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.9",
            "verseOrgIds": [
              "2KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumu muyaayi wa Jabeshi yaazira mwami Zakaria haasi kandi na mwitira ha Ibuleamu, navugura ovogono vwivwe kuli mwami wa Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.10",
            "verseOrgIds": [
              "2KI.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.10",
            "verseOrgIds": [
              "2KI.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivindu vindi viosi via Zakaria yakola, viang'odwa mu vitabu via makuva ga kale ga vami va Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.11",
            "verseOrgIds": [
              "2KI.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.11",
            "verseOrgIds": [
              "2KI.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa lilaga yili liadukizwa ilia Yahova yaali ni yalomba ku mwami Jehu: “Visukululwi vovo, kuduuka ku likula lia kane, valava avami va Isiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
            "verseOrgIds": [
              "2KI.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwami Shalumu wa Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
            "verseOrgIds": [
              "2KI.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu muhiga gwa salasini na tisa gwi liamiiha liu mwami Uzia wi Ivuyuda, Shalumu muyaayi wa Jabeshi yagwa mwami wa Isiraeli, kandi yamiha mu Samaria kulwu umweli mulala.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.13",
            "verseOrgIds": [
              "2KI.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.13",
            "verseOrgIds": [
              "2KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemu muyaayi wa Gadi yatura Tiriza nazia Samaria, ni yita Shalumu, ma navugura ovogono vwivwe kuli mwami wa Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.14",
            "verseOrgIds": [
              "2KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivindu vindi viosi via Shalumu yakola, harara ni livaala lie lilohiza kokora gu vuchamu viang'odwa mu vitabu via makuva ga kale ga vami va Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.15",
            "verseOrgIds": [
              "2KI.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemu yaali naturaa Tiriza, yononyia ligali lidaala linene lia Tapua, avandu vosi avamenyaa mulio, ni vivala viosi ivialikumberiza, kigira lidaala linene yili siliamwigulira yingiri mulio nu kuvugilira kuguutwa mba. Kali yatanyia zinda zia vakali vosi avaari ni vaveleka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.16",
            "verseOrgIds": [
              "2KI.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwami Menahemu wa Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.16",
            "verseOrgIds": [
              "2KI.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu muhiga gwa salasini na tisa gwi liamiiha liu mwami Uzia wi Ivuyuda, Manahemu muyaayi wa Gadi yagwa mwami wa Isiraeli; yamiha mu Samaria ku lwi mihiga likomi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.17",
            "verseOrgIds": [
              "2KI.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakola madamanu mu zimoni zia Yahova; mu madiku geege goosi, siyaleka kokora uvwoni vwosi vwa Jeroboamu muyaayi wa Nebati, wagira Isiraeli nikola uvwoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.18",
            "verseOrgIds": [
              "2KI.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tigilazi Pileseri, mwami wa Asiria yazia kulwana kivala cha Isiraeli, na Menahemu yamuha zikilo 34,000 zie ifeza konyoora ovokonyi mu lidinyiriza zinguru zia Menahemu ukwamiiha kivala cha Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.19",
            "verseOrgIds": [
              "2KI.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemu yanyoora mabese kutura ku vandu vatugi va Isiraeli, na yaniga mundu sa mulala kosolola vidonye amusini viefeza kuhaana ku mwami wa Asiria. Kunangwa Tigilazi Pileseri yirana mu kivala chiche.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.20",
            "verseOrgIds": [
              "2KI.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.20",
            "verseOrgIds": [
              "2KI.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vindu vindi viosi via Menahemu yakola viang'odwa mu vitabu via makuva ga kale ga vami va Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.21",
            "verseOrgIds": [
              "2KI.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemu yakuza ma nayavirwa, na muyaayi weve Pekahia yavugula ovogono vwivwe kuli mwami wa Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.22",
            "verseOrgIds": [
              "2KI.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwami Pekahia wa Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
