            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu muhiga gwa amusini gwi liamiiha liu mwami Uzia wi Ivuyuda, Pekahia muyaayi wa Menahemu yaatanga kwamiiha kuli mwami wa Isiraeli. Yamiha mu Samaria ku mihiga giviri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.23",
            "verseOrgIds": [
              "2KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakola uvwoni mu zimoni zia Yahova; siyagirung'ana kutura mu vwoni vwa Jeroboamu muyaayi wa Nebati mba. Yimilira Isiraeli mu likora uvwoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munene wi liihi lia Pekahia, Peka muyaayi wa Remalia, yamuzira haasi harara na vandu vasaza amusini kutura Gileadi, niyiitira Pekahia mu imbinga yu mugati yi inyumba yu mwami mu Samaria. Peka yavugula vogono vwivwe kuli mwami wa Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
          }
        }
      ]
