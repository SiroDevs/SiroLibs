          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi Yahova yakola kuli Musa yateeva. Iziinji ziatula ku Mwami, kuvatumikiri veve, kandi ku vandu veve; inji kali ndala siyaatigala mba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.31",
            "verseOrgIds": [
              "EXO.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa kali kuduuka ing'inga yiyi Mwami yaali umudinyu, kandi siyaali anyala kuvaleka vazie mba.",
          "type": "text",
          "attrs": {
