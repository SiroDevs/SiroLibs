              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami yavoola, “Ndamuleka muzie kuhaana visiuviliru ku Yahova, Nyasaye winyu, mwigendanyama, niiva simulazia ihaale mba. Musaliri ku.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.28",
