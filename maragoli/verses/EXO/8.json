          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Mwami yalanga Musa na Haruni navoora, “Muzie na muhaaniri Nyasaye winyu visiuviliru hano mu kivala kinu.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.25",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        }
      ]
